@Component
script BRLobbyMatchmaker extends Component

	property boolean EnableLobbyMatchmaker = true

	property boolean AutoQueueOnEnter = true

	property boolean AutoJoinCurrentUsersOnBeginPlay = true

	property number AutoJoinCurrentUsersDelay = 1

	property number TargetPlayerCount = 3

	property number QueuePollSeconds = 1

	property number HeartbeatSeconds = 10

	property number TicketTtlSeconds = 45

	property number MaxQueueUpdateRetries = 5

	property number MaxMatchesPerTick = 8

	property boolean UseGlobalMatchQueue = true

	property string GlobalQueueStorageName = "SkillChangeSurvivalMatchmaking"

	property string GlobalQueueKey = "br_match_queue"

	property string LobbyMapName = "StartMap"

	property boolean VerboseDebugLog = true

	property number DebugLogIntervalSeconds = 5

	property string GatherMapName = "BattleMap"

	property string DynamicMapPrefix = "gather_"

	property number GatherCenterX = 0

	property number GatherCenterY = 3

	property number GatherSpacingX = 1.5

	property number GatherSpacingY = 0.8

	property number GatherColumns = 8

	@Sync
	property string MatchmakingPhase = "Idle"

	@Sync
	property number QueueCount = 0

	@Sync
	property number TotalQueueCount = 0

	@Sync
	property number GatheredCount = 0

	@Sync
	property string LastGatherId = ""

	@Sync
	property string LastDynamicMapName = ""

	@Sync
	property number ActiveMatchCount = 0

	@Sync
	property string LastError = ""

	@Sync
	property string CurrentWorldInstanceId = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		if self:IsLobbyMapEntity() == false then
			self.EnableLobbyMatchmaker = false
			self._T.disabledOutsideLobby = true
			return
		end

		self:ResetRuntime()
		self:StartPollTimer()
		self:TryJoinCurrentUsersSoon()
	end

	@ExecSpace("ServerOnly")
	method void ResetRuntime()
		self._T.queue = self:CreateEmptyQueue()
		self._T.localTickets = {}
		self._T.pollTimerId = 0
		self._T.lastHeartbeatAt = 0
		self._T.lastDebugLogAt = 0
		self._T.matches = {}
		self._T.dynamicMaps = {}
		self._T.runtimeReady = true
		self.MatchmakingPhase = "Idle"
		self.QueueCount = 0
		self.TotalQueueCount = 0
		self.GatheredCount = 0
		self.LastGatherId = ""
		self.LastDynamicMapName = ""
		self.ActiveMatchCount = 0
		self.LastError = ""
		self.CurrentWorldInstanceId = self:GetCurrentWorldInstanceId()
		log("[BRLobby] begin backend=" .. self:GetQueueBackendName() .. " autoQueue=" .. tostring(self.AutoQueueOnEnter) .. " autoCurrent=" .. tostring(self.AutoJoinCurrentUsersOnBeginPlay) .. " groupSize=" .. tostring(self:GetTargetCount()) .. " ttl=" .. tostring(self:GetTicketTtlSeconds()) .. " heartbeat=" .. tostring(self:GetHeartbeatSeconds()) .. " instance=" .. self.CurrentWorldInstanceId)
	end

	@ExecSpace("ServerOnly")
	method void EnsureRuntimeStarted()
		if self._T.disabledOutsideLobby == true then
			return
		end
		if self:IsLobbyMapEntity() == false then
			self.EnableLobbyMatchmaker = false
			self._T.disabledOutsideLobby = true
			return
		end
		if self._T.runtimeReady == true then
			return
		end

		log("[BRLobby] runtime was not ready. initializing now.")
		self:ResetRuntime()
		self:StartPollTimer()
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Join Current Users")
	method void JoinCurrentUsers()
		self:EnsureRuntimeStarted()
		local joinedCount = 0
		for userId, entity in pairs(_UserService.UserEntities) do
			local profileCode = ""
			if entity.PlayerComponent ~= nil then
				profileCode = entity.PlayerComponent.ProfileCode
			end
			self:JoinQueue(userId, profileCode)
			joinedCount = joinedCount + 1
		end
		log("[BRLobby] join current users requested count=" .. tostring(joinedCount))
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Cancel Current Users")
	method void CancelCurrentUsers()
		self:EnsureRuntimeStarted()
		for userId, entity in pairs(_UserService.UserEntities) do
			self:CancelQueue(userId)
		end
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Gather Match")
	method void GatherMatchNow()
		self:EnsureRuntimeStarted()
		self:TryMakeMatch(true)
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Clear Dynamic Matches")
	method void ClearDynamicMatches()
		self:EnsureRuntimeStarted()
		if self._T.dynamicMaps == nil then
			self._T.dynamicMaps = {}
		end

		for mapName, active in pairs(self._T.dynamicMaps) do
			if active == true then
				local result = _DynamicMapService:DestroyDynamicMap(mapName)
				if result ~= DynamicMapResultCode.Success and result ~= DynamicMapResultCode.DynamicMapNotFound then
					log("[BRLobby] dynamic map destroy failed: " .. mapName .. " result=" .. tostring(result))
				end
			end
		end

		self._T.matches = {}
		self._T.dynamicMaps = {}
		self.ActiveMatchCount = 0
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Reset Global Queue")
	method void ResetGlobalQueue()
		self:EnsureRuntimeStarted()
		local storage = self:GetGlobalQueueStorage()
		if storage == nil then
			return
		end

		local key = self:GetGlobalQueueKey()
		local code = storage:SetAndWait(key, self:EncodeQueue(self:CreateEmptyQueue()))
		if self:IsDataStorageSuccess(code) == true then
			self._T.localTickets = {}
			self.QueueCount = 0
			self.TotalQueueCount = 0
			self.MatchmakingPhase = "Idle"
			self.LastError = ""
			log("[BRLobby] global queue reset: key=" .. key)
			return
		end

		self.LastError = "Global queue reset failed: " .. tostring(code)
		log("[BRLobby] global queue reset failed: key=" .. key .. " result=" .. tostring(code))
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Matchmaker")
	method void DebugMatchmaker()
		self:EnsureRuntimeStarted()
		local snapshot = self:ReadQueueSnapshot()
		if snapshot == nil then
			log("[BRLobby] debug failed: queue unavailable")
			return
		end

		local queue = snapshot.State
		self:NormalizeQueue(queue)
		self:UpdateQueueCounts(queue)
		self.CurrentWorldInstanceId = self:GetCurrentWorldInstanceId()
		log("[BRLobby] debug backend=" .. self:GetQueueBackendName() .. " localQueue=" .. tostring(self.QueueCount) .. " totalQueue=" .. tostring(self.TotalQueueCount) .. " groupSize=" .. tostring(self:GetTargetCount()) .. " instance=" .. self.CurrentWorldInstanceId .. " phase=" .. self.MatchmakingPhase .. " lastError=" .. self.LastError)
	end

	@ExecSpace("ServerOnly")
	method void StartPollTimer()
		if self.EnableLobbyMatchmaker == false then
			log("[BRLobby] poll timer skipped: disabled")
			return
		end
		if self._T.pollTimerId ~= nil and self._T.pollTimerId > 0 then
			log("[BRLobby] poll timer already running id=" .. tostring(self._T.pollTimerId))
			return
		end

		local tick = function()
			self:OnMatchmakerTick()
		end

		self._T.pollTimerId = _TimerService:SetTimerRepeat(tick, math.max(0.2, self.QueuePollSeconds))
		log("[BRLobby] poll timer started id=" .. tostring(self._T.pollTimerId) .. " interval=" .. tostring(math.max(0.2, self.QueuePollSeconds)))
	end

	@ExecSpace("ServerOnly")
	method void TryJoinCurrentUsersSoon()
		if self.EnableLobbyMatchmaker == false or self.AutoQueueOnEnter == false or self.AutoJoinCurrentUsersOnBeginPlay == false then
			log("[BRLobby] auto join current users skipped: enabled=" .. tostring(self.EnableLobbyMatchmaker) .. " autoQueue=" .. tostring(self.AutoQueueOnEnter) .. " autoCurrent=" .. tostring(self.AutoJoinCurrentUsersOnBeginPlay))
			return
		end

		local joinUsers = function()
			log("[BRLobby] auto join current users fired")
			self:JoinCurrentUsers()
			self:TryMakeMatch(false)
		end

		_TimerService:SetTimerOnce(joinUsers, math.max(0, self.AutoJoinCurrentUsersDelay))
		log("[BRLobby] auto join current users scheduled delay=" .. tostring(math.max(0, self.AutoJoinCurrentUsersDelay)))
	end

	@ExecSpace("ServerOnly")
	method void OnMatchmakerTick()
		self:EnsureRuntimeStarted()
		if self.EnableLobbyMatchmaker == false then
			return
		end

		self:RefreshLocalTicketHeartbeats()
		self:TryMakeMatch(false)
		self:LogPeriodicStatus()
	end

	@ExecSpace("ServerOnly")
	method boolean JoinQueue(string userId, string profileCode)
		self:EnsureRuntimeStarted()
		if userId == nil or userId == "" then
			return false
		end

		local ticketId = _UtilLogic:NewGuid()
		local now = self:Now()
		local ticket = {
			TicketId = ticketId,
			UserId = userId,
			ProfileCode = self:ReadString(profileCode, ""),
			WorldInstanceId = self:GetCurrentWorldInstanceId(),
			EnqueuedAt = now,
			LastSeenAt = now,
			ExpiresAt = now + self:GetTicketTtlSeconds()
		}

		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return false
			end

			local queue = snapshot.State
			self:NormalizeQueue(queue)
			self:RemoveTicketByUserId(queue, userId)
			table.insert(queue.Tickets, ticket)
			queue.UpdatedAt = now

			if self:CommitQueueSnapshot(snapshot) == true then
				self._T.localTickets[userId] = ticketId
				self:UpdateQueueCounts(queue)
				self.MatchmakingPhase = "Queued"
				self:SetLobbyName(userId, self.QueueCount)
				self:ShowToast("Matching " .. tostring(self.QueueCount) .. "/" .. tostring(self:GetTargetCount()))
				log("[BRLobby] queued " .. userId .. " ticket=" .. ticketId .. " backend=" .. self:GetQueueBackendName() .. " localQueue=" .. tostring(self.QueueCount) .. " totalQueue=" .. tostring(self.TotalQueueCount) .. " instance=" .. self.CurrentWorldInstanceId)
				return true
			end
		end

		log("[BRLobby] failed to join queue: " .. userId)
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean CancelQueue(string userId)
		self:EnsureRuntimeStarted()
		if userId == nil or userId == "" then
			return false
		end

		local localTicketId = self._T.localTickets[userId]
		if localTicketId == nil or localTicketId == "" then
			return true
		end

		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return false
			end

			local queue = snapshot.State
			self:NormalizeQueue(queue)
			local removed = self:RemoveTicketByUserIdAndTicketId(queue, userId, localTicketId)
			queue.UpdatedAt = self:Now()

			if removed == false then
				self._T.localTickets[userId] = nil
				self:UpdateQueueCounts(queue)
				return true
			end

			if self:CommitQueueSnapshot(snapshot) == true then
				self._T.localTickets[userId] = nil
				self:UpdateQueueCounts(queue)
				self.MatchmakingPhase = "Canceled"
				self:ShowToast("Matchmaking canceled.")
				log("[BRLobby] canceled " .. userId)
				return true
			end
		end

		log("[BRLobby] failed to cancel queue: " .. userId)
		return false
	end

	@ExecSpace("ServerOnly")
	method void RefreshLocalTicketHeartbeats()
		self:EnsureRuntimeStarted()
		local now = self:Now()
		if self._T.lastHeartbeatAt ~= nil and now - self._T.lastHeartbeatAt < self:GetHeartbeatSeconds() then
			return
		end
		self._T.lastHeartbeatAt = now

		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return
			end

			local queue = snapshot.State
			self:NormalizeQueue(queue)
			local changed = false
			local beforeCleanCount = #queue.Tickets

			for index, ticket in ipairs(queue.Tickets) do
				if self._T.localTickets[ticket.UserId] == ticket.TicketId then
					ticket.WorldInstanceId = self:GetCurrentWorldInstanceId()
					ticket.LastSeenAt = now
					ticket.ExpiresAt = now + self:GetTicketTtlSeconds()
					changed = true
				end
			end

			self:CleanExpiredTickets(queue, now)
			if #queue.Tickets ~= beforeCleanCount then
				changed = true
				log("[BRLobby] expired tickets removed during heartbeat: before=" .. tostring(beforeCleanCount) .. " after=" .. tostring(#queue.Tickets) .. " now=" .. tostring(now) .. " ttl=" .. tostring(self:GetTicketTtlSeconds()))
			end
			queue.UpdatedAt = now

			if changed == false then
				self:UpdateQueueCounts(queue)
				return
			end
			if self:CommitQueueSnapshot(snapshot) == true then
				self:UpdateQueueCounts(queue)
				return
			end
		end
	end

	@ExecSpace("ServerOnly")
	method boolean TryMakeMatch(boolean force)
		self:EnsureRuntimeStarted()
		if self.EnableLobbyMatchmaker == false then
			return false
		end

		local madeMatch = false
		local maxMatches = math.max(1, math.floor(self:ReadNumber(self.MaxMatchesPerTick, 8)))
		for matchIndex = 1, maxMatches do
			if self:TryMakeSingleMatch(force) == false then
				return madeMatch
			end

			madeMatch = true
			if force == true then
				force = false
			end
		end

		return madeMatch
	end

	@ExecSpace("ServerOnly")
	method boolean TryMakeSingleMatch(boolean force)
		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return false
			end

			local queue = snapshot.State
			self:NormalizeQueue(queue)
			local beforeCleanCount = #queue.Tickets
			self:CleanExpiredTickets(queue, self:Now())
			local queueChanged = #queue.Tickets ~= beforeCleanCount
			if queueChanged == true then
				log("[BRLobby] expired tickets removed during match check: before=" .. tostring(beforeCleanCount) .. " after=" .. tostring(#queue.Tickets) .. " now=" .. tostring(self:Now()) .. " ttl=" .. tostring(self:GetTicketTtlSeconds()))
			end
			self:UpdateQueueCounts(queue)

			if self:CanStartWithQueue(queue, force) == false then
				self:UpdateWaitingPhase(queue)
				if queueChanged == true then
					self:CommitQueueSnapshot(snapshot)
				end
				return false
			end

			local selectedTickets = self:TakeMatchTickets(queue)
			if #selectedTickets == 0 then
				return false
			end

			queue.UpdatedAt = self:Now()
			if self:CommitQueueSnapshot(snapshot) == true then
				self:UpdateQueueCounts(queue)
				self:GatherTickets(selectedTickets)
				return true
			end
		end

		return false
	end

	method boolean CanStartWithQueue(any queue, boolean force)
		local queuedCount = self:GetLocalTicketCount(queue)
		return queuedCount >= self:GetTargetCount()
	end

	method void UpdateWaitingPhase(any queue)
		local queuedCount = self:GetLocalTicketCount(queue)
		local totalCount = self:GetTotalTicketCount(queue)
		if queuedCount <= 0 then
			self.MatchmakingPhase = "Waiting local 0/" .. tostring(self:GetTargetCount()) .. " total " .. tostring(totalCount)
			return
		end
		self.MatchmakingPhase = "Waiting local " .. tostring(queuedCount) .. "/" .. tostring(self:GetTargetCount()) .. " total " .. tostring(totalCount)
	end

	method any TakeMatchTickets(any queue)
		local selected = {}
		local count = self:GetTargetCount()
		local index = 1

		while index <= #queue.Tickets do
			if #selected >= count then
				break
			end

			local ticket = queue.Tickets[index]
			if ticket ~= nil and self:IsLocalTicket(ticket) == true then
				table.remove(queue.Tickets, index)
				table.insert(selected, ticket)
			else
				index = index + 1
			end
		end

		if #selected < count then
			for selectedIndex, ticket in ipairs(selected) do
				table.insert(queue.Tickets, ticket)
			end
			return {}
		end

		return selected
	end

	@ExecSpace("ServerOnly")
	method void GatherTickets(any tickets)
		local players = {}
		for index, ticket in ipairs(tickets) do
			table.insert(players, ticket.UserId)
			self._T.localTickets[ticket.UserId] = nil
		end

		if self:AreAllPlayersInThisServer(players) == false then
			self.MatchmakingPhase = "UsersMissing"
			self:RestoreTickets(tickets)
			log("[BRLobby] gather canceled because selected users are not in this server.")
			return
		end

		local gatherId = _UtilLogic:NewGuid()
		local dynamicMapName = self:CreateDynamicGatherMap(gatherId)
		if dynamicMapName == "" then
			self.MatchmakingPhase = "DynamicMapFailed"
			self:RestoreTickets(tickets)
			log("[BRLobby] gather canceled because dynamic map creation failed: " .. gatherId)
			return
		end

		local movedCount = 0

		for index, userId in ipairs(players) do
			local playerEntity = _UserService:GetUserEntityByUserId(userId)
			if playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
				local position = self:GetGatherPosition(index, #players)
				playerEntity.PlayerComponent:MoveToMapPosition(dynamicMapName, position)
				self:SetGatherName(userId, index, #players)
				movedCount = movedCount + 1
			end
		end

		self:SaveDynamicMatch(gatherId, dynamicMapName, players)
		self.LastGatherId = gatherId
		self.LastDynamicMapName = dynamicMapName
		self.GatheredCount = movedCount
		self.MatchmakingPhase = "Gathered"
		self:ShowToast("Gathered " .. tostring(self.GatheredCount) .. " players.")
		log("[BRLobby] gathered " .. gatherId .. " map=" .. dynamicMapName .. " players=" .. tostring(movedCount) .. " activeMatches=" .. tostring(self.ActiveMatchCount))
	end

	method string CreateDynamicGatherMap(string gatherId)
		local sourceMapName = self:ReadString(self.GatherMapName, "BattleMap")
		local mapName = self:GetDynamicGatherMapName(gatherId)
		self.LastError = ""
		local result = _DynamicMapService:CreateDynamicMap(sourceMapName, mapName)
		if result == DynamicMapResultCode.Success then
			return mapName
		end

		self.LastError = "DynamicMap create failed: " .. tostring(result)
		log("[BRLobby] dynamic map create failed: source=" .. sourceMapName .. " map=" .. mapName .. " result=" .. tostring(result))
		return ""
	end

	method string GetDynamicGatherMapName(string gatherId)
		local rawName = self:ReadString(self.DynamicMapPrefix, "gather_") .. self:ReadString(gatherId, _UtilLogic:NewGuid())
		local safeName = string.gsub(rawName, "[\\/:*?\"<>|#&=]", "_")
		if string.len(safeName) > 80 then
			return string.sub(safeName, 1, 80)
		end
		return safeName
	end

	method void SaveDynamicMatch(string gatherId, string mapName, any players)
		if self._T.matches == nil then
			self._T.matches = {}
		end
		if self._T.dynamicMaps == nil then
			self._T.dynamicMaps = {}
		end

		self._T.matches[gatherId] = {
			Id = gatherId,
			MapName = mapName,
			Players = players,
			StartedAt = self:Now()
		}
		self._T.dynamicMaps[mapName] = true
		self.ActiveMatchCount = self:GetActiveMatchCount()
	end

	@ExecSpace("ServerOnly")
	method void RestoreTickets(any tickets)
		local now = self:Now()
		for index, ticket in ipairs(tickets) do
			ticket.WorldInstanceId = self:GetCurrentWorldInstanceId()
			ticket.LastSeenAt = now
			ticket.ExpiresAt = now + self:GetTicketTtlSeconds()
		end

		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return
			end

			local queue = snapshot.State
			self:NormalizeQueue(queue)
			for index, ticket in ipairs(tickets) do
				self:RemoveTicketByUserId(queue, ticket.UserId)
				table.insert(queue.Tickets, ticket)
				self._T.localTickets[ticket.UserId] = ticket.TicketId
			end
			queue.UpdatedAt = now

			if self:CommitQueueSnapshot(snapshot) == true then
				self:UpdateQueueCounts(queue)
				return
			end
		end
	end

	@ExecSpace("ServerOnly")
	method any ReadQueueSnapshot()
		if self.UseGlobalMatchQueue == true then
			return self:ReadGlobalQueueSnapshot()
		end

		return self:ReadLocalQueueSnapshot()
	end

	@ExecSpace("ServerOnly")
	method any ReadLocalQueueSnapshot()
		if self._T.queue == nil then
			self._T.queue = self:CreateEmptyQueue()
		end

		self:NormalizeQueue(self._T.queue)
		return {
			Backend = "Local",
			State = self._T.queue
		}
	end

	@ExecSpace("ServerOnly")
	method boolean CommitQueueSnapshot(any snapshot)
		if snapshot == nil or snapshot.State == nil then
			return false
		end

		if snapshot.Backend == "GlobalDataStorage" then
			return self:CommitGlobalQueueSnapshot(snapshot)
		end

		self._T.queue = snapshot.State
		return true
	end

	@ExecSpace("ServerOnly")
	method any ReadGlobalQueueSnapshot()
		local storage = self:GetGlobalQueueStorage()
		if storage == nil then
			return nil
		end

		local key = self:GetGlobalQueueKey()
		local code, encodedQueue = storage:GetAndWait(key)
		local missingQueue = false
		if self:IsDataStorageSuccess(code) == false then
			if self:IsDataStorageBadRequest(code) == false then
				self.LastError = "Global queue read failed: " .. tostring(code)
				log("[BRLobby] global queue read failed: key=" .. key .. " result=" .. tostring(code))
				return nil
			end
			missingQueue = true
			encodedQueue = ""
		end

		local queue = self:DecodeQueue(encodedQueue)
		if queue == nil then
			self.LastError = "Global queue decode failed"
			log("[BRLobby] global queue decode failed. Reinitializing queue: key=" .. key)
			queue = self:CreateEmptyQueue()
		end

		self:NormalizeQueue(queue)
		return {
			Backend = "GlobalDataStorage",
			Storage = storage,
			Key = key,
			ExpectedValue = self:ReadString(encodedQueue, ""),
			Missing = missingQueue,
			State = queue
		}
	end

	@ExecSpace("ServerOnly")
	method boolean CommitGlobalQueueSnapshot(any snapshot)
		local storage = snapshot.Storage
		if storage == nil then
			storage = self:GetGlobalQueueStorage()
		end
		if storage == nil then
			return false
		end

		local key = self:ReadString(snapshot.Key, self:GetGlobalQueueKey())
		local expectedValue = self:ReadString(snapshot.ExpectedValue, "")
		local newValue = self:EncodeQueue(snapshot.State)
		if newValue == "" then
			self.LastError = "Global queue encode failed"
			return false
		end

		local code = 0
		local updatedValue = ""
		if snapshot.Missing == true then
			code = storage:SetAndWait(key, newValue)
		else
			code, updatedValue = storage:UpdateAndWait(key, expectedValue, newValue)
		end

		if self:IsDataStorageSuccess(code) == true then
			return true
		end

		self.LastError = "Global queue write failed: " .. tostring(code)
		log("[BRLobby] global queue write failed: key=" .. key .. " result=" .. tostring(code))
		return false
	end

	method GlobalDataStorage GetGlobalQueueStorage()
		if _DataStorageService == nil then
			self.LastError = "DataStorageService unavailable"
			log("[BRLobby] DataStorageService unavailable.")
			return nil
		end

		return _DataStorageService:GetGlobalDataStorage(self:ReadString(self.GlobalQueueStorageName, "SkillChangeSurvivalMatchmaking"))
	end

	method boolean IsDataStorageSuccess(any code)
		local codeNumber = tonumber(code)
		if codeNumber ~= nil then
			return codeNumber == 0
		end

		local codeText = tostring(code)
		return codeText == "Success" or codeText == "WriteResultCode.Success"
	end

	method boolean IsDataStorageBadRequest(any code)
		local codeNumber = tonumber(code)
		if codeNumber ~= nil then
			return codeNumber == 2
		end

		local codeText = tostring(code)
		return codeText == "BadRequest" or codeText == "WriteResultCode.BadRequest"
	end

	method string GetGlobalQueueKey()
		return self:ReadString(self.GlobalQueueKey, "br_match_queue")
	end

	method string GetQueueBackendName()
		if self.UseGlobalMatchQueue == true then
			return "GlobalDataStorage"
		end
		return "Local"
	end

	method boolean IsLobbyMapEntity()
		if self.Entity == nil then
			return true
		end

		local path = self:ReadString(self.Entity.Path, "")
		if path == "" then
			return true
		end

		local lobbyRoot = "/maps/" .. self:ReadString(self.LobbyMapName, "StartMap")
		if path == lobbyRoot then
			return true
		end

		return string.sub(path, 1, string.len(lobbyRoot) + 1) == lobbyRoot .. "/"
	end

	method string EncodeQueue(any queue)
		if queue == nil then
			return ""
		end

		self:NormalizeQueue(queue)
		local encoded = "BRQ2\n" .. tostring(self:ReadNumber(queue.UpdatedAt, self:Now()))
		for index, ticket in ipairs(queue.Tickets) do
			encoded = encoded .. "\n" ..
				self:EncodeQueueField(ticket.TicketId) .. "|" ..
				self:EncodeQueueField(ticket.UserId) .. "|" ..
				self:EncodeQueueField(ticket.ProfileCode) .. "|" ..
				self:EncodeQueueField(ticket.WorldInstanceId) .. "|" ..
				tostring(self:ReadNumber(ticket.EnqueuedAt, self:Now())) .. "|" ..
				tostring(self:ReadNumber(ticket.LastSeenAt, self:Now())) .. "|" ..
				tostring(self:ReadNumber(ticket.ExpiresAt, self:Now() + self:GetTicketTtlSeconds()))
		end

		return encoded
	end

	method any DecodeQueue(string encodedQueue)
		if encodedQueue == nil or encodedQueue == "" then
			return self:CreateEmptyQueue()
		end

		if string.sub(encodedQueue, 1, 5) ~= "BRQ2\n" then
			return self:CreateEmptyQueue()
		end

		local queue = self:CreateEmptyQueue()
		local lineIndex = 0
		for line in string.gmatch(encodedQueue, "[^\n]+") do
			lineIndex = lineIndex + 1
			if lineIndex == 2 then
				queue.UpdatedAt = self:ReadNumber(line, self:Now())
			elseif lineIndex > 2 then
				local fields = self:SplitQueueLine(line)
				if #fields >= 7 then
					table.insert(queue.Tickets, {
						TicketId = fields[1],
						UserId = fields[2],
						ProfileCode = fields[3],
						WorldInstanceId = fields[4],
						EnqueuedAt = self:ReadNumber(fields[5], self:Now()),
						LastSeenAt = self:ReadNumber(fields[6], self:Now()),
						ExpiresAt = self:ReadNumber(fields[7], self:Now() + self:GetTicketTtlSeconds())
					})
				end
			end
		end
		self:NormalizeQueue(queue)
		return queue
	end

	method string EncodeQueueField(any value)
		local text = tostring(self:ReadString(value, ""))
		text = string.gsub(text, "|", "_")
		text = string.gsub(text, "\n", "_")
		text = string.gsub(text, "\r", "_")
		return text
	end

	method any SplitQueueLine(string line)
		local fields = {}
		local startIndex = 1
		while #fields < 7 do
			local separatorIndex = string.find(line, "|", startIndex, true)
			if separatorIndex == nil then
				table.insert(fields, string.sub(line, startIndex))
				break
			end

			table.insert(fields, string.sub(line, startIndex, separatorIndex - 1))
			startIndex = separatorIndex + 1
		end
		return fields
	end

	method any CreateEmptyQueue()
		return {
			Version = 1,
			Tickets = {},
			UpdatedAt = self:Now()
		}
	end

	method void NormalizeQueue(any queue)
		if queue.Version == nil then
			queue.Version = 1
		end
		if queue.Tickets == nil then
			queue.Tickets = {}
		end
	end

	method void CleanExpiredTickets(any queue, number now)
		for index = #queue.Tickets, 1, -1 do
			local ticket = queue.Tickets[index]
			local expiresAt = tonumber(ticket.ExpiresAt)
			if expiresAt == nil or expiresAt <= now then
				table.remove(queue.Tickets, index)
			end
		end
	end

	method void RemoveTicketByUserId(any queue, string userId)
		for index = #queue.Tickets, 1, -1 do
			if queue.Tickets[index].UserId == userId then
				table.remove(queue.Tickets, index)
			end
		end
	end

	method boolean RemoveTicketByUserIdAndTicketId(any queue, string userId, string ticketId)
		local removed = false
		for index = #queue.Tickets, 1, -1 do
			local ticket = queue.Tickets[index]
			if ticket.UserId == userId and (ticketId == nil or ticketId == "" or ticket.TicketId == ticketId) then
				table.remove(queue.Tickets, index)
				removed = true
			end
		end
		return removed
	end

	method number GetLocalTicketCount(any queue)
		local count = 0
		if queue == nil or queue.Tickets == nil then
			return count
		end
		for index, ticket in ipairs(queue.Tickets) do
			if self:IsLocalTicket(ticket) == true then
				count = count + 1
			end
		end
		return count
	end

	method void UpdateQueueCounts(any queue)
		self.QueueCount = self:GetLocalTicketCount(queue)
		self.TotalQueueCount = self:GetTotalTicketCount(queue)
		self.CurrentWorldInstanceId = self:GetCurrentWorldInstanceId()
	end

	method number GetTotalTicketCount(any queue)
		if queue == nil or queue.Tickets == nil then
			return 0
		end
		return #queue.Tickets
	end

	@ExecSpace("ServerOnly")
	method void LogPeriodicStatus()
		if self.VerboseDebugLog == false then
			return
		end

		local now = self:Now()
		local interval = math.max(1, self:ReadNumber(self.DebugLogIntervalSeconds, 5))
		if self._T.lastDebugLogAt ~= nil and now - self._T.lastDebugLogAt < interval then
			return
		end
		self._T.lastDebugLogAt = now

		log("[BRLobby] tick backend=" .. self:GetQueueBackendName() .. " users=" .. tostring(self:GetConnectedUserCount()) .. " localQueue=" .. tostring(self.QueueCount) .. " totalQueue=" .. tostring(self.TotalQueueCount) .. " phase=" .. self.MatchmakingPhase .. " instance=" .. self.CurrentWorldInstanceId .. " lastError=" .. self.LastError)
	end

	method number GetConnectedUserCount()
		local count = 0
		for userId, entity in pairs(_UserService.UserEntities) do
			count = count + 1
		end
		return count
	end

	method any GetOldestLocalTicket(any queue)
		if queue == nil or queue.Tickets == nil then
			return nil
		end
		for index, ticket in ipairs(queue.Tickets) do
			if self:IsLocalTicket(ticket) == true then
				return ticket
			end
		end
		return nil
	end

	method boolean IsLocalTicket(any ticket)
		if ticket == nil then
			return false
		end
		local ticketWorldInstanceId = self:ReadString(ticket.WorldInstanceId, "")
		return ticketWorldInstanceId == "" or ticketWorldInstanceId == self:GetCurrentWorldInstanceId()
	end

	method boolean AreAllPlayersInThisServer(any players)
		if players == nil then
			return false
		end
		for index, userId in ipairs(players) do
			if _UserService:GetUserEntityByUserId(userId) == nil then
				return false
			end
		end
		return true
	end

	method Vector2 GetGatherPosition(number index, number total)
		local safeTotal = math.max(1, math.floor(total))
		local columns = math.floor(self:ReadNumber(self.GatherColumns, 8))
		if columns <= 0 then
			columns = math.ceil(math.sqrt(safeTotal))
		end
		columns = math.max(1, math.min(columns, safeTotal))

		local row = math.floor((index - 1) / columns)
		local column = (index - 1) % columns
		local rows = math.ceil(safeTotal / columns)
		local spacingX = math.max(0.1, self:ReadNumber(self.GatherSpacingX, 1.5))
		local spacingY = math.max(0, self:ReadNumber(self.GatherSpacingY, 0.8))
		local centerX = self:ReadNumber(self.GatherCenterX, 0)
		local centerY = self:ReadNumber(self.GatherCenterY, 3)
		local x = centerX + (column - ((columns - 1) * 0.5)) * spacingX
		local y = centerY + (((rows - 1) * 0.5) - row) * spacingY
		return Vector2(x, y)
	end

	method number GetActiveMatchCount()
		local count = 0
		if self._T.matches == nil then
			return count
		end
		for matchId, match in pairs(self._T.matches) do
			count = count + 1
		end
		return count
	end

	method number GetTargetCount()
		return math.max(1, math.floor(self:ReadNumber(self.TargetPlayerCount, 8)))
	end

	method number GetTicketTtlSeconds()
		return math.max(30, self:ReadNumber(self.TicketTtlSeconds, 45))
	end

	method number GetHeartbeatSeconds()
		return math.max(1, math.min(self:GetTicketTtlSeconds() * 0.5, self:ReadNumber(self.HeartbeatSeconds, 10)))
	end

	method number Now()
		return _UtilLogic.ServerElapsedSeconds
	end

	method string GetCurrentWorldInstanceId()
		if _WorldInstanceService == nil then
			return ""
		end
		return self:ReadString(_WorldInstanceService.WorldInstanceId, "")
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method number GetStringLength(string value)
		if value == nil then
			return 0
		end
		return string.len(value)
	end

	@ExecSpace("ServerOnly")
	method void SetLobbyName(string userId, number queueCount)
		local playerEntity = _UserService:GetUserEntityByUserId(userId)
		if playerEntity == nil or playerEntity.NameTagComponent == nil then
			return
		end

		playerEntity.NameTagComponent.Name = "Matching " .. tostring(queueCount) .. "/" .. tostring(self:GetTargetCount())
		playerEntity.NameTagComponent.FontColor = Color(0.2, 1, 1, 1)
	end

	@ExecSpace("ServerOnly")
	method void SetGatherName(string userId, number index, number total)
		local playerEntity = _UserService:GetUserEntityByUserId(userId)
		if playerEntity == nil or playerEntity.NameTagComponent == nil then
			return
		end

		playerEntity.NameTagComponent.Name = "Gathered " .. tostring(index) .. "/" .. tostring(total)
		playerEntity.NameTagComponent.FontColor = Color(0.6, 1, 0.35, 1)
	end

	@ExecSpace("Client")
	method void ShowToast(string message)
		if _UIToast ~= nil then
			_UIToast:ShowMessage(message)
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		self:EnsureRuntimeStarted()
		if self.EnableLobbyMatchmaker == false or self.AutoQueueOnEnter == false then
			log("[BRLobby] user enter ignored: enabled=" .. tostring(self.EnableLobbyMatchmaker) .. " autoQueue=" .. tostring(self.AutoQueueOnEnter) .. " user=" .. tostring(event.UserId))
			return
		end

		log("[BRLobby] user enter user=" .. tostring(event.UserId) .. " profile=" .. tostring(event.ProfileCode))
		self:JoinQueue(event.UserId, event.ProfileCode)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		self:EnsureRuntimeStarted()
		if self.EnableLobbyMatchmaker == false then
			log("[BRLobby] user leave ignored: disabled user=" .. tostring(event.UserId))
			return
		end

		log("[BRLobby] user leave user=" .. tostring(event.UserId))
		self:CancelQueue(event.UserId)
	end

end
