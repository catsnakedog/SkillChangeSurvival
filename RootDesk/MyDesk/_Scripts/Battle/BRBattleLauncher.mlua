		local value = self.BattleTimerSeconds
		if owner ~= nil and owner.BattleTimerSeconds ~= nil then
			value = owner.BattleTimerSeconds
		end
		return math.max(1, math.floor(self:ReadNumber(value, 1800)))
	end

