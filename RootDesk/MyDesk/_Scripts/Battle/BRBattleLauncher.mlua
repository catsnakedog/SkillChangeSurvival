@Logic
script BRBattleLauncher extends Logic

	property number BattleTimerSeconds = 1800

	property string BattleTimerLabel = "BOSS"

	property boolean EnableMagneticZone = true

	property number MagneticZoneShrinkIntervalSeconds = 30

	property number MagneticZoneWarningSeconds = 5

	property number MagneticZoneForbiddenSeconds = 20

	property number MagneticZoneShrinkAmount = 2

	property number StartCornerSideInsetX = 1.5

	property number StartCornerFloorOffsetY = 0.25

	property number StartCenterSpawnSpreadX = 0.85

	property number FallbackStartRoomWidth = 20

	property number FallbackStartRoomHeight = 10

	property number FallbackStartGapX = 3

	property number FallbackStartGapY = 3

	property number FallbackStartOriginX = 0

	property number FallbackStartOriginY = 3

	property number MatchLoadingSeconds = 4

	property number PostLoadingCurtainSeconds = 2

	property number PreCountdownDelaySeconds = 1

	property number ResultPopupDelaySeconds = 0.75

	property string MatchLoadingMessage = "MATCH LOADING..."

	property string MatchStartMessage = "START!"

	property string BattleStartCountdownEffectRUID = "3b765e2b2a68476996ea77b2e5b8bcb4"

	property string BattleStartEffectRUID = "1dea1763a5fb4c5da2e06411183dbca8"

	property number BattleStartCountdownSeconds = 3

	property number BattleStartEffectSeconds = 1

	property number BattleStartEffectScale = 0.7

	property number BattleStartEffectOrderInLayer = 120

	property string MatchResultVictoryTitle = "VICTORY"

	property string MatchResultDefeatTitle = "DEFEAT"

	property boolean EnableBattleBots = true

	property string BattleBotModelId = "battlebot"

	property number BattleBotMaxHp = 100

	property number BattleBotLives = 2

	property number BattleBotMaxFillCount = 3

	property boolean UseInstanceBattleRooms = true

	property number InstanceRoomFirstUserWaitSeconds = 30

	property number InstanceRoomRetrySeconds = 1

	property number InstanceRoomCreateMaxAttempts = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes server-side match flow runtime tables.
		self:ResetRuntime()
		log("[BRBattleLauncher] ready loading=" .. tostring(self:GetMatchLoadingSeconds(nil)))
	end

	method void ResetRuntime()
		-- Clears active match registries for a fresh world session.
		self._T.activeMatchesByMap = {}
		self._T.activeMatchesById = {}
	end

	method void EnsureRuntimeTables()
		-- Creates active match registries when another method runs before OnBeginPlay.
		if self._T.activeMatchesByMap == nil then
			self._T.activeMatchesByMap = {}
		end
		if self._T.activeMatchesById == nil then
			self._T.activeMatchesById = {}
		end
	end

	@ExecSpace("ServerOnly")
	method any StartMatchRoom(any matchRoom, any owner)
		-- Starts a match after ensuring the per-match battle room exists.
		if matchRoom == nil then
			return self:CreateResult(false, "", 0, "MatchRoom is nil")
		end
		
		local targetMapName = self:ResolveTargetMapForRoom(matchRoom, owner)
		if targetMapName == "" then
			return self:CreateResult(false, "", 0, "Target map is empty")
		end
		
		matchRoom.TargetMapName = targetMapName
		local startedAt = _UtilLogic.ServerElapsedSeconds
		log("[BRBattleLauncher] launch begin match=" .. self:ReadString(matchRoom.MatchId, "") .. " map=" .. targetMapName)
		local roomCreateResult = self:EnsureBattleInstanceRoom(matchRoom, owner, targetMapName)
		if roomCreateResult == nil or roomCreateResult.Success ~= true then
			local errorMessage = "Instance room creation failed"
			if roomCreateResult ~= nil then
				errorMessage = self:ReadString(roomCreateResult.Error, errorMessage)
			end
			if roomCreateResult ~= nil and roomCreateResult.Retry == true then
				if self:ScheduleBattleInstanceRoomRetry(matchRoom, owner, targetMapName, roomCreateResult) == true then
					local pendingResult = self:CreateResult(false, targetMapName, 0, errorMessage)
					pendingResult.Pending = true
					pendingResult.RoomKey = self:ReadString(matchRoom.RoomKey, "")
					pendingResult.InstanceRoomKey = self:ReadString(matchRoom.InstanceRoomKey, "")
					pendingResult.RoomCreateAttempts = self:ReadNumber(matchRoom.RoomCreateAttempts, 0)
					return pendingResult
				end
			end
			return self:CreateResult(false, targetMapName, 0, errorMessage)
		end
		self:EnsurePhysicalGrid(targetMapName)

		local loadingSeconds = self:GetMatchLoadingSeconds(owner)
		self:NotifyMatchLoading(matchRoom, owner, loadingSeconds)

		local movedCount = self:MovePlayersToMatchRoom(matchRoom, owner)
		local botCount = 0
		local roomGraph = nil
		if movedCount > 0 then
			self:RegisterActiveMatch(matchRoom, owner, targetMapName, loadingSeconds)
			botCount = self:SpawnBattleBotsForMatchRoom(matchRoom, owner, movedCount, targetMapName)
			log("[BRBattleLauncher] launch actors ready match=" .. self:ReadString(matchRoom.MatchId, "") .. " moved=" .. tostring(movedCount) .. " bots=" .. tostring(botCount) .. " elapsed=" .. tostring(math.floor((_UtilLogic.ServerElapsedSeconds - startedAt) * 100) * 0.01))
			roomGraph = self:GenerateRoomGraph(matchRoom, owner)
			if roomGraph == nil then
				self:ReturnPlayersToLobby(matchRoom, owner)
				return self:CreateResult(false, targetMapName, movedCount, "Room graph generation failed")
			end
			log("[BRBattleLauncher] launch graph ready match=" .. self:ReadString(matchRoom.MatchId, "") .. " elapsed=" .. tostring(math.floor((_UtilLogic.ServerElapsedSeconds - startedAt) * 100) * 0.01))
			self:SchedulePrepareSupplies(matchRoom, roomGraph, targetMapName)
			self:ScheduleBattleSystems(matchRoom.MatchId, loadingSeconds)
		else
			self:NotifyMatchLoadingClosed(matchRoom)
		end

		local result = self:CreateResult(true, targetMapName, movedCount, "")
		result.BotCount = botCount
		result.RoomKey = self:ReadString(matchRoom.RoomKey, "")
		result.InstanceRoomKey = self:ReadString(matchRoom.InstanceRoomKey, "")
		result.RoomCreateAttempts = self:ReadNumber(matchRoom.RoomCreateAttempts, 0)
		if roomGraph ~= nil then
			self:ApplyRoomGraphToResult(result, roomGraph)
		end
		return result
	end

	method any CreateResult(boolean success, string targetMapName, number movedCount, string error)
		-- Creates the launch result table consumed by the lobby matchmaker.
		return {
			Success = success,
			TargetMapName = self:ReadString(targetMapName, ""),
			MovedCount = movedCount,
			BotCount = 0,
			Error = self:ReadString(error, ""),
			RoomGraphSummary = "",
			RoomGraphRoomCount = 0,
			RoomGraphConnectionCount = 0,
			RoomGraphAssignmentCount = 0,
			RoomKey = "",
			InstanceRoomKey = "",
			RoomCreateAttempts = 0,
			Pending = false
		}
	end

	@ExecSpace("ServerOnly")
	method any EnsureBattleInstanceRoom(any matchRoom, any owner, string targetMapName)
		-- Attempts to create the per-match instance room once and reports whether a timer retry is needed.
		if self:ShouldUseInstanceBattleRooms(owner) ~= true then
			return {
				Success = true,
				RoomKey = "",
				Attempts = 0,
				Error = "",
				Retry = false
			}
		end
		if matchRoom == nil then
			return {
				Success = false,
				RoomKey = "",
				Attempts = 0,
				Error = "MatchRoom is nil",
				Retry = false
			}
		end
		if _RoomService == nil then
			return {
				Success = false,
				RoomKey = "",
				Attempts = 0,
				Error = "RoomService is missing",
				Retry = false
			}
		end

		local safeMapName = self:ReadString(targetMapName, "")
		if safeMapName == "" then
			return {
				Success = false,
				RoomKey = "",
				Attempts = 0,
				Error = "Target map is empty",
				Retry = false
			}
		end

		local roomKey = self:GetBattleInstanceRoomKey(matchRoom)
		if roomKey == "" then
			return {
				Success = false,
				RoomKey = "",
				Attempts = 0,
				Error = "Instance room key is empty",
				Retry = false
			}
		end

		matchRoom.RoomKey = roomKey
		matchRoom.InstanceRoomKey = roomKey
		local maps = { safeMapName }
		local attempt = self:ReadNumber(matchRoom.RoomCreateAttempts, 0) + 1
		local maxAttempts = self:GetInstanceRoomCreateMaxAttempts(owner)
		local firstUserWaitSeconds = self:GetInstanceRoomFirstUserWaitSeconds(owner)
		matchRoom.RoomCreateAttempts = attempt

		local existingRoom = self:GetExistingInstanceRoom(roomKey)
		if existingRoom ~= nil and existingRoom:IsValid() == true then
			log("[BRBattleLauncher] instance room already ready key=" .. roomKey .. " map=" .. safeMapName .. " attempts=" .. tostring(attempt))
			return {
				Success = true,
				RoomKey = roomKey,
				Attempts = attempt,
				Error = "",
				Retry = false
			}
		end

		local instanceRoom = _RoomService:CreateInstanceRoom(roomKey, maps, firstUserWaitSeconds)
		if instanceRoom ~= nil and instanceRoom:IsValid() == true then
			log("[BRBattleLauncher] instance room created key=" .. roomKey .. " map=" .. safeMapName .. " attempts=" .. tostring(attempt) .. " firstUserWait=" .. tostring(firstUserWaitSeconds))
			return {
				Success = true,
				RoomKey = roomKey,
				Attempts = attempt,
				Error = "",
				Retry = false
			}
		end

		local shouldRetry = maxAttempts <= 0 or attempt < maxAttempts
		log("[BRBattleLauncher] instance room create failed key=" .. roomKey .. " map=" .. safeMapName .. " attempt=" .. tostring(attempt) .. " retry=" .. tostring(shouldRetry))
		return {
			Success = false,
			RoomKey = roomKey,
			Attempts = attempt,
			Error = "Instance room creation failed after " .. tostring(attempt) .. " attempts",
			Retry = shouldRetry
		}
	end

	@ExecSpace("ServerOnly")
	method boolean ScheduleBattleInstanceRoomRetry(any matchRoom, any owner, string targetMapName, any roomCreateResult)
		-- Schedules the next room creation attempt without relying on undocumented blocking wait calls.
		if _TimerService == nil then
			log("[BRBattleLauncher] instance room retry skipped: TimerService missing")
			return false
		end
		local retrySeconds = self:GetInstanceRoomRetrySeconds(owner)
		local roomKey = ""
		local attempts = 0
		if roomCreateResult ~= nil then
			roomKey = self:ReadString(roomCreateResult.RoomKey, "")
			attempts = self:ReadNumber(roomCreateResult.Attempts, 0)
		end
		log("[BRBattleLauncher] instance room retry scheduled key=" .. roomKey .. " map=" .. self:ReadString(targetMapName, "") .. " attempts=" .. tostring(attempts) .. " retryIn=" .. tostring(retrySeconds))
		local timerId = _TimerService:SetTimerOnce(function()
			self:RetryStartMatchRoomAfterInstanceRoomDelay(matchRoom, owner)
		end, retrySeconds)
		if timerId <= 0 then
			log("[BRBattleLauncher] instance room retry timer failed key=" .. roomKey)
			return false
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method void RetryStartMatchRoomAfterInstanceRoomDelay(any matchRoom, any owner)
		-- Re-enters battle launch after a failed room creation attempt and reports the final result to the matchmaker.
		local result = self:StartMatchRoom(matchRoom, owner)
		if result == nil or result.Pending == true then
			return
		end
		if owner == nil then
			log("[BRBattleLauncher] instance room retry completed without owner callback")
			return
		end
		owner:CompleteMatchLaunch(matchRoom, matchRoom.PendingTickets, result)
	end

	method any GetExistingInstanceRoom(string roomKey)
		-- Reads an already-created instance room from RoomService by key.
		local safeRoomKey = self:ReadString(roomKey, "")
		if safeRoomKey == "" or _RoomService == nil or _RoomService.InstanceRooms == nil then
			return nil
		end
		return _RoomService.InstanceRooms[safeRoomKey]
	end

	method string GetBattleInstanceRoomKey(any matchRoom)
		-- Builds the stable RoomService key used to isolate one battle match.
		if matchRoom == nil then
			return ""
		end
		local matchId = self:ReadString(matchRoom.MatchId, "")
		if matchId == "" then
			matchId = _UtilLogic:NewGuid()
			matchRoom.MatchId = matchId
		end
		return "battle_" .. matchId
	end

	method boolean ShouldUseInstanceBattleRooms(any owner)
		-- Reads whether battle launches should create an isolated RoomService instance room.
		local value = self.UseInstanceBattleRooms
		if owner ~= nil and owner.UseInstanceBattleRooms ~= nil then
			value = owner.UseInstanceBattleRooms
		end
		return value == true
	end

	method number GetInstanceRoomFirstUserWaitSeconds(any owner)
		-- Reads how long an empty created instance room should wait for its first entering user.
		local value = self.InstanceRoomFirstUserWaitSeconds
		if owner ~= nil and owner.InstanceRoomFirstUserWaitSeconds ~= nil then
			value = owner.InstanceRoomFirstUserWaitSeconds
		end
		return math.max(1, self:ReadNumber(value, 30))
	end

	method number GetInstanceRoomRetrySeconds(any owner)
		-- Reads the paced retry interval used when RoomService room creation returns nil or invalid.
		local value = self.InstanceRoomRetrySeconds
		if owner ~= nil and owner.InstanceRoomRetrySeconds ~= nil then
			value = owner.InstanceRoomRetrySeconds
		end
		return math.max(0.25, self:ReadNumber(value, 1))
	end

	method number GetInstanceRoomCreateMaxAttempts(any owner)
		-- Reads the retry cap; zero or below means retry forever until creation succeeds.
		local value = self.InstanceRoomCreateMaxAttempts
		if owner ~= nil and owner.InstanceRoomCreateMaxAttempts ~= nil then
			value = owner.InstanceRoomCreateMaxAttempts
		end
		return math.floor(self:ReadNumber(value, 0))
	end

	@ExecSpace("ServerOnly")
	method any GenerateRoomGraph(any matchRoom, any owner)
		-- Delegates logical room graph creation to the graph generator.
		if _BRRoomGraphGenerator == nil then
			log("[BRBattleLauncher] room graph skipped: generator missing")
			return nil
		end
		return _BRRoomGraphGenerator:CreateGraphForMatch(matchRoom, owner)
	end

	method void ApplyRoomGraphToResult(any result, any roomGraph)
		-- Copies graph summary fields into the launch result.
		if result == nil or roomGraph == nil then
			return
		end
		result.RoomGraphSummary = self:ReadString(roomGraph.Summary, "")
		result.RoomGraphRoomCount = self:ReadNumber(roomGraph.RoomCount, #roomGraph.Rooms)
		result.RoomGraphConnectionCount = self:ReadNumber(roomGraph.ConnectionCount, 0)
		result.RoomGraphAssignmentCount = self:ReadNumber(roomGraph.AssignmentCount, 0)
	end

	@ExecSpace("ServerOnly")
	method void RegisterActiveMatch(any matchRoom, any owner, string targetMapName, number loadingSeconds)
		-- Stores the active match so map-local battle logic can finish it later.
		if matchRoom == nil then
			return
		end

		self:EnsureRuntimeTables()
		local matchId = self:ReadString(matchRoom.MatchId, "")
		local safeMapName = self:ReadString(targetMapName, "")
		if matchId == "" or safeMapName == "" then
			return
		end

		local entry = {
			MatchId = matchId,
			MatchRoom = matchRoom,
			Owner = owner,
			TargetMapName = safeMapName,
			LoadingSeconds = self:ReadNumber(loadingSeconds, 0),
			LoadingTimerId = 0,
			RegisteredAt = _UtilLogic.ServerElapsedSeconds,
			StartSequenceStarted = false,
			Started = false,
			Finished = false
		}
		self._T.activeMatchesByMap[safeMapName] = entry
		self._T.activeMatchesById[matchId] = entry
		log("[BRBattleLauncher] active match registered id=" .. matchId .. " map=" .. safeMapName .. " loading=" .. tostring(entry["LoadingSeconds"]))
	end

	@ExecSpace("ServerOnly")
	method void UnregisterActiveMatch(string matchId, string targetMapName)
		-- Removes a match from the active runtime registries.
		self:EnsureRuntimeTables()
		local safeMatchId = self:ReadString(matchId, "")
		local safeMapName = self:ReadString(targetMapName, "")

		local entry = {}
		local hasEntry = false
		if safeMatchId ~= "" then
			local idEntry = self._T.activeMatchesById[safeMatchId]
			if idEntry ~= nil then
				entry = idEntry
				hasEntry = true
			end
		end
		if hasEntry == false and safeMapName ~= "" then
			local mapEntry = self._T.activeMatchesByMap[safeMapName]
			if mapEntry ~= nil then
				entry = mapEntry
				hasEntry = true
			end
		end
		if hasEntry == true then
			local loadingTimerId = math.floor(self:ReadNumber(entry["LoadingTimerId"], 0))
			if loadingTimerId > 0 then
				_TimerService:ClearTimer(loadingTimerId)
				entry["LoadingTimerId"] = 0
			end
			safeMatchId = self:ReadString(entry["MatchId"], safeMatchId)
			safeMapName = self:ReadString(entry["TargetMapName"], safeMapName)
		end

		if safeMatchId ~= "" then
			self._T.activeMatchesById[safeMatchId] = nil
		end
		if safeMapName ~= "" then
			self._T.activeMatchesByMap[safeMapName] = nil
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsActiveMatchForMap(string targetMapName)
		-- Lets map-scoped battle logic ignore direct editor/map tests.
		self:EnsureRuntimeTables()
		local safeMapName = self:ReadString(targetMapName, "")
		if safeMapName == "" then
			return false
		end

		local entry = self._T.activeMatchesByMap[safeMapName]
		return entry ~= nil and entry["Finished"] ~= true
	end

	@ExecSpace("ServerOnly")
	method boolean IsBattleGameplayStartedForMap(string targetMapName)
		-- Returns true only after the countdown/start-effect gate has opened gameplay.
		self:EnsureRuntimeTables()
		local safeMapName = self:ReadString(targetMapName, "")
		if safeMapName == "" then
			return false
		end

		local entry = self._T.activeMatchesByMap[safeMapName]
		return entry ~= nil and entry["Finished"] ~= true and entry["Started"] == true
	end

	@ExecSpace("ServerOnly")
	method void ScheduleBattleSystems(string matchId, number loadingSeconds)
		-- Defers the start presentation until loading, curtain hold, and pre-countdown gap finish.
		self:EnsureRuntimeTables()
		local safeMatchId = self:ReadString(matchId, "")
		local entry = self._T.activeMatchesById[safeMatchId]
		if entry == nil then
			return
		end

		local loadingDelay = math.max(0, self:ReadNumber(loadingSeconds, 0))
		local curtainDelay = self:GetPostLoadingCurtainSeconds(entry["Owner"])
		local preCountdownDelay = self:GetPreCountdownDelaySeconds(entry["Owner"])
		local delay = loadingDelay + curtainDelay + preCountdownDelay
		if delay <= 0 then
			self:StartRegisteredBattleSystems(safeMatchId)
			return
		end

		entry["LoadingTimerId"] = _TimerService:SetTimerOnce(function() self:StartRegisteredBattleSystems(safeMatchId) end, delay)
		log("[BRBattleLauncher] battle start presentation scheduled id=" .. safeMatchId .. " loading=" .. tostring(loadingDelay) .. " curtain=" .. tostring(curtainDelay) .. " preCountdown=" .. tostring(preCountdownDelay) .. " delay=" .. tostring(delay))
	end

	@ExecSpace("ServerOnly")
	method void StartRegisteredBattleSystems(string matchId)
		-- Starts the 3-2-1 countdown presentation after the loading curtain is gone.
		self:EnsureRuntimeTables()
		local safeMatchId = self:ReadString(matchId, "")
		local entry = self._T.activeMatchesById[safeMatchId]
		if entry == nil or entry["Finished"] == true then
			return
		end
		if entry["Started"] == true then
			return
		end
		if entry["StartSequenceStarted"] == true then
			return
		end

		entry["LoadingTimerId"] = 0
		entry["StartSequenceStarted"] = true
		self:PrepareBattleTimer(entry["MatchRoom"], entry["Owner"], entry["TargetMapName"])
		self:NotifyBattleStartCountdown(entry["MatchRoom"])

		local delay = self:GetBattleStartCountdownSeconds(entry["Owner"])
		if delay <= 0 then
			self:NotifyBattleStartEffectAndScheduleComplete(safeMatchId)
			return
		end

		entry["LoadingTimerId"] = _TimerService:SetTimerOnce(function() self:NotifyBattleStartEffectAndScheduleComplete(safeMatchId) end, delay)
		log("[BRBattleLauncher] countdown scheduled id=" .. safeMatchId .. " delay=" .. tostring(delay))
	end

	@ExecSpace("ServerOnly")
	method void NotifyBattleStartEffectAndScheduleComplete(string matchId)
		-- Plays the START animation first, then schedules actual gameplay unlock.
		self:EnsureRuntimeTables()
		local safeMatchId = self:ReadString(matchId, "")
		local entry = self._T.activeMatchesById[safeMatchId]
		if entry == nil or entry["Finished"] == true then
			return
		end
		if entry["Started"] == true then
			return
		end

		entry["LoadingTimerId"] = 0
		self:NotifyMatchStarted(entry["MatchRoom"])
		self:StartBattleTimer(entry["MatchRoom"], entry["Owner"], entry["TargetMapName"])

		local delay = self:GetBattleStartEffectSeconds(entry["Owner"])
		if delay <= 0 then
			self:CompleteBattleStartSequence(safeMatchId)
			return
		end

		entry["LoadingTimerId"] = _TimerService:SetTimerOnce(function() self:CompleteBattleStartSequence(safeMatchId) end, delay)
		log("[BRBattleLauncher] start effect scheduled id=" .. safeMatchId .. " delay=" .. tostring(delay))
	end

	@ExecSpace("ServerOnly")
	method void CompleteBattleStartSequence(string matchId)
		-- Opens gameplay after the 3-2-1 countdown and START animation have finished.
		self:EnsureRuntimeTables()
		local safeMatchId = self:ReadString(matchId, "")
		local entry = self._T.activeMatchesById[safeMatchId]
		if entry == nil or entry["Finished"] == true then
			return
		end
		if entry["Started"] == true then
			return
		end

		entry["LoadingTimerId"] = 0
		entry["Started"] = true
		self:StartMagneticZone(entry["MatchRoom"], entry["Owner"], entry["TargetMapName"])
		self:StartBattleMonsters(entry["TargetMapName"])
		self:MarkMatchPlaying(entry["MatchRoom"], entry["Owner"])
		self:NotifyBattleGameplayOpened(entry["MatchRoom"])
		log("[BRBattleLauncher] battle systems started id=" .. safeMatchId .. " map=" .. self:ReadString(entry["TargetMapName"], ""))
	end

	@ExecSpace("ServerOnly")
	method void MarkMatchPlaying(any matchRoom, any owner)
		-- Marks the lobby room state as Playing once the loading gate opens.
		if matchRoom == nil or owner == nil then
			return
		end
		owner:MarkMatchPlaying(matchRoom)
	end

	method string ResolveTargetMapForRoom(any matchRoom, any owner)
		-- Resolves the fixed physical map that will host this match.
		if matchRoom == nil then
			return ""
		end

		local explicitTargetMapName = self:ReadString(matchRoom.TargetMapName, "")
		if explicitTargetMapName ~= "" then
			return explicitTargetMapName
		end

		local fallbackMapName = "RoomTestMap"
		if owner ~= nil then
			fallbackMapName = self:ReadString(owner.GatherMapName, fallbackMapName)
		end
		return self:ReadString(matchRoom.SourceMapName, fallbackMapName)
	end

	@ExecSpace("ServerOnly")
	method number MovePlayersToMatchRoom(any matchRoom, any owner)
		-- Moves selected players into their fixed corner battle start slots.
		local movedCount = 0
		if matchRoom == nil or matchRoom.Players == nil then
			return movedCount
		end

		local targetMapName = self:ResolveTargetMapForRoom(matchRoom, owner)
		if targetMapName == "" then
			log("[BRBattleLauncher] move skipped: empty target map")
			return movedCount
		end
		
		local total = #matchRoom.Players
		self:EnsurePhysicalGrid(targetMapName)
		for index, player in ipairs(matchRoom.Players) do
			local playerEntity = _UserService:GetUserEntityByUserId(player.UserId)
			if playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
				local requestedSpawnIndex = self:ReadNumber(player.SpawnIndex, index)
				local spawnIndex = math.max(1, math.floor(self:ReadNumber(requestedSpawnIndex, movedCount + 1)))
				local spawnPosition = self:GetSpawnPosition(matchRoom, spawnIndex, total, owner)
				local spawnCornerName = self:GetStartCornerRoomName(spawnIndex)
				self:ResetPlayerSkillStateForBattle(playerEntity, self:ReadString(matchRoom.MatchId, ""))
				self:MovePlayerToBattleStart(playerEntity, targetMapName, spawnPosition, spawnIndex)
				self:SetGatherName(player.UserId, spawnIndex, total)
				player.SpawnIndex = spawnIndex
				player.SpawnCornerName = spawnCornerName
				player.SpawnPositionX = spawnPosition.x
				player.SpawnPositionY = spawnPosition.y
				player.State = "Arrived"
				player.ArrivedAt = _UtilLogic.ServerElapsedSeconds
				movedCount = movedCount + 1
				log("[BRBattleLauncher] start assigned user=" .. tostring(player.UserId) .. " requestedSlot=" .. tostring(requestedSpawnIndex) .. " slot=" .. tostring(spawnIndex) .. " corner=" .. spawnCornerName .. " pos=(" .. tostring(spawnPosition.x) .. "," .. tostring(spawnPosition.y) .. ")")
			end
		end
		log("[BRBattleLauncher] moved players to fixed map: map=" .. targetMapName .. " count=" .. tostring(movedCount) .. "/" .. tostring(total))
		return movedCount
	end

	@ExecSpace("ServerOnly")
	method void ResetPlayerSkillStateForBattle(Entity playerEntity, string matchId)
		if _BRSkillSystem == nil or playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end
		local userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
		if userId == "" then
			return
		end
		_BRSkillSystem:ResetUserForBattle(userId)
		log("[BRBattleLauncher] skill battle reset user=" .. userId .. " match=" .. self:ReadString(matchId, ""))
	end

	@ExecSpace("ServerOnly")
	method number SpawnBattleBotsForMatchRoom(any matchRoom, any owner, number movedPlayerCount, string targetMapName)
		-- Fills empty match slots with BT-controlled AI competitors.
		if self.EnableBattleBots ~= true then
			return 0
		end
		if matchRoom == nil then
			return 0
		end

		local safeMapName = self:ReadString(targetMapName, self:ResolveTargetMapForRoom(matchRoom, owner))
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. safeMapName)
		if mapEntity == nil then
			log("[BRBattleLauncher] bot spawn skipped: map missing " .. safeMapName)
			return 0
		end

		local targetCount = self:GetTargetPlayerCountForBots(matchRoom, owner)
		local humanCount = math.max(0, math.floor(self:ReadNumber(movedPlayerCount, 0)))
		local botCount = math.min(self:GetBattleBotMaxFillCount(owner), math.max(0, targetCount - humanCount))
		if botCount <= 0 then
			return 0
		end

		matchRoom.Bots = {}
		local spawned = 0
		for index = 1, botCount do
			local slotIndex = self:GetStartCornerSlotIndex(humanCount + index)
			local spawnPosition = self:GetSpawnPosition(matchRoom, slotIndex, targetCount, owner)
			local botId = "AI_" .. self:GetShortMatchId(matchRoom) .. "_" .. tostring(index)
			local entityName = "BattleBot_" .. tostring(index)
			local botEntity = _SpawnService:SpawnByModelId(self:GetBattleBotModelId(owner), entityName, Vector3(spawnPosition.x, spawnPosition.y, 0), mapEntity)
			if botEntity ~= nil then
				local bot = self:GetBattleBotController(botEntity)
				if bot ~= nil then
					bot:InitializeBattleBot(botId, spawnPosition, self:GetBattleBotMaxHp(owner), self:GetBattleBotLives(owner))
					spawned = spawned + 1
					table.insert(matchRoom.Bots, {
						BotId = botId,
						SpawnIndex = slotIndex,
						SpawnPositionX = spawnPosition.x,
						SpawnPositionY = spawnPosition.y
					})
					log("[BRBattleLauncher] bot spawned id=" .. botId .. " slot=" .. tostring(slotIndex) .. " map=" .. safeMapName .. " pos=(" .. tostring(spawnPosition.x) .. "," .. tostring(spawnPosition.y) .. ")")
				else
					log("[BRBattleLauncher] bot spawn missing component entity=" .. entityName)
					botEntity:Destroy()
				end
			else
				log("[BRBattleLauncher] bot spawn failed model=" .. self:GetBattleBotModelId(owner) .. " map=" .. safeMapName)
			end
		end
		return spawned
	end

	@ExecSpace("ServerOnly")
	method void ClearBattleBots(string targetMapName)
		-- Removes runtime-spawned AI competitors when a match ends.
		local safeMapName = self:ReadString(targetMapName, "")
		if safeMapName == "" then
			return
		end
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. safeMapName)
		if mapEntity == nil then
			return
		end
		local botComponents = mapEntity:GetChildComponentsByTypeName("script.BRBattleBotController", true)
		if botComponents == nil then
			return
		end
		for index, bot in ipairs(botComponents) do
			if bot ~= nil and bot.Entity ~= nil then
				bot.Entity:Destroy()
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void EnsurePhysicalGrid(string targetMapName)
		-- Ensures fixed physical room parts exist before portals, supplies, or player starts use them.
		local gridTool = self:GetGridMapEditorTool(targetMapName)
		if gridTool == nil then
			log("[BRBattleLauncher] physical grid sync skipped: grid tool missing map=" .. self:ReadString(targetMapName, ""))
			return
		end
		gridTool:SyncGeneratedGrid(true, false, "launch grid")
	end

	@ExecSpace("ServerOnly")
	method void MovePlayerToBattleStart(Entity playerEntity, string targetMapName, Vector2 spawnPosition, number spawnIndex)
		-- Uses TeleportService first because release authority checks can block direct PlayerComponent map travel.
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end

		local userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
		local safeMapName = self:ReadString(targetMapName, "")
		local slotIndex = self:GetStartCornerSlotIndex(spawnIndex)
		if safeMapName == "" then
			return
		end

		playerEntity.PlayerComponent.RespawnPosition = Vector3(spawnPosition.x, spawnPosition.y, 0)
		self:TeleportPlayerToMapPosition(playerEntity, safeMapName, spawnPosition, "battle-start")
		log("[BRBattleLauncher] start map teleport requested user=" .. userId .. " slot=" .. tostring(slotIndex) .. " from=" .. self:ReadString(playerEntity.CurrentMapName, "") .. " map=" .. safeMapName .. " pos=(" .. tostring(spawnPosition.x) .. "," .. tostring(spawnPosition.y) .. ")")
		if userId ~= "" then
			_TimerService:SetTimerOnce(function()
				self:ConfirmBattleStartArrival(userId, safeMapName, spawnPosition, slotIndex, 1)
			end, 0.35)
			_TimerService:SetTimerOnce(function()
				self:ConfirmBattleStartArrival(userId, safeMapName, spawnPosition, slotIndex, 2)
			end, 1.2)
		end
	end

	@ExecSpace("ServerOnly")
	method void ConfirmBattleStartArrival(string userId, string targetMapName, Vector2 spawnPosition, number spawnIndex, number attempt)
		-- Confirms release map travel and applies the final body-position correction after the map switch lands.
		local safeUserId = self:ReadString(userId, "")
		local safeMapName = self:ReadString(targetMapName, "")
		if safeUserId == "" or safeMapName == "" then
			return
		end
		self:EnsureRuntimeTables()
		local activeEntry = self._T.activeMatchesByMap[safeMapName]
		if activeEntry == nil or activeEntry["Finished"] == true then
			log("[BRBattleLauncher] battle start arrival skipped user=" .. safeUserId .. " map=" .. safeMapName .. " attempt=" .. tostring(attempt) .. " reason=inactive match")
			return
		end

		local playerEntity = _UserService:GetUserEntityByUserId(safeUserId)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			log("[BRBattleLauncher] battle start arrival skipped user=" .. safeUserId .. " attempt=" .. tostring(attempt) .. " reason=entity nil")
			return
		end

		local currentMapName = self:ReadString(playerEntity.CurrentMapName, "")
		if currentMapName ~= safeMapName then
			if self:ReadNumber(attempt, 1) <= 1 then
				log("[BRBattleLauncher] battle start arrival retry user=" .. safeUserId .. " attempt=" .. tostring(attempt) .. " current=" .. currentMapName .. " target=" .. safeMapName)
				self:TeleportPlayerToMapPosition(playerEntity, safeMapName, spawnPosition, "battle-start-retry")
			else
				log("[BRBattleLauncher] battle start arrival failed user=" .. safeUserId .. " attempt=" .. tostring(attempt) .. " current=" .. currentMapName .. " target=" .. safeMapName)
			end
			return
		end

		playerEntity.PlayerComponent.RespawnPosition = Vector3(spawnPosition.x, spawnPosition.y, 0)
		self:ApplyPlayerWorldPosition(playerEntity, spawnPosition, "battle-start-confirm")
		self:ApplyLocalPlayerWorldPosition(spawnPosition, "battle-start-confirm", safeUserId)
		log("[BRBattleLauncher] battle start arrived user=" .. safeUserId .. " slot=" .. tostring(spawnIndex) .. " map=" .. safeMapName .. " pos=(" .. tostring(spawnPosition.x) .. "," .. tostring(spawnPosition.y) .. ") attempt=" .. tostring(attempt))
	end

	@ExecSpace("ServerOnly")
	method void TeleportPlayerToMapPosition(Entity playerEntity, string targetMapName, Vector2 targetPosition, string reason)
		-- TeleportService moves the entity itself to the target map/position; PlayerComponent travel is kept as fallback.
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end

		local safeMapName = self:ReadString(targetMapName, "")
		if safeMapName == "" then
			return
		end

		if _TeleportService ~= nil then
			_TeleportService:TeleportToMapPosition(playerEntity, Vector3(targetPosition.x, targetPosition.y, 0), safeMapName)
			log("[BRBattleLauncher] teleport service reason=" .. self:ReadString(reason, "") .. " user=" .. self:ReadString(playerEntity.PlayerComponent.UserId, "") .. " map=" .. safeMapName .. " pos=(" .. tostring(targetPosition.x) .. "," .. tostring(targetPosition.y) .. ")")
			return
		end

		playerEntity.PlayerComponent:MoveToMapPosition(safeMapName, targetPosition)
		log("[BRBattleLauncher] player move fallback reason=" .. self:ReadString(reason, "") .. " user=" .. self:ReadString(playerEntity.PlayerComponent.UserId, "") .. " map=" .. safeMapName .. " pos=(" .. tostring(targetPosition.x) .. "," .. tostring(targetPosition.y) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void ApplyPlayerWorldPositionByUserId(string userId, Vector2 spawnPosition, string phase)
		-- Re-resolves the current player entity before applying a delayed battle start position.
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end

		local currentPlayerEntity = _UserService:GetUserEntityByUserId(safeUserId)
		if currentPlayerEntity == nil then
			log("[BRBattleLauncher] force start position skipped phase=" .. self:ReadString(phase, "") .. " user=" .. safeUserId .. " reason=entity nil")
			return
		end
		self:ApplyPlayerWorldPosition(currentPlayerEntity, spawnPosition, phase)
		self:ApplyLocalPlayerWorldPosition(spawnPosition, self:ReadString(phase, ""), safeUserId)
	end

	@ExecSpace("Client")
	method void ApplyLocalPlayerWorldPosition(Vector2 spawnPosition, string phase)
		-- Mirrors the server-side battle start teleport on the owning client so local movement authority does not pull it back.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return
		end

		local appliedBy = ""
		if localPlayer.MovementComponent ~= nil then
			localPlayer.MovementComponent:Stop()
			localPlayer.MovementComponent:SetWorldPosition(spawnPosition)
			appliedBy = appliedBy .. "Movement"
		end

		if localPlayer.RigidbodyComponent ~= nil then
			localPlayer.RigidbodyComponent.IgnoreMoveBoundary = true
			localPlayer.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			localPlayer.RigidbodyComponent:SetWorldPosition(spawnPosition)
			localPlayer.RigidbodyComponent:PositionReset()
			appliedBy = appliedBy .. "+Rigidbody"
		elseif localPlayer.KinematicbodyComponent ~= nil then
			localPlayer.KinematicbodyComponent:SetWorldPosition(spawnPosition)
			appliedBy = appliedBy .. "+Kinematicbody"
		elseif localPlayer.SideviewbodyComponent ~= nil then
			localPlayer.SideviewbodyComponent:SetWorldPosition(spawnPosition)
			appliedBy = appliedBy .. "+Sideviewbody"
		end

		if localPlayer.PlayerComponent ~= nil then
			localPlayer.PlayerComponent:SetWorldPosition(Vector3(spawnPosition.x, spawnPosition.y, 0))
			appliedBy = appliedBy .. "+Player"
		end

		local currentPosition = Vector3(0, 0, 0)
		if localPlayer.TransformComponent ~= nil then
			currentPosition = localPlayer.TransformComponent.WorldPosition
		end
		log("[BRBattleLauncher] local start position phase=" .. self:ReadString(phase, "") .. " map=" .. self:ReadString(localPlayer.CurrentMapName, "") .. " target=(" .. tostring(spawnPosition.x) .. "," .. tostring(spawnPosition.y) .. ") current=(" .. tostring(currentPosition.x) .. "," .. tostring(currentPosition.y) .. ") by=" .. appliedBy)
	end

	@ExecSpace("ServerOnly")
	method void ApplyPlayerWorldPosition(Entity playerEntity, Vector2 spawnPosition, string phase)
		-- Applies the assigned start position to the real movement/body component, not only the map-transfer request.
		if playerEntity == nil then
			return
		end

		local appliedBy = ""
		if playerEntity.MovementComponent ~= nil then
			playerEntity.MovementComponent:Stop()
			playerEntity.MovementComponent:SetWorldPosition(spawnPosition)
			appliedBy = appliedBy .. "Movement"
		end

		if playerEntity.RigidbodyComponent ~= nil then
			playerEntity.RigidbodyComponent.IgnoreMoveBoundary = true
			playerEntity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			playerEntity.RigidbodyComponent:SetWorldPosition(spawnPosition)
			playerEntity.RigidbodyComponent:PositionReset()
			appliedBy = appliedBy .. "+Rigidbody"
		elseif playerEntity.KinematicbodyComponent ~= nil then
			playerEntity.KinematicbodyComponent:SetWorldPosition(spawnPosition)
			appliedBy = appliedBy .. "+Kinematicbody"
		elseif playerEntity.SideviewbodyComponent ~= nil then
			playerEntity.SideviewbodyComponent:SetWorldPosition(spawnPosition)
			appliedBy = appliedBy .. "+Sideviewbody"
		end

		if playerEntity.PlayerComponent ~= nil then
			playerEntity.PlayerComponent:SetWorldPosition(Vector3(spawnPosition.x, spawnPosition.y, 0))
			appliedBy = appliedBy .. "+Player"
		end

		local userId = ""
		if playerEntity.PlayerComponent ~= nil then
			userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
		end
		local mapName = ""
		if playerEntity.CurrentMapName ~= nil then
			mapName = self:ReadString(playerEntity.CurrentMapName, "")
		end

		local currentPosition = Vector3(0, 0, 0)
		if playerEntity.TransformComponent ~= nil then
			currentPosition = playerEntity.TransformComponent.WorldPosition
		end
		log("[BRBattleLauncher] force start position phase=" .. self:ReadString(phase, "") .. " user=" .. tostring(userId) .. " map=" .. mapName .. " target=(" .. tostring(spawnPosition.x) .. "," .. tostring(spawnPosition.y) .. ") current=(" .. tostring(currentPosition.x) .. "," .. tostring(currentPosition.y) .. ") by=" .. appliedBy)
	end

	@ExecSpace("ServerOnly")
	method number ReturnPlayersToLobby(any matchRoom, any owner)
		-- Returns match players to the configured lobby gather position.
		local movedCount = 0
		if matchRoom == nil or matchRoom.Players == nil then
			return movedCount
		end
		
		local lobbyMapName = "StartMap"
		local centerX = 0
		local centerY = 3
		if owner ~= nil then
			lobbyMapName = self:ReadString(owner.LobbyMapName, lobbyMapName)
			centerX = self:ReadNumber(owner.GatherCenterX, centerX)
			centerY = self:ReadNumber(owner.GatherCenterY, centerY)
		end
		for index, player in ipairs(matchRoom.Players) do
			local playerEntity = _UserService:GetUserEntityByUserId(player.UserId)
			if playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
				self:PreparePlayerForLobbyReturn(playerEntity, Vector2(centerX, centerY), "return-lobby")
				self:TeleportPlayerToMapPosition(playerEntity, lobbyMapName, Vector2(centerX, centerY), "return-lobby")
				player.State = "Returned"
				movedCount = movedCount + 1
			end
		end
		if movedCount > 0 then
			self:StopBattleTimer()
			self:StopMagneticZone()
			self:ClearPortalConnections(matchRoom)
			self:ClearSupplies(matchRoom, lobbyMapName)
			self:ClearBattleBots(self:ReadString(matchRoom.TargetMapName, ""))
			self:NotifyMatchLoadingClosed(matchRoom)
			self:UnregisterActiveMatch(self:ReadString(matchRoom.MatchId, ""), self:ReadString(matchRoom.TargetMapName, ""))
		end
		return movedCount
	end

	@ExecSpace("ServerOnly")
	method boolean ReturnEliminatedPlayerToLobby(string targetMapName, string userId, string reason)
		-- Returns one eliminated match participant to lobby without ending the whole match.
		self:EnsureRuntimeTables()
		local safeMapName = self:ReadString(targetMapName, "")
		local safeUserId = self:ReadString(userId, "")
		if safeMapName == "" or safeUserId == "" then
			return false
		end

		local entry = self._T.activeMatchesByMap[safeMapName]
		if entry == nil or entry["Finished"] == true then
			log("[BRBattleLauncher] eliminate return skipped: match missing map=" .. safeMapName .. " user=" .. safeUserId)
			return false
		end

		local playerRecord = self:FindMatchPlayerRecord(entry["MatchRoom"], safeUserId)
		if playerRecord == nil then
			log("[BRBattleLauncher] eliminate return skipped: player not in match user=" .. safeUserId .. " map=" .. safeMapName)
			return false
		end

		local playerEntity = _UserService:GetUserEntityByUserId(safeUserId)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			log("[BRBattleLauncher] eliminate return skipped: player entity missing user=" .. safeUserId)
			return false
		end

		local lobbyMapName = self:GetLobbyMapName(entry["Owner"])
		local lobbyPosition = self:GetLobbyReturnPosition(entry["Owner"])
		local elapsedSeconds = math.max(0, math.floor(_UtilLogic.ServerElapsedSeconds - self:ReadNumber(entry["RegisteredAt"], _UtilLogic.ServerElapsedSeconds)))
		local title = self:ReadString(self.MatchResultDefeatTitle, "DEFEAT")
		local body = self:BuildEliminatedResultBody(entry["MatchRoom"], safeUserId, self:ReadString(reason, "life-out"), elapsedSeconds)

		playerRecord.State = "EliminatedReturned"
		playerRecord.ResultShown = true
		playerRecord.EliminatedAt = _UtilLogic.ServerElapsedSeconds
		playerRecord.EliminatedReason = self:ReadString(reason, "life-out")

		self:HideMatchLoading("", safeUserId)
		self:PreparePlayerForLobbyReturn(playerEntity, lobbyPosition, "eliminated")
		self:TeleportPlayerToMapPosition(playerEntity, lobbyMapName, lobbyPosition, "eliminated")
		_TimerService:SetTimerOnce(function() self:ShowMatchResult(title, body, safeUserId) end, self:GetResultPopupDelaySeconds())
		log("[BRBattleLauncher] eliminated player returned user=" .. safeUserId .. " map=" .. safeMapName .. " lobby=" .. lobbyMapName .. " reason=" .. self:ReadString(reason, ""))
		return true
	end

	method any FindMatchPlayerRecord(any matchRoom, string userId)
		-- Finds a mutable player record inside a match room table.
		local safeUserId = self:ReadString(userId, "")
		if matchRoom == nil or matchRoom.Players == nil or safeUserId == "" then
			return nil
		end
		for index, player in ipairs(matchRoom.Players) do
			if self:ReadString(player.UserId, "") == safeUserId then
				return player
			end
		end
		return nil
	end

	method string GetLobbyMapName(any owner)
		-- Reads the configured lobby map name from the match owner.
		local lobbyMapName = "StartMap"
		if owner ~= nil then
			lobbyMapName = self:ReadString(owner.LobbyMapName, lobbyMapName)
		end
		return lobbyMapName
	end

	method Vector2 GetLobbyReturnPosition(any owner)
		-- Reads the configured lobby gather position from the match owner.
		local centerX = 0
		local centerY = 3
		if owner ~= nil then
			centerX = self:ReadNumber(owner.GatherCenterX, centerX)
			centerY = self:ReadNumber(owner.GatherCenterY, centerY)
		end
		return Vector2(centerX, centerY)
	end

	method void PreparePlayerForLobbyReturn(Entity playerEntity, Vector2 lobbyPosition, string reason)
		-- Clears battle death state before sending a player back to the lobby.
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end

		local playerComponent = playerEntity.PlayerComponent
		local userId = self:ReadString(playerComponent.UserId, "")
		local deadBefore = playerComponent:IsDead() == true or playerComponent.Hp <= 0
		local maxHp = math.max(1, math.floor(self:ReadNumber(playerComponent.MaxHp, 100)))

		if playerEntity.MovementComponent ~= nil then
			playerEntity.MovementComponent:Stop()
		end
		if playerEntity.RigidbodyComponent ~= nil then
			playerEntity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			playerEntity.RigidbodyComponent:PositionReset()
		end

		playerComponent.PVPMode = false
		playerComponent.RespawnDuration = 5
		playerComponent.RespawnPosition = Vector3(lobbyPosition.x, lobbyPosition.y, 0)
		playerComponent.Hp = maxHp
		if deadBefore == true then
			playerComponent:Respawn()
			playerComponent.Hp = maxHp
			playerComponent:ProcessRevive(userId)
		end
		log("[BRBattleLauncher] lobby return reset user=" .. userId .. " deadBefore=" .. tostring(deadBefore) .. " hp=" .. tostring(playerComponent.Hp) .. "/" .. tostring(maxHp) .. " reason=" .. self:ReadString(reason, ""))
	end

	@ExecSpace("ServerOnly")
	method void FinishMatchByMap(string targetMapName, string winnerUserId, string reason)
		-- Ends the active match for a map, returns players, and schedules result popups.
		self:EnsureRuntimeTables()
		local safeMapName = self:ReadString(targetMapName, "")
		if safeMapName == "" then
			return
		end

		local entry = self._T.activeMatchesByMap[safeMapName]
		if entry == nil then
			log("[BRBattleLauncher] finish skipped: active match missing map=" .. safeMapName .. " winner=" .. self:ReadString(winnerUserId, ""))
			return
		end
		if entry["Finished"] == true then
			return
		end

		entry["Finished"] = true
		if entry["LoadingTimerId"] ~= nil and entry["LoadingTimerId"] > 0 then
			_TimerService:ClearTimer(entry["LoadingTimerId"])
			entry["LoadingTimerId"] = 0
		end

		local elapsedSeconds = math.max(0, math.floor(_UtilLogic.ServerElapsedSeconds - self:ReadNumber(entry["RegisteredAt"], _UtilLogic.ServerElapsedSeconds)))
		self:NotifyMatchResults(entry["MatchRoom"], self:ReadString(winnerUserId, ""), self:ReadString(reason, "last-man"), elapsedSeconds)
		self:ClearBattleBots(safeMapName)
		local returnedCount = self:ReturnPlayersToLobby(entry["MatchRoom"], entry["Owner"])
		self:CompleteMatchRoom(entry["MatchRoom"], entry["Owner"], self:ReadString(winnerUserId, ""), self:ReadString(reason, "last-man"))
		self:UnregisterActiveMatch(self:ReadString(entry["MatchId"], ""), safeMapName)
		log("[BRBattleLauncher] match finished id=" .. self:ReadString(entry["MatchId"], "") .. " map=" .. safeMapName .. " winner=" .. self:ReadString(winnerUserId, "") .. " returned=" .. tostring(returnedCount) .. " reason=" .. self:ReadString(reason, ""))
	end

	@ExecSpace("ServerOnly")
	method void CompleteMatchRoom(any matchRoom, any owner, string winnerUserId, string reason)
		-- Notifies the lobby matchmaker that this match has ended.
		if owner == nil or matchRoom == nil then
			return
		end
		owner:CompleteMatch(matchRoom, self:ReadString(winnerUserId, ""), self:ReadString(reason, ""))
	end

	@ExecSpace("ServerOnly")
	method void NotifyMatchLoading(any matchRoom, any owner, number loadingSeconds)
		-- Shows the loading overlay to every selected player.
		if matchRoom == nil or matchRoom.Players == nil then
			return
		end

		local message = self:ReadString(self.MatchLoadingMessage, "MATCH LOADING...")
		local seconds = self:GetMatchLoadingSeconds(nil)
		if loadingSeconds ~= nil then
			seconds = self:ReadNumber(loadingSeconds, seconds)
		end
		local curtainSeconds = self:GetPostLoadingCurtainSeconds(owner)
		for index, player in ipairs(matchRoom.Players) do
			local userId = self:ReadString(player.UserId, "")
			if userId ~= "" then
				self:ShowMatchLoading(message, seconds, curtainSeconds, userId)
			end
		end
		log("[BRBattleLauncher] loading shown match=" .. self:ReadString(matchRoom.MatchId, "") .. " seconds=" .. tostring(seconds) .. " curtain=" .. tostring(curtainSeconds))
	end

	@ExecSpace("ServerOnly")
	method void NotifyMatchStarted(any matchRoom)
		-- Plays the START presentation before actual gameplay is unlocked.
		if matchRoom == nil or matchRoom.Players == nil then
			return
		end

		local message = self:ReadString(self.MatchStartMessage, "START!")
		local startEffectRuid = self:GetBattleStartEffectRUID(nil)
		local startScale = self:GetBattleStartEffectScale(nil)
		for index, player in ipairs(matchRoom.Players) do
			local userId = self:ReadString(player.UserId, "")
			if userId ~= "" then
				self:ShowBattleStartEffect(startEffectRuid, startScale, message, userId)
			end
		end
		log("[BRBattleLauncher] start effect notified match=" .. self:ReadString(matchRoom.MatchId, "") .. " ruid=" .. startEffectRuid)
	end

	@ExecSpace("ServerOnly")
	method void NotifyBattleGameplayOpened(any matchRoom)
		-- Releases local controls after the START presentation has finished.
		if matchRoom == nil or matchRoom.Players == nil then
			return
		end

		for index, player in ipairs(matchRoom.Players) do
			local userId = self:ReadString(player.UserId, "")
			if userId ~= "" then
				self:OpenBattleGameplay(userId)
			end
		end
		log("[BRBattleLauncher] gameplay opened match=" .. self:ReadString(matchRoom.MatchId, ""))
	end

	@ExecSpace("ServerOnly")
	method void NotifyBattleStartCountdown(any matchRoom)
		-- Closes the loading overlay, keeps input locked, and plays the 3-2-1 countdown.
		if matchRoom == nil or matchRoom.Players == nil then
			return
		end

		local countdownRuid = self:GetBattleStartCountdownEffectRUID(nil)
		local countdownSeconds = self:GetBattleStartCountdownSeconds(nil)
		local scale = self:GetBattleStartEffectScale(nil)
		for index, player in ipairs(matchRoom.Players) do
			local userId = self:ReadString(player.UserId, "")
			if userId ~= "" then
				self:ShowBattleStartCountdown(countdownRuid, countdownSeconds, scale, userId)
			end
		end
		log("[BRBattleLauncher] countdown effect notified match=" .. self:ReadString(matchRoom.MatchId, "") .. " ruid=" .. countdownRuid .. " seconds=" .. tostring(countdownSeconds))
	end

	@ExecSpace("ServerOnly")
	method void NotifyMatchLoadingClosed(any matchRoom)
		-- Hides loading overlays without showing a start toast.
		if matchRoom == nil or matchRoom.Players == nil then
			return
		end

		for index, player in ipairs(matchRoom.Players) do
			local userId = self:ReadString(player.UserId, "")
			if userId ~= "" then
				self:HideMatchLoading("", userId)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void NotifyMatchResults(any matchRoom, string winnerUserId, string reason, number elapsedSeconds)
		-- Schedules a result popup for every match participant after lobby return starts.
		if matchRoom == nil or matchRoom.Players == nil then
			return
		end

		local delay = self:GetResultPopupDelaySeconds()
		for index, player in ipairs(matchRoom.Players) do
			local userId = self:ReadString(player.UserId, "")
			if userId ~= "" and player.ResultShown ~= true then
				local title = self:GetResultTitle(userId, winnerUserId)
				local body = self:BuildResultBody(matchRoom, userId, winnerUserId, reason, elapsedSeconds)
				_TimerService:SetTimerOnce(function() self:ShowMatchResult(title, body, userId) end, delay)
			end
		end
	end

	method string GetResultTitle(string viewerUserId, string winnerUserId)
		-- Returns the result popup title for one participant.
		if self:ReadString(viewerUserId, "") ~= "" and self:ReadString(viewerUserId, "") == self:ReadString(winnerUserId, "") then
			return self:ReadString(self.MatchResultVictoryTitle, "VICTORY")
		end
		return self:ReadString(self.MatchResultDefeatTitle, "DEFEAT")
	end

	method string BuildResultBody(any matchRoom, string viewerUserId, string winnerUserId, string reason, number elapsedSeconds)
		-- Builds the compact battle result text shown after returning to lobby.
		local winnerName = self:GetPlayerDisplayName(winnerUserId)
		local rankText = "#2"
		if self:ReadString(winnerUserId, "") == "" then
			rankText = "N/A"
			winnerName = "NONE"
		elseif self:ReadString(viewerUserId, "") == self:ReadString(winnerUserId, "") then
			rankText = "#1"
		end

		return "RANK " .. rankText
			.. "\nWINNER " .. winnerName
			.. "\nMATCH " .. self:GetShortMatchId(matchRoom)
			.. "\nTIME " .. self:FormatSeconds(elapsedSeconds)
			.. "\nREASON " .. self:ReadString(reason, "last-man")
	end

	method string BuildEliminatedResultBody(any matchRoom, string viewerUserId, string reason, number elapsedSeconds)
		-- Builds the result text shown immediately when a player runs out of lives.
		return "RANK OUT"
			.. "\nWINNER PENDING"
			.. "\nMATCH " .. self:GetShortMatchId(matchRoom)
			.. "\nTIME " .. self:FormatSeconds(elapsedSeconds)
			.. "\nREASON " .. self:ReadString(reason, "life-out")
	end

	method string GetPlayerDisplayName(string userId)
		-- Returns nickname when available, otherwise falls back to the user id.
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return "NONE"
		end
		if string.sub(safeUserId, 1, 3) == "AI_" then
			return "AI BOT"
		end

		local playerEntity = _UserService:GetUserEntityByUserId(safeUserId)
		if playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
			local nickname = self:ReadString(playerEntity.PlayerComponent.Nickname, "")
			if nickname ~= "" then
				return nickname
			end
		end
		return safeUserId
	end

	method string GetShortMatchId(any matchRoom)
		-- Returns a short readable match id for the result popup.
		if matchRoom == nil then
			return "-"
		end
		local matchId = self:ReadString(matchRoom.MatchId, "")
		if string.len(matchId) <= 8 then
			return matchId
		end
		return string.sub(matchId, 1, 8)
	end

	method string FormatSeconds(number elapsedSeconds)
		-- Formats elapsed seconds as MM:SS.
		local total = math.max(0, math.floor(self:ReadNumber(elapsedSeconds, 0)))
		local minutes = math.floor(total / 60)
		local seconds = total - minutes * 60
		return string.format("%02d:%02d", minutes, seconds)
	end

	@ExecSpace("ServerOnly")
	method void SchedulePrepareSupplies(any matchRoom, any roomGraph, string targetMapName)
		-- Keeps supply setup from blocking player transfer and bot fill in release builds.
		if _BRSupplySystem == nil then
			log("[BRBattleLauncher] supply schedule skipped: supply system missing")
			return
		end
		local safeMapName = self:ReadString(targetMapName, "")
		local safeMatchId = ""
		if matchRoom ~= nil then
			safeMatchId = self:ReadString(matchRoom.MatchId, "")
		end
		_TimerService:SetTimerOnce(function()
			log("[BRBattleLauncher] supply prepare begin match=" .. safeMatchId .. " map=" .. safeMapName)
			self:PrepareSupplies(matchRoom, roomGraph, safeMapName)
			log("[BRBattleLauncher] supply prepare end match=" .. safeMatchId .. " map=" .. safeMapName)
		end, 0.05)
	end

	@ExecSpace("ServerOnly")
	method void PrepareSupplies(any matchRoom, any roomGraph, string targetMapName)
		-- Prepares room-child supply prefabs before players enter the battle map.
		if _BRSupplySystem == nil then
			log("[BRBattleLauncher] supply skipped: supply system missing")
			return
		end
		_BRSupplySystem:PrepareSuppliesForMatch(matchRoom, roomGraph, self:ReadString(targetMapName, ""))
	end

	@ExecSpace("ServerOnly")
	method void ClearSupplies(any matchRoom, string fallbackMapName)
		-- Clears supply prefabs when a battle ends or players return to lobby.
		if _BRSupplySystem == nil then
			return
		end

		local targetMapName = ""
		if matchRoom ~= nil then
			targetMapName = self:ReadString(matchRoom.TargetMapName, "")
		end
		if targetMapName == "" then
			targetMapName = self:ReadString(fallbackMapName, "")
		end
		_BRSupplySystem:ClearSuppliesForMap(targetMapName)
	end

	@ExecSpace("ServerOnly")
	method void StartBattleMonsters(string targetMapName)
		-- Spawns the first monster.csv row after gameplay opens.
		if _BRSupplySystem == nil then
			log("[BRBattleLauncher] monster start skipped: supply system missing")
			return
		end
		local safeMapName = self:ReadString(targetMapName, "")
		if safeMapName == "" then
			return
		end
		local count = _BRSupplySystem:StartMonstersForMap(safeMapName)
		log("[BRBattleLauncher] battle monsters started map=" .. safeMapName .. " count=" .. tostring(count))
	end

	@ExecSpace("ServerOnly")
	method void PrepareBattleTimer(any matchRoom, any owner, string targetMapName)
		-- Shows the synchronized timer before START, but keeps it frozen.
		if _BRBattleTimerSystem == nil then
			log("[BRBattleLauncher] timer prepare skipped: timer system missing")
			return
		end
		_BRBattleTimerSystem:PrepareTimer(self:GetBattleTimerSeconds(owner), self:ReadString(targetMapName, ""), self:GetBattleTimerLabel(owner))
	end

	@ExecSpace("ServerOnly")
	method void StartBattleTimer(any matchRoom, any owner, string targetMapName)
		-- Starts the synchronized boss timer when the START presentation appears.
		if _BRBattleTimerSystem == nil then
			log("[BRBattleLauncher] timer skipped: timer system missing")
			return
		end
		_BRBattleTimerSystem:StartTimer(self:GetBattleTimerSeconds(owner), self:ReadString(targetMapName, ""), self:GetBattleTimerLabel(owner))
	end

	@ExecSpace("ServerOnly")
	method void StopBattleTimer()
		-- Stops the synchronized boss timer when the battle returns to lobby.
		if _BRBattleTimerSystem ~= nil then
			_BRBattleTimerSystem:StopTimer()
		end
	end

	method number GetBattleTimerSeconds(any owner)
