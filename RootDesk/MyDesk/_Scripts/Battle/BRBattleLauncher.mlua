	@ExecSpace("Client")
	method void ShowMatchLoading(string message, number seconds, number curtainHoldSeconds)
		-- Opens a modal loading overlay and blocks local player input.
		self:SetLocalPlayerInputEnabled(false)
		local matchFlowUI = self:GetMatchFlowUI()
		if matchFlowUI ~= nil then
			matchFlowUI:ShowLoading(self:ReadString(message, "MATCH LOADING..."), seconds, curtainHoldSeconds)
		elseif _UIPopup ~= nil then
			_UIPopup:OpenBlockingMessage(self:ReadString(message, "MATCH LOADING..."))
		elseif _UIToast ~= nil then
			_UIToast:ShowMessage(self:ReadString(message, "MATCH LOADING..."))
		end
	end

	@ExecSpace("Client")
	method void HideMatchLoading(string message)
		-- Closes the loading overlay and restores local player input.
		self:SetLocalPlayerInputEnabled(true)
		local matchFlowUI = self:GetMatchFlowUI()
		if matchFlowUI ~= nil then
			matchFlowUI:HideLoading(self:ReadString(message, ""))
			return
		end
		if _UIPopup ~= nil then
			_UIPopup:Close()
		end
		local safeMessage = self:ReadString(message, "")
		if safeMessage ~= "" and _UIToast ~= nil then
			_UIToast:ShowMessage(safeMessage)
		end
	end

	@ExecSpace("Client")
	method void ShowBattleStartCountdown(string animationRuid, number seconds, number scale)
		-- Shows the 3-2-1 effect while keeping local controls locked.
		self:SetLocalPlayerInputEnabled(false)
		self:PlayBattleStartPresentationEffect(animationRuid, scale, seconds, "countdown")
		log("[BRBattleLauncher] local countdown effect ruid=" .. self:ReadString(animationRuid, "") .. " seconds=" .. tostring(seconds) .. " scale=" .. tostring(scale))
	end

	@ExecSpace("Client")
	method void ShowBattleStartEffect(string animationRuid, number scale, string message)
		-- Shows the START effect while controls remain locked until the server opens gameplay.
		self:SetLocalPlayerInputEnabled(false)
		self:PlayBattleStartPresentationEffect(animationRuid, scale, self:GetBattleStartEffectSeconds(nil), "start")
		log("[BRBattleLauncher] local start effect ruid=" .. self:ReadString(animationRuid, "") .. " scale=" .. tostring(scale))
	end

	@ExecSpace("Client")
	method void OpenBattleGameplay()
		-- Releases local controls after the START animation has completed.
		local matchFlowUI = self:GetMatchFlowUI()
		if matchFlowUI ~= nil then
			matchFlowUI:HideStartSequence()
		end
		self:SetLocalPlayerInputEnabled(true)
		log("[BRBattleLauncher] local gameplay opened")
	end

	@ExecSpace("ClientOnly")
	method void PlayBattleStartPresentationEffect(string animationRuid, number scale, number seconds, string phase)
		-- Plays a battle-start animationclip at the center of the UI, with world-effect fallback.
		local matchFlowUI = self:GetMatchFlowUI()
		if matchFlowUI ~= nil then
			matchFlowUI:HideLoading("")
			matchFlowUI:PlayCenterEffect(self:ReadString(animationRuid, ""), scale, seconds, self:ReadString(phase, "start"))
			return
		end

		self:HideMatchLoading("")
		self:SetLocalPlayerInputEnabled(false)
		self:PlayBattleStartWorldEffect(animationRuid, scale, phase)
	end

	@ExecSpace("ClientOnly")
	method void PlayBattleStartWorldEffect(string animationRuid, number scale, string phase)
		-- Plays a battle-start animationclip near the local camera center.
		if _EffectService == nil then
			return
		end
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return
		end
		local safeRuid = self:ReadString(animationRuid, "")
		if safeRuid == "" then
			return
		end

		local position = self:GetEntityPosition2(localPlayer)
		local safeScale = self:ReadNumber(scale, self:GetBattleStartEffectScale(nil))
		local options = {}
		options["SortingLayer"] = "MapLayer0"
		options["OrderInLayer"] = math.floor(self:ReadNumber(self.BattleStartEffectOrderInLayer, 120))
		options["Alpha"] = 1
		options["PlayRate"] = 1
		options["IgnoreMapLayerCheck"] = true

		local serial = _EffectService:PlayEffect(safeRuid, localPlayer, Vector3(position.x, position.y + 0.25, 0), 0, Vector3(safeScale, safeScale, 1), false, options)
		if math.floor(self:ReadNumber(serial, 0)) <= 0 then
			log("[BRBattleLauncher] local " .. self:ReadString(phase, "start") .. " effect failed ruid=" .. safeRuid)
		end
	end

	@ExecSpace("Client")
	method void ShowMatchResult(string title, string body)
		-- Shows the final match result popup on the local client.
		self:SetLocalPlayerInputEnabled(true)
		local safeTitle = self:ReadString(title, "RESULT")
		local safeBody = self:ReadString(body, "")
		local matchFlowUI = self:GetMatchFlowUI()
		if matchFlowUI ~= nil then
			matchFlowUI:ShowResult(safeTitle, safeBody)
		elseif _UIPopup ~= nil then
			_UIPopup.OkText = "LOBBY"
			_UIPopup:OpenAlert(safeTitle .. "\n\n" .. safeBody, nil)
		elseif _UIToast ~= nil then
			_UIToast:ShowMessage(safeTitle)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetLocalPlayerInputEnabled(boolean enabled)
		-- Toggles local input while loading or result UI is active.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerControllerComponent == nil then
			return
		end
		localPlayer.PlayerControllerComponent.Enable = enabled == true
	end

	@ExecSpace("ClientOnly")
	method any GetMatchFlowUI()
		-- Finds the dedicated match flow UI component without relying on a generated global alias.
		local controller = _EntityService:GetEntityByPath("/ui/BRMatchFlowGroup/Controller")
		if controller == nil then
			return nil
		end
		return controller:GetComponent("script.BRMatchFlowUI")
	end

	@ExecSpace("ServerOnly")
	method void StartMagneticZone(any matchRoom, any owner, string targetMapName)
		-- Starts the synchronized magnetic-zone shrink system for the launched battle.
		if self:IsMagneticZoneEnabled(owner) ~= true then
			return
		end
		if _BRMagneticZoneSystem == nil then
			log("[BRBattleLauncher] magnetic zone skipped: system missing")
			return
		end
		_BRMagneticZoneSystem:StartZone(
			self:ReadString(targetMapName, ""),
			self:GetMagneticZoneShrinkIntervalSeconds(owner),
			self:GetMagneticZoneWarningSeconds(owner),
			self:GetMagneticZoneForbiddenSeconds(owner),
			self:GetMagneticZoneShrinkAmount(owner)
		)
	end

	@ExecSpace("ServerOnly")
	method void StopMagneticZone()
		-- Stops the magnetic-zone shrink system when the battle returns to lobby.
		if _BRMagneticZoneSystem ~= nil then
			_BRMagneticZoneSystem:StopZone()
		end
	end

	@ExecSpace("ServerOnly")
	method void ClearPortalConnections(any matchRoom)
		-- Clears custom portal links for the match map.
		if _BRPortalConnectionSystem == nil or matchRoom == nil then
			return
		end

		local targetMapName = self:ReadString(matchRoom.TargetMapName, "")
		if targetMapName == "" then
			return
		end
		_BRPortalConnectionSystem:ClearMap(targetMapName)
	end

