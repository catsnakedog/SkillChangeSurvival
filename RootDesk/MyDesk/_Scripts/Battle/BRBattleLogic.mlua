@Component
script BRBattleLogic extends Component

	property boolean EnableBattleLogic = true

	property string AttackActionName = "Attack"

	property number BattleMaxHp = 100

	property number BasicAttackDamage = 20

	property number AttackCooldownSeconds = 0.45

	property number HitInvincibleSeconds = 0.25

	property number PortalCombatLockSeconds = 1.25

	property number AttackBoxWidth = 1.6

	property number AttackBoxHeight = 1.0

	property number AttackOffsetX = 0.9

	property number AttackOffsetY = 0.35

	property number AttackOffsetYFromFeet = 0.35

	property number PlayerScanSeconds = 0.05

	property number PlayerRespawnDuration = 5

	property boolean EnableLifeSystem = true

	property boolean EnableLastManStandingEnd = true

	property number MinimumPlayersForLastManEnd = 2

	property number DefaultLives = 2

	property number LifeReviveDelaySeconds = 4

	property number LifeReviveHpPercent = 0.6

	property number LifeReviveInvincibleSeconds = 2

	property boolean LifeReviveRequireSelection = true

	property number LifeReviveSelectionTimeoutSeconds = 10

	property number LifeReviveMinForbiddenSeconds = 10

	property number LifeNativeRespawnBlockSeconds = 9999

	property number LifeRespawnFloorOffsetY = 0.35

	property number LifeRespawnSearchDistance = 24

	property boolean EnablePlatformFallback = false

	property number PlatformGroundingSeconds = 0.033

	property number FallResetY = -5

	property number BattleGravity = 1.8

	property number BattleWalkSpeed = 1.95

	property number BattleWalkJump = 1.95

	property boolean OverridePlayerPhysicsStats = true

	property boolean ResetHpOnEnter = true

	property boolean EnableOutOfBoundsPenalty = true

	property number OutOfBoundsDamage = 20

	property number OutOfBoundsDamageCooldownSeconds = 1

	property boolean EnableRoomBottomOutOfBounds = true

	property number RoomBottomOutOfBoundsPadding = 0.1

	property number OutOfBoundsFootholdSearchDistance = 28

	property boolean VerboseBattleLog = false

	property boolean LogPhysicsStateOnRegister = false

	property boolean RequireActiveMatch = true

	property number ActiveMatchWaitPollSeconds = 0.25

	@Sync
	property number AlivePlayerCount = 0

	@Sync
	property string BattlePhase = "Idle"

	@Sync
	property string LifeMapName = ""

	@Sync
	property string LifeSummary = ""

	@Sync
	property number LifeVersion = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		if self.EnableBattleLogic == false then
			return
		end
		
		self:StartServerRuntimeWhenActive()
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		self:StopServerRuntime()
	end

	@ExecSpace("ServerOnly")
	method void StartServerRuntimeWhenActive()
		self:EnsureServerRuntimeTables()
		if self:IsActiveMatchReady() == true then
			self:StartServerRuntime()
			return
		end

		self:StartActiveMatchWait()
	end

	@ExecSpace("ServerOnly")
	method void StartServerRuntime()
		self:EnsureServerRuntimeTables()
		if self._T.runtimeStarted == true then
			return
		end

		self:StopActiveMatchWait()
		self._T.playerHandlers = {}
		self._T.nextAttackAt = {}
		self._T.invincibleUntil = {}
		self._T.portalLockedUntil = {}
		self._T.lives = {}
		self._T.lifeState = {}
		self._T.reviveUntil = {}
		self._T.pendingRevive = {}
		self._T.deathRoomKey = {}
		self._T.reviveOptionVersions = {}
		self._T.reviveAutoSelectToken = {}
		self._T.lastLifeSummary = ""
		self._T.preparedPlayers = {}
		self._T.knownParticipants = {}
		self._T.botRecords = {}
		self._T.knownBotParticipants = {}
		self._T.matchEndRequested = false
		self._T.lastPositions = {}
		self._T.basePhysicsStats = {}
		self._T.outOfBoundsDamageUntil = {}
		self._T.outOfBoundsRoomKeyByUser = {}
		self._T.runtimeStarted = true
		self._T.serverTimerId = _TimerService:SetTimerRepeat(function() self:RefreshBattlePlayers() end, self:GetPlayerScanSeconds(), 0)
		if self.EnablePlatformFallback == true then
			self._T.groundTimerId = _TimerService:SetTimerRepeat(function() self:GroundBattlePlayers() end, self:GetPlatformGroundingSeconds(), 0.1)
		else
			self._T.groundTimerId = 0
		end
		self:RefreshBattlePlayers()
		self.BattlePhase = "Ready"
		self:LogMapFootholdState()
		log("[BRBattle] started map=" .. self:GetBattleMapName())
		self:Log("started map=" .. self:GetBattleMapName())
	end

	@ExecSpace("ServerOnly")
	method void StopServerRuntime()
		self:StopActiveMatchWait()
		if self._T.serverTimerId ~= nil and self._T.serverTimerId > 0 then
			_TimerService:ClearTimer(self._T.serverTimerId)
		end
		self._T.serverTimerId = 0
		if self._T.groundTimerId ~= nil and self._T.groundTimerId > 0 then
			_TimerService:ClearTimer(self._T.groundTimerId)
		end
		self._T.groundTimerId = 0
		
		if self._T.playerHandlers ~= nil then
			for userId, entry in pairs(self._T.playerHandlers) do
				self:DisconnectPlayerEntry(entry)
			end
		end
		self._T.playerHandlers = {}
		self._T.nextAttackAt = {}
		self._T.invincibleUntil = {}
		self._T.portalLockedUntil = {}
		self._T.lives = {}
		self._T.lifeState = {}
		self._T.reviveUntil = {}
		self._T.pendingRevive = {}
		self._T.deathRoomKey = {}
		self._T.reviveOptionVersions = {}
		self._T.reviveAutoSelectToken = {}
		self._T.lastLifeSummary = ""
		self._T.preparedPlayers = {}
		self._T.knownParticipants = {}
		self._T.botRecords = {}
		self._T.knownBotParticipants = {}
		self._T.matchEndRequested = false
		self._T.lastPositions = {}
		self._T.basePhysicsStats = {}
		self._T.outOfBoundsDamageUntil = {}
		self._T.outOfBoundsRoomKeyByUser = {}
		self._T.runtimeStarted = false
		self.LifeMapName = ""
		self.LifeSummary = ""
		self.LifeVersion = self.LifeVersion + 1
	end

	@ExecSpace("ServerOnly")
	method void StartActiveMatchWait()
		self:EnsureServerRuntimeTables()
		if self.RequireActiveMatch ~= true then
			return
		end
		if self._T.activeMatchWaitTimerId ~= nil and self._T.activeMatchWaitTimerId > 0 then
			return
		end

		self._T.activeMatchWaitTimerId = _TimerService:SetTimerRepeat(function() self:TryStartServerRuntimeWhenActive() end, self:GetActiveMatchWaitPollSeconds(), 0.1)
		log("[BRBattle] waiting active match map=" .. self:GetBattleMapName())
	end

	@ExecSpace("ServerOnly")
	method void StopActiveMatchWait()
		if self._T.activeMatchWaitTimerId ~= nil and self._T.activeMatchWaitTimerId > 0 then
			_TimerService:ClearTimer(self._T.activeMatchWaitTimerId)
		end
		self._T.activeMatchWaitTimerId = 0
	end

	@ExecSpace("ServerOnly")
	method void TryStartServerRuntimeWhenActive()
		if self:IsActiveMatchReady() ~= true then
			return
		end

		log("[BRBattle] active match detected map=" .. self:GetBattleMapName())
		self:StartServerRuntime()
	end

	@ExecSpace("ServerOnly")
	method void RefreshBattlePlayers()
		if self:IsActiveMatchReady() ~= true then
			log("[BRBattle] stopped map=" .. self:GetBattleMapName() .. " reason=active match missing")
			self:StopServerRuntime()
			self:StartActiveMatchWait()
			return
		end

		self:EnsureServerRuntimeTables()
		local mapName = self:GetBattleMapName()
		local activeUsers = {}
		local users = _UserService:GetUsersByMapName(mapName)
		if users ~= nil then
			for index, playerEntity in ipairs(users) do
				if playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
					local userId = playerEntity.PlayerComponent.UserId
					activeUsers[userId] = true
					self:RegisterBattlePlayer(playerEntity)
					self:CheckBattlePlayerRoomBounds(playerEntity)
				end
			end
		end
		
		if self._T.playerHandlers ~= nil then
			for userId, entry in pairs(self._T.playerHandlers) do
				if activeUsers[userId] ~= true then
					self:UnregisterBattlePlayer(userId)
				end
			end
		end
		
		self:RefreshBattleBots()
		self:UpdateAlivePlayerCount()
		self:UpdateLifeSummary()
	end

	@ExecSpace("ServerOnly")
	method void RegisterBattlePlayer(Entity playerEntity)
		self:EnsureServerRuntimeTables()
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end
		
		local userId = playerEntity.PlayerComponent.UserId
		if userId == nil or userId == "" then
			return
		end
		
		if self._T.playerHandlers[userId] ~= nil then
			self._T.playerHandlers[userId].Entity = playerEntity
			self._T.knownParticipants[userId] = true
			if self.OverridePlayerPhysicsStats == true then
				self:ApplyBattlePhysicsSettings(playerEntity, false)
			end
			self:ApplySkillStatsToPlayer(playerEntity)
			return
		end
		
		self:PreparePlayerForBattle(playerEntity)
		
		local actionHandler = playerEntity:ConnectEvent(PlayerActionEvent, self.HandlePlayerActionEvent)
		self._T.playerHandlers[userId] = {
			Entity = playerEntity,
			ActionHandler = actionHandler
		}
		self._T.knownParticipants[userId] = true
		self:Log("registered user=" .. userId .. " map=" .. self:GetBattleMapName())
	end

	@ExecSpace("ServerOnly")
	method void UnregisterBattlePlayer(string userId)
		if self._T.playerHandlers == nil then
			return
		end
		
		local entry = self._T.playerHandlers[userId]
		if entry ~= nil then
			self:DisconnectPlayerEntry(entry)
			self._T.playerHandlers[userId] = nil
		end
		if self._T.nextAttackAt ~= nil then
			self._T.nextAttackAt[userId] = nil
		end
		if self._T.invincibleUntil ~= nil then
			self._T.invincibleUntil[userId] = nil
		end
		if self._T.portalLockedUntil ~= nil then
			self._T.portalLockedUntil[userId] = nil
		end
		if self._T.lives ~= nil then
			self._T.lives[userId] = nil
		end
		if self._T.lifeState ~= nil then
			self._T.lifeState[userId] = nil
		end
		if self._T.reviveUntil ~= nil then
			self._T.reviveUntil[userId] = nil
		end
		if self._T.pendingRevive ~= nil then
			self._T.pendingRevive[userId] = nil
		end
		if self._T.deathRoomKey ~= nil then
			self._T.deathRoomKey[userId] = nil
		end
		if self._T.reviveOptionVersions ~= nil then
			self._T.reviveOptionVersions[userId] = nil
		end
		if self._T.reviveAutoSelectToken ~= nil then
			self._T.reviveAutoSelectToken[userId] = self:ReadNumber(self._T.reviveAutoSelectToken[userId], 0) + 1
		end
		if self._T.preparedPlayers ~= nil then
			self._T.preparedPlayers[userId] = nil
		end
		if self._T.lastPositions ~= nil then
			self._T.lastPositions[userId] = nil
		end
		if self._T.basePhysicsStats ~= nil then
			self._T.basePhysicsStats[userId] = nil
		end
		if self._T.outOfBoundsDamageUntil ~= nil then
			self._T.outOfBoundsDamageUntil[userId] = nil
		end
		if self._T.outOfBoundsRoomKeyByUser ~= nil then
			self._T.outOfBoundsRoomKeyByUser[userId] = nil
		end
	end

	@ExecSpace("ServerOnly")
	method void DisconnectPlayerEntry(any entry)
		if entry == nil or entry.Entity == nil or entry.ActionHandler == nil then
			return
		end
		
		entry.Entity:DisconnectEvent(PlayerActionEvent, entry.ActionHandler)
	end

	@ExecSpace("ServerOnly")
	method void PreparePlayerForBattle(Entity playerEntity)
		self:EnsureServerRuntimeTables()
		local playerComponent = playerEntity.PlayerComponent
		if playerComponent == nil then
			return
		end
		
		local userId = playerComponent.UserId
		if self._T.preparedPlayers[userId] == nil then
			self:ResetSkillState(userId)
		end
		self:CaptureBasePhysicsStats(playerEntity)
		
		local maxHp = self:GetAdjustedBattleMaxHp(playerEntity)
		playerComponent.PVPMode = true
		playerComponent.MaxHp = maxHp
		if self.EnableLifeSystem == true then
			playerComponent.RespawnDuration = self:GetLifeNativeRespawnBlockSeconds()
		else
			playerComponent.RespawnDuration = self:GetPlayerRespawnDuration()
		end
		self:PreparePlayerPhysics(playerEntity)
		self:ApplySkillStatsToPlayer(playerEntity)
		if self._T.preparedPlayers == nil then
			self._T.preparedPlayers = {}
		end
		
		if self.ResetHpOnEnter == true and self._T.preparedPlayers[userId] == nil then
			playerComponent.Hp = maxHp
			self._T.lives[userId] = self:GetDefaultLives()
			self._T.lifeState[userId] = "ALIVE"
			self._T.reviveUntil[userId] = 0
			self._T.pendingRevive[userId] = nil
			self._T.deathRoomKey[userId] = nil
		elseif playerComponent.Hp <= 0 then
			playerComponent.Hp = maxHp
			if self._T.lives[userId] == nil then
				self._T.lives[userId] = self:GetDefaultLives()
			end
			self._T.lifeState[userId] = "ALIVE"
			self._T.reviveUntil[userId] = 0
			self._T.pendingRevive[userId] = nil
			self._T.deathRoomKey[userId] = nil
		elseif self._T.lives[userId] == nil then
			self._T.lives[userId] = self:GetDefaultLives()
			self._T.lifeState[userId] = "ALIVE"
			self._T.reviveUntil[userId] = 0
			self._T.pendingRevive[userId] = nil
			self._T.deathRoomKey[userId] = nil
		end
		
		self._T.preparedPlayers[userId] = true
	end

	@ExecSpace("ServerOnly")
	method void PreparePlayerPhysics(Entity playerEntity)
		self:ApplyBattlePhysicsSettings(playerEntity, true)
		if self.LogPhysicsStateOnRegister == true then
			self:LogPlayerPhysicsSetup(playerEntity)
			_TimerService:SetTimerOnce(function() self:LogPlayerGroundState(playerEntity) end, 0.25)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyBattlePhysicsSettings(Entity playerEntity, boolean resetPosition)
		if playerEntity == nil then
			return
		end
		
		if playerEntity.RigidbodyComponent ~= nil then
			playerEntity.RigidbodyComponent.Enable = true
			playerEntity.RigidbodyComponent.KinematicMove = false
			playerEntity.RigidbodyComponent.IsolatedMove = false
			playerEntity.RigidbodyComponent.IgnoreMoveBoundary = true
			if self.OverridePlayerPhysicsStats == true then
				playerEntity.RigidbodyComponent.Gravity = self:GetBattleGravity()
				playerEntity.RigidbodyComponent.WalkSpeed = self:GetBattleWalkSpeed()
				playerEntity.RigidbodyComponent.WalkJump = self:GetBattleWalkJump()
			end
			if resetPosition == true then
				playerEntity.RigidbodyComponent:PositionReset()
			end
		else
			self:Log("missing RigidbodyComponent user=" .. self:GetUserId(playerEntity))
		end
		
		if self.OverridePlayerPhysicsStats == true and playerEntity.MovementComponent ~= nil then
			playerEntity.MovementComponent.InputSpeed = self:GetBattleWalkSpeed()
			playerEntity.MovementComponent.JumpForce = self:GetBattleWalkJump()
		end
	end

	@ExecSpace("ServerOnly")
	method void ResetSkillState(string userId)
		if _BRSkillSystem ~= nil then
			_BRSkillSystem:ResetUserForBattle(userId)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillStatsToPlayer(Entity playerEntity)
		if _BRSkillSystem == nil or playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end
		
		local maxHp = self:GetAdjustedBattleMaxHp(playerEntity)
		playerEntity.PlayerComponent.MaxHp = maxHp
		if playerEntity.PlayerComponent.Hp > maxHp then
			playerEntity.PlayerComponent.Hp = maxHp
		end
		_BRSkillSystem:ApplyMovementStatsToPlayer(playerEntity, self:CaptureBasePhysicsStats(playerEntity))
	end

	@ExecSpace("ServerOnly")
	method any CaptureBasePhysicsStats(Entity playerEntity)
		self:EnsureServerRuntimeTables()
		local userId = self:GetUserId(playerEntity)
		if userId == "" then
			return nil
		end
		if self._T.basePhysicsStats[userId] ~= nil then
			return self._T.basePhysicsStats[userId]
		end
		
		local stats = {
			InputSpeed = self:GetBattleWalkSpeed(),
			JumpForce = self:GetBattleWalkJump(),
			WalkSpeed = self:GetBattleWalkSpeed(),
			WalkJump = self:GetBattleWalkJump()
		}
		if playerEntity.MovementComponent ~= nil then
			stats.InputSpeed = self:ReadNumber(playerEntity.MovementComponent.InputSpeed, stats.InputSpeed)
			stats.JumpForce = self:ReadNumber(playerEntity.MovementComponent.JumpForce, stats.JumpForce)
		end
		if playerEntity.RigidbodyComponent ~= nil then
			stats.WalkSpeed = self:ReadNumber(playerEntity.RigidbodyComponent.WalkSpeed, stats.WalkSpeed)
			stats.WalkJump = self:ReadNumber(playerEntity.RigidbodyComponent.WalkJump, stats.WalkJump)
		end
		self._T.basePhysicsStats[userId] = stats
		return stats
	end

	@ExecSpace("ServerOnly")
	method void LogMapFootholdState()
		if self.LogPhysicsStateOnRegister == false then
			return
		end
		if self.Entity == nil or self.Entity.CurrentMap == nil then
			self:Log("map physics map=nil footholds=-1 customFootholds=-1")
			return
		end
		
		local mapEntity = self.Entity.CurrentMap
		local footholdCount = -1
		if mapEntity.FootholdComponent ~= nil then
			local footholds = mapEntity.FootholdComponent:GetFootholdAll()
			if footholds ~= nil then
				footholdCount = #footholds
			else
				footholdCount = 0
			end
		end
		
		local customFootholdCount = 0
		local customFootholds = mapEntity:GetChildComponentsByTypeName("CustomFootholdComponent", true)
		if customFootholds == nil or #customFootholds == 0 then
			customFootholds = mapEntity:GetChildComponentsByTypeName("MOD.Core.CustomFootholdComponent", true)
		end
		if customFootholds ~= nil then
			customFootholdCount = #customFootholds
		end
		
		local tileMapMode = "nil"
		if mapEntity.MapComponent ~= nil then
			tileMapMode = tostring(mapEntity.MapComponent.TileMapMode)
		end
		self:Log("map physics map=" .. self:GetBattleMapName() .. " tileMode=" .. tileMapMode .. " footholds=" .. tostring(footholdCount) .. " customFootholds=" .. tostring(customFootholdCount))
	end

	@ExecSpace("ServerOnly")
	method void LogPlayerPhysicsSetup(Entity playerEntity)
		if playerEntity == nil then
			return
		end
		
		local position = self:GetEntityPosition2(playerEntity)
		local hasRigidbody = playerEntity.RigidbodyComponent ~= nil
		local hasMovement = playerEntity.MovementComponent ~= nil
		local hasController = playerEntity.PlayerControllerComponent ~= nil
		self:Log("player physics setup user=" .. self:GetUserId(playerEntity)
			.. " rigidbody=" .. tostring(hasRigidbody)
			.. " movement=" .. tostring(hasMovement)
			.. " controller=" .. tostring(hasController)
			.. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void LogPlayerGroundState(Entity playerEntity)
		if playerEntity == nil or playerEntity.RigidbodyComponent == nil then
			return
		end
		
		local position = self:GetEntityPosition2(playerEntity)
		local onGround = playerEntity.RigidbodyComponent:IsOnGround()
		local footholdId = "nil"
		local foothold = playerEntity.RigidbodyComponent:GetCurrentFoothold()
		if foothold ~= nil then
			footholdId = tostring(foothold.Id)
		end
		
		self:Log("player ground state user=" .. self:GetUserId(playerEntity)
			.. " onGround=" .. tostring(onGround)
			.. " foothold=" .. footholdId
			.. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void GroundBattlePlayers()
		if self.EnablePlatformFallback == false then
			return
		end
		
		self:EnsureServerRuntimeTables()
		local users = _UserService:GetUsersByMapName(self:GetBattleMapName())
		if users == nil then
			return
		end
		
		for index, playerEntity in ipairs(users) do
			self:GroundBattlePlayer(playerEntity)
		end
	end

	@ExecSpace("ServerOnly")
	method void GroundBattlePlayer(Entity playerEntity)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end
		
		local userId = playerEntity.PlayerComponent.UserId
		local position = self:GetEntityPosition2(playerEntity)
		local lastPosition = self._T.lastPositions[userId]
		if lastPosition == nil then
			lastPosition = Vector2(position.x, position.y + 2)
		end
		
		if position.y < self:GetFallResetY() then
			self:SetEntityWorldPosition2(playerEntity, Vector2(0, self:GetMainFloorY() + 0.1))
			self._T.lastPositions[userId] = Vector2(0, self:GetMainFloorY() + 0.1)
			return
		end
		
		local groundY = self:FindPlatformY(position.x, position.y, lastPosition.y)
		if groundY ~= nil then
			local groundedPosition = Vector2(position.x, groundY)
			self:SetEntityWorldPosition2(playerEntity, groundedPosition)
			self._T.lastPositions[userId] = groundedPosition
			return
		end
		
		self._T.lastPositions[userId] = position
	end

	method any FindPlatformY(number x, number y, number lastY)
		local bestY = nil
		bestY = self:PickPlatformY(bestY, x, y, lastY, 0, 2.25, 14)
		bestY = self:PickPlatformY(bestY, x, y, lastY, -5.4, 4.15, 3)
		bestY = self:PickPlatformY(bestY, x, y, lastY, 5.4, 4.15, 3)
		bestY = self:PickPlatformY(bestY, x, y, lastY, 0, 5.75, 2.4)
		return bestY
	end

	method any PickPlatformY(any currentY, number x, number y, number lastY, number centerX, number platformY, number halfWidth)
		if x < centerX - halfWidth or x > centerX + halfWidth then
			return currentY
		end
		if lastY < platformY or y > platformY then
			return currentY
		end
		if currentY ~= nil and platformY <= currentY then
			return currentY
		end
		return platformY
	end

	@ExecSpace("ServerOnly")
	method void SetEntityWorldPosition2(Entity playerEntity, Vector2 position)
		if playerEntity == nil then
			return
		end
		
		if playerEntity.MovementComponent ~= nil then
			playerEntity.MovementComponent:Stop()
			playerEntity.MovementComponent:SetWorldPosition(position)
		end

		if playerEntity.RigidbodyComponent ~= nil then
			playerEntity.RigidbodyComponent.IgnoreMoveBoundary = true
			playerEntity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			playerEntity.RigidbodyComponent:SetWorldPosition(position)
			playerEntity.RigidbodyComponent:PositionReset()
		elseif playerEntity.KinematicbodyComponent ~= nil then
			playerEntity.KinematicbodyComponent:SetWorldPosition(position)
		elseif playerEntity.SideviewbodyComponent ~= nil then
			playerEntity.SideviewbodyComponent:SetWorldPosition(position)
		end

		if playerEntity.PlayerComponent ~= nil then
			playerEntity.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		end
	end

	@ExecSpace("ServerOnly")
	method void RefreshBattleBots()
		-- Drops stale AI records. Spawned bots register themselves when initialized.
		self:EnsureServerRuntimeTables()

		for botId, record in pairs(self._T.botRecords) do
			if self:GetBotControllerFromRecord(record) == nil then
				self._T.botRecords[botId] = nil
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void RegisterBattleBot(Entity botEntity, string botId)
		-- Adds a spawned AI to the same contender pool used by last-man-standing.
		self:EnsureServerRuntimeTables()
		local safeBotId = self:ReadString(botId, "")
		if safeBotId == "" or botEntity == nil then
			return
		end

		self._T.botRecords[safeBotId] = {
			Entity = botEntity
		}
		self._T.knownBotParticipants[safeBotId] = true
	end

	@ExecSpace("ServerOnly")
	method void UnregisterBattleBot(string botId)
		self:EnsureServerRuntimeTables()
		local safeBotId = self:ReadString(botId, "")
		if safeBotId == "" then
			return
		end
		self._T.botRecords[safeBotId] = nil
	end

	@ExecSpace("Client")
	method void ApplyLocalLifeRespawnPosition(Vector2 position, string reason)
		-- Mirrors a server revive teleport on the owning client.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return
		end

		if localPlayer.MovementComponent ~= nil then
			localPlayer.MovementComponent:Stop()
			localPlayer.MovementComponent:SetWorldPosition(position)
		end
		if localPlayer.RigidbodyComponent ~= nil then
			localPlayer.RigidbodyComponent.IgnoreMoveBoundary = true
			localPlayer.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			localPlayer.RigidbodyComponent:SetWorldPosition(position)
			localPlayer.RigidbodyComponent:PositionReset()
		elseif localPlayer.KinematicbodyComponent ~= nil then
			localPlayer.KinematicbodyComponent:SetWorldPosition(position)
		elseif localPlayer.SideviewbodyComponent ~= nil then
			localPlayer.SideviewbodyComponent:SetWorldPosition(position)
		end
		local localUserId = ""
		if localPlayer.PlayerComponent ~= nil then
			localUserId = self:ReadString(localPlayer.PlayerComponent.UserId, "")
			localPlayer.PlayerComponent:ProcessRevive()
			localPlayer.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		end
		log("[BRBattle] local revive position user=" .. localUserId .. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ") reason=" .. self:ReadString(reason, ""))
	end

	@ExecSpace("ServerOnly")
	method boolean HandlePlayerOutOfBoundsReturn(Entity playerEntity, Vector2 fromPosition)
		-- Applies a battle penalty and returns a player who has left the playable map bounds.
		if self.EnableOutOfBoundsPenalty ~= true then
			return false
		end
		self:EnsureServerRuntimeTables()
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return false
		end
		if playerEntity.CurrentMapName ~= self:GetBattleMapName() then
			return false
		end
		if self:IsActiveMatchReady() ~= true then
			return false
		end
		if self:IsBattleGameplayStarted() ~= true then
			return false
		end

		local playerComponent = playerEntity.PlayerComponent
		if playerComponent:IsDead() == true or playerComponent.Hp <= 0 then
			return true
		end

		local userId = self:ReadString(playerComponent.UserId, "")
		if userId == "" then
			return false
		end
		if fromPosition == nil then
			fromPosition = self:GetEntityPosition2(playerEntity)
		end

		local graph = self:GetLatestRoomGraph()
		if graph == nil or graph.Rooms == nil then
			return false
		end

		local currentRoom = self:GetLogicalRoomForPosition(graph, fromPosition)
		local currentRoomKey = self:GetLogicalRoomKey(currentRoom)
		local returnReason = "out-of-bounds"
		if currentRoomKey ~= "" then
			self._T.outOfBoundsRoomKeyByUser[userId] = currentRoomKey
			if self:IsBelowLogicalRoomBottom(graph, currentRoom, fromPosition) ~= true then
				return false
			end
			returnReason = "room-bottom"
		end

		local returnRoom = currentRoom
		if returnRoom == nil then
			returnRoom = self:GetOutOfBoundsReturnLogicalRoom(graph, userId, fromPosition)
		end
		local returnRoomKey = self:GetLogicalRoomKey(returnRoom)
		local returnPosition = self:GetOutOfBoundsReturnPosition(playerEntity, fromPosition, returnRoom)
		if returnPosition == nil then
			return false
		end
		if returnRoomKey ~= "" then
			self._T.outOfBoundsRoomKeyByUser[userId] = returnRoomKey
		end

		local now = self:Now()
		local oldHp = math.max(0, math.floor(self:ReadNumber(playerComponent.Hp, 0)))
		local damage = 0
		if now >= self:ReadNumber(self._T.outOfBoundsDamageUntil[userId], 0) then
			damage = self:GetIncomingDamageAfterSkillReduction(playerEntity, self:GetOutOfBoundsDamage(playerEntity), 1)
			playerComponent.Hp = math.max(0, oldHp - damage)
			self._T.outOfBoundsDamageUntil[userId] = now + self:GetOutOfBoundsDamageCooldownSeconds()
			self:LockPortalUse(userId, now)
		end

		self:SetEntityWorldPosition2(playerEntity, returnPosition)
		self:ApplyLocalBoundsReturnPosition(returnPosition, returnReason, userId)
		self._T.lastPositions[userId] = returnPosition

		log("[BRBattle] bounds return user=" .. userId
			.. " reason=" .. returnReason
			.. " damage=" .. tostring(damage)
			.. " hp=" .. tostring(oldHp) .. "->" .. tostring(playerComponent.Hp)
			.. " room=" .. self:ReadString(returnRoomKey, "-")
			.. " from=(" .. tostring(fromPosition.x) .. "," .. tostring(fromPosition.y) .. ")"
			.. " to=(" .. tostring(returnPosition.x) .. "," .. tostring(returnPosition.y) .. ")")
		if damage > 0 and _BRDamageSkinSystem ~= nil then
			_BRDamageSkinSystem:ShowDamage(playerEntity, damage, false, returnReason)
		end

		if damage > 0 and playerComponent.Hp <= 0 then
			self:HandlePlayerFatalDeath(nil, playerEntity, "out-of-bounds")
		else
			if damage > 0 then
				self:PlayBodyAction(playerEntity, MapleAvatarBodyActionState.Hit, true, 1)
			end
			self:UpdateAlivePlayerCount()
			self:UpdateLifeSummary()
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method void CheckBattlePlayerRoomBounds(Entity playerEntity)
		-- Checks active-room bottom bounds during the battle scan, independent of skill tick timing.
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end
		self:HandlePlayerOutOfBoundsReturn(playerEntity, self:GetEntityPosition2(playerEntity))
	end

	@ExecSpace("Client")
	method void ApplyLocalBoundsReturnPosition(Vector2 position, string reason)
		-- Mirrors a server bounds-return teleport without touching dead/revive state.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return
		end

		if localPlayer.MovementComponent ~= nil then
			localPlayer.MovementComponent:Stop()
			localPlayer.MovementComponent:SetWorldPosition(position)
		end
		if localPlayer.RigidbodyComponent ~= nil then
			localPlayer.RigidbodyComponent.IgnoreMoveBoundary = true
			localPlayer.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			localPlayer.RigidbodyComponent:SetWorldPosition(position)
			localPlayer.RigidbodyComponent:PositionReset()
		elseif localPlayer.KinematicbodyComponent ~= nil then
			localPlayer.KinematicbodyComponent:SetWorldPosition(position)
		elseif localPlayer.SideviewbodyComponent ~= nil then
			localPlayer.SideviewbodyComponent:SetWorldPosition(position)
		end
		local localUserId = ""
		if localPlayer.PlayerComponent ~= nil then
			localUserId = self:ReadString(localPlayer.PlayerComponent.UserId, "")
			localPlayer.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		end
		log("[BRBattle] local bounds return user=" .. localUserId .. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ") reason=" .. self:ReadString(reason, ""))
	end

	@ExecSpace("ServerOnly")
	method void LogReviveConfirm(string userId, Entity playerEntity, string source)
		local safeUserId = self:ReadString(userId, "")
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			log("[BRBattle] revive confirm user=" .. safeUserId .. " missing-player source=" .. self:ReadString(source, ""))
			return
		end

		local position = self:GetEntityPosition2(playerEntity)
		log("[BRBattle] revive confirm user=" .. safeUserId
			.. " dead=" .. tostring(playerEntity.PlayerComponent:IsDead())
			.. " hp=" .. tostring(playerEntity.PlayerComponent.Hp)
			.. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ") source=" .. self:ReadString(source, ""))
	end

	@ExecSpace("ServerOnly")
	method void HandlePlayerActionEvent(PlayerActionEvent event)
		if self.EnableBattleLogic == false or event == nil then
			return
		end
		if self:IsAttackAction(event.ActionName) == false then
			return
		end
		if self:IsBattleGameplayStarted() ~= true then
			self:Log("attack ignored before start")
			return
		end
		
		self:TryBasicAttack(event.PlayerEntity)
	end

	@ExecSpace("ServerOnly")
	method void TryBasicAttack(Entity attackerEntity)
		self:EnsureServerRuntimeTables()
		if attackerEntity == nil or attackerEntity.PlayerComponent == nil then
			return
		end
		if attackerEntity.CurrentMapName ~= self:GetBattleMapName() then
			return
		end
		if attackerEntity.PlayerComponent:IsDead() == true or attackerEntity.PlayerComponent.Hp <= 0 then
			return
		end
		
		local userId = attackerEntity.PlayerComponent.UserId
		if _BRSkillSystem ~= nil then
			_BRSkillSystem:RequestCastBasicAttackSkill(userId)
			self:Log("basic-attack input user=" .. userId)
			return
		end

		local now = self:Now()
		local nextAttackAt = self:ReadNumber(self._T.nextAttackAt[userId], 0)
		if now < nextAttackAt then
			return
		end
		
		self._T.nextAttackAt[userId] = now + self:GetAttackCooldownSeconds()
		self:LockPortalUse(userId, now)
		self:PlayBodyAction(attackerEntity, MapleAvatarBodyActionState.Attack, true, 1)
		
		local hitCount = 0
		local users = _UserService:GetUsersByMapName(self:GetBattleMapName())
		if users ~= nil then
			for index, targetEntity in ipairs(users) do
				if self:CanHitTarget(attackerEntity, targetEntity, now) == true then
					self:DamageTarget(attackerEntity, targetEntity, now)
					hitCount = hitCount + 1
				end
			end
		end
		
		self:Log("attack user=" .. userId .. " hits=" .. tostring(hitCount))
	end

	@ExecSpace("ServerOnly")
	method boolean CanHitTarget(Entity attackerEntity, Entity targetEntity, number now)
		if targetEntity == nil or targetEntity.PlayerComponent == nil then
			return false
		end
		if attackerEntity == nil or attackerEntity.Id == targetEntity.Id then
			return false
		end
		if targetEntity.CurrentMapName ~= self:GetBattleMapName() then
			return false
		end
		if targetEntity.PlayerComponent:IsDead() == true or targetEntity.PlayerComponent.Hp <= 0 then
			return false
		end
		
		local targetUserId = targetEntity.PlayerComponent.UserId
		if now < self:ReadNumber(self._T.invincibleUntil[targetUserId], 0) then
			return false
		end
		
		return self:IsTargetInsideAttackBox(attackerEntity, targetEntity)
	end

	@ExecSpace("ServerOnly")
	method boolean IsTargetInsideAttackBox(Entity attackerEntity, Entity targetEntity)
		local attackerPosition = self:GetEntityPosition2(attackerEntity)
		local targetPosition = self:GetEntityPosition2(targetEntity)
		local direction = self:GetLookDirection(attackerEntity)
		local centerX = attackerPosition.x + direction * self:GetAttackOffsetX()
		local centerY = attackerPosition.y + self:GetAttackOffsetY()
		local halfWidth = self:GetAttackBoxWidth() * 0.5
		local halfHeight = self:GetAttackBoxHeight() * 0.5
		
		return math.abs(targetPosition.x - centerX) <= halfWidth and math.abs((targetPosition.y + self:GetAttackOffsetYFromFeet()) - centerY) <= halfHeight
	end

	method number GetIncomingDamageAfterSkillReduction(Entity targetEntity, number rawDamage, number minimumDamage)
		-- Applies BRSkillSystem damage-taken statuses such as Iron Wall.
		local baseDamage = math.floor(self:ReadNumber(rawDamage, 0))
		local minDamage = math.max(0, math.floor(self:ReadNumber(minimumDamage, 0)))
		if baseDamage <= 0 then
			return 0
		end
		local rate = 1.0
		if _BRSkillSystem ~= nil then
			rate = math.max(0, self:ReadNumber(_BRSkillSystem:GetDamageTakenRate(targetEntity), 1))
		end
		return math.max(minDamage, math.floor(baseDamage * rate))
	end

	@ExecSpace("ServerOnly")
	method void DamageTarget(Entity attackerEntity, Entity targetEntity, number now)
		self:EnsureServerRuntimeTables()
		local targetPlayer = targetEntity.PlayerComponent
		if targetPlayer == nil then
			return
		end
		
		local damage = self:GetIncomingDamageAfterSkillReduction(targetEntity, self:GetAdjustedBasicAttackDamage(attackerEntity), 1)
		targetPlayer.Hp = math.max(0, targetPlayer.Hp - damage)
		self._T.invincibleUntil[targetPlayer.UserId] = now + self:GetHitInvincibleSeconds()
		self:LockPortalUse(targetPlayer.UserId, now)
		if _BRDamageSkinSystem ~= nil then
			_BRDamageSkinSystem:ShowEnemyDamage(targetEntity, damage, false, "battle-basic")
		end
		
		if targetPlayer.Hp <= 0 then
			self:KillTarget(attackerEntity, targetEntity)
		else
			self:PlayBodyAction(targetEntity, MapleAvatarBodyActionState.Hit, true, 1)
		end
		
		self:UpdateAlivePlayerCount()
	end

	@ExecSpace("ServerOnly")
	method void ApplyDamageToPlayerFromBot(Entity botEntity, Entity targetEntity, number rawDamage, string source)
		-- Lets BT-controlled AI damage real players while reusing the battle life system.
		self:EnsureServerRuntimeTables()
		if botEntity == nil or targetEntity == nil or targetEntity.PlayerComponent == nil then
			return
		end
		if targetEntity.CurrentMapName ~= self:GetBattleMapName() then
			return
		end
		local targetPlayer = targetEntity.PlayerComponent
		if targetPlayer:IsDead() == true or targetPlayer.Hp <= 0 then
			return
		end

		local userId = self:ReadString(targetPlayer.UserId, "")
		local now = self:Now()
		if now < self:ReadNumber(self._T.invincibleUntil[userId], 0) then
			return
		end

		local damage = self:GetIncomingDamageAfterSkillReduction(targetEntity, self:ReadNumber(rawDamage, self:GetBasicAttackDamage()), 1)
		targetPlayer.Hp = math.max(0, targetPlayer.Hp - damage)
		self._T.invincibleUntil[userId] = now + self:GetHitInvincibleSeconds()
		self:LockPortalUse(userId, now)
		self:Log("bot damage target=" .. userId .. " bot=" .. self:GetBotId(botEntity) .. " damage=" .. tostring(damage) .. " hp=" .. tostring(targetPlayer.Hp) .. " source=" .. self:ReadString(source, "bot"))
		if _BRDamageSkinSystem ~= nil then
			_BRDamageSkinSystem:ShowDamage(targetEntity, damage, false, self:ReadString(source, "bot"))
		end

		if targetPlayer.Hp <= 0 then
			self:HandlePlayerFatalDeath(botEntity, targetEntity, "bot:" .. self:ReadString(source, "attack"))
		else
			self:PlayBodyAction(targetEntity, MapleAvatarBodyActionState.Hit, true, 1)
		end

		self:UpdateAlivePlayerCount()
		self:UpdateLifeSummary()
	end

	@ExecSpace("ServerOnly")
	method void LockPortalUse(string userId, number now)
		-- Blocks portal movement briefly after combat contact.
		self:EnsureServerRuntimeTables()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end
		self._T.portalLockedUntil[safeUserId] = self:ReadNumber(now, self:Now()) + self:GetPortalCombatLockSeconds()
	end

	@ExecSpace("ServerOnly")
	method boolean IsPortalUseBlocked(Entity playerEntity)
		-- Returns whether the player is currently blocked from using battle portals.
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return true
		end
		if playerEntity.PlayerComponent:IsDead() == true or playerEntity.PlayerComponent.Hp <= 0 then
			return true
		end

		self:EnsureServerRuntimeTables()
		local userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
		if userId == "" then
			return true
		end
		return self:Now() < self:ReadNumber(self._T.portalLockedUntil[userId], 0)
	end

	@ExecSpace("ServerOnly")
	method void KillTarget(Entity attackerEntity, Entity targetEntity)
		self:HandlePlayerFatalDeath(attackerEntity, targetEntity, "combat")
	end

	@ExecSpace("ServerOnly")
	method void HandleExternalFatalDeath(Entity targetEntity, string reason)
		-- Lets external hazards use the same life and revive pipeline as combat deaths.
		self:HandlePlayerFatalDeath(nil, targetEntity, self:ReadString(reason, "external"))
	end

	@ExecSpace("ServerOnly")
	method void HandlePlayerFatalDeath(Entity attackerEntity, Entity targetEntity, string reason)
		-- Consumes one life and either schedules a revive or leaves the player out.
		self:EnsureServerRuntimeTables()
		if targetEntity == nil or targetEntity.PlayerComponent == nil then
			return
		end

		local playerComponent = targetEntity.PlayerComponent
		local userId = self:ReadString(playerComponent.UserId, "")
		if userId == "" then
			return
		end
		if self._T.pendingRevive[userId] == true then
			self:UpdateLifeSummary()
			return
		end

		local attackerId = ""
		if attackerEntity ~= nil and attackerEntity.PlayerComponent ~= nil then
			attackerId = attackerEntity.PlayerComponent.UserId
		elseif attackerEntity ~= nil then
			attackerId = self:GetBotId(attackerEntity)
		end
		local deathRoomKey = self:GetLogicalRoomKeyForEntity(targetEntity)

		playerComponent.Hp = 0
		playerComponent.RespawnDuration = self:GetLifeNativeRespawnBlockSeconds()
		self:PlayBodyAction(targetEntity, MapleAvatarBodyActionState.Dead, true, 1)
		playerComponent:ProcessDead(userId)

		if self.EnableLifeSystem ~= true then
			self._T.lifeState[userId] = "OUT"
			self._T.lives[userId] = 0
			self:UpdateAlivePlayerCount()
			self:UpdateLifeSummary()
			self:Log("dead user=" .. userId .. " attacker=" .. attackerId .. " reason=" .. self:ReadString(reason, ""))
			self:ReturnOutPlayerToLobby(userId, self:ReadString(reason, "dead"))
			self:CheckLastManStanding(reason)
			return
		end

		local maxLives = self:GetDefaultLives()
		local remainingLives = math.max(0, math.floor(self:ReadNumber(self._T.lives[userId], maxLives)))
		remainingLives = math.max(0, remainingLives - 1)
		self._T.lives[userId] = remainingLives

		if remainingLives > 0 then
			local delay = self:GetLifeReviveDelaySeconds()
			self._T.lifeState[userId] = "REVIVE"
			self._T.pendingRevive[userId] = true
			self._T.reviveUntil[userId] = self:Now() + delay
			self._T.deathRoomKey[userId] = deathRoomKey
			self:UpdateAlivePlayerCount()
			self:UpdateLifeSummary()
			self:RefreshMiniMapPlayerCounts()
			self:Log("life consumed user=" .. userId .. " lives=" .. tostring(remainingLives) .. "/" .. tostring(maxLives)
				.. " reviveDelay=" .. tostring(delay) .. " deathRoom=" .. self:ReadString(deathRoomKey, "-") .. " reason=" .. self:ReadString(reason, "") .. " attacker=" .. attackerId)
			if self:IsLifeReviveSelectionEnabled() == true then
				self:PushReviveOptionsToUser(userId, "Waiting for revive selection...")
				_TimerService:SetTimerOnce(function() self:PushReviveOptionsToUser(userId, "Select a revive point. Auto revive in " .. tostring(math.ceil(self:GetLifeReviveSelectionTimeoutSeconds())) .. "s.") end, delay)
				self:ScheduleReviveAutoSelection(userId, delay + self:GetLifeReviveSelectionTimeoutSeconds())
			else
				_TimerService:SetTimerOnce(function() self:RevivePlayerByUserId(userId) end, delay)
			end
			return
		end

		self._T.lifeState[userId] = "OUT"
		self._T.pendingRevive[userId] = nil
		self._T.reviveUntil[userId] = 0
		self:UpdateAlivePlayerCount()
		self:UpdateLifeSummary()
		self:Log("life out user=" .. userId .. " reason=" .. self:ReadString(reason, "") .. " attacker=" .. attackerId)
		self:RefreshMiniMapPlayerCounts()
		self:ReturnOutPlayerToLobby(userId, self:ReadString(reason, "life-out"))
		self:CheckLastManStanding(reason)
	end

	@ExecSpace("ServerOnly")
	method void ReturnOutPlayerToLobby(string userId, string reason)
		-- Sends one out-of-lives player to lobby and clears revive UI state.
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end

		self:ReceiveReviveOptions("", "Eliminated.", 0, self:GetNextReviveOptionVersion(safeUserId), safeUserId)
		local returned = false
		if _BRBattleLauncher ~= nil then
			returned = _BRBattleLauncher:ReturnEliminatedPlayerToLobby(self:GetBattleMapName(), safeUserId, self:ReadString(reason, "life-out"))
		end
		log("[BRBattle] eliminated user=" .. safeUserId .. " lobbyReturn=" .. tostring(returned) .. " reason=" .. self:ReadString(reason, ""))
	end

	@ExecSpace("ServerOnly")
	method void RevivePlayerByUserId(string userId)
		-- Revives a player in an empty logical grid room after the delay expires.
		self:EnsureServerRuntimeTables()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end
		if self._T.pendingRevive[safeUserId] ~= true then
			return
		end
		if self:ReadNumber(self._T.lives[safeUserId], 0) <= 0 then
			self._T.pendingRevive[safeUserId] = nil
			self._T.lifeState[safeUserId] = "OUT"
			self:UpdateLifeSummary()
			self:CheckLastManStanding("revive-expired")
			return
		end

		local playerEntity = _UserService:GetUserEntityByUserId(safeUserId)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			self._T.pendingRevive[safeUserId] = nil
			self._T.lifeState[safeUserId] = "OUT"
			self:UpdateLifeSummary()
			self:CheckLastManStanding("revive-missing-player")
			return
		end
		if playerEntity.CurrentMapName ~= self:GetBattleMapName() then
			self._T.pendingRevive[safeUserId] = nil
			self._T.lifeState[safeUserId] = "OUT"
			self:UpdateLifeSummary()
			self:CheckLastManStanding("revive-map-left")
			return
		end
		if self:IsLifeReviveSelectionEnabled() == true then
			self:PushReviveOptionsToUser(safeUserId, "Select a revive point.")
			return
		end

		local revivePosition = self:PickEmptyRespawnPosition(safeUserId)
		if revivePosition == nil then
			revivePosition = self:GetEntityPosition2(playerEntity)
		end

		self:RevivePlayerAtPosition(safeUserId, playerEntity, revivePosition, "auto")
	end

	@ExecSpace("ServerOnly")
	method void ScheduleReviveAutoSelection(string userId, number delaySeconds)
		-- Schedules a server-owned random revive selection for an unanswered revive UI.
		self:EnsureServerRuntimeTables()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end
		local delay = math.max(0, self:ReadNumber(delaySeconds, 0))
		local token = self:ReadNumber(self._T.reviveAutoSelectToken[safeUserId], 0) + 1
		self._T.reviveAutoSelectToken[safeUserId] = token
		_TimerService:SetTimerOnce(function() self:AutoSelectReviveForUser(safeUserId, token) end, delay)
		log("[BRBattle] revive auto selection scheduled user=" .. safeUserId .. " delay=" .. tostring(delay) .. " token=" .. tostring(token))
	end

	@ExecSpace("ServerOnly")
	method void AutoSelectReviveForUser(string userId, number token)
		-- Revives a still-pending player at a random currently selectable room.
		self:EnsureServerRuntimeTables()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end
		local expectedToken = self:ReadNumber(self._T.reviveAutoSelectToken[safeUserId], -1)
		if expectedToken ~= self:ReadNumber(token, -2) then
			log("[BRBattle] revive auto selection skipped user=" .. safeUserId .. " reason=stale-token expected=" .. tostring(expectedToken) .. " token=" .. tostring(token))
			return
		end
		if self._T.pendingRevive[safeUserId] ~= true then
			return
		end
		if self:ReadNumber(self._T.lives[safeUserId], 0) <= 0 then
			self._T.pendingRevive[safeUserId] = nil
			self._T.lifeState[safeUserId] = "OUT"
			self:InvalidateReviveAutoSelection(safeUserId)
			self:UpdateLifeSummary()
			self:CheckLastManStanding("revive-auto-no-lives")
			return
		end

		local now = self:Now()
		local reviveAt = self:ReadNumber(self._T.reviveUntil[safeUserId], now)
		if now < reviveAt then
			local remaining = math.max(0.1, reviveAt - now)
			_TimerService:SetTimerOnce(function() self:AutoSelectReviveForUser(safeUserId, token) end, remaining)
			log("[BRBattle] revive auto selection deferred user=" .. safeUserId .. " remaining=" .. tostring(remaining))
			return
		end

		local playerEntity = _UserService:GetUserEntityByUserId(safeUserId)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			self._T.pendingRevive[safeUserId] = nil
			self._T.lifeState[safeUserId] = "OUT"
			self:InvalidateReviveAutoSelection(safeUserId)
			self:UpdateLifeSummary()
			self:CheckLastManStanding("revive-auto-missing-player")
			return
		end
		if playerEntity.CurrentMapName ~= self:GetBattleMapName() then
			self._T.pendingRevive[safeUserId] = nil
			self._T.lifeState[safeUserId] = "OUT"
			self:InvalidateReviveAutoSelection(safeUserId)
			self:UpdateLifeSummary()
			self:CheckLastManStanding("revive-auto-map-left")
			return
		end

		local revivePosition = self:PickSelectableRespawnPosition(safeUserId)
		if revivePosition == nil then
			self:PushReviveOptionsToUser(safeUserId, "No revive room is available.")
			_TimerService:SetTimerOnce(function() self:AutoSelectReviveForUser(safeUserId, token) end, 1)
			log("[BRBattle] revive auto selection waiting user=" .. safeUserId .. " reason=no-selectable-room")
			return
		end

		self:RevivePlayerAtPosition(safeUserId, playerEntity, revivePosition, "auto-timeout")
		self:ReceiveReviveOptions("", "", 0, self:GetNextReviveOptionVersion(safeUserId), safeUserId)
	end

	@ExecSpace("ServerOnly")
	method void InvalidateReviveAutoSelection(string userId)
		-- Invalidates any older auto-select timer already queued for this user.
		self:EnsureServerRuntimeTables()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end
		self._T.reviveAutoSelectToken[safeUserId] = self:ReadNumber(self._T.reviveAutoSelectToken[safeUserId], 0) + 1
	end

	@ExecSpace("ServerOnly")
	method void RevivePlayerAtPosition(string userId, Entity playerEntity, Vector2 revivePosition, string source)
		-- Performs the actual custom life revive at the validated position.
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" or playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end

		local playerComponent = playerEntity.PlayerComponent
		local maxHp = self:GetAdjustedBattleMaxHp(playerEntity)
		local reviveHp = math.max(1, math.ceil(maxHp * self:GetLifeReviveHpPercent()))
		playerComponent.PVPMode = true
		playerComponent.MaxHp = maxHp
		playerComponent.RespawnDuration = self:GetLifeNativeRespawnBlockSeconds()
		playerComponent.RespawnPosition = Vector3(revivePosition.x, revivePosition.y, 0)
		playerComponent.Hp = reviveHp
		playerComponent:Respawn()
		playerComponent.Hp = reviveHp
		playerComponent:ProcessRevive(safeUserId)
		self:PreparePlayerPhysics(playerEntity)
		self:ApplySkillStatsToPlayer(playerEntity)
		self:SetEntityWorldPosition2(playerEntity, revivePosition)
		self:ApplyLocalLifeRespawnPosition(revivePosition, "life-revive", safeUserId)
		self:PlayBodyAction(playerEntity, MapleAvatarBodyActionState.Stand, true, 1)

		local now = self:Now()
		self._T.invincibleUntil[safeUserId] = now + self:GetLifeReviveInvincibleSeconds()
		self._T.portalLockedUntil[safeUserId] = now + math.max(self:GetPortalCombatLockSeconds(), 0.5)
		self._T.pendingRevive[safeUserId] = nil
		self._T.reviveUntil[safeUserId] = 0
		self._T.lifeState[safeUserId] = "ALIVE"
		self._T.deathRoomKey[safeUserId] = nil
		self:InvalidateReviveAutoSelection(safeUserId)
		self:EnsureReviveForbiddenTime(safeUserId)
		self:UpdateAlivePlayerCount()
		self:UpdateLifeSummary()
		self:RefreshMiniMapPlayerCounts()
		self:Log("life revive user=" .. safeUserId
			.. " lives=" .. tostring(math.floor(self:ReadNumber(self._T.lives[safeUserId], 0)))
			.. " hp=" .. tostring(playerComponent.Hp) .. "/" .. tostring(maxHp)
			.. " pos=(" .. tostring(revivePosition.x) .. "," .. tostring(revivePosition.y) .. ") source=" .. self:ReadString(source, ""))
		log("[BRBattle] life revive user=" .. safeUserId
			.. " lives=" .. tostring(math.floor(self:ReadNumber(self._T.lives[safeUserId], 0)))
			.. " hp=" .. tostring(playerComponent.Hp) .. "/" .. tostring(maxHp)
			.. " pos=(" .. tostring(revivePosition.x) .. "," .. tostring(revivePosition.y) .. ") source=" .. self:ReadString(source, ""))
		_TimerService:SetTimerOnce(function() self:LogReviveConfirm(safeUserId, playerEntity, source) end, 0.2)
	end

	@ExecSpace("Server")
	method void RequestReviveOptions()
		self:RequestReviveOptionsForUser("")
	end

	@ExecSpace("Server")
	method void RequestReviveOptionsForUser(string requestedUserId)
		-- Pushes the caller's current selectable revive rooms to the client UI.
		local userId = self:ReadString(senderUserId, "")
		if userId == "" then
			userId = self:ReadString(requestedUserId, "")
		end
		if userId == "" then
			log("[BRBattle] revive options ignored sender=nil requested=nil")
			return
		end
		self:PushReviveOptionsToUser(userId, "")
	end

	@ExecSpace("Server")
	method void RequestReviveAt(number row, number column)
		self:RequestReviveAtForUser(row, column, "")
	end

	@ExecSpace("Server")
	method void RequestReviveAtForUser(number row, number column, string requestedUserId)
		-- Validates and performs a selected revive location.
		local userId = self:ReadString(senderUserId, "")
		if userId == "" then
			userId = self:ReadString(requestedUserId, "")
		end
		if userId == "" then
			log("[BRBattle] revive request ignored sender=nil row=" .. tostring(row) .. " column=" .. tostring(column))
			return
		end

		self:EnsureServerRuntimeTables()
		log("[BRBattle] revive request user=" .. userId .. " row=" .. tostring(row) .. " column=" .. tostring(column)
			.. " pending=" .. tostring(self._T.pendingRevive[userId] == true)
			.. " lives=" .. tostring(self:ReadNumber(self._T.lives[userId], 0)))
		if self:IsLifeReviveSelectionEnabled() ~= true then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=selection-disabled")
			self:PushReviveOptionsToUser(userId, "Revive selection is disabled.")
			return
		end
		if self._T.pendingRevive[userId] ~= true then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=not-pending")
			self:PushReviveOptionsToUser(userId, "You are not waiting for revive.")
			return
		end
		if self:ReadNumber(self._T.lives[userId], 0) <= 0 then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=no-lives")
			self:PushReviveOptionsToUser(userId, "No lives left.")
			return
		end

		local now = self:Now()
		if now < self:ReadNumber(self._T.reviveUntil[userId], now) then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=preparing remaining=" .. tostring(self:ReadNumber(self._T.reviveUntil[userId], now) - now))
			self:PushReviveOptionsToUser(userId, "Revive preparing...")
			return
		end

		local playerEntity = _UserService:GetUserEntityByUserId(userId)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=missing-player")
			self._T.pendingRevive[userId] = nil
			self._T.lifeState[userId] = "OUT"
			self:UpdateLifeSummary()
			self:CheckLastManStanding("revive-missing-player")
			return
		end
		if playerEntity.CurrentMapName ~= self:GetBattleMapName() then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=map-left current=" .. self:ReadString(playerEntity.CurrentMapName, ""))
			self._T.pendingRevive[userId] = nil
			self._T.lifeState[userId] = "OUT"
			self:UpdateLifeSummary()
			self:CheckLastManStanding("revive-map-left")
			return
		end

		local graph = self:GetLatestRoomGraph()
		local room = self:FindLogicalRoomByCoordinate(graph, row, column)
		local roomKey = self:GetLogicalRoomKey(room)
		if room == nil or roomKey == "" then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=no-room row=" .. tostring(row) .. " column=" .. tostring(column))
			self:PushReviveOptionsToUser(userId, "That room is not available.")
			return
		end
		if roomKey == self:ReadString(self._T.deathRoomKey[userId], "") then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=death-room key=" .. roomKey)
			self:PushReviveOptionsToUser(userId, "Cannot revive where you died.")
			return
		end

		local occupied = self:BuildOccupiedLogicalRoomCounts(graph, userId)
		if self:ReadNumber(occupied[roomKey], 0) > 0 then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=occupied key=" .. roomKey .. " count=" .. tostring(self:ReadNumber(occupied[roomKey], 0)))
			self:PushReviveOptionsToUser(userId, "Cannot revive on another player.")
			return
		end

		local revivePosition = self:GetRespawnPositionForLogicalRoom(graph, room)
		if revivePosition == nil then
			log("[BRBattle] revive rejected user=" .. userId .. " reason=missing-position key=" .. roomKey)
			self:PushReviveOptionsToUser(userId, "Revive point is missing.")
			return
		end
		self:RevivePlayerAtPosition(userId, playerEntity, revivePosition, "selected:" .. roomKey)
		self:ReceiveReviveOptions("", "", 0, self:GetNextReviveOptionVersion(userId), userId)
	end

	@ExecSpace("ServerOnly")
	method void PushReviveOptionsToUser(string userId, string message)
		-- Builds and pushes revive UI state to one waiting user.
		self:EnsureServerRuntimeTables()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end

		local now = self:Now()
		local remaining = math.max(0, self:ReadNumber(self._T.reviveUntil[safeUserId], now) - now)
		local optionsText = self:BuildReviveOptionsText(safeUserId)
		local safeMessage = self:ReadString(message, "")
		if optionsText == "" and self._T.pendingRevive[safeUserId] == true then
			safeMessage = "No revive room is available."
		end
		self:ReceiveReviveOptions(optionsText, safeMessage, remaining, self:GetNextReviveOptionVersion(safeUserId), safeUserId)
	end

	@ExecSpace("Client")
	method void ReceiveReviveOptions(string optionsText, string message, number remainingSeconds, number version)
		-- Receives the local revive-selection payload.
		self._T.localReviveOptionsText = self:ReadString(optionsText, "")
		self._T.localReviveMessage = self:ReadString(message, "")
		self._T.localReviveRemaining = math.max(0, self:ReadNumber(remainingSeconds, 0))
		self._T.localReviveReceivedAt = _UtilLogic.ElapsedSeconds
		self._T.localReviveOptionsVersion = self:ReadNumber(version, 0)
	end

	@ExecSpace("Client")
	method string GetLocalReviveOptionsText()
		return self:ReadString(self._T.localReviveOptionsText, "")
	end

	@ExecSpace("Client")
	method string GetLocalReviveMessage()
		return self:ReadString(self._T.localReviveMessage, "")
	end

	@ExecSpace("Client")
	method number GetLocalReviveRemainingSeconds()
		local remaining = math.max(0, self:ReadNumber(self._T.localReviveRemaining, 0))
		local receivedAt = self:ReadNumber(self._T.localReviveReceivedAt, _UtilLogic.ElapsedSeconds)
		local elapsed = math.max(0, _UtilLogic.ElapsedSeconds - receivedAt)
		return math.max(0, remaining - elapsed)
	end

	@ExecSpace("Client")
	method number GetLocalReviveOptionsVersion()
		return self:ReadNumber(self._T.localReviveOptionsVersion, 0)
	end

	method string BuildReviveOptionsText(string userId)
		-- Serializes revive candidates as row,column,state,count records.
		local graph = self:GetLatestRoomGraph()
		if graph == nil or graph.Rooms == nil then
			return ""
		end

		local occupied = self:BuildOccupiedLogicalRoomCounts(graph, userId)
		local deathRoomKey = self:ReadString(self._T.deathRoomKey[userId], "")
		local text = ""
		for index, room in ipairs(graph.Rooms) do
			if room ~= nil and room.Visited == true then
				local roomKey = self:GetLogicalRoomKey(room)
				if roomKey ~= "" then
					local state = 1
					local count = math.floor(self:ReadNumber(occupied[roomKey], 0))
					if roomKey == deathRoomKey then
						state = 2
					elseif count > 0 then
						state = 3
					end
					if text ~= "" then
						text = text .. ";"
					end
					text = text .. tostring(math.floor(self:ReadNumber(room.Row, 0)))
						.. "," .. tostring(math.floor(self:ReadNumber(room.Column, 0)))
						.. "," .. tostring(state)
						.. "," .. tostring(count)
				end
			end
		end
		return text
	end

	method number GetNextReviveOptionVersion(string userId)
		local safeUserId = self:ReadString(userId, "")
		if self._T.reviveOptionVersions == nil then
			self._T.reviveOptionVersions = {}
		end
		self._T.reviveOptionVersions[safeUserId] = self:ReadNumber(self._T.reviveOptionVersions[safeUserId], 0) + 1
		return self._T.reviveOptionVersions[safeUserId]
	end

	method any GetLatestRoomGraph()
		if _BRRoomGraphGenerator == nil then
			return nil
		end
		return _BRRoomGraphGenerator:GetLatestGraphForMap(self:GetBattleMapName())
	end

	method any GetOutOfBoundsReturnPosition(Entity playerEntity, Vector2 fromPosition, any preferredRoom)
		-- Returns the player to a nearby foothold, falling back to room respawn and then map center.
		local graph = self:GetLatestRoomGraph()
		local targetRoom = preferredRoom
		if targetRoom == nil and playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
			targetRoom = self:GetOutOfBoundsReturnLogicalRoom(graph, self:ReadString(playerEntity.PlayerComponent.UserId, ""), fromPosition)
		end
		local footholdPosition = self:GetNearestOutOfBoundsFootholdPosition(playerEntity, fromPosition, targetRoom)
		if footholdPosition ~= nil then
			return footholdPosition
		end
		if targetRoom ~= nil then
			local graphPosition = self:GetRespawnPositionForLogicalRoom(graph, targetRoom)
			if graphPosition ~= nil then
				return graphPosition
			end
		end
		return self:GetMapCenterReturnPosition(playerEntity)
	end

	method any GetNearestOutOfBoundsFootholdPosition(Entity playerEntity, Vector2 fromPosition, any targetRoom)
		-- Finds a usable foothold near the out-of-bounds position while keeping the player in the owning room.
		if playerEntity == nil then
			return nil
		end
		if fromPosition == nil then
			fromPosition = self:GetEntityPosition2(playerEntity)
		end

		local mapName = self:ReadString(playerEntity.CurrentMapName, self:GetBattleMapName())
		if mapName == "" then
			mapName = self:GetBattleMapName()
		end
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil then
			mapEntity = playerEntity.CurrentMap
		end
		if mapEntity == nil or mapEntity.FootholdComponent == nil then
			return nil
		end

		local graph = self:GetLatestRoomGraph()
		local bounds = self:GetPhysicalRoomBoundsForLogicalRoom(graph, targetRoom)
		if bounds == nil then
			bounds = self:GetMapBoundsForEntity(playerEntity)
		end

		local point = Vector2(fromPosition.x, fromPosition.y)
		if bounds ~= nil then
			point = Vector2(
				self:ClampNumber(point.x, bounds.Left + 0.25, bounds.Right - 0.25),
				self:ClampNumber(point.y, bounds.Bottom + 0.25, bounds.Top - 0.25)
			)
		end

		local searchDistance = self:GetOutOfBoundsFootholdSearchDistance()
		local foothold = mapEntity.FootholdComponent:GetNearestFootholdByPoint(point, searchDistance)
		local landing = self:GetFootholdLandingPosition(foothold, point.x, bounds)
		if landing ~= nil then
			return landing
		end

		local rayStart = Vector2(point.x, point.y + searchDistance * 0.5)
		local rayDistance = searchDistance
		if bounds ~= nil then
			rayStart = Vector2(point.x, bounds.Top + 1)
			rayDistance = math.max(searchDistance, bounds.Top - bounds.Bottom + 2)
		end
		foothold = mapEntity.FootholdComponent:Raycast(rayStart, Vector2(0, -1), rayDistance)
		return self:GetFootholdLandingPosition(foothold, point.x, bounds)
	end

	method any GetPhysicalRoomBoundsForLogicalRoom(any graph, any logicalRoom)
		-- Converts a logical room assignment into a world-space rectangle.
		if _BRRoomGraphGenerator == nil or graph == nil or logicalRoom == nil then
			return nil
		end
		local roomName = self:GetAssignedPhysicalRoomName(logicalRoom)
		if roomName == "" then
			return nil
		end
		local mapName = self:ResolveGraphMapName(graph)
		if mapName == "" then
			return nil
		end
		local root = _BRRoomGraphGenerator:GetPhysicalRoomRoot(mapName)
		local center = _BRRoomGraphGenerator:GetPhysicalRoomCenter(mapName, root, roomName)
		local halfSize = _BRRoomGraphGenerator:GetRoomHalfSize(mapName)
		if center == nil or halfSize == nil then
			return nil
		end
		return {
			Left = center.x - halfSize.x,
			Bottom = center.y - halfSize.y,
			Right = center.x + halfSize.x,
			Top = center.y + halfSize.y,
			MapName = mapName,
			RoomName = roomName
		}
	end

	method any GetFootholdLandingPosition(any foothold, number requestedX, any bounds)
		-- Converts a foothold hit into a safe standing point.
		if foothold == nil then
			return nil
		end
		if foothold:IsVertical() == true then
			return nil
		end

		local x = self:ReadNumber(requestedX, 0)
		local startPoint = foothold.StartPoint
		local endPoint = foothold.EndPoint
		if startPoint ~= nil and endPoint ~= nil then
			local minX = math.min(startPoint.x, endPoint.x) + 0.03
			local maxX = math.max(startPoint.x, endPoint.x) - 0.03
			if maxX < minX then
				minX = math.min(startPoint.x, endPoint.x)
				maxX = math.max(startPoint.x, endPoint.x)
			end
			x = self:ClampNumber(x, minX, maxX)
		end
		if bounds ~= nil then
			x = self:ClampNumber(x, bounds.Left + 0.25, bounds.Right - 0.25)
		end

		local position = Vector2(x, foothold:GetYByX(x) + self:GetLifeRespawnFloorOffsetY())
		if bounds ~= nil then
			if position.x < bounds.Left - 0.05 or position.x > bounds.Right + 0.05 then
				return nil
			end
			if position.y < bounds.Bottom - 0.1 or position.y > bounds.Top + 1 then
				return nil
			end
		end
		return position
	end

	method number ClampNumber(number value, number minimum, number maximum)
		-- Clamps numbers while tolerating inverted ranges from tiny rooms.
		local safeValue = self:ReadNumber(value, 0)
		local minValue = self:ReadNumber(minimum, safeValue)
		local maxValue = self:ReadNumber(maximum, safeValue)
		if maxValue < minValue then
			local middle = (minValue + maxValue) * 0.5
			minValue = middle
			maxValue = middle
		end
		return math.max(minValue, math.min(maxValue, safeValue))
	end

	method any GetOutOfBoundsReturnLogicalRoom(any graph, string userId, Vector2 fromPosition)
		-- Resolves the room that owns an out-of-room penalty return.
		if graph == nil or graph.Rooms == nil then
			return nil
		end

		local safeUserId = self:ReadString(userId, "")
		if self._T.outOfBoundsRoomKeyByUser ~= nil and safeUserId ~= "" then
			local storedRoom = self:FindLogicalRoomByKey(graph, self:ReadString(self._T.outOfBoundsRoomKeyByUser[safeUserId], ""))
			if storedRoom ~= nil then
				return storedRoom
			end
		end

		local nearestRoom = self:GetNearestLogicalRoomForPosition(graph, fromPosition)
		if nearestRoom ~= nil then
			return nearestRoom
		end

		return self:GetCenterLogicalRoom(graph)
	end

	method boolean IsBelowLogicalRoomBottom(any graph, any logicalRoom, Vector2 position)
		-- Treats falling below a physical room floor as out of bounds even inside the overall map bounds.
		if self.EnableRoomBottomOutOfBounds ~= true then
			return false
		end
		if _BRRoomGraphGenerator == nil or graph == nil or logicalRoom == nil or position == nil then
			return false
		end

		local bottomY = self:GetLogicalRoomBottomY(graph, logicalRoom)
		if bottomY == nil then
			return false
		end
		return position.y < bottomY - self:GetRoomBottomOutOfBoundsPadding()
	end

	method any GetLogicalRoomBottomY(any graph, any logicalRoom)
		-- Resolves the bottom edge of a logical room's assigned physical room.
		if _BRRoomGraphGenerator == nil or graph == nil or logicalRoom == nil then
			return nil
		end

		local roomName = self:GetAssignedPhysicalRoomName(logicalRoom)
		if roomName == "" then
			return nil
		end

		local mapName = self:ResolveGraphMapName(graph)
		if mapName == "" then
			return nil
		end
		local root = _BRRoomGraphGenerator:GetPhysicalRoomRoot(mapName)
		local center = _BRRoomGraphGenerator:GetPhysicalRoomCenter(mapName, root, roomName)
		if center == nil then
			return nil
		end

		local halfSize = _BRRoomGraphGenerator:GetRoomHalfSize(mapName)
		if halfSize == nil then
			return nil
		end
		return center.y - halfSize.y
	end

	method any GetLogicalRoomForPosition(any graph, Vector2 position)
		-- Finds the visited logical room whose assigned physical room contains the position.
		if _BRRoomGraphGenerator == nil or graph == nil or position == nil then
			return nil
		end

		return _BRRoomGraphGenerator:GetLogicalRoomForPosition(graph, position)
	end

	method any FindLogicalRoomByKey(any graph, string roomKey)
		-- Finds a visited logical room by its row-column key.
		if graph == nil or graph.Rooms == nil then
			return nil
		end

		local safeKey = self:ReadString(roomKey, "")
		if safeKey == "" then
			return nil
		end

		for index, room in ipairs(graph.Rooms) do
			if room ~= nil and room.Visited == true and self:GetLogicalRoomKey(room) == safeKey then
				return room
			end
		end
		return nil
	end

	method any GetNearestLogicalRoomForPosition(any graph, Vector2 position)
		-- Picks the assigned physical room rectangle nearest to a position outside every room.
		if _BRRoomGraphGenerator == nil or graph == nil or graph.Rooms == nil or position == nil then
			return nil
		end

		local mapName = self:ResolveGraphMapName(graph)
		if mapName == "" then
			return nil
		end
		local root = _BRRoomGraphGenerator:GetPhysicalRoomRoot(mapName)
		local halfSize = _BRRoomGraphGenerator:GetRoomHalfSize(mapName)
		if halfSize == nil then
			return nil
		end
		local bestRoom = nil
		local bestDistance = nil
		for index, room in ipairs(graph.Rooms) do
			if room ~= nil and room.Visited == true then
				local roomName = self:GetAssignedPhysicalRoomName(room)
				if roomName ~= "" then
					local center = _BRRoomGraphGenerator:GetPhysicalRoomCenter(mapName, root, roomName)
					if center ~= nil then
						local dx = math.max(0, math.abs(position.x - center.x) - halfSize.x)
						local dy = math.max(0, math.abs(position.y - center.y) - halfSize.y)
						local distance = dx * dx + dy * dy
						if bestDistance == nil or distance < bestDistance then
							bestDistance = distance
							bestRoom = room
						end
					end
				end
			end
		end
		return bestRoom
	end

	method any GetCenterLogicalRoom(any graph)
		if graph == nil or graph.Rooms == nil then
			return nil
		end

		local centerRow = (math.max(1, self:ReadNumber(graph.Rows, 1)) + 1) * 0.5
		local centerColumn = (math.max(1, self:ReadNumber(graph.Columns, 1)) + 1) * 0.5
		local bestRoom = nil
		local bestDistance = nil
		for index, room in ipairs(graph.Rooms) do
			if room ~= nil and room.Visited == true then
				local row = self:ReadNumber(room.Row, centerRow)
				local column = self:ReadNumber(room.Column, centerColumn)
				local dx = column - centerColumn
				local dy = row - centerRow
				local distance = dx * dx + dy * dy
				if bestDistance == nil or distance < bestDistance then
					bestDistance = distance
					bestRoom = room
				end
			end
		end
		if bestRoom ~= nil then
			return bestRoom
		end

		for index, room in ipairs(graph.Rooms) do
			if room ~= nil then
				local row = self:ReadNumber(room.Row, centerRow)
				local column = self:ReadNumber(room.Column, centerColumn)
				local dx = column - centerColumn
				local dy = row - centerRow
				local distance = dx * dx + dy * dy
				if bestDistance == nil or distance < bestDistance then
					bestDistance = distance
					bestRoom = room
				end
			end
		end
		return bestRoom
	end

	method any GetMapCenterReturnPosition(Entity playerEntity)
		local bounds = self:GetMapBoundsForEntity(playerEntity)
		if bounds == nil then
			return Vector2(0, self:GetMainFloorY() + 0.1)
		end

		local rawPosition = Vector2((bounds.Left + bounds.Right) * 0.5, (bounds.Bottom + bounds.Top) * 0.5)
		return self:GetFootholdAlignedRespawnPosition(bounds.MapName, rawPosition, bounds.Top - bounds.Bottom)
	end

	method any GetMapBoundsForEntity(Entity entity)
		if entity == nil then
			return nil
		end
		local mapEntity = entity.CurrentMap
		if mapEntity == nil then
			local mapName = self:ReadString(entity.CurrentMapName, "")
			if mapName ~= "" then
				mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
			end
		end
		if mapEntity == nil or mapEntity.MapComponent == nil or mapEntity.MapComponent.UseCustomBound ~= true then
			return nil
		end
		local leftBottom = mapEntity.MapComponent.LeftBottom
		local rightTop = mapEntity.MapComponent.RightTop
		if leftBottom == nil or rightTop == nil or rightTop.x <= leftBottom.x or rightTop.y <= leftBottom.y then
			return nil
		end
		return {
			Left = leftBottom.x,
			Bottom = leftBottom.y,
			Right = rightTop.x,
			Top = rightTop.y,
			MapName = self:ReadString(mapEntity.Name, self:GetBattleMapName())
		}
	end

	method any FindLogicalRoomByCoordinate(any graph, number row, number column)
		if graph == nil or graph.Rooms == nil then
			return nil
		end

		local safeRow = math.floor(self:ReadNumber(row, 0))
		local safeColumn = math.floor(self:ReadNumber(column, 0))
		for index, room in ipairs(graph.Rooms) do
			if room ~= nil and room.Visited == true then
				if math.floor(self:ReadNumber(room.Row, 0)) == safeRow and math.floor(self:ReadNumber(room.Column, 0)) == safeColumn then
					return room
				end
			end
		end
		return nil
	end

	method any PickEmptyRespawnPosition(string excludedUserId)
		-- Picks a respawn point from the latest logical graph, ignoring magnetic-zone state.
		local graph = self:GetLatestRoomGraph()
		if graph == nil or graph.Rooms == nil then
			return nil
		end

		local occupied = self:BuildOccupiedLogicalRoomCounts(graph, excludedUserId)
		local deathRoomKey = self:ReadString(self._T.deathRoomKey[self:ReadString(excludedUserId, "")], "")
		local emptyRooms = {}
		local fallbackRooms = {}
		for index, room in ipairs(graph.Rooms) do
			if room ~= nil and room.Visited == true then
				local roomKey = self:GetLogicalRoomKey(room)
				if roomKey ~= "" then
					if roomKey ~= deathRoomKey then
						table.insert(fallbackRooms, room)
					end
					if roomKey ~= deathRoomKey and self:ReadNumber(occupied[roomKey], 0) <= 0 then
						table.insert(emptyRooms, room)
					end
				end
			end
		end

		local candidates = emptyRooms
		if #candidates <= 0 then
			candidates = fallbackRooms
		end
		if #candidates <= 0 then
			return nil
		end

		local selectedIndex = _UtilLogic:RandomIntegerRange(1, #candidates)
		return self:GetRespawnPositionForLogicalRoom(graph, candidates[selectedIndex])
	end

	method any PickSelectableRespawnPosition(string excludedUserId)
		-- Picks a random revive position from rooms the revive UI currently marks selectable.
		local graph = self:GetLatestRoomGraph()
		if graph == nil or graph.Rooms == nil then
			return nil
		end

		local occupied = self:BuildOccupiedLogicalRoomCounts(graph, excludedUserId)
		local deathRoomKey = self:ReadString(self._T.deathRoomKey[self:ReadString(excludedUserId, "")], "")
		local candidates = {}
		for index, room in ipairs(graph.Rooms) do
			if room ~= nil and room.Visited == true then
				local roomKey = self:GetLogicalRoomKey(room)
				if roomKey ~= "" and roomKey ~= deathRoomKey and self:ReadNumber(occupied[roomKey], 0) <= 0 then
					local revivePosition = self:GetRespawnPositionForLogicalRoom(graph, room)
					if revivePosition ~= nil then
						table.insert(candidates, revivePosition)
					end
				end
			end
		end

		if #candidates <= 0 then
			return nil
		end
		return candidates[_UtilLogic:RandomIntegerRange(1, #candidates)]
	end

	method any BuildOccupiedLogicalRoomCounts(any graph, string excludedUserId)
		-- Counts other players by logical room so revives can prefer empty rooms.
		local result = {}
		if _BRRoomGraphGenerator == nil or graph == nil then
			return result
		end

		local users = _UserService:GetUsersByMapName(self:GetBattleMapName())
		if users == nil then
			return result
		end

		local excluded = self:ReadString(excludedUserId, "")
		for index, playerEntity in ipairs(users) do
			if playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
				local userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
				if userId ~= "" and userId ~= excluded and playerEntity.PlayerComponent:IsDead() ~= true and playerEntity.PlayerComponent.Hp > 0 then
					local room = _BRRoomGraphGenerator:GetLogicalRoomForPosition(graph, self:GetEntityPosition2(playerEntity))
					local roomKey = self:GetLogicalRoomKey(room)
					if roomKey ~= "" then
						result[roomKey] = self:ReadNumber(result[roomKey], 0) + 1
					end
				end
			end
		end
		return result
	end

	method any GetRespawnPositionForLogicalRoom(any graph, any room)
		-- Converts a logical room assignment into a foothold-aligned world position.
		if _BRRoomGraphGenerator == nil or graph == nil or room == nil then
			return nil
		end

		local roomName = self:GetAssignedPhysicalRoomName(room)
		if roomName == "" then
			return nil
		end

		local mapName = self:ResolveGraphMapName(graph)
		if mapName == "" then
			return nil
		end
		local root = _BRRoomGraphGenerator:GetPhysicalRoomRoot(mapName)
		local center = _BRRoomGraphGenerator:GetPhysicalRoomCenter(mapName, root, roomName)
		if center == nil then
			return nil
		end

		local halfSize = _BRRoomGraphGenerator:GetRoomHalfSize(mapName)
		if halfSize == nil then
			return nil
		end
		local rawPosition = Vector2(center.x, center.y - halfSize.y + self:GetLifeRespawnFloorOffsetY())
		return self:GetFootholdAlignedRespawnPosition(mapName, rawPosition, halfSize.y * 2)
	end

	method string ResolveGraphMapName(any graph)
		local mapName = self:ReadString(self:GetBattleMapName(), "")
		return mapName
	end

	method Vector2 GetFootholdAlignedRespawnPosition(string mapName, Vector2 rawPosition, number roomHeight)
		-- Aligns a revive position to the real foothold below the selected room.
		local safeMapName = self:ReadString(mapName, self:GetBattleMapName())
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. safeMapName)
		if mapEntity == nil or mapEntity.FootholdComponent == nil then
			return rawPosition
		end

		local searchDistance = math.max(self:GetLifeRespawnSearchDistance(), self:ReadNumber(roomHeight, 10) * 2 + 5)
		local rayStart = Vector2(rawPosition.x, rawPosition.y + searchDistance * 0.5)
		local foothold = mapEntity.FootholdComponent:Raycast(rayStart, Vector2(0, -1), searchDistance)
		if foothold == nil then
			return rawPosition
		end

		local alignedY = foothold:GetYByX(rawPosition.x) + self:GetLifeRespawnFloorOffsetY()
		local allowedDelta = math.max(1, self:ReadNumber(roomHeight, 10) * 0.5)
		if math.abs(alignedY - rawPosition.y) > allowedDelta then
			return rawPosition
		end
		return Vector2(rawPosition.x, alignedY)
	end

	method string GetAssignedPhysicalRoomName(any logicalRoom)
		-- Reads the physical room name assigned to a logical room.
		if logicalRoom == nil then
			return ""
		end
		local assignedRoomName = self:ReadString(logicalRoom.AssignedRoomName, "")
		if assignedRoomName ~= "" then
			return assignedRoomName
		end
		return self:ReadString(logicalRoom.FixedPhysicalRoomName, "")
	end

	method string GetLogicalRoomKey(any logicalRoom)
		-- Builds a stable row-column key for a logical room.
		if logicalRoom == nil then
			return ""
		end
		local row = math.floor(self:ReadNumber(logicalRoom.Row, 0))
		local column = math.floor(self:ReadNumber(logicalRoom.Column, 0))
		if row <= 0 or column <= 0 then
			return ""
		end
		return tostring(row) .. ":" .. tostring(column)
	end

	method string GetLogicalRoomKeyForEntity(Entity playerEntity)
		-- Finds the current logical room key for a player entity.
		if playerEntity == nil or _BRRoomGraphGenerator == nil then
			return ""
		end

		local graph = self:GetLatestRoomGraph()
		if graph == nil then
			return ""
		end

		local room = _BRRoomGraphGenerator:GetLogicalRoomForPosition(graph, self:GetEntityPosition2(playerEntity))
		return self:GetLogicalRoomKey(room)
	end

	@ExecSpace("ServerOnly")
	method void EnsureReviveForbiddenTime(string userId)
		-- Guarantees a freshly revived player has enough forbidden-zone budget to move.
		local minimumSeconds = self:GetLifeReviveMinForbiddenSeconds()
		if minimumSeconds <= 0 or _BRMagneticZoneSystem == nil then
			return
		end
		_BRMagneticZoneSystem:EnsureForbiddenTimeAtLeast(self:ReadString(userId, ""), minimumSeconds)
	end

	@ExecSpace("ServerOnly")
	method void UpdateLifeSummary()
		-- Synchronizes each current player's life and revive countdown to clients.
		self:EnsureServerRuntimeTables()
		local mapName = self:GetBattleMapName()
		local summary = self:BuildLifeSummary(mapName)
		self.LifeMapName = mapName
		if summary ~= self._T.lastLifeSummary then
			self._T.lastLifeSummary = summary
			self.LifeSummary = summary
			self.LifeVersion = self.LifeVersion + 1
		else
			self.LifeSummary = summary
		end
	end

	method string BuildLifeSummary(string mapName)
		-- Formats current life state records as user,lives,max,state,seconds.
		local users = _UserService:GetUsersByMapName(self:ReadString(mapName, self:GetBattleMapName()))

		local now = self:Now()
		local records = ""
		if users ~= nil then
			for index, playerEntity in ipairs(users) do
				if playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
					local userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
					if userId ~= "" and self._T.playerHandlers[userId] ~= nil then
						local maxLives = self:GetDefaultLives()
						local lives = math.max(0, math.floor(self:ReadNumber(self._T.lives[userId], maxLives)))
						local state = self:ReadString(self._T.lifeState[userId], "ALIVE")
						if playerEntity.PlayerComponent:IsDead() == true or playerEntity.PlayerComponent.Hp <= 0 then
							if self._T.pendingRevive[userId] == true then
								state = "REVIVE"
							elseif lives <= 0 then
								state = "OUT"
							end
						elseif self._T.pendingRevive[userId] ~= true and lives > 0 then
							state = "ALIVE"
						end

						local remaining = 0
						if state == "REVIVE" then
							remaining = math.max(0, math.ceil(self:ReadNumber(self._T.reviveUntil[userId], now) - now))
						end
						records = self:AppendLifeRecord(records, userId, lives, maxLives, state, remaining)
					end
				end
			end
		end
		for botId, record in pairs(self._T.botRecords) do
			local bot = self:GetBotControllerFromRecord(record)
			if bot ~= nil then
				local maxLives = math.max(1, math.floor(self:ReadNumber(bot.MaxLives, self:GetDefaultLives())))
				local lives = math.max(0, math.floor(self:ReadNumber(bot.CurrentLives, maxLives)))
				local state = self:ReadString(bot.BotState, "ALIVE")
				records = self:AppendLifeRecord(records, botId, lives, maxLives, state, 0)
			end
		end
		return records
	end

	method string AppendLifeRecord(string records, string userId, number lives, number maxLives, string state, number remaining)
		-- Appends one semicolon-delimited life HUD record.
		local nextRecord = self:ReadString(userId, "")
			.. "," .. tostring(math.max(0, math.floor(self:ReadNumber(lives, 0))))
			.. "," .. tostring(math.max(1, math.floor(self:ReadNumber(maxLives, 1))))
			.. "," .. self:ReadString(state, "ALIVE")
			.. "," .. tostring(math.max(0, math.floor(self:ReadNumber(remaining, 0))))
		if records == nil or records == "" then
			return nextRecord
		end
		return records .. ";" .. nextRecord
	end

	@ExecSpace("ServerOnly")
	method void RefreshMiniMapPlayerCounts()
		-- Refreshes minimap occupancy after death or life revive changes player count state.
		if _BRRoomGraphGenerator ~= nil then
			_BRRoomGraphGenerator:RefreshMiniMapPlayerCounts()
		end
	end

	@ExecSpace("ServerOnly")
	method void CheckLastManStanding(string reason)
		-- Ends the match when only one non-out participant remains.
		if self.EnableLastManStandingEnd ~= true then
			return
		end
		if self:IsBattleGameplayStarted() ~= true then
			return
		end

		self:EnsureServerRuntimeTables()
		if self._T.matchEndRequested == true then
			return
		end

		local knownCount = self:GetKnownParticipantCount()
		if knownCount < self:GetMinimumPlayersForLastManEnd() then
			return
		end

		local summary = self:GetRemainingContenderSummary()
		if summary.Count > 1 then
			return
		end

		self._T.matchEndRequested = true
		self.BattlePhase = "Ending"
		self:Log("last man result winner=" .. self:ReadString(summary.WinnerUserId, "") .. " contenders=" .. tostring(summary.Count) .. " known=" .. tostring(knownCount) .. " reason=" .. self:ReadString(reason, ""))
		if _BRBattleLauncher ~= nil then
			_BRBattleLauncher:FinishMatchByMap(self:GetBattleMapName(), self:ReadString(summary.WinnerUserId, ""), self:ReadString(reason, "last-man"))
		end
	end

	method any GetRemainingContenderSummary()
		-- Counts participants who still have lives and are not out.
		self:EnsureServerRuntimeTables()
		local result = {
			Count = 0,
			WinnerUserId = ""
		}

		for userId, known in pairs(self._T.knownParticipants) do
			if known == true and self:IsUserStillContending(userId) == true then
				result.Count = result.Count + 1
				result.WinnerUserId = self:ReadString(userId, "")
			end
		end
		for botId, known in pairs(self._T.knownBotParticipants) do
			if known == true and self:IsBotStillContending(botId) == true then
				result.Count = result.Count + 1
				result.WinnerUserId = self:ReadString(botId, "")
			end
		end
		return result
	end

	method boolean IsUserStillContending(string userId)
		-- Returns true while a known participant is alive or waiting for revive.
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return false
		end
		if self._T.playerHandlers == nil or self._T.playerHandlers[safeUserId] == nil then
			return false
		end

		local state = self:ReadString(self._T.lifeState[safeUserId], "ALIVE")
		local lives = math.max(0, math.floor(self:ReadNumber(self._T.lives[safeUserId], self:GetDefaultLives())))
		if state == "OUT" or lives <= 0 then
			return false
		end
		return true
	end

	method boolean IsBotStillContending(string botId)
		local safeBotId = self:ReadString(botId, "")
		if safeBotId == "" or self._T.botRecords == nil then
			return false
		end
		local record = self._T.botRecords[safeBotId]
		local bot = self:GetBotControllerFromRecord(record)
		if bot == nil then
			return false
		end
		return bot:IsContending() == true
	end

	method number GetKnownParticipantCount()
		-- Counts every participant registered during this match lifecycle.
		self:EnsureServerRuntimeTables()
		local count = 0
		for userId, known in pairs(self._T.knownParticipants) do
			if known == true then
				count = count + 1
			end
		end
		for botId, known in pairs(self._T.knownBotParticipants) do
			if known == true then
				count = count + 1
			end
		end
		return count
	end

	@ExecSpace("ServerOnly")
	method void UpdateAlivePlayerCount()
		self:EnsureServerRuntimeTables()
		local count = 0
		local users = _UserService:GetUsersByMapName(self:GetBattleMapName())
		if users ~= nil then
			for index, playerEntity in ipairs(users) do
				if playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
					if playerEntity.PlayerComponent:IsDead() == false and playerEntity.PlayerComponent.Hp > 0 then
						count = count + 1
					end
				end
			end
		end
		count = count + self:GetAliveBotCount()
		
		self.AlivePlayerCount = count
		if self._T.matchEndRequested == true then
			self.BattlePhase = "Ending"
			return
		end
		if self:IsBattleGameplayStarted() ~= true then
			self.BattlePhase = "Ready"
			return
		end
		if count > 0 then
			self.BattlePhase = "Playing " .. tostring(count)
		else
			local contenders = self:GetRemainingContenderSummary()
			if contenders.Count > 0 then
				self.BattlePhase = "Reviving " .. tostring(contenders.Count)
			else
				self.BattlePhase = "Waiting"
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void PlayBodyAction(Entity playerEntity, MapleAvatarBodyActionState actionState, boolean reset, number playRate)
		if playerEntity == nil then
			return
		end
		
		playerEntity:SendEvent(BodyActionStateChangeEvent(reset, actionState, 0, 2147483647, playRate))
	end

	@ExecSpace("ServerOnly")
	method void EnsureServerRuntimeTables()
		if self._T.runtimeStarted == nil then
			self._T.runtimeStarted = false
		end
		if self._T.activeMatchWaitTimerId == nil then
			self._T.activeMatchWaitTimerId = 0
		end
		if self._T.playerHandlers == nil then
			self._T.playerHandlers = {}
		end
		if self._T.nextAttackAt == nil then
			self._T.nextAttackAt = {}
		end
		if self._T.invincibleUntil == nil then
			self._T.invincibleUntil = {}
		end
		if self._T.portalLockedUntil == nil then
			self._T.portalLockedUntil = {}
		end
		if self._T.lives == nil then
			self._T.lives = {}
		end
		if self._T.lifeState == nil then
			self._T.lifeState = {}
		end
		if self._T.reviveUntil == nil then
			self._T.reviveUntil = {}
		end
		if self._T.pendingRevive == nil then
			self._T.pendingRevive = {}
		end
		if self._T.deathRoomKey == nil then
			self._T.deathRoomKey = {}
		end
		if self._T.reviveOptionVersions == nil then
			self._T.reviveOptionVersions = {}
		end
		if self._T.reviveAutoSelectToken == nil then
			self._T.reviveAutoSelectToken = {}
		end
		if self._T.lastLifeSummary == nil then
			self._T.lastLifeSummary = ""
		end
		if self._T.preparedPlayers == nil then
			self._T.preparedPlayers = {}
		end
		if self._T.knownParticipants == nil then
			self._T.knownParticipants = {}
		end
		if self._T.botRecords == nil then
			self._T.botRecords = {}
		end
		if self._T.knownBotParticipants == nil then
			self._T.knownBotParticipants = {}
		end
		if self._T.matchEndRequested == nil then
			self._T.matchEndRequested = false
		end
		if self._T.lastPositions == nil then
			self._T.lastPositions = {}
		end
		if self._T.basePhysicsStats == nil then
			self._T.basePhysicsStats = {}
		end
		if self._T.outOfBoundsDamageUntil == nil then
			self._T.outOfBoundsDamageUntil = {}
		end
		if self._T.outOfBoundsRoomKeyByUser == nil then
			self._T.outOfBoundsRoomKeyByUser = {}
		end
		if self._T.localReviveReceivedAt == nil then
			self._T.localReviveReceivedAt = 0
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsActiveMatchReady()
		if self.RequireActiveMatch ~= true then
			return true
		end
		if _BRBattleLauncher == nil then
			return false
		end
		return _BRBattleLauncher:IsActiveMatchForMap(self:GetBattleMapName())
	end

	@ExecSpace("ServerOnly")
	method boolean IsBattleGameplayStarted()
		if self.RequireActiveMatch ~= true then
			return true
		end
		if self:IsActiveMatchReady() ~= true then
			return false
		end
		if _BRBattleLauncher ~= nil then
			return _BRBattleLauncher:IsBattleGameplayStartedForMap(self:GetBattleMapName()) == true
		end
		if _BRBattleTimerSystem == nil then
			return true
		end
		return _BRBattleTimerSystem.TimerRunning == true and self:ReadString(_BRBattleTimerSystem.TimerMapName, "") == self:GetBattleMapName()
	end

	method boolean IsAttackAction(string actionName)
		local normalized = string.lower(self:ReadString(actionName, ""))
		local configured = string.lower(self:ReadString(self.AttackActionName, "Attack"))
		return normalized == configured or normalized == "attack" or normalized == "actionattack" or normalized == "basicattack"
	end

	method Vector2 GetEntityPosition2(Entity entity)
		if entity == nil or entity.TransformComponent == nil then
			return Vector2(0, 0)
		end
		
		local position = entity.TransformComponent.WorldPosition
		return Vector2(position.x, position.y)
	end

	method number GetLookDirection(Entity entity)
		if entity ~= nil and entity.PlayerControllerComponent ~= nil then
			if entity.PlayerControllerComponent.LookDirectionX >= 0 then
				return 1
			end
		end
		return -1
	end

	method string GetBattleMapName()
		if self.Entity ~= nil and self.Entity.CurrentMapName ~= nil and self.Entity.CurrentMapName ~= "" then
			return self.Entity.CurrentMapName
		end
		return "BattleMap"
	end

	method number GetBattleMaxHp()
		return math.max(1, math.floor(self:ReadNumber(self.BattleMaxHp, 100)))
	end

	method number GetBasicAttackDamage()
		return math.max(1, math.floor(self:ReadNumber(self.BasicAttackDamage, 20)))
	end

	method number GetOutOfBoundsDamage(Entity playerEntity)
		return math.max(1, math.floor(self:ReadNumber(self.OutOfBoundsDamage, self:GetBasicAttackDamage())))
	end

	method number GetOutOfBoundsDamageCooldownSeconds()
		return math.max(0.1, self:ReadNumber(self.OutOfBoundsDamageCooldownSeconds, 1))
	end

	method number GetRoomBottomOutOfBoundsPadding()
		return math.max(0, self:ReadNumber(self.RoomBottomOutOfBoundsPadding, 0.1))
	end

	method number GetOutOfBoundsFootholdSearchDistance()
		return math.max(2, self:ReadNumber(self.OutOfBoundsFootholdSearchDistance, 28))
	end

	method number GetAliveBotCount()
		self:EnsureServerRuntimeTables()
		local count = 0
		for botId, record in pairs(self._T.botRecords) do
			local bot = self:GetBotControllerFromRecord(record)
			if bot ~= nil and bot:IsAlive() == true then
				count = count + 1
			end
		end
		return count
	end

	method Entity FindNearestAliveBotTarget(Entity sourceEntity, Vector2 origin, number maxDistance)
		self:EnsureServerRuntimeTables()
		local best = nil
		local bestDistance = math.max(0, self:ReadNumber(maxDistance, 0))
		for botId, record in pairs(self._T.botRecords) do
			local bot = self:GetBotControllerFromRecord(record)
			if bot ~= nil and bot.Entity ~= nil and sourceEntity ~= nil and bot.Entity.Id ~= sourceEntity.Id and bot:IsAlive() == true then
				local targetPosition = self:GetEntityPosition2(bot.Entity)
				local dx = targetPosition.x - origin.x
				local dy = targetPosition.y - origin.y
				local distance = math.sqrt(dx * dx + dy * dy)
				if distance < bestDistance then
					bestDistance = distance
					best = bot.Entity
				end
			end
		end
		return best
	end

	method any GetBotControllerFromRecord(any record)
		if record == nil or record.Entity == nil or isvalid(record.Entity) == false then
			return nil
		end
		return self:GetBattleBotController(record.Entity)
	end

	method string GetBotId(Entity entity)
		if entity == nil then
			return ""
		end
		local bot = self:GetBattleBotController(entity)
		if bot == nil then
			return ""
		end
		return self:ReadString(bot.BotId, "")
	end

	method any GetBattleBotController(Entity entity)
		if entity == nil then
			return nil
		end
		local component = entity:GetComponent("script.BRBattleBotController")
		if component == nil then
			component = entity:GetComponent("BRBattleBotController")
		end
		return component
	end

	method number GetAdjustedBattleMaxHp(Entity playerEntity)
		if _BRSkillSystem == nil or playerEntity == nil or playerEntity.PlayerComponent == nil then
			return self:GetBattleMaxHp()
		end
		return _BRSkillSystem:GetMaxHp(playerEntity.PlayerComponent.UserId, self:GetBattleMaxHp())
	end

	method number GetAdjustedBasicAttackDamage(Entity attackerEntity)
		if _BRSkillSystem == nil or attackerEntity == nil or attackerEntity.PlayerComponent == nil then
			return self:GetBasicAttackDamage()
		end
		return _BRSkillSystem:GetBasicAttackDamage(attackerEntity.PlayerComponent.UserId, self:GetBasicAttackDamage())
	end

	method number GetAttackCooldownSeconds()
		return math.max(0.05, self:ReadNumber(self.AttackCooldownSeconds, 0.45))
	end

	method number GetHitInvincibleSeconds()
		return math.max(0, self:ReadNumber(self.HitInvincibleSeconds, 0.25))
	end

	method number GetPortalCombatLockSeconds()
		-- Returns how long combat contact blocks portal entry.
		return math.max(0, self:ReadNumber(self.PortalCombatLockSeconds, 1.25))
	end

	method number GetAttackBoxWidth()
		return math.max(0.1, self:ReadNumber(self.AttackBoxWidth, 1.6))
	end

	method number GetAttackBoxHeight()
		return math.max(0.1, self:ReadNumber(self.AttackBoxHeight, 1.0))
	end

	method number GetAttackOffsetX()
		return math.max(0, self:ReadNumber(self.AttackOffsetX, 0.9))
	end

	method number GetAttackOffsetY()
		return self:ReadNumber(self.AttackOffsetY, 0.35)
	end

	method number GetAttackOffsetYFromFeet()
		return self:ReadNumber(self.AttackOffsetYFromFeet, 0.35)
	end

	method number GetPlayerScanSeconds()
		return math.max(0.033, self:ReadNumber(self.PlayerScanSeconds, 0.05))
	end

	method number GetActiveMatchWaitPollSeconds()
		return math.max(0.1, self:ReadNumber(self.ActiveMatchWaitPollSeconds, 0.25))
	end

	method number GetPlayerRespawnDuration()
		return math.max(0, self:ReadNumber(self.PlayerRespawnDuration, 5))
	end

	method number GetDefaultLives()
		-- Returns total lives granted at battle entry.
		return math.max(1, math.floor(self:ReadNumber(self.DefaultLives, 2)))
	end

	method number GetMinimumPlayersForLastManEnd()
		-- Returns how many participants must have joined before last-man ending is allowed.
		return math.max(2, math.floor(self:ReadNumber(self.MinimumPlayersForLastManEnd, 2)))
	end

	method number GetLifeReviveDelaySeconds()
		-- Returns the delay before a consumed life revives the player.
		return math.max(0.5, self:ReadNumber(self.LifeReviveDelaySeconds, 4))
	end

	method number GetLifeReviveHpPercent()
		-- Returns the HP ratio restored on life revive.
		return math.max(0.05, math.min(1, self:ReadNumber(self.LifeReviveHpPercent, 0.6)))
	end

	method number GetLifeReviveInvincibleSeconds()
		-- Returns temporary invulnerability after life revive.
		return math.max(0, self:ReadNumber(self.LifeReviveInvincibleSeconds, 2))
	end

	method boolean IsLifeReviveSelectionEnabled()
		-- Returns whether custom revive point selection is required.
		return self.LifeReviveRequireSelection == true
	end

	method number GetLifeReviveSelectionTimeoutSeconds()
		-- Returns how long selection can remain unanswered after revive becomes available.
		return math.max(0, self:ReadNumber(self.LifeReviveSelectionTimeoutSeconds, 10))
	end

	method number GetLifeReviveMinForbiddenSeconds()
		-- Returns the minimum forbidden-zone time restored on revive.
		return math.max(0, self:ReadNumber(self.LifeReviveMinForbiddenSeconds, 10))
	end

	method number GetLifeNativeRespawnBlockSeconds()
		-- Keeps native respawn delayed while the custom life system controls revive.
		return math.max(1, self:ReadNumber(self.LifeNativeRespawnBlockSeconds, 9999))
	end

	method number GetLifeRespawnFloorOffsetY()
		-- Returns the vertical offset above a selected foothold.
		return self:ReadNumber(self.LifeRespawnFloorOffsetY, 0.35)
	end

	method number GetLifeRespawnSearchDistance()
		-- Returns the minimum downward ray distance for foothold alignment.
		return math.max(4, self:ReadNumber(self.LifeRespawnSearchDistance, 24))
	end

	method number GetPlatformGroundingSeconds()
		return math.max(0.016, self:ReadNumber(self.PlatformGroundingSeconds, 0.033))
	end

	method number GetFallResetY()
		return self:ReadNumber(self.FallResetY, -5)
	end

	method number GetMainFloorY()
		return 2.25
	end

	method number GetBattleGravity()
		return math.max(0.1, self:ReadNumber(self.BattleGravity, 1.8))
	end

	method number GetBattleWalkSpeed()
		return math.max(0.1, self:ReadNumber(self.BattleWalkSpeed, 1.95))
	end

	method number GetBattleWalkJump()
		return math.max(0.1, self:ReadNumber(self.BattleWalkJump, 1.95))
	end

	method string GetUserId(Entity entity)
		if entity ~= nil and entity.PlayerComponent ~= nil then
			return self:ReadString(entity.PlayerComponent.UserId, "")
		end
		return ""
	end

	method number Now()
		return _UtilLogic.ElapsedSeconds
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		if self.VerboseBattleLog == true then
			log("[BRBattle] " .. message)
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		self:UnregisterBattlePlayer(event.UserId)
		self:CheckLastManStanding("leave")
	end

end
