@Logic
script BRSupplySystem extends Logic

	property string DefaultMapName = "RoomTestMap"

	property string SupplyChildName = "SupplyBox"

	property string FallbackSupplyChildNames = "SupplyBox,SupplyPoint,SkillPartBox,skillPart,SkillPart,PartBox"

	property string RuntimeSupplyNamePrefix = "RuntimeSupplyBox"

	property string RuntimeSupplyBoxModelId = "skillpartbox"

	property string MonsterDataSetName = "monster"

	property string MonsterAnchorChildName = "Monster"

	property string FallbackMonsterAnchorChildNames = "Monster,Monster_1,Monster_2,Monster_3,Monster_4,MonsterSpawn,MonsterSpawnPoint"

	property integer MonsterFallbackRoomScanCount = 36

	property string RuntimeMonsterNamePrefix = "RuntimeBattleMonster"

	property string StartMonsterName = "갈리나"

	property string FinalEvolutionMonsterName = "푸른 눈의 가고일"

	property string FallbackMonsterModelId = "battlechainmonster"

	property number MonsterSpawnYOffset = 0.03

	property number MaxSuppliesPerDrop = 0

	property number SkillChestDropCount = 3

	property number SupplyChestDropCount = 3

	property number KioskSpawnDelaySeconds = 15

	property number KioskSpawnCount = 2

	property number SupplyDropCount = 1

	property number SupplyGroundYOffset = 0.03

	property number SupplyGroundSearchUp = 3

	property number SupplyGroundSearchDown = 24

	property string BossMonsterModelId = "battlechainmonster"

	property number BossSpawnYOffset = 0

	property number MonsterLevelUpHpMultiplier = 1.5

	property number MonsterLevelUpAttackMultiplier = 1.25

	property number MonsterLevelUpRewardMultiplier = 1.25

	property boolean VerboseLog = true

	@Sync
	property string LastSupplyMapName = ""

	@Sync
	property string LastSupplyState = "Idle"

	@Sync
	property number LastSupplyCandidateCount = 0

	@Sync
	property number LastSupplyDroppedCount = 0

	@Sync
	property number LastSupplyVersion = 0

	@Sync
	property string LastSupplyAlertCells = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes runtime storage for supply anchors.
		self:EnsureRuntime()
		self:Log("ready child=" .. self:GetSupplyChildName() .. " maxDrop=" .. tostring(self:GetMaxSuppliesPerDrop()))
	end

	@ExecSpace("ServerOnly")
	method void PrepareSuppliesForMatch(any matchRoom, any graph, string mapName)
		-- Collects and hides supply anchors before players enter the generated battle.
		local targetMapName = self:ResolveMapName(matchRoom, mapName)
		self:PrepareSupplies(targetMapName, graph)
	end

	@ExecSpace("ServerOnly")
	method number PrepareSupplies(string mapName, any graph)
		-- Finds supply child prefabs for a map and stores them until the timer finishes.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self:CollectSupplyCandidates(targetMapName, graph)
		self._T.candidatesByMap[targetMapName] = candidates
		local monsterAnchors = self:CollectMonsterAnchors(targetMapName, graph)
		self._T.monsterAnchorsByMap[targetMapName] = monsterAnchors
		self._T.currentMonsterRowByMap[targetMapName] = 0

		for index, supply in ipairs(candidates) do
			self:SetSupplyRuntimeActive(supply, false)
		end
		for index, anchor in ipairs(monsterAnchors) do
			self:HideMonsterAnchor(anchor)
		end
		self:ClearRuntimeMonstersForMap(targetMapName)

		local initialDropped = self:SpawnOneSkillChestPerRoom(targetMapName, candidates)

		self.LastSupplyMapName = targetMapName
		self.LastSupplyState = "Prepared"
		self.LastSupplyCandidateCount = #candidates
		self.LastSupplyDroppedCount = initialDropped
		self.LastSupplyVersion = self.LastSupplyVersion + 1
		self:Log("prepared map=" .. targetMapName
			.. " candidates=" .. tostring(#candidates)
			.. " monsterAnchors=" .. tostring(#monsterAnchors)
			.. " initialChests=" .. tostring(initialDropped))
		return #candidates
	end

	@ExecSpace("ServerOnly")
	method number DropSuppliesForMap(string mapName)
		-- Activates prepared supply boxes for the requested map.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self._T.candidatesByMap[targetMapName]
		if candidates == nil or #candidates <= 0 then
			candidates = self:CollectSupplyCandidates(targetMapName, nil)
			self._T.candidatesByMap[targetMapName] = candidates
		end

		if candidates == nil or #candidates <= 0 then
			self.LastSupplyMapName = targetMapName
			self.LastSupplyState = "Skipped"
			self.LastSupplyCandidateCount = 0
			self.LastSupplyDroppedCount = 0
			self.LastSupplyVersion = self.LastSupplyVersion + 1
			self:Log("drop skipped: no supply anchors map=" .. targetMapName)
			return 0
		end

		local limit = self:GetMaxSuppliesPerDrop()
		if limit <= 0 then
			limit = self:GetSupplyDropCount()
		end
		local dropped = self:SpawnSupplyDropForMap(targetMapName, limit)

		self.LastSupplyMapName = targetMapName
		self.LastSupplyState = "Dropped"
		self.LastSupplyCandidateCount = #candidates
		self.LastSupplyDroppedCount = dropped
		self.LastSupplyVersion = self.LastSupplyVersion + 1
		self:Log("dropped map=" .. targetMapName .. " active=" .. tostring(dropped) .. "/" .. tostring(#candidates))
		return dropped
	end

	@ExecSpace("ServerOnly")
	method void ClearSuppliesForMap(string mapName)
		-- Hides every remembered supply box on the requested map.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.LastSupplyMapName, self:ReadString(self.DefaultMapName, "RoomTestMap")))
		local candidates = self._T.candidatesByMap[targetMapName]
		local cleared = 0
		if candidates ~= nil then
			for index, supply in ipairs(candidates) do
				if self:SetSupplyRuntimeActive(supply, false) == true then
					cleared = cleared + 1
				end
			end
		end
		local monstersCleared = self:ClearRuntimeMonstersForMap(targetMapName)
		self._T.currentMonsterRowByMap[targetMapName] = 0

		self.LastSupplyMapName = targetMapName
		self.LastSupplyState = "Cleared"
		self.LastSupplyDroppedCount = 0
		self.LastSupplyVersion = self.LastSupplyVersion + 1
		self:Log("cleared map=" .. targetMapName .. " count=" .. tostring(cleared) .. " monsters=" .. tostring(monstersCleared))
	end

	@ExecSpace("ServerOnly")
	method void OnBattlePhaseChanged(string mapName, number phaseNumber)
		-- Runs phase-specific supply events once per map and phase.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.LastSupplyMapName, self:ReadString(self.DefaultMapName, "RoomTestMap")))
		local phase = math.floor(self:ReadNumber(phaseNumber, 0))
		local key = targetMapName .. ":" .. tostring(phase)
		if self._T.phaseEvents[key] == true then
			return
		end
		self._T.phaseEvents[key] = true
		local evolvedCount = self:TryEvolveMonstersForPhase(targetMapName, phase)
		if evolvedCount > 0 then
			self:PublishSupplyEvent(targetMapName, "MonsterEvolve", evolvedCount, "")
		end

		if phase == 3 then
			local delay = self:GetKioskSpawnDelaySeconds()
			_TimerService:SetTimerOnce(function() self:SpawnPhaseKiosks(targetMapName) end, delay)
			self.LastSupplyState = "KioskPending"
			self:Log("phase 3 kiosk scheduled map=" .. targetMapName .. " delay=" .. tostring(delay))
		elseif phase == 4 then
			local count = self:RefillOpenRoomChests(targetMapName)
			self:PublishSupplyEvent(targetMapName, "Refill", count, "")
		elseif phase == 5 then
			local count = self:SpawnSupplyDropForMap(targetMapName, self:GetSupplyDropCount())
			self:PublishSupplyEvent(targetMapName, "SupplyDrop", count, self.LastSupplyAlertCells)
		elseif phase == 6 then
			self:PublishSupplyEvent(targetMapName, "MonsterEvolve", evolvedCount, "")
		elseif phase == 7 then
			local count = self:SpawnBossForMap(targetMapName)
			self:PublishSupplyEvent(targetMapName, "Boss", count, "")
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnPhaseKiosks(string mapName)
		-- Spawns kiosk boxes in up to two empty anchors among the center nine open rooms.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.LastSupplyMapName, self:ReadString(self.DefaultMapName, "RoomTestMap")))
		local count = self:SpawnKiosksForMap(targetMapName, self:GetKioskSpawnCount())
		self:PublishSupplyEvent(targetMapName, "Kiosk", count, self.LastSupplyAlertCells)
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Prepare Supplies")
	method void DebugPrepareSupplies()
		-- Prepares supply anchors on the default test map.
		self:PrepareSupplies(self:ReadString(self.DefaultMapName, "RoomTestMap"), nil)
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Drop Supplies")
	method void DebugDropSupplies()
		-- Drops supply boxes on the default test map.
		self:DropSuppliesForMap(self:ReadString(self.DefaultMapName, "RoomTestMap"))
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Clear Supplies")
	method void DebugClearSupplies()
		-- Clears supply boxes on the default test map.
		self:ClearSuppliesForMap(self:ReadString(self.DefaultMapName, "RoomTestMap"))
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Start Monsters")
	method void DebugStartMonsters()
		-- Spawns the first CSV monster row on every authored monster anchor.
		self:StartMonstersForMap(self:ReadString(self.DefaultMapName, "RoomTestMap"))
	end

	@ExecSpace("ServerOnly")
	method number StartMonstersForMap(string mapName)
		-- Starts the CSV monster chain from the configured first monster row.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local rowIndex = self:GetStartMonsterRowIndex()
		if rowIndex <= 0 then
			self:Log("monster start skipped reason=noStartRow map=" .. targetMapName)
			return 0
		end
		local count = self:ReplaceMonsterWave(targetMapName, rowIndex, "start")
		self:PublishSupplyEvent(targetMapName, "MonsterStart", count, "")
		return count
	end

	method number TryEvolveMonstersForPhase(string mapName, number phaseNumber)
		-- Evolves active monsters when the current CSV row's evolution phase is reached.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local currentRow = math.floor(self:ReadNumber(self._T.currentMonsterRowByMap[targetMapName], 0))
		if currentRow <= 0 then
			return 0
		end

		local current = self:GetMonsterDataRow(currentRow)
		if current == nil then
			return 0
		end
		local phase = math.floor(self:ReadNumber(phaseNumber, 0))
		if math.floor(self:ReadNumber(current.EvolutionPhase, 0)) ~= phase then
			return 0
		end

		local nextRow = currentRow + 1
		local finalRow = self:GetFinalEvolutionRowIndex()
		if finalRow > 0 and nextRow > finalRow then
			return 0
		end
		if self:GetMonsterDataRow(nextRow) == nil then
			return 0
		end
		return self:ReplaceMonsterWave(targetMapName, nextRow, "phase " .. tostring(phase))
	end

	method number ReplaceMonsterWave(string mapName, number rowIndex, string reason)
		-- Destroys the previous wave and respawns the requested CSV monster at every monster anchor.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local row = math.max(1, math.floor(self:ReadNumber(rowIndex, 1)))
		self:ClearRuntimeMonstersForMap(targetMapName)
		local spawned = self:SpawnMonsterWaveForRow(targetMapName, row)
		if spawned > 0 then
			self._T.currentMonsterRowByMap[targetMapName] = row
		end
		local data = self:GetMonsterDataRow(row)
		local name = ""
		if data ~= nil then
			name = self:ReadString(data.Name, "")
		end
		self:Log("monster wave map=" .. targetMapName
			.. " row=" .. tostring(row)
			.. " name=" .. name
			.. " count=" .. tostring(spawned)
			.. " reason=" .. self:ReadString(reason, ""))
		return spawned
	end

	method number SpawnMonsterWaveForRow(string mapName, number rowIndex)
		-- Spawns one configured monster for each authored monster anchor.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local anchors = self:GetMonsterAnchorsForMap(targetMapName)
		if anchors == nil or #anchors <= 0 then
			self:Log("monster wave skipped reason=noAnchors map=" .. targetMapName)
			return 0
		end

		local spawned = 0
		for index, anchor in ipairs(anchors) do
			local monster = self:SpawnMonsterForAnchor(targetMapName, anchor, rowIndex, false)
			if monster ~= nil then
				spawned = spawned + 1
				self:RememberRuntimeMonster(targetMapName, monster, rowIndex, self:GetEntityKey(anchor))
			end
		end
		return spawned
	end

	method Entity SpawnMonsterForAnchor(string mapName, Entity anchor, number rowIndex, boolean boss)
		-- Spawns one CSV-configured monster at an authored map anchor.
		if anchor == nil or isvalid(anchor) ~= true then
			return nil
		end
		self:HideMonsterAnchor(anchor)
		local position = self:GetMonsterAnchorSpawnPosition(mapName, anchor)
		return self:SpawnConfiguredMonster(mapName, rowIndex, position, boss == true)
	end

	method Entity SpawnConfiguredMonster(string mapName, number rowIndex, Vector3 position, boolean boss)
		-- Spawns the local battle monster model and applies monster.csv preset metadata/stats.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. targetMapName)
		if mapEntity == nil then
			self:Log("monster spawn skipped reason=noMap map=" .. targetMapName)
			return nil
		end

		local row = math.max(1, math.floor(self:ReadNumber(rowIndex, 1)))
		local fallbackModelId = self:GetFallbackMonsterModelId()
		local entityName = self:GetRuntimeMonsterName(row, boss == true)
		local monster = _SpawnService:SpawnByModelId(fallbackModelId, entityName, position, mapEntity)
		if monster == nil then
			self:Log("monster spawn failed row=" .. tostring(row) .. " modelId=" .. fallbackModelId .. " map=" .. targetMapName)
			return nil
		end
		self:ConfigureBattleMonsterEntity(monster, row, boss == true)
		return monster
	end

	method void ConfigureBattleMonsterEntity(Entity monster, number rowIndex, boolean boss)
		-- Applies data-driven battle target stats to a spawned monster entity.
		if monster == nil or isvalid(monster) ~= true then
			return
		end
		if monster.NameTagComponent == nil then
			monster:AddComponent("NameTagComponent")
		end
		if monster.NameTagComponent ~= nil then
			monster.NameTagComponent.Enable = true
			monster.NameTagComponent.OffsetY = 1.4
		end

		local data = self:GetMonsterDataRow(rowIndex)
		self:EnsureMonsterRuntimeComponents(monster, data, boss == true)

		local dummy = monster:GetComponent("script.BRTrainingDummy")
		if dummy == nil then
			dummy = monster:GetComponent("BRTrainingDummy")
		end
		if dummy == nil then
			dummy = monster:AddComponent("script.BRTrainingDummy")
		end
		if dummy ~= nil and data ~= nil then
			---@type BRTrainingDummy
			local trainingDummy = dummy
			trainingDummy.VerboseLog = boss == true
			trainingDummy:InitializeBattleMonster(
				self:ReadString(data.Name, "Battle Monster"),
				self:ReadString(data.ModelId, ""),
				self:ReadNumber(data.Level, 1),
				self:ReadNumber(data.MaxHp, 1),
				self:ReadNumber(data.HitDamage, 0),
				self:ReadNumber(data.MesoReward, 0),
				self:ReadNumber(data.ExpReward, 0),
				boss == true
			)
		end
		self:ApplyMonsterRenderDefaults(monster, boss == true, data)
		self:ConfigureMonsterRuntimeAI(monster, data, boss == true)
	end

	method void EnsureMonsterRuntimeComponents(Entity monster, any data, boolean boss)
		-- The local fallback model is a training dummy, so runtime monsters need render, body, and AI pieces.
		if monster == nil or isvalid(monster) ~= true then
			return
		end
		if monster.SpriteRendererComponent == nil then
			monster:AddComponent("SpriteRendererComponent")
		end
		if monster.RigidbodyComponent == nil then
			monster:AddComponent("RigidbodyComponent")
		end
		if monster.MovementComponent == nil then
			monster:AddComponent("MovementComponent")
		end
		local ai = monster:GetComponent("script.BRBattleMonsterAI")
		if ai == nil then
			ai = monster:GetComponent("BRBattleMonsterAI")
		end
		if ai == nil then
			monster:AddComponent("script.BRBattleMonsterAI")
		end
		if monster.PolygonRendererComponent ~= nil then
			monster.PolygonRendererComponent.Enable = false
		end
		self:ConfigureMonsterPhysicsDefaults(monster, data, boss == true)
	end

	method void ConfigureMonsterPhysicsDefaults(Entity monster, any data, boolean boss)
		if monster == nil then
			return
		end
		local moveSpeed = self:GetBattleMonsterMoveSpeed(data, boss == true)
		if monster.RigidbodyComponent ~= nil then
			monster.RigidbodyComponent.Enable = true
			monster.RigidbodyComponent.KinematicMove = false
			monster.RigidbodyComponent.IsolatedMove = false
			monster.RigidbodyComponent.IgnoreMoveBoundary = false
			monster.RigidbodyComponent.Gravity = 30
			monster.RigidbodyComponent.WalkSpeed = moveSpeed
			monster.RigidbodyComponent.WalkJump = 1.4
			monster.RigidbodyComponent:PositionReset()
		end
		if monster.MovementComponent ~= nil then
			monster.MovementComponent.InputSpeed = moveSpeed
			monster.MovementComponent.JumpForce = 1.4
		end
	end

	method void ApplyMonsterRenderDefaults(Entity monster, boolean boss, any data)
		-- Keeps spawned preset monsters above map tiles and readable as battle targets.
		if monster == nil then
			return
		end
		if monster.SpriteRendererComponent ~= nil then
			local standRuid = self:GetMonsterVisualRUIDByData(data, "stand")
			if standRuid ~= "" then
				monster.SpriteRendererComponent.SpriteRUID = standRuid
			end
			monster.SpriteRendererComponent.SortingLayer = "MapLayer0"
			monster.SpriteRendererComponent.OrderInLayer = 34
			monster.SpriteRendererComponent.IgnoreMapLayerCheck = true
			monster.SpriteRendererComponent.Enable = true
			monster.SpriteRendererComponent.Color = Color(1, 1, 1, 1)
			monster.SpriteRendererComponent:SetAlpha(1)
		end
		if monster.AvatarRendererComponent ~= nil then
			monster.AvatarRendererComponent.SortingLayer = "MapLayer0"
			monster.AvatarRendererComponent.OrderInLayer = 34
			monster.AvatarRendererComponent.IgnoreMapLayerCheck = true
			monster.AvatarRendererComponent.Enable = true
		end
		if monster.TransformComponent ~= nil and boss == true then
			local scale = monster.TransformComponent.Scale
			monster.TransformComponent.Scale = Vector3(math.abs(scale.x) * 1.15, math.abs(scale.y) * 1.15, scale.z)
		end
	end

	method void ConfigureMonsterRuntimeAI(Entity monster, any data, boolean boss)
		if monster == nil or data == nil then
			return
		end
		local ai = monster:GetComponent("script.BRBattleMonsterAI")
		if ai == nil then
			ai = monster:GetComponent("BRBattleMonsterAI")
		end
		if ai == nil then
			self:Log("monster ai missing name=" .. self:ReadString(monster.Name, "monster"))
			return
		end
		---@type BRBattleMonsterAI
		local monsterAI = ai
		monsterAI.MoveSpeed = self:GetBattleMonsterMoveSpeed(data, boss == true)
		monsterAI.VerboseLog = boss == true
		monsterAI:ConfigureBattleMonsterAI(
			self:GetMonsterVisualRUIDByData(data, "stand"),
			self:GetMonsterVisualRUIDByData(data, "move"),
			self:GetMonsterVisualRUIDByData(data, "attack"),
			self:GetMonsterVisualRUIDByData(data, "die"),
			self:ReadNumber(data.HitDamage, 1),
			boss == true
		)
	end

	method number GetBattleMonsterMoveSpeed(any data, boolean boss)
		local level = 1
		if data ~= nil then
			level = math.max(1, math.floor(self:ReadNumber(data.Level, 1)))
		end
		local speed = 0.6 + math.min(0.35, level * 0.045)
		if boss == true then
			speed = math.max(speed, 0.95)
		end
		return speed
	end

	method string GetMonsterVisualRUIDByData(any data, string action)
		local presetName = ""
		if data ~= nil then
			presetName = self:ReadString(data.ModelId, "")
		end
		return self:GetMonsterVisualRUID(presetName, action)
	end

	method string GetMonsterVisualRUID(string presetName, string action)
		local preset = string.lower(self:ReadString(presetName, ""))
		local state = string.lower(self:ReadString(action, "stand"))
		if preset == "monster-797" then
			return self:GetMonsterVisualRUIDFromState(state,
				"9cd156b021944812adee08038f82731f",
				"b44d5aa5e1704deab2dab7ef512b4a70",
				"bbd6d46426ff40a3ba7796d3c3dc8d0f",
				"fbde4fab716a4e658eb88a27a2d321df")
		elseif preset == "monster-1637" then
			return self:GetMonsterVisualRUIDFromState(state,
				"d5966a1f6c80461bb50b1ff9544c7d28",
				"c289009fbd924d2b880e897fb3523828",
				"01a1fcfcf33b4e8488f1fbaac1eaeaee",
				"49d1578d52e144a183958128c7fc1daf")
		elseif preset == "monster-2796" then
			return self:GetMonsterVisualRUIDFromState(state,
				"43304dbb82894470861f079a0adf649b",
				"ee648f1c6db64c35935a89e46902993f",
				"9a8646ca583a4c2eb79fbf67c14841f4",
				"fd050baaabf94b59a05d38a38de261b7")
		elseif preset == "monster-1859" then
			return self:GetMonsterVisualRUIDFromState(state,
				"5acdccae3bd24089bb18b5f0c8c8a081",
				"b7e6bbb9c04a4d9d8d2196bd76ad645e",
				"fe8e8e9226644d8e8c852b5a00c97b21",
				"930ade7b0c88406e8f36238644c842c8")
		elseif preset == "monster-531" then
			return self:GetMonsterVisualRUIDFromState(state,
				"f3687ed4444d41c6b640e6da1da46924",
				"d473319f4f11425c8207a12fbbefdb54",
				"a285deb5eda24250ba37c861b9a67d9b",
				"5436ad26396b450196b1c30d29cffe26")
		elseif preset == "monster-3367" then
			return self:GetMonsterVisualRUIDFromState(state,
				"cc19ff7ffbc744fca9a35ce0e4d3ca89",
				"c3b4aaa8a64c44f9b1f09fa4174a6445",
				"92a1040bf0504bb48c1cf034e142c35e",
				"58a1032a261249f5a20257dc92fd788a")
		end
		return self:GetMonsterVisualRUIDFromState(state,
			"9cd156b021944812adee08038f82731f",
			"b44d5aa5e1704deab2dab7ef512b4a70",
			"bbd6d46426ff40a3ba7796d3c3dc8d0f",
			"fbde4fab716a4e658eb88a27a2d321df")
	end

	method string GetMonsterVisualRUIDFromState(string state, string standRuid, string moveRuid, string attackRuid, string dieRuid)
		local stateKey = string.lower(self:ReadString(state, "stand"))
		if stateKey == "move" then
			return self:ReadString(moveRuid, standRuid)
		elseif stateKey == "attack" or stateKey == "attack1" then
			return self:ReadString(attackRuid, standRuid)
		elseif stateKey == "die" or stateKey == "die1" then
			return self:ReadString(dieRuid, standRuid)
		end
		return self:ReadString(standRuid, "")
	end

	method number SpawnBossForMap(string mapName)
		-- Spawns the last monster.csv row as the phase-7 center boss.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local rowIndex = self:GetLastMonsterRowIndex()
		if rowIndex <= 0 then
			self:Log("boss skipped reason=noMonsterData map=" .. targetMapName)
			return 0
		end
		local center = self:GetMapCenterPosition(targetMapName)
		local spawnPosition = self:GetMonsterSpawnPositionNear(targetMapName, center)
		local boss = self:SpawnConfiguredMonster(targetMapName, rowIndex, spawnPosition, true)
		if boss == nil then
			return 0
		end
		self:RememberRuntimeMonster(targetMapName, boss, rowIndex, "boss")
		local data = self:GetMonsterDataRow(rowIndex)
		local name = ""
		if data ~= nil then
			name = self:ReadString(data.Name, "")
		end
		self:Log("boss spawned row=" .. tostring(rowIndex)
			.. " name=" .. name
			.. " map=" .. targetMapName)
		return 1
	end

	method number SpawnOneSkillChestPerRoom(string mapName, any candidates)
		-- Activates at most one random skill chest anchor in each generated room.
		local groups = self:GroupCandidatesByRoom(candidates)
		local spawned = 0
		for index, group in ipairs(groups) do
			local supply = self:PickEmptySupplyFromGroup(group)
			if supply ~= nil and self:SetSupplyRuntimeActiveWithKind(supply, true, "skill") == true then
				spawned = spawned + 1
			end
		end
		return spawned
	end

	method number RefillOpenRoomChests(string mapName)
		-- Refills one skill chest in every currently open safe room that has an empty anchor.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self:GetCandidatesForMap(targetMapName)
		local groups = self:GroupCandidatesByRoom(candidates)
		local spawned = 0
		for index, group in ipairs(groups) do
			if self:IsRoomOpenForSupplies(targetMapName, self:ReadString(group.RoomName, "")) == true and self:GroupHasActiveSupply(group) ~= true then
				local supply = self:PickEmptySupplyFromGroup(group)
				if supply ~= nil and self:SetSupplyRuntimeActiveWithKind(supply, true, "skill") == true then
					spawned = spawned + 1
				end
			end
		end
		self:Log("refill map=" .. targetMapName .. " count=" .. tostring(spawned))
		return spawned
	end

	method number SpawnSupplyDropForMap(string mapName, number count)
		-- Spawns slime treasure boxes in empty safe-room anchors.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self:GetEmptyOpenCandidates(targetMapName, false)
		local spawned = self:ActivateRandomCandidates(targetMapName, candidates, math.max(1, math.floor(self:ReadNumber(count, 1))), "supply", "S")
		self:Log("supply drop map=" .. targetMapName .. " count=" .. tostring(spawned))
		return spawned
	end

	method number SpawnKiosksForMap(string mapName, number count)
		-- Spawns candy-machine kiosks in empty center-nine safe-room anchors.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self:GetEmptyOpenCandidates(targetMapName, true)
		local spawned = self:ActivateRandomCandidates(targetMapName, candidates, math.max(1, math.floor(self:ReadNumber(count, 1))), "kiosk", "K")
		self:Log("kiosk spawn map=" .. targetMapName .. " count=" .. tostring(spawned))
		return spawned
	end

	method number LevelUpMonstersForMap(string mapName)
		-- Strengthens existing training monsters and battle bots for phase 6.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. targetMapName)
		if mapEntity == nil then
			self:Log("monster level-up skipped reason=noMap map=" .. targetMapName)
			return 0
		end

		local hpMultiplier = self:GetMonsterLevelUpHpMultiplier()
		local attackMultiplier = self:GetMonsterLevelUpAttackMultiplier()
		local rewardMultiplier = self:GetMonsterLevelUpRewardMultiplier()
		local count = 0

		local dummyComponents = mapEntity:GetChildComponentsByTypeName("script.BRTrainingDummy", true)
		if dummyComponents == nil or #dummyComponents <= 0 then
			dummyComponents = mapEntity:GetChildComponentsByTypeName("BRTrainingDummy", true)
		end
		if dummyComponents ~= nil then
			for index, component in ipairs(dummyComponents) do
				if component ~= nil then
					---@type BRTrainingDummy
					local dummy = component
					local oldHp = dummy:GetMaxHp()
					dummy.MaxHp = math.max(oldHp + 1, math.floor(oldHp * hpMultiplier))
					dummy.SkillExperienceReward = math.max(dummy:GetSkillExperienceReward(), math.floor(dummy:GetSkillExperienceReward() * rewardMultiplier))
					dummy.MesoReward = math.max(dummy:GetMesoReward(), math.floor(dummy:GetMesoReward() * rewardMultiplier))
					if dummy.CurrentHp > 0 then
						dummy.CurrentHp = dummy:GetMaxHp()
						dummy:UpdateNameTag()
					end
					count = count + 1
				end
			end
		end

		local botComponents = mapEntity:GetChildComponentsByTypeName("script.BRBattleBotController", true)
		if botComponents == nil or #botComponents <= 0 then
			botComponents = mapEntity:GetChildComponentsByTypeName("BRBattleBotController", true)
		end
		if botComponents ~= nil then
			for index, component in ipairs(botComponents) do
				if component ~= nil then
					---@type BRBattleBotController
					local bot = component
					local oldHp = bot:GetMaxHp()
					local oldAttack = bot:GetAttackDamage()
					bot.MaxHp = math.max(oldHp + 1, math.floor(oldHp * hpMultiplier))
					bot.AttackDamage = math.max(oldAttack + 1, math.floor(oldAttack * attackMultiplier))
					bot.MesoReward = math.max(bot:GetMesoReward(), math.floor(bot:GetMesoReward() * rewardMultiplier))
					if bot.BotState == "ALIVE" and bot.CurrentHp > 0 then
						bot.CurrentHp = bot:GetMaxHp()
						bot:UpdateNameTag()
					end
					count = count + 1
				end
			end
		end

		self:Log("phase 6 monster level-up map=" .. targetMapName .. " count=" .. tostring(count)
			.. " hpMul=" .. tostring(hpMultiplier) .. " attackMul=" .. tostring(attackMultiplier))
		return count
	end

	method number ActivateRandomCandidates(string mapName, any candidates, number count, string kind, string alertKind)
		-- Picks random empty candidates, activates them, and publishes minimap alert cells.
		local spawned = 0
		local alertRecords = {}
		local pool = self:CopyCandidateList(candidates)
		local limit = math.max(0, math.floor(self:ReadNumber(count, 0)))
		while spawned < limit and #pool > 0 do
			local index = _UtilLogic:RandomIntegerRange(1, #pool)
			local supply = pool[index]
			table.remove(pool, index)
			if supply ~= nil and self:SetSupplyRuntimeActiveWithKind(supply, true, kind) == true then
				spawned = spawned + 1
				local record = self:GetSupplyAlertRecord(mapName, supply, alertKind)
				if record ~= "" then
					table.insert(alertRecords, record)
				end
			end
		end
		self.LastSupplyAlertCells = self:JoinRecords(alertRecords)
		return spawned
	end

	method any GetEmptyOpenCandidates(string mapName, boolean centerOnly)
		-- Returns empty supply anchors in safe rooms, optionally restricted to the center nine cells.
		local result = {}
		local candidates = self:GetCandidatesForMap(mapName)
		for index, supply in ipairs(candidates) do
			local roomName = self:GetRoomNameForSupply(supply)
			if self:IsSupplyEmpty(supply) == true and self:IsRoomOpenForSupplies(mapName, roomName) == true then
				if centerOnly ~= true or self:IsRoomInCenterNine(mapName, roomName) == true then
					table.insert(result, supply)
				end
			end
		end
		return result
	end

	method any GetCandidatesForMap(string mapName)
		-- Returns cached candidates or recollects anchors for the target map.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self._T.candidatesByMap[targetMapName]
		if candidates == nil or #candidates <= 0 then
			candidates = self:CollectSupplyCandidates(targetMapName, nil)
			self._T.candidatesByMap[targetMapName] = candidates
		end
		return candidates
	end

	method any GroupCandidatesByRoom(any candidates)
		-- Groups supply anchors by the generated room that owns them.
		local groups = {}
		local byRoom = {}
		if candidates == nil then
			return groups
		end
		for index, supply in ipairs(candidates) do
			local roomName = self:GetRoomNameForSupply(supply)
			if roomName == "" then
				roomName = self:GetEntityKey(supply)
			end
			if roomName ~= "" then
				local group = byRoom[roomName]
				if group == nil then
					group = { RoomName = roomName, Supplies = {} }
					byRoom[roomName] = group
					table.insert(groups, group)
				end
				table.insert(group.Supplies, supply)
			end
		end
		return groups
	end

	method Entity PickEmptySupplyFromGroup(any group)
		-- Chooses one empty supply anchor from a room group.
		if group == nil or group.Supplies == nil then
			return nil
		end
		local candidates = {}
		for index, supply in ipairs(group.Supplies) do
			if self:IsSupplyEmpty(supply) == true then
				table.insert(candidates, supply)
			end
		end
		if #candidates <= 0 then
			return nil
		end
		return candidates[_UtilLogic:RandomIntegerRange(1, #candidates)]
	end

	method boolean GroupHasActiveSupply(any group)
		-- Checks whether a room already has an active chest or kiosk.
		if group == nil or group.Supplies == nil then
			return false
		end
		for index, supply in ipairs(group.Supplies) do
			local runtimeSupply = self:GetRuntimeSupplyForAnchor(supply)
			if self:IsRuntimeSupplyActive(runtimeSupply) == true then
				return true
			end
		end
		return false
	end

	method boolean IsSupplyEmpty(Entity supply)
		-- Checks whether a supply anchor is currently free to receive a runtime chest.
		if supply == nil or isvalid(supply) ~= true then
			return false
		end
		local runtimeSupply = self:GetRuntimeSupplyForAnchor(supply)
		if runtimeSupply ~= nil then
			return self:IsRuntimeSupplyActive(runtimeSupply) ~= true
		end
		return true
	end

	method boolean IsRoomOpenForSupplies(string mapName, string roomName)
		-- Checks whether the room is currently inside the magnetic safe region.
		local cell = self:GetLogicalCellForRoom(mapName, roomName)
		if cell == nil then
			return true
		end
		if _BRMagneticZoneSystem == nil or _BRMagneticZoneSystem.ZoneRunning ~= true then
			return true
		end
		local row = math.floor(self:ReadNumber(cell.Row, 0))
		local column = math.floor(self:ReadNumber(cell.Column, 0))
		if row <= 0 or column <= 0 then
			return true
		end
		return row >= self:ReadNumber(_BRMagneticZoneSystem.SafeMinRow, 1)
			and row <= self:ReadNumber(_BRMagneticZoneSystem.SafeMaxRow, 999)
			and column >= self:ReadNumber(_BRMagneticZoneSystem.SafeMinColumn, 1)
			and column <= self:ReadNumber(_BRMagneticZoneSystem.SafeMaxColumn, 999)
	end

	method boolean IsRoomInCenterNine(string mapName, string roomName)
		-- Checks whether the room belongs to the 3x3 center kiosk band.
		local cell = self:GetLogicalCellForRoom(mapName, roomName)
		if cell == nil then
			return false
		end
		local graph = self:GetGraphForMap(mapName)
		if graph == nil then
			return false
		end
		local centerRow = math.floor((self:ReadNumber(graph.Rows, 1) + 1) * 0.5)
		local centerColumn = math.floor((self:ReadNumber(graph.Columns, 1) + 1) * 0.5)
		local row = math.floor(self:ReadNumber(cell.Row, 0))
		local column = math.floor(self:ReadNumber(cell.Column, 0))
		return math.abs(row - centerRow) <= 1 and math.abs(column - centerColumn) <= 1
	end

	method any GetLogicalCellForRoom(string mapName, string roomName)
		-- Finds the logical row and column assigned to a physical generated room.
		local safeRoomName = self:ReadString(roomName, "")
		if safeRoomName == "" then
			return nil
		end
		local graph = self:GetGraphForMap(mapName)
		if graph == nil or graph.Rooms == nil then
			return nil
		end
		for index, room in ipairs(graph.Rooms) do
			local assigned = self:ReadString(room.AssignedRoomName, self:ReadString(room.Name, ""))
			if assigned == safeRoomName or self:ReadString(room.Name, "") == safeRoomName then
				return { Row = self:ReadNumber(room.Row, 0), Column = self:ReadNumber(room.Column, 0) }
			end
		end
		return nil
	end

	method any GetGraphForMap(string mapName)
		-- Returns the latest logical graph for a battle map.
		if _BRRoomGraphGenerator == nil then
			return nil
		end
		return _BRRoomGraphGenerator:GetLatestGraphForMap(self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap")))
	end

	method string GetRoomNameForSupply(Entity supply)
		-- Walks up the entity tree to find the generated room name for an anchor.
		local current = supply
		local depth = 0
		while current ~= nil and depth < 12 do
			if self:IsGeneratedRoomName(current.Name) == true then
				return self:ReadString(current.Name, "")
			end
			current = current.Parent
			depth = depth + 1
		end
		return ""
	end

	method string GetSupplyAlertRecord(string mapName, Entity supply, string alertKind)
		-- Builds one minimap alert record in row,column,kind form.
		local roomName = self:GetRoomNameForSupply(supply)
		local cell = self:GetLogicalCellForRoom(mapName, roomName)
		if cell == nil then
			return ""
		end
		return tostring(math.floor(self:ReadNumber(cell.Row, 0))) .. "," .. tostring(math.floor(self:ReadNumber(cell.Column, 0))) .. "," .. self:ReadString(alertKind, "S")
	end

	method string JoinRecords(any records)
		-- Joins minimap alert records with semicolons.
		local result = ""
		if records == nil then
			return result
		end
		for index, record in ipairs(records) do
			local value = self:ReadString(record, "")
			if value ~= "" then
				if result ~= "" then
					result = result .. ";"
				end
				result = result .. value
			end
		end
		return result
	end

	method any CopyCandidateList(any candidates)
		-- Copies a candidate list before random removal.
		local result = {}
		if candidates == nil then
			return result
		end
		for index, supply in ipairs(candidates) do
			table.insert(result, supply)
		end
		return result
	end

	method any GetMonsterAnchorsForMap(string mapName)
		-- Returns cached monster anchors or recollects them from generated rooms.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local anchors = self._T.monsterAnchorsByMap[targetMapName]
		if anchors == nil or #anchors <= 0 then
			anchors = self:CollectMonsterAnchors(targetMapName, nil)
			self._T.monsterAnchorsByMap[targetMapName] = anchors
		end
		return anchors
	end

	method any CollectMonsterAnchors(string mapName, any graph)
		-- Collects authored Monster children from assigned generated rooms.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local anchors = {}
		local seen = {}
		if graph ~= nil and graph.Rooms ~= nil then
			for index, graphRoom in ipairs(graph.Rooms) do
				local roomName = self:ReadString(graphRoom.AssignedRoomName, self:ReadString(graphRoom.Name, ""))
				self:CollectMonsterAnchorsForRoomName(targetMapName, roomName, anchors, seen)
			end
		end
		if #anchors <= 0 then
			self:CollectDefaultMonsterAnchors(targetMapName, anchors, seen)
		end
		self:Log("monster anchors collected map=" .. targetMapName .. " count=" .. tostring(#anchors))
		return anchors
	end

	method void CollectDefaultMonsterAnchors(string mapName, any anchors, any seen)
		-- Uses stable generated-room paths without walking the runtime entity tree.
		self:CollectMonsterAnchorsForRoomName(mapName, "CornerNW", anchors, seen)
		self:CollectMonsterAnchorsForRoomName(mapName, "CornerNE", anchors, seen)
		self:CollectMonsterAnchorsForRoomName(mapName, "CornerSW", anchors, seen)
		self:CollectMonsterAnchorsForRoomName(mapName, "CornerSE", anchors, seen)
		for index = 1, self:GetMonsterFallbackRoomScanCount() do
			self:CollectMonsterAnchorsForRoomName(mapName, self:GetGeneratedRoomIndexedName(index), anchors, seen)
		end
	end

	method void CollectMonsterAnchorsForRoomName(string mapName, string roomName, any anchors, any seen)
		-- Finds Monster marker children by direct entity path under generated and direct map rooms.
		local safeMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local safeRoomName = self:ReadString(roomName, "")
		if safeRoomName == "" then
			return
		end
		self:CollectMonsterAnchorsAtBasePath("/maps/" .. safeMapName .. "/EditorGeneratedGrid/" .. safeRoomName, anchors, seen)
		self:CollectMonsterAnchorsAtBasePath("/maps/" .. safeMapName .. "/" .. safeRoomName, anchors, seen)
	end

	method void CollectMonsterAnchorsAtBasePath(string basePath, any anchors, any seen)
		-- Adds every configured marker name from one known room path.
		local safeBasePath = self:ReadString(basePath, "")
		if safeBasePath == "" then
			return
		end
		self:AddMonsterAnchor(anchors, seen, _EntityService:GetEntityByPath(safeBasePath .. "/" .. self:GetMonsterAnchorChildName()))
		local names = self:GetFallbackMonsterAnchorNames()
		for index, childName in ipairs(names) do
			self:AddMonsterAnchor(anchors, seen, _EntityService:GetEntityByPath(safeBasePath .. "/" .. childName))
		end
	end

	method void CollectRoomMonsterAnchors(Entity room, any anchors, any seen)
		-- Adds direct and nested Monster markers from one generated room.
		if room == nil then
			return
		end

		self:AddMonsterAnchor(anchors, seen, room:GetChildByName(self:GetMonsterAnchorChildName(), false))
		local names = self:GetFallbackMonsterAnchorNames()
		for index, childName in ipairs(names) do
			self:AddMonsterAnchor(anchors, seen, room:GetChildByName(childName, false))
		end

		if room.Children ~= nil then
			local children = room.Children:ToTable()
			for index, child in ipairs(children) do
				if child ~= nil and self:IsMonsterAnchorName(child.Name) == true then
					self:AddMonsterAnchor(anchors, seen, child)
				end
			end
		end
		self:CollectMonsterAnchorsRecursive(room, anchors, seen, 0)
	end

	method void CollectMonsterAnchorsRecursive(Entity entity, any anchors, any seen, number depth)
		-- Finds nested monster markers without depending on direct-child placement.
		if entity == nil or entity.Children == nil then
			return
		end
		local safeDepth = math.floor(self:ReadNumber(depth, 0))
		if safeDepth > 16 then
			return
		end
		local children = entity.Children:ToTable()
		for index, child in ipairs(children) do
			if child ~= nil then
				if self:IsMonsterAnchorName(child.Name) == true then
					self:AddMonsterAnchor(anchors, seen, child)
				end
				self:CollectMonsterAnchorsRecursive(child, anchors, seen, safeDepth + 1)
			end
		end
	end

	method void AddMonsterAnchor(any anchors, any seen, Entity anchor)
		-- Adds one monster anchor once by stable entity key.
		if anchor == nil then
			return
		end
		if self:IsMonsterAnchorName(anchor.Name) ~= true then
			return
		end
		local key = self:GetEntityKey(anchor)
		if key == "" or seen[key] == true then
			return
		end
		table.insert(anchors, anchor)
		seen[key] = true
	end

	method boolean IsMonsterAnchorName(string childName)
		-- Checks authored monster marker names while excluding runtime-spawned monsters.
		local value = self:ReadString(childName, "")
		if value == "" then
			return false
		end
		local lowerValue = string.lower(value)
		if self:StartsWith(lowerValue, string.lower(self:ReadString(self.RuntimeMonsterNamePrefix, "RuntimeBattleMonster"))) == true then
			return false
		end
		if self:StartsWith(lowerValue, "phase7boss") == true then
			return false
		end
		if lowerValue == string.lower(self:GetMonsterAnchorChildName()) then
			return true
		end
		local names = self:GetFallbackMonsterAnchorNames()
		for index, name in ipairs(names) do
			if lowerValue == string.lower(name) then
				return true
			end
		end
		return false
	end

	method string GetMonsterAnchorChildName()
		return self:ReadString(self.MonsterAnchorChildName, "Monster")
	end

	method any GetFallbackMonsterAnchorNames()
		-- Parses comma-delimited fallback monster anchor names.
		local result = {}
		local text = self:ReadString(self.FallbackMonsterAnchorChildNames, "")
		for name in string.gmatch(text, "([^,]+)") do
			local trimmed = self:Trim(name)
			if trimmed ~= "" then
				table.insert(result, trimmed)
			end
		end
		return result
	end

	method void HideMonsterAnchor(Entity anchor)
		-- Keeps authored Monster objects as invisible spawn markers.
		if anchor == nil or isvalid(anchor) ~= true then
			return
		end
		local partBox = anchor:GetComponent("script.BRPartBox")
		if partBox == nil then
			partBox = anchor:GetComponent("BRPartBox")
		end
		if partBox ~= nil then
			---@type BRPartBox
			local box = partBox
			box:ConfigureAsSpawnMarker()
		end
		self:SetSupplyAnchorVisibleRecursive(anchor, false, 0)
	end

	method Vector3 GetMonsterAnchorSpawnPosition(string mapName, Entity anchor)
		-- Reads an anchor world position and nudges it to the nearest foothold.
		if anchor ~= nil and anchor.TransformComponent ~= nil then
			local position = anchor.TransformComponent.WorldPosition
			return self:GetMonsterSpawnPositionNear(mapName, Vector2(position.x, position.y))
		end
		return self:GetMonsterSpawnPositionNear(mapName, Vector2(0, 0))
	end

	method Vector3 GetMonsterSpawnPositionNear(string mapName, Vector2 rawPosition)
		-- Aligns a requested monster spawn to a nearby MapleTile foothold.
		local point = rawPosition
		if point == nil then
			point = Vector2(0, 0)
		end
		local offsetY = self:GetMonsterSpawnYOffset()
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap")))
		if mapEntity ~= nil and mapEntity.FootholdComponent ~= nil then
			local searchDistance = 24
			local rayStart = Vector2(point.x, point.y + 8)
			local foothold = mapEntity.FootholdComponent:Raycast(rayStart, Vector2(0, -1), searchDistance + 8)
			if foothold == nil then
				foothold = mapEntity.FootholdComponent:GetNearestFootholdByPoint(point, searchDistance)
			end
			local landing = self:GetFootholdLandingPosition(foothold, point.x)
			if landing ~= nil then
				return Vector3(landing.x, landing.y + offsetY, 0)
			end
		end
		return Vector3(point.x, point.y + offsetY, 0)
	end

	method any GetFootholdLandingPosition(any foothold, number requestedX)
		-- Converts a foothold to a safe standing point.
		if foothold == nil then
			return nil
		end
		if foothold:IsVertical() == true then
			return nil
		end
		local x = self:ReadNumber(requestedX, 0)
		local startPoint = foothold.StartPoint
		local endPoint = foothold.EndPoint
		if startPoint ~= nil and endPoint ~= nil then
			local minX = math.min(startPoint.x, endPoint.x) + 0.03
			local maxX = math.max(startPoint.x, endPoint.x) - 0.03
			if maxX < minX then
				minX = math.min(startPoint.x, endPoint.x)
				maxX = math.max(startPoint.x, endPoint.x)
			end
			x = math.max(minX, math.min(maxX, x))
		end
		return Vector2(x, foothold:GetYByX(x))
	end

	method number GetMonsterSpawnYOffset()
		return math.max(0, self:ReadNumber(self.MonsterSpawnYOffset, 0.03))
	end

	method integer GetMonsterFallbackRoomScanCount()
		return math.max(0, math.floor(self:ReadNumber(self.MonsterFallbackRoomScanCount, 36)))
	end

	method void RememberRuntimeMonster(string mapName, Entity monster, number rowIndex, string anchorKey)
		-- Tracks runtime monsters so phase changes and cleanup can remove them deterministically.
		if monster == nil then
			return
		end
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		if self._T.runtimeMonstersByMap[targetMapName] == nil then
			self._T.runtimeMonstersByMap[targetMapName] = {}
		end
		table.insert(self._T.runtimeMonstersByMap[targetMapName], {
			Entity = monster,
			RowIndex = math.floor(self:ReadNumber(rowIndex, 0)),
			AnchorKey = self:ReadString(anchorKey, "")
		})
	end

	method number ClearRuntimeMonstersForMap(string mapName)
		-- Destroys all runtime battle monsters on a map.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local count = 0
		local seen = {}
		local records = self._T.runtimeMonstersByMap[targetMapName]
		if records ~= nil then
			for index, record in ipairs(records) do
				if record ~= nil and record.Entity ~= nil then
					local key = self:GetEntityKey(record.Entity)
					if key ~= "" then
						seen[key] = true
					end
					if self:DestroyRuntimeMonster(record.Entity) == true then
						count = count + 1
					end
				end
			end
		end
		self._T.runtimeMonstersByMap[targetMapName] = {}

		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. targetMapName)
		if mapEntity ~= nil then
			local dummyComponents = mapEntity:GetChildComponentsByTypeName("script.BRTrainingDummy", true)
			if dummyComponents == nil or #dummyComponents <= 0 then
				dummyComponents = mapEntity:GetChildComponentsByTypeName("BRTrainingDummy", true)
			end
			if dummyComponents ~= nil then
				for index, dummy in ipairs(dummyComponents) do
					if dummy ~= nil and dummy.Entity ~= nil and self:IsRuntimeBattleMonster(dummy.Entity, dummy) == true then
						local key = self:GetEntityKey(dummy.Entity)
						if key == "" or seen[key] ~= true then
							if self:DestroyRuntimeMonster(dummy.Entity) == true then
								count = count + 1
							end
						end
					end
				end
			end
		end
		if count > 0 then
			self:Log("runtime monsters cleared map=" .. targetMapName .. " count=" .. tostring(count))
		end
		return count
	end

	method boolean DestroyRuntimeMonster(Entity monster)
		if monster == nil or isvalid(monster) ~= true then
			return false
		end
		local dummy = monster:GetComponent("script.BRTrainingDummy")
		if dummy == nil then
			dummy = monster:GetComponent("BRTrainingDummy")
		end
		if dummy ~= nil then
			---@type BRTrainingDummy
			local trainingDummy = dummy
			trainingDummy:KillForEvolution()
		else
			monster:SetVisible(false)
			monster:SetEnable(false)
			monster:Destroy()
		end
		return true
	end

	method boolean IsRuntimeBattleMonster(Entity monster, any dummy)
		if monster == nil then
			return false
		end
		if dummy ~= nil and dummy.IsBattleRuntimeMonster == true then
			return true
		end
		local name = string.lower(self:ReadString(monster.Name, ""))
		return self:StartsWith(name, string.lower(self:ReadString(self.RuntimeMonsterNamePrefix, "RuntimeBattleMonster")))
			or self:StartsWith(name, "phase7boss")
	end

	method any GetMonsterDataRow(number rowIndex)
		-- Returns one cached monster.csv row as normalized runtime data.
		self:EnsureMonsterData()
		local row = math.floor(self:ReadNumber(rowIndex, 0))
		if row <= 0 or self._T.monsterRows == nil then
			return nil
		end
		return self._T.monsterRows[row]
	end

	method void EnsureMonsterData()
		-- Loads monster.csv through its UserDataSet wrapper once per session.
		self:EnsureRuntime()
		if self._T.monsterRows ~= nil then
			return
		end
		self._T.monsterRows = {}
		local data = self:GetDataTable(self:ReadString(self.MonsterDataSetName, "monster"))
		if data == nil then
			self:Log("monster data missing table=" .. self:ReadString(self.MonsterDataSetName, "monster"))
			return
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			table.insert(self._T.monsterRows, {
				Name = self:GetDataCell(data, row, "몬스터 이름", ""),
				ModelId = self:GetDataCell(data, row, "몬스터 preset 이름", ""),
				Level = self:ReadNumber(self:GetDataCell(data, row, "레벨", "1"), 1),
				EvolutionPhase = self:ReadNumber(self:GetDataCell(data, row, "진화 페이즈", "0"), 0),
				MaxHp = self:ReadNumber(self:GetDataCell(data, row, "체력", "1"), 1),
				HitDamage = self:ReadNumber(self:GetDataCell(data, row, "피격 데미지", "0"), 0),
				MesoReward = self:ReadNumber(self:GetDataCell(data, row, "드랍 메소", "0"), 0),
				ExpReward = self:ReadNumber(self:GetDataCell(data, row, "주는 경험치", "0"), 0),
				Note = self:GetDataCell(data, row, "비고", "")
			})
		end
		self:Log("monster data loaded rows=" .. tostring(#self._T.monsterRows))
	end

	method number GetStartMonsterRowIndex()
		local row = self:GetMonsterRowByName(self:ReadString(self.StartMonsterName, "갈리나"))
		if row > 0 then
			return row
		end
		if self:GetMonsterDataRow(1) ~= nil then
			return 1
		end
		return 0
	end

	method number GetFinalEvolutionRowIndex()
		return self:GetMonsterRowByName(self:ReadString(self.FinalEvolutionMonsterName, "푸른 눈의 가고일"))
	end

	method number GetLastMonsterRowIndex()
		self:EnsureMonsterData()
		if self._T.monsterRows == nil then
			return 0
		end
		return #self._T.monsterRows
	end

	method number GetMonsterRowByName(string monsterName)
		self:EnsureMonsterData()
		local targetName = self:NormalizeMonsterName(monsterName)
		if targetName == "" or self._T.monsterRows == nil then
			return 0
		end
		for row, data in ipairs(self._T.monsterRows) do
			if self:NormalizeMonsterName(data.Name) == targetName then
				return row
			end
		end
		return 0
	end

	method string GetMonsterModelId(number rowIndex)
		local data = self:GetMonsterDataRow(rowIndex)
		if data == nil then
			return self:GetFallbackMonsterModelId()
		end
		local modelId = string.lower(self:ReadString(data.ModelId, ""))
		if modelId == "" then
			return self:GetFallbackMonsterModelId()
		end
		return modelId
	end

	method string GetFallbackMonsterModelId()
		return string.lower(self:ReadString(self.FallbackMonsterModelId, "battlechainmonster"))
	end

	method string GetRuntimeMonsterName(number rowIndex, boolean boss)
		local prefix = self:ReadString(self.RuntimeMonsterNamePrefix, "RuntimeBattleMonster")
		if boss == true then
			prefix = "Phase7Boss"
		end
		return prefix .. "_" .. tostring(math.floor(self:ReadNumber(rowIndex, 0)))
			.. "_" .. tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000))
			.. "_" .. tostring(_UtilLogic:RandomIntegerRange(1000, 9999))
	end

	method string NormalizeMonsterName(string value)
		local text = string.lower(self:ReadString(value, ""))
		return string.gsub(text, "%s+", "")
	end

	method any GetDataTable(string tableName)
		-- Reads a UserDataSet by table name. Missing datasets are allowed during authoring.
		local safeName = self:ReadString(tableName, "")
		if safeName == "" or _DataService == nil then
			return nil
		end
		return _DataService:GetTable(safeName)
	end

	method string GetDataCell(any dataSet, number row, string columnName, string fallback)
		-- Reads one DataSet cell as a trimmed string.
		if dataSet == nil then
			return self:ReadString(fallback, "")
		end
		local value = dataSet:GetCell(math.max(1, math.floor(self:ReadNumber(row, 1))), self:ReadString(columnName, ""))
		if value == nil then
			return self:ReadString(fallback, "")
		end
		return self:Trim(tostring(value))
	end

	method Vector2 GetMapCenterPosition(string mapName)
		-- Uses generated-room bounds so phase-7 boss spawn never depends on graph cache calls.
		local bounds = { Count = 0, MinX = 0, MaxX = 0, MinY = 0, MaxY = 0 }
		self:AddRoomBounds(mapName, "CornerNW", bounds)
		self:AddRoomBounds(mapName, "CornerNE", bounds)
		self:AddRoomBounds(mapName, "CornerSW", bounds)
		self:AddRoomBounds(mapName, "CornerSE", bounds)
		for index = 1, self:GetMonsterFallbackRoomScanCount() do
			self:AddRoomBounds(mapName, self:GetGeneratedRoomIndexedName(index), bounds)
		end
		if bounds.Count > 0 then
			return Vector2((bounds.MinX + bounds.MaxX) * 0.5, (bounds.MinY + bounds.MaxY) * 0.5)
		end
		return Vector2(0, 0)
	end

	method void AddRoomBounds(string mapName, string roomName, any bounds)
		-- Extends a simple bounds table with one generated room position.
		if bounds == nil then
			return
		end
		local room = self:GetPhysicalRoom(mapName, nil, roomName)
		if room == nil or room.TransformComponent == nil then
			return
		end
		local position = room.TransformComponent.WorldPosition
		local count = math.floor(self:ReadNumber(bounds.Count, 0))
		if count <= 0 then
			bounds.MinX = position.x
			bounds.MaxX = position.x
			bounds.MinY = position.y
			bounds.MaxY = position.y
		else
			bounds.MinX = math.min(self:ReadNumber(bounds.MinX, position.x), position.x)
			bounds.MaxX = math.max(self:ReadNumber(bounds.MaxX, position.x), position.x)
			bounds.MinY = math.min(self:ReadNumber(bounds.MinY, position.y), position.y)
			bounds.MaxY = math.max(self:ReadNumber(bounds.MaxY, position.y), position.y)
		end
		bounds.Count = count + 1
	end

	method void PublishSupplyEvent(string mapName, string state, number count, string alertCells)
		-- Updates synced supply state and minimap alert payload.
		self.LastSupplyMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		self.LastSupplyState = self:ReadString(state, "Supply")
		self.LastSupplyDroppedCount = math.max(0, math.floor(self:ReadNumber(count, 0)))
		self.LastSupplyAlertCells = self:ReadString(alertCells, "")
		self.LastSupplyVersion = self.LastSupplyVersion + 1
	end

	method any CollectSupplyCandidates(string mapName, any graph)
		-- Collects supply child entities from assigned physical rooms first, then falls back to all generated rooms.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local root = self:GetPhysicalRoomRoot(targetMapName)
		if root == nil then
			self:Log("collect skipped: room root missing map=" .. targetMapName)
			return {}
		end

		local graphForMap = graph
		if graphForMap == nil and _BRRoomGraphGenerator ~= nil then
			graphForMap = _BRRoomGraphGenerator:GetLatestGraphForMap(targetMapName)
		end

		local rooms = self:CollectGraphPhysicalRooms(targetMapName, root, graphForMap)
		if #rooms <= 0 then
			rooms = self:CollectAllGeneratedRooms(root)
		end

		local candidates = {}
		local seenSupply = {}
		for index, room in ipairs(rooms) do
			self:CollectRoomSupplyChildren(room, candidates, seenSupply)
		end
		return candidates
	end

	method any CollectGraphPhysicalRooms(string mapName, Entity root, any graph)
		-- Resolves the physical rooms assigned by the latest logical room graph.
		local rooms = {}
		local seenRoom = {}
		if graph == nil or graph.Rooms == nil then
			return rooms
		end

		for index, graphRoom in ipairs(graph.Rooms) do
			local roomName = self:ReadString(graphRoom.AssignedRoomName, self:ReadString(graphRoom.Name, ""))
			if roomName ~= "" and seenRoom[roomName] ~= true then
				local room = self:GetPhysicalRoom(mapName, root, roomName)
				if room ~= nil then
					table.insert(rooms, room)
					seenRoom[roomName] = true
				end
			end
		end
		return rooms
	end

	method any CollectAllGeneratedRooms(Entity root)
		-- Returns every generated room child under the physical room root.
		local rooms = {}
		if root == nil then
			return rooms
		end

		local children = root.Children:ToTable()
		for index, child in ipairs(children) do
			if child ~= nil and self:IsGeneratedRoomName(child.Name) == true then
				table.insert(rooms, child)
			end
		end
		return rooms
	end

	method void CollectRoomSupplyChildren(Entity room, any candidates, any seenSupply)
		-- Adds supply anchors from one room. Anchors may be nested inside copied room prefabs.
		if room == nil then
			return
		end

		local direct = room:GetChildByName(self:GetSupplyChildName(), false)
		self:AddSupplyCandidate(candidates, seenSupply, direct)

		local names = self:GetFallbackSupplyNames()
		for index, childName in ipairs(names) do
			local child = room:GetChildByName(childName, false)
			self:AddSupplyCandidate(candidates, seenSupply, child)
		end

		if room.Children ~= nil then
			local children = room.Children:ToTable()
			for index, child in ipairs(children) do
				if child ~= nil and self:IsSupplyChildName(child.Name) == true then
					self:AddSupplyCandidate(candidates, seenSupply, child)
				end
			end
		end
		self:CollectSupplyChildrenRecursive(room, candidates, seenSupply, 0)
	end

	method void CollectSupplyChildrenRecursive(Entity entity, any candidates, any seenSupply, number depth)
		-- Finds nested skillPart markers without requiring every room prefab to keep them as direct children.
		if entity == nil then
			return
		end
		local safeDepth = math.floor(self:ReadNumber(depth, 0))
		if safeDepth > 16 then
			return
		end
		if entity.Children == nil then
			return
		end
		local children = entity.Children:ToTable()
		for index, child in ipairs(children) do
			if child ~= nil then
				if self:IsSupplyChildName(child.Name) == true then
					self:AddSupplyCandidate(candidates, seenSupply, child)
				end
				self:CollectSupplyChildrenRecursive(child, candidates, seenSupply, safeDepth + 1)
			end
		end
	end

	method void AddSupplyCandidate(any candidates, any seenSupply, Entity supply)
		-- Adds one supply entity if it has not already been recorded.
		if supply == nil then
			return
		end

		local key = self:GetEntityKey(supply)
		if key == "" or seenSupply[key] == true then
			return
		end

		table.insert(candidates, supply)
		seenSupply[key] = true
	end

	method boolean SetSupplyRuntimeActive(Entity supply, boolean active)
		-- Toggles one supply prefab and its optional BRPartBox component.
		return self:SetSupplyRuntimeActiveWithKind(supply, active, "skill")
	end

	method boolean SetSupplyRuntimeActiveWithKind(Entity supply, boolean active, string kind)
		-- Uses the placed supply entity only as a spawn anchor, then toggles a runtime box at that position.
		if supply == nil or isvalid(supply) ~= true then
			return false
		end

		self:EnsureRuntime()
		self:HideSupplyAnchor(supply)
		if active == true then
			local runtimeSupply = self:GetRuntimeSupplyForAnchor(supply)
			if runtimeSupply == nil then
				runtimeSupply = self:SpawnRuntimeSupplyForAnchor(supply, kind)
				self:SetRuntimeSupplyForAnchor(supply, runtimeSupply)
			else
				self:AlignRuntimeSupplyToAnchor(runtimeSupply, supply)
			end
			return self:ConfigureRuntimeSupplyBox(runtimeSupply, true, kind)
		else
			local runtimeSupply = self:GetRuntimeSupplyForAnchor(supply)
			self:ConfigureRuntimeSupplyBox(runtimeSupply, false, kind)
		end
		return true
	end

	method void HideSupplyAnchor(Entity supply)
		-- Keeps map-authored skillPart/SupplyBox objects as invisible spawn markers only.
		if supply == nil or isvalid(supply) ~= true then
			return
		end
		local component = supply:GetComponent("script.BRPartBox")
		if component == nil then
			component = supply:GetComponent("BRPartBox")
		end
		if component ~= nil then
			---@type BRPartBox
			local partBox = component
			partBox:ConfigureAsSpawnMarker()
		end
		self:SetSupplyAnchorVisibleRecursive(supply, false, 0)
	end

	method void SetSupplyAnchorVisibleRecursive(Entity entity, boolean visible, number depth)
		-- Fully hides copied marker objects and their render-only children while preserving their transform as an anchor.
		if entity == nil or isvalid(entity) ~= true then
			return
		end
		local safeDepth = math.floor(self:ReadNumber(depth, 0))
		if safeDepth > 16 then
			return
		end
		entity:SetVisible(visible == true)
		entity.Visible = visible == true
		self:SetEntityRendererVisible(entity, visible == true)
		if entity.Children == nil then
			return
		end
		local children = entity.Children:ToTable()
		for index, child in ipairs(children) do
			self:SetSupplyAnchorVisibleRecursive(child, visible == true, safeDepth + 1)
		end
	end

	method void SetEntityRendererVisible(Entity entity, boolean visible)
		-- Disables common renderer components so an anchor cannot remain visible as an old polygon/model.
		if entity == nil then
			return
		end
		if entity.SpriteRendererComponent ~= nil then
			entity.SpriteRendererComponent.Enable = visible == true
			if visible ~= true then
				entity.SpriteRendererComponent:SetAlpha(0)
			end
		end
		if entity.PolygonRendererComponent ~= nil then
			entity.PolygonRendererComponent.Enable = visible == true
		end
		if entity.TextRendererComponent ~= nil then
			entity.TextRendererComponent.Enable = visible == true
		end
	end

	method Entity GetRuntimeSupplyForAnchor(Entity supply)
		-- Returns the spawned runtime box associated with one map-authored anchor.
		self:EnsureRuntime()
		local key = self:GetEntityKey(supply)
		if key == "" then
			return nil
		end
		local runtimeSupply = self._T.runtimeSupplyByAnchor[key]
		if runtimeSupply ~= nil and isvalid(runtimeSupply) == true then
			return runtimeSupply
		end
		self._T.runtimeSupplyByAnchor[key] = nil
		return nil
	end

	method void SetRuntimeSupplyForAnchor(Entity supply, Entity runtimeSupply)
		-- Stores the runtime box created from a spawn anchor.
		self:EnsureRuntime()
		local key = self:GetEntityKey(supply)
		if key == "" then
			return
		end
		if runtimeSupply ~= nil and isvalid(runtimeSupply) == true then
			self._T.runtimeSupplyByAnchor[key] = runtimeSupply
		else
			self._T.runtimeSupplyByAnchor[key] = nil
		end
	end

	method Entity SpawnRuntimeSupplyForAnchor(Entity supply, string kind)
		-- Spawns a real runtime box at the anchor position while the authored entity remains a pure spawn point.
		if supply == nil or isvalid(supply) ~= true then
			return nil
		end
		local mapEntity = self:GetSupplyAnchorMapEntity(supply)
		if mapEntity == nil then
			self:Log("runtime supply skipped reason=noMap anchor=" .. self:ReadString(supply.Name, ""))
			return nil
		end
		local rawPosition = self:GetSupplyAnchorPosition(supply)
		local position = self:ResolveSupplyGroundPosition(mapEntity, rawPosition)
		local runtimeName = self:GetRuntimeSupplyName(kind)
		local modelId = self:GetRuntimeSupplyBoxModelId()
		local runtimeSupply = nil
		if modelId ~= "" then
			runtimeSupply = _SpawnService:SpawnByModelId(modelId, runtimeName, position, mapEntity)
			if runtimeSupply == nil then
				self:Log("runtime model spawn failed modelId=" .. modelId .. " anchor=" .. self:ReadString(supply.Name, "")
					.. " kind=" .. self:ReadString(kind, "skill") .. " fallback=clone")
			end
		end
		if runtimeSupply == nil then
			if modelId == "" then
				self:Log("runtime model id empty anchor=" .. self:ReadString(supply.Name, "")
					.. " kind=" .. self:ReadString(kind, "skill") .. " fallback=clone")
			end
			runtimeSupply = _SpawnService:SpawnByEntity(supply, runtimeName, position, mapEntity, false)
		end
		if runtimeSupply == nil then
			self:Log("runtime supply spawn failed anchor=" .. self:ReadString(supply.Name, "") .. " kind=" .. self:ReadString(kind, "skill"))
			return nil
		end
		self:EnsureRuntimeSupplyVisualComponents(runtimeSupply)
		runtimeSupply:SetEnable(true)
		runtimeSupply:SetVisible(true)
		self:Log("runtime supply spawned anchor=" .. self:ReadString(supply.Name, "")
			.. " box=" .. self:ReadString(runtimeSupply.Name, "")
			.. " modelId=" .. modelId
			.. " raw=(" .. tostring(rawPosition.x) .. "," .. tostring(rawPosition.y) .. ")"
			.. " grounded=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ")")
		return runtimeSupply
	end

	method void AlignRuntimeSupplyToAnchor(Entity runtimeSupply, Entity supply)
		-- Repositions an already-spawned runtime box to the grounded anchor position.
		if runtimeSupply == nil or isvalid(runtimeSupply) ~= true or supply == nil or isvalid(supply) ~= true then
			return
		end
		local mapEntity = self:GetSupplyAnchorMapEntity(supply)
		if mapEntity == nil then
			return
		end
		local rawPosition = self:GetSupplyAnchorPosition(supply)
		local position = self:ResolveSupplyGroundPosition(mapEntity, rawPosition)
		self:MoveRuntimeSupplyToPosition(runtimeSupply, position)
		self:Log("runtime supply realigned anchor=" .. self:ReadString(supply.Name, "")
			.. " box=" .. self:ReadString(runtimeSupply.Name, "")
			.. " raw=(" .. tostring(rawPosition.x) .. "," .. tostring(rawPosition.y) .. ")"
			.. " grounded=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ")")
	end

	method void MoveRuntimeSupplyToPosition(Entity runtimeSupply, Vector3 position)
		-- Applies a world-space position to a runtime supply, using body APIs when present.
		if runtimeSupply == nil or isvalid(runtimeSupply) ~= true or position == nil then
			return
		end
		local position2 = Vector2(self:ReadNumber(position.x, 0), self:ReadNumber(position.y, 0))
		if runtimeSupply.RigidbodyComponent ~= nil then
			runtimeSupply.RigidbodyComponent:SetWorldPosition(position2)
		elseif runtimeSupply.MovementComponent ~= nil then
			runtimeSupply.MovementComponent:SetWorldPosition(position2)
		elseif runtimeSupply.TransformComponent ~= nil then
			runtimeSupply.TransformComponent.WorldPosition = position
		end
	end

	method Vector3 ResolveSupplyGroundPosition(Entity mapEntity, Vector3 rawPosition)
		-- Snaps a supply anchor position down to the nearest MapleTile foothold.
		if rawPosition == nil then
			return Vector3(0, 0, 0)
		end
		local x = self:ReadNumber(rawPosition.x, 0)
		local y = self:ReadNumber(rawPosition.y, 0)
		local z = self:ReadNumber(rawPosition.z, 0)
		if mapEntity == nil or mapEntity.FootholdComponent == nil then
			return Vector3(x, y, z)
		end

		local searchUp = self:GetSupplyGroundSearchUp()
		local searchDown = self:GetSupplyGroundSearchDown()
		local rayStart = Vector2(x, y + 0.05)
		local foothold = mapEntity.FootholdComponent:Raycast(rayStart, Vector2(0, -1), searchDown + 0.05)
		if foothold == nil then
			rayStart = Vector2(x, y + searchUp)
			foothold = mapEntity.FootholdComponent:Raycast(rayStart, Vector2(0, -1), searchUp + searchDown)
		end
		if foothold == nil then
			foothold = mapEntity.FootholdComponent:GetNearestFootholdByPoint(Vector2(x, y), searchUp + searchDown)
		end
		local landing = self:GetFootholdLandingPosition(foothold, x)
		if landing == nil then
			return Vector3(x, y, z)
		end
		return Vector3(landing.x, landing.y + self:GetSupplyGroundYOffset(), z)
	end

	method boolean ConfigureRuntimeSupplyBox(Entity runtimeSupply, boolean active, string kind)
		-- Applies box behavior and the previously supplied Maple resource RUIDs to a runtime supply entity.
		if runtimeSupply == nil or isvalid(runtimeSupply) ~= true then
			return false
		end
		self:EnsureRuntimeSupplyVisualComponents(runtimeSupply)
		local component = runtimeSupply:GetComponent("script.BRPartBox")
		if component == nil then
			component = runtimeSupply:GetComponent("BRPartBox")
		end
		if component == nil and active == true then
			component = runtimeSupply:AddComponent("script.BRPartBox")
		end
		if active == true then
			runtimeSupply:SetEnable(true)
			runtimeSupply:SetVisible(true)
			if component ~= nil then
				---@type BRPartBox
				local partBox = component
				local safeKind = self:ReadString(kind, "skill")
				partBox:ConfigureSupplyKind(safeKind)
				if string.lower(safeKind) == "supply" then
					partBox.DropCount = self:GetSupplyChestDropCount()
				elseif string.lower(safeKind) == "skill" then
					partBox.DropCount = self:GetSkillChestDropCount()
				end
				partBox:SetRuntimeActive(true)
				self:ForceRuntimeSupplyVisual(runtimeSupply, partBox)
			end
		else
			if component ~= nil then
				---@type BRPartBox
				local partBox = component
				partBox:SetRuntimeActive(false)
			end
			runtimeSupply:SetVisible(false)
			runtimeSupply:SetEnable(false)
		end
		return true
	end

	method void ForceRuntimeSupplyVisual(Entity runtimeSupply, any partBox)
		-- Immediately paints the spawned runtime model with the intended box sprite/animation.
		if runtimeSupply == nil or isvalid(runtimeSupply) ~= true or partBox == nil then
			return
		end
		---@type BRPartBox
		local boxComponent = partBox
		if runtimeSupply.SpriteRendererComponent == nil then
			runtimeSupply:AddComponent("SpriteRendererComponent")
		end
		if runtimeSupply.PolygonRendererComponent ~= nil then
			runtimeSupply.PolygonRendererComponent.Enable = false
		end
		if runtimeSupply.SpriteRendererComponent ~= nil then
			local standRuid = boxComponent:GetStandRUID()
			if standRuid ~= "" then
				runtimeSupply.SpriteRendererComponent.SpriteRUID = standRuid
			end
			runtimeSupply.SpriteRendererComponent.Enable = true
			runtimeSupply.SpriteRendererComponent.SortingLayer = "MapLayer0"
			runtimeSupply.SpriteRendererComponent.OrderInLayer = 35
			runtimeSupply.SpriteRendererComponent.IgnoreMapLayerCheck = true
			runtimeSupply.SpriteRendererComponent:SetAlpha(1)
		end
		if runtimeSupply.TransformComponent ~= nil then
			local visualScale = boxComponent:GetVisualScale()
			runtimeSupply.TransformComponent.Scale = Vector3(visualScale, visualScale, 1)
		end
		runtimeSupply:SetVisible(true)
		runtimeSupply:SetEnable(true)
	end

	method void EnsureRuntimeSupplyVisualComponents(Entity runtimeSupply)
		-- Ensures old polygon-only anchors produce real sprite boxes after runtime spawn.
		if runtimeSupply == nil or isvalid(runtimeSupply) ~= true then
			return
		end
		if runtimeSupply.SpriteRendererComponent == nil then
			runtimeSupply:AddComponent("SpriteRendererComponent")
		end
		if runtimeSupply.PolygonRendererComponent ~= nil then
			runtimeSupply.PolygonRendererComponent.Enable = false
		end
	end

	method boolean IsRuntimeSupplyActive(Entity runtimeSupply)
		-- Checks whether a spawned box currently occupies its anchor.
		if runtimeSupply == nil or isvalid(runtimeSupply) ~= true then
			return false
		end
		if runtimeSupply.Enable ~= true then
			return false
		end
		local component = runtimeSupply:GetComponent("script.BRPartBox")
		if component == nil then
			component = runtimeSupply:GetComponent("BRPartBox")
		end
		if component == nil then
			return runtimeSupply.Visible == true
		end
		---@type BRPartBox
		local partBox = component
		return partBox.EnablePartBox == true and partBox.available == true
	end

	method Entity GetSupplyAnchorMapEntity(Entity supply)
		-- Resolves the map parent used by SpawnService for a supply anchor.
		if supply == nil then
			return nil
		end
		if supply.CurrentMap ~= nil then
			return supply.CurrentMap
		end
		local mapName = self:ReadString(supply.CurrentMapName, "")
		if mapName ~= "" then
			return _EntityService:GetEntityByPath("/maps/" .. mapName)
		end
		return nil
	end

	method Vector3 GetSupplyAnchorPosition(Entity supply)
		-- Reads the anchor world position used for runtime box placement.
		if supply ~= nil and supply.TransformComponent ~= nil then
			local position = supply.TransformComponent.WorldPosition
			return Vector3(position.x, position.y, position.z)
		end
		return Vector3(0, 0, 0)
	end

	method string GetRuntimeSupplyName(string kind)
		-- Builds a unique runtime box name that never collides with authored anchor names.
		local prefix = self:ReadString(self.RuntimeSupplyNamePrefix, "RuntimeSupplyBox")
		local safeKind = self:ReadString(kind, "skill")
		local tick = tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000))
		local randomPart = tostring(_UtilLogic:RandomIntegerRange(1000, 9999))
		return prefix .. "_" .. safeKind .. "_" .. tick .. "_" .. randomPart
	end

	method string GetRuntimeSupplyBoxModelId()
		-- Returns the model id used for real boxes spawned from map-authored anchors.
		local modelId = string.lower(self:ReadString(self.RuntimeSupplyBoxModelId, "skillpartbox"))
		if modelId == "" then
			return "skillpartbox"
		end
		return modelId
	end

	method Entity GetPhysicalRoomRoot(string mapName)
		-- Resolves the generated-room container for a fixed physical map.
		local safeMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local root = _EntityService:GetEntityByPath("/maps/" .. safeMapName .. "/EditorGeneratedGrid")
		if root ~= nil then
			return root
		end
		return _EntityService:GetEntityByPath("/maps/" .. safeMapName)
	end

	method Entity GetPhysicalRoom(string mapName, Entity root, string roomName)
		-- Resolves one physical room by generated-grid path or direct map path.
		local safeRoomName = self:ReadString(roomName, "")
		if safeRoomName == "" then
			return nil
		end

		if root ~= nil then
			local room = root:GetChildByName(safeRoomName, false)
			if room ~= nil then
				return room
			end
		end

		local safeMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local generatedPath = "/maps/" .. safeMapName .. "/EditorGeneratedGrid/" .. safeRoomName
		local generatedRoom = _EntityService:GetEntityByPath(generatedPath)
		if generatedRoom ~= nil then
			return generatedRoom
		end

		return _EntityService:GetEntityByPath("/maps/" .. safeMapName .. "/" .. safeRoomName)
	end

	method string GetGeneratedRoomIndexedName(number index)
		-- Builds generated room names such as Room_001.
		local safeIndex = math.max(1, math.floor(self:ReadNumber(index, 1)))
		if safeIndex < 10 then
			return "Room_00" .. tostring(safeIndex)
		end
		if safeIndex < 100 then
			return "Room_0" .. tostring(safeIndex)
		end
		return "Room_" .. tostring(safeIndex)
	end

	method boolean IsGeneratedRoomName(string roomName)
		-- Checks whether a name follows the generated room naming pattern.
		local value = self:ReadString(roomName, "")
		if value == "CornerNW" or value == "CornerNE" or value == "CornerSW" or value == "CornerSE" then
			return true
		end

		local prefix = "Room_"
		if string.sub(value, 1, string.len(prefix)) ~= prefix then
			return false
		end
		return tonumber(string.sub(value, string.len(prefix) + 1)) ~= nil
	end

	method boolean IsSupplyChildName(string childName)
		-- Checks whether a room child should be treated as a supply anchor.
		local value = self:ReadString(childName, "")
		if value == "" then
			return false
		end
		local lowerValue = string.lower(value)
		if lowerValue == string.lower(self:GetSupplyChildName()) then
			return true
		end

		local fallbackNames = self:GetFallbackSupplyNames()
		for index, fallbackName in ipairs(fallbackNames) do
			if lowerValue == string.lower(fallbackName) then
				return true
			end
		end

		return string.sub(lowerValue, 1, 6) == "supply"
			or string.find(lowerValue, "skillpart", 1, true) ~= nil
			or string.find(lowerValue, "partbox", 1, true) ~= nil
	end

	method any GetFallbackSupplyNames()
		-- Parses comma-delimited fallback supply child names.
		local result = {}
		local text = self:ReadString(self.FallbackSupplyChildNames, "")
		for name in string.gmatch(text, "([^,]+)") do
			local trimmed = self:Trim(name)
			if trimmed ~= "" then
				table.insert(result, trimmed)
			end
		end
		return result
	end

	method string GetSupplyChildName()
		-- Returns the primary supply child name.
		return self:ReadString(self.SupplyChildName, "SupplyBox")
	end

	method number GetMaxSuppliesPerDrop()
		-- Returns zero for all supplies or a positive cap for each drop.
		return math.max(0, math.floor(self:ReadNumber(self.MaxSuppliesPerDrop, 0)))
	end

	method number GetSkillChestDropCount()
		-- Returns the number of skill parts dropped by wooden skill chests.
		return math.max(1, math.floor(self:ReadNumber(self.SkillChestDropCount, 3)))
	end

	method number GetSupplyChestDropCount()
		-- Returns the number of skill parts dropped by slime treasure chests.
		return math.max(1, math.floor(self:ReadNumber(self.SupplyChestDropCount, 3)))
	end

	method number GetKioskSpawnDelaySeconds()
		-- Returns the phase-3 kiosk spawn delay.
		return math.max(0, self:ReadNumber(self.KioskSpawnDelaySeconds, 15))
	end

	method number GetKioskSpawnCount()
		-- Returns the number of phase-3 kiosks to spawn.
		return math.max(0, math.floor(self:ReadNumber(self.KioskSpawnCount, 2)))
	end

	method number GetSupplyDropCount()
		-- Returns the number of phase-5 supply drops.
		return math.max(0, math.floor(self:ReadNumber(self.SupplyDropCount, 1)))
	end

	method number GetSupplyGroundYOffset()
		-- Returns the vertical foothold offset used for spawned supply boxes.
		return math.max(0, self:ReadNumber(self.SupplyGroundYOffset, 0.03))
	end

	method number GetSupplyGroundSearchUp()
		-- Returns how far above an anchor the supply-ground ray begins.
		return math.max(0, self:ReadNumber(self.SupplyGroundSearchUp, 3))
	end

	method number GetSupplyGroundSearchDown()
		-- Returns how far below an anchor supply boxes search for a foothold.
		return math.max(0.1, self:ReadNumber(self.SupplyGroundSearchDown, 24))
	end

	method number GetMonsterLevelUpHpMultiplier()
		-- Returns phase-6 monster HP multiplier.
		return math.max(1, self:ReadNumber(self.MonsterLevelUpHpMultiplier, 1.5))
	end

	method number GetMonsterLevelUpAttackMultiplier()
		-- Returns phase-6 battle-bot attack multiplier.
		return math.max(1, self:ReadNumber(self.MonsterLevelUpAttackMultiplier, 1.25))
	end

	method number GetMonsterLevelUpRewardMultiplier()
		-- Returns phase-6 reward multiplier for training monsters.
		return math.max(1, self:ReadNumber(self.MonsterLevelUpRewardMultiplier, 1.25))
	end

	method string ResolveMapName(any matchRoom, string mapName)
		-- Resolves the target map from explicit input or match room fields.
		local value = self:ReadString(mapName, "")
		if value ~= "" then
			return value
		end
		if matchRoom ~= nil then
			value = self:ReadString(matchRoom.TargetMapName, self:ReadString(matchRoom.SourceMapName, ""))
		end
		return self:ReadString(value, self:ReadString(self.DefaultMapName, "RoomTestMap"))
	end

	method string GetEntityKey(Entity entity)
		-- Returns a stable key for an entity reference.
		if entity == nil then
			return ""
		end
		if entity.Id ~= nil and entity.Id ~= "" then
			return entity.Id
		end
		return self:ReadString(entity.Path, "")
	end

	method string Trim(string text)
		-- Removes leading and trailing whitespace from a small config token.
		local value = self:ReadString(text, "")
		while string.len(value) > 0 and self:IsWhitespace(string.sub(value, 1, 1)) == true do
			value = string.sub(value, 2)
		end
		while string.len(value) > 0 and self:IsWhitespace(string.sub(value, string.len(value), string.len(value))) == true do
			value = string.sub(value, 1, string.len(value) - 1)
		end
		return value
	end

	method boolean IsWhitespace(string value)
		-- Checks a single-character whitespace token.
		return value == " " or value == "\t" or value == "\n" or value == "\r"
	end

	method void EnsureRuntime()
		-- Initializes non-synced runtime tables.
		if self._T == nil then
			self._T = {}
		end
		if self._T.candidatesByMap == nil then
			self._T.candidatesByMap = {}
		end
		if self._T.phaseEvents == nil then
			self._T.phaseEvents = {}
		end
		if self._T.runtimeSupplyByAnchor == nil then
			self._T.runtimeSupplyByAnchor = {}
		end
		if self._T.monsterAnchorsByMap == nil then
			self._T.monsterAnchorsByMap = {}
		end
		if self._T.runtimeMonstersByMap == nil then
			self._T.runtimeMonstersByMap = {}
		end
		if self._T.currentMonsterRowByMap == nil then
			self._T.currentMonsterRowByMap = {}
		end
	end

	method boolean StartsWith(string value, string prefix)
		-- Checks a string prefix while safely handling empty values.
		local safeValue = self:ReadString(value, "")
		local safePrefix = self:ReadString(prefix, "")
		if safeValue == "" or safePrefix == "" then
			return false
		end
		return string.sub(safeValue, 1, string.len(safePrefix)) == safePrefix
	end

	method string ReadString(any value, string fallback)
		-- Reads a string-like value with fallback.
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		-- Reads a numeric value with fallback.
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		-- Writes a supply-system log when verbose logging is enabled.
		if self.VerboseLog == true then
			log("[BRSupplySystem] " .. self:ReadString(message, ""))
		end
	end

end
