@Logic
script BRSupplySystem extends Logic

	property string DefaultMapName = "RoomTestMap"

	property string SupplyChildName = "SupplyBox"

	property string FallbackSupplyChildNames = "SupplyBox,SupplyPoint,SkillPartBox,PartBox"

	property number MaxSuppliesPerDrop = 0

	property number SkillChestDropCount = 3

	property number SupplyChestDropCount = 3

	property number KioskSpawnDelaySeconds = 15

	property number KioskSpawnCount = 2

	property number SupplyDropCount = 1

	property string BossMonsterModelId = "battlechainmonster"

	property number BossSpawnYOffset = 0

	property number MonsterLevelUpHpMultiplier = 1.5

	property number MonsterLevelUpAttackMultiplier = 1.25

	property number MonsterLevelUpRewardMultiplier = 1.25

	property boolean VerboseLog = true

	@Sync
	property string LastSupplyMapName = ""

	@Sync
	property string LastSupplyState = "Idle"

	@Sync
	property number LastSupplyCandidateCount = 0

	@Sync
	property number LastSupplyDroppedCount = 0

	@Sync
	property number LastSupplyVersion = 0

	@Sync
	property string LastSupplyAlertCells = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes runtime storage for supply anchors.
		self:EnsureRuntime()
		self:Log("ready child=" .. self:GetSupplyChildName() .. " maxDrop=" .. tostring(self:GetMaxSuppliesPerDrop()))
	end

	@ExecSpace("ServerOnly")
	method void PrepareSuppliesForMatch(any matchRoom, any graph, string mapName)
		-- Collects and hides supply anchors before players enter the generated battle.
		local targetMapName = self:ResolveMapName(matchRoom, mapName)
		self:PrepareSupplies(targetMapName, graph)
	end

	@ExecSpace("ServerOnly")
	method number PrepareSupplies(string mapName, any graph)
		-- Finds supply child prefabs for a map and stores them until the timer finishes.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self:CollectSupplyCandidates(targetMapName, graph)
		self._T.candidatesByMap[targetMapName] = candidates

		for index, supply in ipairs(candidates) do
			self:SetSupplyRuntimeActive(supply, false)
		end

		local initialDropped = self:SpawnOneSkillChestPerRoom(targetMapName, candidates)

		self.LastSupplyMapName = targetMapName
		self.LastSupplyState = "Prepared"
		self.LastSupplyCandidateCount = #candidates
		self.LastSupplyDroppedCount = initialDropped
		self.LastSupplyVersion = self.LastSupplyVersion + 1
		self:Log("prepared map=" .. targetMapName .. " candidates=" .. tostring(#candidates) .. " initialChests=" .. tostring(initialDropped))
		return #candidates
	end

	@ExecSpace("ServerOnly")
	method number DropSuppliesForMap(string mapName)
		-- Activates prepared supply boxes for the requested map.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self._T.candidatesByMap[targetMapName]
		if candidates == nil or #candidates <= 0 then
			candidates = self:CollectSupplyCandidates(targetMapName, nil)
			self._T.candidatesByMap[targetMapName] = candidates
		end

		if candidates == nil or #candidates <= 0 then
			self.LastSupplyMapName = targetMapName
			self.LastSupplyState = "Skipped"
			self.LastSupplyCandidateCount = 0
			self.LastSupplyDroppedCount = 0
			self.LastSupplyVersion = self.LastSupplyVersion + 1
			self:Log("drop skipped: no supply anchors map=" .. targetMapName)
			return 0
		end

		local limit = self:GetMaxSuppliesPerDrop()
		if limit <= 0 then
			limit = self:GetSupplyDropCount()
		end
		local dropped = self:SpawnSupplyDropForMap(targetMapName, limit)

		self.LastSupplyMapName = targetMapName
		self.LastSupplyState = "Dropped"
		self.LastSupplyCandidateCount = #candidates
		self.LastSupplyDroppedCount = dropped
		self.LastSupplyVersion = self.LastSupplyVersion + 1
		self:Log("dropped map=" .. targetMapName .. " active=" .. tostring(dropped) .. "/" .. tostring(#candidates))
		return dropped
	end

	@ExecSpace("ServerOnly")
	method void ClearSuppliesForMap(string mapName)
		-- Hides every remembered supply box on the requested map.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.LastSupplyMapName, self:ReadString(self.DefaultMapName, "RoomTestMap")))
		local candidates = self._T.candidatesByMap[targetMapName]
		local cleared = 0
		if candidates ~= nil then
			for index, supply in ipairs(candidates) do
				if self:SetSupplyRuntimeActive(supply, false) == true then
					cleared = cleared + 1
				end
			end
		end

		self.LastSupplyMapName = targetMapName
		self.LastSupplyState = "Cleared"
		self.LastSupplyDroppedCount = 0
		self.LastSupplyVersion = self.LastSupplyVersion + 1
		self:Log("cleared map=" .. targetMapName .. " count=" .. tostring(cleared))
	end

	@ExecSpace("ServerOnly")
	method void OnBattlePhaseChanged(string mapName, number phaseNumber)
		-- Runs phase-specific supply events once per map and phase.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.LastSupplyMapName, self:ReadString(self.DefaultMapName, "RoomTestMap")))
		local phase = math.floor(self:ReadNumber(phaseNumber, 0))
		local key = targetMapName .. ":" .. tostring(phase)
		if self._T.phaseEvents[key] == true then
			return
		end
		self._T.phaseEvents[key] = true

		if phase == 3 then
			local delay = self:GetKioskSpawnDelaySeconds()
			_TimerService:SetTimerOnce(function() self:SpawnPhaseKiosks(targetMapName) end, delay)
			self.LastSupplyState = "KioskPending"
			self:Log("phase 3 kiosk scheduled map=" .. targetMapName .. " delay=" .. tostring(delay))
		elseif phase == 4 then
			local count = self:RefillOpenRoomChests(targetMapName)
			self:PublishSupplyEvent(targetMapName, "Refill", count, "")
		elseif phase == 5 then
			local count = self:SpawnSupplyDropForMap(targetMapName, self:GetSupplyDropCount())
			self:PublishSupplyEvent(targetMapName, "SupplyDrop", count, self.LastSupplyAlertCells)
		elseif phase == 6 then
			local count = self:LevelUpMonstersForMap(targetMapName)
			self:PublishSupplyEvent(targetMapName, "MonsterLevelUp", count, "")
		elseif phase == 7 then
			local count = self:SpawnBossForMap(targetMapName)
			self:PublishSupplyEvent(targetMapName, "Boss", count, "")
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnPhaseKiosks(string mapName)
		-- Spawns kiosk boxes in up to two empty anchors among the center nine open rooms.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.LastSupplyMapName, self:ReadString(self.DefaultMapName, "RoomTestMap")))
		local count = self:SpawnKiosksForMap(targetMapName, self:GetKioskSpawnCount())
		self:PublishSupplyEvent(targetMapName, "Kiosk", count, self.LastSupplyAlertCells)
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Prepare Supplies")
	method void DebugPrepareSupplies()
		-- Prepares supply anchors on the default test map.
		self:PrepareSupplies(self:ReadString(self.DefaultMapName, "RoomTestMap"), nil)
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Drop Supplies")
	method void DebugDropSupplies()
		-- Drops supply boxes on the default test map.
		self:DropSuppliesForMap(self:ReadString(self.DefaultMapName, "RoomTestMap"))
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Clear Supplies")
	method void DebugClearSupplies()
		-- Clears supply boxes on the default test map.
		self:ClearSuppliesForMap(self:ReadString(self.DefaultMapName, "RoomTestMap"))
	end

	method number SpawnOneSkillChestPerRoom(string mapName, any candidates)
		-- Activates at most one random skill chest anchor in each generated room.
		local groups = self:GroupCandidatesByRoom(candidates)
		local spawned = 0
		for index, group in ipairs(groups) do
			local supply = self:PickEmptySupplyFromGroup(group)
			if supply ~= nil and self:SetSupplyRuntimeActiveWithKind(supply, true, "skill") == true then
				spawned = spawned + 1
			end
		end
		return spawned
	end

	method number RefillOpenRoomChests(string mapName)
		-- Refills one skill chest in every currently open safe room that has an empty anchor.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self:GetCandidatesForMap(targetMapName)
		local groups = self:GroupCandidatesByRoom(candidates)
		local spawned = 0
		for index, group in ipairs(groups) do
			if self:IsRoomOpenForSupplies(targetMapName, self:ReadString(group.RoomName, "")) == true and self:GroupHasActiveSupply(group) ~= true then
				local supply = self:PickEmptySupplyFromGroup(group)
				if supply ~= nil and self:SetSupplyRuntimeActiveWithKind(supply, true, "skill") == true then
					spawned = spawned + 1
				end
			end
		end
		self:Log("refill map=" .. targetMapName .. " count=" .. tostring(spawned))
		return spawned
	end

	method number SpawnSupplyDropForMap(string mapName, number count)
		-- Spawns slime treasure boxes in empty safe-room anchors.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self:GetEmptyOpenCandidates(targetMapName, false)
		local spawned = self:ActivateRandomCandidates(targetMapName, candidates, math.max(1, math.floor(self:ReadNumber(count, 1))), "supply", "S")
		self:Log("supply drop map=" .. targetMapName .. " count=" .. tostring(spawned))
		return spawned
	end

	method number SpawnKiosksForMap(string mapName, number count)
		-- Spawns candy-machine kiosks in empty center-nine safe-room anchors.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self:GetEmptyOpenCandidates(targetMapName, true)
		local spawned = self:ActivateRandomCandidates(targetMapName, candidates, math.max(1, math.floor(self:ReadNumber(count, 1))), "kiosk", "K")
		self:Log("kiosk spawn map=" .. targetMapName .. " count=" .. tostring(spawned))
		return spawned
	end

	method number SpawnBossForMap(string mapName)
		-- Spawns the configured boss monster at the current map center when possible.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. targetMapName)
		if mapEntity == nil then
			self:Log("boss skipped reason=noMap map=" .. targetMapName)
			return 0
		end
		local modelId = self:ReadString(self.BossMonsterModelId, "")
		if modelId == "" then
			self:Log("boss skipped reason=noModelId map=" .. targetMapName)
			return 0
		end
		local center = self:GetMapCenterPosition(targetMapName)
		local spawnPosition = Vector3(center.x, center.y + self:ReadNumber(self.BossSpawnYOffset, 0), 0)
		local boss = _SpawnService:SpawnByModelId(modelId, "Phase7Boss_" .. tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000)), spawnPosition, mapEntity)
		if boss == nil then
			self:Log("boss spawn failed modelId=" .. modelId .. " map=" .. targetMapName)
			return 0
		end
		self:Log("boss spawned modelId=" .. modelId .. " map=" .. targetMapName)
		return 1
	end

	method number LevelUpMonstersForMap(string mapName)
		-- Strengthens existing training monsters and battle bots for phase 6.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. targetMapName)
		if mapEntity == nil then
			self:Log("monster level-up skipped reason=noMap map=" .. targetMapName)
			return 0
		end

		local hpMultiplier = self:GetMonsterLevelUpHpMultiplier()
		local attackMultiplier = self:GetMonsterLevelUpAttackMultiplier()
		local rewardMultiplier = self:GetMonsterLevelUpRewardMultiplier()
		local count = 0

		local dummyComponents = mapEntity:GetChildComponentsByTypeName("script.BRTrainingDummy", true)
		if dummyComponents == nil or #dummyComponents <= 0 then
			dummyComponents = mapEntity:GetChildComponentsByTypeName("BRTrainingDummy", true)
		end
		if dummyComponents ~= nil then
			for index, component in ipairs(dummyComponents) do
				if component ~= nil then
					---@type BRTrainingDummy
					local dummy = component
					local oldHp = dummy:GetMaxHp()
					dummy.MaxHp = math.max(oldHp + 1, math.floor(oldHp * hpMultiplier))
					dummy.SkillExperienceReward = math.max(dummy:GetSkillExperienceReward(), math.floor(dummy:GetSkillExperienceReward() * rewardMultiplier))
					dummy.MesoReward = math.max(dummy:GetMesoReward(), math.floor(dummy:GetMesoReward() * rewardMultiplier))
					if dummy.CurrentHp > 0 then
						dummy.CurrentHp = dummy:GetMaxHp()
						dummy:UpdateNameTag()
					end
					count = count + 1
				end
			end
		end

		local botComponents = mapEntity:GetChildComponentsByTypeName("script.BRBattleBotController", true)
		if botComponents == nil or #botComponents <= 0 then
			botComponents = mapEntity:GetChildComponentsByTypeName("BRBattleBotController", true)
		end
		if botComponents ~= nil then
			for index, component in ipairs(botComponents) do
				if component ~= nil then
					---@type BRBattleBotController
					local bot = component
					local oldHp = bot:GetMaxHp()
					local oldAttack = bot:GetAttackDamage()
					bot.MaxHp = math.max(oldHp + 1, math.floor(oldHp * hpMultiplier))
					bot.AttackDamage = math.max(oldAttack + 1, math.floor(oldAttack * attackMultiplier))
					bot.MesoReward = math.max(bot:GetMesoReward(), math.floor(bot:GetMesoReward() * rewardMultiplier))
					if bot.BotState == "ALIVE" and bot.CurrentHp > 0 then
						bot.CurrentHp = bot:GetMaxHp()
						bot:UpdateNameTag()
					end
					count = count + 1
				end
			end
		end

		self:Log("phase 6 monster level-up map=" .. targetMapName .. " count=" .. tostring(count)
			.. " hpMul=" .. tostring(hpMultiplier) .. " attackMul=" .. tostring(attackMultiplier))
		return count
	end

	method number ActivateRandomCandidates(string mapName, any candidates, number count, string kind, string alertKind)
		-- Picks random empty candidates, activates them, and publishes minimap alert cells.
		local spawned = 0
		local alertRecords = {}
		local pool = self:CopyCandidateList(candidates)
		local limit = math.max(0, math.floor(self:ReadNumber(count, 0)))
		while spawned < limit and #pool > 0 do
			local index = _UtilLogic:RandomIntegerRange(1, #pool)
			local supply = pool[index]
			table.remove(pool, index)
			if supply ~= nil and self:SetSupplyRuntimeActiveWithKind(supply, true, kind) == true then
				spawned = spawned + 1
				local record = self:GetSupplyAlertRecord(mapName, supply, alertKind)
				if record ~= "" then
					table.insert(alertRecords, record)
				end
			end
		end
		self.LastSupplyAlertCells = self:JoinRecords(alertRecords)
		return spawned
	end

	method any GetEmptyOpenCandidates(string mapName, boolean centerOnly)
		-- Returns empty supply anchors in safe rooms, optionally restricted to the center nine cells.
		local result = {}
		local candidates = self:GetCandidatesForMap(mapName)
		for index, supply in ipairs(candidates) do
			local roomName = self:GetRoomNameForSupply(supply)
			if self:IsSupplyEmpty(supply) == true and self:IsRoomOpenForSupplies(mapName, roomName) == true then
				if centerOnly ~= true or self:IsRoomInCenterNine(mapName, roomName) == true then
					table.insert(result, supply)
				end
			end
		end
		return result
	end

	method any GetCandidatesForMap(string mapName)
		-- Returns cached candidates or recollects anchors for the target map.
		self:EnsureRuntime()
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local candidates = self._T.candidatesByMap[targetMapName]
		if candidates == nil or #candidates <= 0 then
			candidates = self:CollectSupplyCandidates(targetMapName, nil)
			self._T.candidatesByMap[targetMapName] = candidates
		end
		return candidates
	end

	method any GroupCandidatesByRoom(any candidates)
		-- Groups supply anchors by the generated room that owns them.
		local groups = {}
		local byRoom = {}
		if candidates == nil then
			return groups
		end
		for index, supply in ipairs(candidates) do
			local roomName = self:GetRoomNameForSupply(supply)
			if roomName == "" then
				roomName = self:GetEntityKey(supply)
			end
			if roomName ~= "" then
				local group = byRoom[roomName]
				if group == nil then
					group = { RoomName = roomName, Supplies = {} }
					byRoom[roomName] = group
					table.insert(groups, group)
				end
				table.insert(group.Supplies, supply)
			end
		end
		return groups
	end

	method Entity PickEmptySupplyFromGroup(any group)
		-- Chooses one empty supply anchor from a room group.
		if group == nil or group.Supplies == nil then
			return nil
		end
		local candidates = {}
		for index, supply in ipairs(group.Supplies) do
			if self:IsSupplyEmpty(supply) == true then
				table.insert(candidates, supply)
			end
		end
		if #candidates <= 0 then
			return nil
		end
		return candidates[_UtilLogic:RandomIntegerRange(1, #candidates)]
	end

	method boolean GroupHasActiveSupply(any group)
		-- Checks whether a room already has an active chest or kiosk.
		if group == nil or group.Supplies == nil then
			return false
		end
		for index, supply in ipairs(group.Supplies) do
			if supply ~= nil and isvalid(supply) == true and supply.Enable == true then
				local component = supply:GetComponent("script.BRPartBox")
				if component == nil then
					component = supply:GetComponent("BRPartBox")
				end
				if component == nil then
					return true
				end
				---@type BRPartBox
				local partBox = component
				if partBox.available == true then
					return true
				end
			end
		end
		return false
	end

	method boolean IsSupplyEmpty(Entity supply)
		-- Checks whether a supply anchor is currently free to receive a chest.
		if supply == nil or isvalid(supply) ~= true then
			return false
		end
		if supply.Enable == true then
			local component = supply:GetComponent("script.BRPartBox")
			if component == nil then
				component = supply:GetComponent("BRPartBox")
			end
			if component == nil then
				return false
			end
			---@type BRPartBox
			local partBox = component
			return partBox.available ~= true
		end
		return true
	end

	method boolean IsRoomOpenForSupplies(string mapName, string roomName)
		-- Checks whether the room is currently inside the magnetic safe region.
		local cell = self:GetLogicalCellForRoom(mapName, roomName)
		if cell == nil then
			return true
		end
		if _BRMagneticZoneSystem == nil or _BRMagneticZoneSystem.ZoneRunning ~= true then
			return true
		end
		local row = math.floor(self:ReadNumber(cell.Row, 0))
		local column = math.floor(self:ReadNumber(cell.Column, 0))
		if row <= 0 or column <= 0 then
			return true
		end
		return row >= self:ReadNumber(_BRMagneticZoneSystem.SafeMinRow, 1)
			and row <= self:ReadNumber(_BRMagneticZoneSystem.SafeMaxRow, 999)
			and column >= self:ReadNumber(_BRMagneticZoneSystem.SafeMinColumn, 1)
			and column <= self:ReadNumber(_BRMagneticZoneSystem.SafeMaxColumn, 999)
	end

	method boolean IsRoomInCenterNine(string mapName, string roomName)
		-- Checks whether the room belongs to the 3x3 center kiosk band.
		local cell = self:GetLogicalCellForRoom(mapName, roomName)
		if cell == nil then
			return false
		end
		local graph = self:GetGraphForMap(mapName)
		if graph == nil then
			return false
		end
		local centerRow = math.floor((self:ReadNumber(graph.Rows, 1) + 1) * 0.5)
		local centerColumn = math.floor((self:ReadNumber(graph.Columns, 1) + 1) * 0.5)
		local row = math.floor(self:ReadNumber(cell.Row, 0))
		local column = math.floor(self:ReadNumber(cell.Column, 0))
		return math.abs(row - centerRow) <= 1 and math.abs(column - centerColumn) <= 1
	end

	method any GetLogicalCellForRoom(string mapName, string roomName)
		-- Finds the logical row and column assigned to a physical generated room.
		local safeRoomName = self:ReadString(roomName, "")
		if safeRoomName == "" then
			return nil
		end
		local graph = self:GetGraphForMap(mapName)
		if graph == nil or graph.Rooms == nil then
			return nil
		end
		for index, room in ipairs(graph.Rooms) do
			local assigned = self:ReadString(room.AssignedRoomName, self:ReadString(room.Name, ""))
			if assigned == safeRoomName or self:ReadString(room.Name, "") == safeRoomName then
				return { Row = self:ReadNumber(room.Row, 0), Column = self:ReadNumber(room.Column, 0) }
			end
		end
		return nil
	end

	method any GetGraphForMap(string mapName)
		-- Returns the latest logical graph for a battle map.
		if _BRRoomGraphGenerator == nil then
			return nil
		end
		return _BRRoomGraphGenerator:GetLatestGraphForMap(self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap")))
	end

	method string GetRoomNameForSupply(Entity supply)
		-- Walks up the entity tree to find the generated room name for an anchor.
		local current = supply
		local depth = 0
		while current ~= nil and depth < 12 do
			if self:IsGeneratedRoomName(current.Name) == true then
				return self:ReadString(current.Name, "")
			end
			current = current.Parent
			depth = depth + 1
		end
		return ""
	end

	method string GetSupplyAlertRecord(string mapName, Entity supply, string alertKind)
		-- Builds one minimap alert record in row,column,kind form.
		local roomName = self:GetRoomNameForSupply(supply)
		local cell = self:GetLogicalCellForRoom(mapName, roomName)
		if cell == nil then
			return ""
		end
		return tostring(math.floor(self:ReadNumber(cell.Row, 0))) .. "," .. tostring(math.floor(self:ReadNumber(cell.Column, 0))) .. "," .. self:ReadString(alertKind, "S")
	end

	method string JoinRecords(any records)
		-- Joins minimap alert records with semicolons.
		local result = ""
		if records == nil then
			return result
		end
		for index, record in ipairs(records) do
			local value = self:ReadString(record, "")
			if value ~= "" then
				if result ~= "" then
					result = result .. ";"
				end
				result = result .. value
			end
		end
		return result
	end

	method any CopyCandidateList(any candidates)
		-- Copies a candidate list before random removal.
		local result = {}
		if candidates == nil then
			return result
		end
		for index, supply in ipairs(candidates) do
			table.insert(result, supply)
		end
		return result
	end

	method Vector2 GetMapCenterPosition(string mapName)
		-- Uses the center logical room if available, falling back to map origin.
		local graph = self:GetGraphForMap(mapName)
		if graph ~= nil and graph.Rooms ~= nil then
			local centerRow = math.floor((self:ReadNumber(graph.Rows, 1) + 1) * 0.5)
			local centerColumn = math.floor((self:ReadNumber(graph.Columns, 1) + 1) * 0.5)
			for index, room in ipairs(graph.Rooms) do
				if math.floor(self:ReadNumber(room.Row, 0)) == centerRow and math.floor(self:ReadNumber(room.Column, 0)) == centerColumn then
					local roomName = self:ReadString(room.AssignedRoomName, self:ReadString(room.Name, ""))
					local physicalRoom = self:GetPhysicalRoom(mapName, self:GetPhysicalRoomRoot(mapName), roomName)
					if physicalRoom ~= nil and physicalRoom.TransformComponent ~= nil then
						local position = physicalRoom.TransformComponent.WorldPosition
						return Vector2(position.x, position.y)
					end
				end
			end
		end
		return Vector2(0, 0)
	end

	method void PublishSupplyEvent(string mapName, string state, number count, string alertCells)
		-- Updates synced supply state and minimap alert payload.
		self.LastSupplyMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		self.LastSupplyState = self:ReadString(state, "Supply")
		self.LastSupplyDroppedCount = math.max(0, math.floor(self:ReadNumber(count, 0)))
		self.LastSupplyAlertCells = self:ReadString(alertCells, "")
		self.LastSupplyVersion = self.LastSupplyVersion + 1
	end

	method any CollectSupplyCandidates(string mapName, any graph)
		-- Collects supply child entities from assigned physical rooms first, then falls back to all generated rooms.
		local targetMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local root = self:GetPhysicalRoomRoot(targetMapName)
		if root == nil then
			self:Log("collect skipped: room root missing map=" .. targetMapName)
			return {}
		end

		local graphForMap = graph
		if graphForMap == nil and _BRRoomGraphGenerator ~= nil then
			graphForMap = _BRRoomGraphGenerator:GetLatestGraphForMap(targetMapName)
		end

		local rooms = self:CollectGraphPhysicalRooms(targetMapName, root, graphForMap)
		if #rooms <= 0 then
			rooms = self:CollectAllGeneratedRooms(root)
		end

		local candidates = {}
		local seenSupply = {}
		for index, room in ipairs(rooms) do
			self:CollectRoomSupplyChildren(room, candidates, seenSupply)
		end
		return candidates
	end

	method any CollectGraphPhysicalRooms(string mapName, Entity root, any graph)
		-- Resolves the physical rooms assigned by the latest logical room graph.
		local rooms = {}
		local seenRoom = {}
		if graph == nil or graph.Rooms == nil then
			return rooms
		end

		for index, graphRoom in ipairs(graph.Rooms) do
			local roomName = self:ReadString(graphRoom.AssignedRoomName, self:ReadString(graphRoom.Name, ""))
			if roomName ~= "" and seenRoom[roomName] ~= true then
				local room = self:GetPhysicalRoom(mapName, root, roomName)
				if room ~= nil then
					table.insert(rooms, room)
					seenRoom[roomName] = true
				end
			end
		end
		return rooms
	end

	method any CollectAllGeneratedRooms(Entity root)
		-- Returns every generated room child under the physical room root.
		local rooms = {}
		if root == nil then
			return rooms
		end

		local children = root.Children:ToTable()
		for index, child in ipairs(children) do
			if child ~= nil and self:IsGeneratedRoomName(child.Name) == true then
				table.insert(rooms, child)
			end
		end
		return rooms
	end

	method void CollectRoomSupplyChildren(Entity room, any candidates, any seenSupply)
		-- Adds direct supply children from one room.
		if room == nil then
			return
		end

		local direct = room:GetChildByName(self:GetSupplyChildName(), false)
		self:AddSupplyCandidate(candidates, seenSupply, direct)

		local names = self:GetFallbackSupplyNames()
		for index, childName in ipairs(names) do
			local child = room:GetChildByName(childName, false)
			self:AddSupplyCandidate(candidates, seenSupply, child)
		end

		local children = room.Children:ToTable()
		for index, child in ipairs(children) do
			if child ~= nil and self:IsSupplyChildName(child.Name) == true then
				self:AddSupplyCandidate(candidates, seenSupply, child)
			end
		end
	end

	method void AddSupplyCandidate(any candidates, any seenSupply, Entity supply)
		-- Adds one supply entity if it has not already been recorded.
		if supply == nil then
			return
		end

		local key = self:GetEntityKey(supply)
		if key == "" or seenSupply[key] == true then
			return
		end

		table.insert(candidates, supply)
		seenSupply[key] = true
	end

	method boolean SetSupplyRuntimeActive(Entity supply, boolean active)
		-- Toggles one supply prefab and its optional BRPartBox component.
		return self:SetSupplyRuntimeActiveWithKind(supply, active, "skill")
	end

	method boolean SetSupplyRuntimeActiveWithKind(Entity supply, boolean active, string kind)
		-- Toggles one supply prefab and configures its BRPartBox behavior.
		if supply == nil or isvalid(supply) ~= true then
			return false
		end

		local component = supply:GetComponent("script.BRPartBox")
		if component == nil then
			component = supply:GetComponent("BRPartBox")
		end
		if component == nil and active == true then
			component = supply:AddComponent("script.BRPartBox")
		end
		if active == true then
			supply:SetEnable(true)
			supply:SetVisible(true)
			if component ~= nil then
				---@type BRPartBox
				local partBox = component
				partBox:ConfigureSupplyKind(self:ReadString(kind, "skill"))
				if string.lower(self:ReadString(kind, "skill")) == "supply" then
					partBox.DropCount = self:GetSupplyChestDropCount()
				elseif string.lower(self:ReadString(kind, "skill")) == "skill" then
					partBox.DropCount = self:GetSkillChestDropCount()
				end
				partBox:SetRuntimeActive(true)
			end
		else
			if component ~= nil then
				---@type BRPartBox
				local partBox = component
				partBox:SetRuntimeActive(false)
			end
			supply:SetVisible(false)
			supply:SetEnable(false)
		end
		return true
	end

	method Entity GetPhysicalRoomRoot(string mapName)
		-- Resolves the generated-room container for a fixed physical map.
		local safeMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local root = _EntityService:GetEntityByPath("/maps/" .. safeMapName .. "/EditorGeneratedGrid")
		if root ~= nil then
			return root
		end
		return _EntityService:GetEntityByPath("/maps/" .. safeMapName)
	end

	method Entity GetPhysicalRoom(string mapName, Entity root, string roomName)
		-- Resolves one physical room by generated-grid path or direct map path.
		local safeRoomName = self:ReadString(roomName, "")
		if safeRoomName == "" then
			return nil
		end

		if root ~= nil then
			local room = root:GetChildByName(safeRoomName, false)
			if room ~= nil then
				return room
			end
		end

		local safeMapName = self:ReadString(mapName, self:ReadString(self.DefaultMapName, "RoomTestMap"))
		local generatedPath = "/maps/" .. safeMapName .. "/EditorGeneratedGrid/" .. safeRoomName
		local generatedRoom = _EntityService:GetEntityByPath(generatedPath)
		if generatedRoom ~= nil then
			return generatedRoom
		end

		return _EntityService:GetEntityByPath("/maps/" .. safeMapName .. "/" .. safeRoomName)
	end

	method boolean IsGeneratedRoomName(string roomName)
		-- Checks whether a name follows the generated room naming pattern.
		local value = self:ReadString(roomName, "")
		if value == "CornerNW" or value == "CornerNE" or value == "CornerSW" or value == "CornerSE" then
			return true
		end

		local prefix = "Room_"
		if string.sub(value, 1, string.len(prefix)) ~= prefix then
			return false
		end
		return tonumber(string.sub(value, string.len(prefix) + 1)) ~= nil
	end

	method boolean IsSupplyChildName(string childName)
		-- Checks whether a room child should be treated as a supply anchor.
		local value = self:ReadString(childName, "")
		if value == "" then
			return false
		end
		if value == self:GetSupplyChildName() then
			return true
		end

		local fallbackNames = self:GetFallbackSupplyNames()
		for index, fallbackName in ipairs(fallbackNames) do
			if value == fallbackName then
				return true
			end
		end

		return string.sub(value, 1, 6) == "Supply"
	end

	method any GetFallbackSupplyNames()
		-- Parses comma-delimited fallback supply child names.
		local result = {}
		local text = self:ReadString(self.FallbackSupplyChildNames, "")
		for name in string.gmatch(text, "([^,]+)") do
			local trimmed = self:Trim(name)
			if trimmed ~= "" then
				table.insert(result, trimmed)
			end
		end
		return result
	end

	method string GetSupplyChildName()
		-- Returns the primary supply child name.
		return self:ReadString(self.SupplyChildName, "SupplyBox")
	end

	method number GetMaxSuppliesPerDrop()
		-- Returns zero for all supplies or a positive cap for each drop.
		return math.max(0, math.floor(self:ReadNumber(self.MaxSuppliesPerDrop, 0)))
	end

	method number GetSkillChestDropCount()
		-- Returns the number of skill parts dropped by wooden skill chests.
		return math.max(1, math.floor(self:ReadNumber(self.SkillChestDropCount, 3)))
	end

	method number GetSupplyChestDropCount()
		-- Returns the number of skill parts dropped by slime treasure chests.
		return math.max(1, math.floor(self:ReadNumber(self.SupplyChestDropCount, 3)))
	end

	method number GetKioskSpawnDelaySeconds()
		-- Returns the phase-3 kiosk spawn delay.
		return math.max(0, self:ReadNumber(self.KioskSpawnDelaySeconds, 15))
	end

	method number GetKioskSpawnCount()
		-- Returns the number of phase-3 kiosks to spawn.
		return math.max(0, math.floor(self:ReadNumber(self.KioskSpawnCount, 2)))
	end

	method number GetSupplyDropCount()
		-- Returns the number of phase-5 supply drops.
		return math.max(0, math.floor(self:ReadNumber(self.SupplyDropCount, 1)))
	end

	method number GetMonsterLevelUpHpMultiplier()
		-- Returns phase-6 monster HP multiplier.
		return math.max(1, self:ReadNumber(self.MonsterLevelUpHpMultiplier, 1.5))
	end

	method number GetMonsterLevelUpAttackMultiplier()
		-- Returns phase-6 battle-bot attack multiplier.
		return math.max(1, self:ReadNumber(self.MonsterLevelUpAttackMultiplier, 1.25))
	end

	method number GetMonsterLevelUpRewardMultiplier()
		-- Returns phase-6 reward multiplier for training monsters.
		return math.max(1, self:ReadNumber(self.MonsterLevelUpRewardMultiplier, 1.25))
	end

	method string ResolveMapName(any matchRoom, string mapName)
		-- Resolves the target map from explicit input or match room fields.
		local value = self:ReadString(mapName, "")
		if value ~= "" then
			return value
		end
		if matchRoom ~= nil then
			value = self:ReadString(matchRoom.TargetMapName, self:ReadString(matchRoom.SourceMapName, ""))
		end
		return self:ReadString(value, self:ReadString(self.DefaultMapName, "RoomTestMap"))
	end

	method string GetEntityKey(Entity entity)
		-- Returns a stable key for an entity reference.
		if entity == nil then
			return ""
		end
		if entity.Id ~= nil and entity.Id ~= "" then
			return entity.Id
		end
		return self:ReadString(entity.Path, "")
	end

	method string Trim(string text)
		-- Removes leading and trailing whitespace from a small config token.
		local value = self:ReadString(text, "")
		while string.len(value) > 0 and self:IsWhitespace(string.sub(value, 1, 1)) == true do
			value = string.sub(value, 2)
		end
		while string.len(value) > 0 and self:IsWhitespace(string.sub(value, string.len(value), string.len(value))) == true do
			value = string.sub(value, 1, string.len(value) - 1)
		end
		return value
	end

	method boolean IsWhitespace(string value)
		-- Checks a single-character whitespace token.
		return value == " " or value == "\t" or value == "\n" or value == "\r"
	end

	method void EnsureRuntime()
		-- Initializes non-synced runtime tables.
		if self._T == nil then
			self._T = {}
		end
		if self._T.candidatesByMap == nil then
			self._T.candidatesByMap = {}
		end
		if self._T.phaseEvents == nil then
			self._T.phaseEvents = {}
		end
	end

	method string ReadString(any value, string fallback)
		-- Reads a string-like value with fallback.
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		-- Reads a numeric value with fallback.
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		-- Writes a supply-system log when verbose logging is enabled.
		if self.VerboseLog == true then
			log("[BRSupplySystem] " .. self:ReadString(message, ""))
		end
	end

end
