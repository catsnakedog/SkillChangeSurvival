@Logic
script BRPortalConnectionSystem extends Logic

	property boolean EnablePortalConnections = true

	property boolean RequireInteractionKey = true

	property number PollSeconds = 0.08

	property number ActivationPadding = 0.18

	property number PortalInteractReach = 5.5

	property number PortalExitOffset = 1.75

	property number ReuseCooldownSeconds = 0.85

	property number ClientRequestCooldownSeconds = 0.15

	property boolean InstantCameraFollow = true

	property boolean EnableCameraBoundsClamp = true

	property number CameraBoundsPollSeconds = 0.2

	property boolean BlockDeadPlayers = true

	property boolean BlockDuringBattleLock = true

	property boolean VerboseLog = true

	@Sync
	property string LastPortalInstallSummary = ""

	@Sync
	property string LastPortalUseSummary = ""

	property number pollTimerId = 0

	property any inputKeyDownHandler = nil

	property number cameraBoundsTimerId = 0

	property string cameraBoundsLastKey = ""

	property number clientNextPortalRequestAt = 0

	method void OnBeginPlay()
		-- Initializes server portal state and client interaction-key input.
		if self:IsServer() then
			self:EnsureRuntime()
			self:StartPolling()
			if self.RequireInteractionKey == true then
				self:Log("ready mode=interaction key=UpArrow")
			else
				self:Log("ready mode=auto")
			end
		end
		if self:IsClient() then
			self:StartClientInput()
			self:StartClientCameraBounds()
		end
	end

	method void OnEndPlay()
		-- Clears server polling and client input handlers.
		if self:IsServer() then
			self:StopPolling()
		end
		if self:IsClient() then
			self:StopClientInput()
			self:StopClientCameraBounds()
		end
	end

	@ExecSpace("ServerOnly")
	method void InstallGraph(any graph)
		-- Registers the latest logical graph portal links for one fixed physical map.
		if graph == nil then
			return
		end
		self:EnsureRuntime()

		local mapName = self:ReadString(graph.MapName, "")
		if mapName == "" then
			return
		end

		self._T.graphsByMap[mapName] = graph
		local linkCount = 0
		if graph.PortalLinks ~= nil then
			linkCount = #graph.PortalLinks
		end
		self.LastPortalInstallSummary = "map=" .. mapName .. " links=" .. tostring(linkCount)
		self:Log("installed " .. self.LastPortalInstallSummary)
	end

	@ExecSpace("ServerOnly")
	method void ClearMap(string mapName)
		-- Removes portal links for a map when a match ends.
		self:EnsureRuntime()
		local safeMapName = self:ReadString(mapName, "")
		if safeMapName == "" then
			return
		end

		self._T.graphsByMap[safeMapName] = nil
		self._T.arrivalPortalKeyByUser = {}
		self:Log("cleared map=" .. safeMapName)
	end

	@ExecSpace("ServerOnly")
	method void StartPolling()
		-- Starts the repeated portal scan.
		if self.EnablePortalConnections ~= true then
			return
		end
		if self.RequireInteractionKey == true then
			return
		end
		if self.pollTimerId ~= nil and self.pollTimerId > 0 then
			return
		end
		self.pollTimerId = _TimerService:SetTimerRepeat(function() self:ScanPortals() end, self:GetPollSeconds(), 0.1)
	end

	@ExecSpace("ServerOnly")
	method void StopPolling()
		-- Stops the repeated portal scan.
		if self.pollTimerId ~= nil and self.pollTimerId > 0 then
			_TimerService:ClearTimer(self.pollTimerId)
		end
		self.pollTimerId = 0
	end

	@ExecSpace("ServerOnly")
	method void ScanPortals()
		-- Checks every active match map for players standing on connected portals.
		if self.EnablePortalConnections ~= true then
			return
		end
		if self.RequireInteractionKey == true then
			return
		end
		self:EnsureRuntime()

		for mapName, graph in pairs(self._T.graphsByMap) do
			self:ScanMapPortals(mapName, graph)
		end
	end

	@ExecSpace("ClientOnly")
	method void StartClientInput()
		-- Hooks the local up-arrow key as the portal interaction command.
		if self.EnablePortalConnections ~= true then
			return
		end
		if self.RequireInteractionKey ~= true then
			return
		end
		if self.inputKeyDownHandler ~= nil then
			return
		end

		self.inputKeyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnPortalInteractKeyDown)
		self:ApplyInstantCameraFollow("client-ready")
		log("[BRPortalConnection] client input ready key=UpArrow")
	end

	@ExecSpace("ClientOnly")
	method void StopClientInput()
		-- Unhooks the local portal interaction key handler.
		if self.inputKeyDownHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.inputKeyDownHandler)
		end
		self.inputKeyDownHandler = nil
	end

	@ExecSpace("ClientOnly")
	method void StartClientCameraBounds()
		-- Starts syncing the local follow camera clamp from the current map bounds.
		if self.cameraBoundsTimerId ~= nil and self.cameraBoundsTimerId > 0 then
			return
		end
		self:ApplyLocalCameraBounds("client-ready")
		self.cameraBoundsTimerId = _TimerService:SetTimerRepeat(function() self:ApplyLocalCameraBounds("tick") end, self:GetCameraBoundsPollSeconds(), 0.1)
		log("[BRPortalConnection] camera bounds watcher ready interval=" .. tostring(self:GetCameraBoundsPollSeconds()))
	end

	@ExecSpace("ClientOnly")
	method void StopClientCameraBounds()
		-- Stops syncing the local follow camera clamp.
		if self.cameraBoundsTimerId ~= nil and self.cameraBoundsTimerId > 0 then
			_TimerService:ClearTimer(self.cameraBoundsTimerId)
		end
		self.cameraBoundsTimerId = 0
		self.cameraBoundsLastKey = ""
	end

	@ExecSpace("ClientOnly")
	method void OnPortalInteractKeyDown(KeyDownEvent event)
		-- Sends a portal-use request when the local player presses the up arrow.
		if event == nil or event.key ~= KeyboardKey.UpArrow then
			return
		end
		if self.EnablePortalConnections ~= true or self.RequireInteractionKey ~= true then
			return
		end
		if _BRCommonSkillSystem ~= nil and _BRCommonSkillSystem:IsLocalNimbusActive() == true then
			log("[BRPortalConnection] interact blocked reason=nimbus")
			return
		end

		local now = _UtilLogic.ElapsedSeconds
		if now < self:ReadNumber(self.clientNextPortalRequestAt, 0) then
			return
		end

		self.clientNextPortalRequestAt = now + self:GetClientRequestCooldownSeconds()
		log("[BRPortalConnection] interact request key=UpArrow")
		self:RequestUsePortal()
	end

	@ExecSpace("ServerOnly")
	method void ScanMapPortals(string mapName, any graph)
		-- Checks all players in one map against that map's portal links.
		if graph == nil or graph.PortalLinks == nil then
			return
		end

		local users = _UserService:GetUsersByMapName(mapName)
		if users == nil then
			return
		end

		for index, playerEntity in ipairs(users) do
			if self:CanPlayerUsePortal(mapName, playerEntity) == true then
				local link = self:FindPortalLinkForPlayer(graph, playerEntity)
				if link ~= nil then
					self:UsePortalLink(mapName, graph, playerEntity, link)
				end
			end
		end
	end

	@ExecSpace("Server")
	method void RequestUsePortal()
		-- Handles a client interaction request after server-side portal validation.
		if self.EnablePortalConnections ~= true then
			return
		end
		self:EnsureRuntime()

		local userId = self:ReadString(senderUserId, "")
		if userId == "" then
			self:Log("interact skipped: sender missing")
			return
		end

		local playerEntity = _UserService:GetUserEntityByUserId(userId)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			self:Log("interact skipped: player missing user=" .. userId)
			return
		end

		local mapName = self:ReadString(playerEntity.CurrentMapName, "")
		if mapName == "" then
			self:Log("interact skipped: map missing user=" .. userId)
			return
		end

		local graph = self._T.graphsByMap[mapName]
		if graph == nil then
			self:Log("interact skipped: graph missing user=" .. userId .. " map=" .. mapName)
			return
		end
		if self:CanPlayerUsePortal(mapName, playerEntity) ~= true then
			self:Log("interact blocked user=" .. userId .. " map=" .. mapName)
			return
		end

		local link = self:FindPortalLinkForPlayer(graph, playerEntity)
		if link == nil then
			local position = self:GetEntityPosition2(playerEntity)
			local root = self:GetPhysicalRoomRoot(mapName)
			self:Log("interact no portal user=" .. userId .. " map=" .. mapName .. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ") " .. self:BuildNearestPortalDebug(graph, root, position))
			return
		end

		self:UsePortalLink(mapName, graph, playerEntity, link)
	end

	method boolean CanPlayerUsePortal(string mapName, Entity playerEntity)
		-- Applies death, cooldown, and battle-lock checks before portal use.
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return false
		end
		if self.BlockDeadPlayers == true and (playerEntity.PlayerComponent:IsDead() == true or playerEntity.PlayerComponent.Hp <= 0) then
			return false
		end

		local userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
		if userId == "" then
			return false
		end

		local now = self:Now()
		if now < self:ReadNumber(self._T.cooldownUntil[userId], 0) then
			return false
		end
		if self:IsNimbusPortalLocked(playerEntity) == true then
			return false
		end
		if self:IsBattlePortalLocked(mapName, playerEntity) == true then
			return false
		end
		return true
	end

	method boolean IsNimbusPortalLocked(Entity playerEntity)
		-- Blocks portal movement while the user is riding the non-combat nimbus skill.
		if _BRCommonSkillSystem == nil or playerEntity == nil or playerEntity.PlayerComponent == nil then
			return false
		end
		local userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
		if userId == "" then
			return false
		end
		return _BRCommonSkillSystem:IsNimbusActiveForUser(userId) == true
	end

	method any FindPortalLinkForPlayer(any graph, Entity playerEntity)
		-- Returns the first active portal link touched by the player.
		if graph == nil or graph.PortalLinks == nil then
			return nil
		end

		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return nil
		end

		local playerPosition = self:GetEntityPosition2(playerEntity)
		local root = self:GetPhysicalRoomRoot(graph.MapName)
		if root == nil then
			return nil
		end

		local userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
		if self:IsWaitingForArrivalPortalExit(graph, root, userId, playerPosition) == true then
			return nil
		end

		for index, link in ipairs(graph.PortalLinks) do
			local fromPortal = self:GetPhysicalPortal(graph.MapName, root, link.FromRoomName, link.FromDirection)
			if self:IsPlayerInsidePortal(playerPosition, fromPortal, link.FromDirection) == true then
				return link
			end
		end
		return nil
	end

	method void UsePortalLink(string mapName, any graph, Entity playerEntity, any link)
		-- Moves a player from one logical portal endpoint to the paired endpoint.
		if playerEntity == nil or playerEntity.PlayerComponent == nil or link == nil then
			return
		end

		local root = self:GetPhysicalRoomRoot(mapName)
		if root == nil then
			return
		end

		local arrivalPortalKey = self:GetArrivalPortalKey(link)
		local pairedLink = self:ResolvePairedPortalLink(graph, link)
		local arrivalRoomName = self:ReadString(link.ToRoomName, "")
		local arrivalDirection = self:ReadString(link.ToDirection, "")
		if pairedLink ~= nil then
			arrivalRoomName = self:ReadString(pairedLink.FromRoomName, arrivalRoomName)
			arrivalDirection = self:ReadString(pairedLink.FromDirection, arrivalDirection)
			arrivalPortalKey = self:ReadString(pairedLink.FromPortalKey, self:BuildPortalKey(arrivalRoomName, arrivalDirection))
		end
		local destinationPortal = self:GetPhysicalPortal(mapName, root, arrivalRoomName, arrivalDirection)
		if destinationPortal == nil then
			destinationPortal = self:GetPhysicalPortal(mapName, root, link.ToRoomName, link.ToDirection)
			arrivalRoomName = self:ReadString(link.ToRoomName, "")
			arrivalDirection = self:ReadString(link.ToDirection, "")
			arrivalPortalKey = self:GetArrivalPortalKey(link)
		end
		if destinationPortal == nil then
			self:Log("use skipped: destination missing map=" .. mapName .. " arrival=" .. arrivalRoomName .. ":" .. arrivalDirection .. " pair=" .. arrivalPortalKey)
			return
		end

		if pairedLink == nil then
			self:Log("pair missing key=" .. self:ReadString(link.Key, "") .. " pair=" .. arrivalPortalKey)
		end

		local exitPosition = self:GetPortalExitPosition(destinationPortal, arrivalDirection)
		local boundsWarning = self:BuildMapBoundsWarning(mapName, exitPosition)
		local userId = self:ReadString(playerEntity.PlayerComponent.UserId, "")
		self._T.cooldownUntil[userId] = self:Now() + self:GetReuseCooldownSeconds()
		self._T.arrivalPortalKeyByUser[userId] = arrivalPortalKey
		self:SetPlayerWorldPosition(playerEntity, exitPosition)
		self:ApplyLocalPortalPosition(exitPosition, "portal", userId)

		self.LastPortalUseSummary = "user=" .. userId
			.. " " .. self:ReadString(link.FromRoomName, "") .. ":" .. self:ReadString(link.FromDirection, "")
			.. ">" .. self:ReadString(link.ToRoomName, "") .. ":" .. self:ReadString(link.ToDirection, "")
			.. " arrival=" .. arrivalRoomName .. ":" .. arrivalDirection
			.. " pair=" .. arrivalPortalKey
			.. " pos=(" .. tostring(exitPosition.x) .. "," .. tostring(exitPosition.y) .. ")"
			.. boundsWarning
		self:Log("used " .. self.LastPortalUseSummary)
	end

	@ExecSpace("Client")
	method void ApplyLocalPortalPosition(Vector2 position, string reason)
		-- Mirrors the server-side portal move on the owning client.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return
		end

		if localPlayer.MovementComponent ~= nil then
			localPlayer.MovementComponent:Stop()
			localPlayer.MovementComponent:SetWorldPosition(position)
		end
		if localPlayer.RigidbodyComponent ~= nil then
			localPlayer.RigidbodyComponent.IgnoreMoveBoundary = true
			localPlayer.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			localPlayer.RigidbodyComponent:SetWorldPosition(position)
			localPlayer.RigidbodyComponent:PositionReset()
		elseif localPlayer.KinematicbodyComponent ~= nil then
			localPlayer.KinematicbodyComponent:SetWorldPosition(position)
		elseif localPlayer.SideviewbodyComponent ~= nil then
			localPlayer.SideviewbodyComponent:SetWorldPosition(position)
		end
		if localPlayer.PlayerComponent ~= nil then
			localPlayer.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		end
		self:ApplyInstantCameraFollow(reason)
		log("[BRPortalConnection] local move reason=" .. self:ReadString(reason, "") .. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void ApplyInstantCameraFollow(string reason)
		-- Makes the local follow camera snap to the teleported player instead of easing across rooms.
		if self.InstantCameraFollow ~= true then
			return
		end

		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.CameraComponent == nil then
			return
		end

		localPlayer.CameraComponent.Damping = Vector2(0, 0)
		local previousBlendTime = 0
		if _CameraService ~= nil then
			previousBlendTime = self:ReadNumber(_CameraService.TransitionBlendTime, 0)
			_CameraService.TransitionBlendTime = 0
			_CameraService:SwitchCameraTo(localPlayer.CameraComponent)
			_CameraService.TransitionBlendTime = previousBlendTime
		end
		log("[BRPortalConnection] camera instant reason=" .. self:ReadString(reason, ""))
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalCameraBounds(string reason)
		-- Copies the current map bounds to the local player camera as a center-coordinate clamp.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.CameraComponent == nil then
			return
		end

		local camera = localPlayer.CameraComponent
		if self.EnableCameraBoundsClamp ~= true then
			self:DisableLocalCameraBounds(camera, "disabled", reason)
			return
		end

		local mapEntity = self:GetLocalPlayerMapEntity(localPlayer)
		local mapName = self:GetLocalPlayerMapName(localPlayer, mapEntity)
		if mapEntity == nil or mapEntity.MapComponent == nil then
			self:DisableLocalCameraBounds(camera, mapName, "mapMissing")
			return
		end

		if mapEntity.MapComponent.UseCustomBound ~= true then
			self:DisableLocalCameraBounds(camera, mapName, "mapHasNoCustomBound")
			return
		end

		local leftBottom = mapEntity.MapComponent.LeftBottom
		local rightTop = mapEntity.MapComponent.RightTop
		if leftBottom == nil or rightTop == nil then
			self:DisableLocalCameraBounds(camera, mapName, "boundMissing")
			return
		end
		if rightTop.x <= leftBottom.x or rightTop.y <= leftBottom.y then
			self:DisableLocalCameraBounds(camera, mapName, "boundInvalid")
			return
		end

		camera.ConfineCameraArea = false
		camera.UseCustomBound = true
		camera.LeftBottom = Vector2(leftBottom.x, leftBottom.y)
		camera.RightTop = Vector2(rightTop.x, rightTop.y)

		local key = "bound:" .. mapName .. ":" .. tostring(leftBottom.x) .. "," .. tostring(leftBottom.y) .. "," .. tostring(rightTop.x) .. "," .. tostring(rightTop.y)
		if self.cameraBoundsLastKey ~= key then
			self.cameraBoundsLastKey = key
			log("[BRPortalConnection] camera bounds centerClamp map=" .. mapName
				.. " bounds=(" .. tostring(leftBottom.x) .. "," .. tostring(leftBottom.y) .. ")-(" .. tostring(rightTop.x) .. "," .. tostring(rightTop.y) .. ")"
				.. " reason=" .. self:ReadString(reason, ""))
		end
	end

	@ExecSpace("ClientOnly")
	method void DisableLocalCameraBounds(CameraComponent camera, string mapName, string reason)
		-- Clears local custom camera bounds when the active map does not expose a map-part range.
		if camera == nil then
			return
		end

		camera.UseCustomBound = false
		camera.ConfineCameraArea = true

		local safeMapName = self:ReadString(mapName, "")
		local safeReason = self:ReadString(reason, "")
		local key = "disabled:" .. safeMapName .. ":" .. safeReason
		if self.cameraBoundsLastKey ~= key then
			self.cameraBoundsLastKey = key
			log("[BRPortalConnection] camera bounds disabled map=" .. safeMapName .. " reason=" .. safeReason)
		end
	end

	method Entity GetLocalPlayerMapEntity(Entity playerEntity)
		-- Resolves the map entity that currently owns the local player.
		if playerEntity == nil then
			return nil
		end
		if playerEntity.CurrentMap ~= nil then
			return playerEntity.CurrentMap
		end

		local mapName = self:ReadString(playerEntity.CurrentMapName, "")
		if mapName == "" then
			return nil
		end
		return _EntityService:GetEntityByPath("/maps/" .. mapName)
	end

	method string GetLocalPlayerMapName(Entity playerEntity, Entity mapEntity)
		-- Reads a stable map name for camera-bound logs and cache keys.
		if mapEntity ~= nil then
			return self:ReadString(mapEntity.Name, "")
		end
		if playerEntity ~= nil then
			return self:ReadString(playerEntity.CurrentMapName, "")
		end
		return ""
	end

	method boolean IsBattlePortalLocked(string mapName, Entity playerEntity)
		-- Checks optional battle logic for combat-time portal blocking.
		if self.BlockDuringBattleLock ~= true then
			return false
		end

		local battleLogic = self:GetBattleLogic(mapName)
		if battleLogic == nil then
			return false
		end
		return battleLogic:IsPortalUseBlocked(playerEntity)
	end

	method any GetBattleLogic(string mapName)
		-- Resolves the map-scoped battle logic component when present.
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. self:ReadString(mapName, ""))
		if mapEntity == nil then
			return nil
		end

		---@type BRBattleLogic
		local battleLogic = mapEntity:GetComponent("script.BRBattleLogic")
		return battleLogic
	end

	method boolean IsPlayerInsidePortal(Vector2 playerPosition, Entity portal, string direction)
		-- Checks whether a player position overlaps one portal activation box.
		if playerPosition == nil or portal == nil or portal.TransformComponent == nil then
			return false
		end
		if portal.Visible ~= true then
			return false
		end

		local portalPosition = self:GetEntityPosition2(portal)
		local boxSize = self:GetPortalBoxSize(direction)
		local halfWidth = boxSize.x * 0.5 + self:GetActivationPadding()
		local halfHeight = boxSize.y * 0.5 + self:GetActivationPadding()
		local reach = self:GetPortalInteractReach()
		if direction == "East" or direction == "West" then
			halfWidth = math.max(halfWidth, 1.35)
			halfHeight = math.max(halfHeight, math.min(reach, 2.2))
		else
			halfWidth = math.max(halfWidth, 2.6)
			halfHeight = math.max(halfHeight, math.min(reach, 3.5))
		end
		return math.abs(playerPosition.x - portalPosition.x) <= halfWidth
			and math.abs(playerPosition.y - portalPosition.y) <= halfHeight
	end

	method string BuildNearestPortalDebug(any graph, Entity root, Vector2 playerPosition)
		-- Reports the closest active portal when interaction misses.
		if graph == nil or graph.PortalLinks == nil or root == nil or playerPosition == nil then
			return "nearest=none"
		end

		local bestPortalPosition = nil
		local bestDistance = nil
		local bestRoomName = ""
		local bestDirection = ""
		for index, link in ipairs(graph.PortalLinks) do
			if link ~= nil then
				local fromRoomName = self:ReadString(link.FromRoomName, "")
				local fromDirection = self:ReadString(link.FromDirection, "")
				local portal = self:GetPhysicalPortal(graph.MapName, root, fromRoomName, fromDirection)
				if portal ~= nil and portal.Visible == true then
					local portalPosition = self:GetEntityPosition2(portal)
					local dx = playerPosition.x - portalPosition.x
					local dy = playerPosition.y - portalPosition.y
					local distance = math.sqrt(dx * dx + dy * dy)
					if bestDistance == nil or distance < bestDistance then
						bestDistance = distance
						bestPortalPosition = portalPosition
						bestRoomName = fromRoomName
						bestDirection = fromDirection
					end
				end
			end
		end

		if bestPortalPosition == nil then
			return "nearest=none"
		end

		return "nearest=" .. bestRoomName .. ":" .. bestDirection
			.. " dist=" .. tostring(bestDistance)
			.. " portal=(" .. tostring(bestPortalPosition.x) .. "," .. tostring(bestPortalPosition.y) .. ")"
	end

	method Vector2 GetPortalExitPosition(Entity destinationPortal, string arrivalDirection)
		-- Moves the player just inside the paired destination room instead of on top of the portal marker.
		local portalPosition = self:GetEntityPosition2(destinationPortal)
		local offset = self:GetPortalExitOffsetForDirection(arrivalDirection)
		if arrivalDirection == "East" then
			return Vector2(portalPosition.x - offset, portalPosition.y)
		elseif arrivalDirection == "West" then
			return Vector2(portalPosition.x + offset, portalPosition.y)
		elseif arrivalDirection == "North" then
			return Vector2(portalPosition.x, portalPosition.y - offset)
		elseif arrivalDirection == "South" then
			return Vector2(portalPosition.x, portalPosition.y + offset)
		end
		return portalPosition
	end

	method string BuildMapBoundsWarning(string mapName, Vector2 position)
		-- Reports when a portal exit lands outside the map's custom playable bounds.
		local safeMapName = self:ReadString(mapName, "")
		if safeMapName == "" or position == nil then
			return ""
		end

		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. safeMapName)
		if mapEntity == nil or mapEntity.MapComponent == nil then
			return ""
		end
		if mapEntity.MapComponent.UseCustomBound ~= true then
			return ""
		end

		local leftBottom = mapEntity.MapComponent.LeftBottom
		local rightTop = mapEntity.MapComponent.RightTop
		if leftBottom == nil or rightTop == nil then
			return ""
		end
		if position.x >= leftBottom.x and position.x <= rightTop.x
			and position.y >= leftBottom.y and position.y <= rightTop.y then
			return ""
		end

		return " outOfBound bounds=(" .. tostring(leftBottom.x) .. "," .. tostring(leftBottom.y) .. ")-(" .. tostring(rightTop.x) .. "," .. tostring(rightTop.y) .. ")"
	end

	method void SetPlayerWorldPosition(Entity playerEntity, Vector2 position)
		-- Applies the portal destination to all relevant movement/body components.
		if playerEntity == nil then
			return
		end

		if playerEntity.MovementComponent ~= nil then
			playerEntity.MovementComponent:Stop()
			playerEntity.MovementComponent:SetWorldPosition(position)
		end
		if playerEntity.RigidbodyComponent ~= nil then
			playerEntity.RigidbodyComponent.IgnoreMoveBoundary = true
			playerEntity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			playerEntity.RigidbodyComponent:SetWorldPosition(position)
			playerEntity.RigidbodyComponent:PositionReset()
		elseif playerEntity.KinematicbodyComponent ~= nil then
			playerEntity.KinematicbodyComponent:SetWorldPosition(position)
		elseif playerEntity.SideviewbodyComponent ~= nil then
			playerEntity.SideviewbodyComponent:SetWorldPosition(position)
		end
		if playerEntity.PlayerComponent ~= nil then
			playerEntity.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		end
	end

	method Entity GetPhysicalRoomRoot(string mapName)
		-- Resolves the generated physical room container.
		local safeMapName = self:ReadString(mapName, "RoomTestMap")
		local root = _EntityService:GetEntityByPath("/maps/" .. safeMapName .. "/EditorGeneratedGrid")
		if root ~= nil then
			return root
		end
		return _EntityService:GetEntityByPath("/maps/" .. safeMapName)
	end

	method Entity GetPhysicalPortal(string mapName, Entity root, string roomName, string direction)
		-- Resolves one physical portal entity from a room name and direction.
		local room = self:GetPhysicalRoom(mapName, root, roomName)
		if room == nil then
			return nil
		end
		return room:GetChildByName(self:GetPortalChildName(direction), false)
	end

	method Entity GetPhysicalRoom(string mapName, Entity root, string roomName)
		-- Resolves a generated physical room entity.
		local safeRoomName = self:ReadString(roomName, "")
		if safeRoomName == "" then
			return nil
		end

		if root ~= nil then
			local room = root:GetChildByName(safeRoomName, false)
			if room ~= nil then
				return room
			end
		end
		return _EntityService:GetEntityByPath("/maps/" .. self:ReadString(mapName, "RoomTestMap") .. "/EditorGeneratedGrid/" .. safeRoomName)
	end

	method string GetPortalChildName(string direction)
		-- Converts a graph direction into the standardized portal child name.
		if direction == "North" then
			return "PortalNorth"
		elseif direction == "East" then
			return "PortalEast"
		elseif direction == "South" then
			return "PortalSouth"
		elseif direction == "West" then
			return "PortalWest"
		end
		return ""
	end

	method boolean IsWaitingForArrivalPortalExit(any graph, Entity root, string userId, Vector2 playerPosition)
		-- Blocks only the arrival portal until the player leaves its trigger box.
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return false
		end
		local blockedKey = self:ReadString(self._T.arrivalPortalKeyByUser[safeUserId], "")
		if blockedKey == "" then
			return false
		end

		local blockedLink = {}
		local hasBlockedLink = false
		local mapName = ""
		if graph ~= nil and graph.PortalLinkByKey ~= nil then
			mapName = self:ReadString(graph.MapName, "")
			local candidateLink = graph.PortalLinkByKey[blockedKey]
			if candidateLink ~= nil then
				blockedLink = candidateLink
				hasBlockedLink = true
			end
		end
		if hasBlockedLink == false then
			self._T.arrivalPortalKeyByUser[safeUserId] = nil
			return false
		end

		local blockedRoomName = self:ReadString(blockedLink["FromRoomName"], "")
		local blockedDirection = self:ReadString(blockedLink["FromDirection"], "")
		local blockedPortal = self:GetPhysicalPortal(mapName, root, blockedRoomName, blockedDirection)
		if self:IsPlayerInsidePortal(playerPosition, blockedPortal, blockedDirection) == true then
			return true
		end

		self._T.arrivalPortalKeyByUser[safeUserId] = nil
		return false
	end

	method string BuildPortalKey(string roomName, string direction)
		-- Builds the directed portal key used by graph.PortalLinkByKey.
		return self:ReadString(roomName, "") .. ":" .. self:ReadString(direction, "")
	end

	method string GetArrivalPortalKey(any link)
		-- Reads the explicit paired portal key, with compatibility for older generated graphs.
		if link == nil then
			return ""
		end
		local toPortalKey = self:ReadString(link.ToPortalKey, "")
		if toPortalKey ~= "" then
			return toPortalKey
		end
		local pairKey = self:ReadString(link.PairKey, "")
		if pairKey ~= "" then
			return pairKey
		end
		return self:BuildPortalKey(link.ToRoomName, link.ToDirection)
	end

	method any ResolvePairedPortalLink(any graph, any link)
		-- Resolves the reverse directed link for the physical portal pair.
		if graph == nil or graph.PortalLinkByKey == nil or link == nil then
			return nil
		end

		local pairKey = self:GetArrivalPortalKey(link)
		if pairKey == "" then
			return nil
		end
		return graph.PortalLinkByKey[pairKey]
	end

	method Vector2 GetPortalBoxSize(string direction)
		-- Returns the activation box size used by generated portal markers.
		if direction == "East" or direction == "West" then
			return Vector2(0.45, 2.4)
		end
		return Vector2(2.4, 0.45)
	end

	method Vector2 GetEntityPosition2(Entity entity)
		-- Reads an entity's world position as Vector2.
		if entity == nil or entity.TransformComponent == nil then
			return Vector2(0, 0)
		end
		local position = entity.TransformComponent.WorldPosition
		return Vector2(position.x, position.y)
	end

	method void EnsureRuntime()
		-- Ensures runtime-only portal tables exist.
		if self._T.graphsByMap == nil then
			self._T.graphsByMap = {}
		end
		if self._T.cooldownUntil == nil then
			self._T.cooldownUntil = {}
		end
		if self._T.arrivalPortalKeyByUser == nil then
			self._T.arrivalPortalKeyByUser = {}
		end
	end

	method number GetPollSeconds()
		-- Returns the portal polling interval.
		return math.max(0.033, self:ReadNumber(self.PollSeconds, 0.08))
	end

	method number GetActivationPadding()
		-- Returns extra activation padding around portal boxes.
		return math.max(0, self:ReadNumber(self.ActivationPadding, 0.18))
	end

	method number GetPortalInteractReach()
		-- Returns the foot-position reach used for side-view portal interaction.
		return math.max(1, self:ReadNumber(self.PortalInteractReach, 5.5))
	end

	method number GetPortalExitOffset()
		-- Returns the inward arrival offset from the destination portal marker.
		return math.max(0, self:ReadNumber(self.PortalExitOffset, 1.75))
	end

	method number GetPortalExitOffsetForDirection(string direction)
		-- North/south markers have a taller interaction reach, so they need a larger exit push.
		local offset = self:GetPortalExitOffset()
		if direction == "North" or direction == "South" then
			return math.max(offset, 3.8)
		end
		return offset
	end

	method number GetReuseCooldownSeconds()
		-- Returns the per-player portal reuse cooldown.
		return math.max(0.1, self:ReadNumber(self.ReuseCooldownSeconds, 0.85))
	end

	method number GetClientRequestCooldownSeconds()
		-- Returns the local key-repeat throttle for portal interaction requests.
		return math.max(0.03, self:ReadNumber(self.ClientRequestCooldownSeconds, 0.15))
	end

	method number GetCameraBoundsPollSeconds()
		-- Returns the client camera-bound sync interval.
		return math.max(0.05, self:ReadNumber(self.CameraBoundsPollSeconds, 0.2))
	end

	method number Now()
		-- Returns the current server elapsed time.
		return _UtilLogic.ServerElapsedSeconds
	end

	method string ReadString(any value, string fallback)
		-- Reads a string-like value with fallback.
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		-- Reads a numeric value with fallback.
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		-- Writes a portal-system log when verbose logging is enabled.
		if self.VerboseLog == true then
			log("[BRPortalConnection] " .. self:ReadString(message, ""))
		end
	end

end
