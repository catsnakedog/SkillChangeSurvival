@Component
script BRSkillPartTestNPC extends Component

	property string InteractionKeyName = "F"

	property number InteractionRange = 1.8

	property number LobbyKioskPrice = 0

	property string CandyMachineStandRUID = "fe310ca2f8e74eb18858ff45273f61e4"

	property string CandyMachineActionRUID = "ea9a08bfa95c4217b1796262feaa737b"

	property string CandyMachineEyeRUID = "31053e533872440598525ce6a660dff2"

	property string CandyMachineNeonRUID = "86ea9c13eb114bea9503ae4db05ecc6e"

	property number CandyMachineOrderInLayer = 35

	property number CandyMachineActionPreviewSeconds = 0.6

	property boolean VerboseLog = true

	property any inputKeyDownHandler = nil

	method void OnBeginPlay()
		self:ApplyCandyMachineVisual()
		self.inputKeyDownHandler = nil
		if self:IsClient() then
			self:StartInput()
		end
	end

	method void OnEndPlay()
		if self:IsClient() then
			self:DisconnectInput()
		end
	end

	@ExecSpace("ClientOnly")
	method void StartInput()
		if self.inputKeyDownHandler ~= nil then
			self:Log("ready skipped reason=alreadyConnected")
			return
		end
		if _InputService == nil then
			self:Log("ready skipped reason=noInputService")
			return
		end
		self.inputKeyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnInteractionKeyDown)
		if self.inputKeyDownHandler == nil then
			self:Log("ready failed reason=connectReturnedNil")
			return
		end
		self:Log("ready key=" .. self:GetInteractionKeyName() .. " range=" .. tostring(self:GetInteractionRange()))
	end

	@ExecSpace("ClientOnly")
	method void OnInteractionKeyDown(KeyDownEvent event)
		if self:IsInteractionKey(event) ~= true then
			return
		end
		if self:IsLocalPlayerInRange() ~= true then
			return
		end
		if _BRSkillPartTestUI == nil then
			self:Log("open skipped reason=noSkillPartTestUI")
			return
		end
		local userId = self:GetLocalUserId()
		if userId == "" then
			self:Log("open skipped reason=noLocalUser npc=" .. self:GetNpcName())
			return
		end
		local position = self:GetWorldPosition()
		local mapName = self:GetMapName()
		local price = math.max(0, math.floor(self:ReadNumber(self.LobbyKioskPrice, 0)))
		self:PlayKioskActionLocal()
		_BRSkillPartTestUI:OpenKiosk(userId, mapName, position.x, position.y, price)
		self:Log("kiosk open requested npc=" .. self:GetNpcName() .. " map=" .. mapName .. " price=" .. tostring(price))
	end

	method void ApplyCandyMachineVisual()
		-- Applies the candy-machine idle animation clips to the NPC and its overlay children.
		self:ApplyRootStandVisual()
		self:ApplyOverlayVisual("Eye", self:ReadString(self.CandyMachineEyeRUID, ""), self:GetCandyMachineOrderInLayer() + 1)
		self:ApplyOverlayVisual("Neon", self:ReadString(self.CandyMachineNeonRUID, ""), self:GetCandyMachineOrderInLayer() + 2)
		self:Log("candy visual ready stand=" .. self:ReadString(self.CandyMachineStandRUID, ""))
	end

	method void ApplyRootStandVisual()
		-- Restores the main vending-machine body to its idle stand clip.
		self:ApplySpriteVisual(self.Entity, self:ReadString(self.CandyMachineStandRUID, ""), self:GetCandyMachineOrderInLayer())
	end

	method void ApplyOverlayVisual(string childName, string ruid, number order)
		-- Applies a same-origin overlay clip when the authored child exists.
		if self.Entity == nil then
			return
		end
		local child = self.Entity:GetChildByName(self:ReadString(childName, ""), false)
		if child == nil then
			return
		end
		self:ApplySpriteVisual(child, ruid, order)
	end

	method void ApplySpriteVisual(Entity entity, string ruid, number order)
		-- Writes a SpriteRenderer animationclip RUID without relying on the old Lucid asset.
		if entity == nil or self:ReadString(ruid, "") == "" then
			return
		end
		local renderer = entity.SpriteRendererComponent
		if renderer == nil then
			renderer = entity:AddComponent("SpriteRendererComponent")
		end
		if renderer == nil then
			return
		end
		renderer.Enable = true
		renderer.SpriteRUID = self:ReadString(ruid, "")
		renderer.OrderInLayer = math.floor(self:ReadNumber(order, self:GetCandyMachineOrderInLayer()))
		renderer.PlayRate = 1
	end

	@ExecSpace("ClientOnly")
	method void PlayKioskActionLocal()
		if self.Entity ~= nil and self.Entity.SpriteRendererComponent ~= nil and self:ReadString(self.CandyMachineActionRUID, "") ~= "" then
			self.Entity.SpriteRendererComponent.SpriteRUID = self:ReadString(self.CandyMachineActionRUID, "")
			_TimerService:SetTimerOnce(function() self:RestoreCandyMachineStandLocal() end, self:GetActionPreviewSeconds())
		end
	end

	@ExecSpace("ServerOnly")
	method void PlayKioskActionForSeconds(number seconds)
		-- Keeps the candy-machine action clip visible during delayed purchase delivery.
		if self.Entity ~= nil and self.Entity.SpriteRendererComponent ~= nil and self:ReadString(self.CandyMachineActionRUID, "") ~= "" then
			local duration = math.max(0.1, self:ReadNumber(seconds, 15))
			self.Entity.SpriteRendererComponent.SpriteRUID = self:ReadString(self.CandyMachineActionRUID, "")
			_TimerService:SetTimerOnce(function() self:RestoreCandyMachineStand() end, duration)
			self:Log("kiosk action hold seconds=" .. tostring(duration))
		end
	end

	@ExecSpace("ClientOnly")
	method void RestoreCandyMachineStandLocal()
		self:ApplyRootStandVisual()
	end

	@ExecSpace("ServerOnly")
	method void RestoreCandyMachineStand()
		-- Restores the idle body clip after a server-driven action animation.
		self:ApplyRootStandVisual()
	end

	method boolean IsInteractionKey(KeyDownEvent event)
		if event == nil then
			return false
		end
		local keyName = self:GetInteractionKeyName()
		if keyName == "C" then
			return event.key == KeyboardKey.C
		elseif keyName == "V" then
			return event.key == KeyboardKey.V
		elseif keyName == "F" then
			return event.key == KeyboardKey.F
		elseif keyName == "X" then
			return event.key == KeyboardKey.X
		end
		return event.key == KeyboardKey.F
	end

	@ExecSpace("ClientOnly")
	method boolean IsLocalPlayerInRange()
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.TransformComponent == nil or self.Entity == nil or self.Entity.TransformComponent == nil then
			return false
		end
		local playerPosition = localPlayer.TransformComponent.WorldPosition
		local npcPosition = self.Entity.TransformComponent.WorldPosition
		local dx = playerPosition.x - npcPosition.x
		local dy = playerPosition.y - npcPosition.y
		local range = self:GetInteractionRange()
		return dx * dx + dy * dy <= range * range
	end

	@ExecSpace("ClientOnly")
	method void DisconnectInput()
		if self.inputKeyDownHandler ~= nil and _InputService ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.inputKeyDownHandler)
		end
		self.inputKeyDownHandler = nil
	end

	method string GetNpcName()
		if self.Entity == nil then
			return "SkillPartTestNPC"
		end
		return self:ReadString(self.Entity.Name, "SkillPartTestNPC")
	end

	@ExecSpace("ClientOnly")
	method string GetLocalUserId()
		if _UserService == nil or _UserService.LocalPlayer == nil or _UserService.LocalPlayer.PlayerComponent == nil then
			return ""
		end
		return self:ReadString(_UserService.LocalPlayer.PlayerComponent.UserId, "")
	end

	method string GetMapName()
		if self.Entity == nil then
			return ""
		end
		local currentMapName = self:ReadString(self.Entity.CurrentMapName, "")
		if currentMapName ~= "" then
			return currentMapName
		end
		if self.Entity.CurrentMap ~= nil then
			return self:ReadString(self.Entity.CurrentMap.Name, "")
		end
		return ""
	end

	method Vector3 GetWorldPosition()
		if self.Entity ~= nil and self.Entity.TransformComponent ~= nil then
			return self.Entity.TransformComponent.WorldPosition
		end
		return Vector3(0, 0, 0)
	end

	method number GetInteractionRange()
		return math.max(0.2, self:ReadNumber(self.InteractionRange, 1.8))
	end

	method number GetCandyMachineOrderInLayer()
		return math.floor(self:ReadNumber(self.CandyMachineOrderInLayer, 35))
	end

	method number GetActionPreviewSeconds()
		return math.max(0.1, self:ReadNumber(self.CandyMachineActionPreviewSeconds, 0.6))
	end

	method string GetInteractionKeyName()
		return self:ReadString(self.InteractionKeyName, "F")
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		if self.VerboseLog == true then
			log("[BRSkillPartNPC] " .. self:ReadString(message, ""))
		end
	end

end
