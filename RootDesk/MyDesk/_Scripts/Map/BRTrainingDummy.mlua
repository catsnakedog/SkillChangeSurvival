@Component
script BRTrainingDummy extends Component

	property boolean EnableTrainingDummy = true

	property number MaxHp = 82

	property boolean NormalizeAuthoredDummyHp = true

	property number AuthoredDummyQuickKillMaxHp = 82

	property number ResetDelaySeconds = 3

	property number DamageFlashSeconds = 0.12

	property boolean RespawnOnBreak = true

	property number BreakDestroyDelaySeconds = 0.45

	property boolean VerboseLog = true

	property string NameTagTitle = "CHAIN MONSTER"

	@Sync
	property string MonsterPresetName = ""

	@Sync
	property number MonsterLevel = 1

	@Sync
	property boolean IsBattleRuntimeMonster = false

	property boolean GrantSkillExperienceOnBreak = true

	property number SkillExperienceReward = 100

	property number ExperienceRewardMultiplier = 1.25

	property number MesoReward = 4

	property number HitDamage = 1

	property boolean PauseMovementWhenBroken = true

	@Sync
	property number CurrentHp = 82

	@Sync
	property string DummyStatus = "Ready"

	property number resetTimerId = 0

	property number flashTimerId = 0

	property number HpBarWidth = 1.2

	property number HpBarHeight = 0.16

	property number HpBarYOffset = 1.0

	property number BossHpBarScale = 1.6

	property Color BossBorderColor = Color(1, 0.35, 0.9, 1)

	property boolean IsBossMonster = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		if self.EnableTrainingDummy == false then
			return
		end

		self:SetupHpBar()
		self:NormalizeAuthoredDummyBalance()
		self:ResetDummy()
		self:Log("ready hp=" .. tostring(self:GetMaxHp()) .. " map=" .. self:GetMapName())
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		self:ClearTimers()
	end

	@ExecSpace("ServerOnly")
	method void ApplyTrainingDamage(Entity attackerEntity, number rawDamage, string source)
		if self.EnableTrainingDummy == false then
			return
		end
		if self.CurrentHp <= 0 then
			return
		end

		local damage = math.max(1, math.floor(self:ReadNumber(rawDamage, 1)))
		self.CurrentHp = math.max(0, self.CurrentHp - damage)
		self:UpdateDummyStatus()

		local attackerId = self:GetUserId(attackerEntity)
		self:Log("hit source=" .. self:ReadString(source, "unknown")
			.. " attacker=" .. attackerId
			.. " damage=" .. tostring(damage)
			.. " hp=" .. tostring(self.CurrentHp) .. "/" .. tostring(self:GetMaxHp()))
		if _BRDamageSkinSystem ~= nil then
			_BRDamageSkinSystem:ShowEnemyDamage(self.Entity, damage, false, self:ReadString(source, "unknown"))
		end

		if self.CurrentHp <= 0 then
			self:GrantBreakReward(attackerEntity, source)
			self:BreakDummy()
		else
			self:FlashHit()
		end
	end

	@ExecSpace("ServerOnly")
	method void InitializeBattleMonster(string displayName, string presetName, number level, number maxHp, number hitDamage, number mesoReward, number experienceReward, boolean boss)
		-- Applies CSV-backed monster stats to a runtime-spawned battle monster.
		self.EnableTrainingDummy = true
		self.IsBattleRuntimeMonster = true
		self.MonsterPresetName = self:ReadString(presetName, "")
		self.MonsterLevel = math.max(1, math.floor(self:ReadNumber(level, 1)))
		self.NameTagTitle = self:ReadString(displayName, "Battle Monster")
		self.MaxHp = math.max(1, math.floor(self:ReadNumber(maxHp, 1)))
		self.HitDamage = math.max(1, math.floor(self:ReadNumber(hitDamage, 1)))
		self.SkillExperienceReward = math.max(0, math.floor(self:ReadNumber(experienceReward, 0)))
		self.MesoReward = math.max(0, math.floor(self:ReadNumber(mesoReward, 0)))
		self.RespawnOnBreak = false
		self.ResetDelaySeconds = 0
		self.GrantSkillExperienceOnBreak = true
		self.CurrentHp = self:GetMaxHp()
		self.DummyStatus = "Lv." .. tostring(math.floor(self.MonsterLevel)) .. " HP " .. tostring(math.floor(self.CurrentHp)) .. "/" .. tostring(self:GetMaxHp())
		self.IsBossMonster = boss == true
		if boss == true then
			self.DummyStatus = "BOSS " .. self.DummyStatus
		end
		self:SetMovementPaused(false)
		self:SetDummyColor(Color(1, 1, 1, 1))
		self:UpdateNameTag()
		self:SetupHpBar()
		self:Log("battle monster initialized name=" .. self.NameTagTitle
			.. " preset=" .. self.MonsterPresetName
			.. " hp=" .. tostring(self:GetMaxHp())
			.. " hitDamage=" .. tostring(self:GetHitDamage())
			.. " meso=" .. tostring(self:GetMesoReward())
			.. " exp=" .. tostring(self:GetSkillExperienceReward()))
	end

	@ExecSpace("ServerOnly")
	method void KillForEvolution()
		-- Removes this monster as part of phase evolution.
		self:ClearTimers()
		self.CurrentHp = 0
		self.DummyStatus = "Evolved"
		self:SetMovementPaused(true)
		self:SetDummyColor(Color(0.4, 0.4, 0.4, 1))
		self:UpdateNameTag()
		self:Log("evolution kill name=" .. self:ReadString(self.NameTagTitle, "monster"))
		self:DestroyEntityAfterBreak()
	end

	@ExecSpace("ServerOnly")
	method void GrantBreakReward(Entity attackerEntity, string source)
		-- Grants skill-chain experience to the attacker when the dummy breaks.
		if self.GrantSkillExperienceOnBreak ~= true then
			return
		end
		if _BRSkillSystem == nil then
			self:Log("reward skipped reason=noSkillSystem")
			return
		end

		local userId = self:GetUserId(attackerEntity)
		if userId == "" then
			self:Log("reward skipped reason=noAttacker")
			return
		end

		local reward = self:GetSkillExperienceReward()
		if reward <= 0 then
			return
		end

		local leveled = _BRSkillSystem:GrantUserExperience(userId, reward, self:ReadString(source, "dummy"))
		local meso = self:GetMesoReward()
		if meso > 0 then
			local addUserMeso = _BRSkillSystem["AddUserMeso"]
			if addUserMeso ~= nil then
				addUserMeso(_BRSkillSystem, userId, meso, self.Entity.Id)
			end
		end
		self:Log("reward user=" .. userId
			.. " exp=" .. tostring(reward)
			.. " meso=" .. tostring(meso)
			.. " leveled=" .. tostring(leveled)
			.. " source=" .. self:ReadString(source, "dummy"))
	end

	@ExecSpace("ServerOnly")
	method void ResetDummy()
		-- Restores the dummy state and lets moving dummy-monsters resume AI.
		self:ClearTimers()
		self.CurrentHp = self:GetMaxHp()
		self.DummyStatus = "Ready"
		self:SetMovementPaused(false)
		self:SetDummyColor(Color(0.87, 0.68, 0.32, 1))
		self:UpdateNameTag()
	end

	method void NormalizeAuthoredDummyBalance()
		-- Converts previously authored high-HP training monsters to the quick-kill target.
		if self.IsBattleRuntimeMonster == true or self.NormalizeAuthoredDummyHp ~= true then
			return
		end
		local targetHp = self:GetAuthoredDummyQuickKillMaxHp()
		if self:ReadNumber(self.MaxHp, targetHp) > targetHp then
			self.MaxHp = targetHp
			self.CurrentHp = targetHp
		end
	end

	@ExecSpace("ServerOnly")
	method void BreakDummy()
		-- Marks the dummy as broken and pauses moving monster AI until reset.
		self:ClearFlashTimer()
		self.DummyStatus = "Broken"
		self:SetMovementPaused(true)
		self:SetDummyColor(Color(0.4, 0.4, 0.4, 1))
		self:UpdateNameTag()
		self:Log("broken resetIn=" .. tostring(self:GetResetDelaySeconds()))

		if self:ShouldRespawnOnBreak() ~= true then
			local destroyDelay = self:GetBreakDestroyDelaySeconds()
			if destroyDelay <= 0 then
				self:DestroyEntityAfterBreak()
				return
			end
			self.resetTimerId = _TimerService:SetTimerOnce(function() self:DestroyEntityAfterBreak() end, destroyDelay)
			return
		end

		local delay = self:GetResetDelaySeconds()
		if delay <= 0 then
			self:ResetDummy()
			return
		end
		self.resetTimerId = _TimerService:SetTimerOnce(function() self:ResetDummy() end, delay)
	end

	@ExecSpace("ServerOnly")
	method void DestroyEntityAfterBreak()
		if self.Entity == nil then
			return
		end
		self.Entity:SetVisible(false)
		self.Entity:SetEnable(false)
		self.Entity:Destroy()
	end

	@ExecSpace("ServerOnly")
	method void FlashHit()
		self:ClearFlashTimer()
		self:SetDummyColor(Color(1, 0.28, 0.22, 1))
		self.flashTimerId = _TimerService:SetTimerOnce(function() self:RestoreIdleVisual() end, self:GetDamageFlashSeconds())
	end

	@ExecSpace("ServerOnly")
	method void RestoreIdleVisual()
		self.flashTimerId = 0
		if self.CurrentHp <= 0 then
			return
		end
		self:SetDummyColor(Color(0.87, 0.68, 0.32, 1))
	end

	@ExecSpace("ServerOnly")
	method void UpdateDummyStatus()
		if self.CurrentHp <= 0 then
			self.DummyStatus = "Broken"
		else
			self.DummyStatus = "HP " .. tostring(math.floor(self.CurrentHp)) .. "/" .. tostring(self:GetMaxHp())
		end
		self:UpdateNameTag()
	end

	@ExecSpace("ServerOnly")
	method void SetupHpBar()
		-- Configures the overhead HP bar child renderers, enlarged with a distinct border for bosses.
		if _BROverheadHpBar == nil or self.Entity == nil then
			return
		end
		local scale = 1
		local borderColor = nil
		if self.IsBossMonster == true then
			scale = math.max(1, self:ReadNumber(self.BossHpBarScale, 1.6))
			borderColor = self.BossBorderColor
		end
		local width = self:ReadNumber(self.HpBarWidth, 1.2) * scale
		local height = self:ReadNumber(self.HpBarHeight, 0.16) * scale
		local yOffset = self:ReadNumber(self.HpBarYOffset, 1.0) * scale
		_BROverheadHpBar:Setup(self.Entity, width, height, yOffset, borderColor)
		self:UpdateHpBar()
	end

	@ExecSpace("ServerOnly")
	method void UpdateHpBar()
		-- Pushes the current HP ratio to the overhead bar fill.
		if _BROverheadHpBar == nil or self.Entity == nil then
			return
		end
		local maxHp = self:GetMaxHp()
		local ratio = 0
		if maxHp > 0 then
			ratio = self.CurrentHp / maxHp
		end
		_BROverheadHpBar:SetRatio(self.Entity, ratio)
	end

	@ExecSpace("ServerOnly")
	method void UpdateNameTag()
		self:UpdateHpBar()
		if self.Entity == nil or self.Entity.NameTagComponent == nil then
			return
		end
		self.Entity.NameTagComponent.Name = self:ReadString(self.NameTagTitle, "CHAIN MONSTER") .. "\n" .. self:ReadString(self.DummyStatus, "Ready")
		if self.CurrentHp <= 0 then
			self.Entity.NameTagComponent.FontColor = Color(0.75, 0.75, 0.75, 1)
		else
			self.Entity.NameTagComponent.FontColor = Color(1, 0.92, 0.58, 1)
		end
	end

	@ExecSpace("ServerOnly")
	method void SetDummyColor(Color color)
		-- Applies dummy color feedback to polygon dummies and sprite monsters.
		if self.Entity == nil or self.Entity.PolygonRendererComponent == nil then
			if self.Entity ~= nil and self.Entity.SpriteRendererComponent ~= nil then
				self:CaptureBaseSpriteColor()
				if self:IsReadyDummyColor(color) == true then
					self.Entity.SpriteRendererComponent.Color = self:GetBaseSpriteColor()
				else
					self.Entity.SpriteRendererComponent.Color = color
				end
			end
			return
		end
		self.Entity.PolygonRendererComponent.Color = color
	end

	@ExecSpace("ServerOnly")
	method void SetMovementPaused(boolean paused)
		-- Stops native monster movement while the dummy is broken.
		if self.PauseMovementWhenBroken ~= true or self.Entity == nil then
			return
		end
		if self.Entity.AIWanderComponent ~= nil then
			self.Entity.AIWanderComponent.Enable = not paused
		end
		if self.Entity.AIChaseComponent ~= nil then
			self.Entity.AIChaseComponent.Enable = not paused
		end
		if paused == true then
			if self.Entity.MovementComponent ~= nil then
				self.Entity.MovementComponent:Stop()
			end
			if self.Entity.RigidbodyComponent ~= nil then
				self.Entity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			end
		end
	end

	method void CaptureBaseSpriteColor()
		-- Caches the sprite's original color so reset does not tint monsters gold.
		if self._T.baseSpriteColor ~= nil then
			return
		end
		if self.Entity ~= nil and self.Entity.SpriteRendererComponent ~= nil then
			self._T.baseSpriteColor = self.Entity.SpriteRendererComponent.Color
		else
			self._T.baseSpriteColor = Color(1, 1, 1, 1)
		end
	end

	method Color GetBaseSpriteColor()
		-- Returns the cached default sprite color.
		if self._T.baseSpriteColor == nil then
			self:CaptureBaseSpriteColor()
		end
		return self._T.baseSpriteColor
	end

	method boolean IsReadyDummyColor(Color color)
		-- Distinguishes the polygon-only ready tint from hit or broken feedback colors.
		if color == nil then
			return false
		end
		return math.abs(color.r - 0.87) < 0.01
			and math.abs(color.g - 0.68) < 0.01
			and math.abs(color.b - 0.32) < 0.01
	end

	@ExecSpace("ServerOnly")
	method void ClearTimers()
		-- Clears reset and flash timers.
		self:ClearFlashTimer()
		if self.resetTimerId ~= nil and self.resetTimerId > 0 then
			_TimerService:ClearTimer(self.resetTimerId)
		end
		self.resetTimerId = 0
	end

	@ExecSpace("ServerOnly")
	method void ClearFlashTimer()
		if self.flashTimerId ~= nil and self.flashTimerId > 0 then
			_TimerService:ClearTimer(self.flashTimerId)
		end
		self.flashTimerId = 0
	end

	method string GetMapName()
		if self.Entity ~= nil and self.Entity.CurrentMapName ~= nil then
			return self.Entity.CurrentMapName
		end
		return ""
	end

	method string GetUserId(Entity entity)
		if entity ~= nil and entity.PlayerComponent ~= nil then
			return self:ReadString(entity.PlayerComponent.UserId, "")
		end
		return ""
	end

	method number GetMaxHp()
		return math.max(1, math.floor(self:ReadNumber(self.MaxHp, 82)))
	end

	method number GetAuthoredDummyQuickKillMaxHp()
		-- Returns the HP target for authored non-boss training monsters.
		return math.max(1, math.floor(self:ReadNumber(self.AuthoredDummyQuickKillMaxHp, 82)))
	end

	method number GetResetDelaySeconds()
		return math.max(0, self:ReadNumber(self.ResetDelaySeconds, 3))
	end

	method number GetDamageFlashSeconds()
		return math.max(0.03, self:ReadNumber(self.DamageFlashSeconds, 0.12))
	end

	method boolean ShouldRespawnOnBreak()
		return self.RespawnOnBreak == true
	end

	method number GetBreakDestroyDelaySeconds()
		return math.max(0, self:ReadNumber(self.BreakDestroyDelaySeconds, 0.45))
	end

	method number GetSkillExperienceReward()
		-- Base CSV/authored exp reward scaled by ExperienceRewardMultiplier (1.25 = +25%).
		local base = self:ReadNumber(self.SkillExperienceReward, 100)
		local multiplier = math.max(0, self:ReadNumber(self.ExperienceRewardMultiplier, 1.25))
		return math.max(0, math.floor(base * multiplier))
	end

	method number GetMesoReward()
		return math.max(0, math.floor(self:ReadNumber(self.MesoReward, 4)))
	end

	method number GetHitDamage()
		return math.max(1, math.floor(self:ReadNumber(self.HitDamage, 1)))
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		if self.VerboseLog == true then
			log("[BRTrainingDummy] " .. message)
		end
	end

end
