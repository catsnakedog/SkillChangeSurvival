@Component
script TestMapGenerate extends Component

	property boolean GenerateOnBeginPlay = true

	property boolean EnablePortalRouting = true

	property number GridSize = 3

	property number CellWidth = 16

	property number CellHeight = 9

	property number CellGapX = 4

	property number CellGapY = 3

	property number OriginX = 0

	property number OriginY = 3

	property number PortalTouchThickness = 1.0

	property number PortalSpan = 3.0

	property number PortalExitInset = 2.0

	property number PortalCooldownSeconds = 0.8

	property number PortalPollSeconds = 0.05

	property boolean EnableCellCameraBounds = true

	property boolean UseFixedCellCameras = true

	property string CellCameraRootPath = "CellCameras"

	property number CameraBoundsPadding = 0

	property boolean LockCameraToCellCenter = true

	property number CellCameraCenterSlackX = 0.05

	property number CellCameraCenterSlackY = 0.05

	property boolean EnableCellCameraZoom = false

	property number CellCameraZoomRatio = 140

	property number CellCameraZoomDuration = 0

	property number GeneratedFootholdFixDelay = 0.15

	property boolean UsePreplacedRoomPool = true

	property string PreplacedRoomRootPath = "GeneratedRooms"

	property boolean UsePrefabTemplates = true

	property boolean HideTemplateRootOnBeginPlay = true

	property string RoomTemplateRootPath = "RoomTemplates"

	property string DefaultRoomTemplateName = "BaseRoom"

	property string RoomTemplateNames = ""

	property boolean RandomizeMapOnGenerate = true

	property number RandomSeed = 0

	property number ExtraPortalChance = 0.35

	property boolean RandomizeRoomTemplates = true

	property boolean RandomizeRoomPlatforms = true

	property number PlatformKeepChance = 0.72

	property boolean VerboseLog = true

	@Sync
	property number GeneratedCellCount = 0

	@Sync
	property number GeneratedPortalCount = 0

	@Sync
	property number LastRandomSeed = 0

	@Sync
	property string LastGeneratedSummary = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:ResetRuntime()
		if self.HideTemplateRootOnBeginPlay == true then
			self:HideTemplateRoot()
		end
		if self.GenerateOnBeginPlay == true then
			self:GenerateTestMap()
		end
		if self.EnablePortalRouting == true then
			self._T.portalTimerId = _TimerService:SetTimerRepeat(function() self:PollPlayerPortals() end, self:GetPortalPollSeconds(), 0)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self._T.portalTimerId ~= nil and self._T.portalTimerId > 0 then
			_TimerService:ClearTimer(self._T.portalTimerId)
		end
		self._T.portalTimerId = 0
		self:ClearGeneratedEntities()
	end

	@ExecSpace("ServerOnly")
	method void ResetRuntime()
		self._T.cells = {}
		self._T.cellById = {}
		self._T.generatedEntities = {}
		self._T.preplacedEntities = {}
		self._T.preplacedPoolById = {}
		self._T.nextPortalAt = {}
		self._T.lastCameraCellByUser = {}
		self._T.templateNames = nil
		self._T.missingTemplateLogged = false
		self._T.randomState = 0
		self._T.portalTimerId = 0
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Generate Test Grid")
	method void GenerateTestMap()
		self:ClearGeneratedEntities()
		self:HidePreplacedRoomPool()
		self._T.cells = {}
		self._T.cellById = {}
		self._T.nextPortalAt = {}
		self._T.lastCameraCellByUser = {}
		self:ResetRandom()
		
		local gridSize = self:GetGridSize()
		for row = 1, gridSize do
			for column = 1, gridSize do
				local cell = self:CreateCell(row, column, gridSize)
				table.insert(self._T.cells, cell)
				self._T.cellById[cell.Id] = cell
			end
		end
		
		local portalCount = 0
		if self.RandomizeMapOnGenerate == true then
			portalCount = self:CreateRandomPortalsForGrid(gridSize)
		else
			for index, cell in ipairs(self._T.cells) do
				portalCount = portalCount + self:CreatePortalsForCell(cell, gridSize)
			end
		end
		
		self:AssignRoomTemplates()
		for index, cell in ipairs(self._T.cells) do
			self:BuildCellRoom(cell)
		end
		
		self.GeneratedCellCount = #self._T.cells
		self.GeneratedPortalCount = portalCount
		self.LastGeneratedSummary = tostring(gridSize) .. "x" .. tostring(gridSize) .. " cells, portals=" .. tostring(portalCount) .. ", seed=" .. tostring(self.LastRandomSeed)
		self:Log("generated " .. self.LastGeneratedSummary .. " map=" .. self:GetMapName())
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Move Users To Grid Center")
	method void MoveCurrentUsersToGridCenter()
		local cell = self:GetCenterCell()
		if cell == nil then
			return
		end
		
		local users = _UserService:GetUsersByMapName(self:GetMapName())
		if users == nil then
			return
		end
		
		for index, playerEntity in ipairs(users) do
			self:MoveEntityTo(playerEntity, Vector2(cell.Center.x, cell.Center.y))
		end
		self:Log("moved current users to " .. cell.Id)
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Test Grid")
	method void DebugTestGrid()
		self:Log("debug map=" .. self:GetMapName() .. " summary=" .. self.LastGeneratedSummary .. " generatedEntities=" .. tostring(self:GetGeneratedEntityCount()))
	end

	method any CreateCell(number row, number column, number gridSize)
		local spacingX = self:GetCellSpacingX()
		local spacingY = self:GetCellSpacingY()
		local middle = (gridSize - 1) * 0.5
		local centerX = self:GetOriginX() + (column - 1 - middle) * spacingX
		local centerY = self:GetOriginY() + (middle - (row - 1)) * spacingY
		return {
			Id = self:GetCellId(row, column),
			Row = row,
			Column = column,
			Center = Vector2(centerX, centerY),
			Portals = {}
		}
	end

	method number CreatePortalsForCell(any cell, number gridSize)
		local count = 0
		if cell.Column < gridSize then
			if self:AddPortal(cell, "E", cell.Row, cell.Column + 1) == true then
				count = count + 1
			end
		end
		if cell.Column > 1 then
			if self:AddPortal(cell, "W", cell.Row, cell.Column - 1) == true then
				count = count + 1
			end
		end
		if cell.Row > 1 then
			if self:AddPortal(cell, "N", cell.Row - 1, cell.Column) == true then
				count = count + 1
			end
		end
		if cell.Row < gridSize then
			if self:AddPortal(cell, "S", cell.Row + 1, cell.Column) == true then
				count = count + 1
			end
		end
		return count
	end

	method number CreateRandomPortalsForGrid(number gridSize)
		local cells = self._T.cells
		if cells == nil or #cells == 0 then
			return 0
		end
		if #cells == 1 then
			return 0
		end
		
		local portalCount = 0
		local visited = {}
		local visitedCells = {}
		local startCell = cells[self:NextRandomIndex(#cells)]
		visited[startCell.Id] = true
		table.insert(visitedCells, startCell)
		
		while #visitedCells < #cells do
			local candidates = {}
			for index, candidate in ipairs(visitedCells) do
				local neighbors = self:GetUnvisitedNeighbors(candidate, gridSize, visited)
				if #neighbors > 0 then
					table.insert(candidates, {
						Cell = candidate,
						Neighbors = neighbors
					})
				end
			end
			if #candidates == 0 then
				break
			end
		
			local candidate = candidates[self:NextRandomIndex(#candidates)]
			local fromCell = candidate.Cell
			local neighbors = candidate.Neighbors
			local picked = neighbors[self:NextRandomIndex(#neighbors)]
			if self:AddPortalPair(fromCell, picked.Direction, picked.Cell) == true then
				portalCount = portalCount + 2
			end
			visited[picked.Cell.Id] = true
			table.insert(visitedCells, picked.Cell)
		end
		
		for index, cell in ipairs(cells) do
			local neighbors = self:GetNeighborInfos(cell, gridSize)
			for neighborIndex, neighbor in ipairs(neighbors) do
				if self:ShouldConsiderExtraPortal(cell, neighbor.Cell) == true and self:NextRandom01() <= self:GetExtraPortalChance() then
					if self:AddPortalPair(cell, neighbor.Direction, neighbor.Cell) == true then
						portalCount = portalCount + 2
					end
				end
			end
		end
		
		return portalCount
	end

	method any GetUnvisitedNeighbors(any cell, number gridSize, any visited)
		local result = {}
		local neighbors = self:GetNeighborInfos(cell, gridSize)
		for index, neighbor in ipairs(neighbors) do
			if visited[neighbor.Cell.Id] ~= true then
				table.insert(result, neighbor)
			end
		end
		return result
	end

	method any GetNeighborInfos(any cell, number gridSize)
		local neighbors = {}
		if cell == nil then
			return neighbors
		end
		
		self:AddNeighborInfo(neighbors, "N", cell.Row - 1, cell.Column, gridSize)
		self:AddNeighborInfo(neighbors, "S", cell.Row + 1, cell.Column, gridSize)
		self:AddNeighborInfo(neighbors, "W", cell.Row, cell.Column - 1, gridSize)
		self:AddNeighborInfo(neighbors, "E", cell.Row, cell.Column + 1, gridSize)
		return neighbors
	end

	method void AddNeighborInfo(any neighbors, string direction, number row, number column, number gridSize)
		if row < 1 or row > gridSize or column < 1 or column > gridSize then
			return
		end
		
		local cell = self._T.cellById[self:GetCellId(row, column)]
		if cell == nil then
			return
		end
		
		table.insert(neighbors, {
			Direction = direction,
			Cell = cell
		})
	end

	method boolean AddPortalPair(any fromCell, string direction, any toCell)
		if fromCell == nil or toCell == nil then
			return false
		end
		
		local addedForward = self:AddPortal(fromCell, direction, toCell.Row, toCell.Column)
		local addedBackward = self:AddPortal(toCell, self:GetOppositeDirection(direction), fromCell.Row, fromCell.Column)
		return addedForward == true or addedBackward == true
	end

	method boolean ShouldConsiderExtraPortal(any cell, any neighborCell)
		if cell == nil or neighborCell == nil then
			return false
		end
		if cell.Row > neighborCell.Row then
			return false
		end
		if cell.Row == neighborCell.Row and cell.Column > neighborCell.Column then
			return false
		end
		return true
	end

	method string GetOppositeDirection(string direction)
		if direction == "N" then
			return "S"
		elseif direction == "S" then
			return "N"
		elseif direction == "W" then
			return "E"
		end
		return "W"
	end

	method boolean AddPortal(any cell, string direction, number targetRow, number targetColumn)
		local targetCell = self._T.cellById[self:GetCellId(targetRow, targetColumn)]
		if targetCell == nil then
			return false
		end
		if cell.PortalDirections == nil then
			cell.PortalDirections = {}
		end
		if cell.PortalDirections[direction] == true then
			return false
		end
		
		local halfWidth = self:GetCellWidth() * 0.5
		local halfHeight = self:GetCellHeight() * 0.5
		local thickness = self:GetPortalTouchThickness()
		local span = self:GetPortalSpan()
		local exitInset = self:GetPortalExitInset()
		local bounds = nil
		local exitPosition = nil
		
		if direction == "E" then
			bounds = self:CreateBounds(cell.Center.x + halfWidth - thickness, cell.Center.x + halfWidth + thickness, cell.Center.y - span * 0.5, cell.Center.y + span * 0.5)
			exitPosition = Vector2(targetCell.Center.x - halfWidth + exitInset, targetCell.Center.y)
		elseif direction == "W" then
			bounds = self:CreateBounds(cell.Center.x - halfWidth - thickness, cell.Center.x - halfWidth + thickness, cell.Center.y - span * 0.5, cell.Center.y + span * 0.5)
			exitPosition = Vector2(targetCell.Center.x + halfWidth - exitInset, targetCell.Center.y)
		elseif direction == "N" then
			bounds = self:CreateBounds(cell.Center.x - span * 0.5, cell.Center.x + span * 0.5, cell.Center.y + halfHeight - thickness, cell.Center.y + halfHeight + thickness)
			exitPosition = Vector2(targetCell.Center.x, targetCell.Center.y - halfHeight + exitInset)
		elseif direction == "S" then
			bounds = self:CreateBounds(cell.Center.x - span * 0.5, cell.Center.x + span * 0.5, cell.Center.y - halfHeight - thickness, cell.Center.y - halfHeight + thickness)
			exitPosition = Vector2(targetCell.Center.x, targetCell.Center.y + halfHeight - exitInset)
		end
		
		if bounds == nil or exitPosition == nil then
			return false
		end
		
		table.insert(cell.Portals, {
			Direction = direction,
			TargetId = targetCell.Id,
			Bounds = bounds,
			ExitPosition = exitPosition
		})
		cell.PortalDirections[direction] = true
		return true
	end

	method any CreateBounds(number minX, number maxX, number minY, number maxY)
		return {
			MinX = math.min(minX, maxX),
			MaxX = math.max(minX, maxX),
			MinY = math.min(minY, maxY),
			MaxY = math.max(minY, maxY)
		}
	end

	@ExecSpace("ServerOnly")
	method void PollPlayerPortals()
		if self.EnablePortalRouting == false or self._T.cells == nil or #self._T.cells == 0 then
			return
		end
		
		local users = _UserService:GetUsersByMapName(self:GetMapName())
		if users == nil then
			return
		end
		
		for index, playerEntity in ipairs(users) do
			self:UpdatePlayerCameraBounds(playerEntity)
			self:RoutePlayerIfInPortal(playerEntity)
		end
	end

	@ExecSpace("ServerOnly")
	method void RoutePlayerIfInPortal(Entity playerEntity)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end
		
		local userId = playerEntity.PlayerComponent.UserId
		local now = self:Now()
		if self._T.nextPortalAt[userId] ~= nil and self._T.nextPortalAt[userId] > now then
			return
		end
		
		local position = self:GetEntityPosition2(playerEntity)
		local cell = self:FindCellByPosition(position)
		if cell == nil then
			return
		end
		
		local portal = self:FindPortalAtPosition(cell, position)
		if portal == nil then
			return
		end
		
		self._T.nextPortalAt[userId] = now + self:GetPortalCooldownSeconds()
		self:MoveEntityTo(playerEntity, portal.ExitPosition)
		self:ApplyCameraBounds(playerEntity, self._T.cellById[portal.TargetId], true)
		self:Log("portal user=" .. tostring(userId) .. " " .. cell.Id .. ":" .. portal.Direction .. " -> " .. portal.TargetId)
	end

	@ExecSpace("ServerOnly")
	method void UpdatePlayerCameraBounds(Entity playerEntity)
		if self.EnableCellCameraBounds == false or playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end
		
		local position = self:GetEntityPosition2(playerEntity)
		local cell = self:FindCellByPosition(position)
		if cell == nil then
			return
		end
		
		self:ApplyCameraBounds(playerEntity, cell, false)
	end

	@ExecSpace("ServerOnly")
	method void ApplyCameraBounds(Entity playerEntity, any cell, boolean force)
		if self.EnableCellCameraBounds == false or playerEntity == nil or cell == nil then
			return
		end
		
		local userId = self:GetPlayerUserId(playerEntity)
		if force == false and self._T.lastCameraCellByUser ~= nil and self._T.lastCameraCellByUser[userId] == cell.Id then
			return
		end
		
		if self.UseFixedCellCameras == true then
			local cameraEntity = self:GetCellCameraEntity(cell)
			if cameraEntity ~= nil and cameraEntity.CameraComponent ~= nil then
				_CameraService:SwitchCameraTo(cameraEntity.CameraComponent, userId)
				if self._T.lastCameraCellByUser == nil then
					self._T.lastCameraCellByUser = {}
				end
				self._T.lastCameraCellByUser[userId] = cell.Id
				return
			end
			self:Log("cell camera missing: " .. self:GetCellCameraPath(cell))
		end
		
		if playerEntity.CameraComponent == nil then
			return
		end
		
		local left = cell.Center.x
		local right = cell.Center.x
		local bottom = cell.Center.y
		local top = cell.Center.y
		if self.LockCameraToCellCenter == true then
			local slackX = self:GetCellCameraCenterSlackX()
			local slackY = self:GetCellCameraCenterSlackY()
			left = cell.Center.x - slackX
			right = cell.Center.x + slackX
			bottom = cell.Center.y - slackY
			top = cell.Center.y + slackY
		else
			local halfWidth = self:GetCellWidth() * 0.5
			local halfHeight = self:GetCellHeight() * 0.5
			local padding = self:GetCameraBoundsPadding()
			left = cell.Center.x - halfWidth + padding
			right = cell.Center.x + halfWidth - padding
			bottom = cell.Center.y - halfHeight + padding
			top = cell.Center.y + halfHeight - padding
		end
		
		playerEntity.CameraComponent.Enable = true
		playerEntity.CameraComponent.ConfineCameraArea = true
		playerEntity.CameraComponent.UseCustomBound = true
		playerEntity.CameraComponent.LeftBottom = Vector2(left, bottom)
		playerEntity.CameraComponent.RightTop = Vector2(right, top)
		if self.EnableCellCameraZoom == true then
			playerEntity.CameraComponent:SetZoomTo(self:GetCellCameraZoomRatio(), self:GetCellCameraZoomDuration(), userId)
		end
		
		if self._T.lastCameraCellByUser == nil then
			self._T.lastCameraCellByUser = {}
		end
		self._T.lastCameraCellByUser[userId] = cell.Id
	end

	method Entity GetCellCameraEntity(any cell)
		return _EntityService:GetEntityByPath(self:GetCellCameraPath(cell))
	end

	method string GetCellCameraPath(any cell)
		return self:ResolveMapChildPath(self:ReadString(self.CellCameraRootPath, "CellCameras") .. "/" .. cell.Id)
	end

	method any FindCellByPosition(Vector2 position)
		local halfWidth = self:GetCellWidth() * 0.5
		local halfHeight = self:GetCellHeight() * 0.5
		for index, cell in ipairs(self._T.cells) do
			if math.abs(position.x - cell.Center.x) <= halfWidth and math.abs(position.y - cell.Center.y) <= halfHeight then
				return cell
			end
		end
		return nil
	end

	method any FindPortalAtPosition(any cell, Vector2 position)
		if cell == nil or cell.Portals == nil then
			return nil
		end
		
		for index, portal in ipairs(cell.Portals) do
			if self:IsInsideBounds(position, portal.Bounds) == true then
				return portal
			end
		end
		return nil
	end

	method boolean IsInsideBounds(Vector2 position, any bounds)
		if bounds == nil then
			return false
		end
		return position.x >= bounds.MinX and position.x <= bounds.MaxX and position.y >= bounds.MinY and position.y <= bounds.MaxY
	end

	@ExecSpace("ServerOnly")
	method void BuildCellRoom(any cell)
		if cell == nil then
			return
		end
		
		if self.UsePreplacedRoomPool == true then
			self:UsePreplacedRoom(cell)
			return
		end
		
		self:SpawnCellPrefab(cell)
	end

	@ExecSpace("ServerOnly")
	method void UsePreplacedRoom(any cell)
		local room = nil
		if self._T.preplacedPoolById ~= nil then
			room = self._T.preplacedPoolById[cell.Id]
		end
		if room == nil then
			room = _EntityService:GetEntityByPath(self:GetPreplacedRoomPath(cell))
		end
		if room == nil then
			self:Log("preplaced room missing: " .. self:GetPreplacedRoomPath(cell))
			return
		end
		
		if room.TransformComponent ~= nil then
			room.TransformComponent.Position = Vector3(cell.Center.x, cell.Center.y, 999.998)
		end
		room:SetEnable(true)
		room:SetVisible(true)
		self:PrepareGeneratedRoom(room)
		self:ApplyPortalGuideVisibility(room, cell)
		self:ApplyPlatformVisibility(room, cell)
		table.insert(self._T.preplacedEntities, room)
	end

	@ExecSpace("ServerOnly")
	method void SpawnCellPrefab(any cell)
		if self.UsePrefabTemplates == false or cell == nil then
			return
		end
		
		local template = self:GetTemplateEntityForCell(cell)
		if template == nil then
			if self._T.missingTemplateLogged == false then
				self._T.missingTemplateLogged = true
				self:Log("room template missing: " .. self:GetTemplatePath(self:GetTemplateNameForCell(cell)))
			end
			return
		end
		
		local clone = template:Clone("GeneratedRoom_" .. cell.Id, false, true)
		if clone == nil then
			return
		end
		
		if self.Entity ~= nil and self.Entity.CurrentMap ~= nil then
			clone:AttachTo(self.Entity.CurrentMap)
		end
		if clone.TransformComponent ~= nil then
			clone.TransformComponent.Position = Vector3(cell.Center.x, cell.Center.y, 999.998)
		end
		clone.Enable = true
		clone.Visible = true
		self:PrepareGeneratedRoom(clone)
		self:ApplyPortalGuideVisibility(clone, cell)
		self:ApplyPlatformVisibility(clone, cell)
		_TimerService:SetTimerOnce(function() self:PrepareGeneratedRoom(clone) end, self:GetGeneratedFootholdFixDelay())
		table.insert(self._T.generatedEntities, clone)
	end

	@ExecSpace("ServerOnly")
	method void PrepareGeneratedRoom(Entity roomEntity)
		if roomEntity == nil then
			return
		end
		
		self:PrepareGeneratedFoothold(roomEntity.CustomFootholdComponent)
		local footholds = roomEntity:GetChildComponentsByTypeName("CustomFootholdComponent", true)
		if footholds == nil or #footholds == 0 then
			footholds = roomEntity:GetChildComponentsByTypeName("MOD.Core.CustomFootholdComponent", true)
		end
		if footholds == nil then
			self:Log("generated foothold components=0 room=" .. roomEntity.Name)
			return
		end
		
		for index, foothold in ipairs(footholds) do
			self:PrepareGeneratedFoothold(foothold)
		end
		self:Log("generated foothold components=" .. tostring(#footholds) .. " room=" .. roomEntity.Name)
	end

	method void ApplyPortalGuideVisibility(Entity roomEntity, any cell)
		if roomEntity == nil or cell == nil then
			return
		end
		
		self:SetPortalGuideVisible(roomEntity, "PortalGuideNorth", self:CellHasPortal(cell, "N"))
		self:SetPortalGuideVisible(roomEntity, "PortalGuideSouth", self:CellHasPortal(cell, "S"))
		self:SetPortalGuideVisible(roomEntity, "PortalGuideWest", self:CellHasPortal(cell, "W"))
		self:SetPortalGuideVisible(roomEntity, "PortalGuideEast", self:CellHasPortal(cell, "E"))
	end

	method void SetPortalGuideVisible(Entity roomEntity, string childName, boolean visible)
		local roomPath = self:ReadString(roomEntity.Path, "")
		if roomPath == "" then
			return
		end
		
		local guide = _EntityService:GetEntityByPath(roomPath .. "/" .. childName)
		if guide == nil then
			return
		end
		
		guide:SetEnable(visible)
		guide:SetVisible(visible)
	end

	method boolean CellHasPortal(any cell, string direction)
		if cell == nil or cell.PortalDirections == nil then
			return false
		end
		return cell.PortalDirections[direction] == true
	end

	method void ApplyPlatformVisibility(Entity roomEntity, any cell)
		if roomEntity == nil or cell == nil or cell.PlatformVisibility == nil then
			return
		end
		
		self:SetRoomChildVisible(roomEntity, "LeftPlatform", cell.PlatformVisibility["LeftPlatform"] == true)
		self:SetRoomChildVisible(roomEntity, "RightPlatform", cell.PlatformVisibility["RightPlatform"] == true)
		self:SetRoomChildVisible(roomEntity, "RightPlatform_1", cell.PlatformVisibility["RightPlatform_1"] == true)
	end

	method void SetRoomChildVisible(Entity roomEntity, string childName, boolean visible)
		local roomPath = self:ReadString(roomEntity.Path, "")
		if roomPath == "" then
			return
		end
		
		local child = _EntityService:GetEntityByPath(roomPath .. "/" .. childName)
		if child == nil then
			return
		end
		
		child:SetEnable(visible)
		child:SetVisible(visible)
	end

	@ExecSpace("ServerOnly")
	method void PrepareGeneratedFoothold(CustomFootholdComponent foothold)
		if foothold == nil then
			return
		end
		
		foothold.Enable = true
	end

	@ExecSpace("ServerOnly")
	method void ClearGeneratedEntities()
		if self._T.generatedEntities == nil then
			self._T.generatedEntities = {}
			return
		end
		
		for index, entity in ipairs(self._T.generatedEntities) do
			if entity ~= nil and _EntityService:IsValid(entity) == true then
				_EntityService:Destroy(entity)
			end
		end
		self._T.generatedEntities = {}
	end

	@ExecSpace("ServerOnly")
	method void HidePreplacedRoomPool()
		if self._T.preplacedEntities == nil then
			self._T.preplacedEntities = {}
		end
		self._T.preplacedPoolById = {}
		
		local root = _EntityService:GetEntityByPath(self:ResolveMapChildPath(self:ReadString(self.PreplacedRoomRootPath, "GeneratedRooms")))
		if root == nil then
			return
		end
		
		for index, room in ipairs(root.Children) do
			if room ~= nil then
				self._T.preplacedPoolById[room.Name] = room
				room:SetEnable(false)
				room:SetVisible(false)
			end
		end
		self._T.preplacedEntities = {}
	end

	method Entity GetTemplateEntityForCell(any cell)
		return _EntityService:GetEntityByPath(self:GetTemplatePath(self:GetTemplateNameForCell(cell)))
	end

	method void AssignRoomTemplates()
		local names = self:GetTemplateNames()
		for index, cell in ipairs(self._T.cells) do
			if self.RandomizeRoomTemplates == true and names ~= nil and #names > 0 then
				cell.TemplateName = names[self:NextRandomIndex(#names)]
			else
				cell.TemplateName = self:ReadString(self.DefaultRoomTemplateName, "BaseRoom")
			end
			self:AssignRoomPlatforms(cell)
		end
	end

	method void AssignRoomPlatforms(any cell)
		if cell == nil then
			return
		end
		
		cell.PlatformVisibility = {}
		local platformNames = {"LeftPlatform", "RightPlatform", "RightPlatform_1"}
		local visibleCount = 0
		for index, platformName in ipairs(platformNames) do
			local visible = true
			if self.RandomizeRoomPlatforms == true then
				visible = self:NextRandom01() <= self:GetPlatformKeepChance()
			end
			cell.PlatformVisibility[platformName] = visible
			if visible == true then
				visibleCount = visibleCount + 1
			end
		end
		
		if visibleCount == 0 then
			cell.PlatformVisibility[platformNames[self:NextRandomIndex(#platformNames)]] = true
		end
	end

	method string GetTemplateNameForCell(any cell)
		if cell ~= nil and cell.TemplateName ~= nil and cell.TemplateName ~= "" then
			return cell.TemplateName
		end
		
		local names = self:GetTemplateNames()
		if names ~= nil and #names > 0 and cell ~= nil then
			local index = ((cell.Row - 1) * self:GetGridSize() + cell.Column - 1) % #names + 1
			return names[index]
		end
		return self:ReadString(self.DefaultRoomTemplateName, "BaseRoom")
	end

	method any GetTemplateNames()
		if self._T.templateNames ~= nil then
			return self._T.templateNames
		end
		
		self._T.templateNames = {}
		local names = self:ReadString(self.RoomTemplateNames, "")
		for name in string.gmatch(names, "[^,]+") do
			local cleanName = self:Trim(name)
			if cleanName ~= "" then
				table.insert(self._T.templateNames, cleanName)
			end
		end
		return self._T.templateNames
	end

	method string GetTemplatePath(string templateName)
		local rootPath = self:ResolveTemplateRootPath()
		if string.sub(rootPath, string.len(rootPath), string.len(rootPath)) == "/" then
			return rootPath .. templateName
		end
		return rootPath .. "/" .. templateName
	end

	method string GetPreplacedRoomPath(any cell)
		return self:ResolveMapChildPath(self:ReadString(self.PreplacedRoomRootPath, "GeneratedRooms") .. "/" .. cell.Id)
	end

	method string ResolveMapChildPath(string relativePath)
		if string.sub(relativePath, 1, 1) == "/" then
			return relativePath
		end
		return "/maps/" .. self:GetMapName() .. "/" .. relativePath
	end

	method string ResolveTemplateRootPath()
		local rootPath = self:ReadString(self.RoomTemplateRootPath, "RoomTemplates")
		if string.sub(rootPath, 1, 1) == "/" then
			return rootPath
		end
		return self:ResolveMapChildPath(rootPath)
	end

	@ExecSpace("ServerOnly")
	method void HideTemplateRoot()
		local root = _EntityService:GetEntityByPath(self:ResolveTemplateRootPath())
		if root ~= nil then
			root:SetVisible(false)
		end
	end

	method any GetCenterCell()
		if self._T.cells == nil or #self._T.cells == 0 then
			return nil
		end
		
		local centerIndex = math.floor((#self._T.cells + 1) * 0.5)
		return self._T.cells[centerIndex]
	end

	method void MoveEntityTo(Entity entity, Vector2 position)
		if entity == nil then
			return
		end
		
		if entity.RigidbodyComponent ~= nil then
			entity.RigidbodyComponent:SetWorldPosition(position)
			entity.RigidbodyComponent:PositionReset()
		elseif entity.MovementComponent ~= nil then
			entity.MovementComponent:SetWorldPosition(position)
		elseif entity.PlayerComponent ~= nil then
			entity.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		elseif entity.TransformComponent ~= nil then
			entity.TransformComponent.Position = Vector3(position.x, position.y, entity.TransformComponent.Position.z)
		end
	end

	method Vector2 GetEntityPosition2(Entity entity)
		if entity == nil or entity.TransformComponent == nil then
			return Vector2(0, 0)
		end
		
		local position = entity.TransformComponent.WorldPosition
		return Vector2(position.x, position.y)
	end

	method string GetMapName()
		if self.Entity ~= nil and self.Entity.CurrentMapName ~= nil and self.Entity.CurrentMapName ~= "" then
			return self.Entity.CurrentMapName
		end
		return "RoomTestMap"
	end

	method string GetCellId(number row, number column)
		return "r" .. tostring(math.floor(row)) .. "c" .. tostring(math.floor(column))
	end

	method void ResetRandom()
		local seed = math.floor(self:ReadNumber(self.RandomSeed, 0))
		if seed <= 0 then
			seed = self:HashString(self:GetMapName() .. ":" .. tostring(math.floor(self:Now() * 1000)))
		end
		if seed <= 0 then
			seed = 1
		end
		
		self._T.randomState = seed % 2147483647
		if self._T.randomState <= 0 then
			self._T.randomState = 1
		end
		self.LastRandomSeed = self._T.randomState
	end

	method number HashString(string value)
		local text = self:ReadString(value, "")
		local hash = 0
		for index = 1, string.len(text) do
			hash = (hash * 31 + string.byte(text, index)) % 2147483647
		end
		return hash
	end

	method number NextRandom01()
		if self._T.randomState == nil or self._T.randomState <= 0 then
			self:ResetRandom()
		end
		
		self._T.randomState = (self._T.randomState * 48271) % 2147483647
		return self._T.randomState / 2147483647
	end

	method number NextRandomIndex(number count)
		local safeCount = math.max(1, math.floor(self:ReadNumber(count, 1)))
		local index = math.floor(self:NextRandom01() * safeCount) + 1
		if index > safeCount then
			return safeCount
		end
		return index
	end

	method number GetGridSize()
		return math.max(1, math.floor(self:ReadNumber(self.GridSize, 3)))
	end

	method number GetCellWidth()
		return math.max(2, self:ReadNumber(self.CellWidth, 16))
	end

	method number GetCellHeight()
		return math.max(2, self:ReadNumber(self.CellHeight, 9))
	end

	method number GetCellSpacingX()
		return self:GetCellWidth() + math.max(0, self:ReadNumber(self.CellGapX, 4))
	end

	method number GetCellSpacingY()
		return self:GetCellHeight() + math.max(0, self:ReadNumber(self.CellGapY, 3))
	end

	method number GetOriginX()
		return self:ReadNumber(self.OriginX, 0)
	end

	method number GetOriginY()
		return self:ReadNumber(self.OriginY, 3)
	end

	method number GetPortalTouchThickness()
		return math.max(0.1, self:ReadNumber(self.PortalTouchThickness, 1.0))
	end

	method number GetPortalSpan()
		return math.max(0.5, self:ReadNumber(self.PortalSpan, 3.0))
	end

	method number GetPortalExitInset()
		return math.max(0.1, self:ReadNumber(self.PortalExitInset, 2.0))
	end

	method number GetPortalCooldownSeconds()
		return math.max(0.1, self:ReadNumber(self.PortalCooldownSeconds, 0.8))
	end

	method number GetExtraPortalChance()
		return math.max(0, math.min(1, self:ReadNumber(self.ExtraPortalChance, 0.35)))
	end

	method number GetPlatformKeepChance()
		return math.max(0, math.min(1, self:ReadNumber(self.PlatformKeepChance, 0.72)))
	end

	method number GetPortalPollSeconds()
		return math.max(0.033, self:ReadNumber(self.PortalPollSeconds, 0.05))
	end

	method number GetCameraBoundsPadding()
		local maxPadding = math.min(self:GetCellWidth(), self:GetCellHeight()) * 0.45
		return math.max(0, math.min(maxPadding, self:ReadNumber(self.CameraBoundsPadding, 0)))
	end

	method number GetCellCameraCenterSlackX()
		return math.max(0, self:ReadNumber(self.CellCameraCenterSlackX, 0.05))
	end

	method number GetCellCameraCenterSlackY()
		return math.max(0, self:ReadNumber(self.CellCameraCenterSlackY, 0.05))
	end

	method number GetCellCameraZoomRatio()
		return math.max(30, math.min(500, self:ReadNumber(self.CellCameraZoomRatio, 140)))
	end

	method number GetCellCameraZoomDuration()
		return math.max(0, self:ReadNumber(self.CellCameraZoomDuration, 0))
	end

	method number GetGeneratedFootholdFixDelay()
		return math.max(0, self:ReadNumber(self.GeneratedFootholdFixDelay, 0.15))
	end

	method string GetPlayerUserId(Entity playerEntity)
		if playerEntity ~= nil and playerEntity.PlayerComponent ~= nil then
			return self:ReadString(playerEntity.PlayerComponent.UserId, "")
		end
		return ""
	end

	method number GetGeneratedEntityCount()
		if self._T.generatedEntities == nil then
			return 0
		end
		return #self._T.generatedEntities
	end

	method string Trim(string value)
		if value == nil then
			return ""
		end
		return string.gsub(value, "^%s*(.-)%s*$", "%1")
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method number Now()
		return _UtilLogic.ElapsedSeconds
	end

	method void Log(string message)
		if self.VerboseLog == true then
			log("[TestMapGenerate] " .. message)
		end
	end

end