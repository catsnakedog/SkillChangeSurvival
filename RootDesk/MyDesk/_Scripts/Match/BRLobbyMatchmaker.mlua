@Component
script BRLobbyMatchmaker extends Component

	property boolean EnableLobbyMatchmaker = true

	property number TargetPlayerCount = 3

	property number QueuePollSeconds = 1

	property number HeartbeatSeconds = 10

	property number TicketTtlSeconds = 45

	property number MaxQueueUpdateRetries = 5

	property number MaxActiveMatches = 3

	property number MatchRoomTtlSeconds = 600

	property string MatchMode = "SoloBattleRoyale"

	property boolean UseGlobalMatchQueue = true

	property string GlobalQueueStorageName = "SkillChangeSurvivalMatchmaking"

	property string GlobalQueueKey = "br_match_queue"

	property string LobbyMapName = "StartMap"

	property boolean RequireUserOnLobbyMapForQueue = true

	property boolean VerboseDebugLog = true

	property number DebugLogIntervalSeconds = 5

	property string GatherMapName = "RoomTestMap"

	property number RoomGraphColumns = 3

	property number RoomGraphRows = 3

	property number RoomGraphMapPartCount = 9

	property number RoomGraphExtraConnectionChancePercent = 0

	property number GatherCenterX = 0

	property number GatherCenterY = 3

	property number GatherSpacingX = 1.5

	property number GatherSpacingY = 0.8

	property number GatherColumns = 8

	property number MatchLoadingSeconds = 3

	@Sync
	property string MatchmakingPhase = "Idle"

	@Sync
	property number QueueCount = 0

	@Sync
	property number TotalQueueCount = 0

	@Sync
	property number GatheredCount = 0

	@Sync
	property string LastGatherId = ""

	@Sync
	property string LastTargetMapName = ""

	@Sync
	property number ActiveMatchCount = 0

	@Sync
	property string LastError = ""

	@Sync
	property string CurrentWorldInstanceId = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		if self:IsLobbyMapEntity() == false then
			self:DisableOutsideLobby()
			return
		end
		
		self:ResetRuntime()
		self:StartPollTimer()
	end

	method void DisableOutsideLobby()
		self.EnableLobbyMatchmaker = false
		self._T.disabledOutsideLobby = true
	end

	@ExecSpace("ServerOnly")
	method void ResetRuntime()
		local now = self:Now()
		self._T.queue = _BRMatchQueue:CreateEmptyQueue(now)
		self._T.roomQueue = _BRMatchRoomQueue:CreateEmptyRoomQueue(now)
		self._T.localTickets = {}
		self._T.pollTimerId = 0
		self._T.lastHeartbeatAt = 0
		self._T.lastDebugLogAt = 0
		self._T.matches = {}
		self._T.dynamicMaps = {}
		self._T.runtimeReady = true
		self.MatchmakingPhase = "Idle"
		self.QueueCount = 0
		self.TotalQueueCount = 0
		self.GatheredCount = 0
		self.LastGatherId = ""
		self.LastTargetMapName = ""
		self.ActiveMatchCount = 0
		self.LastError = ""
		self.CurrentWorldInstanceId = self:GetCurrentWorldInstanceId()
		log("[BRLobby] begin backend=" .. self:GetQueueBackendName() .. " groupSize=" .. tostring(self:GetTargetCount()) .. " ttl=" .. tostring(self:GetTicketTtlSeconds()) .. " heartbeat=" .. tostring(self:GetHeartbeatSeconds()) .. " instance=" .. self.CurrentWorldInstanceId)
	end

	@ExecSpace("ServerOnly")
	method void EnsureRuntimeStarted()
		if self._T.disabledOutsideLobby == true then
			return
		end
		if self:IsLobbyMapEntity() == false then
			self:DisableOutsideLobby()
			return
		end
		if self._T.runtimeReady == true then
			return
		end
		
		log("[BRLobby] runtime was not ready. initializing now.")
		self:ResetRuntime()
		self:StartPollTimer()
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Cancel Current Users")
	method void CancelCurrentUsers()
		self:EnsureRuntimeStarted()
		for userId, entity in pairs(_UserService.UserEntities) do
			self:CancelQueue(userId)
		end
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Clear Active Matches")
	method void ClearActiveMatches()
		self:EnsureRuntimeStarted()
		self:EnsureRoomQueue()
		self._T.roomQueue = _BRMatchRoomQueue:CreateEmptyRoomQueue(self:Now())
		
		if self._T.activeMaps == nil then
			self._T.activeMaps = {}
		end
		
		self._T.matches = {}
		self._T.activeMaps = {}
		self.ActiveMatchCount = 0
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Cleanup Ended Matches")
	method void CleanupEndedMatches()
		self:EnsureRuntimeStarted()
		self:EnsureRoomQueue()
		
		for index = #self._T.roomQueue.Rooms, 1, -1 do
			local room = self._T.roomQueue.Rooms[index]
			if _BRMatchRoomQueue:IsFinishedState(room.State) == true then
				table.remove(self._T.roomQueue.Rooms, index)
			end
		end
		
		self:UpdateActiveMatchCount()
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Reset Global Queue")
	method void ResetGlobalQueue()
		self:EnsureRuntimeStarted()
		if _BRMatchQueueStore:ResetGlobalQueue(self) == true then
			self._T.localTickets = {}
			self.QueueCount = 0
			self.TotalQueueCount = 0
			self.MatchmakingPhase = "Idle"
			self.LastError = ""
			log("[BRLobby] global queue reset: key=" .. self:GetGlobalQueueKey())
			return
		end
		
		log("[BRLobby] global queue reset failed: key=" .. self:GetGlobalQueueKey() .. " error=" .. self.LastError)
	end

	@ExecSpace("ServerOnly")
	@InspectorButton("Debug Matchmaker")
	method void DebugMatchmaker()
		self:EnsureRuntimeStarted()
		local snapshot = self:ReadQueueSnapshot()
		if snapshot == nil then
			log("[BRLobby] debug failed: queue unavailable")
			return
		end
		
		local queue = snapshot.State
		_BRMatchQueue:NormalizeQueue(queue)
		self:UpdateQueueCounts(queue)
		self.CurrentWorldInstanceId = self:GetCurrentWorldInstanceId()
		log("[BRLobby] debug backend=" .. self:GetQueueBackendName() .. " localQueue=" .. tostring(self.QueueCount) .. " totalQueue=" .. tostring(self.TotalQueueCount) .. " groupSize=" .. tostring(self:GetTargetCount()) .. " instance=" .. self.CurrentWorldInstanceId .. " phase=" .. self.MatchmakingPhase .. " lastError=" .. self.LastError)
	end

	@ExecSpace("ServerOnly")
	method void StartPollTimer()
		if self.EnableLobbyMatchmaker == false then
			log("[BRLobby] poll timer skipped: disabled")
			return
		end
		if self._T.pollTimerId ~= nil and self._T.pollTimerId > 0 then
			log("[BRLobby] poll timer already running id=" .. tostring(self._T.pollTimerId))
			return
		end
		
		local tick = function()
			self:OnMatchmakerTick()
		end
		
		self._T.pollTimerId = _TimerService:SetTimerRepeat(tick, math.max(0.2, self.QueuePollSeconds))
		log("[BRLobby] poll timer started id=" .. tostring(self._T.pollTimerId) .. " interval=" .. tostring(math.max(0.2, self.QueuePollSeconds)))
	end

	@ExecSpace("ServerOnly")
	method void OnMatchmakerTick()
		self:EnsureRuntimeStarted()
		if self.EnableLobbyMatchmaker == false then
			return
		end
		
		self:CleanExpiredMatchRooms()
		self:RefreshLocalTicketHeartbeats()
		self:LogPeriodicStatus()
	end

	@ExecSpace("ServerOnly")
	method boolean JoinQueue(string userId, string profileCode)
		self:EnsureRuntimeStarted()
		if userId == nil or userId == "" then
			return false
		end
		if self.RequireUserOnLobbyMapForQueue == true and self:IsUserInLobbyMap(userId) == false then
			log("[BRLobby] queue skipped outside lobby: user=" .. tostring(userId) .. " lobby=" .. self:ReadString(self.LobbyMapName, "StartMap"))
			return false
		end
		
		local now = self:Now()
		local ticket = _BRMatchQueue:CreateTicket(userId, profileCode, self:GetCurrentWorldInstanceId(), now, self:GetTicketTtlSeconds())
		
		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return false
			end
		
			local queue = snapshot.State
			_BRMatchQueue:NormalizeQueue(queue)
			_BRMatchQueue:RemoveTicket(queue, userId, "")
			table.insert(queue.Tickets, ticket)
			queue.UpdatedAt = now
		
			if self:CommitQueueAndUpdate(snapshot, queue) == true then
				self._T.localTickets[userId] = ticket.TicketId
				self.MatchmakingPhase = "Queued"
				self:SetLobbyName(userId, self.QueueCount)
				self:ShowToast(self:GetMatchingLabel(self.QueueCount))
				log("[BRLobby] queued " .. userId .. " ticket=" .. ticket.TicketId .. " backend=" .. self:GetQueueBackendName() .. " localQueue=" .. tostring(self.QueueCount) .. " totalQueue=" .. tostring(self.TotalQueueCount) .. " instance=" .. self.CurrentWorldInstanceId)
				return true
			end
		end
		
		log("[BRLobby] failed to join queue: " .. userId)
		return false
	end

	@ExecSpace("Server")
	method void RequestJoinQueue(string userId)
		self:EnsureRuntimeStarted()
		if self.EnableLobbyMatchmaker == false then
			log("[BRLobby] button join ignored: disabled user=" .. tostring(userId))
			return
		end
		if userId == nil or userId == "" then
			log("[BRLobby] button join ignored: empty user")
			return
		end
		
		local playerEntity = _UserService:GetUserEntityByUserId(userId)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			log("[BRLobby] button join ignored: missing player user=" .. tostring(userId))
			return
		end
		
		if self:IsUserQueuedLocally(userId) == true then
			log("[BRLobby] button join ignored: already queued user=" .. tostring(userId))
			return
		end
		
		if self:JoinQueue(userId, playerEntity.PlayerComponent.ProfileCode) == true then
			self:TryMakeMatch()
		end
	end

	@ExecSpace("Server")
	method void RequestCancelQueue(string userId)
		self:EnsureRuntimeStarted()
		if self.EnableLobbyMatchmaker == false then
			log("[BRLobby] button cancel ignored: disabled user=" .. tostring(userId))
			return
		end
		if userId == nil or userId == "" then
			log("[BRLobby] button cancel ignored: empty user")
			return
		end
		
		self:CancelQueue(userId)
	end

	@ExecSpace("ServerOnly")
	method boolean CancelQueue(string userId)
		self:EnsureRuntimeStarted()
		if userId == nil or userId == "" then
			return false
		end
		
		local localTicketId = self._T.localTickets[userId]
		if localTicketId == nil or localTicketId == "" then
			return true
		end
		
		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return false
			end
		
			local queue = snapshot.State
			_BRMatchQueue:NormalizeQueue(queue)
			local removed = _BRMatchQueue:RemoveTicket(queue, userId, localTicketId)
			queue.UpdatedAt = self:Now()
		
			if removed == false then
				self._T.localTickets[userId] = nil
				self:UpdateQueueCounts(queue)
				return true
			end
		
			if self:CommitQueueAndUpdate(snapshot, queue) == true then
				self._T.localTickets[userId] = nil
				self.MatchmakingPhase = "Canceled"
				self:ShowToast("Matchmaking canceled.")
				log("[BRLobby] canceled " .. userId)
				return true
			end
		end
		
		log("[BRLobby] failed to cancel queue: " .. userId)
		return false
	end

	@ExecSpace("ServerOnly")
	method void RefreshLocalTicketHeartbeats()
		self:EnsureRuntimeStarted()
		if self:HasLocalTickets() == false then
			return
		end
		
		local now = self:Now()
		if self._T.lastHeartbeatAt ~= nil and now - self._T.lastHeartbeatAt < self:GetHeartbeatSeconds() then
			return
		end
		self._T.lastHeartbeatAt = now
		
		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return
			end
		
			local queue = snapshot.State
			_BRMatchQueue:NormalizeQueue(queue)
			local beforeCleanCount = #queue.Tickets
			local changed = _BRMatchQueue:RefreshLocalTickets(queue, self._T.localTickets, self:GetCurrentWorldInstanceId(), now, self:GetTicketTtlSeconds())
		
			if _BRMatchQueue:CleanExpiredTickets(queue, now) == true then
				changed = true
				log("[BRLobby] expired tickets removed during heartbeat: before=" .. tostring(beforeCleanCount) .. " after=" .. tostring(#queue.Tickets) .. " now=" .. tostring(now) .. " ttl=" .. tostring(self:GetTicketTtlSeconds()))
			end
			queue.UpdatedAt = now
		
			if changed == false then
				self:UpdateQueueCounts(queue)
				return
			end
			if self:CommitQueueAndUpdate(snapshot, queue) == true then
				return
			end
		end
	end

	@ExecSpace("ServerOnly")
	method boolean TryMakeMatch()
		self:EnsureRuntimeStarted()
		if self.EnableLobbyMatchmaker == false then
			return false
		end
		
		self:CleanExpiredMatchRooms()
		return self:TryMakeSingleMatch()
	end

	@ExecSpace("ServerOnly")
	method boolean TryMakeSingleMatch()
		if self:CanCreateMoreMatches() == false then
			local activeCount = _BRMatchRoomQueue:GetActiveRoomCount(self._T.roomQueue)
			self.ActiveMatchCount = activeCount
			self.MatchmakingPhase = "Match capacity full " .. tostring(activeCount) .. "/" .. tostring(self.MaxActiveMatches)
			return false
		end
		
		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return false
			end
		
			local queue = snapshot.State
			_BRMatchQueue:NormalizeQueue(queue)
			local beforeCleanCount = #queue.Tickets
			local queueChanged = _BRMatchQueue:CleanExpiredTickets(queue, self:Now())
			if queueChanged == true then
				log("[BRLobby] expired tickets removed during match check: before=" .. tostring(beforeCleanCount) .. " after=" .. tostring(#queue.Tickets) .. " now=" .. tostring(self:Now()) .. " ttl=" .. tostring(self:GetTicketTtlSeconds()))
			end
			self:UpdateQueueCounts(queue)
		
			if self:CanStartWithQueue(queue) == false then
				self:UpdateWaitingPhase(queue)
				if queueChanged == true then
					self:CommitQueueSnapshot(snapshot)
				end
				return false
			end
		
			local selectedTickets = _BRMatchQueue:TakeLocalTickets(queue, self:GetTargetCount(), self:GetCurrentWorldInstanceId())
			if #selectedTickets == 0 then
				return false
			end
		
			queue.UpdatedAt = self:Now()
			if self:CommitQueueAndUpdate(snapshot, queue) == true then
				self:GatherTickets(selectedTickets)
				return true
			end
		end
		
		return false
	end

	method boolean CanStartWithQueue(any queue)
		local queuedCount = _BRMatchQueue:GetLocalTicketCount(queue, self:GetCurrentWorldInstanceId())
		return queuedCount >= self:GetTargetCount()
	end

	method void UpdateWaitingPhase(any queue)
		local queuedCount = _BRMatchQueue:GetLocalTicketCount(queue, self:GetCurrentWorldInstanceId())
		self.MatchmakingPhase = "Waiting local " .. tostring(queuedCount) .. "/" .. tostring(self:GetTargetCount()) .. " total " .. tostring(_BRMatchQueue:GetTotalTicketCount(queue))
	end

	@ExecSpace("ServerOnly")
	method void GatherTickets(any tickets)
		self:StartMatchFromTickets(tickets)
	end

	@ExecSpace("ServerOnly")
	method void StartMatchFromTickets(any tickets)
		local players = self:TakeTicketUsers(tickets)
		if self:AreAllPlayersInThisServer(players) == false then
			self.MatchmakingPhase = "UsersMissing"
			self:RestoreTickets(tickets)
			log("[BRLobby] gather canceled because selected users are not in this server.")
			return
		end
		
		self:EnsureRoomQueue()
		local now = self:Now()
		local matchRoom = _BRMatchRoomQueue:CreateMatchRoom(tickets, self.MatchMode, self.GatherMapName, "", self:GetCurrentWorldInstanceId(), self:GetTargetCount(), now, self:GetMatchRoomTtlSeconds())
		if _BRMatchRoomQueue:AddRoom(self._T.roomQueue, matchRoom) == false then
			self.MatchmakingPhase = "RoomAddFailed"
			self:RestoreTickets(tickets)
			log("[BRLobby] match room add failed: " .. tostring(matchRoom.MatchId))
			return
		end
		
		self:UpdateActiveMatchCount()
		_BRMatchRoomQueue:UpdateRoomState(self._T.roomQueue, matchRoom.MatchId, "Moving", now)
		local launchResult = _BRBattleLauncher:StartMatchRoom(matchRoom, self)
		if launchResult.Success == false then
			self:FailMatchRoom(matchRoom, tickets, launchResult, "LaunchFailed")
			return
		end
		
		_BRMatchRoomQueue:SetRoomTargetMap(self._T.roomQueue, matchRoom.MatchId, launchResult.TargetMapName)
		if launchResult.MovedCount < self:GetTargetCount() then
			_BRBattleLauncher:ReturnPlayersToLobby(matchRoom, self)
			self:FailMatchRoom(matchRoom, tickets, launchResult, "MoveFailed")
			return
		end
		
		_BRMatchRoomQueue:UpdateRoomState(self._T.roomQueue, matchRoom.MatchId, "Gathered", self:Now())
		self:SaveActiveMatch(matchRoom.MatchId, launchResult.TargetMapName, players)
		self.LastGatherId = matchRoom.MatchId
		self.LastTargetMapName = launchResult.TargetMapName
		self.GatheredCount = launchResult.MovedCount
		self.MatchmakingPhase = "Gathered"
		self:UpdateActiveMatchCount()
		self:ShowToast("Gathered " .. tostring(self.GatheredCount) .. " players.")
		log("[BRLobby] gathered " .. matchRoom.MatchId .. " map=" .. launchResult.TargetMapName .. " players=" .. tostring(self.GatheredCount) .. " activeMatches=" .. tostring(self.ActiveMatchCount))
	end

	@ExecSpace("ServerOnly")
	method void FailMatchRoom(any matchRoom, any tickets, any launchResult, string phase)
		local errorMessage = self:ReadString(launchResult.Error, phase)
		_BRMatchRoomQueue:UpdateRoomState(self._T.roomQueue, matchRoom.MatchId, "Failed", self:Now())
		self:RestoreTickets(tickets)
		self:UpdateActiveMatchCount()
		self.MatchmakingPhase = phase
		self.LastError = errorMessage
		log("[BRLobby] match room failed: " .. tostring(matchRoom.MatchId) .. " phase=" .. phase .. " error=" .. errorMessage)
	end

	method any TakeTicketUsers(any tickets)
		local players = {}
		for index, ticket in ipairs(tickets) do
			table.insert(players, ticket.UserId)
			self._T.localTickets[ticket.UserId] = nil
		end
		return players
	end

	method void SaveActiveMatch(string gatherId, string mapName, any players)
		if self._T.matches == nil then
			self._T.matches = {}
		end
		if self._T.activeMaps == nil then
			self._T.activeMaps = {}
		end
		
		self._T.matches[gatherId] = {
			Id = gatherId,
			MapName = mapName,
			Players = players,
			StartedAt = self:Now()
		}
		self._T.activeMaps[mapName] = true
		self.ActiveMatchCount = self:GetActiveMatchCount()
	end

	@ExecSpace("ServerOnly")
	method void MarkMatchPlaying(any matchRoom)
		-- Marks a gathered match as actively playing after its loading gate opens.
		self:EnsureRuntimeStarted()
		self:EnsureRoomQueue()
		if matchRoom == nil then
			return
		end

		local matchId = self:ReadString(matchRoom.MatchId, "")
		if matchId == "" then
			return
		end
		_BRMatchRoomQueue:UpdateRoomState(self._T.roomQueue, matchId, "Playing", self:Now())
		self.MatchmakingPhase = "Playing"
		self:UpdateActiveMatchCount()
		log("[BRLobby] match playing id=" .. matchId .. " activeMatches=" .. tostring(self.ActiveMatchCount))
	end

	@ExecSpace("ServerOnly")
	method void CompleteMatch(any matchRoom, string winnerUserId, string reason)
		-- Marks a playing match as ended and releases matchmaker capacity.
		self:EnsureRuntimeStarted()
		self:EnsureRoomQueue()
		if matchRoom == nil then
			return
		end

		local matchId = self:ReadString(matchRoom.MatchId, "")
		local targetMapName = self:ReadString(matchRoom.TargetMapName, "")
		if matchId ~= "" then
			_BRMatchRoomQueue:UpdateRoomState(self._T.roomQueue, matchId, "Ended", self:Now())
			if self._T.matches ~= nil then
				self._T.matches[matchId] = nil
			end
		end
		if targetMapName ~= "" and self._T.activeMaps ~= nil then
			self._T.activeMaps[targetMapName] = nil
		end

		self.MatchmakingPhase = "Ended"
		self.LastGatherId = matchId
		self.LastTargetMapName = targetMapName
		self.LastError = ""
		self:UpdateActiveMatchCount()
		log("[BRLobby] match completed id=" .. matchId .. " winner=" .. self:ReadString(winnerUserId, "") .. " reason=" .. self:ReadString(reason, "") .. " activeMatches=" .. tostring(self.ActiveMatchCount))
	end

	@ExecSpace("ServerOnly")
	method void CleanupMatchRoom(string matchId)
		self:EnsureRoomQueue()
		local room = _BRMatchRoomQueue:GetRoom(self._T.roomQueue, matchId)
		if room ~= nil then
			_BRMatchRoomQueue:RemoveRoom(self._T.roomQueue, matchId)
		end
		self:UpdateActiveMatchCount()
	end

	@ExecSpace("ServerOnly")
	method void CleanExpiredMatchRooms()
		self:EnsureRoomQueue()
		local now = self:Now()
		local expiredRooms = {}
		for index, room in ipairs(self._T.roomQueue.Rooms) do
			if _BRMatchRoomQueue:IsActiveState(room.State) == true and self:ReadNumber(room.ExpiresAt, now + 1) <= now then
				table.insert(expiredRooms, room)
			end
		end
		
		if _BRMatchRoomQueue:CleanExpiredRooms(self._T.roomQueue, now) == true then
			for index, room in ipairs(expiredRooms) do
				_BRBattleLauncher:ReturnPlayersToLobby(room, self)
			end
			self:UpdateActiveMatchCount()
		end
	end

	@ExecSpace("ServerOnly")
	method void RestoreTickets(any tickets)
		local now = self:Now()
		for index, ticket in ipairs(tickets) do
			_BRMatchQueue:RefreshTicket(ticket, self:GetCurrentWorldInstanceId(), now, self:GetTicketTtlSeconds())
		end
		
		for attempt = 1, self.MaxQueueUpdateRetries do
			local snapshot = self:ReadQueueSnapshot()
			if snapshot == nil then
				return
			end
		
			local queue = snapshot.State
			_BRMatchQueue:NormalizeQueue(queue)
			for index, ticket in ipairs(tickets) do
				_BRMatchQueue:RemoveTicket(queue, ticket.UserId, "")
				table.insert(queue.Tickets, ticket)
				self._T.localTickets[ticket.UserId] = ticket.TicketId
			end
			queue.UpdatedAt = now
		
			if self:CommitQueueAndUpdate(snapshot, queue) == true then
				return
			end
		end
	end

	@ExecSpace("ServerOnly")
	method any ReadQueueSnapshot()
		return _BRMatchQueueStore:ReadQueueSnapshot(self)
	end

	@ExecSpace("ServerOnly")
	method any ReadLocalQueueSnapshot()
		return _BRMatchQueueStore:ReadLocalQueueSnapshot(self)
	end

	@ExecSpace("ServerOnly")
	method boolean CommitQueueSnapshot(any snapshot)
		return _BRMatchQueueStore:CommitQueueSnapshot(self, snapshot)
	end

	@ExecSpace("ServerOnly")
	method boolean CommitQueueAndUpdate(any snapshot, any queue)
		return _BRMatchQueueStore:CommitQueueAndUpdate(self, snapshot, queue)
	end

	@ExecSpace("ServerOnly")
	method any ReadGlobalQueueSnapshot()
		return _BRMatchQueueStore:ReadGlobalQueueSnapshot(self)
	end

	@ExecSpace("ServerOnly")
	method boolean CommitGlobalQueueSnapshot(any snapshot)
		return _BRMatchQueueStore:CommitGlobalQueueSnapshot(self, snapshot)
	end

	method GlobalDataStorage GetGlobalQueueStorage()
		return _BRMatchQueueStore:GetGlobalQueueStorage(self)
	end

	method boolean IsDataStorageSuccess(any code)
		return _BRMatchQueueStore:IsDataStorageSuccess(code)
	end

	method boolean IsDataStorageBadRequest(any code)
		return _BRMatchQueueStore:IsDataStorageBadRequest(code)
	end

	method string GetGlobalQueueKey()
		return _BRMatchQueueStore:GetGlobalQueueKey(self)
	end

	method string GetQueueBackendName()
		return _BRMatchQueueStore:GetQueueBackendName(self)
	end

	method boolean IsLobbyMapEntity()
		if self.Entity == nil then
			return true
		end
		
		local path = self:ReadString(self.Entity.Path, "")
		if path == "" then
			return true
		end
		
		local lobbyRoot = "/maps/" .. self:ReadString(self.LobbyMapName, "StartMap")
		if path == lobbyRoot then
			return true
		end
		
		return string.sub(path, 1, string.len(lobbyRoot) + 1) == lobbyRoot .. "/"
	end

	method boolean IsUserInLobbyMap(string userId)
		local playerEntity = _UserService:GetUserEntityByUserId(userId)
		if playerEntity == nil then
			return false
		end
		
		return self:IsLobbyMapName(playerEntity.CurrentMapName)
	end

	method boolean IsLobbyMapName(string mapName)
		return self:ReadString(mapName, "") == self:ReadString(self.LobbyMapName, "StartMap")
	end

	method void EnsureRoomQueue()
		if self._T.roomQueue == nil then
			self._T.roomQueue = _BRMatchRoomQueue:CreateEmptyRoomQueue(self:Now())
		end
		_BRMatchRoomQueue:NormalizeRoomQueue(self._T.roomQueue)
	end

	method void UpdateActiveMatchCount()
		self:EnsureRoomQueue()
		self.ActiveMatchCount = _BRMatchRoomQueue:GetActiveRoomCount(self._T.roomQueue)
	end

	method boolean CanCreateMoreMatches()
		self:EnsureRoomQueue()
		local maxActive = math.max(1, math.floor(self:ReadNumber(self.MaxActiveMatches, 3)))
		return _BRMatchRoomQueue:GetActiveRoomCount(self._T.roomQueue) < maxActive
	end

	method boolean HasLocalTickets()
		if self._T.localTickets == nil then
			return false
		end
		for userId, ticketId in pairs(self._T.localTickets) do
			if ticketId ~= nil and ticketId ~= "" then
				return true
			end
		end
		return false
	end

	method boolean IsUserQueuedLocally(string userId)
		if self._T.localTickets == nil then
			return false
		end
		local ticketId = self._T.localTickets[userId]
		return ticketId ~= nil and ticketId ~= ""
	end

	method void UpdateQueueCounts(any queue)
		self.QueueCount = _BRMatchQueue:GetLocalTicketCount(queue, self:GetCurrentWorldInstanceId())
		self.TotalQueueCount = _BRMatchQueue:GetTotalTicketCount(queue)
		self.CurrentWorldInstanceId = self:GetCurrentWorldInstanceId()
	end

	@ExecSpace("ServerOnly")
	method void LogPeriodicStatus()
		if self.VerboseDebugLog == false then
			return
		end
		
		local now = self:Now()
		local interval = math.max(1, self:ReadNumber(self.DebugLogIntervalSeconds, 5))
		if self._T.lastDebugLogAt ~= nil and now - self._T.lastDebugLogAt < interval then
			return
		end
		self._T.lastDebugLogAt = now
		
		log("[BRLobby] tick backend=" .. self:GetQueueBackendName() .. " users=" .. tostring(self:GetConnectedUserCount()) .. " localQueue=" .. tostring(self.QueueCount) .. " totalQueue=" .. tostring(self.TotalQueueCount) .. " phase=" .. self.MatchmakingPhase .. " instance=" .. self.CurrentWorldInstanceId .. " lastError=" .. self.LastError)
	end

	method number GetConnectedUserCount()
		local count = 0
		for userId, entity in pairs(_UserService.UserEntities) do
			count = count + 1
		end
		return count
	end

	method boolean AreAllPlayersInThisServer(any players)
		if players == nil then
			return false
		end
		for index, userId in ipairs(players) do
			if _UserService:GetUserEntityByUserId(userId) == nil then
				return false
			end
		end
		return true
	end

	method number GetActiveMatchCount()
		if self._T.roomQueue ~= nil then
			return _BRMatchRoomQueue:GetActiveRoomCount(self._T.roomQueue)
		end
		
		local count = 0
		if self._T.matches == nil then
			return count
		end
		for matchId, match in pairs(self._T.matches) do
			count = count + 1
		end
		return count
	end

	method number GetTargetCount()
		return math.max(1, math.floor(self:ReadNumber(self.TargetPlayerCount, 8)))
	end

	method number GetTicketTtlSeconds()
		return math.max(30, self:ReadNumber(self.TicketTtlSeconds, 45))
	end

	method number GetHeartbeatSeconds()
		return math.max(1, math.min(self:GetTicketTtlSeconds() * 0.5, self:ReadNumber(self.HeartbeatSeconds, 10)))
	end

	method number GetMatchRoomTtlSeconds()
		return math.max(30, self:ReadNumber(self.MatchRoomTtlSeconds, 600))
	end

	method number Now()
		return _UtilLogic.ServerElapsedSeconds
	end

	method string GetCurrentWorldInstanceId()
		if _WorldInstanceService == nil then
			return ""
		end
		return self:ReadString(_WorldInstanceService.WorldInstanceId, "")
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method string GetMatchingLabel(number queueCount)
		return "Matching " .. tostring(queueCount) .. "/" .. tostring(self:GetTargetCount())
	end

	@ExecSpace("ServerOnly")
	method void SetLobbyName(string userId, number queueCount)
		local playerEntity = _UserService:GetUserEntityByUserId(userId)
		if playerEntity == nil or playerEntity.NameTagComponent == nil then
			return
		end
		
		playerEntity.NameTagComponent.Name = self:GetMatchingLabel(queueCount)
		playerEntity.NameTagComponent.FontColor = Color(0.2, 1, 1, 1)
	end

	@ExecSpace("ServerOnly")
	method void SetGatherName(string userId, number index, number total)
		_BRBattleLauncher:SetGatherName(userId, index, total)
	end

	@ExecSpace("Client")
	method void ShowToast(string message)
		if _UIToast ~= nil then
			_UIToast:ShowMessage(message)
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		self:EnsureRuntimeStarted()
		if self.EnableLobbyMatchmaker == false then
			log("[BRLobby] user leave ignored: disabled user=" .. tostring(event.UserId))
			return
		end
		
		log("[BRLobby] user leave user=" .. tostring(event.UserId))
		self:CancelQueue(event.UserId)
	end

end
