@Component
script BRMatchButton extends Component

	property string MatchmakerPath = "/maps/StartMap/MatchMaker"

	property string LobbyMapName = "StartMap"

	property string ReadyText = "MATCH"

	property string WaitingText = "MATCHING..."

	property boolean BotMatchMode = false

	property string BotReadyText = "BOT MATCH"

	property string BotWaitingText = "BOT MATCHING..."

	property string LobbyRootPath = "/ui/LobbyGroup"

	property string PeopleTogglePath = "PeopleHit"

	property string BotTogglePath = "BotHit"

	property string PeopleHighPath = "People/High"

	property string BotHighPath = "Bot/High"

	property boolean RequireLobbyMap = true

	property number ClickCooldownSeconds = 0.5

	property number QueueRequestDebounceSeconds = 0.25

	property any buttonHandler = nil

	property any peopleToggleHandler = nil

	property any botToggleHandler = nil

	property any peopleToggleEntity = nil

	property any botToggleEntity = nil

	property number refreshTimerId = 0

	property number queueRequestTimerId = 0

	property number nextClickAt = 0

	property boolean waiting = false

	property boolean committedWaiting = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Initializes the lobby match button and mode toggles.
		local entityName = "unknown"
		if self.Entity ~= nil then
			entityName = self:ReadString(self.Entity.Name, "unknown")
		end
		log("[BRMatchButton] ready entity=" .. entityName .. " bot=" .. tostring(self.BotMatchMode))
		self:ConnectButton()
		self:ConnectModeToggleButtons()
		log("[BRMatchButton] mode toggles connected people=" .. tostring(self.peopleToggleHandler ~= nil) .. " bot=" .. tostring(self.botToggleHandler ~= nil))
		self:UpdateModeHighlights()
		self:RefreshButtonState()
		self.refreshTimerId = _TimerService:SetTimerRepeat(function() self:RefreshButtonState() end, 0.25)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Releases lobby button handlers and timers.
		self:DisconnectButton()
		self:DisconnectModeToggleButtons()
		if self.refreshTimerId ~= nil and self.refreshTimerId > 0 then
			_TimerService:ClearTimer(self.refreshTimerId)
		end
		self.refreshTimerId = 0
		self:ClearPendingQueueRequest()
	end

	@ExecSpace("ClientOnly")
	method void ConnectButton()
		-- Connects the primary matching button click handler.
		if self.buttonHandler ~= nil or self.Entity == nil then
			return
		end
		self.buttonHandler = self.Entity:ConnectEvent(ButtonClickEvent, self.HandleButtonClickEvent)
	end

	@ExecSpace("ClientOnly")
	method void DisconnectButton()
		-- Disconnects the primary matching button click handler.
		if self.buttonHandler == nil or self.Entity == nil then
			return
		end
		self.Entity:DisconnectEvent(ButtonClickEvent, self.buttonHandler)
		self.buttonHandler = nil
	end

	@ExecSpace("ClientOnly")
	method void ConnectModeToggleButtons()
		-- Connects People/Bot toggle click handlers under the lobby group.
		if self.peopleToggleHandler == nil then
			local people = self:GetLobbyEntity(self.PeopleTogglePath)
			if people ~= nil then
				self.peopleToggleEntity = people
				self.peopleToggleHandler = people:ConnectEvent(ButtonClickEvent, self.HandlePeopleToggleClickEvent)
			end
		end
		if self.botToggleHandler == nil then
			local bot = self:GetLobbyEntity(self.BotTogglePath)
			if bot ~= nil then
				self.botToggleEntity = bot
				self.botToggleHandler = bot:ConnectEvent(ButtonClickEvent, self.HandleBotToggleClickEvent)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void DisconnectModeToggleButtons()
		-- Disconnects People/Bot toggle click handlers.
		if self.peopleToggleHandler ~= nil and self.peopleToggleEntity ~= nil then
			self.peopleToggleEntity:DisconnectEvent(ButtonClickEvent, self.peopleToggleHandler)
		end
		if self.botToggleHandler ~= nil and self.botToggleEntity ~= nil then
			self.botToggleEntity:DisconnectEvent(ButtonClickEvent, self.botToggleHandler)
		end
		self.peopleToggleHandler = nil
		self.botToggleHandler = nil
		self.peopleToggleEntity = nil
		self.botToggleEntity = nil
	end

	@ExecSpace("ClientOnly")
	method void HandlePeopleToggleClickEvent(ButtonClickEvent event)
		-- Selects human matchmaking mode from the People toggle.
		self:SelectMatchMode(false)
	end

	@ExecSpace("ClientOnly")
	method void HandleBotToggleClickEvent(ButtonClickEvent event)
		-- Selects bot matchmaking mode from the Bot toggle.
		self:SelectMatchMode(true)
	end

	@ExecSpace("ClientOnly")
	method void SelectMatchMode(boolean useBotMatch)
		-- Applies the selected matching mode and updates the highlight state.
		local wasHumanQueuePending = self.BotMatchMode == false and (self.waiting == true or self.committedWaiting == true)
		if self.BotMatchMode == useBotMatch then
			self:UpdateModeHighlights()
			return
		end
		
		self.BotMatchMode = useBotMatch
		self.waiting = false
		self.committedWaiting = false
		self:ClearPendingQueueRequest()
		self:UpdateModeHighlights()
		self:RefreshButtonState()
		
		if wasHumanQueuePending == true then
			self:RequestCancelQueueForLocalPlayer()
		end
		log("[BRMatchButton] mode selected bot=" .. tostring(self.BotMatchMode))
	end

	@ExecSpace("ClientOnly")
	method void HandleButtonClickEvent(ButtonClickEvent event)
		-- Starts or toggles matchmaking with the currently selected lobby mode.
		if self.RequireLobbyMap == true and self:IsLocalPlayerInLobby() == false then
			self:RefreshButtonState()
			return
		end
		
		local now = _UtilLogic.ElapsedSeconds
		if now < self.nextClickAt then
			return
		end
		self.nextClickAt = now + math.max(0.1, self.ClickCooldownSeconds)
		
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			self:ShowLocalToast("Player is not ready.")
			return
		end
		
		local matchmaker = self:GetMatchmaker()
		if matchmaker == nil then
			self:ShowLocalToast("Matchmaker is not ready.")
			return
		end
		
		if self.BotMatchMode == true then
			self.waiting = true
		else
			self.waiting = not self.waiting
		end
		self:RefreshButtonState()
		self:ScheduleQueueRequest()
	end

	@ExecSpace("ClientOnly")
	method void RefreshButtonState()
		-- Refreshes button availability, label text, and current mode highlight.
		local inLobby = self:IsLocalPlayerInLobby()
		local canUse = inLobby == true or self.RequireLobbyMap == false
		if self.Entity ~= nil and self.Entity.ButtonComponent ~= nil then
			self.Entity.ButtonComponent.Enable = canUse
		end
		self:SetModeToggleButtonsEnabled(canUse)
		self:UpdateModeHighlights()
		if canUse == false then
			self.waiting = false
			self.committedWaiting = false
			self:ClearPendingQueueRequest()
			self:SetButtonText(self:GetReadyText())
			return
		end
		if self.waiting == true then
			self:SetButtonText(self:GetWaitingText())
		else
			self:SetButtonText(self:GetReadyText())
		end
	end

	@ExecSpace("ClientOnly")
	method void ScheduleQueueRequest()
		self:ClearPendingQueueRequest()
		self.queueRequestTimerId = _TimerService:SetTimerOnce(function() self:CommitQueueRequest() end, self:GetQueueRequestDebounceSeconds())
	end

	@ExecSpace("ClientOnly")
	method void ClearPendingQueueRequest()
		if self.queueRequestTimerId ~= nil and self.queueRequestTimerId > 0 then
			_TimerService:ClearTimer(self.queueRequestTimerId)
		end
		self.queueRequestTimerId = 0
	end

	@ExecSpace("ClientOnly")
	method void CommitQueueRequest()
		self.queueRequestTimerId = 0
		if self.RequireLobbyMap == true and self:IsLocalPlayerInLobby() == false then
			self.waiting = false
			self.committedWaiting = false
			self:RefreshButtonState()
			return
		end
		
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			self:ShowLocalToast("Player is not ready.")
			self.waiting = self.committedWaiting
			self:RefreshButtonState()
			return
		end
		
		local matchmaker = self:GetMatchmaker()
		if matchmaker == nil then
			self:ShowLocalToast("Matchmaker is not ready.")
			self.waiting = self.committedWaiting
			self:RefreshButtonState()
			return
		end
		
		if self.BotMatchMode == true then
			log("[BRMatchButton] request bot match user=" .. tostring(localPlayer.PlayerComponent.UserId))
			matchmaker:RequestStartBotMatch(localPlayer.PlayerComponent.UserId)
			self.waiting = false
			self.committedWaiting = false
			self:RefreshButtonState()
			return
		end
		
		if self.waiting == self.committedWaiting then
			return
		end
		
		if self.waiting == true then
			log("[BRMatchButton] request human queue join user=" .. tostring(localPlayer.PlayerComponent.UserId))
			matchmaker:RequestJoinQueue(localPlayer.PlayerComponent.UserId)
		else
			log("[BRMatchButton] request human queue cancel user=" .. tostring(localPlayer.PlayerComponent.UserId))
			matchmaker:RequestCancelQueue(localPlayer.PlayerComponent.UserId)
		end
		self.committedWaiting = self.waiting
	end

	@ExecSpace("ClientOnly")
	method boolean IsLocalPlayerInLobby()
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return false
		end
		return self:ReadString(localPlayer.CurrentMapName, "") == self:ReadString(self.LobbyMapName, "StartMap")
	end

	@ExecSpace("ClientOnly")
	method any GetMatchmaker()
		local entity = _EntityService:GetEntityByPath(self:ReadString(self.MatchmakerPath, "/maps/StartMap/MatchMaker"))
		if entity == nil then
			return nil
		end
		---@type BRLobbyMatchmaker
		local matchmaker = entity:GetComponent("script.BRLobbyMatchmaker")
		return matchmaker
	end

	@ExecSpace("ClientOnly")
	method void SetButtonText(string text)
		if self.Entity ~= nil and self.Entity.TextComponent ~= nil then
			self.Entity.TextComponent.Text = self:ReadString(text, "MATCH")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetModeToggleButtonsEnabled(boolean enabled)
		-- Mirrors the lobby availability state onto People/Bot toggle buttons.
		local people = self:GetLobbyEntity(self.PeopleTogglePath)
		if people ~= nil and people.ButtonComponent ~= nil then
			people.ButtonComponent.Enable = enabled
		end
		local bot = self:GetLobbyEntity(self.BotTogglePath)
		if bot ~= nil and bot.ButtonComponent ~= nil then
			bot.ButtonComponent.Enable = enabled
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateModeHighlights()
		-- Shows exactly one selected-mode highlight under People or Bot.
		self:SetLobbyEntityActive(self.PeopleHighPath, self.BotMatchMode == false)
		self:SetLobbyEntityActive(self.BotHighPath, self.BotMatchMode == true)
	end

	@ExecSpace("ClientOnly")
	method void SetLobbyEntityActive(string relativePath, boolean active)
		-- Toggles a lobby UI child entity through Enable so input and children follow the state.
		local entity = self:GetLobbyEntity(relativePath)
		if entity == nil then
			return
		end
		entity.Enable = active
	end

	@ExecSpace("ClientOnly")
	method void RequestCancelQueueForLocalPlayer()
		-- Cancels a committed human queue ticket when the user switches away from people mode.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			return
		end
		
		local matchmaker = self:GetMatchmaker()
		if matchmaker == nil then
			return
		end
		
		log("[BRMatchButton] cancel human queue on mode switch user=" .. tostring(localPlayer.PlayerComponent.UserId))
		matchmaker:RequestCancelQueue(localPlayer.PlayerComponent.UserId)
	end

	@ExecSpace("ClientOnly")
	method any GetLobbyEntity(string relativePath)
		-- Resolves a lobby UI entity from either an absolute or root-relative path.
		local path = self:BuildLobbyPath(relativePath)
		if path == "" then
			return nil
		end
		return _EntityService:GetEntityByPath(path)
	end

	method string BuildLobbyPath(string relativePath)
		-- Builds an absolute LobbyGroup UI path for runtime entity lookup.
		local path = self:ReadString(relativePath, "")
		if path == "" then
			return ""
		end
		if string.sub(path, 1, 1) == "/" then
			return path
		end
		
		local root = self:ReadString(self.LobbyRootPath, "/ui/LobbyGroup")
		if root == "" then
			root = "/ui/LobbyGroup"
		end
		if string.sub(root, string.len(root), string.len(root)) == "/" then
			return root .. path
		end
		return root .. "/" .. path
	end

	@ExecSpace("ClientOnly")
	method void ShowLocalToast(string message)
		if _UIToast ~= nil then
			_UIToast:ShowMessage(message)
		end
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number GetQueueRequestDebounceSeconds()
		return math.max(0.1, self.QueueRequestDebounceSeconds)
	end

	method string GetReadyText()
		if self.BotMatchMode == true then
			return self:ReadString(self.BotReadyText, "BOT MATCH")
		end
		return self:ReadString(self.ReadyText, "MATCH")
	end

	method string GetWaitingText()
		if self.BotMatchMode == true then
			return self:ReadString(self.BotWaitingText, "BOT MATCHING...")
		end
		return self:ReadString(self.WaitingText, "MATCHING...")
	end

end
