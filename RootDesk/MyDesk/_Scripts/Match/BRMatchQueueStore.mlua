@Logic
script BRMatchQueueStore extends Logic

	method any ReadQueueSnapshot(any owner)
		if self:ShouldUseGlobalQueue(owner, true) == true then
			return self:ReadGlobalQueueSnapshot(owner)
		end
		
		return self:ReadLocalQueueSnapshot(owner)
	end

	method any ReadLocalQueueSnapshot(any owner)
		if owner._T.queue == nil then
			owner._T.queue = _BRMatchQueue:CreateEmptyQueue(owner:Now())
		end
		
		_BRMatchQueue:NormalizeQueue(owner._T.queue)
		return {
			Backend = "Local",
			State = owner._T.queue
		}
	end

	method any ReadGlobalQueueSnapshot(any owner)
		local storage = self:GetGlobalQueueStorage(owner)
		if storage == nil then
			return nil
		end
		
		local key = self:GetGlobalQueueKey(owner)
		local code, encodedQueue = storage:GetAndWait(key)
		local missingQueue = false
		if self:IsDataStorageSuccess(code) == false then
			if self:IsDataStorageNotFound(code) == false then
				owner.LastError = "Global queue read failed: " .. tostring(code)
				log("[BRMatchQueueStore] global queue read failed: key=" .. key .. " result=" .. tostring(code))
				return nil
			end
			missingQueue = true
			encodedQueue = ""
			log("[BRMatchQueueStore] global queue key missing. using empty queue snapshot: key=" .. key .. " result=" .. tostring(code))
		end
		
		local queue = _BRMatchQueue:DecodeQueue(encodedQueue, owner:Now(), owner:GetTicketTtlSeconds())
		if queue == nil then
			owner.LastError = "Global queue decode failed"
			log("[BRMatchQueueStore] global queue decode failed. Reinitializing queue: key=" .. key)
			queue = _BRMatchQueue:CreateEmptyQueue(owner:Now())
		end
		
		_BRMatchQueue:NormalizeQueue(queue)
		return {
			Backend = "GlobalDataStorage",
			Storage = storage,
			Key = key,
			ExpectedValue = owner:ReadString(encodedQueue, ""),
			Missing = missingQueue,
			State = queue
		}
	end

	method boolean CommitQueueSnapshot(any owner, any snapshot)
		if snapshot == nil or snapshot.State == nil then
			return false
		end
		
		if snapshot.Backend == "GlobalDataStorage" then
			return self:CommitGlobalQueueSnapshot(owner, snapshot)
		end
		
		owner._T.queue = snapshot.State
		return true
	end

	method boolean CommitQueueAndUpdate(any owner, any snapshot, any queue)
		if self:CommitQueueSnapshot(owner, snapshot) == false then
			return false
		end
		owner:UpdateQueueCounts(queue)
		return true
	end

	method boolean CommitGlobalQueueSnapshot(any owner, any snapshot)
		local storage = snapshot.Storage
		if storage == nil then
			storage = self:GetGlobalQueueStorage(owner)
		end
		if storage == nil then
			return false
		end
		
		local key = owner:ReadString(snapshot.Key, self:GetGlobalQueueKey(owner))
		local expectedValue = owner:ReadString(snapshot.ExpectedValue, "")
		local newValue = _BRMatchQueue:EncodeQueue(snapshot.State, owner:Now(), owner:GetTicketTtlSeconds())
		if newValue == "" then
			owner.LastError = "Global queue encode failed"
			return false
		end
		
		local code = 0
		local updatedValue = ""
		local createdMissingKey = false
		if snapshot.Missing == true then
			code = storage:SetAndWait(key, newValue)
			createdMissingKey = true
		else
			code, updatedValue = storage:UpdateAndWait(key, expectedValue, newValue)
			if self:IsDataStorageNotFound(code) == true then
				log("[BRMatchQueueStore] global queue missing during update. creating key=" .. key .. " result=" .. tostring(code))
				code = storage:SetAndWait(key, newValue)
				createdMissingKey = true
			end
		end
		
		if self:IsDataStorageSuccess(code) == true then
			if createdMissingKey == true then
				log("[BRMatchQueueStore] global queue key initialized: key=" .. key)
			end
			return true
		end
		
		owner.LastError = "Global queue write failed: " .. tostring(code)
		log("[BRMatchQueueStore] global queue write failed: key=" .. key .. " result=" .. tostring(code))
		return false
	end

	method boolean EnsureGlobalQueueInitialized(any owner)
		-- Creates the global queue key once when published DataStorage starts empty.
		if self:ShouldUseGlobalQueue(owner, false) == false then
			return false
		end

		local snapshot = self:ReadGlobalQueueSnapshot(owner)
		if snapshot == nil then
			return false
		end
		if snapshot.Missing ~= true then
			return true
		end

		log("[BRMatchQueueStore] initializing missing global queue key: key=" .. self:ReadString(snapshot.Key, self:GetGlobalQueueKey(owner)))
		return self:CommitGlobalQueueSnapshot(owner, snapshot)
	end

	method boolean ResetGlobalQueue(any owner)
		local storage = self:GetGlobalQueueStorage(owner)
		if storage == nil then
			return false
		end
		
		local now = owner:Now()
		local key = self:GetGlobalQueueKey(owner)
		local emptyQueue = _BRMatchQueue:CreateEmptyQueue(now)
		local code = storage:SetAndWait(key, _BRMatchQueue:EncodeQueue(emptyQueue, now, owner:GetTicketTtlSeconds()))
		if self:IsDataStorageSuccess(code) == true then
			return true
		end
		
		owner.LastError = "Global queue reset failed: " .. tostring(code)
		log("[BRMatchQueueStore] global queue reset failed: key=" .. key .. " result=" .. tostring(code))
		return false
	end

	method GlobalDataStorage GetGlobalQueueStorage(any owner)
		if _DataStorageService == nil then
			owner.LastError = "DataStorageService unavailable"
			log("[BRMatchQueueStore] DataStorageService unavailable.")
			return nil
		end
		
		return _DataStorageService:GetGlobalDataStorage(owner:ReadString(owner.GlobalQueueStorageName, "SkillChangeSurvivalMatchmaking"))
	end

	method string GetGlobalQueueKey(any owner)
		return owner:ReadString(owner.GlobalQueueKey, "br_match_queue")
	end

	method string GetQueueBackendName(any owner)
		if self:ShouldUseGlobalQueue(owner, false) == true then
			return "GlobalDataStorage"
		end
		return "Local"
	end

	method boolean ShouldUseGlobalQueue(any owner, boolean logFallback)
		if owner == nil or owner.UseGlobalMatchQueue ~= true then
			return false
		end
		if _DataStorageService == nil then
			if logFallback == true then
				self:LogGlobalQueueFallback(owner, "DataStorageService unavailable")
			end
			return false
		end
		if owner:GetCurrentWorldInstanceId() == "" then
			if logFallback == true then
				self:LogGlobalQueueFallback(owner, "WorldInstanceId unavailable")
			end
			return false
		end
		return true
	end

	method void LogGlobalQueueFallback(any owner, string reason)
		if owner == nil then
			return
		end
		owner.LastError = self:ReadString(reason, "Global queue unavailable") .. "; local queue fallback"
		if owner._T == nil then
			return
		end
		if owner._T.globalQueueFallbackReason == reason then
			return
		end
		owner._T.globalQueueFallbackReason = reason
		log("[BRMatchQueueStore] global queue fallback reason=" .. self:ReadString(reason, "unknown"))
	end

	method boolean IsDataStorageSuccess(any code)
		local codeNumber = tonumber(code)
		if codeNumber ~= nil then
			return codeNumber == 0
		end
		
		local codeText = tostring(code)
		return codeText == "Success" or codeText == "OK" or codeText == "WriteResultCode.Success" or codeText == "SharedMemoryResultCode.OK"
	end

	method boolean IsDataStorageNotFound(any code)
		-- Returns true for published DataStorage missing-key responses.
		local codeNumber = tonumber(code)
		if codeNumber ~= nil then
			return codeNumber == 1000002
		end

		local codeText = tostring(code)
		return codeText == "NotFound" or codeText == "SharedMemoryResultCode.NotFound"
	end

	method boolean IsDataStorageBadRequest(any code)
		local codeNumber = tonumber(code)
		if codeNumber ~= nil then
			return codeNumber == 2 or codeNumber == 1000003
		end
		
		local codeText = tostring(code)
		return codeText == "BadRequest" or codeText == "WriteResultCode.BadRequest" or codeText == "SharedMemoryResultCode.BadRequest"
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

end
