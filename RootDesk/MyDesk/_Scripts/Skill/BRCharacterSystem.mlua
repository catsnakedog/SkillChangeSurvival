	method boolean IsOneHandedWeaponRuid(string ruid)
		-- Current fixed class weapons are avatar item weapon/onehandedweapon resources.
		local safeRuid = self:ReadString(ruid, "")
		return safeRuid == "5c17efb794334d4980987edaace1f546"
			or safeRuid == "37d1f2f65ace4ff583e388243b756682"
			or safeRuid == "f109234375b84d008cc9c363a2f22598"
			or safeRuid == "bd723e9061d144b98d9fb693521313c8"
	end

	method string GetLocalUserId()
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			return ""
		end
		return self:ReadString(localPlayer.PlayerComponent.UserId, "")
	end

	method void EnsureRuntime()
		if self._T.serverCharacterByUserId == nil then
			self._T.serverCharacterByUserId = {}
		end
	end

	method void SetAvatarEquip(any costume, any category, string ruid)
		-- Writes one avatar slot, allowing an empty RUID to clear unused class parts.
		if costume == nil or category == nil then
			return
		end
		local safeRuid = self:ReadString(ruid, "")
		if category == MapleAvatarItemCategory.Body then
			costume.CustomBodyEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Hair then
			costume.CustomHairEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Face then
			costume.CustomFaceEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Cap then
			costume.CustomCapEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Cape then
			costume.CustomCapeEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Coat then
			costume.CustomCoatEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Longcoat then
			costume.CustomLongcoatEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Pants then
			costume.CustomPantsEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Glove then
			costume.CustomGloveEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Shoes then
			costume.CustomShoesEquip = safeRuid
		elseif category == MapleAvatarItemCategory.OneHandedWeapon then
			costume.CustomOneHandedWeaponEquip = safeRuid
		elseif category == MapleAvatarItemCategory.TwoHandedWeapon then
			costume.CustomTwoHandedWeaponEquip = safeRuid
		elseif category == MapleAvatarItemCategory.SubWeapon or category == MapleAvatarItemCategory.Shield then
			costume.CustomSubWeaponEquip = safeRuid
		elseif category == MapleAvatarItemCategory.FaceAccessory then
			costume.CustomFaceAccessoryEquip = safeRuid
		elseif category == MapleAvatarItemCategory.EyeAccessory then
			costume.CustomEyeAccessoryEquip = safeRuid
		elseif category == MapleAvatarItemCategory.EarAccessory then
			costume.CustomEarAccessoryEquip = safeRuid
		elseif category == MapleAvatarItemCategory.Ear then
			costume.CustomEarEquip = safeRuid
		else
			self:Log("avatar equip skipped reason=unknownCategory ruid=" .. safeRuid)
		end
	end

	method void RefreshClassSelection()
		self:RefreshClassSelectionByKey(self:GetLocalCharacterKey())
	end

	method void RefreshClassSelectionByKey(string characterKey)
		local key = self:NormalizeCharacterKey(characterKey)
		self:SetClassSelectFrameActive(self.knightFrame, key == "Knight")
		self:SetClassSelectFrameActive(self.mageFrame, key == "Mage")
		self:SetClassSelectFrameActive(self.rogueFrame, key == "Rogue")
		self:SetClassSelectFrameActive(self.archerFrame, key == "Archer")
		self:RefreshClassSelectSkillIcons(key)
	end

	method void RefreshClassSelectSkillIcons(string characterKey)
		local key = self:NormalizeCharacterKey(characterKey)
		local basicSkillKey = self:GetCharacterDefaultSkillValue(key, "basic_skill_id")
		local uniqueSkillKey = self:GetCharacterDefaultSkillValue(key, "unique_skill_id")
		local basicIconRuid = self:GetSkillIconRUID(basicSkillKey)
		local uniqueIconRuid = self:GetSkillIconRUID(uniqueSkillKey)
		self:SetClassSelectSkillIcon(self.classSelectBasicSkillIcon, basicIconRuid)
		self:SetClassSelectSkillIcon(self.classSelectUniqueSkillIcon, uniqueIconRuid)
		self:SetClassSelectSkillIconByPath("Common_1/Icon", basicIconRuid)
		self:SetClassSelectSkillIconByPath("Common_2/Icon", uniqueIconRuid)
		self:Log("classSelect icons key=" .. key .. " basic=" .. basicSkillKey .. " unique=" .. uniqueSkillKey)
	end

	method void SetClassSelectSkillIcon(SpriteGUIRendererComponent renderer, string iconRuid)
		if renderer == nil then
			return
		end
		self:ApplyClassSelectSkillIcon(renderer, iconRuid)
	end

	method void SetClassSelectSkillIconByPath(string relativePath, string iconRuid)
		local path = "/ui/BRClassSelectGroup/Bg/" .. self:ReadString(relativePath, "")
		local entity = _EntityService:GetEntityByPath(path)
		if entity == nil or entity.SpriteGUIRendererComponent == nil then
			return
		end
		self:ApplyClassSelectSkillIcon(entity.SpriteGUIRendererComponent, iconRuid)
	end

	method void ApplyClassSelectSkillIcon(SpriteGUIRendererComponent renderer, string iconRuid)
		if renderer == nil then
			return
		end
		local safeRuid = self:ReadString(iconRuid, "")
		if safeRuid == "" then
			safeRuid = "4fea64a3307cda641809ad8be0d4890b"
		end
		renderer.Enable = true
		renderer.ImageRUID = DataRef(safeRuid)
		renderer.Color = Color(1, 1, 1, 0.96)
	end

	method string GetSkillIconRUID(string skillKey)
		local safeSkillKey = self:ReadString(skillKey, "")
		if safeSkillKey == "" then
			return ""
		end
		if _BRSkillUIDatabase ~= nil then
			local iconRuid = _BRSkillUIDatabase:GetSlotIconRUID(safeSkillKey, 1, false)
			if self:ReadString(iconRuid, "") ~= "" then
				return iconRuid
			end
		end
		local data = self:GetDataTable("skills")
		if data == nil then
			return ""
		end
		local row = self:GetDataRowIndex(data, "id", safeSkillKey)
		if row <= 0 then
			return ""
		end
		return self:GetDataCell(data, row, "icon_ruid", "")
	end

	method void ConnectClassSelectButtons()
		-- Connects class select buttons and the Escape close key on the client.
		self:DisconnectClassSelectButtons()
		if self.knightButton ~= nil and self.knightButton.Entity ~= nil then
			self.knightHandler = self.knightButton.Entity:ConnectEvent(ButtonClickEvent, function() self:PreviewClassFromUI("Knight") end)
		end
		if self.mageButton ~= nil and self.mageButton.Entity ~= nil then
			self.mageHandler = self.mageButton.Entity:ConnectEvent(ButtonClickEvent, function() self:PreviewClassFromUI("Mage") end)
		end
		if self.rogueButton ~= nil and self.rogueButton.Entity ~= nil then
			self.rogueHandler = self.rogueButton.Entity:ConnectEvent(ButtonClickEvent, function() self:PreviewClassFromUI("Rogue") end)
		end
		if self.archerButton ~= nil and self.archerButton.Entity ~= nil then
			self.archerHandler = self.archerButton.Entity:ConnectEvent(ButtonClickEvent, function() self:PreviewClassFromUI("Archer") end)
		end
		if self.classSelectCloseButton ~= nil and self.classSelectCloseButton.Entity ~= nil then
			self.classSelectCloseHandler = self.classSelectCloseButton.Entity:ConnectEvent(ButtonClickEvent, self.CloseClassSelect)
		end
		if self.classSelectConfirmButton ~= nil and self.classSelectConfirmButton.Entity ~= nil then
			self.classSelectConfirmHandler = self.classSelectConfirmButton.Entity:ConnectEvent(ButtonClickEvent, self.ConfirmClassSelection)
		end
		if self.classSelectRandomButton ~= nil and self.classSelectRandomButton.Entity ~= nil then
			self.classSelectRandomHandler = self.classSelectRandomButton.Entity:ConnectEvent(ButtonClickEvent, self.RandomPreviewClass)
		end
		if self.classSelectKeyDownHandler == nil and _InputService ~= nil then
			self.classSelectKeyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnClassSelectKeyDown)
		end
		self:Log("classSelect handlers connected missing=" .. self:GetClassSelectMissingReason())
	end

	method void DisconnectClassSelectButtons()
		-- Disconnects all class select UI handlers.
		if self.knightHandler ~= nil and self.knightButton ~= nil and self.knightButton.Entity ~= nil then
			self.knightButton.Entity:DisconnectEvent(ButtonClickEvent, self.knightHandler)
		end
		if self.mageHandler ~= nil and self.mageButton ~= nil and self.mageButton.Entity ~= nil then
			self.mageButton.Entity:DisconnectEvent(ButtonClickEvent, self.mageHandler)
		end
		if self.rogueHandler ~= nil and self.rogueButton ~= nil and self.rogueButton.Entity ~= nil then
			self.rogueButton.Entity:DisconnectEvent(ButtonClickEvent, self.rogueHandler)
		end
		if self.archerHandler ~= nil and self.archerButton ~= nil and self.archerButton.Entity ~= nil then
			self.archerButton.Entity:DisconnectEvent(ButtonClickEvent, self.archerHandler)
		end
		if self.classSelectCloseHandler ~= nil and self.classSelectCloseButton ~= nil and self.classSelectCloseButton.Entity ~= nil then
			self.classSelectCloseButton.Entity:DisconnectEvent(ButtonClickEvent, self.classSelectCloseHandler)
		end
		if self.classSelectConfirmHandler ~= nil and self.classSelectConfirmButton ~= nil and self.classSelectConfirmButton.Entity ~= nil then
			self.classSelectConfirmButton.Entity:DisconnectEvent(ButtonClickEvent, self.classSelectConfirmHandler)
		end
		if self.classSelectRandomHandler ~= nil and self.classSelectRandomButton ~= nil and self.classSelectRandomButton.Entity ~= nil then
			self.classSelectRandomButton.Entity:DisconnectEvent(ButtonClickEvent, self.classSelectRandomHandler)
		end
		if self.classSelectKeyDownHandler ~= nil and _InputService ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.classSelectKeyDownHandler)
		end
		self.knightHandler = nil
		self.mageHandler = nil
		self.rogueHandler = nil
		self.archerHandler = nil
		self.classSelectCloseHandler = nil
		self.classSelectConfirmHandler = nil
		self.classSelectRandomHandler = nil
		self.classSelectKeyDownHandler = nil
	end

	method void HideClassSelectImmediate()
		-- Hides the class select root and panel immediately without changing selection state.
		if self.classSelectRoot ~= nil then
			self.classSelectRoot.Enable = false
			self.classSelectRoot.Visible = false
			if self.classSelectRoot.CanvasGroupComponent ~= nil then
				self.classSelectRoot.CanvasGroupComponent.GroupAlpha = 0
				self.classSelectRoot.CanvasGroupComponent.BlocksRaycasts = false
				self.classSelectRoot.CanvasGroupComponent.Interactable = false
			end
		end
		if self.classSelectPanel ~= nil then
			self.classSelectPanel.Enable = false
			self.classSelectPanel.Visible = false
		end
	end

	method void SetClassSelectFrameActive(Entity frame, boolean active)
		-- Shows one CharacterFull entity and hides the others.
		if frame == nil then
			return
		end
		frame.Enable = active == true
		frame.Visible = active == true
	end

	method boolean IsClassSelectReady()
		-- Returns true when every required class select binding exists.
		return self:GetClassSelectMissingReason() == ""
	end

	method string GetClassSelectMissingReason()
		-- Describes the first missing required UI binding for class select.
		if self.classSelectRoot == nil then
			return "classSelectRoot"
		end
		if self.classSelectPanel == nil then
			return "classSelectPanel"
		end
		if self.knightButton == nil then
			return "KnightButton"
		end
		if self.mageButton == nil then
			return "MageButton"
		end
		if self.rogueButton == nil then
			return "RogueButton"
		end
		if self.archerButton == nil then
			return "ArcherButton"
		end
		if self.classSelectConfirmButton == nil then
			return "SelectButton"
		end
		if self.classSelectRandomButton == nil then
			return "RandomButton"
		end
		if self.knightFrame == nil then
			return "KnightCharacterFull"
		end
		if self.mageFrame == nil then
			return "MageCharacterFull"
		end
		if self.rogueFrame == nil then
			return "RogueCharacterFull"
		end
		if self.archerFrame == nil then
			return "ArcherCharacterFull"
		end
		return ""
	end

	method string ReadAvatarRuid(any avatar, string key)
		-- Reads one class avatar RUID by table key.
		if avatar == nil then
			return ""
		end
		local value = avatar[self:ReadString(key, "")]
		return self:ReadString(value, "")
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method string GetEntityDebugName(Entity entity)
		if entity == nil then
			return "nil"
		end
		local name = self:ReadString(entity.Name, "")
		if name ~= "" then
			return name
		end
		return self:ReadString(entity.Id, "entity")
	end

	method string TrimString(string value)
		-- Trims leading and trailing whitespace from CSV/DataSet strings.
		local text = self:ReadString(value, "")
		return self:ReadString(string.match(text, "^%s*(.-)%s*$"), "")
	end

	method void Log(string message)
		if self.VerboseLog == true then
			log("[BRCharacter] " .. self:ReadString(message, ""))
		end
	end

end
