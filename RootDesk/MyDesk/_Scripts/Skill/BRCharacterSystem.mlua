@Logic
script BRCharacterSystem extends Logic

	property string DefaultCharacterKey = "Knight"
	property string CharacterDefaultSkillsTableName = "character_default_skills"

	property boolean VerboseLog = true
	property integer CharacterCatalogVersion = 4

	property Entity classSelectRoot = "ff877862-5ed0-4b36-81e3-29f3385d63e8"

	property Entity classSelectPanel = "c5e6bdc6-d1c4-41dd-85fc-728eed241ea6"

	property ButtonComponent knightButton = "5ca001f2-2e6d-4b66-a64a-0a800a369375"

	property ButtonComponent mageButton = "f746d1d5-38b4-4b85-9d43-e0d31d6f7c72"

	property ButtonComponent rogueButton = "f0710818-ad92-4570-ab39-fa8af9d6e7c3"

	property ButtonComponent archerButton = "6191a152-e5cf-43ac-9266-ff0804b1b812"

	property ButtonComponent classSelectCloseButton = "6fc62a6d-79f2-47c3-a61d-a85fca15aca9"

	property ButtonComponent classSelectConfirmButton = "fd5e9419-1cb0-42b0-b2e4-0074219c032b"

	property ButtonComponent classSelectRandomButton = "06ca18ce-68b1-42d6-b743-89623b3ef6d7"

	property Entity knightFrame = "29423e89-2752-48e0-82fb-28a09fbecd45"

	property Entity mageFrame = "0d630ddd-9f46-4ff9-afcb-44b616cf4340"

	property Entity rogueFrame = "b3c94cb6-db5a-49a8-9f8a-ecde48afbc3d"

	property Entity archerFrame = "c0518a53-e8cb-4541-8a6d-0dc9e832b4ec"

	property SpriteGUIRendererComponent classSelectBasicSkillIcon = "2b593614-29ca-49d5-8f2f-ef1208a69e67"

	property SpriteGUIRendererComponent classSelectUniqueSkillIcon = "1ba1a03d-032c-4c3c-8a28-fe852a8fd2a8"

	property number clientSnapshotTimerId = 0

	property boolean classSelectOpen = false

	property string classSelectSource = ""

	property string classSelectPreviewKey = ""

	property any knightHandler = nil

	property any mageHandler = nil

	property any rogueHandler = nil

	property any archerHandler = nil

	property any classSelectCloseHandler = nil

	property any classSelectConfirmHandler = nil

	property any classSelectRandomHandler = nil

	property any classSelectKeyDownHandler = nil

	method void OnBeginPlay()
		self:EnsureRuntime()
		if self:IsServer() then
			self:Log("ready catalog=" .. tostring(#self:GetCharacterCatalog()))
		end
		if self:IsClient() then
			self:HideClassSelectImmediate()
			self:ConnectClassSelectButtons()
			self.clientSnapshotTimerId = _TimerService:SetTimerOnce(function() self:RequestCharacterSnapshot() end, 0.2)
		end
	end

	method void OnEndPlay()
		if self:IsClient() then
			self:DisconnectClassSelectButtons()
		end
		if self.clientSnapshotTimerId ~= nil and self.clientSnapshotTimerId > 0 then
			_TimerService:ClearTimer(self.clientSnapshotTimerId)
		end
		self.clientSnapshotTimerId = 0
	end

	@ExecSpace("Server")
	method void RequestCharacterSnapshot()
		local userId = self:ReadString(senderUserId, "")
		if userId == "" then
			return
		end
		local key = self:GetServerCharacterKey(userId)
		self:ApplyCharacterAvatarToUser(userId, key, "snapshot-server")
		self:ApplyCharacterClient(userId, key, "snapshot")
		self:Log("snapshot user=" .. userId .. " key=" .. key)
	end

	@ExecSpace("ClientOnly")
	method void RequestCycleCharacter(string source)
		-- Opens the class select popup from NPC interaction.
		self:OpenClassSelectInternal(source)
	end

	@ExecSpace("Server")
	method void RequestSetCharacter(string characterKey, string source)
		local userId = self:ReadString(senderUserId, "")
		if userId == "" then
			return
		end
		self:SetServerCharacterKeyForUser(userId, characterKey, "set:" .. self:ReadString(source, "unknown"))
	end

	@ExecSpace("ServerOnly")
	method void SetServerCharacterKeyForUser(string userId, string characterKey, string reason)
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end
		local safeKey = self:NormalizeCharacterKey(characterKey)
		self._T.serverCharacterByUserId[safeUserId] = safeKey
		self:ApplyCharacterAvatarToUser(safeUserId, safeKey, reason)
		self:ApplyCharacterClient(safeUserId, safeKey, reason)
		if _BRSkillSystem ~= nil then
			_BRSkillSystem:NotifyUserChanged(safeUserId)
		end
		self:Log("changed user=" .. safeUserId .. " key=" .. safeKey .. " reason=" .. self:ReadString(reason, ""))
	end

	@ExecSpace("Client")
	method void ApplyCharacterClient(string userId, string characterKey, string reason)
		local localUserId = self:GetLocalUserId()
		if localUserId == "" or localUserId ~= self:ReadString(userId, "") then
			return
		end
		local safeKey = self:NormalizeCharacterKey(characterKey)
		self._T.localCharacterKey = safeKey
		self:ApplyLocalCharacterAvatar(safeKey, reason)
		self:Log("local key=" .. safeKey .. " reason=" .. self:ReadString(reason, ""))
	end

	@ExecSpace("ClientOnly")
	method void PreviewLocalCharacter(string characterKey, string reason)
		-- Applies a local preview immediately while the server-authoritative change is requested.
		local safeKey = self:NormalizeCharacterKey(characterKey)
		self._T.localCharacterKey = safeKey
		self:ApplyLocalCharacterAvatar(safeKey, reason)
		self:Log("preview key=" .. safeKey .. " reason=" .. self:ReadString(reason, ""))
	end

	@ExecSpace("ClientOnly")
	method void OpenClassSelectFromNpc(string source)
		-- Opens the class select popup from direct UI/NPC callers.
		self:OpenClassSelectInternal(source)
	end

	@ExecSpace("ClientOnly")
	method void OpenClassSelectInternal(string source)
		-- Shows the class selector after verifying the current authored UI bindings.
		if self:IsClassSelectReady() ~= true then
			self:Log("classSelect open skipped reason=notReady missing=" .. self:GetClassSelectMissingReason() .. " source=" .. self:ReadString(source, ""))
			return
		end
		self.classSelectSource = self:ReadString(source, "npc")
		self:ConnectClassSelectButtons()
		self.classSelectOpen = true
		self.classSelectRoot.Enable = true
		self.classSelectRoot.Visible = true
		self.classSelectPanel.Enable = true
		self.classSelectPanel.Visible = true
		if self.classSelectRoot.CanvasGroupComponent ~= nil then
			self.classSelectRoot.CanvasGroupComponent.GroupAlpha = 1
			self.classSelectRoot.CanvasGroupComponent.BlocksRaycasts = true
			self.classSelectRoot.CanvasGroupComponent.Interactable = true
		end
		self.classSelectPreviewKey = self:GetLocalCharacterKey()
		self:RefreshClassSelectionByKey(self.classSelectPreviewKey)
		self:Log("classSelect opened source=" .. self.classSelectSource .. " preview=" .. self.classSelectPreviewKey)
	end

	@ExecSpace("ClientOnly")
	method void CloseClassSelect()
		if self.classSelectOpen ~= true then
			self:HideClassSelectImmediate()
			return
		end
		self.classSelectOpen = false
		self:HideClassSelectImmediate()
		self:Log("classSelect closed")
	end

	@ExecSpace("ClientOnly")
	method void SelectClassFromUI(string characterKey)
		-- Compatibility entry point for old button wiring; a job click now previews only.
		self:PreviewClassFromUI(characterKey)
	end

	@ExecSpace("ClientOnly")
	method void PreviewClassFromUI(string characterKey)
		-- Updates the pending class and toggles the matching CharacterFull image.
		local safeKey = self:NormalizeCharacterKey(characterKey)
		self.classSelectPreviewKey = safeKey
		self:RefreshClassSelectionByKey(safeKey)
		self:Log("classSelect preview key=" .. safeKey)
	end

	@ExecSpace("ClientOnly")
	method void ConfirmClassSelection()
		-- Confirms the currently previewed class through the server-authoritative flow.
		local safeKey = self:NormalizeCharacterKey(self:ReadString(self.classSelectPreviewKey, self:GetLocalCharacterKey()))
		local reason = "class-ui:" .. self.classSelectSource
		self:PreviewLocalCharacter(safeKey, reason)
		self:RequestSetCharacter(safeKey, reason)
		self:RefreshClassSelectionByKey(safeKey)
		self:Log("classSelect confirmed key=" .. safeKey)
	end

	@ExecSpace("ClientOnly")
	method void RandomPreviewClass()
		-- Picks one visible class button and applies the same preview flow as a button click.
		local candidates = {}
		if self.knightButton ~= nil then
			table.insert(candidates, "Knight")
		end
		if self.mageButton ~= nil then
			table.insert(candidates, "Mage")
		end
		if self.rogueButton ~= nil then
			table.insert(candidates, "Rogue")
		end
		if self.archerButton ~= nil then
			table.insert(candidates, "Archer")
		end
		if #candidates <= 0 then
			self:Log("classSelect random skipped reason=noCandidates")
			return
		end
		local index = 1
		if _UtilLogic ~= nil then
			index = _UtilLogic:RandomIntegerRange(1, #candidates)
		end
		local key = self:ReadString(candidates[index], self:GetDefaultCharacterKey())
		self:PreviewClassFromUI(key)
		self:Log("classSelect random key=" .. key)
	end

	@ExecSpace("ClientOnly")
	method void OnClassSelectKeyDown(KeyDownEvent event)
		-- Closes the class selector when Escape is pressed.
		if self.classSelectOpen ~= true then
			return
		end
		if event == nil or event.key ~= KeyboardKey.Escape then
			return
		end
		self:CloseClassSelect()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalCharacterAvatar(string characterKey, string reason)
		-- Applies the fixed class costume to the local player avatar.
		local safeKey = self:NormalizeCharacterKey(characterKey)
		local data = self:GetCharacterData(safeKey)
		if data == nil or data.Avatar == nil then
			self:Log("avatar skipped reason=noData key=" .. safeKey)
			return
		end
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.CostumeManagerComponent == nil then
			self:Log("avatar skipped reason=noLocalCostume key=" .. self:ReadString(characterKey, ""))
			return
		end

		self:ApplyCharacterAvatarToEntityInternal(localPlayer, safeKey, reason)
	end

	@ExecSpace("ServerOnly")
	method void ApplyCharacterAvatarToUser(string userId, string characterKey, string reason)
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end
		local playerEntity = _UserService:GetUserEntityByUserId(safeUserId)
		if playerEntity == nil then
			self:Log("avatar server skipped reason=noUserEntity user=" .. safeUserId .. " key=" .. self:ReadString(characterKey, ""))
			return
		end
		self:ApplyCharacterAvatarToEntityInternal(playerEntity, characterKey, reason)
	end

	@ExecSpace("ServerOnly")
	method boolean ApplyCharacterAvatarToEntityServer(Entity targetEntity, string characterKey, string reason)
		return self:ApplyCharacterAvatarToEntityInternal(targetEntity, characterKey, reason)
	end

	@ExecSpace("ClientOnly")
	method boolean ApplyCharacterAvatarToEntityClient(Entity targetEntity, string characterKey, string reason)
		return self:ApplyCharacterAvatarToEntityInternal(targetEntity, characterKey, reason)
	end

	method boolean ApplyCharacterAvatarToEntityInternal(Entity targetEntity, string characterKey, string reason)
		local safeKey = self:NormalizeCharacterKey(characterKey)
		local data = self:GetCharacterData(safeKey)
		if data == nil or data.Avatar == nil then
			self:Log("avatar skipped reason=noData key=" .. self:ReadString(characterKey, ""))
			return false
		end
		if targetEntity == nil or targetEntity.CostumeManagerComponent == nil then
			self:Log("avatar skipped reason=noCostume key=" .. safeKey)
			return false
		end

		local costume = targetEntity.CostumeManagerComponent
		local avatar = data.Avatar
		costume.Enable = true
		costume.UseCustomEquipOnly = true
		costume.DefaultEquipUserId = ""

		self:SetAvatarEquip(costume, MapleAvatarItemCategory.Body, self:ReadAvatarRuid(avatar, "Body"))
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.Hair, self:ReadAvatarRuid(avatar, "Hair"))
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.Face, self:ReadAvatarRuid(avatar, "Face"))
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.Cap, self:ReadAvatarRuid(avatar, "Cap"))
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.Longcoat, self:ReadAvatarRuid(avatar, "Longcoat"))
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.Coat, "")
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.Pants, "")
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.Shoes, self:ReadAvatarRuid(avatar, "Shoes"))
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.EyeAccessory, self:ReadAvatarRuid(avatar, "EyeAccessory"))
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.FaceAccessory, self:ReadAvatarRuid(avatar, "FaceAccessory"))
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.OneHandedWeapon, "")
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.TwoHandedWeapon, "")
		self:SetAvatarEquip(costume, MapleAvatarItemCategory.SubWeapon, "")

		local weaponRuid = self:ReadAvatarRuid(avatar, "Weapon")
		local weaponSlot = self:ReadString(data.WeaponSlot, "OneHanded")
		if self:IsOneHandedWeaponRuid(weaponRuid) == true then
			weaponSlot = "OneHanded"
		end
		if weaponSlot == "TwoHanded" then
			self:SetAvatarEquip(costume, MapleAvatarItemCategory.TwoHandedWeapon, weaponRuid)
		else
			self:SetAvatarEquip(costume, MapleAvatarItemCategory.OneHandedWeapon, weaponRuid)
		end
		self:Log("avatar applied key=" .. self:ReadString(data.Key, "") .. " entity=" .. self:GetEntityDebugName(targetEntity) .. " reason=" .. self:ReadString(reason, ""))
		return true
	end

	@ExecSpace("ClientOnly")
	method string GetLocalCharacterKey()
		self:EnsureRuntime()
		local key = self:ReadString(self._T.localCharacterKey, "")
		if key == "" then
			key = self:GetDefaultCharacterKey()
			self._T.localCharacterKey = key
		end
		return key
	end

	@ExecSpace("ClientOnly")
	method string GetLocalUniqueSkillKey()
		-- Returns the local character's CSV-declared unique skill key.
		local skillKey = self:GetCharacterDefaultSkillValue(self:GetLocalCharacterKey(), "unique_skill_id")
		if skillKey ~= "" then
			return skillKey
		end
		local data = self:GetCharacterData(self:GetLocalCharacterKey())
		if data == nil then
			return ""
		end
		return self:ReadString(data.UniqueSkillKey, "")
	end

	@ExecSpace("ServerOnly")
	method string GetServerUniqueSkillKey(string userId)
		-- Returns the server-authoritative CSV-declared unique skill key for one user.
		local characterKey = self:GetServerCharacterKey(userId)
		local skillKey = self:GetCharacterDefaultSkillValue(characterKey, "unique_skill_id")
		if skillKey ~= "" then
			return skillKey
		end
		local data = self:GetCharacterData(characterKey)
		if data == nil then
			return ""
		end
		return self:ReadString(data.UniqueSkillKey, "")
	end

	@ExecSpace("ClientOnly")
	method string GetLocalBasicSkillKey()
		-- Returns the local character's CSV-declared basic skill key.
		return self:GetCharacterDefaultSkillValue(self:GetLocalCharacterKey(), "basic_skill_id")
	end

	@ExecSpace("ServerOnly")
	method string GetServerBasicSkillKey(string userId)
		-- Returns the server-authoritative CSV-declared basic skill key for one user.
		return self:GetCharacterDefaultSkillValue(self:GetServerCharacterKey(userId), "basic_skill_id")
	end

	@ExecSpace("ClientOnly")
	method string GetLocalBasicAttackKey()
		-- Returns the local character's CSV-declared basic attack key.
		return self:GetCharacterDefaultSkillValue(self:GetLocalCharacterKey(), "basic_attack_id")
	end

	@ExecSpace("ServerOnly")
	method string GetServerBasicAttackKey(string userId)
		-- Returns the server-authoritative CSV-declared basic attack key for one user.
		return self:GetCharacterDefaultSkillValue(self:GetServerCharacterKey(userId), "basic_attack_id")
	end

	@ExecSpace("ClientOnly")
	method string GetLocalPassiveSkillKey()
		-- Returns the local character's CSV-declared passive skill key.
		return self:GetCharacterDefaultSkillValue(self:GetLocalCharacterKey(), "passive_id")
	end

	@ExecSpace("ServerOnly")
	method string GetServerPassiveSkillKey(string userId)
		-- Returns the server-authoritative CSV-declared passive skill key for one user.
		return self:GetCharacterDefaultSkillValue(self:GetServerCharacterKey(userId), "passive_id")
	end

	@ExecSpace("ClientOnly")
	method string GetLocalCharacterDisplayName()
		local data = self:GetCharacterData(self:GetLocalCharacterKey())
		if data == nil then
			return "기사"
		end
		return self:ReadString(data.DisplayName, "기사")
	end

	method string GetServerCharacterKey(string userId)
		self:EnsureRuntime()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return self:GetDefaultCharacterKey()
		end
		local key = self:ReadString(self._T.serverCharacterByUserId[safeUserId], "")
		if self:GetCharacterData(key) == nil then
			key = self:GetDefaultCharacterKey()
			self._T.serverCharacterByUserId[safeUserId] = key
		end
		return key
	end

	method string GetNextCharacterKey(string characterKey)
		local catalog = self:GetCharacterCatalog()
		local currentIndex = self:GetCharacterIndex(characterKey)
		local nextIndex = currentIndex + 1
		if nextIndex > #catalog then
			nextIndex = 1
		end
		local data = catalog[nextIndex]
		if data == nil then
			return self:GetDefaultCharacterKey()
		end
		return self:ReadString(data.Key, self:GetDefaultCharacterKey())
	end

	method string NormalizeCharacterKey(string characterKey)
		local key = self:ReadString(characterKey, "")
		if self:GetCharacterData(key) ~= nil then
			return key
		end
		return self:GetDefaultCharacterKey()
	end

	method string GetDefaultCharacterKey()
		local key = self:ReadString(self.DefaultCharacterKey, "Knight")
		if self:GetCharacterData(key) ~= nil then
			return key
		end
		return "Knight"
	end

	method any GetCharacterData(string characterKey)
		local key = self:ReadString(characterKey, "")
		if key == "" then
			return nil
		end
		local catalog = self:GetCharacterCatalog()
		for index, data in ipairs(catalog) do
			if data ~= nil and self:ReadString(data.Key, "") == key then
				return data
			end
		end
		return nil
	end

	method number GetCharacterIndex(string characterKey)
		local key = self:NormalizeCharacterKey(characterKey)
		local catalog = self:GetCharacterCatalog()
		for index, data in ipairs(catalog) do
			if data ~= nil and self:ReadString(data.Key, "") == key then
				return index
			end
		end
		return 1
	end

	method string GetCharacterKeyByIndex(number rawIndex)
		return self:GetCharacterKeyByIndexInternal(rawIndex)
	end

	@ExecSpace("ServerOnly")
	method string GetServerCharacterKeyByIndex(number rawIndex)
		return self:GetCharacterKeyByIndexInternal(rawIndex)
	end

	method string GetCharacterKeyByIndexInternal(number rawIndex)
		local catalog = self:GetCharacterCatalog()
		local count = #catalog
		if count <= 0 then
			return self:GetDefaultCharacterKey()
		end
		local index = math.floor(self:ReadNumber(rawIndex, 1))
		if index < 1 then
			index = 1
		end
		index = ((index - 1) % count) + 1
		local data = catalog[index]
		if data == nil then
			return self:GetDefaultCharacterKey()
		end
		return self:ReadString(data.Key, self:GetDefaultCharacterKey())
	end

	method string GetCharacterDefaultSkillValue(string characterKey, string columnName)
		-- Reads one class default skill field from the CSV-backed DataSet.
		local key = self:ReadString(characterKey, "")
		local column = self:ReadString(columnName, "")
		if key == "" or column == "" then
			return ""
		end
		local data = self:GetDataTable(self.CharacterDefaultSkillsTableName)
		if data == nil then
			return ""
		end
		local row = self:GetDataRowIndex(data, "character_key", key)
		if row <= 0 then
			return ""
		end
		return self:GetDataCell(data, row, column, "")
	end

	method any GetDataTable(string tableName)
		-- Reads a UserDataSet by table name.
		local safeName = self:ReadString(tableName, "")
		if safeName == "" or _DataService == nil then
			return nil
		end
		return _DataService:GetTable(safeName)
	end

	method string GetDataCell(any dataSet, number row, string columnName, string fallback)
		-- Reads one DataSet cell as a string.
		if dataSet == nil then
			return self:ReadString(fallback, "")
		end
		local value = dataSet:GetCell(math.max(1, math.floor(row)), self:ReadString(columnName, ""))
		if value == nil then
			return self:ReadString(fallback, "")
		end
		return self:TrimString(tostring(value))
	end

	method number GetDataRowIndex(any dataSet, string keyColumnName, string keyValue)
		-- Finds the first DataSet row whose key column matches the requested value.
		if dataSet == nil then
			return 0
		end
		local rowCount = math.max(0, math.floor(dataSet:GetRowCount()))
		local column = self:ReadString(keyColumnName, "")
		local key = self:ReadString(keyValue, "")
		for row = 1, rowCount do
			if self:GetDataCell(dataSet, row, column, "") == key then
				return row
			end
		end
		return 0
	end

	method any GetCharacterCatalog()
		self:EnsureRuntime()
		if self._T.characterCatalog == nil or self._T.characterCatalogVersion ~= self.CharacterCatalogVersion then
			self._T.characterCatalogVersion = self.CharacterCatalogVersion
			self._T.characterCatalog = {
				{
					Key = "Knight",
					DisplayName = "기사",
