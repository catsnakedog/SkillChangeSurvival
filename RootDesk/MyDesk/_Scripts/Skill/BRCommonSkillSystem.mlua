@Logic
script BRCommonSkillSystem extends Logic

	property boolean EnableCommonSkills = true

	property boolean VerboseLog = true

	property number UniqueCooldownSeconds = 0.35

	property number BlinkCooldownSeconds = 1.2

	property number BlinkDistance = 2.2

	property string BlinkSkillKey = "Blink"

	property string BlinkSoundRUID = "287c154aa1de458cb8f8eaf892c84b24"

	property string BlinkEffectRUID = "8dc15776c4f349a0bfa155e911e4a7be"

	property string BlinkStartEffectRUID = "df5bd4514ffb461fb8479ff0d88ec204"

	property string BlinkEndEffectRUID = "c4755faee88149738692350b34aa5766"

	property string BlinkBlockedEffectRUID = "ba3f9119b8634a1f80e85017adc426f7"

	property number BlinkSoundVolume = 0.9

	property number BlinkEffectScale = 1.0

	property number BlinkEffectAlpha = 0.95

	property number BlinkEffectPlayRate = 1.0

	property integer BlinkEffectOrderInLayer = 30

	property boolean RestrictBlinkToCurrentRoom = true

	property boolean SnapBlinkToFoothold = true

	property number BlinkFootholdSearchUp = 0.8

	property number BlinkFootholdSearchDown = 4.0

	property number BlinkFootholdYOffset = 0.04

	property number NimbusToggleCooldownSeconds = 0.35

	property number NimbusMoveSpeed = 5.2

	property boolean RestrictNimbusToCurrentRoom = true

	property number NimbusRoomBoundsPadding = 0.08

	property string NimbusSkillKey = "Nimbus"

	property boolean BlockNimbusInBattleMap = true

	property boolean NimbusUseFlyAnimation = true

	property string NimbusEffectRUID = "263871f547a941c99ce0ab13c7b95aad"

	property string NimbusEndEffectRUID = "6a743f785c1e4513ad9b3fd6954ef9d7"

	property string NimbusUseSoundRUID = "626819a606324e038c632018086bb9de"

	property string NimbusEndSoundRUID = "7a11ec9a27384286bc7de630bc0dcabb"

	property number NimbusSoundVolume = 0.9

	property number NimbusEffectLocalX = 0

	property number NimbusEffectLocalY = 0

	property number NimbusEffectScale = 0.68

	property number NimbusEffectAlpha = 0.95

	property number NimbusEffectPlayRate = 1.0

	property integer NimbusEffectOrderInLayer = 20

	-- The Nimbus/repeat clip is frames 0-7 = cloud forming, 8-22 = steady ride. Looping the whole clip
	-- snaps 22->0 (full size -> tiny) which reads as a repeated appear/disappear, so loop only the
	-- steady-ride frames for a seamless cloud. Cancel still plays the separate Nimbus/end disappear.
	property integer NimbusEffectLoopStartFrame = 8

	property integer NimbusEffectLoopEndFrame = 22

	property any inputKeyDownHandler = nil

	property any inputKeyUpHandler = nil

	property number localNextUniqueAt = 0

	property number localNextBlinkAt = 0

	property number localNextNimbusToggleAt = 0

	property boolean localNimbusActive = false

	property boolean localNimbusToggleKeyHeld = false

	property integer localNimbusEffectSerial = 0

	-- Fixed-action key rebinding (client-local). Codes are KeyboardKey values (Q=113, C=99, E=101).
	-- Attack has no static default in this project (DefaultPlayer engine binding), so it is discovered
	-- at runtime via PlayerControllerComponent:GetActionName and remapped via SetActionKey.
	property string AttackActionName = "Attack"

	property integer DefaultUniqueKeyCode = 113

	property integer DefaultBlinkKeyCode = 99

	property integer DefaultNimbusKeyCode = 101

	property integer UniqueKeyCode = 113

	property integer BlinkKeyCode = 99

	property integer NimbusKeyCode = 101

	property integer AttackKeyCode = 0

	property integer DefaultAttackKeyCode = 0

	property boolean attackKeyDiscovered = false

	property string capturingActionId = ""

	property string rebindStatusText = ""

	property integer snapUniqueKeyCode = 113

	property integer snapBlinkKeyCode = 99

	property integer snapNimbusKeyCode = 101

	property integer snapAttackKeyCode = 0

	method void OnBeginPlay()
		-- Initializes common skill input on the client and portal-lock state on the server.
		self:EnsureRuntime()
		if self:IsClient() then
			self:StartClientInput()
		end
		if self:IsServer() then
			self:Log("ready common=Unique/Blink/Nimbus")
		end
	end

	method void OnEndPlay()
		if self:IsClient() then
			self:StopNimbusEffect()
			self:SetLocalNimbusActive(false, "endplay")
			self:StopClientInput()
		end
	end

	method void OnUpdate(number delta)
		if self:IsClient() then
			self:TickLocalInputOverrides(delta)
			self:TickLocalNimbus(delta)
		end
	end

	@ExecSpace("ClientOnly")
	method void StartClientInput()
		if self.EnableCommonSkills ~= true then
			return
		end
		if self.inputKeyDownHandler ~= nil then
			return
		end
		self.inputKeyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnCommonSkillKeyDown)
		self.inputKeyUpHandler = _InputService:ConnectEvent(KeyUpEvent, self.OnCommonSkillKeyUp)
		self:EnsureAttackKeyDiscovered()
		self:RemoveBlinkKeyDefaultAction(true)
		log("[BRCommonSkill] client input ready unique=" .. self:GetKeyDisplayName(self:GetUniqueKeyCode()) .. " blink=" .. self:GetKeyDisplayName(self:GetBlinkKeyCode()) .. " nimbus=" .. self:GetKeyDisplayName(self:GetNimbusKeyCode()))
	end

	@ExecSpace("ClientOnly")
	method void StopClientInput()
		if self.inputKeyDownHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.inputKeyDownHandler)
		end
		self.inputKeyDownHandler = nil
		if self.inputKeyUpHandler ~= nil then
			_InputService:DisconnectEvent(KeyUpEvent, self.inputKeyUpHandler)
		end
		self.inputKeyUpHandler = nil
		self.localNimbusToggleKeyHeld = false
	end

	@ExecSpace("ClientOnly")
	method void OnCommonSkillKeyDown(KeyDownEvent event)
		if event == nil or self.EnableCommonSkills ~= true then
			return
		end
		-- While the key-config panel is capturing, consume the next key as the new binding and fire nothing.
		if self:IsCapturingRebind() == true then
			self:HandleRebindCapture(event.key)
			return
		end
		local key = event.key
		if key == KeyboardKey.CastFrom(self:GetUniqueKeyCode()) then
			self:TryUseUniqueSkill()
		elseif key == KeyboardKey.CastFrom(self:GetBlinkKeyCode()) then
			self:RemoveBlinkKeyDefaultAction(false)
			self:TryBlink()
		elseif key == KeyboardKey.CastFrom(self:GetNimbusKeyCode()) then
			if self.localNimbusToggleKeyHeld == true then
				return
			end
			self.localNimbusToggleKeyHeld = true
			self:TryToggleNimbus()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCommonSkillKeyUp(KeyUpEvent event)
		-- Releases the Nimbus toggle latch so a held E key cannot repeatedly turn the ride on and off.
		if event == nil then
			return
		end
		if event.key == KeyboardKey.CastFrom(self:GetNimbusKeyCode()) then
			self.localNimbusToggleKeyHeld = false
		end
	end

	@ExecSpace("ClientOnly")
	method void TickLocalInputOverrides(number delta)
		-- Keeps the player controller from treating C as crouch/sit while C is reserved for Blink.
		local now = _UtilLogic.ElapsedSeconds
		if now < self:ReadNumber(self._T.nextInputOverrideCheckAt, 0) then
			return
		end
		self._T.nextInputOverrideCheckAt = now + 0.5
		self:EnsureAttackKeyDiscovered()
		self:RemoveBlinkKeyDefaultAction(false)
	end

	@ExecSpace("ClientOnly")
	method void RemoveBlinkKeyDefaultAction(boolean logEvenWhenEmpty)
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerControllerComponent == nil then
			return
		end

		local controller = localPlayer.PlayerControllerComponent
		local blinkKey = KeyboardKey.CastFrom(self:GetBlinkKeyCode())
		local previousAction = self:ReadString(controller:GetActionName(blinkKey), "")
		-- Never strip the basic-attack action off its key (defensive; Blink can never share the attack key).
		if previousAction == self:ReadString(self.AttackActionName, "Attack") then
			return
		end
		controller:RemoveActionKey(blinkKey)
		if self.VerboseLog == true and (previousAction ~= "" or logEvenWhenEmpty == true) then
			log("[BRCommonSkill] blink key override key=" .. self:GetKeyDisplayName(self:GetBlinkKeyCode()) .. " removedAction=" .. previousAction)
		end
	end

	@ExecSpace("ClientOnly")
	method void TryUseUniqueSkill()
		local now = _UtilLogic.ElapsedSeconds
		if now < self:ReadNumber(self.localNextUniqueAt, 0) then
			return
		end
		self.localNextUniqueAt = now + self:GetUniqueCooldownSeconds()

		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			return
		end
		if localPlayer.PlayerComponent:IsDead() == true or localPlayer.PlayerComponent.Hp <= 0 then
			return
		end

		if _BRSkillSystem ~= nil then
			local userId = self:ReadString(localPlayer.PlayerComponent.UserId, "")
			local uniqueSkillKey = ""
			if _BRCharacterSystem ~= nil then
				uniqueSkillKey = _BRCharacterSystem:GetLocalUniqueSkillKey()
			end
			_BRSkillSystem:RequestCastUniqueSkill(userId, uniqueSkillKey)
			log("[BRCommonSkill] unique request user=" .. userId .. " skill=" .. uniqueSkillKey)
		else
			log("[BRCommonSkill] unique skipped reason=noSkillSystem")
		end
	end

	@ExecSpace("ClientOnly")
	method void TryBlink()
		-- Performs Burst Step with the current arrow-key direction and CSV-backed resources.
		local now = _UtilLogic.ElapsedSeconds
		if now < self:ReadNumber(self.localNextBlinkAt, 0) then
			return
		end

		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil or localPlayer.RigidbodyComponent == nil then
			return
		end
		if localPlayer.PlayerComponent:IsDead() == true or localPlayer.PlayerComponent.Hp <= 0 then
			return
		end

		self.localNextBlinkAt = now + self:GetBlinkCooldownSeconds()
		local position = self:GetEntityPosition2(localPlayer)
		local direction = self:GetBlinkInputDirection(localPlayer)
		local distance = self:GetBlinkDistance()
		local target = Vector2(position.x + direction.x * distance, position.y + direction.y * distance)
		local resolvedTarget = self:ResolveBlinkTarget(localPlayer, position, target)
		local moved = math.abs(resolvedTarget.x - position.x) > 0.001 or math.abs(resolvedTarget.y - position.y) > 0.001

		self:PlayBlinkVisual(localPlayer, position, resolvedTarget, direction, moved)

		localPlayer.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
		localPlayer.RigidbodyComponent:SetWorldPosition(resolvedTarget)
		localPlayer.RigidbodyComponent:PositionReset()
		if localPlayer.MovementComponent ~= nil then
			localPlayer.MovementComponent:Stop()
		end
		-- Burst Step cancels the active chain: current skill motion cancels (return to idle + free
		-- movement), queued steps are dropped, but already-spawned damage still lands. The chain runs
		-- server-side in BRSkillSystem, so request the cancel there.
		if _BRSkillSystem ~= nil then
			_BRSkillSystem:RequestCancelChainByBlink(self:ReadString(localPlayer.PlayerComponent.UserId, ""))
		end
		log("[BRCommonSkill] burstStep dir=(" .. tostring(direction.x) .. "," .. tostring(direction.y) .. ") distance=" .. tostring(distance) .. " moved=" .. tostring(moved == true) .. " target=(" .. tostring(resolvedTarget.x) .. "," .. tostring(resolvedTarget.y) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void TryToggleNimbus()
		local now = _UtilLogic.ElapsedSeconds
		if now < self:ReadNumber(self.localNextNimbusToggleAt, 0) then
			return
		end
		self.localNextNimbusToggleAt = now + self:GetNimbusToggleCooldownSeconds()
		self:SetLocalNimbusActive(self.localNimbusActive ~= true, "toggle")
	end

	@ExecSpace("ClientOnly")
	method void SetLocalNimbusActive(boolean active, string reason)
		self:EnsureRuntime()
		local nextActive = active == true
		if self.localNimbusActive == nextActive then
			return
		end

		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil or localPlayer.RigidbodyComponent == nil then
			return
		end
		if nextActive == true and self:CanStartNimbus(localPlayer) ~= true then
			log("[BRCommonSkill] nimbus blocked reason=combatOrInvalid")
			return
		end

		if nextActive == true then
			self:CaptureNimbusBackup(localPlayer)
			self:CaptureNimbusRideBounds(localPlayer)
			self:ApplyNimbusMovement(localPlayer, true)
			self:PlayNimbusVisual(localPlayer, true)
			self.localNimbusActive = true
			self:SetNimbusActiveServer(true)
			local position = self:GetEntityPosition2(localPlayer)
			log("[BRCommonSkill] nimbus ride on reason=" .. self:ReadString(reason, "unknown") .. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ")")
		else
			self:RestoreNimbusMovement(localPlayer)
			self:PlayNimbusVisual(localPlayer, false)
			self:ClearNimbusRideBounds()
			self.localNimbusActive = false
			self:SetNimbusActiveServer(false)
			log("[BRCommonSkill] nimbus ride off reason=" .. self:ReadString(reason, "unknown"))
		end
	end

	@ExecSpace("ClientOnly")
	method void TickLocalNimbus(number delta)
		if self.localNimbusActive ~= true then
			return
		end

		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.RigidbodyComponent == nil or localPlayer.PlayerComponent == nil then
			self:StopNimbusEffect()
			self:ClearNimbusRideBounds()
			self.localNimbusActive = false
			self:SetNimbusActiveServer(false)
			return
		end
		if self:CanKeepNimbus(localPlayer) ~= true then
			self:SetLocalNimbusActive(false, "auto")
			return
		end

		self:ApplyNimbusMovement(localPlayer, false)
		local dx = 0
		local dy = 0
		if _InputService:IsKeyPressed(KeyboardKey.RightArrow) == true then
			dx = dx + 1
		end
		if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) == true then
			dx = dx - 1
		end
		if _InputService:IsKeyPressed(KeyboardKey.UpArrow) == true then
			dy = dy + 1
		end
		if _InputService:IsKeyPressed(KeyboardKey.DownArrow) == true then
			dy = dy - 1
		end

		if dx ~= 0 and dy ~= 0 then
			local inv = 1 / math.sqrt(2)
			dx = dx * inv
			dy = dy * inv
		end
		if localPlayer.PlayerControllerComponent ~= nil then
			if dx > 0 then
				localPlayer.PlayerControllerComponent.LookDirectionX = 1
			elseif dx < 0 then
				localPlayer.PlayerControllerComponent.LookDirectionX = -1
			end
		end
		local speed = self:GetNimbusMoveSpeed()
		local position = self:GetNimbusRidePosition(localPlayer)
		local deltaSeconds = math.min(0.05, math.max(0, self:ReadNumber(delta, 0)))
		local nextPosition = Vector2(position.x + dx * speed * deltaSeconds, position.y + dy * speed * deltaSeconds)
		local rideBounds = self:GetNimbusMovementBounds(localPlayer, position)
		if rideBounds ~= nil and self:IsPositionInsideBounds(nextPosition, rideBounds, 0) ~= true then
			local oldDx = dx
			local oldDy = dy
			if nextPosition.x < self:ReadNumber(rideBounds.Left, nextPosition.x) or nextPosition.x > self:ReadNumber(rideBounds.Right, nextPosition.x) then
				dx = 0
			end
			if nextPosition.y < self:ReadNumber(rideBounds.Bottom, nextPosition.y) or nextPosition.y > self:ReadNumber(rideBounds.Top, nextPosition.y) then
				dy = 0
			end
			if dx == 0 and oldDx ~= 0 and oldDy ~= 0 and dy ~= 0 then
				if dy > 0 then
					dy = 1
				else
					dy = -1
				end
			end
			if dy == 0 and oldDy ~= 0 and oldDx ~= 0 and dx ~= 0 then
				if dx > 0 then
					dx = 1
				else
					dx = -1
				end
			end
			if self.VerboseLog == true then
				self:LogNimbusMoveBlocked(rideBounds, position, oldDx, oldDy, dx, dy)
			end
		end
		self:DriveNimbusMovement(localPlayer, dx, dy, speed, deltaSeconds)
	end

	@ExecSpace("ClientOnly")
	method boolean CanStartNimbus(Entity playerEntity)
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return false
		end
		if playerEntity.PlayerComponent:IsDead() == true or playerEntity.PlayerComponent.Hp <= 0 then
			return false
		end
		if self.BlockNimbusInBattleMap == true and self:IsBattleMap(playerEntity) == true then
			return false
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean CanKeepNimbus(Entity playerEntity)
		return self:CanStartNimbus(playerEntity)
	end

	@ExecSpace("ClientOnly")
	method boolean IsBattleMap(Entity playerEntity)
		if playerEntity == nil then
			return false
		end
		local mapName = self:ReadString(playerEntity.CurrentMapName, "")
		if mapName == "" then
			return false
		end
		return _EntityService:GetEntityByPath("/maps/" .. mapName .. "/BattleLogic") ~= nil
	end

	@ExecSpace("ClientOnly")
	method void CaptureNimbusBackup(Entity playerEntity)
		if playerEntity == nil or playerEntity.RigidbodyComponent == nil then
			return
		end
		self._T.localNimbusBackup = {
			KinematicMove = playerEntity.RigidbodyComponent.KinematicMove,
			Gravity = playerEntity.RigidbodyComponent.Gravity,
			IgnoreMoveBoundary = playerEntity.RigidbodyComponent.IgnoreMoveBoundary,
			EnableKinematicMoveJump = playerEntity.RigidbodyComponent.EnableKinematicMoveJump,
			KinematicMoveAcceleration = playerEntity.RigidbodyComponent.KinematicMoveAcceleration,
			MoveVelocity = playerEntity.RigidbodyComponent.MoveVelocity,
			InputSpeed = nil,
			PlayerControllerEnable = nil
		}
		if playerEntity.MovementComponent ~= nil then
			self._T.localNimbusBackup.InputSpeed = playerEntity.MovementComponent.InputSpeed
		end
		if playerEntity.PlayerControllerComponent ~= nil then
			self._T.localNimbusBackup.PlayerControllerEnable = playerEntity.PlayerControllerComponent.Enable
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyNimbusMovement(Entity playerEntity, boolean resetVelocity)
		if playerEntity == nil or playerEntity.RigidbodyComponent == nil then
			return
		end
		if playerEntity.PlayerControllerComponent ~= nil then
			playerEntity.PlayerControllerComponent.Enable = false
		end
		playerEntity.RigidbodyComponent.KinematicMove = true
		playerEntity.RigidbodyComponent.Gravity = 0
		playerEntity.RigidbodyComponent.IgnoreMoveBoundary = true
		playerEntity.RigidbodyComponent.EnableKinematicMoveJump = false
		local speed = self:GetNimbusMoveSpeed()
		playerEntity.RigidbodyComponent.KinematicMoveAcceleration = Vector2(speed, speed)
		if resetVelocity == true then
			playerEntity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
		end
		if playerEntity.MovementComponent ~= nil then
			playerEntity.MovementComponent.InputSpeed = speed
			if resetVelocity == true then
				playerEntity.MovementComponent:Stop()
			end
		end
		if resetVelocity == true then
			self:SetNimbusRidePosition(self:GetEntityPosition2(playerEntity))
			playerEntity.RigidbodyComponent:PositionReset()
		end
	end

	@ExecSpace("ClientOnly")
	method void DriveNimbusMovement(Entity playerEntity, number dx, number dy, number speed, number deltaSeconds)
		if playerEntity == nil or playerEntity.RigidbodyComponent == nil then
			return
		end
		local moveX = self:ReadNumber(dx, 0)
		local moveY = self:ReadNumber(dy, 0)
		local safeSpeed = math.max(0.1, self:ReadNumber(speed, self.NimbusMoveSpeed))
		if math.abs(moveX) <= 0.001 and math.abs(moveY) <= 0.001 then
			local holdPosition = self:GetNimbusRidePosition(playerEntity)
			playerEntity.RigidbodyComponent:SetWorldPosition(holdPosition)
			playerEntity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			if playerEntity.MovementComponent ~= nil then
				playerEntity.MovementComponent:Stop()
			end
			return
		end

		local safeDelta = math.min(0.05, math.max(0, self:ReadNumber(deltaSeconds, 0)))
		local direction = Vector2(moveX, moveY)
		local position = self:GetNimbusRidePosition(playerEntity)
		local nextPosition = Vector2(position.x + moveX * safeSpeed * safeDelta, position.y + moveY * safeSpeed * safeDelta)
		playerEntity.RigidbodyComponent.KinematicMoveAcceleration = Vector2(safeSpeed, safeSpeed)
		playerEntity.RigidbodyComponent:SetWorldPosition(nextPosition)
		if playerEntity.MovementComponent ~= nil then
			playerEntity.MovementComponent.InputSpeed = safeSpeed
		end
		playerEntity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
		self:SetNimbusRidePosition(nextPosition)
		self:LogNimbusMoveSample(playerEntity, direction, safeSpeed)
	end

	@ExecSpace("ClientOnly")
	method void LogNimbusMoveSample(Entity playerEntity, Vector2 direction, number speed)
		if self.VerboseLog ~= true then
			return
		end
		local now = _UtilLogic.ElapsedSeconds
		if now < self:ReadNumber(self._T.nextNimbusMoveLogAt, 0) then
			return
		end
		self._T.nextNimbusMoveLogAt = now + 1
		local position = self:GetNimbusRidePosition(playerEntity)
		local actualPosition = self:GetEntityPosition2(playerEntity)
		log("[BRCommonSkill] nimbus ride move dir=(" .. tostring(direction.x) .. "," .. tostring(direction.y) .. ") speed=" .. tostring(speed) .. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ") actual=(" .. tostring(actualPosition.x) .. "," .. tostring(actualPosition.y) .. ")")
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetNimbusRidePosition(Entity playerEntity)
		-- Keeps Nimbus movement independent from transient physics correction when direction changes.
		local cachedPosition = self._T.localNimbusPosition
		if cachedPosition ~= nil then
			return Vector2(self:ReadNumber(cachedPosition.x, 0), self:ReadNumber(cachedPosition.y, 0))
		end
		local position = self:GetEntityPosition2(playerEntity)
		self:SetNimbusRidePosition(position)
		return position
	end

	@ExecSpace("ClientOnly")
	method void SetNimbusRidePosition(Vector2 position)
		if position == nil then
			return
		end
		self._T.localNimbusPosition = Vector2(position.x, position.y)
	end

	@ExecSpace("ClientOnly")
	method void LogNimbusMoveBlocked(any bounds, Vector2 position, number oldDx, number oldDy, number dx, number dy)
		local now = _UtilLogic.ElapsedSeconds
		if now < self:ReadNumber(self._T.nextNimbusBlockedLogAt, 0) then
			return
		end
		self._T.nextNimbusBlockedLogAt = now + 0.6
		local safePosition = position
		if safePosition == nil then
			safePosition = Vector2(0, 0)
		end
		log("[BRCommonSkill] nimbus ride edge bounds=" .. self:GetBoundsLabel(bounds) .. " pos=(" .. tostring(safePosition.x) .. "," .. tostring(safePosition.y) .. ") input=(" .. tostring(oldDx) .. "," .. tostring(oldDy) .. ") applied=(" .. tostring(dx) .. "," .. tostring(dy) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void RestoreNimbusMovement(Entity playerEntity)
		if playerEntity == nil or playerEntity.RigidbodyComponent == nil then
			return
		end
		local backup = self._T.localNimbusBackup
		if backup ~= nil then
			playerEntity.RigidbodyComponent.KinematicMove = backup.KinematicMove == true
			playerEntity.RigidbodyComponent.Gravity = self:ReadNumber(backup.Gravity, 1)
			playerEntity.RigidbodyComponent.IgnoreMoveBoundary = backup.IgnoreMoveBoundary == true
			playerEntity.RigidbodyComponent.EnableKinematicMoveJump = backup.EnableKinematicMoveJump ~= false
			if backup.KinematicMoveAcceleration ~= nil then
				playerEntity.RigidbodyComponent.KinematicMoveAcceleration = backup.KinematicMoveAcceleration
			end
			playerEntity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			if playerEntity.MovementComponent ~= nil and backup.InputSpeed ~= nil then
				playerEntity.MovementComponent.InputSpeed = self:ReadNumber(backup.InputSpeed, playerEntity.MovementComponent.InputSpeed)
				playerEntity.MovementComponent:Stop()
			end
			if playerEntity.PlayerControllerComponent ~= nil and backup.PlayerControllerEnable ~= nil then
				playerEntity.PlayerControllerComponent.Enable = backup.PlayerControllerEnable == true
			end
		else
			playerEntity.RigidbodyComponent.KinematicMove = false
			playerEntity.RigidbodyComponent.Gravity = 1
			playerEntity.RigidbodyComponent.EnableKinematicMoveJump = true
			playerEntity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			if playerEntity.PlayerControllerComponent ~= nil then
				playerEntity.PlayerControllerComponent.Enable = true
			end
		end
		playerEntity.RigidbodyComponent:PositionReset()
		self._T.localNimbusBackup = nil
		self._T.localNimbusPosition = nil
	end

	@ExecSpace("ClientOnly")
	method void CaptureNimbusRideBounds(Entity playerEntity)
		-- Saves the room/map area that Nimbus may fly inside without triggering center-return.
		local position = self:GetEntityPosition2(playerEntity)
		self:SetNimbusRidePosition(position)
		local bounds = self:BuildNimbusRideBounds(playerEntity, position)
		self._T.localNimbusRideBounds = bounds
		if self.VerboseLog == true and bounds ~= nil then
			log("[BRCommonSkill] nimbus ride bounds=" .. self:GetBoundsLabel(bounds))
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearNimbusRideBounds()
		self._T.localNimbusRideBounds = nil
		self._T.localNimbusPosition = nil
	end

	@ExecSpace("ClientOnly")
	method any GetNimbusMovementBounds(Entity playerEntity, Vector2 position)
		local bounds = self._T.localNimbusRideBounds
		if bounds ~= nil then
			return bounds
		end
		bounds = self:BuildNimbusRideBounds(playerEntity, position)
		self._T.localNimbusRideBounds = bounds
		return bounds
	end

	@ExecSpace("ClientOnly")
	method any BuildNimbusRideBounds(Entity playerEntity, Vector2 position)
		local bounds = nil
		if self.RestrictNimbusToCurrentRoom == true then
			bounds = self:GetCurrentPhysicalRoomBounds(playerEntity, position)
		end
		if bounds == nil then
			bounds = self:GetMapBounds(playerEntity)
		end
		return self:CopyBounds(bounds)
	end

	@ExecSpace("ClientOnly")
	method any CopyBounds(any bounds)
		if bounds == nil then
			return nil
		end
		local padding = self:GetNimbusRoomBoundsPadding()
		local left = self:ReadNumber(bounds.Left, 0) + padding
		local right = self:ReadNumber(bounds.Right, 0) - padding
		local bottom = self:ReadNumber(bounds.Bottom, 0) + padding
		local top = self:ReadNumber(bounds.Top, 0) - padding
		if right < left then
			local midX = (left + right) * 0.5
			left = midX
			right = midX
		end
		if top < bottom then
			local midY = (bottom + top) * 0.5
			bottom = midY
			top = midY
		end
		return {
			Left = left,
			Right = right,
			Bottom = bottom,
			Top = top,
			RoomName = self:ReadString(bounds.RoomName, "map")
		}
	end

	@ExecSpace("ClientOnly")
	method Vector2 ClampPositionToBounds(Vector2 position, any bounds)
		if position == nil then
			return Vector2(0, 0)
		end
		if bounds == nil then
			return position
		end
		return Vector2(
			math.max(self:ReadNumber(bounds.Left, position.x), math.min(self:ReadNumber(bounds.Right, position.x), position.x)),
			math.max(self:ReadNumber(bounds.Bottom, position.y), math.min(self:ReadNumber(bounds.Top, position.y), position.y))
		)
	end

	@ExecSpace("ClientOnly")
	method string GetBoundsLabel(any bounds)
		if bounds == nil then
			return "none"
		end
		return self:ReadString(bounds.RoomName, "map")
			.. "["
			.. tostring(self:ReadNumber(bounds.Left, 0)) .. ","
			.. tostring(self:ReadNumber(bounds.Bottom, 0)) .. " "
			.. tostring(self:ReadNumber(bounds.Right, 0)) .. ","
			.. tostring(self:ReadNumber(bounds.Top, 0)) .. "]"
	end

	@ExecSpace("ClientOnly")
	method void PlayNimbusVisual(Entity playerEntity, boolean active)
		-- Plays Nimbus ride start, loop, and end feedback.
		if playerEntity == nil then
			if active ~= true then
				self:StopNimbusEffect()
			end
			return
		end
		if active == true then
			self:PlayNimbusUseSound()
			self:StartNimbusEffect(playerEntity)
		else
			self:StopNimbusEffect()
			self:PlayNimbusEndEffect(playerEntity)
			self:PlayNimbusEndSound()
		end
		if self.NimbusUseFlyAnimation ~= true then
			return
		end
		local actionState = MapleAvatarBodyActionState.Stand
		if active == true then
			actionState = MapleAvatarBodyActionState.Fly
		end
		playerEntity:SendEvent(BodyActionStateChangeEvent(true, actionState, 0, 2147483647, 1))
	end

	@ExecSpace("ClientOnly")
	method void StartNimbusEffect(Entity playerEntity)
		-- Starts the looping cloud ride effect attached to the player.
		if math.floor(self:ReadNumber(self.localNimbusEffectSerial, 0)) > 0 then
			return
		end
		if playerEntity == nil or _EffectService == nil then
			return
		end

		local ruid = self:GetNimbusEffectRUID("repeat", self.NimbusEffectRUID)
		if ruid == "" then
			return
		end

		local scale = math.max(0.05, self:ReadNumber(self.NimbusEffectScale, 0.68))
		local alpha = math.max(0, math.min(1, self:ReadNumber(self.NimbusEffectAlpha, 0.95)))
		local options = {}
		options["SortingLayer"] = "MapLayer0"
		options["OrderInLayer"] = math.floor(self:ReadNumber(self.NimbusEffectOrderInLayer, 20))
		options["Alpha"] = alpha
		options["PlayRate"] = math.max(0.1, self:ReadNumber(self.NimbusEffectPlayRate, 1.0))
		options["IgnoreMapLayerCheck"] = true
		-- Loop only the steady-ride frames (skip the 0-7 form-in and the 22->0 snap) so the attached
		-- cloud stays seamless instead of re-appearing/disappearing every loop cycle.
		options["StartFrameIndex"] = math.max(0, math.floor(self:ReadNumber(self.NimbusEffectLoopStartFrame, 8)))
		options["EndFrameIndex"] = math.max(0, math.floor(self:ReadNumber(self.NimbusEffectLoopEndFrame, 22)))

		local serial = _EffectService:PlayEffectAttached(
			ruid,
			playerEntity,
			Vector3(self:ReadNumber(self.NimbusEffectLocalX, 0), self:ReadNumber(self.NimbusEffectLocalY, -0.34), 0),
			0,
			Vector3(scale, scale, 1),
			true,
			options
		)
		self.localNimbusEffectSerial = math.floor(self:ReadNumber(serial, 0))
		if self.localNimbusEffectSerial <= 0 then
			log("[BRCommonSkill] nimbus effect failed ruid=" .. ruid)
		else
			log("[BRCommonSkill] nimbus effect start ruid=" .. ruid .. " serial=" .. tostring(self.localNimbusEffectSerial))
		end
	end

	@ExecSpace("ClientOnly")
	method void StopNimbusEffect()
		-- Removes the currently attached Nimbus loop effect.
		local serial = math.floor(self:ReadNumber(self.localNimbusEffectSerial, 0))
		if serial <= 0 then
			self.localNimbusEffectSerial = 0
			return
		end
		if _EffectService ~= nil then
			_EffectService:RemoveEffect(serial)
		end
		self.localNimbusEffectSerial = 0
		log("[BRCommonSkill] nimbus effect stop serial=" .. tostring(serial))
	end

	@ExecSpace("ClientOnly")
	method void PlayNimbusEndEffect(Entity playerEntity)
		-- Plays the one-shot cloud disappearance effect at the player position.
		if playerEntity == nil or _EffectService == nil then
			return
		end
		local ruid = self:GetNimbusEffectRUID("end", self.NimbusEndEffectRUID)
		if ruid == "" then
			return
		end
		local position = self:GetEntityPosition2(playerEntity)
		local scale = math.max(0.05, self:ReadNumber(self.NimbusEffectScale, 0.68))
		local alpha = math.max(0, math.min(1, self:ReadNumber(self.NimbusEffectAlpha, 0.95)))
		local options = {}
		options["SortingLayer"] = "MapLayer0"
		options["OrderInLayer"] = math.floor(self:ReadNumber(self.NimbusEffectOrderInLayer, 20))
		options["Alpha"] = alpha
		options["PlayRate"] = math.max(0.1, self:ReadNumber(self.NimbusEffectPlayRate, 1.0))
		options["IgnoreMapLayerCheck"] = true
		local localX = self:ReadNumber(self.NimbusEffectLocalX, 0)
		local localY = self:ReadNumber(self.NimbusEffectLocalY, -0.34)
		local serial = _EffectService:PlayEffect(
			ruid,
			playerEntity,
			Vector3(position.x + localX, position.y + localY, 0),
			0,
			Vector3(scale, scale, 1),
			false,
			options
		)
		if self.VerboseLog == true then
			log("[BRCommonSkill] nimbus end effect ruid=" .. ruid .. " serial=" .. tostring(serial))
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayNimbusUseSound()
		-- Plays the Nimbus use sound locally.
		self:PlayNimbusSound(self:GetNimbusUseSoundRUID())
	end

	@ExecSpace("ClientOnly")
	method void PlayNimbusEndSound()
		-- Plays the Nimbus end voice locally.
		self:PlayNimbusSound(self:GetNimbusEndSoundRUID())
	end

	@ExecSpace("ClientOnly")
	method void PlayNimbusSound(string ruid)
		-- Plays one local Nimbus audio resource.
		if _SoundService == nil then
			return
		end
		local safeRuid = self:ReadString(ruid, "")
		if safeRuid == "" then
			return
		end
		_SoundService:PlaySound(safeRuid, math.max(0, self:ReadNumber(self.NimbusSoundVolume, 0.9)))
	end

	@ExecSpace("Server")
	method void SetNimbusActiveServer(boolean active)
		self:EnsureRuntime()
		local userId = self:ReadString(senderUserId, "")
		if userId == "" then
			return
		end
		self._T.serverNimbusByUserId[userId] = active == true
		self:Log("nimbus server user=" .. userId .. " active=" .. tostring(active == true))
	end

	method boolean IsNimbusActiveForUser(string userId)
		self:EnsureRuntime()
		return self._T.serverNimbusByUserId[self:ReadString(userId, "")] == true
	end

	@ExecSpace("Client")
	method boolean IsLocalNimbusActive()
		return self.localNimbusActive == true
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetEntityPosition2(Entity entity)
		-- Reads an entity world position as Vector2.
		if entity == nil or entity.TransformComponent == nil then
			return Vector2(0, 0)
		end
		local position = entity.TransformComponent.WorldPosition
		return Vector2(position.x, position.y)
	end

	@ExecSpace("ClientOnly")
	method Entity GetEntityMap(Entity entity)
		-- Resolves the current map entity for local player movement helpers.
		if entity == nil then
			return nil
		end
		if entity.CurrentMap ~= nil then
			return entity.CurrentMap
		end
		local mapName = self:ReadString(entity.CurrentMapName, "")
		if mapName == "" then
			return nil
		end
		return _EntityService:GetEntityByPath("/maps/" .. mapName)
	end

	@ExecSpace("ClientOnly")
	method Vector2 ClampPositionToMapBounds(Entity entity, Vector2 position)
		-- Clamps a world position to the current map's playable custom bound.
		if position == nil then
			return Vector2(0, 0)
		end
		local bounds = self:GetMapBounds(entity)
		if bounds == nil then
			return position
		end
		return Vector2(
			math.max(bounds.Left, math.min(bounds.Right, position.x)),
			math.max(bounds.Bottom, math.min(bounds.Top, position.y))
		)
	end

	@ExecSpace("ClientOnly")
	method boolean IsPositionOutsideMapBounds(Entity entity, Vector2 position, number padding)
		-- Checks whether a world position is outside the current map's custom bound.
		if position == nil then
			return false
		end
		local bounds = self:GetMapBounds(entity)
		if bounds == nil then
			return false
		end
		local pad = math.max(0, self:ReadNumber(padding, 0))
		return position.x < bounds.Left - pad
			or position.x > bounds.Right + pad
			or position.y < bounds.Bottom - pad
			or position.y > bounds.Top + pad
	end

	@ExecSpace("ClientOnly")
	method any GetMapBounds(Entity entity)
		-- Reads the map-part custom bound used by the camera clamp.
		if entity == nil then
			return nil
		end
		local mapEntity = entity.CurrentMap
		if mapEntity == nil then
			local mapName = self:ReadString(entity.CurrentMapName, "")
			if mapName ~= "" then
				mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
			end
		end
		if mapEntity == nil or mapEntity.MapComponent == nil or mapEntity.MapComponent.UseCustomBound ~= true then
			return nil
		end
		local leftBottom = mapEntity.MapComponent.LeftBottom
		local rightTop = mapEntity.MapComponent.RightTop
		if leftBottom == nil or rightTop == nil or rightTop.x <= leftBottom.x or rightTop.y <= leftBottom.y then
			return nil
		end
		return {
			Left = leftBottom.x,
			Bottom = leftBottom.y,
			Right = rightTop.x,
			Top = rightTop.y
		}
	end

	@ExecSpace("ClientOnly")
	method number GetFacingDirection(Entity entity)
		-- Reads the player's current horizontal facing direction.
		if entity ~= nil and entity.PlayerControllerComponent ~= nil then
			local value = tonumber(entity.PlayerControllerComponent.LookDirectionX)
			if value ~= nil and value < 0 then
				return -1
			end
		end
		if entity ~= nil and entity.SpriteRendererComponent ~= nil and entity.SpriteRendererComponent.FlipX == true then
			return -1
		end
		return 1
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetBlinkInputDirection(Entity entity)
		-- Converts current arrow-key input into a straight teleport direction.
		local dx = 0
		local dy = 0
		if _InputService:IsKeyPressed(KeyboardKey.RightArrow) == true then
			dx = 1
		elseif _InputService:IsKeyPressed(KeyboardKey.LeftArrow) == true then
			dx = -1
		end
		if dx ~= 0 then
			return Vector2(dx, 0)
		end
		if _InputService:IsKeyPressed(KeyboardKey.UpArrow) == true then
			dy = 1
		elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) == true then
			dy = -1
		end
		if dy ~= 0 then
			return Vector2(0, dy)
		end
		return Vector2(self:GetFacingDirection(entity), 0)
	end

	@ExecSpace("ClientOnly")
	method Vector2 ResolveBlinkTarget(Entity entity, Vector2 currentPosition, Vector2 requestedTarget)
		-- Uses self-teleport when the requested straight-line target is outside playable bounds or has no landing foothold.
		if currentPosition == nil then
			currentPosition = Vector2(0, 0)
		end
		if requestedTarget == nil then
			return currentPosition
		end
		if self:IsBlinkTargetOutsideCurrentRoom(entity, currentPosition, requestedTarget) == true then
			return currentPosition
		end
		if self:IsPositionOutsideMapBounds(entity, requestedTarget, 0) == true then
			return currentPosition
		end

		local adjustedTarget = self:ResolveBlinkFootholdTarget(entity, currentPosition, requestedTarget)
		if adjustedTarget == nil then
			log("[BRCommonSkill] burstStep blocked reason=noFoothold target=(" .. tostring(requestedTarget.x) .. "," .. tostring(requestedTarget.y) .. ")")
			return currentPosition
		end
		if self:IsBlinkTargetOutsideCurrentRoom(entity, currentPosition, adjustedTarget) == true then
			return currentPosition
		end
		if self:IsPositionOutsideMapBounds(entity, adjustedTarget, 0) == true then
			return currentPosition
		end
		return adjustedTarget
	end

	@ExecSpace("ClientOnly")
	method any ResolveBlinkFootholdTarget(Entity entity, Vector2 currentPosition, Vector2 requestedTarget)
		-- Snaps Burst Step to the foothold under the requested target, matching Maple-style teleport landings.
		if requestedTarget == nil then
			return currentPosition
		end
		if self.SnapBlinkToFoothold ~= true then
			return requestedTarget
		end
		local mapEntity = self:GetEntityMap(entity)
		if mapEntity == nil or mapEntity.FootholdComponent == nil then
			return requestedTarget
		end

		local footholdPosition = self:FindBlinkFootholdPosition(mapEntity, requestedTarget)
		if footholdPosition == nil then
			return nil
		end
		if math.abs(footholdPosition.y - requestedTarget.y) > 0.001 then
			log("[BRCommonSkill] burstStep foothold snap from=(" .. tostring(requestedTarget.x) .. "," .. tostring(requestedTarget.y) .. ") to=(" .. tostring(footholdPosition.x) .. "," .. tostring(footholdPosition.y) .. ")")
		end
		return footholdPosition
	end

	@ExecSpace("ClientOnly")
	method any FindBlinkFootholdPosition(Entity mapEntity, Vector2 requestedTarget)
		-- Finds a valid foothold landing point below the requested Burst Step target.
		if mapEntity == nil or mapEntity.FootholdComponent == nil or requestedTarget == nil then
			return nil
		end
		local up = math.max(0, self:ReadNumber(self.BlinkFootholdSearchUp, 0.8))
		local down = math.max(0.1, self:ReadNumber(self.BlinkFootholdSearchDown, 4.0))
		local searchDistance = up + down
		local rayStart = Vector2(requestedTarget.x, requestedTarget.y + up)
		local hits = mapEntity.FootholdComponent:RaycastAll(rayStart, Vector2(0, -1), searchDistance)
		if hits ~= nil then
			for index, foothold in ipairs(hits) do
				local position = self:GetBlinkFootholdLandingPosition(foothold, requestedTarget.x)
				if position ~= nil then
					return position
				end
			end
		end

		local foothold = mapEntity.FootholdComponent:Raycast(rayStart, Vector2(0, -1), searchDistance)
		return self:GetBlinkFootholdLandingPosition(foothold, requestedTarget.x)
	end

	@ExecSpace("ClientOnly")
	method any GetBlinkFootholdLandingPosition(any foothold, number x)
		-- Converts one foothold hit into a safe standing position.
		if foothold == nil or self:IsUsableBlinkFoothold(foothold, x) ~= true then
			return nil
		end
		return Vector2(x, foothold:GetYByX(x) + self:GetBlinkFootholdYOffset())
	end

	@ExecSpace("ClientOnly")
	method boolean IsUsableBlinkFoothold(any foothold, number x)
		-- Rejects vertical or out-of-range footholds for Burst Step landing.
		if foothold == nil then
			return false
		end
		if foothold:IsVertical() == true then
			return false
		end
		local startPoint = foothold.StartPoint
		local endPoint = foothold.EndPoint
		if startPoint == nil or endPoint == nil then
			return true
		end
		local minX = math.min(startPoint.x, endPoint.x) - 0.02
		local maxX = math.max(startPoint.x, endPoint.x) + 0.02
		local safeX = self:ReadNumber(x, 0)
		return safeX >= minX and safeX <= maxX
	end

	@ExecSpace("ClientOnly")
	method boolean IsBlinkTargetOutsideCurrentRoom(Entity entity, Vector2 currentPosition, Vector2 requestedTarget)
		-- Checks the current generated room rectangle before allowing a blink target.
		if self.RestrictBlinkToCurrentRoom ~= true then
			return false
		end
		if requestedTarget == nil then
			return false
		end
		local bounds = self:GetCurrentPhysicalRoomBounds(entity, currentPosition)
		if bounds == nil then
			return false
		end
		return self:IsPositionInsideBounds(requestedTarget, bounds, 0.05) ~= true
	end

	@ExecSpace("ClientOnly")
	method any GetCurrentPhysicalRoomBounds(Entity entity, Vector2 currentPosition)
		-- Resolves the physical room rectangle containing the local player.
		if entity == nil or currentPosition == nil or _BRRoomGraphGenerator == nil then
			return nil
		end
		local mapName = self:ReadString(entity.CurrentMapName, "")
		if mapName == "" then
			return nil
		end
		local publishedMapName = self:ReadString(_BRRoomGraphGenerator.LastMiniMapMapName, "")
		if publishedMapName ~= "" and publishedMapName ~= mapName then
			return nil
		end
		local halfSize = self:GetPhysicalRoomHalfSize(mapName)
		local assignments = self:ParseMiniMapAssignments(self:ReadString(_BRRoomGraphGenerator.LastMiniMapAssignments, ""))
		for key, roomName in pairs(assignments) do
			local bounds = self:GetPhysicalRoomBounds(mapName, roomName, halfSize)
			if bounds ~= nil and self:IsPositionInsideBounds(currentPosition, bounds, 0.05) == true then
				return bounds
			end
		end
		return self:FindGeneratedRoomBoundsByPosition(mapName, currentPosition, halfSize)
	end

	@ExecSpace("ClientOnly")
	method any FindGeneratedRoomBoundsByPosition(string mapName, Vector2 position, Vector2 halfSize)
		-- Falls back to scanning generated room entities when minimap assignments are not ready.
		local root = self:GetPhysicalRoomRoot(mapName)
		if root == nil or root.Children == nil then
			return nil
		end
		local children = root.Children:ToTable()
		for index, child in ipairs(children) do
			if child ~= nil and self:IsGeneratedRoomName(child.Name) == true then
				local bounds = self:BuildPhysicalRoomBounds(child, halfSize)
				if bounds ~= nil and self:IsPositionInsideBounds(position, bounds, 0.05) == true then
					return bounds
				end
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method any GetPhysicalRoomBounds(string mapName, string roomName, Vector2 halfSize)
		-- Builds a rectangular world bound from a generated room entity.
		local room = self:GetPhysicalRoom(mapName, roomName)
		return self:BuildPhysicalRoomBounds(room, halfSize)
	end

	@ExecSpace("ClientOnly")
	method any BuildPhysicalRoomBounds(Entity room, Vector2 halfSize)
		-- Converts one physical room center and half size into bounds.
		if room == nil or room.TransformComponent == nil or halfSize == nil then
			return nil
		end
		local center = room.TransformComponent.WorldPosition
		return {
			Left = center.x - halfSize.x,
			Right = center.x + halfSize.x,
			Bottom = center.y - halfSize.y,
			Top = center.y + halfSize.y,
			RoomName = self:ReadString(room.Name, "")
		}
	end

	@ExecSpace("ClientOnly")
	method Entity GetPhysicalRoom(string mapName, string roomName)
		-- Finds a generated physical room by name.
		local safeRoomName = self:ReadString(roomName, "")
		if safeRoomName == "" then
			return nil
		end
		local root = self:GetPhysicalRoomRoot(mapName)
		if root ~= nil then
			local room = root:GetChildByName(safeRoomName, false)
			if room ~= nil then
				return room
			end
		end
		return _EntityService:GetEntityByPath("/maps/" .. self:ReadString(mapName, "RoomTestMap") .. "/EditorGeneratedGrid/" .. safeRoomName)
	end

	@ExecSpace("ClientOnly")
	method Entity GetPhysicalRoomRoot(string mapName)
		-- Finds the generated physical room root for one map.
		return _EntityService:GetEntityByPath("/maps/" .. self:ReadString(mapName, "RoomTestMap") .. "/EditorGeneratedGrid")
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetPhysicalRoomHalfSize(string mapName)
		-- Reads generated room half extents from the room graph when available.
		if _BRRoomGraphGenerator ~= nil then
			return _BRRoomGraphGenerator:GetRoomHalfSize(mapName)
		end
		return Vector2(5, 5)
	end

	@ExecSpace("ClientOnly")
	method any ParseMiniMapAssignments(string assignmentsText)
		-- Parses row,column,roomName records into a compact room-name lookup.
		local result = {}
		local value = self:ReadString(assignmentsText, "")
		for record in string.gmatch(value, "([^;]+)") do
			local parts = self:SplitCommaRecord(record)
			local roomName = self:ReadString(parts[3], "")
			if roomName ~= "" then
				result[self:ReadString(parts[1], "") .. ":" .. self:ReadString(parts[2], "")] = roomName
			end
		end
		return result
	end

	@ExecSpace("ClientOnly")
	method any SplitCommaRecord(string record)
		-- Splits one comma-delimited minimap record into ordered fields.
		local parts = {}
		for part in string.gmatch(self:ReadString(record, ""), "([^,]+)") do
			table.insert(parts, part)
		end
		return parts
	end

	@ExecSpace("ClientOnly")
	method boolean IsGeneratedRoomName(string roomName)
		-- Checks the generated room naming convention.
		return string.sub(self:ReadString(roomName, ""), 1, 5) == "Room_"
	end

	@ExecSpace("ClientOnly")
	method boolean IsPositionInsideBounds(Vector2 position, any bounds, number padding)
		-- Tests whether a point belongs to a rectangular world bound.
		if position == nil or bounds == nil then
			return false
		end
		local pad = math.max(0, self:ReadNumber(padding, 0))
		return position.x >= self:ReadNumber(bounds.Left, 0) - pad
			and position.x <= self:ReadNumber(bounds.Right, 0) + pad
			and position.y >= self:ReadNumber(bounds.Bottom, 0) - pad
			and position.y <= self:ReadNumber(bounds.Top, 0) + pad
	end

	@ExecSpace("ClientOnly")
	method void PlayBlinkVisual(Entity playerEntity, Vector2 fromPosition, Vector2 toPosition, Vector2 direction, boolean moved)
		-- Plays the Burst Step sound and start/end effects for local feedback.
		self:PlayBlinkSound(playerEntity)
		local safeDirection = direction
		if safeDirection == nil then
			safeDirection = Vector2(1, 0)
		end
		local startRuid = self:GetBlinkEffectRUID("effect1", self.BlinkEndEffectRUID)
		local endRuid = self:GetBlinkEffectRUID("effect0", self.BlinkStartEffectRUID)
		local blockedRuid = self:GetBlinkEffectRUID("special", self.BlinkBlockedEffectRUID)
		if fromPosition ~= nil then
			self:PlayBlinkEffectAt(playerEntity, startRuid, fromPosition, safeDirection)
		end
		if moved == true and toPosition ~= nil then
			self:PlayBlinkEffectAt(playerEntity, endRuid, toPosition, safeDirection)
		elseif fromPosition ~= nil then
			self:PlayBlinkEffectAt(playerEntity, blockedRuid, fromPosition, safeDirection)
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayBlinkSound(Entity playerEntity)
		-- Plays the Burst Step use sound locally.
		if _SoundService == nil then
			return
		end
		local ruid = self:GetBlinkSoundRUID()
		if ruid == "" then
			return
		end
		_SoundService:PlaySound(ruid, math.max(0, self:ReadNumber(self.BlinkSoundVolume, 0.9)))
	end

	@ExecSpace("ClientOnly")
	method void PlayBlinkEffectAt(Entity playerEntity, string ruid, Vector2 position, Vector2 direction)
		-- Plays a Burst Step animationclip at a fixed world position.
		if _EffectService == nil or playerEntity == nil then
			return
		end
		local safeRuid = self:ReadString(ruid, "")
		if safeRuid == "" or position == nil then
			return
		end
		local scale = math.max(0.05, self:ReadNumber(self.BlinkEffectScale, 1.0))
		local alpha = math.max(0, math.min(1, self:ReadNumber(self.BlinkEffectAlpha, 0.95)))
		local options = {}
		options["SortingLayer"] = "MapLayer0"
		options["OrderInLayer"] = math.floor(self:ReadNumber(self.BlinkEffectOrderInLayer, 30))
		options["Alpha"] = alpha
		options["PlayRate"] = math.max(0.1, self:ReadNumber(self.BlinkEffectPlayRate, 1.0))
		options["IgnoreMapLayerCheck"] = true
		if direction ~= nil and direction.x > 0 then
			options["FlipX"] = true
		end
		local serial = _EffectService:PlayEffect(safeRuid, playerEntity, Vector3(position.x, position.y, 0), 0, Vector3(scale, scale, 1), false, options)
		if self.VerboseLog == true and math.floor(self:ReadNumber(serial, 0)) <= 0 then
			log("[BRCommonSkill] burstStep effect failed ruid=" .. safeRuid)
		end
	end

	method void EnsureRuntime()
		if self._T.serverNimbusByUserId == nil then
			self._T.serverNimbusByUserId = {}
		end
	end

	method string GetSkillDataCell(string skillKey, string columnName, string fallback)
		-- Reads one cell from the CSV-backed skills table.
		local data = self:GetDataTable("skills")
		if data == nil then
			return self:ReadString(fallback, "")
		end
		local row = self:GetDataRowIndex(data, "id", self:ReadString(skillKey, ""))
		if row <= 0 then
			return self:ReadString(fallback, "")
		end
		return self:GetDataCell(data, row, columnName, fallback)
	end

	method string GetBlinkSkillDataCell(string columnName, string fallback)
		-- Reads one cell from the CSV-backed Blink skill row.
		return self:GetSkillDataCell(self:GetBlinkSkillKey(), columnName, fallback)
	end

	method string GetBlinkSkillKey()
		-- Returns the common blink skill id used by CSV tables.
		return self:ReadString(self.BlinkSkillKey, "Blink")
	end

	method string GetBlinkSoundRUID()
		-- Returns the Burst Step sound RUID from CSV or property fallback.
		return self:GetBlinkSkillDataCell("sound_ruid", self.BlinkSoundRUID)
	end

	method string GetBlinkEffectRUID(string suffix, string fallback)
		-- Resolves a Burst Step effect RUID through effects.csv.
		local safeSuffix = self:ReadString(suffix, "")
		local skillKey = self:GetBlinkSkillKey()
		if safeSuffix ~= "" then
			local exactRuid = self:GetEffectRUIDByEffectId(skillKey .. "/" .. safeSuffix, "")
			if exactRuid ~= "" then
				return exactRuid
			end
		end
		local effectIds = self:ParseDelimitedList(self:GetBlinkSkillDataCell("effect_ids", ""), "|")
		for index, effectId in ipairs(effectIds) do
			local ruid = self:GetEffectRUIDByEffectId(effectId, "")
			if ruid ~= "" then
				return ruid
			end
		end
		return self:ReadString(fallback, self.BlinkEffectRUID)
	end

	method string GetNimbusSkillDataCell(string columnName, string fallback)
		-- Reads one cell from the CSV-backed Nimbus skill row.
		return self:GetSkillDataCell(self:GetNimbusSkillKey(), columnName, fallback)
	end

	method string GetNimbusSkillKey()
		-- Returns the common Nimbus skill id used by CSV tables.
		return self:ReadString(self.NimbusSkillKey, "Nimbus")
	end

	method string GetNimbusUseSoundRUID()
		-- Returns the Nimbus use sound RUID from CSV or property fallback.
		return self:GetNimbusSkillDataCell("sound_ruid", self.NimbusUseSoundRUID)
	end

	method string GetNimbusEndSoundRUID()
		-- Returns the Nimbus end sound RUID from CSV or property fallback.
		return self:GetNimbusSkillDataCell("end_sound_ruid", self.NimbusEndSoundRUID)
	end

	method string GetNimbusEffectRUID(string suffix, string fallback)
		-- Resolves a Nimbus effect RUID through effects.csv.
		local safeSuffix = self:ReadString(suffix, "")
		local skillKey = self:GetNimbusSkillKey()
		if safeSuffix ~= "" then
			local exactRuid = self:GetEffectRUIDByEffectId(skillKey .. "/" .. safeSuffix, "")
			if exactRuid ~= "" then
				return exactRuid
			end
		end
		local effectIds = self:ParseDelimitedList(self:GetNimbusSkillDataCell("effect_ids", ""), "|")
		for index, effectId in ipairs(effectIds) do
			local ruid = self:GetEffectRUIDByEffectId(effectId, "")
			if ruid ~= "" then
				return ruid
			end
		end
		return self:ReadString(fallback, self.NimbusEffectRUID)
	end

	method string GetEffectRUIDByEffectId(string effectId, string fallback)
		-- Looks up one effect id in effects.csv.
		local safeEffectId = self:ReadString(effectId, "")
		if safeEffectId == "" then
			return self:ReadString(fallback, "")
		end
		local data = self:GetDataTable("effects")
		if data == nil then
			return self:ReadString(fallback, "")
		end
		local row = self:GetDataRowIndex(data, "effect_id", safeEffectId)
		if row <= 0 then
			return self:ReadString(fallback, "")
		end
		return self:GetDataCell(data, row, "effect_ruid", fallback)
	end

	method any GetDataTable(string tableName)
		-- Reads a UserDataSet by table name when available.
		if _DataService == nil then
			return nil
		end
		local safeName = self:ReadString(tableName, "")
		if safeName == "" then
			return nil
		end
		return _DataService:GetTable(safeName)
	end

	method string GetDataCell(any dataSet, number row, string columnName, string fallback)
		-- Reads one DataSet cell as a trimmed string.
		if dataSet == nil then
			return self:ReadString(fallback, "")
		end
		local value = dataSet:GetCell(math.max(1, math.floor(self:ReadNumber(row, 1))), self:ReadString(columnName, ""))
		if value == nil then
			return self:ReadString(fallback, "")
		end
		return self:TrimString(tostring(value))
	end

	method number GetDataRowIndex(any dataSet, string columnName, string value)
		-- Finds a DataSet row index by exact string cell match.
		if dataSet == nil then
			return 0
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(dataSet:GetRowCount(), 0)))
		local safeValue = self:ReadString(value, "")
		for row = 1, rowCount do
			if self:GetDataCell(dataSet, row, columnName, "") == safeValue then
				return row
			end
		end
		return 0
	end

	method any ParseDelimitedList(string value, string delimiter)
		-- Parses pipe-delimited CSV fields into a compact string list.
		local result = {}
		local safeValue = self:ReadString(value, "")
		local safeDelimiter = self:ReadString(delimiter, "|")
		if safeValue == "" then
			return result
		end
		local startIndex = 1
		while startIndex <= string.len(safeValue) do
			local remaining = string.sub(safeValue, startIndex)
			local relativeDelimiterIndex, relativeDelimiterEndIndex = string.find(remaining, safeDelimiter, 1, true)
			local delimiterIndex = nil
			if relativeDelimiterIndex ~= nil then
				delimiterIndex = startIndex + relativeDelimiterIndex - 1
			end
			local token = ""
			if delimiterIndex == nil then
				token = string.sub(safeValue, startIndex)
				startIndex = string.len(safeValue) + 1
			else
				token = string.sub(safeValue, startIndex, delimiterIndex - 1)
				startIndex = delimiterIndex + string.len(safeDelimiter)
			end
			token = self:TrimString(token)
			if token ~= "" then
				table.insert(result, token)
			end
		end
		return result
	end

	method number GetUniqueCooldownSeconds()
		return math.max(0.05, self:ReadNumber(self.UniqueCooldownSeconds, 0.35))
	end

	method number GetBlinkCooldownSeconds()
		-- Reads the blink cooldown from skills.csv when present.
		return math.max(0.05, self:ReadNumber(self:GetBlinkSkillDataCell("cooldown", tostring(self.BlinkCooldownSeconds)), self.BlinkCooldownSeconds))
	end

	method number GetBlinkDistance()
		-- Reads the blink distance from skills.csv when present.
		return math.max(0.1, self:ReadNumber(self:GetBlinkSkillDataCell("common_distance", tostring(self.BlinkDistance)), self.BlinkDistance))
	end

	method number GetBlinkFootholdYOffset()
		-- Returns the small lift applied when snapping Burst Step to a foothold.
		return math.max(0, self:ReadNumber(self.BlinkFootholdYOffset, 0.04))
	end

	method number GetNimbusToggleCooldownSeconds()
		-- Reads the Nimbus toggle cooldown from skills.csv when present.
		return math.max(0.05, self:ReadNumber(self:GetNimbusSkillDataCell("cooldown", tostring(self.NimbusToggleCooldownSeconds)), self.NimbusToggleCooldownSeconds))
	end

	method number GetNimbusMoveSpeed()
		-- Reads the Nimbus ride movement speed from skills.csv when present.
		return math.max(0.1, self:ReadNumber(self:GetNimbusSkillDataCell("common_speed", tostring(self.NimbusMoveSpeed)), self.NimbusMoveSpeed))
	end

	method number GetNimbusRoomBoundsPadding()
		-- Keeps the aerial ride slightly inside the active room bounds.
		return math.max(0, self:ReadNumber(self.NimbusRoomBoundsPadding, 0.08))
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method string TrimString(string value)
		-- Trims surrounding whitespace from CSV tokens.
		local safeValue = self:ReadString(value, "")
		return string.match(safeValue, "^%s*(.-)%s*$")
	end

	method void Log(string message)
		if self.VerboseLog == true then
			log("[BRCommonSkill] " .. self:ReadString(message, ""))
		end
	end

	-- ===== Key rebinding (client-local, session persistence) =====

	method integer GetUniqueKeyCode()
		local code = math.floor(self:ReadNumber(self.UniqueKeyCode, self.DefaultUniqueKeyCode))
		if code <= 0 then
			return math.floor(self:ReadNumber(self.DefaultUniqueKeyCode, 113))
		end
		return code
	end

	method integer GetBlinkKeyCode()
		local code = math.floor(self:ReadNumber(self.BlinkKeyCode, self.DefaultBlinkKeyCode))
		if code <= 0 then
			return math.floor(self:ReadNumber(self.DefaultBlinkKeyCode, 99))
		end
		return code
	end

	method integer GetNimbusKeyCode()
		local code = math.floor(self:ReadNumber(self.NimbusKeyCode, self.DefaultNimbusKeyCode))
		if code <= 0 then
			return math.floor(self:ReadNumber(self.DefaultNimbusKeyCode, 101))
		end
		return code
	end

	method integer GetActionKeyCode(string actionId)
		local id = self:NormalizeActionId(actionId)
		if id == "unique" then
			return self:GetUniqueKeyCode()
		elseif id == "blink" then
			return self:GetBlinkKeyCode()
		elseif id == "nimbus" then
			return self:GetNimbusKeyCode()
		elseif id == "attack" then
			return math.floor(self:ReadNumber(self.AttackKeyCode, 0))
		end
		return 0
	end

	method string GetActionKeyName(string actionId)
		local code = self:GetActionKeyCode(actionId)
		if code <= 0 then
			return "미지정"
		end
		return self:GetKeyDisplayName(code)
	end

	method string GetActionLabel(string actionId)
		local id = self:NormalizeActionId(actionId)
		if id == "unique" then
			return "유니크 스킬"
		elseif id == "blink" then
			return "블링크"
		elseif id == "nimbus" then
			return "근두운"
		elseif id == "attack" then
			return "기본 공격"
		end
		return ""
	end

	method string NormalizeActionId(string actionId)
		local id = string.lower(self:ReadString(actionId, ""))
		if id == "unique" or id == "blink" or id == "nimbus" or id == "attack" then
			return id
		end
		return ""
	end

	method string GetActionUsingKeyCode(integer code, string exceptActionId)
		-- Returns the action id already bound to code (excluding exceptActionId), or "" when free.
		local except = self:NormalizeActionId(exceptActionId)
		local ids = {"unique", "blink", "nimbus", "attack"}
		local target = math.floor(self:ReadNumber(code, 0))
		for index, id in ipairs(ids) do
			if id ~= except and self:GetActionKeyCode(id) == target then
				return id
			end
		end
		return ""
	end

	method boolean IsCapturingRebind()
		return self:ReadString(self.capturingActionId, "") ~= ""
	end

	method string GetCapturingActionId()
		return self:ReadString(self.capturingActionId, "")
	end

	method string GetRebindStatusText()
		return self:ReadString(self.rebindStatusText, "")
	end

	@ExecSpace("ClientOnly")
	method void BeginRebind(string actionId)
		-- Arms capture for one action; the next key press routes through HandleRebindCapture.
		local safeId = self:NormalizeActionId(actionId)
		if safeId == "" then
			return
		end
		self.capturingActionId = safeId
		self.rebindStatusText = self:GetActionLabel(safeId) .. " : 새 키를 누르세요 (ESC 취소)"
		log("[BRCommonSkill] rebind begin action=" .. safeId)
	end

	@ExecSpace("ClientOnly")
	method void CancelRebind()
		if self:ReadString(self.capturingActionId, "") == "" then
			return
		end
		local id = self.capturingActionId
		self.capturingActionId = ""
		self.rebindStatusText = "변경을 취소했습니다"
		log("[BRCommonSkill] rebind cancel action=" .. id)
	end

	@ExecSpace("ClientOnly")
	method void HandleRebindCapture(KeyboardKey key)
		-- Validates the pressed key and either applies it or reports why it was rejected.
		local actionId = self:ReadString(self.capturingActionId, "")
		if actionId == "" then
			return
		end
		local code = self:ResolveKeyCode(key)
		if code == 27 then
			self:CancelRebind()
			return
		end
		if code <= 0 then
			self.rebindStatusText = "지원하지 않는 키입니다"
			return
		end
		if self:IsReservedKeyCode(code) == true then
			self.rebindStatusText = self:GetKeyDisplayName(code) .. " 키는 예약되어 변경할 수 없습니다"
			return
		end
		local conflictId = self:GetActionUsingKeyCode(code, actionId)
		if conflictId ~= "" then
			self.rebindStatusText = self:GetKeyDisplayName(code) .. " 키는 이미 '" .. self:GetActionLabel(conflictId) .. "' 에 사용 중입니다"
			return
		end
		self:ApplyBinding(actionId, code)
		self.capturingActionId = ""
		self.rebindStatusText = self:GetActionLabel(actionId) .. " → " .. self:GetKeyDisplayName(code)
		log("[BRCommonSkill] rebind apply action=" .. actionId .. " key=" .. self:GetKeyDisplayName(code))
	end

	@ExecSpace("ClientOnly")
	method void ApplyBinding(string actionId, integer code)
		local safeCode = math.floor(self:ReadNumber(code, 0))
		if actionId == "unique" then
			self.UniqueKeyCode = safeCode
		elseif actionId == "blink" then
			self.BlinkKeyCode = safeCode
			self:RemoveBlinkKeyDefaultAction(true)
		elseif actionId == "nimbus" then
			self.NimbusKeyCode = safeCode
		elseif actionId == "attack" then
			self.AttackKeyCode = safeCode
			self.attackKeyDiscovered = true
			self:ApplyAttackKeyToController(safeCode)
		end
	end

	@ExecSpace("ClientOnly")
	method any GetLocalPlayerController()
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerControllerComponent == nil then
			return nil
		end
		return localPlayer.PlayerControllerComponent
	end

	@ExecSpace("ClientOnly")
	method void ApplyAttackKeyToController(integer code)
		-- Remaps the DefaultPlayer basic-attack action to a new key (client-side action map).
		local controller = self:GetLocalPlayerController()
		if controller == nil then
			return
		end
		local actionName = self:ReadString(self.AttackActionName, "Attack")
		controller:RemoveAllActionKeyByActionName(actionName)
		local safeCode = math.floor(self:ReadNumber(code, 0))
		if safeCode > 0 then
			controller:SetActionKey(KeyboardKey.CastFrom(safeCode), actionName)
		end
	end

	@ExecSpace("ClientOnly")
	method void EnsureAttackKeyDiscovered()
		-- Finds which key currently fires the "Attack" PlayerActionEvent so it can be shown and remapped.
		if self.attackKeyDiscovered == true then
			return
		end
		local controller = self:GetLocalPlayerController()
		if controller == nil then
			return
		end
		local actionName = string.lower(self:ReadString(self.AttackActionName, "Attack"))
		local codes = self:GetResolveKeyCodes()
		for index, code in ipairs(codes) do
			local mapped = string.lower(self:ReadString(controller:GetActionName(KeyboardKey.CastFrom(code)), ""))
			if mapped == actionName then
				self.AttackKeyCode = code
				self.DefaultAttackKeyCode = code
				self.snapAttackKeyCode = code
				self.attackKeyDiscovered = true
				log("[BRCommonSkill] attack key discovered key=" .. self:GetKeyDisplayName(code))
				return
			end
		end
		-- Player controller exists but no key maps to Attack; stop scanning to avoid wasted work.
		self.attackKeyDiscovered = true
		log("[BRCommonSkill] attack key not found (default player attack key unbound)")
	end

	@ExecSpace("ClientOnly")
	method void SnapshotBindings()
		-- Called when the key-config panel opens so Cancel can restore this exact state.
		self:EnsureAttackKeyDiscovered()
		self.capturingActionId = ""
		self.rebindStatusText = ""
		self.snapUniqueKeyCode = self:GetUniqueKeyCode()
		self.snapBlinkKeyCode = self:GetBlinkKeyCode()
		self.snapNimbusKeyCode = self:GetNimbusKeyCode()
		self.snapAttackKeyCode = math.floor(self:ReadNumber(self.AttackKeyCode, 0))
	end

	@ExecSpace("ClientOnly")
	method void RestoreBindings()
		-- Rolls back to the snapshot taken on panel open (Cancel / X button).
		self.capturingActionId = ""
		self.UniqueKeyCode = math.floor(self:ReadNumber(self.snapUniqueKeyCode, self.DefaultUniqueKeyCode))
		self.BlinkKeyCode = math.floor(self:ReadNumber(self.snapBlinkKeyCode, self.DefaultBlinkKeyCode))
		self.NimbusKeyCode = math.floor(self:ReadNumber(self.snapNimbusKeyCode, self.DefaultNimbusKeyCode))
		local snapAttack = math.floor(self:ReadNumber(self.snapAttackKeyCode, 0))
		if snapAttack ~= math.floor(self:ReadNumber(self.AttackKeyCode, 0)) then
			self.AttackKeyCode = snapAttack
			self:ApplyAttackKeyToController(snapAttack)
		end
		self:RemoveBlinkKeyDefaultAction(false)
		self.rebindStatusText = "변경 사항을 되돌렸습니다"
		log("[BRCommonSkill] rebind restore")
	end

	@ExecSpace("ClientOnly")
	method void CommitBindings()
		-- Confirm: promote the current bindings to the new baseline snapshot.
		self.capturingActionId = ""
		self.snapUniqueKeyCode = self:GetUniqueKeyCode()
		self.snapBlinkKeyCode = self:GetBlinkKeyCode()
		self.snapNimbusKeyCode = self:GetNimbusKeyCode()
		self.snapAttackKeyCode = math.floor(self:ReadNumber(self.AttackKeyCode, 0))
		self.rebindStatusText = "저장되었습니다"
		log("[BRCommonSkill] rebind commit")
	end

	@ExecSpace("ClientOnly")
	method void ResetBindingsToDefault()
		self.capturingActionId = ""
		self.UniqueKeyCode = math.floor(self:ReadNumber(self.DefaultUniqueKeyCode, 113))
		self.BlinkKeyCode = math.floor(self:ReadNumber(self.DefaultBlinkKeyCode, 99))
		self.NimbusKeyCode = math.floor(self:ReadNumber(self.DefaultNimbusKeyCode, 101))
		local defaultAttack = math.floor(self:ReadNumber(self.DefaultAttackKeyCode, 0))
		if defaultAttack > 0 then
			self.AttackKeyCode = defaultAttack
			self:ApplyAttackKeyToController(defaultAttack)
		end
		self:RemoveBlinkKeyDefaultAction(false)
		self.rebindStatusText = "기본값으로 초기화했습니다"
		log("[BRCommonSkill] rebind reset default")
	end

	method boolean IsReservedKeyCode(integer code)
		-- Arrows (move/blink dir/nimbus), mouse buttons, and core system keys cannot be rebound.
		local c = math.floor(self:ReadNumber(code, 0))
		if c <= 0 then
			return true
		end
		if c == 273 or c == 274 or c == 275 or c == 276 then
			return true
		end
		if c == 323 or c == 324 or c == 325 then
			return true
		end
		if c == 27 or c == 13 or c == 9 or c == 32 then
			return true
		end
		return false
	end

	method integer ResolveKeyCode(KeyboardKey key)
		-- Maps a pressed KeyboardKey back to its integer code using the known-key catalog.
		local codes = self:GetResolveKeyCodes()
		for index, code in ipairs(codes) do
			if key == KeyboardKey.CastFrom(code) then
				return code
			end
		end
		return 0
	end

	method any GetResolveKeyCodes()
		-- Cached catalog of every key we can name / resolve (bindable + reserved for detection).
		if self._T.resolveKeyCodes ~= nil then
			return self._T.resolveKeyCodes
		end
		local codes = {}
		local c = 97
		while c <= 122 do
			table.insert(codes, c)
			c = c + 1
		end
		c = 48
		while c <= 57 do
			table.insert(codes, c)
			c = c + 1
		end
		c = 282
		while c <= 293 do
			table.insert(codes, c)
			c = c + 1
		end
		local extras = {303, 304, 305, 306, 307, 308, 32, 27, 13, 9, 273, 274, 275, 276, 323, 324, 325, 44, 45, 46, 47, 59, 61, 91, 93}
		for index, extra in ipairs(extras) do
			table.insert(codes, extra)
		end
		self._T.resolveKeyCodes = codes
		return codes
	end

	method string GetKeyDisplayName(integer code)
		-- Human-readable label for one KeyboardKey code (uppercase letters, digits, named specials).
		local c = math.floor(self:ReadNumber(code, 0))
		if c >= 97 and c <= 122 then
			return string.upper(string.char(c))
		end
		if c >= 48 and c <= 57 then
			return string.char(c)
		end
		if c >= 282 and c <= 293 then
			return "F" .. tostring(c - 281)
		end
		if c == 32 then
			return "Space"
		elseif c == 27 then
			return "Esc"
		elseif c == 13 then
			return "Enter"
		elseif c == 9 then
			return "Tab"
		elseif c == 273 then
			return "↑"
		elseif c == 274 then
			return "↓"
		elseif c == 275 then
			return "→"
		elseif c == 276 then
			return "←"
		elseif c == 323 then
			return "L-Click"
		elseif c == 324 then
			return "R-Click"
		elseif c == 325 then
			return "M-Click"
		elseif c == 303 then
			return "R-Shift"
		elseif c == 304 then
			return "Shift"
		elseif c == 305 then
			return "R-Ctrl"
		elseif c == 306 then
			return "Ctrl"
		elseif c == 307 then
			return "R-Alt"
		elseif c == 308 then
			return "Alt"
		elseif c == 44 then
			return ","
		elseif c == 45 then
			return "-"
		elseif c == 46 then
			return "."
		elseif c == 47 then
			return "/"
		elseif c == 59 then
			return ";"
		elseif c == 61 then
			return "="
		elseif c == 91 then
			return "["
		elseif c == 93 then
			return "]"
		end
		if c <= 0 then
			return "미지정"
		end
		return "Key" .. tostring(c)
	end

end
