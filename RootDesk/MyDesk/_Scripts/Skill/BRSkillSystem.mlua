				actionDef.DamageTakenRate = math.max(0, self:ReadNumber(self:GetDataCell(data, row, "damage_taken_rate", "1"), 1))
				actionDef.ChancePercent = math.max(0, self:ReadNumber(self:GetDataCell(data, row, "chance_percent", "100"), 100))
