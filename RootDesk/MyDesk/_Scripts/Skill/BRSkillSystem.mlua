	method any CreateSkillHitboxCatalog()
		-- Creates invisible target-capture rectangles in pixel data; runtime converts to world units.
		local hitboxes = {}
		hitboxes["ds1b1"] = { HitboxId = "ds1b1", Rx = 0, By = 0, W = 248, H = 90 }
		hitboxes["ds1b2"] = { HitboxId = "ds1b2", Rx = -248, By = 0, W = 43, H = 63 }
		hitboxes["projectileSmall"] = { HitboxId = "projectileSmall", Rx = 0, By = 0, W = 80, H = 70 }
		hitboxes["projectileMedium"] = { HitboxId = "projectileMedium", Rx = 0, By = -8, W = 110, H = 86 }
		hitboxes["projectileLarge"] = { HitboxId = "projectileLarge", Rx = 0, By = -15, W = 140, H = 110 }
		hitboxes["slashWide"] = { HitboxId = "slashWide", Rx = -10, By = -10, W = 320, H = 120 }
		hitboxes["slashBackWide"] = { HitboxId = "slashBackWide", Rx = -300, By = -8, W = 180, H = 110 }
		hitboxes["burstCore"] = { HitboxId = "burstCore", Rx = -40, By = -20, W = 180, H = 150 }
		hitboxes["burstWide"] = { HitboxId = "burstWide", Rx = -80, By = -35, W = 280, H = 190 }
		hitboxes["burstHuge"] = { HitboxId = "burstHuge", Rx = -150, By = -45, W = 420, H = 240 }
		hitboxes["dashBox"] = { HitboxId = "dashBox", Rx = 0, By = 0, W = 180, H = 90 }
		hitboxes["dashLong"] = { HitboxId = "dashLong", Rx = 0, By = -5, W = 280, H = 95 }
		hitboxes["dashBack"] = { HitboxId = "dashBack", Rx = -220, By = -5, W = 180, H = 95 }
		hitboxes["dashWide"] = { HitboxId = "dashWide", Rx = -80, By = -20, W = 380, H = 150 }
		hitboxes["fieldZone"] = { HitboxId = "fieldZone", Rx = -140, By = -30, W = 280, H = 160 }
		hitboxes["fieldWide"] = { HitboxId = "fieldWide", Rx = -210, By = -45, W = 420, H = 190 }
		hitboxes["fieldHuge"] = { HitboxId = "fieldHuge", Rx = -300, By = -60, W = 600, H = 240 }
		return hitboxes
	end

	method any CreateSkillActionCatalog()
		-- Creates executable actions consumed by skill events.
		local actions = {}
		actions["ds1hit"] = { ActionId = "ds1hit", Type = "damage", Coefficient = 120 }
