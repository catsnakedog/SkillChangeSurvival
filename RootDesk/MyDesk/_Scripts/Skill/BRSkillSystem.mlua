			local actionId = self:GetDataCell(data, row, "action_id", "")
			local actionDef = actions[actionId]
			if actionDef ~= nil then
				actionDef.Type = "debuff"
				actionDef.StatusId = self:GetDataCell(data, row, "status_id", "debuff")
				actionDef.DurationFrames = math.max(1, math.floor(self:ReadNumber(self:GetDataCell(data, row, "duration_frames", "1"), 1)))
				actionDef.CancelChain = self:ReadDataBoolean(data, row, "cancel_chain", false)
				actionDef.ChancePercent = math.max(0, self:ReadNumber(self:GetDataCell(data, row, "chance_percent", "100"), 100))
				actionDef.DotCoefficient = math.max(0, self:ReadNumber(self:GetDataCell(data, row, "dot_coefficient_percent", "0"), 0))
				actionDef.TickIntervalFrames = math.max(1, math.floor(self:ReadNumber(self:GetDataCell(data, row, "tick_interval_frames", "33"), 33)))
			end
		end
	end

	@ExecSpace("Server")
	method void RequestCastNextChainSkill(string requestUserId)
		-- Casts the resolved local user's chain as an ordered sequence.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			self:Log("cast request skipped reason=noUser")
			return
		end
		local playerEntity = self:FindPlayerEntityByUserId(userId)
		if playerEntity == nil then
			self:Log("cast request skipped user=" .. userId .. " reason=noPlayer")
			return
		end
		self:TryCastNextChainSkill(playerEntity)
	end

	@ExecSpace("Server")
	method void RequestCastUniqueSkill(string requestUserId, string requestedSkillKey)
		-- Casts the character-specific unique skill outside the skill-chain recipe.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			self:Log("unique request skipped reason=noUser")
			return
		end
		local playerEntity = self:FindPlayerEntityByUserId(userId)
		if playerEntity == nil then
			self:Log("unique request skipped user=" .. userId .. " reason=noPlayer")
			return
		end
		local uniqueSkillKey = self:ResolveUniqueSkillKey(userId, requestedSkillKey)
		self:TryCastUniqueSkill(playerEntity, uniqueSkillKey)
	end

	method boolean TryCastUniqueSkill(Entity casterEntity, string uniqueSkillKey)
		-- Starts one character-specific unique skill with its own cooldown.
		self:EnsureRuntime()
		if casterEntity == nil or casterEntity.PlayerComponent == nil then
			return false
		end
		if casterEntity.PlayerComponent:IsDead() == true or casterEntity.PlayerComponent.Hp <= 0 then
			return false
		end

		local userId = self:GetUserIdFromPlayer(casterEntity)
		if userId == "" then
			return false
		end
		if self:IsCasterControlBlocked(casterEntity) == true then
			self:Log("unique cast blocked user=" .. userId .. " reason=controlStatus")
			return false
		end

		local safeSkillKey = self:NormalizeUniqueSkillKey(uniqueSkillKey)
		local skillDef = self._T.skillRuntimeCatalog[safeSkillKey]
		if skillDef == nil then
			self:Log("unique skipped user=" .. userId .. " skill=" .. safeSkillKey .. " reason=noDefinition")
			return false
		end

		local runtime = self:GetUniqueRuntime(userId)
		local now = self:Now()
		if now < self:ReadNumber(runtime.NextCastAt, 0) then
			return true
		end

		local step = {
			SlotIndex = 0,
			EndSlotIndex = 0,
			Tier = 1,
			Part = nil,
			SkillDef = skillDef,
			SkillKey = safeSkillKey,
			Role = "unique",
			EndPart = nil,
			EndSkillDef = nil,
			TriggerEndSlotIndex = 0,
			EndTier = 0
		}
		self:StartSkillCast(casterEntity, userId, step, false, nil, nil)
		runtime.NextCastAt = now + math.max(self:GetUniqueSkillCooldownSeconds(), self:GetSkillCooldownSeconds(skillDef))
		self:Log("unique cast user=" .. userId .. " skill=" .. safeSkillKey .. " cooldown=" .. tostring(runtime.NextCastAt - now))
		return true
	end

	@ExecSpace("ServerOnly")
	method string ResolveUniqueSkillKey(string userId, string requestedSkillKey)
		-- Resolves the unique skill from the server-side character state first.
		local fallbackSkillKey = self:GetDefaultBasicSkillIdForUser(userId)
		if _BRCharacterSystem ~= nil then
			local serverSkillKey = _BRCharacterSystem:GetServerUniqueSkillKey(userId)
			if serverSkillKey ~= nil and serverSkillKey ~= "" then
				return self:NormalizeSkillKeyWithFallback(serverSkillKey, fallbackSkillKey)
			end
		end
		return self:NormalizeSkillKeyWithFallback(requestedSkillKey, fallbackSkillKey)
	end

	method string NormalizeUniqueSkillKey(string skillKey)
		-- Keeps direct skill requests inside the CSV runtime catalog.
		return self:NormalizeSkillKeyWithFallback(skillKey, self:GetDefaultBasicSkillId())
	end

	method string NormalizeSkillKeyWithFallback(string skillKey, string fallbackSkillKey)
		-- Keeps direct skill requests inside the CSV runtime catalog with a caller-selected fallback.
		self:EnsureRuntime()
		local safeSkillKey = self:ReadString(skillKey, "")
		if safeSkillKey ~= "" and self:HasSkillDefinition(safeSkillKey) == true then
			return safeSkillKey
		end
		local safeFallbackSkillKey = self:ReadString(fallbackSkillKey, "")
		if safeFallbackSkillKey ~= "" and self:HasSkillDefinition(safeFallbackSkillKey) == true then
			return safeFallbackSkillKey
		end
		return self:GetDefaultBasicSkillId()
	end

	method boolean HasSkillDefinition(string skillKey)
		-- Returns whether a CSV-backed skill definition exists.
		self:EnsureRuntime()
		local safeSkillKey = self:ReadString(skillKey, "")
		return safeSkillKey ~= "" and self._T.skillRuntimeCatalog ~= nil and self._T.skillRuntimeCatalog[safeSkillKey] ~= nil
	end

	method string GetDefaultBasicSkillId()
		-- Returns the CSV-declared basic skill, or the first available skill.
		if self._T.skillRuntimeCatalog == nil then
			self._T.skillRuntimeCatalog = self:CreateSkillRuntimeCatalog()
		end
		if self._T.characterDefaults == nil then
			self._T.characterDefaults = self:CreateCharacterDefaults()
		end
		if self._T.characterDefaults ~= nil then
			local basicSkillId = self:ReadString(self._T.characterDefaults.BasicSkillId, "")
			if basicSkillId ~= "" and self._T.skillRuntimeCatalog ~= nil and self._T.skillRuntimeCatalog[basicSkillId] ~= nil then
				return basicSkillId
			end
		end
		if self._T.skillRuntimeCatalog ~= nil then
			for skillKey, skillDef in pairs(self._T.skillRuntimeCatalog) do
				return skillKey
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string GetDefaultBasicSkillIdForUser(string userId)
		-- Returns the class-specific basic skill for a user when declared in CSV.
		self:EnsureRuntime()
		if _BRCharacterSystem ~= nil then
			local characterSkillKey = _BRCharacterSystem:GetServerBasicSkillKey(userId)
			if characterSkillKey ~= "" and self:HasSkillDefinition(characterSkillKey) == true then
				return characterSkillKey
			end
		end
		return self:GetDefaultBasicSkillId()
	end

	method boolean TryCastNextChainSkill(Entity casterEntity)
		-- Starts one resolved chain sequence, executing each step in order.
		self:EnsureRuntime()
		if casterEntity == nil or casterEntity.PlayerComponent == nil then
			return false
		end
		if casterEntity.PlayerComponent:IsDead() == true or casterEntity.PlayerComponent.Hp <= 0 then
			return false
		end

		local userId = self:GetUserIdFromPlayer(casterEntity)
		if userId == "" then
			return false
		end
		if self:IsCasterControlBlocked(casterEntity) == true then
			self:Log("chain cast blocked user=" .. userId .. " reason=controlStatus")
			return false
		end

		local state = self:GetUserState(userId)
		local resolved = self:BuildResolvedChain(state)
		if resolved == nil or resolved.Count <= 0 then
			return false
		end

		local runtime = self:GetChainRuntime(userId)
		local now = self:Now()
		if self:ReadNumber(runtime.ActiveCastCount, 0) > 0 or self:HasPendingChainSteps(runtime) == true then
			return true
		end
		if now < self:ReadNumber(runtime.NextCastAt, 0) then
			return true
		end

		runtime.Signature = resolved.Signature

		local maxCooldown = self:GetChainCastCooldownSeconds()
		local castCount = 0
		local skillSummary = ""
		for stepIndex, step in ipairs(resolved.Steps) do
			if step ~= nil and step.SkillDef ~= nil then
				castCount = castCount + 1
				local skillCooldown = self:GetSkillCooldownSeconds(step.SkillDef)
				if skillCooldown > maxCooldown then
					maxCooldown = skillCooldown
				end
				if skillSummary ~= "" then
					skillSummary = skillSummary .. ">"
				end
				skillSummary = skillSummary .. self:ReadString(step.SkillKey, "") .. "#" .. tostring(math.max(1, math.floor(self:ReadNumber(step.Tier, 1))))
			end
		end

		if castCount <= 0 then
			return false
		end

		runtime.PendingSteps = resolved.Steps
		runtime.PendingStepIndex = 1
		runtime.PendingStepCount = castCount
		runtime.PendingSummary = skillSummary
		runtime.PendingCooldownSeconds = maxCooldown
		runtime.NextCastAt = now + maxCooldown
		runtime.ResetAt = now + self:GetSkillChainResetSeconds()

		-- Lock movement + jump for the entire chain sequence (until every step finishes / is cancelled).
		self:ApplyCasterChainLock(casterEntity, userId)
		self:Log("chain sequence start user=" .. userId .. " count=" .. tostring(castCount) .. " skills=" .. skillSummary .. " cooldown=" .. tostring(maxCooldown))
		return self:StartNextQueuedChainStep(casterEntity, userId, runtime)
	end

	method boolean HasPendingChainSteps(any runtime)
		-- Returns whether the current chain sequence has more steps to start.
		if runtime == nil or runtime.PendingSteps == nil then
			return false
		end
		local nextIndex = math.max(1, math.floor(self:ReadNumber(runtime.PendingStepIndex, 1)))
		local count = math.max(0, math.floor(self:ReadNumber(runtime.PendingStepCount, #runtime.PendingSteps)))
		return nextIndex <= count
	end

	method void ClearQueuedChainRuntime(any runtime)
		-- Clears the queued chain sequence without touching cooldowns.
		if runtime == nil then
			return
		end
		runtime.PendingSteps = nil
		runtime.PendingStepIndex = 1
		runtime.PendingStepCount = 0
		runtime.PendingSummary = ""
		runtime.PendingCooldownSeconds = 0
	end

	method boolean StartNextQueuedChainStep(Entity casterEntity, string userId, any runtime)
		-- Starts the next chain step after the previous cast has fully ended.
		if runtime == nil then
			return false
		end
		if casterEntity == nil or isvalid(casterEntity) == false or casterEntity.PlayerComponent == nil then
			self:ClearQueuedChainRuntime(runtime)
			return false
		end
		if casterEntity.PlayerComponent:IsDead() == true or casterEntity.PlayerComponent.Hp <= 0 then
			self:ClearQueuedChainRuntime(runtime)
			return false
		end

		local count = math.max(0, math.floor(self:ReadNumber(runtime.PendingStepCount, 0)))
		local nextIndex = math.max(1, math.floor(self:ReadNumber(runtime.PendingStepIndex, 1)))
		while runtime.PendingSteps ~= nil and nextIndex <= count do
			local step = runtime.PendingSteps[nextIndex]
			runtime.PendingStepIndex = nextIndex + 1
			if step ~= nil and step.SkillDef ~= nil then
				self:Log("chain step start user=" .. self:ReadString(userId, "") .. " step=" .. tostring(nextIndex) .. "/" .. tostring(count) .. " skill=" .. self:ReadString(step.SkillKey, "") .. " tier=" .. tostring(math.max(1, math.floor(self:ReadNumber(step.Tier, 1)))) .. " role=" .. self:ReadString(step.Role, "normal"))
				self:StartSkillCast(casterEntity, userId, step, false, nil, nil)
				return true
			end
			nextIndex = nextIndex + 1
		end

		self:Log("chain sequence end user=" .. self:ReadString(userId, "") .. " skills=" .. self:ReadString(runtime.PendingSummary, ""))
		self:ClearQueuedChainRuntime(runtime)
		return false
	end

	method any BuildResolvedChain(any state)
		-- Resolves chain slots into player-cast steps while folding consecutive same-key tiers.
		local result = {
			Steps = {},
			Count = 0,
			Signature = ""
		}
		if state == nil then
			return result
		end
		self:NormalizeUserState(state)
		local consumedEndGroups = {}
		local groups = {}
		local activeGroup = {}
		local hasActiveGroup = false
		local signature = ""
		local slotCount = self:GetUnlockedChainSlotCount(state)
		for slotIndex = 1, slotCount do
			local instanceId = state.EquippedChainSlots[slotIndex]
			local part = self:FindPartInState(state, instanceId)
			if signature ~= "" then
				signature = signature .. "|"
			end
			if part == nil then
				signature = signature .. "-"
				hasActiveGroup = false
			else
				local skillKey = self:ReadString(part.SkillKey, self:ReadString(part.SlotKey, part.PartId))
				signature = signature .. tostring(part.InstanceId) .. ":" .. skillKey
				if hasActiveGroup == true and skillKey ~= "" and self:ReadString(activeGroup.SkillKey, "") == skillKey then
					activeGroup.EndSlotIndex = slotIndex
					activeGroup.Part = part
					activeGroup.InstanceId = instanceId
					activeGroup.Tier = self:ClampSkillTier(self:ReadNumber(activeGroup.Tier, 1) + 1)
				else
					activeGroup = {
						StartSlotIndex = slotIndex,
						EndSlotIndex = slotIndex,
						Part = part,
						InstanceId = instanceId,
						SkillKey = skillKey,
						Tier = 1
					}
					hasActiveGroup = true
					table.insert(groups, activeGroup)
				end
			end
		end

		local pendingMesoCount = 0
		for groupIndex, group in ipairs(groups) do
			if consumedEndGroups[groupIndex] ~= true then
				local part = group.Part
				if part ~= nil then
					local groupTier = self:ClampSkillTier(group.Tier)
					local skillDef = self:GetSkillDefinitionForPart(part, groupTier)
					local step = {
						SlotIndex = math.floor(self:ReadNumber(group.StartSlotIndex, 0)),
						EndSlotIndex = math.floor(self:ReadNumber(group.EndSlotIndex, 0)),
						Tier = groupTier,
						Part = part,
						SkillDef = skillDef,
						SkillKey = self:ReadString(skillDef.SkillKey, self:ReadString(group.SkillKey, self:ReadString(part.SkillKey, ""))),
						Role = "normal",
						EndPart = nil,
						EndSkillDef = nil,
						TriggerEndSlotIndex = 0,
						EndTier = 0
					}
					local nextGroup = groups[groupIndex + 1]
					-- Only combo (start->end trigger) when the next group is DIRECTLY ADJACENT in the chain.
					-- A gap (empty slot) means the chain is broken there, so those skills must cast
					-- sequentially (each as its own queued step) instead of firing together.
					local nextAdjacent = nextGroup ~= nil and math.floor(self:ReadNumber(nextGroup.StartSlotIndex, 0)) == math.floor(self:ReadNumber(group.EndSlotIndex, 0)) + 1
					if self:SkillHasTrigger(skillDef) == true and nextGroup ~= nil and nextGroup.Part ~= nil and nextAdjacent == true then
						local endTier = self:ClampSkillTier(nextGroup.Tier)
						local endSkillDef = self:GetSkillDefinitionForPart(nextGroup.Part, endTier)
						if self:SkillHasTrigger(endSkillDef) ~= true then
							step.Role = "start"
							step.EndPart = nextGroup.Part
							step.EndSkillDef = endSkillDef
							step.TriggerEndSlotIndex = math.floor(self:ReadNumber(nextGroup.EndSlotIndex, 0))
							step.EndTier = endTier
							consumedEndGroups[groupIndex + 1] = true
						else
							step.Role = "start"
							self:Log("trigger link skipped user=" .. self:ReadString(state.UserId, "") .. " start=" .. self:ReadString(step.SkillKey, "") .. " next=" .. self:ReadString(endSkillDef.SkillKey, "") .. " reason=nextIsTrigger")
						end
					end
					if pendingMesoCount > 0 then
						step.MesoFollowUpCount = pendingMesoCount
						pendingMesoCount = 0
					end
					table.insert(result.Steps, step)
				end
			end
			if self:IsMesoExplosionSkillKey(self:ReadString(group.SkillKey, "")) == true then
				pendingMesoCount = self:CoinCountForTier(group.Tier)
			end
		end
		result.Count = #result.Steps
		result.Signature = signature
		return result
	end

	method string BuildResolvedChainSummary(any state)
		-- Builds a readable ordered cast summary such as A 1 + B 2->C 1.
		local resolved = self:BuildResolvedChain(state)
		if resolved == nil or resolved.Count <= 0 then
			return self:BuildEmptyRecipeText()
		end
		local text = "Chain: "
		for index, step in ipairs(resolved.Steps) do
			if index > 1 then
				text = text .. " + "
			end
			local name = self:GetSkillTierText(step.Part, self:ReadNumber(step.Tier, 1))
			if step.Role == "start" and step.EndPart ~= nil then
				name = name .. "->" .. self:GetSkillTierText(step.EndPart, self:ReadNumber(step.EndTier, 1))
			end
			text = text .. name
		end
		return text
	end

	method any GetSkillDefinitionForPart(any part, number tier)
		-- Returns runtime skill data for one owned part and folded tier.
		self:EnsureRuntime()
		local skillKey = ""
		if part ~= nil then
			skillKey = self:ReadString(part.SkillKey, self:ReadString(part.SlotKey, ""))
		end
		local order = self:ClampSkillTier(tier)
		local tieredSkillKey = self:GetTieredSkillKey(skillKey, order)
		local skillDef = self._T.skillRuntimeCatalog[tieredSkillKey]
		if skillDef == nil then
			skillDef = self._T.skillRuntimeCatalog[skillKey]
		end
		if skillDef == nil then
			skillDef = self._T.skillRuntimeCatalog[self:GetDefaultBasicSkillId()]
		end
		return skillDef
	end

	method string GetTieredSkillKey(string baseSkillKey, number tier)
		-- Converts a base skill and tier into the executable skill definition key.
		local safeSkillKey = self:ReadString(baseSkillKey, self:GetDefaultBasicSkillId())
		local order = self:ClampSkillTier(tier)
		if order <= 1 then
			return safeSkillKey
		end
		return safeSkillKey .. tostring(order)
	end

	method number ClampSkillTier(number tier)
		-- Clamps a chain order to the designed skill-tier range.
		local order = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		return math.min(order, self:GetMaxSkillTier())
	end

	method number GetMaxSkillTier()
		-- Returns the highest skill order that has a dedicated definition.
		return math.max(1, math.floor(self:ReadNumber(self.MaxSkillTier, 4)))
	end

	method boolean SkillHasTrigger(any skillDef)
		-- Checks whether a skill timeline contains a trigger action.
		if skillDef == nil or skillDef.EventsByFrame == nil then
			return false
		end
		for frame, eventIds in pairs(skillDef.EventsByFrame) do
			if eventIds ~= nil then
				for index, eventId in ipairs(eventIds) do
					if self:SkillEventHasTrigger(eventId, {}) == true then
						return true
					end
				end
			end
		end
		return false
	end

	method boolean SkillPartHasTrigger(any part, number tier)
		-- Resolves a part to the tiered skill definition and checks for trigger/starter behavior.
		if part == nil then
			return false
		end
		self:EnsureRuntime()
		local skillKey = self:ReadString(part.SkillKey, self:ReadString(part.SlotKey, part.PartId))
		if skillKey == "" or self._T.skillRuntimeCatalog == nil then
			return false
		end
		if self:IsMesoExplosionSkillKey(skillKey) == true then
			return true
		end
		local tieredSkillKey = self:GetTieredSkillKey(skillKey, tier)
		local skillDef = self._T.skillRuntimeCatalog[tieredSkillKey]
		if skillDef == nil then
			skillDef = self._T.skillRuntimeCatalog[skillKey]
		end
		return self:SkillHasTrigger(skillDef)
	end

	method boolean SkillEventHasTrigger(string eventId, any visitedEvents)
		local safeEventId = self:ReadString(eventId, "")
		if safeEventId == "" or self._T.skillEventCatalog == nil then
			return false
		end
		if visitedEvents == nil then
			visitedEvents = {}
		end
		if visitedEvents[safeEventId] == true then
			return false
		end
		visitedEvents[safeEventId] = true
		local eventDef = self._T.skillEventCatalog[safeEventId]
		if eventDef == nil then
			return false
		end
		if eventDef.ActionIds ~= nil then
			for actionIndex, actionId in ipairs(eventDef.ActionIds) do
				local actionDef = self._T.skillActionCatalog[actionId]
				if self:SkillActionHasTrigger(actionDef, visitedEvents) == true then
					return true
				end
			end
		end
		if self:SkillEventListHasTrigger(eventDef.CollisionEventIds, visitedEvents) == true then
			return true
		end
		if self:SkillEventListHasTrigger(eventDef.ExpireEventIds, visitedEvents) == true then
			return true
		end
		return false
	end

	method boolean SkillActionHasTrigger(any actionDef, any visitedEvents)
		if actionDef == nil then
			return false
		end
		if self:ReadString(actionDef.Type, "") == "trigger" then
			return true
		end
		if self:SkillEventListHasTrigger(actionDef.CollisionEventIds, visitedEvents) == true then
			return true
		end
		if self:SkillEventListHasTrigger(actionDef.ExpireEventIds, visitedEvents) == true then
			return true
		end
		return false
	end

	method boolean SkillEventListHasTrigger(any eventIds, any visitedEvents)
		if eventIds == nil then
			return false
		end
		for index, eventId in ipairs(eventIds) do
			if self:SkillEventHasTrigger(eventId, visitedEvents) == true then
				return true
			end
		end
		return false
	end

	method any GetChainRuntime(string userId)
		-- Returns per-user chain execution state.
		self:EnsureRuntime()
		local safeUserId = self:ReadString(userId, "")
		if self._T.chainRuntimeByUser[safeUserId] == nil then
			self._T.chainRuntimeByUser[safeUserId] = {
				Signature = "",
				NextCastAt = 0,
				ResetAt = 0,
				ActiveUntil = 0,
				ActiveCastCount = 0,
				PendingSteps = nil,
				PendingStepIndex = 1,
				PendingStepCount = 0,
				PendingSummary = "",
				PendingCooldownSeconds = 0
			}
		end
		return self._T.chainRuntimeByUser[safeUserId]
	end

	method any GetUniqueRuntime(string userId)
		-- Returns per-user unique-skill cooldown state.
		self:EnsureRuntime()
		local safeUserId = self:ReadString(userId, "")
		if self._T.uniqueRuntimeByUser[safeUserId] == nil then
			self._T.uniqueRuntimeByUser[safeUserId] = {
				NextCastAt = 0
			}
		end
		return self._T.uniqueRuntimeByUser[safeUserId]
	end

	method void StartSkillCast(Entity casterEntity, string userId, any step, boolean isVirtualCaster, number fixedX, number fixedY)
		-- Adds one active skill cast to the server frame loop.
		if step == nil or step.SkillDef == nil then
			return
		end
		local direction = self:GetLookDirection(casterEntity)
		local fixedOriginX = nil
		local fixedOriginY = nil
		if fixedX ~= nil and fixedY ~= nil then
			fixedOriginX = fixedX
			fixedOriginY = fixedY
		end
		local cast = {
			UserId = self:ReadString(userId, ""),
			CasterEntity = casterEntity,
			SourceEntity = casterEntity,
			SkillDef = step.SkillDef,
			SkillKey = self:ReadString(step.SkillKey, self:ReadString(step.SkillDef.SkillKey, "")),
			EffectIds = step.SkillDef.EffectIds,
			Tier = math.max(1, math.floor(self:ReadNumber(step.Tier, 1))),
			Role = self:ReadString(step.Role, "normal"),
			EndPart = step.EndPart,
			EndSkillDef = step.EndSkillDef,
			EndTier = math.max(0, math.floor(self:ReadNumber(step.EndTier, 0))),
			IsVirtualCaster = isVirtualCaster == true,
			Direction = direction,
			Frame = 0,
			FrameTimer = 0,
			FixedOriginX = fixedOriginX,
			FixedOriginY = fixedOriginY,
			MesoFollowUpCount = math.max(0, math.floor(self:ReadNumber(step.MesoFollowUpCount, 0))),
			MesoAttacker = casterEntity,
			DamageRate = math.max(0, self:ReadNumber(step.DamageRate, 1)),
			Completed = false,
			Cancelled = false
		}
		table.insert(self._T.activeCasts, cast)
		if cast.IsVirtualCaster ~= true and self:IsMesoExplosionSkillKey(self:ReadString(cast.SkillKey, "")) == true then
			self:PlayCasterMesoEffect(casterEntity)
			self:ArmActiveMesoFollowUps(cast.UserId, self:CoinCountForTier(cast.Tier), casterEntity)
		end
		if cast.IsVirtualCaster ~= true then
			self:HandleShadowDashCast(cast)
		end
		if cast.IsVirtualCaster ~= true then
			self:HandleThrowStarCast(cast)
		end
		if cast.IsVirtualCaster ~= true then
			local runtime = self:GetChainRuntime(cast.UserId)
			runtime.ActiveCastCount = math.max(0, math.floor(self:ReadNumber(runtime.ActiveCastCount, 0))) + 1
			local expectedEndAt = self:Now() + self:GetSkillDurationSeconds(step.SkillDef)
			if expectedEndAt > self:ReadNumber(runtime.ActiveUntil, 0) then
				runtime.ActiveUntil = expectedEndAt
			end
			self:ApplyCasterActionLimit(cast)
		end
	end

	method void StartVirtualEndSkill(any context, number originX, number originY)
		-- Creates a temporary virtual caster and casts the paired end skill only.
		if context == nil or context.IsVirtualCaster == true then
			return
		end
		if context.EndSkillDef == nil then
			self:Log("trigger skipped user=" .. self:ReadString(context.UserId, "") .. " reason=noEndSkill")
			return
		end
		local step = {
			SkillDef = context.EndSkillDef,
			SkillKey = self:ReadString(context.EndSkillDef.SkillKey, ""),
			EffectIds = context.EndSkillDef.EffectIds,
			Tier = math.max(1, math.floor(self:ReadNumber(context.EndTier, 1))),
			Role = "end",
			DamageRate = self:GetPiercingEndSkillDamageRate(context),
			EndPart = nil,
			EndSkillDef = nil,
			EndTier = 0
		}
		self:StartSkillCast(context.SourceEntity, self:ReadString(context.UserId, ""), step, true, originX, originY)
		self:Log("trigger cast user=" .. self:ReadString(context.UserId, "") .. " endSkill=" .. self:ReadString(step.SkillKey, "") .. " tier=" .. tostring(math.max(1, math.floor(self:ReadNumber(step.Tier, 1)))) .. " rate=" .. tostring(self:ReadNumber(step.DamageRate, 1)) .. " at=(" .. tostring(originX) .. "," .. tostring(originY) .. ")")
	end

	method string GetPiercingBaseSkillKey()
		-- Base skill key of the piercing chain part; tier variants are 피어싱2/3/4.
		return "피어싱"
	end

	method boolean IsPiercingSkillKey(string skillKey)
		-- True when a skill key belongs to the piercing part family (base or tier variant).
		local baseKey = self:GetPiercingBaseSkillKey()
		local safeKey = self:ReadString(skillKey, "")
		return safeKey == baseKey or string.sub(safeKey, 1, #baseKey) == baseKey
	end

	method number GetPiercingEndSkillDamageRate(any context)
		-- Hardcoded piercing trigger amp for the paired end skill (2=+30%,3=+50%,4=+70%); 1.0 otherwise.
		if context == nil or self:IsPiercingSkillKey(self:ReadString(context.SkillKey, "")) ~= true then
			return 1
		end
		local tier = self:ClampSkillTier(context.Tier)
		if tier == 2 then
			return 1.3
		elseif tier == 3 then
			return 1.5
		elseif tier == 4 then
			return 1.7
		end
		return 1
	end

	method string GetPiercingExplosionEffectRUID()
		-- Hardcoded burst effect played on piercing tier 3+ projectile expiry (인핸스 피어싱 ll effect).
		return "b73f45d4c26e400d8a618296b04db0d2"
	end

	method void TryPlayPiercingExplosionBurst(any projectile)
		-- Plays the central explosion burst when a tier 3+ piercing projectile expires.
		if projectile == nil or self:IsPiercingSkillKey(self:ReadString(projectile.SkillKey, "")) ~= true then
			return
		end
		if self:ClampSkillTier(projectile.Tier) < 3 then
			return
		end
		self:PlaySkillVisualAt(projectile, self:GetPiercingExplosionEffectRUID(), self:ReadNumber(projectile.X, 0), self:ReadNumber(projectile.Y, 0), self:ReadNumber(projectile.Direction, 1), 1.0, "piercing:explosion")
	end

	method number GetHardcodedStatusMoveSpeedRate(string statusId)
		-- Hardcoded target move-speed multiplier per status id (둔화 slow = 0.7); 1.0 means no slow.
		if self:ReadString(statusId, "") == "둔화" then
			return 0.7
		end
		return 1.0
	end

	method void ApplyTargetSlow(Entity targetEntity, number rate)
		-- Reduces a slowed target's InputSpeed, capturing the original value once until restored.
		if targetEntity == nil or isvalid(targetEntity) == false or self:ReadNumber(rate, 1) >= 0.999 then
			return
		end
		local key = self:GetEntityKey(targetEntity)
		if key == "" or self._T.slowLocks[key] ~= nil then
			return
		end
		if targetEntity.MovementComponent == nil then
			return
		end
		local original = targetEntity.MovementComponent.InputSpeed
		targetEntity.MovementComponent.InputSpeed = math.max(0.05, self:ReadNumber(original, 1) * self:ReadNumber(rate, 1))
		self._T.slowLocks[key] = { Entity = targetEntity, InputSpeed = original }
		self:Log("slow apply target=" .. targetEntity.Name .. " rate=" .. tostring(rate))
	end

	method void RestoreTargetSlow(Entity targetEntity)
		-- Restores a slowed target's InputSpeed when its slow status expires.
		if targetEntity == nil then
			return
		end
		local key = self:GetEntityKey(targetEntity)
		if key == "" then
			return
		end
		local lock = self._T.slowLocks[key]
		if lock == nil then
			return
		end
		if lock.Entity ~= nil and isvalid(lock.Entity) and lock.Entity.MovementComponent ~= nil and lock.InputSpeed ~= nil then
			lock.Entity.MovementComponent.InputSpeed = lock.InputSpeed
		end
		self._T.slowLocks[key] = nil
		self:Log("slow restore target=" .. tostring(key))
	end

	method void TickActiveCasts(number delta)
		-- Ticks active casts on skill timeline frames; physical movement is updated separately with delta.
		-- Re-assert full-chain movement locks first so the lobby controller cannot restore movement mid-chain.
		self:ReapplyAllChainLocks()
		for index = #self._T.activeCasts, 1, -1 do
			local cast = self._T.activeCasts[index]
			if cast == nil or cast.Cancelled == true then
				self:FinishSkillCast(cast, true)
				table.remove(self._T.activeCasts, index)
			else
				self:TickSkillCast(cast, delta)
				if cast.Completed == true then
					self:FinishSkillCast(cast, false)
					table.remove(self._T.activeCasts, index)
				end
			end
		end
	end

	method void TickSkillCast(any cast, number delta)
		-- Advances one active cast and fires frame events.
		if cast == nil or cast.SkillDef == nil then
			return
		end
		cast.FrameTimer = self:ReadNumber(cast.FrameTimer, 0) + self:ReadNumber(delta, 0)
		local frameSeconds = self:GetSkillFrameSeconds()
		while cast.FrameTimer >= frameSeconds and cast.Completed ~= true and cast.Cancelled ~= true do
			cast.FrameTimer = cast.FrameTimer - frameSeconds
			self:ProcessSkillFrame(cast, math.floor(self:ReadNumber(cast.Frame, 0)))
			cast.Frame = math.floor(self:ReadNumber(cast.Frame, 0)) + 1
			if cast.Frame >= self:GetSkillTotalFrames(cast.SkillDef) + self:PreDelayFramesForSkill(cast.SkillDef) + self:PostDelayFramesForSkill(cast.SkillDef) then
				cast.Completed = true
			end
		end
	end

	method void ProcessSkillFrame(any cast, number frame)
		-- Executes all events on one skill frame, shifted later by the skill's pre-cast wind-up (선딜레이).
		if cast == nil or cast.SkillDef == nil then
			return
		end
		local preFrames = self:PreDelayFramesForSkill(cast.SkillDef)
		if frame == 0 then
			self:Log("skill frame0 user=" .. self:ReadString(cast.UserId, "") .. " skill=" .. self:ReadString(cast.SkillKey, "") .. " tier=" .. tostring(math.max(1, math.floor(self:ReadNumber(cast.Tier, 1)))) .. " virtual=" .. tostring(cast.IsVirtualCaster == true))
		end
		-- Telegraph the incoming hit area for the whole wind-up (shown at its very start).
		if preFrames > 0 and frame == 0 and cast.TelegraphShown ~= true then
			cast.TelegraphShown = true
			self:ShowSkillTelegraph(cast)
		end
		-- Play the skill's main visual effect when the wind-up ENDS (the strike begins), not during the
		-- pre-delay — otherwise the effect appears before the telegraph resolves (frame 0 = wind-up start).
		if frame == preFrames and cast.IsVirtualCaster ~= true and cast.MainEffectPlayed ~= true then
			local mainOrigin = self:GetContextOrigin(cast)
			self:PlaySkillVisualForEvent(cast, "", mainOrigin.x, mainOrigin.y, false)
			cast.MainEffectPlayed = true
		end
		-- Post-cast recovery (후딜): once every timeline event has fired, freeze the caster in place
		-- and hold the attack motion until the cast (and this recovery window) ends.
		local curFrame = math.floor(self:ReadNumber(frame, 0))
		if cast.IsVirtualCaster ~= true and self:PostDelayFramesForSkill(cast.SkillDef) > 0 and curFrame >= preFrames + self:GetSkillTotalFrames(cast.SkillDef) then
			self:ApplyCasterPostDelayFreeze(cast)
		end
		local eventsByFrame = cast.SkillDef.EventsByFrame
		if eventsByFrame == nil then
			return
		end
		local effectiveFrame = math.floor(self:ReadNumber(frame, 0)) - preFrames
		if effectiveFrame < 0 then
			return
		end
		local eventIds = eventsByFrame[effectiveFrame]
		if eventIds == nil then
			return
		end
		for index, eventId in ipairs(eventIds) do
			self:StartSkillEvent(cast, eventId)
		end
	end

	method void StartSkillEvent(any cast, string eventId)
		-- Starts one skill event from a timeline frame.
		local safeEventId = self:ReadString(eventId, "")
		local eventDef = self._T.skillEventCatalog[safeEventId]
		if eventDef == nil then
			self:Log("event skipped reason=missing skill=" .. self:ReadString(cast.SkillKey, "") .. " event=" .. safeEventId)
			return
		end
		local eventType = self:ReadString(eventDef.Type, "action")
		if eventType == "area" then
			self:StartAreaCapture(cast, eventDef)
		elseif eventType == "projectile" then
			self:StartProjectile(cast, eventDef)
		elseif eventType == "field" then
			self:StartField(cast, eventDef)
		else
			local origin = self:GetContextOrigin(cast)
			self:ExecuteActions(cast, eventDef.ActionIds, nil, origin.x, origin.y, self:ReadString(eventDef.EventId, "action"))
		end
	end

	method void FinishSkillCast(any cast, boolean cancelled)
		-- Restores action limits and advances the queued chain after one cast ends.
		if cast == nil then
			return
		end
		if cancelled == true then
			self:Log("skill cancelled user=" .. self:ReadString(cast.UserId, "") .. " skill=" .. self:ReadString(cast.SkillKey, ""))
		else
			self:Log("skill end user=" .. self:ReadString(cast.UserId, "") .. " skill=" .. self:ReadString(cast.SkillKey, ""))
		end
		if cast.IsVirtualCaster ~= true then
			local userId = self:ReadString(cast.UserId, "")
			local runtime = self:GetChainRuntime(userId)
			local activeCount = math.max(0, math.floor(self:ReadNumber(runtime.ActiveCastCount, 0)) - 1)
			runtime.ActiveCastCount = activeCount
			if activeCount <= 0 then
				self:RestoreCasterActionLimit(cast)
				runtime.ActiveUntil = 0
				if cancelled == true then
					-- Chain cancelled and no cast left running → release the full-chain movement lock.
					self:RestoreCasterChainLock(userId)
					self:ClearQueuedChainRuntime(runtime)
				elseif self:HasPendingChainSteps(runtime) == true then
					-- More steps queued → keep the lock and start the next step.
					self:StartNextQueuedChainStep(cast.CasterEntity, userId, runtime)
				else
					if runtime.PendingSteps ~= nil then
						self:Log("chain sequence end user=" .. userId .. " skills=" .. self:ReadString(runtime.PendingSummary, ""))
					end
					-- Whole chain finished → release the full-chain movement lock.
					self:RestoreCasterChainLock(userId)
					self:ClearQueuedChainRuntime(runtime)
				end
			end
		end
	end

	method void StartAreaCapture(any context, any eventDef)
		-- Creates a duration-based invisible hitbox area that follows the caster unless virtual.
		local origin = self:GetContextOrigin(context)
		local fixedOriginX = nil
		local fixedOriginY = nil
		if context.IsVirtualCaster == true or context.FixedOriginX ~= nil or (context.X ~= nil and context.Y ~= nil) then
			fixedOriginX = origin.x
			fixedOriginY = origin.y
		end
		local area = {
			EventId = self:ReadString(eventDef.EventId, ""),
			UserId = self:ReadString(context.UserId, ""),
			CasterEntity = context.CasterEntity,
			SourceEntity = context.SourceEntity,
			SkillKey = self:ReadString(context.SkillKey, ""),
			EffectIds = context.EffectIds,
			Tier = self:ClampSkillTier(context.Tier),
			IsVirtualCaster = context.IsVirtualCaster == true,
			Direction = self:GetContextDirection(context),
			FixedOriginX = fixedOriginX,
			FixedOriginY = fixedOriginY,
			EndSkillDef = context.EndSkillDef,
			EndTier = math.max(0, math.floor(self:ReadNumber(context.EndTier, 0))),
			RemainingFrames = math.max(1, math.floor(self:ReadNumber(eventDef.DurationFrames, 1))),
			FrameTimer = 0,
			TickIntervalFrames = math.max(1, math.floor(self:ReadNumber(eventDef.TickIntervalFrames, 1))),
			TickFrameCounter = 0,
			HitboxIds = eventDef.HitboxIds,
			ActionIds = eventDef.ActionIds,
			MaxTargets = math.max(0, math.floor(self:ReadNumber(eventDef.MaxTargets, 0))),
			HitCount = 0,
			SeenTargets = {},
			MesoFollowUpCount = math.max(0, math.floor(self:ReadNumber(context.MesoFollowUpCount, 0))),
			MesoAttacker = context.MesoAttacker,
			TriggerFired = false,
			SuppressMainEffect = context.MainEffectPlayed == true or (context.X ~= nil and context.Y ~= nil),
			MesoSeenTargets = {},
			DamageRate = self:ReadNumber(context.DamageRate, 1)
		}
		table.insert(self._T.activeAreas, area)
		if area.SuppressMainEffect ~= true then
			self:PlaySkillVisualForEvent(area, area.EventId, origin.x, origin.y, false)
		end
		self:Log("area start user=" .. area.UserId .. " event=" .. area.EventId .. " frames=" .. tostring(area.RemainingFrames))
	end

	method void TickActiveAreas(number delta)
		-- Updates every active target-capture area once per skill frame.
		for index = #self._T.activeAreas, 1, -1 do
			local area = self._T.activeAreas[index]
			if area == nil then
				table.remove(self._T.activeAreas, index)
			else
				area.FrameTimer = self:ReadNumber(area.FrameTimer, 0) + self:ReadNumber(delta, 0)
				local frameSeconds = self:GetSkillFrameSeconds()
				while area.FrameTimer >= frameSeconds and area.RemainingFrames > 0 do
					area.FrameTimer = area.FrameTimer - frameSeconds
					self:ProcessAreaFrame(area)
					area.RemainingFrames = area.RemainingFrames - 1
				end
				if area.RemainingFrames <= 0 then
					self:Log("area end user=" .. self:ReadString(area.UserId, "") .. " event=" .. self:ReadString(area.EventId, ""))
					table.remove(self._T.activeAreas, index)
				end
			end
		end
	end

	method void ProcessAreaFrame(any area)
		-- Detects targets inside one active area and runs its actions once per target.
		self:ShowHitboxesForContext(area, "area:" .. self:ReadString(area.EventId, "area"))
		local targets = self:CollectTargetsForContext(area)
		local maxTargets = math.max(0, math.floor(self:ReadNumber(area.MaxTargets, 0)))
		for index, targetEntity in ipairs(targets) do
			if maxTargets > 0 and self:ReadNumber(area.HitCount, 0) >= maxTargets then
				return
			end
			if self:IsSkillTargetValid(area, targetEntity) == true and self:IsTargetInsideHitboxes(area, targetEntity) == true then
				local targetKey = self:GetEntityKey(targetEntity)
				if area.SeenTargets[targetKey] ~= true then
					area.SeenTargets[targetKey] = true
					area.HitCount = self:ReadNumber(area.HitCount, 0) + 1
					local pos = self:GetEntityPosition2(targetEntity)
					self:ExecuteActions(area, area.ActionIds, targetEntity, pos.x, pos.y, self:ReadString(area.EventId, "area"))
				end
			end
		end
	end

	method void StartProjectile(any context, any eventDef)
		-- Creates a logical projectile that moves in the skill direction and executes actions on contact.
		local origin = self:GetContextOrigin(context)
		local direction = self:GetContextDirection(context)
		if eventDef.FrontDirection == false then
			direction = -direction
		end
		local projectile = {
			EventId = self:ReadString(eventDef.EventId, ""),
			UserId = self:ReadString(context.UserId, ""),
			CasterEntity = context.CasterEntity,
			SourceEntity = context.SourceEntity,
			SkillKey = self:ReadString(context.SkillKey, ""),
			EffectIds = context.EffectIds,
			VisualRUID = self:ReadString(eventDef.ProjectileEffectRUID, self:ReadString(eventDef.ProjectileSpriteRUID, "")),
			Tier = self:ClampSkillTier(context.Tier),
			IsVirtualCaster = context.IsVirtualCaster == true,
			Direction = direction,
			X = origin.x,
			Y = origin.y,
			Travelled = 0,
			Speed = math.max(0.1, self:ReadNumber(eventDef.Speed, 6)),
			Range = math.max(0.1, self:ReadNumber(eventDef.Range, 5)),
			SpinDegreesPerSecond = self:ReadNumber(eventDef.ProjectileSpinDegreesPerSecond, 0),
			SpinAngle = 0,
			Pierce = self:ReadProjectilePierce(eventDef.Pierce),
			HitboxIds = eventDef.HitboxIds,
			ActionIds = eventDef.ActionIds,
			CollisionEventIds = eventDef.CollisionEventIds,
			ExpireEventIds = eventDef.ExpireEventIds,
			SeenTargets = {},
			EndSkillDef = context.EndSkillDef,
			EndTier = math.max(0, math.floor(self:ReadNumber(context.EndTier, 0))),
			MesoFollowUpCount = math.max(0, math.floor(self:ReadNumber(context.MesoFollowUpCount, 0))),
			MesoAttacker = context.MesoAttacker,
			MesoSeenTargets = {},
			DamageRate = self:ReadNumber(context.DamageRate, 1),
			VisualEntity = nil
		}
		table.insert(self._T.activeProjectiles, projectile)
		self:SpawnProjectileObject(projectile)
		self:Log("projectile start user=" .. projectile.UserId .. " event=" .. projectile.EventId .. " speed=" .. tostring(projectile.Speed) .. " spin=" .. tostring(projectile.SpinDegreesPerSecond) .. " pierce=" .. tostring(projectile.Pierce))
	end

	method void TickActiveProjectiles(number delta)
		-- Moves active logical projectiles and resolves contact.
		for index = #self._T.activeProjectiles, 1, -1 do
			local projectile = self._T.activeProjectiles[index]
			if projectile == nil then
				table.remove(self._T.activeProjectiles, index)
			else
				local move = projectile.Speed * self:ReadNumber(delta, 0)
				projectile.X = self:ReadNumber(projectile.X, 0) + projectile.Direction * move
				projectile.Travelled = self:ReadNumber(projectile.Travelled, 0) + math.abs(move)
				local spinDegrees = self:ReadNumber(projectile.SpinDegreesPerSecond, 0)
				if spinDegrees ~= 0 then
					projectile.SpinAngle = self:ReadNumber(projectile.SpinAngle, 0) + spinDegrees * self:ReadNumber(projectile.Direction, 1) * self:ReadNumber(delta, 0)
				end
				local clampedProjectilePosition = self:ClampContextPositionToMapBounds(projectile, Vector2(projectile.X, projectile.Y))
				if math.abs(clampedProjectilePosition.x - projectile.X) > 0.001 or math.abs(clampedProjectilePosition.y - projectile.Y) > 0.001 then
					projectile.X = clampedProjectilePosition.x
					projectile.Y = clampedProjectilePosition.y
					projectile.Remove = true
					self:Log("projectile bound stop user=" .. self:ReadString(projectile.UserId, "") .. " event=" .. self:ReadString(projectile.EventId, ""))
				end
				self:UpdateProjectileObjectTransform(projectile)
				if projectile.Remove ~= true then
					self:ProcessProjectileContact(projectile)
				end
				if projectile.Remove == true or projectile.Travelled >= projectile.Range then
					if projectile.Expired ~= true then
						projectile.Expired = true
						self:TryPlayPiercingExplosionBurst(projectile)
						self:ExecuteEventsForContext(projectile, projectile.ExpireEventIds, nil, projectile.X, projectile.Y, self:ReadString(projectile.EventId, "projectile") .. ":expire")
					end
					self:Log("projectile end user=" .. self:ReadString(projectile.UserId, "") .. " event=" .. self:ReadString(projectile.EventId, ""))
					self:DestroyProjectileObject(projectile, 0)
					table.remove(self._T.activeProjectiles, index)
				end
			end
		end
	end

	method void ProcessProjectileContact(any projectile)
		-- Applies projectile actions to newly contacted targets.
		self:ShowHitboxesForContext(projectile, "projectile:" .. self:ReadString(projectile.EventId, "projectile"))
		local targets = self:CollectTargetsForContext(projectile)
		for index, targetEntity in ipairs(targets) do
			if self:IsSkillTargetValid(projectile, targetEntity) == true and self:IsTargetInsideHitboxes(projectile, targetEntity) == true then
				local targetKey = self:GetEntityKey(targetEntity)
				if projectile.SeenTargets[targetKey] ~= true then
					projectile.SeenTargets[targetKey] = true
					local hitX = self:ReadNumber(projectile.X, 0)
					local hitY = self:ReadNumber(projectile.Y, 0)
					self:Log("projectile hit user=" .. self:ReadString(projectile.UserId, "") .. " event=" .. self:ReadString(projectile.EventId, "projectile") .. " target=" .. targetKey .. " at=(" .. tostring(hitX) .. "," .. tostring(hitY) .. ")")
					if projectile.CollisionEventIds ~= nil and #projectile.CollisionEventIds > 0 then
						-- Collision events run gameplay actions only. Target hit visuals are handled by damage action data.
						self:ExecuteEventsForContext(projectile, projectile.CollisionEventIds, targetEntity, hitX, hitY, self:ReadString(projectile.EventId, "projectile") .. ":collision")
					else
						self:ExecuteActions(projectile, projectile.ActionIds, targetEntity, hitX, hitY, self:ReadString(projectile.EventId, "projectile"))
					end
					local pierce = math.floor(self:ReadNumber(projectile.Pierce, 0))
					if pierce == 0 then
						projectile.Remove = true
						return
					end
					if pierce > 0 then
						projectile.Pierce = pierce - 1
					end
				end
			end
		end
	end

	method void PlayProjectileCollisionVisual(any projectile, any collisionEventIds, number hitX, number hitY, string sourceId)
		-- Plays the impact effect mapped to a projectile collision event.
		if collisionEventIds == nil then
			return
		end
		for index, eventId in ipairs(collisionEventIds) do
			local safeEventId = self:ReadString(eventId, "")
			local ruid = self:GetSkillEffectRUID(safeEventId)
			if ruid ~= "" then
				local scale = math.max(0.05, self:GetSkillEffectScale(safeEventId) * 0.7)
				self:PlaySkillVisualAt(projectile, ruid, hitX, hitY, self:GetContextDirection(projectile), scale, "projectile-hit:" .. safeEventId)
				self:Log("projectile hit visual source=" .. self:ReadString(sourceId, "projectile") .. " event=" .. safeEventId .. " ruid=" .. ruid)
				return
			end
		end
		self:Log("projectile hit visual skipped source=" .. self:ReadString(sourceId, "projectile") .. " reason=missing-effect")
	end

	method void SpawnProjectileObject(any projectile)
		if projectile == nil then
			return
		end
		local visualRuid = self:ReadString(projectile.VisualRUID, "")
		if visualRuid == "" then
			self:Log("projectile visual skipped: ruid empty event=" .. self:ReadString(projectile.EventId, "projectile"))
			return
		end
		local mapName = self:GetContextMapName(projectile)
		if mapName == "" then
			self:Log("projectile visual skipped: map empty event=" .. self:ReadString(projectile.EventId, "projectile"))
			return
		end
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil or isvalid(mapEntity) == false then
			self:Log("projectile visual skipped: map missing map=" .. mapName)
			return
		end
		local modelId = self:ReadString(self.ProjectileObjectModelId, "")
		if modelId == "" then
			modelId = self:ReadString(self.SummonObjectModelId, "")
		end
		if modelId == "" then
			self:Log("projectile visual skipped: model id empty")
			return
		end
		if self._T.projectileObjectSeq == nil then
			self._T.projectileObjectSeq = 0
		end
		self._T.projectileObjectSeq = self._T.projectileObjectSeq + 1
		local name = "SkillProjectile_" .. tostring(self._T.projectileObjectSeq) .. "_" .. tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000))
		local entity = _SpawnService:SpawnByModelId(modelId, name, Vector3(self:ReadNumber(projectile.X, 0), self:ReadNumber(projectile.Y, 0) + self:GetProjectileVisualYOffset(), 0), mapEntity)
		if entity == nil then
			self:Log("projectile visual spawn failed model=" .. modelId .. " event=" .. self:ReadString(projectile.EventId, "projectile"))
			return
		end
		projectile.VisualEntity = entity
		self:ApplyProjectileObjectRenderer(entity, projectile)
		self:Log("projectile visual spawned event=" .. self:ReadString(projectile.EventId, "projectile") .. " name=" .. self:ReadString(entity.Name, "") .. " speed=" .. tostring(self:ReadNumber(projectile.Speed, 0)) .. " spin=" .. tostring(self:ReadNumber(projectile.SpinDegreesPerSecond, 0)))
	end

	method void ApplyProjectileObjectRenderer(Entity entity, any projectile)
		if entity == nil or isvalid(entity) == false then
			return
		end
		local scale = self:GetProjectileVisualScale()
		if entity.TransformComponent ~= nil then
			entity.TransformComponent.Scale = Vector3(scale, scale, 1)
			entity.TransformComponent.ZRotation = self:ReadNumber(projectile.SpinAngle, 0)
		end
		if entity.SpriteRendererComponent ~= nil then
			entity.SpriteRendererComponent.SpriteRUID = self:ReadString(projectile.VisualRUID, "")
			entity.SpriteRendererComponent.SortingLayer = "MapLayer0"
			entity.SpriteRendererComponent.OrderInLayer = math.floor(self:ReadNumber(self.SkillEffectOrderInLayer, 30))
			entity.SpriteRendererComponent.IgnoreMapLayerCheck = true
			entity.SpriteRendererComponent.PlayRate = 1.0
			entity.SpriteRendererComponent.FlipX = self:GetContextDirection(projectile) > 0
			entity.SpriteRendererComponent:SetAlpha(math.max(0, math.min(1, self:ReadNumber(self.SkillEffectAlpha, 1))))
		end
	end

	method void UpdateProjectileObjectTransform(any projectile)
		if projectile == nil or projectile.VisualEntity == nil then
			return
		end
		local entity = projectile.VisualEntity
		if entity == nil or isvalid(entity) == false then
			projectile.VisualEntity = nil
			return
		end
		local scale = self:GetProjectileVisualScale()
		if entity.TransformComponent ~= nil then
			entity.TransformComponent.Position = Vector3(self:ReadNumber(projectile.X, 0), self:ReadNumber(projectile.Y, 0) + self:GetProjectileVisualYOffset(), 0)
			entity.TransformComponent.Scale = Vector3(scale, scale, 1)
			entity.TransformComponent.ZRotation = self:ReadNumber(projectile.SpinAngle, 0)
		end
		if entity.SpriteRendererComponent ~= nil then
			entity.SpriteRendererComponent.FlipX = self:GetContextDirection(projectile) > 0
		end
	end

	method void DestroyProjectileObject(any projectile, number delaySeconds)
		if projectile == nil or projectile.VisualEntity == nil then
			return
		end
		local entity = projectile.VisualEntity
		projectile.VisualEntity = nil
		if entity ~= nil and isvalid(entity) == true then
			entity:Destroy(math.max(0, self:ReadNumber(delaySeconds, 0)))
		end
	end

	method number GetProjectileVisualYOffset()
		return self:ReadNumber(self.ProjectileObjectYOffset, 0.35)
	end

	method number GetProjectileVisualScale()
		return math.max(0.05, self:ReadNumber(self.ProjectileObjectScale, 0.85) * math.max(0.05, self:ReadNumber(self.SkillEffectScale, 1)))
	end

	method void StartField(any context, any eventDef)
		-- Creates a fixed-position field area with repeated target capture.
		local origin = self:GetContextOrigin(context)
		local field = {
			EventId = self:ReadString(eventDef.EventId, ""),
			UserId = self:ReadString(context.UserId, ""),
			CasterEntity = context.CasterEntity,
			SourceEntity = context.SourceEntity,
			SkillKey = self:ReadString(context.SkillKey, ""),
			EffectIds = context.EffectIds,
			Tier = self:ClampSkillTier(context.Tier),
			IsVirtualCaster = context.IsVirtualCaster == true,
			Direction = self:GetContextDirection(context),
			FixedOriginX = origin.x,
			FixedOriginY = origin.y,
			RemainingFrames = math.max(1, math.floor(self:ReadNumber(eventDef.DurationFrames, 1))),
			FrameTimer = 0,
			TickIntervalFrames = math.max(1, math.floor(self:ReadNumber(eventDef.TickIntervalFrames, 1))),
			TickFrameCounter = 0,
			HitboxIds = eventDef.HitboxIds,
			ActionIds = eventDef.ActionIds,
			TargetGroup = self:ReadString(eventDef.TargetGroup, ""),
			MaxTargets = math.max(0, math.floor(self:ReadNumber(eventDef.MaxTargets, 0))),
			HitCount = 0,
			SeenTargets = {},
			EndSkillDef = context.EndSkillDef,
			EndTier = math.max(0, math.floor(self:ReadNumber(context.EndTier, 0))),
			MesoFollowUpCount = math.max(0, math.floor(self:ReadNumber(context.MesoFollowUpCount, 0))),
			MesoAttacker = context.MesoAttacker,
			MesoSeenTargets = {},
			TriggerFired = false,
			DamageRate = self:ReadNumber(context.DamageRate, 1),
			VisualTimer = 0
		}
		table.insert(self._T.activeFields, field)
		self:PlaySkillVisualForEvent(field, field.EventId, origin.x, origin.y, true)
		self:Log("field start user=" .. field.UserId .. " event=" .. field.EventId)
	end

	method void TickActiveFields(number delta)
		-- Ticks fixed fields; field hit memory resets each frame to support repeated ticks.
		for index = #self._T.activeFields, 1, -1 do
			local field = self._T.activeFields[index]
			if field == nil then
				table.remove(self._T.activeFields, index)
			else
				field.FrameTimer = self:ReadNumber(field.FrameTimer, 0) + self:ReadNumber(delta, 0)
				field.VisualTimer = self:ReadNumber(field.VisualTimer, 0) + self:ReadNumber(delta, 0)
				if field.VisualTimer >= 0.45 then
					field.VisualTimer = 0
					local origin = self:GetContextOrigin(field)
					self:PlaySkillVisualForEvent(field, self:ReadString(field.EventId, ""), origin.x, origin.y, true)
				end
				local frameSeconds = self:GetSkillFrameSeconds()
				while field.FrameTimer >= frameSeconds and field.RemainingFrames > 0 do
					field.FrameTimer = field.FrameTimer - frameSeconds
					field.RemainingFrames = field.RemainingFrames - 1
					field.TickFrameCounter = self:ReadNumber(field.TickFrameCounter, 0) + 1
					if self:ReadNumber(field.TickFrameCounter, 0) >= math.max(1, math.floor(self:ReadNumber(field.TickIntervalFrames, 1))) then
						field.TickFrameCounter = 0
						field.SeenTargets = {}
						field.HitCount = 0
						self:ProcessAreaFrame(field)
					end
				end
				if field.RemainingFrames <= 0 then
					self:Log("field end user=" .. self:ReadString(field.UserId, "") .. " event=" .. self:ReadString(field.EventId, ""))
					table.remove(self._T.activeFields, index)
				end
			end
		end
	end

	method void StartSummonFromAction(any context, any actionDef, number triggerX, number triggerY, string sourceId)
		-- Starts one or more logical summons that attack from their own runtime positions.
		local origin = self:GetContextOrigin(context)
		local direction = self:GetContextDirection(context)
		local offsets = actionDef.Offsets
		if offsets == nil or #offsets <= 0 then
			offsets = { Vector2(0, 0) }
		end
		for index, offset in ipairs(offsets) do
			local startX = origin.x + direction * self:ReadNumber(offset.x, 0)
			local startY = origin.y + self:ReadNumber(offset.y, 0)
			local summon = {
				ActionId = self:ReadString(actionDef.ActionId, "summon"),
				UserId = self:ReadString(context.UserId, ""),
				CasterEntity = context.CasterEntity,
				SourceEntity = context.SourceEntity,
				SkillKey = self:ReadString(context.SkillKey, ""),
				Tier = self:ClampSkillTier(context.Tier),
				Direction = direction,
				X = startX,
				Y = startY,
				HomeOffsetX = self:ReadNumber(offset.x, 0),
				HomeOffsetY = self:ReadNumber(offset.y, 0),
				RemainingFrames = math.max(1, math.floor(self:ReadNumber(actionDef.DurationFrames, 1))),
				FrameTimer = 0,
				AttackIntervalFrames = math.max(1, math.floor(self:ReadNumber(actionDef.AttackIntervalFrames, 20))),
				AttackFrameCounter = 0,
				AttackCycle = 0,
				VisualTimer = 0,
				VisualIntervalSeconds = math.max(0.05, self:ReadNumber(actionDef.VisualIntervalSeconds, 0.45)),
				StandEffectIds = actionDef.StandEffectIds,
				MoveEffectIds = actionDef.MoveEffectIds,
				AttackEffectIds = actionDef.AttackEffectIds,
				SummonedEffectIds = actionDef.SummonedEffectIds,
				DieEffectIds = actionDef.DieEffectIds,
				HitEffectRUID = self:ReadString(actionDef.HitEffectRUID, ""),
				HitboxIds = actionDef.HitboxIds,
				TargetGroup = self:ReadString(actionDef.TargetGroup, ""),
				MaxTargets = math.max(0, math.floor(self:ReadNumber(actionDef.MaxTargets, 0))),
				Coefficient = math.max(0, self:ReadNumber(actionDef.Coefficient, 100)),
				MoveEnabled = actionDef.MoveEnabled == true,
				FollowSpeed = math.max(0.1, self:ReadNumber(actionDef.FollowSpeed, 3.6)),
				ScaleRate = math.max(0.05, self:ReadNumber(actionDef.ScaleRate, 0.85)),
				SummonIndex = index,
				Entity = nil,
				IsMoving = false,
				EndSkillDef = context.EndSkillDef,
				EndTier = math.max(0, math.floor(self:ReadNumber(context.EndTier, 0))),
				IsVirtualCaster = context.IsVirtualCaster == true,
				MesoFollowUpCount = math.max(0, math.floor(self:ReadNumber(context.MesoFollowUpCount, 0))),
				MesoAttacker = context.MesoAttacker,
				MesoSeenTargets = {},
				TriggerFired = false,
				VisualState = "",
				VisualRUID = "",
				VisualHoldSeconds = 0
			}
			local clamped = self:ClampContextPositionToMapBounds(summon, Vector2(summon.X, summon.Y))
			summon.X = clamped.x
			summon.Y = clamped.y
			table.insert(self._T.activeSummons, summon)
			self:SpawnSummonObject(summon, index)
			self:PlaySummonVisual(summon, summon.SummonedEffectIds, index, summon.X, summon.Y, "summoned:" .. summon.ActionId)
			self:UpdateSummonIdleVisual(summon)
		end
		self:Log("summon action user=" .. self:ReadString(context.UserId, "") .. " action=" .. self:ReadString(actionDef.ActionId, "") .. " count=" .. tostring(#offsets) .. " source=" .. self:ReadString(sourceId, ""))
	end

	method void TickActiveSummons(number delta)
		-- Updates logical summons continuously while their attack cadence remains frame-based.
		if self._T.activeSummons == nil then
			return
		end
		local dt = math.max(0, self:ReadNumber(delta, 0))
		for index = #self._T.activeSummons, 1, -1 do
			local summon = self._T.activeSummons[index]
			if summon == nil or summon.CasterEntity == nil or isvalid(summon.CasterEntity) == false then
				self:DestroySummonObject(summon, 0)
				table.remove(self._T.activeSummons, index)
			else
				self:UpdateSummonFollow(summon, dt)
				self:UpdateSummonObjectTransform(summon)
				summon.FrameTimer = self:ReadNumber(summon.FrameTimer, 0) + dt
				summon.VisualHoldSeconds = math.max(0, self:ReadNumber(summon.VisualHoldSeconds, 0) - dt)
				if self:ReadNumber(summon.VisualHoldSeconds, 0) <= 0 then
					self:UpdateSummonIdleVisual(summon)
				end
				local frameSeconds = self:GetSkillFrameSeconds()
				while summon.FrameTimer >= frameSeconds and summon.RemainingFrames > 0 do
					summon.FrameTimer = summon.FrameTimer - frameSeconds
					summon.RemainingFrames = summon.RemainingFrames - 1
					summon.AttackFrameCounter = self:ReadNumber(summon.AttackFrameCounter, 0) + 1
					if self:ReadNumber(summon.AttackFrameCounter, 0) >= self:ReadNumber(summon.AttackIntervalFrames, 20) then
						summon.AttackFrameCounter = 0
						self:ProcessSummonAttack(summon)
					end
				end
				if summon.RemainingFrames <= 0 then
					self:SetSummonObjectVisual(summon, summon.DieEffectIds, self:ReadNumber(summon.AttackCycle, 0) + 1, "die")
					self:DestroySummonObject(summon, 0.35)
					self:Log("summon end user=" .. self:ReadString(summon.UserId, "") .. " action=" .. self:ReadString(summon.ActionId, "summon"))
					table.remove(self._T.activeSummons, index)
				end
			end
		end
	end

	method void UpdateSummonFollow(any summon, number delta)
		if summon == nil or summon.MoveEnabled ~= true then
			return
		end
		local caster = summon.CasterEntity
		if caster == nil or isvalid(caster) == false then
			return
		end
		local casterPos = self:GetEntityPosition2(caster)
		local direction = self:GetLookDirection(caster)
		summon.Direction = direction
		local targetX = casterPos.x + direction * self:ReadNumber(summon.HomeOffsetX, 0)
		local targetY = casterPos.y + self:ReadNumber(summon.HomeOffsetY, 0)
		local dx = targetX - self:ReadNumber(summon.X, 0)
		local dy = targetY - self:ReadNumber(summon.Y, 0)
		local distance = math.sqrt(dx * dx + dy * dy)
		if distance <= 0.001 then
			summon.IsMoving = false
			return
		end
		local move = math.min(distance, math.max(0, self:ReadNumber(summon.FollowSpeed, 3.6)) * math.max(0, self:ReadNumber(delta, 0)))
		summon.X = self:ReadNumber(summon.X, 0) + dx / distance * move
		summon.Y = self:ReadNumber(summon.Y, 0) + dy / distance * move
		summon.IsMoving = move > 0.001
		local clamped = self:ClampContextPositionToMapBounds(summon, Vector2(summon.X, summon.Y))
		summon.X = clamped.x
		summon.Y = clamped.y
	end

	method void ProcessSummonAttack(any summon)
		if summon == nil then
			return
		end
		summon.AttackCycle = self:ReadNumber(summon.AttackCycle, 0) + 1
		self:SetSummonObjectVisual(summon, summon.AttackEffectIds, self:ReadNumber(summon.SummonIndex, 1) + self:ReadNumber(summon.AttackCycle, 1) - 1, "attack")
		self:ShowHitboxesForContext(summon, "summon:" .. self:ReadString(summon.ActionId, "summon"))
		local targets = self:CollectTargetsForContext(summon)
		local maxTargets = math.max(0, math.floor(self:ReadNumber(summon.MaxTargets, 0)))
		local hitCount = 0
		local damageAction = {
			Coefficient = math.max(0, self:ReadNumber(summon.Coefficient, 100)),
			HitEffectRUID = self:ReadString(summon.HitEffectRUID, "")
		}
		for index, targetEntity in ipairs(targets) do
			if maxTargets > 0 and hitCount >= maxTargets then
				return
			end
			if self:IsSkillTargetValid(summon, targetEntity) == true and self:IsTargetInsideHitboxes(summon, targetEntity) == true then
				hitCount = hitCount + 1
				local pos = self:GetEntityPosition2(targetEntity)
				self:ApplySkillDamage(summon, targetEntity, damageAction, "summon:" .. self:ReadString(summon.ActionId, "summon"))
				self:PlaySkillHitVisual(summon, pos.x, pos.y, "summon:" .. self:ReadString(summon.ActionId, "summon"), damageAction.HitEffectRUID)
				self:TrySpawnMesoFollowUp(summon, targetEntity)
			end
		end
	end

	method void SpawnSummonObject(any summon, number index)
		if summon == nil then
			return
		end
		local mapName = self:GetContextMapName(summon)
		if mapName == "" then
			self:Log("summon object spawn skipped: map empty action=" .. self:ReadString(summon.ActionId, "summon"))
			return
		end
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil or isvalid(mapEntity) == false then
			self:Log("summon object spawn skipped: map missing map=" .. mapName)
			return
		end
		local modelId = self:ReadString(self.SummonObjectModelId, "")
		if modelId == "" then
			self:Log("summon object spawn skipped: model id empty")
			return
		end
		if self._T.summonObjectSeq == nil then
			self._T.summonObjectSeq = 0
		end
		self._T.summonObjectSeq = self._T.summonObjectSeq + 1
		local name = "SkillSummon_" .. tostring(self._T.summonObjectSeq) .. "_" .. tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000))
		local x = self:ReadNumber(summon.X, 0)
		local y = self:ReadNumber(summon.Y, 0) + self:ReadNumber(self.SummonObjectYOffset, 0.15)
		local entity = _SpawnService:SpawnByModelId(modelId, name, Vector3(x, y, 0), mapEntity)
		if entity == nil then
			self:Log("summon object spawn failed model=" .. modelId .. " action=" .. self:ReadString(summon.ActionId, "summon"))
			return
		end
		summon.Entity = entity
		self:ApplySummonObjectRenderer(entity, summon)
		self:Log("summon object spawned action=" .. self:ReadString(summon.ActionId, "summon") .. " index=" .. tostring(index) .. " name=" .. self:ReadString(entity.Name, ""))
	end

	method void ApplySummonObjectRenderer(Entity entity, any summon)
		if entity == nil or isvalid(entity) == false then
			return
		end
		local scale = math.max(0.05, self:ReadNumber(summon.ScaleRate, 0.85))
		if entity.TransformComponent ~= nil then
			entity.TransformComponent.Scale = Vector3(scale, scale, 1)
		end
		if entity.SpriteRendererComponent ~= nil then
			entity.SpriteRendererComponent.SortingLayer = "MapLayer0"
			entity.SpriteRendererComponent.OrderInLayer = math.floor(self:ReadNumber(self.SkillEffectOrderInLayer, 30))
			entity.SpriteRendererComponent.IgnoreMapLayerCheck = true
			entity.SpriteRendererComponent.PlayRate = 1.0
			entity.SpriteRendererComponent.FlipX = self:GetContextDirection(summon) > 0
			entity.SpriteRendererComponent:SetAlpha(math.max(0, math.min(1, self:ReadNumber(self.SkillEffectAlpha, 1))))
		end
	end

	method void UpdateSummonObjectTransform(any summon)
		if summon == nil or summon.Entity == nil or isvalid(summon.Entity) == false then
			return
		end
		local entity = summon.Entity
		local scale = math.max(0.05, self:ReadNumber(summon.ScaleRate, 0.85))
		if entity.TransformComponent ~= nil then
			entity.TransformComponent.Position = Vector3(self:ReadNumber(summon.X, 0), self:ReadNumber(summon.Y, 0) + self:ReadNumber(self.SummonObjectYOffset, 0.15), 0)
			entity.TransformComponent.Scale = Vector3(scale, scale, 1)
		end
		if entity.SpriteRendererComponent ~= nil then
			entity.SpriteRendererComponent.FlipX = self:GetContextDirection(summon) > 0
		end
	end

	method void UpdateSummonIdleVisual(any summon)
		if summon == nil then
			return
		end
		local idleEffectIds = summon.StandEffectIds
		local idleState = "stand"
		if summon.MoveEnabled == true and summon.IsMoving == true then
			local moveEffectIds = summon.MoveEffectIds
			if moveEffectIds ~= nil and #moveEffectIds > 0 then
				idleEffectIds = moveEffectIds
				idleState = "move"
			end
		end
		self:SetSummonObjectVisual(summon, idleEffectIds, self:ReadNumber(summon.SummonIndex, 1), idleState)
	end

	method void SetSummonObjectVisual(any summon, any effectIds, number index, string stateName)
		if summon == nil then
			return
		end
		local effectId = self:GetListValue(effectIds, index)
		local ruid = self:GetSkillEffectRUID(effectId)
		if ruid == "" then
			return
		end
		local safeState = self:ReadString(stateName, "stand")
		local stateKey = safeState .. ":" .. effectId
		if safeState ~= "attack" and safeState ~= "die" and self:ReadString(summon.VisualState, "") == stateKey and self:ReadString(summon.VisualRUID, "") == ruid then
			return
		end
		summon.VisualState = stateKey
		summon.VisualRUID = ruid
		if safeState == "attack" then
			summon.VisualHoldSeconds = math.max(0.05, self:ReadNumber(self.SummonAttackVisualHoldSeconds, 0.28))
		elseif safeState == "die" then
			summon.VisualHoldSeconds = 1
		end
		local entity = summon.Entity
		if entity == nil or isvalid(entity) == false or entity.SpriteRendererComponent == nil then
			if safeState == "attack" or safeState == "die" then
				self:PlaySkillVisualAt(summon, ruid, self:ReadNumber(summon.X, 0), self:ReadNumber(summon.Y, 0) + self:ReadNumber(self.SummonObjectYOffset, 0.15), self:GetContextDirection(summon), self:ReadNumber(summon.ScaleRate, 0.85), "summon-object-fallback:" .. stateKey)
			end
			return
		end
		self:ApplySummonObjectRenderer(entity, summon)
		entity.SpriteRendererComponent.SpriteRUID = ruid
	end

	method void DestroySummonObject(any summon, number delaySeconds)
		if summon == nil or summon.Entity == nil then
			return
		end
		local entity = summon.Entity
		summon.Entity = nil
		if entity ~= nil and isvalid(entity) == true then
			entity:Destroy(math.max(0, self:ReadNumber(delaySeconds, 0)))
		end
	end

	method void PlaySummonVisual(any summon, any effectIds, number index, number x, number y, string sourceId)
		local effectId = self:GetListValue(effectIds, index)
		local ruid = self:GetSkillEffectRUID(effectId)
		if ruid == "" then
			return
		end
		self:PlaySkillVisualAt(summon, ruid, x, y, self:GetContextDirection(summon), self:ReadNumber(summon.ScaleRate, 0.85), sourceId)
	end

	method string GetListValue(any values, number index)
		if values == nil or #values <= 0 then
			return ""
		end
		local count = #values
		local safeIndex = math.max(1, math.floor(self:ReadNumber(index, 1)))
		local wrapped = ((safeIndex - 1) % count) + 1
		return self:ReadString(values[wrapped], "")
	end

	method void ExecuteActions(any context, any actionIds, Entity targetEntity, number triggerX, number triggerY, string sourceId)
		-- Executes action ids sequentially with the supplied context and target.
		if actionIds == nil then
			return
		end
		for index, actionId in ipairs(actionIds) do
			local safeActionId = self:ReadString(actionId, "")
			local actionDef = self._T.skillActionCatalog[safeActionId]
			if actionDef ~= nil then
				self:ExecuteAction(context, actionDef, targetEntity, triggerX, triggerY, sourceId)
			else
				self:Log("action skipped reason=missing source=" .. self:ReadString(sourceId, "") .. " action=" .. safeActionId)
			end
		end
	end

	method void ExecuteEventsForContext(any context, any eventIds, Entity targetEntity, number triggerX, number triggerY, string sourceId)
		-- Executes event ids from nested systems such as projectile collision/expiration.
		if eventIds == nil then
			return
		end
		for index, eventId in ipairs(eventIds) do
			local safeEventId = self:ReadString(eventId, "")
			local eventDef = self._T.skillEventCatalog[safeEventId]
			if eventDef ~= nil then
				local eventType = self:ReadString(eventDef.Type, "action")
				if eventType == "area" then
					self:StartAreaCapture(context, eventDef)
				elseif eventType == "projectile" then
					self:StartProjectile(context, eventDef)
				elseif eventType == "field" then
					self:StartField(context, eventDef)
				else
					self:ExecuteActions(context, eventDef.ActionIds, targetEntity, triggerX, triggerY, self:ReadString(sourceId, "") .. ":" .. safeEventId)
				end
			else
				self:Log("event skipped reason=missing source=" .. self:ReadString(sourceId, "") .. " event=" .. safeEventId)
			end
		end
	end

	method boolean RollActionChance(any actionDef)
		-- Supports CSV probability columns such as stun/silence proc rates.
		local chance = math.max(0, self:ReadNumber(actionDef.ChancePercent, 100))
		if chance >= 100 then
			return true
		end
		if chance <= 0 then
			return false
		end
		return _UtilLogic:RandomDouble() * 100 < chance
	end

	method void StartProjectileFromAction(any context, any actionDef, number triggerX, number triggerY, string sourceId)
		-- Converts a projectile-spawn action into a logical projectile event.
		local eventDef = {
			EventId = self:ReadString(actionDef.ActionId, "projectile"),
			Type = "projectile",
			ProjectileSpriteRUID = actionDef.ProjectileSpriteRUID,
			ProjectileEffectRUID = actionDef.ProjectileEffectRUID,
			Speed = actionDef.Speed,
			Range = actionDef.Range,
			ProjectileSpinDegreesPerSecond = actionDef.ProjectileSpinDegreesPerSecond,
			Pierce = actionDef.Pierce,
			FrontDirection = actionDef.FrontDirection ~= false,
			HitboxIds = actionDef.HitboxIds,
			ActionIds = actionDef.ActionIds,
			CollisionEventIds = actionDef.CollisionEventIds,
			ExpireEventIds = actionDef.ExpireEventIds
		}
		self:StartProjectile(context, eventDef)
		self:Log("projectile action user=" .. self:ReadString(context.UserId, "") .. " action=" .. self:ReadString(actionDef.ActionId, "") .. " source=" .. self:ReadString(sourceId, ""))
	end

	method void StartFieldFromAction(any context, any actionDef, number triggerX, number triggerY, string sourceId)
		-- Converts a ground-area action into an active field.
		local eventDef = {
			EventId = self:ReadString(actionDef.ActionId, "field"),
			Type = "field",
			DurationFrames = math.max(1, math.floor(self:ReadNumber(actionDef.DurationFrames, 1))),
			TickIntervalFrames = math.max(1, math.floor(self:ReadNumber(actionDef.TickIntervalFrames, 1))),
			HitboxIds = actionDef.HitboxIds,
			ActionIds = actionDef.ActionIds,
			TargetGroup = actionDef.TargetGroup,
			MaxTargets = actionDef.MaxTargets
		}
		self:StartField(context, eventDef)
		self:Log("field action user=" .. self:ReadString(context.UserId, "") .. " action=" .. self:ReadString(actionDef.ActionId, "") .. " source=" .. self:ReadString(sourceId, ""))
	end

	method void ExecuteAction(any context, any actionDef, Entity targetEntity, number triggerX, number triggerY, string sourceId)
		-- Dispatches one action by type.
		local actionType = self:ReadString(actionDef.Type, "damage")
		if actionType == "damage" then
			self:ApplySkillDamage(context, targetEntity, actionDef, sourceId)
			if targetEntity ~= nil then
				self:PlaySkillHitVisual(context, triggerX, triggerY, sourceId, actionDef.HitEffectRUID)
				self:TrySpawnMesoFollowUp(context, targetEntity)
			end
		elseif actionType == "buff" then
			if self:RollActionChance(actionDef) == true and self:ApplySkillStatus(context.SourceEntity, actionDef, self:ReadString(context.UserId, ""), sourceId) == true then
				self:ApplySkillHeal(context.SourceEntity, actionDef, sourceId)
				local origin = self:GetContextOrigin(context)
				self:PlaySkillVisualAt(context, self:GetContextVisualRUID(context, ""), origin.x, origin.y, self:GetContextDirection(context), 0.75, "buff:" .. self:ReadString(actionDef.ActionId, "buff"))
			else
				self:Log("buff skipped chance action=" .. self:ReadString(actionDef.ActionId, "buff") .. " source=" .. self:ReadString(sourceId, ""))
			end
		elseif actionType == "debuff" then
			local applied = false
			if self:RollActionChance(actionDef) == true then
				applied = self:ApplySkillStatus(targetEntity, actionDef, self:ReadString(context.UserId, ""), sourceId)
			end
			if applied == true and targetEntity ~= nil then
				self:PlaySkillHitVisual(context, triggerX, triggerY, "debuff:" .. self:ReadString(actionDef.ActionId, "debuff"), "")
			end
			if applied == true and actionDef.CancelChain == true then
				self:CancelTargetChain(targetEntity, self:ReadString(sourceId, "debuff"))
			elseif applied ~= true then
				self:Log("debuff skipped chance action=" .. self:ReadString(actionDef.ActionId, "debuff") .. " source=" .. self:ReadString(sourceId, ""))
			end
		elseif actionType == "trigger" then
			if context.IsVirtualCaster ~= true and context.TriggerFired ~= true then
				context.TriggerFired = true
				self:PlaySkillVisualAt(context, self:GetContextVisualRUID(context, ""), triggerX, triggerY, self:GetContextDirection(context), 0.9, "trigger:" .. self:ReadString(actionDef.ActionId, "trigger"))
				self:StartVirtualEndSkill(context, triggerX, triggerY)
			end
		elseif actionType == "move" then
			self:ApplySkillMovement(context, actionDef, sourceId)
		elseif actionType == "projectile" then
			self:StartProjectileFromAction(context, actionDef, triggerX, triggerY, sourceId)
		elseif actionType == "field" then
			self:StartFieldFromAction(context, actionDef, triggerX, triggerY, sourceId)
		elseif actionType == "summon" then
			self:StartSummonFromAction(context, actionDef, triggerX, triggerY, sourceId)
		else
			local origin = self:GetContextOrigin(context)
			self:PlaySkillVisualAt(context, self:GetContextVisualRUID(context, ""), origin.x, origin.y, self:GetContextDirection(context), 0.65, "aftereffect:" .. self:ReadString(actionDef.ActionId, "aftereffect"))
			self:Log("aftereffect user=" .. self:ReadString(context.UserId, "") .. " action=" .. self:ReadString(actionDef.ActionId, "") .. " source=" .. self:ReadString(sourceId, ""))
		end
	end

	method void ApplySkillMovement(any context, any actionDef, string sourceId)
		-- Starts smooth caster movement from a skill action while staying inside the map bound.
		if context == nil or context.SourceEntity == nil or context.IsVirtualCaster == true then
			return
		end
		local entity = context.SourceEntity
		if entity == nil or isvalid(entity) == false then
			return
		end
		local position = self:GetEntityPosition2(entity)
		local direction = self:GetContextDirection(context)
		local distance = self:ReadNumber(actionDef.Distance, 0)
		local vertical = self:ReadNumber(actionDef.Vertical, 0)
		local target = Vector2(position.x + direction * distance, position.y + vertical)
		target = self:ClampPositionToMapBounds(entity, target)
		self:StartSmoothSkillMovement(context, actionDef, target, sourceId)
		self:PlaySkillVisualAt(context, self:GetContextVisualRUID(context, ""), target.x, target.y, direction, 0.65, "move:" .. self:ReadString(actionDef.ActionId, "move"))
		self:Log("move action user=" .. self:ReadString(context.UserId, "") .. " action=" .. self:ReadString(actionDef.ActionId, "") .. " target=(" .. tostring(target.x) .. "," .. tostring(target.y) .. ") duration=" .. tostring(self:GetSkillMoveDurationSeconds(actionDef)))
	end

	method void StartSmoothSkillMovement(any context, any actionDef, Vector2 target, string sourceId)
		-- Registers a delta-based caster movement; the skill frame only decides when it starts.
		if context == nil or actionDef == nil or target == nil then
			return
		end
		local entity = context.SourceEntity
		if entity == nil or isvalid(entity) == false then
			return
		end
		self:EnsureRuntime()
		self:CancelSkillMovesForEntity(entity)
		local start = self:GetEntityPosition2(entity)
		local duration = self:GetSkillMoveDurationSeconds(actionDef)
		local move = {
			UserId = self:ReadString(context.UserId, self:GetUserIdFromPlayer(entity)),
			Entity = entity,
			ActionId = self:ReadString(actionDef.ActionId, "move"),
			SourceId = self:ReadString(sourceId, "move"),
			StartX = start.x,
			StartY = start.y,
			TargetX = target.x,
			TargetY = target.y,
			DurationSeconds = duration,
			ElapsedSeconds = 0
		}
		table.insert(self._T.activeSkillMoves, move)
		if move.UserId ~= "" then
			self:StartLocalSkillMovement(start, target, duration, "skillMove:" .. move.SourceId, move.UserId)
		end
	end

	method void TickActiveSkillMoves(number delta)
		-- Updates active skill movement continuously from delta rather than stepping by skill frames.
		if self._T.activeSkillMoves == nil then
			return
		end
		local dt = math.max(0, self:ReadNumber(delta, 0))
		for index = #self._T.activeSkillMoves, 1, -1 do
			local move = self._T.activeSkillMoves[index]
			if move == nil or move.Entity == nil or isvalid(move.Entity) == false then
				table.remove(self._T.activeSkillMoves, index)
			else
				move.ElapsedSeconds = self:ReadNumber(move.ElapsedSeconds, 0) + dt
				local duration = math.max(0.001, self:ReadNumber(move.DurationSeconds, self:GetSkillFrameSeconds()))
				local rate = math.min(1, math.max(0, self:ReadNumber(move.ElapsedSeconds, 0) / duration))
				local position = self:LerpSkillMovePosition(move, rate)
				position = self:ClampPositionToMapBounds(move.Entity, position)
				self:ApplySmoothSkillMovePosition(move.Entity, position)
				if rate >= 1 then
					self:MoveEntityToWorldPosition(move.Entity, position)
					if self:ReadString(move.UserId, "") ~= "" then
						self:ApplyLocalSkillMovementPosition(position, "skillMoveFinish:" .. self:ReadString(move.SourceId, "move"), self:ReadString(move.UserId, ""))
					end
					self:Log("move end user=" .. self:ReadString(move.UserId, "") .. " action=" .. self:ReadString(move.ActionId, "") .. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ")")
					table.remove(self._T.activeSkillMoves, index)
				end
			end
		end
	end

	method Vector2 LerpSkillMovePosition(any move, number rate)
		-- Interpolates one skill movement position at a normalized 0..1 rate.
		if move == nil then
			return Vector2(0, 0)
		end
		local safeRate = math.min(1, math.max(0, self:ReadNumber(rate, 0)))
		local startX = self:ReadNumber(move.StartX, 0)
		local startY = self:ReadNumber(move.StartY, 0)
		local targetX = self:ReadNumber(move.TargetX, startX)
		local targetY = self:ReadNumber(move.TargetY, startY)
		return Vector2(startX + (targetX - startX) * safeRate, startY + (targetY - startY) * safeRate)
	end

	method void ApplySmoothSkillMovePosition(Entity entity, Vector2 position)
		-- Applies one continuous movement sample without treating it as a skill-frame teleport.
		if entity == nil or position == nil then
			return
		end
		if entity.MovementComponent ~= nil then
			entity.MovementComponent:Stop()
			entity.MovementComponent:SetWorldPosition(position)
		end
		if entity.RigidbodyComponent ~= nil then
			entity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			entity.RigidbodyComponent:SetWorldPosition(position)
			entity.RigidbodyComponent:PositionReset()
		elseif entity.KinematicbodyComponent ~= nil then
			entity.KinematicbodyComponent:SetWorldPosition(position)
		elseif entity.SideviewbodyComponent ~= nil then
			entity.SideviewbodyComponent:SetWorldPosition(position)
		end
		if entity.PlayerComponent ~= nil then
			entity.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		end
	end

	method void CancelSkillMovesForEntity(Entity entity)
		-- Removes any pending smooth movement for the same caster before a new one starts.
		if entity == nil or self._T.activeSkillMoves == nil then
			return
		end
		local entityKey = self:GetEntityKey(entity)
		for index = #self._T.activeSkillMoves, 1, -1 do
			local move = self._T.activeSkillMoves[index]
			if move == nil or move.Entity == nil or isvalid(move.Entity) == false then
				table.remove(self._T.activeSkillMoves, index)
			elseif self:GetEntityKey(move.Entity) == entityKey then
				table.remove(self._T.activeSkillMoves, index)
			end
		end
	end

	method void MoveEntityToWorldPosition(Entity entity, Vector2 position)
		-- Applies an authoritative world-position correction to any supported body.
		if entity == nil or position == nil then
			return
		end
		if entity.MovementComponent ~= nil then
			entity.MovementComponent:Stop()
			entity.MovementComponent:SetWorldPosition(position)
		end
		if entity.RigidbodyComponent ~= nil then
			entity.RigidbodyComponent.IgnoreMoveBoundary = false
			entity.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			entity.RigidbodyComponent:SetWorldPosition(position)
			entity.RigidbodyComponent:PositionReset()
		elseif entity.KinematicbodyComponent ~= nil then
			entity.KinematicbodyComponent:SetWorldPosition(position)
		elseif entity.SideviewbodyComponent ~= nil then
			entity.SideviewbodyComponent:SetWorldPosition(position)
		end
		if entity.PlayerComponent ~= nil then
			entity.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		end
	end

	@ExecSpace("Client")
	method void ApplyLocalSkillMovementPosition(Vector2 position, string reason)
		-- Applies the final server movement correction on the owning client.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or position == nil then
			return
		end
		self:ClearLocalSkillMovement("correction:" .. self:ReadString(reason, ""))
		if localPlayer.MovementComponent ~= nil then
			localPlayer.MovementComponent:Stop()
			localPlayer.MovementComponent:SetWorldPosition(position)
		end
		if localPlayer.RigidbodyComponent ~= nil then
			localPlayer.RigidbodyComponent.IgnoreMoveBoundary = false
			localPlayer.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			localPlayer.RigidbodyComponent:SetWorldPosition(position)
			localPlayer.RigidbodyComponent:PositionReset()
		elseif localPlayer.KinematicbodyComponent ~= nil then
			localPlayer.KinematicbodyComponent:SetWorldPosition(position)
		elseif localPlayer.SideviewbodyComponent ~= nil then
			localPlayer.SideviewbodyComponent:SetWorldPosition(position)
		end
		if localPlayer.PlayerComponent ~= nil then
			localPlayer.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		end
		log("[BRSkill] local movement correction reason=" .. self:ReadString(reason, "") .. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ")")
	end

	@ExecSpace("Client")
	method void StartLocalSkillMovement(Vector2 startPosition, Vector2 targetPosition, number durationSeconds, string reason)
		-- Starts client-side visual smoothing for the owner's skill movement.
		if startPosition == nil or targetPosition == nil then
			return
		end
		self:EnsureLocalSkillMovementRuntime()
		self._T.localActiveSkillMoves = {}
		table.insert(self._T.localActiveSkillMoves, {
			Reason = self:ReadString(reason, "skillMove"),
			StartX = startPosition.x,
			StartY = startPosition.y,
			TargetX = targetPosition.x,
			TargetY = targetPosition.y,
			DurationSeconds = math.max(0.001, self:ReadNumber(durationSeconds, self:GetSkillFrameSeconds())),
			ElapsedSeconds = 0
		})
		self:EnsureLocalSkillMoveTimer()
		log("[BRSkill] local move start reason=" .. self:ReadString(reason, "skillMove") .. " duration=" .. tostring(durationSeconds))
	end

	@ExecSpace("ClientOnly")
	method void ClearLocalSkillMovement(string reason)
		-- Clears client-only smooth movement state.
		self:EnsureLocalSkillMovementRuntime()
		local count = #self._T.localActiveSkillMoves
		self._T.localActiveSkillMoves = {}
		self:StopLocalSkillMoveTimer()
		if count > 0 then
			log("[BRSkill] local move clear reason=" .. self:ReadString(reason, "clear"))
		end
	end

	@ExecSpace("ClientOnly")
	method void EnsureLocalSkillMovementRuntime()
		-- Initializes client-only smooth movement bookkeeping.
		if self._T.localActiveSkillMoves == nil then
			self._T.localActiveSkillMoves = {}
		end
		if self._T.localSkillMoveTimerId == nil then
			self._T.localSkillMoveTimerId = 0
		end
		if self._T.localSkillMoveLastAt == nil then
			self._T.localSkillMoveLastAt = _UtilLogic.ElapsedSeconds
		end
	end

	@ExecSpace("ClientOnly")
	method void EnsureLocalSkillMoveTimer()
		-- Runs the local smoothing loop at display cadence rather than skill timeline cadence.
		self:EnsureLocalSkillMovementRuntime()
		if math.floor(self:ReadNumber(self._T.localSkillMoveTimerId, 0)) > 0 then
			return
		end
		self._T.localSkillMoveLastAt = _UtilLogic.ElapsedSeconds
		self._T.localSkillMoveTimerId = _TimerService:SetTimerRepeat(function() self:TickLocalSkillMoves() end, 1 / 60, 0)
	end

	@ExecSpace("ClientOnly")
	method void StopLocalSkillMoveTimer()
		-- Stops the local movement timer when no smooth movement remains.
		if self._T.localSkillMoveTimerId ~= nil and math.floor(self:ReadNumber(self._T.localSkillMoveTimerId, 0)) > 0 then
			_TimerService:ClearTimer(math.floor(self:ReadNumber(self._T.localSkillMoveTimerId, 0)))
		end
		self._T.localSkillMoveTimerId = 0
	end

	@ExecSpace("ClientOnly")
	method void TickLocalSkillMoves()
		-- Updates client-side smooth movement using elapsed time between timer callbacks.
		self:EnsureLocalSkillMovementRuntime()
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			self:ClearLocalSkillMovement("missing-player")
			return
		end
		local now = _UtilLogic.ElapsedSeconds
		local last = self:ReadNumber(self._T.localSkillMoveLastAt, now)
		local delta = math.min(0.1, math.max(0, now - last))
		self._T.localSkillMoveLastAt = now
		for index = #self._T.localActiveSkillMoves, 1, -1 do
			local move = self._T.localActiveSkillMoves[index]
			if move == nil then
				table.remove(self._T.localActiveSkillMoves, index)
			else
				move.ElapsedSeconds = self:ReadNumber(move.ElapsedSeconds, 0) + delta
				local duration = math.max(0.001, self:ReadNumber(move.DurationSeconds, self:GetSkillFrameSeconds()))
				local rate = math.min(1, math.max(0, self:ReadNumber(move.ElapsedSeconds, 0) / duration))
				local position = self:LerpSkillMovePosition(move, rate)
				self:ApplyLocalSmoothSkillMovePosition(localPlayer, position)
				if rate >= 1 then
					log("[BRSkill] local move end reason=" .. self:ReadString(move.Reason, "skillMove") .. " pos=(" .. tostring(position.x) .. "," .. tostring(position.y) .. ")")
					table.remove(self._T.localActiveSkillMoves, index)
				end
			end
		end
		if #self._T.localActiveSkillMoves <= 0 then
			self:StopLocalSkillMoveTimer()
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalSmoothSkillMovePosition(Entity localPlayer, Vector2 position)
		-- Applies one local visual movement sample without waiting for skill-frame ticks.
		if localPlayer == nil or position == nil then
			return
		end
		if localPlayer.MovementComponent ~= nil then
			localPlayer.MovementComponent:Stop()
			localPlayer.MovementComponent:SetWorldPosition(position)
		end
		if localPlayer.RigidbodyComponent ~= nil then
			localPlayer.RigidbodyComponent.MoveVelocity = Vector2(0, 0)
			localPlayer.RigidbodyComponent:SetWorldPosition(position)
			localPlayer.RigidbodyComponent:PositionReset()
		elseif localPlayer.KinematicbodyComponent ~= nil then
			localPlayer.KinematicbodyComponent:SetWorldPosition(position)
		elseif localPlayer.SideviewbodyComponent ~= nil then
			localPlayer.SideviewbodyComponent:SetWorldPosition(position)
		end
		if localPlayer.PlayerComponent ~= nil then
			localPlayer.PlayerComponent:SetWorldPosition(Vector3(position.x, position.y, 0))
		end
	end

	method void ApplySkillDamage(any context, Entity targetEntity, any actionDef, string sourceId)
		-- Applies direct skill damage to players or training dummies.
		if targetEntity == nil then
			return
		end
		local attackerEntity = context.SourceEntity
		local attackPower = self:GetSkillAttackPower(attackerEntity)
		local coefficient = math.max(0, self:ReadNumber(actionDef.Coefficient, 100))
		local damage = math.max(1, math.floor(attackPower * coefficient / 100 * self:GetAttackBuffRate(attackerEntity) * math.max(0, self:ReadNumber(context.DamageRate, 1))))
		local critical = self:RollCritical(attackerEntity)
		if critical == true then
			damage = math.max(1, math.floor(damage * self:GetCriticalDamageRate(attackerEntity)))
		end

		---@type BRTrainingDummy
		local dummy = self:GetTrainingDummyComponent(targetEntity)
		if dummy ~= nil then
			dummy:ApplyTrainingDamage(attackerEntity, damage, self:ReadString(sourceId, "skill"))
			self:Log("damage dummy user=" .. self:ReadString(context.UserId, "") .. " target=" .. targetEntity.Name .. " amount=" .. tostring(damage) .. " critical=" .. tostring(critical))
			return
		end

		---@type any
		local partBox = self:GetPartBoxComponent(targetEntity)
		if partBox ~= nil and partBox:IsDamageBox() == true then
			partBox:ApplyPartBoxDamage(attackerEntity, damage, self:ReadString(sourceId, "skill"))
			self:Log("damage partbox user=" .. self:ReadString(context.UserId, "") .. " target=" .. targetEntity.Name .. " amount=" .. tostring(damage) .. " critical=" .. tostring(critical))
			return
		end

		local bot = self:GetBattleBotComponent(targetEntity)
		if bot ~= nil then
			bot:ApplyBotDamage(attackerEntity, damage, self:ReadString(sourceId, "skill"))
			self:Log("damage bot user=" .. self:ReadString(context.UserId, "") .. " target=" .. self:ReadString(bot.BotId, targetEntity.Name) .. " amount=" .. tostring(damage) .. " critical=" .. tostring(critical))
			return
		end

		if targetEntity.PlayerComponent ~= nil then
			local player = targetEntity.PlayerComponent
			player.Hp = math.max(0, player.Hp - damage)
			self:Log("damage player user=" .. self:ReadString(context.UserId, "") .. " target=" .. self:ReadString(player.UserId, "") .. " amount=" .. tostring(damage) .. " hp=" .. tostring(player.Hp) .. " critical=" .. tostring(critical))
			if _BRDamageSkinSystem ~= nil then
				_BRDamageSkinSystem:ShowEnemyDamage(targetEntity, damage, critical == true, self:ReadString(sourceId, "skill"))
			end
			if player.Hp <= 0 then
				self:HandleSkillFatalDamage(attackerEntity, targetEntity, sourceId)
			end
		end
	end

	method boolean TrySpawnMesoFollowUp(any context, Entity targetEntity)
		-- Spawns the meso follow-up once per target for the current hit context.
		if context == nil or targetEntity == nil or isvalid(targetEntity) ~= true then
			return false
		end
		local count = math.max(0, math.floor(self:ReadNumber(context.MesoFollowUpCount, 0)))
		if count <= 0 then
			return false
		end
		if context.MesoSeenTargets == nil then
			context.MesoSeenTargets = {}
		end
		local targetKey = self:GetEntityKey(targetEntity)
		if context.MesoSeenTargets[targetKey] == true then
			return false
		end
		context.MesoSeenTargets[targetKey] = true
		local attacker = context.MesoAttacker
		if attacker == nil then
			attacker = context.SourceEntity
		end
		self:SpawnMesoCoins(targetEntity, count, attacker)
		self:Log("meso follow-up user=" .. self:ReadString(context.UserId, "") .. " source=" .. self:ReadString(context.SkillKey, self:ReadString(context.EventId, self:ReadString(context.ActionId, ""))) .. " target=" .. targetKey .. " count=" .. tostring(count))
		return true
	end

	method number ArmActiveMesoFollowUps(string userId, number count, Entity attacker)
		-- Lets Meso Explosion arm persistent objects that were already installed before it.
		local safeUserId = self:ReadString(userId, "")
		local safeCount = math.max(0, math.floor(self:ReadNumber(count, 0)))
		if safeUserId == "" or safeCount <= 0 then
			return 0
		end
		local armedCount = 0
		armedCount = armedCount + self:ArmMesoFollowUpsForList(self._T.activeAreas, safeUserId, safeCount, attacker)
		armedCount = armedCount + self:ArmMesoFollowUpsForList(self._T.activeFields, safeUserId, safeCount, attacker)
		armedCount = armedCount + self:ArmMesoFollowUpsForList(self._T.activeProjectiles, safeUserId, safeCount, attacker)
		armedCount = armedCount + self:ArmMesoFollowUpsForList(self._T.activeSummons, safeUserId, safeCount, attacker)
		self:Log("meso arm user=" .. safeUserId .. " count=" .. tostring(safeCount) .. " contexts=" .. tostring(armedCount))
		return armedCount
	end

	method number ArmMesoFollowUpsForList(any contexts, string userId, number count, Entity attacker)
		if contexts == nil then
			return 0
		end
		local armedCount = 0
		for index, context in ipairs(contexts) do
			if context ~= nil and self:ReadString(context.UserId, "") == self:ReadString(userId, "") then
				context.MesoFollowUpCount = math.max(math.floor(self:ReadNumber(context.MesoFollowUpCount, 0)), math.floor(self:ReadNumber(count, 0)))
				context.MesoAttacker = attacker
				context.MesoSeenTargets = {}
				armedCount = armedCount + 1
			end
		end
		return armedCount
	end

	method string GetMesoExplosionSkillKey()
		-- Returns the reserved skill key that arms meso follow-up coins.
		return "메소 익스플로전"
	end

	method boolean IsMesoExplosionSkillKey(string skillKey)
		-- Returns true for the synthetic meso trigger/starter skill.
		return self:ReadString(skillKey, "") == self:GetMesoExplosionSkillKey()
	end

	method string GetMesoCoinModelId()
		-- Returns the spawnable model id for a meso coin projectile.
		return "mesocoin"
	end

	method number GetMesoCoinDamageCoefficient()
		-- Returns coin damage as a percent of attack power.
		return 50
	end

	method number CoinCountForTier(number tier)
		-- Maps a folded meso tier to its coin count (1/3/5/7).
		local order = self:ClampSkillTier(tier)
		return math.max(0, 2 * order - 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnMesoCoins(Entity target, number count, Entity attacker)
		-- Spawns homing meso coins that chase the follow-up skill's hit target.
		if target == nil or isvalid(target) ~= true then
			return
		end
		local safeCount = math.max(0, math.floor(self:ReadNumber(count, 0)))
		if safeCount <= 0 then
			return
		end
		local parent = nil
		if attacker ~= nil and isvalid(attacker) == true then
			parent = attacker.CurrentMap
		end
		if parent == nil then
			parent = target.CurrentMap
		end
		if parent == nil then
			self:Log("meso coin spawn aborted reason=noMap target=" .. target.Name)
			return
		end
		local basePos = target.TransformComponent.WorldPosition
		local damage = math.max(1, math.floor(self:GetSkillAttackPower(attacker) * self:GetMesoCoinDamageCoefficient() / 100))
		for coinIndex = 1, safeCount do
			self._T.mesoCoinSerial = math.floor(self:ReadNumber(self._T.mesoCoinSerial, 0)) + 1
			local coinName = "MesoCoin_" .. tostring(self._T.mesoCoinSerial)
			local angle = _UtilLogic:RandomDouble() * 2 * math.pi
			local coin = _SpawnService:SpawnByModelId(self:GetMesoCoinModelId(), coinName, basePos, parent)
			if coin ~= nil then
				local projectile = coin:GetComponent("script.MesoCoinProjectile")
				if projectile ~= nil then
					---@type MesoCoinProjectile
					local mesoProjectile = projectile
					mesoProjectile:Fire(target, attacker, angle, damage)
					self:Log("meso coin spawn index=" .. tostring(coinIndex) .. "/" .. tostring(safeCount) .. " target=" .. target.Name .. " dmg=" .. tostring(damage))
				else
					self:Log("meso coin spawn failed reason=noComponent index=" .. tostring(coinIndex))
				end
			else
				self:Log("meso coin spawn failed reason=noEntity index=" .. tostring(coinIndex))
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyMesoCoinDamage(Entity target, Entity attacker, number damage)
		-- Applies meso coin follow-up damage, reusing the standard target dispatch.
		if target == nil or isvalid(target) ~= true then
			return
		end
		local dmg = math.max(1, math.floor(self:ReadNumber(damage, 1)))
		---@type BRTrainingDummy
		local dummy = self:GetTrainingDummyComponent(target)
		if dummy ~= nil then
			dummy:ApplyTrainingDamage(attacker, dmg, "meso")
			self:Log("meso coin damage dummy target=" .. target.Name .. " amount=" .. tostring(dmg))
			return
		end
		---@type any
		local partBox = self:GetPartBoxComponent(target)
		if partBox ~= nil and partBox:IsDamageBox() == true then
			partBox:ApplyPartBoxDamage(attacker, dmg, "meso")
			self:Log("meso coin damage partbox target=" .. target.Name .. " amount=" .. tostring(dmg))
			return
		end
		local bot = self:GetBattleBotComponent(target)
		if bot ~= nil then
			bot:ApplyBotDamage(attacker, dmg, "meso")
			self:Log("meso coin damage bot target=" .. self:ReadString(bot.BotId, target.Name) .. " amount=" .. tostring(dmg))
			return
		end
		if target.PlayerComponent ~= nil then
			local player = target.PlayerComponent
			player.Hp = math.max(0, player.Hp - dmg)
			self:Log("meso coin damage player amount=" .. tostring(dmg) .. " hp=" .. tostring(player.Hp))
			if _BRDamageSkinSystem ~= nil then
				_BRDamageSkinSystem:ShowEnemyDamage(target, dmg, false, "meso")
			end
			if player.Hp <= 0 then
				self:HandleSkillFatalDamage(attacker, target, "meso")
			end
		end
	end

	method void PlayCasterMesoEffect(Entity caster)
		-- Broadcasts the meso arming body effect to clients viewing the caster.
		if self.EnableSkillVisualEffects ~= true or caster == nil then
			return
		end
		self:PlayCasterMesoEffectClient(caster)
		self:Log("meso cast effect caster=" .. caster.Name)
	end

	@ExecSpace("Client")
	method void PlayCasterMesoEffectClient(Entity caster)
		-- Plays the meso-explosion arming animationclip twice on the caster body.
		if caster == nil or isvalid(caster) ~= true then
			return
		end
		_EffectService:PlayEffectAttached("61840689ea7b44f09f91960734232e34", caster, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false)
		_EffectService:PlayEffectAttached("61840689ea7b44f09f91960734232e34", caster, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false)
	end

	method string GetShadowDashSkillKey()
		-- Returns the base skill key that arms the shadow-dash (tier 1) / into-darkness (tier 2) utility.
		return "인투 다크니스"
	end

	method string GetShadowDashModelId()
		-- Returns the spawnable model id for the shadow-dash projectile.
		return "shadowdash"
	end

	method void HandleShadowDashCast(any cast)
		-- Routes a shadow-dash cast to the tier-1 dash or the tier-2 into-darkness teleport.
		if cast == nil or cast.CasterEntity == nil then
			return
		end
		local baseKey = self:GetShadowDashSkillKey()
		local castKey = self:ReadString(cast.SkillKey, "")
		local tier2Key = self:GetTieredSkillKey(baseKey, 2)
		local tier = math.max(1, math.floor(self:ReadNumber(cast.Tier, 1)))
		if castKey == tier2Key or (castKey == baseKey and tier >= 2) then
			self:StartIntoDarkness(cast)
		elseif castKey == baseKey then
			self:StartShadowDash(cast)
		end
	end

	method void StartShadowDash(any cast)
		-- Tier 1: fires the shadow forward, then dashes the caster along the same path after a delay.
		local caster = cast.CasterEntity
		if caster == nil or isvalid(caster) ~= true then
			return
		end
		local direction = self:GetLookDirection(caster)
		local distance = math.max(0.1, self:ReadNumber(self.ShadowDashDistance, 5))
		local flightTime = math.max(0.05, self:ReadNumber(self.ShadowDashFlightTime, 0.35))
		local followDelay = math.max(0, self:ReadNumber(self.ShadowDashFollowDelay, 1.0))
		local userId = self:ReadString(cast.UserId, "")
		self:SpawnShadowProjectile(caster, direction, distance, flightTime)
		self:PlayShadowDashCastSound(caster)
		local capturedCaster = caster
		local capturedUserId = userId
		local capturedDirection = direction
		local capturedDistance = distance
		local capturedFlightTime = flightTime
		_TimerService:SetTimerOnce(function()
			self:DashCaster(capturedCaster, capturedUserId, capturedDirection, capturedDistance, capturedFlightTime)
		end, followDelay)
		self:Log("shadow dash cast user=" .. userId .. " dir=" .. tostring(direction) .. " dist=" .. tostring(distance) .. " flight=" .. tostring(flightTime) .. " followDelay=" .. tostring(followDelay))
	end

	@ExecSpace("ServerOnly")
	method void SpawnShadowProjectile(Entity caster, number direction, number distance, number flightTime)
		-- Spawns the shadow projectile at the caster and launches it along the facing direction.
		if caster == nil or isvalid(caster) ~= true then
			return
		end
		local parent = caster.CurrentMap
		if parent == nil then
			self:Log("shadow dash spawn aborted reason=noMap")
			return
		end
		local basePos = caster.TransformComponent.WorldPosition
		self._T.shadowDashSerial = math.floor(self:ReadNumber(self._T.shadowDashSerial, 0)) + 1
		local shadowName = "ShadowDash_" .. tostring(self._T.shadowDashSerial)
		local shadow = _SpawnService:SpawnByModelId(self:GetShadowDashModelId(), shadowName, basePos, parent)
		if shadow == nil then
			self:Log("shadow dash spawn failed reason=noEntity")
			return
		end
		---@type ShadowDashProjectile
		local projectile = shadow:GetComponent("script.ShadowDashProjectile")
		if projectile == nil then
			self:Log("shadow dash spawn failed reason=noComponent")
			return
		end
		projectile:Fire(direction, 0, distance, flightTime)
		self:Log("shadow dash projectile fired name=" .. shadowName .. " dir=" .. tostring(direction))
	end

	@ExecSpace("ServerOnly")
	method void DashCaster(Entity caster, string userId, number direction, number distance, number flightTime)
		-- Dashes the caster distance units along dir over flightTime, reusing the smooth-movement system.
		if caster == nil or isvalid(caster) ~= true then
			return
		end
		local context = {
			SourceEntity = caster,
			CasterEntity = caster,
			UserId = self:ReadString(userId, ""),
			Direction = direction,
			IsVirtualCaster = false
		}
		local frames = math.max(1, math.floor(math.max(0.05, flightTime) / self:GetSkillFrameSeconds() + 0.5))
		local actionDef = {
			ActionId = "shadowdash",
			MoveTimeFrames = frames
		}
		local casterPos = self:GetEntityPosition2(caster)
		local target = Vector2(casterPos.x + direction * math.max(0.1, distance), casterPos.y)
		target = self:ClampPositionToMapBounds(caster, target)
		self:StartSmoothSkillMovement(context, actionDef, target, "shadowdash")
		self:Log("shadow dash caster move user=" .. self:ReadString(userId, "") .. " target=(" .. tostring(target.x) .. "," .. tostring(target.y) .. ")")
	end

	method void PlayShadowDashCastSound(Entity caster)
		-- Broadcasts the shadow-dash cast sound to clients.
		if self.EnableSkillVisualEffects ~= true or caster == nil then
			return
		end
		self:PlayShadowDashCastSoundClient()
	end

	@ExecSpace("Client")
	method void PlayShadowDashCastSoundClient()
		-- Plays the shadow-dash cast sound on the client.
		_SoundService:PlaySound("934e8d9af9ec4b10a9cc04a87455ef02", math.max(0, self:ReadNumber(self.ShadowDashSoundVolume, 0.9)))
	end

	method void StartIntoDarkness(any cast)
		-- Tier 2: teleports the caster behind the nearest facing enemy within range; no-op if none.
		local caster = cast.CasterEntity
		if caster == nil or isvalid(caster) ~= true then
			return
		end
		local direction = self:GetLookDirection(caster)
		local range = math.max(0.5, self:ReadNumber(self.IntoDarknessRange, 6))
		local behindDistance = math.max(0.1, self:ReadNumber(self.IntoDarknessBehindDistance, 0.7))
		local userId = self:ReadString(cast.UserId, "")
		local context = {
			SourceEntity = caster,
			CasterEntity = caster,
			UserId = userId,
			Direction = direction
		}
		local enemy = self:FindFacedEnemy(context, caster, direction, range)
		if enemy == nil then
			self:Log("into darkness no target user=" .. userId)
			return
		end
		local casterPos = self:GetEntityPosition2(caster)
		local enemyPos = self:GetEntityPosition2(enemy)
		local dx = enemyPos.x - casterPos.x
		local dy = enemyPos.y - casterPos.y
		local length = math.sqrt(dx * dx + dy * dy)
		if length < 0.0001 then
			dx = direction
			dy = 0
			length = 1
		end
		local nx = dx / length
		local ny = dy / length
		local behind = Vector2(enemyPos.x + (nx >= 0 and behindDistance or -behindDistance), enemyPos.y)
		behind = self:ClampPositionToMapBounds(caster, behind)
		self:MoveEntityToWorldPosition(caster, behind)
		if userId ~= "" then
			self:ApplyLocalSkillMovementPosition(behind, "intoDarkness", userId)
		end
		self:FaceEntityTowardPoint(caster, enemyPos.x, behind.x)
		self:PlayIntoDarknessEffect(caster, enemyPos, behind)
		self:Log("into darkness teleport user=" .. userId .. " enemy=" .. enemy.Name .. " behind=(" .. tostring(behind.x) .. "," .. tostring(behind.y) .. ")")
	end

	method Entity FindFacedEnemy(any context, Entity caster, number direction, number range)
		-- Returns the nearest valid enemy in the caster's facing direction within range.
		if caster == nil then
			return nil
		end
		local targets = self:CollectTargetsForContext(context)
		if targets == nil then
			return nil
		end
		local casterPos = self:GetEntityPosition2(caster)
		local best = nil
		local bestDistance = range + 1
		for index, targetEntity in ipairs(targets) do
			if self:IsSkillTargetValid(context, targetEntity) == true then
				local targetPos = self:GetEntityPosition2(targetEntity)
				local dx = targetPos.x - casterPos.x
				local dy = targetPos.y - casterPos.y
				if dx * direction >= -0.5 then
					local distance = math.sqrt(dx * dx + dy * dy)
					if distance <= range and distance < bestDistance then
						best = targetEntity
						bestDistance = distance
					end
				end
			end
		end
		return best
	end

	method void FaceEntityTowardPoint(Entity entity, number targetX, number fromX)
		-- Turns a player entity to look toward a target X position after a teleport.
		if entity == nil or isvalid(entity) ~= true or entity.PlayerControllerComponent == nil then
			return
		end
		local diff = targetX - fromX
		if diff > 0.0001 then
			entity.PlayerControllerComponent.LookDirectionX = 1
		elseif diff < -0.0001 then
			entity.PlayerControllerComponent.LookDirectionX = -1
		end
	end

	method void PlayIntoDarknessEffect(Entity caster, Vector2 fromPos, Vector2 toPos)
		-- Broadcasts the into-darkness teleport visuals and sound to clients.
		if self.EnableSkillVisualEffects ~= true or caster == nil then
			return
		end
		self:PlayIntoDarknessEffectClient(toPos.x, toPos.y, fromPos.x, fromPos.y)
	end

	@ExecSpace("Client")
	method void PlayIntoDarknessEffectClient(number toX, number toY, number fromX, number fromY)
		-- Plays the teleport effect + ball animationclips and the cast sound on the client.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return
		end
		local options = {}
		options["SortingLayer"] = "MapLayer0"
		options["OrderInLayer"] = 40
		options["IgnoreMapLayerCheck"] = true
		_EffectService:PlayEffect("173e5f5f81994d73b16b0e21dff1f52a", localPlayer, Vector3(toX, toY, 0), 0, Vector3(1, 1, 1), false, options)
		_EffectService:PlayEffect("30f61ec72f5d48f2ab93cff43d70559e", localPlayer, Vector3(fromX, fromY, 0), 0, Vector3(1, 1, 1), false, options)
		_SoundService:PlaySound("b625fb6b256140c493c7a163d0c3a44c", math.max(0, self:ReadNumber(self.IntoDarknessSoundVolume, 0.9)))
	end

	method string GetThrowStarSkillKey()
		-- Returns the base skill key that fires the homing throwing-star burst (tiers 1-4).
		return "럭키 세븐"
	end

	method string GetThrowStarModelId()
		-- Returns the spawnable model id for a throwing-star projectile.
		return "throwstar"
	end

	method void HandleThrowStarCast(any cast)
		-- Routes a 럭키 세븐 cast (base or tiered key) to the tiered homing-star burst.
		if cast == nil or cast.CasterEntity == nil then
			return
		end
		local baseKey = self:GetThrowStarSkillKey()
		local castKey = self:ReadString(cast.SkillKey, "")
		local tier = math.max(1, math.floor(self:ReadNumber(cast.Tier, 1)))
		local matched = false
		local resolvedTier = tier
		if castKey == baseKey then
			matched = true
			resolvedTier = tier
		else
			for order = 2, self:GetMaxSkillTier() do
				if castKey == self:GetTieredSkillKey(baseKey, order) then
					matched = true
					resolvedTier = order
					break
				end
			end
		end
		if matched ~= true then
			return
		end
		self:StartThrowStars(cast, resolvedTier)
	end

	method void StartThrowStars(any cast, number tier)
		-- Fires the tiered burst of homing stars one at a time, evenly spaced by ThrowStarFollowupDelay.
		local caster = cast.CasterEntity
		if caster == nil or isvalid(caster) ~= true then
			return
		end
		local order = self:ClampSkillTier(tier)
		local direction = self:GetLookDirection(caster)
		local userId = self:ReadString(cast.UserId, "")
		local acquireRange = math.max(0.5, self:ReadNumber(self.ThrowStarAcquireRange, 7))
		local context = {
			SourceEntity = caster,
			CasterEntity = caster,
			UserId = userId,
			Direction = direction
		}
		local totalStars = order + 1
		local damagePercent = self:GetThrowStarDamagePercent(order)
		local damage = math.max(1, math.floor(self:GetSkillAttackPower(caster) * damagePercent / 100))
		local hitEffect = self:GetThrowStarHitEffect(order)
		local maxRange = math.max(0.5, self:ReadNumber(self.ThrowStarMaxRange, 7))
		local speed = math.max(0.1, self:ReadNumber(self.ThrowStarSpeed, 12))
		local interval = math.max(0, self:ReadNumber(self.ThrowStarFollowupDelay, 0.15))
		local mesoCount = math.max(0, math.floor(self:ReadNumber(cast.MesoFollowUpCount, 0)))
		local mesoAttacker = cast.MesoAttacker

		self:PlayThrowStarCastSound(caster, order)

		for starIndex = 0, totalStars - 1 do
			local delay = starIndex * interval
			local capturedCaster = caster
			local capturedContext = context
			local capturedDirection = direction
			local capturedDamage = damage
			local capturedMaxRange = maxRange
			local capturedSpeed = speed
			local capturedHitEffect = hitEffect
			local capturedAcquireRange = acquireRange
			local capturedMesoCount = mesoCount
			local capturedMesoAttacker = mesoAttacker
			if delay <= 0 then
				local target = self:FindFacedEnemy(context, caster, direction, acquireRange)
				self:SpawnThrowStarVolley(caster, target, direction, 1, damage, maxRange, speed, hitEffect, mesoCount, mesoAttacker)
			else
				_TimerService:SetTimerOnce(function()
					if capturedCaster == nil or isvalid(capturedCaster) ~= true then
						return
					end
					local target = self:FindFacedEnemy(capturedContext, capturedCaster, capturedDirection, capturedAcquireRange)
					self:SpawnThrowStarVolley(capturedCaster, target, capturedDirection, 1, capturedDamage, capturedMaxRange, capturedSpeed, capturedHitEffect, capturedMesoCount, capturedMesoAttacker)
				end, delay)
			end
		end
		self:Log("throw star cast user=" .. userId .. " tier=" .. tostring(order) .. " stars=" .. tostring(totalStars) .. " sequential interval=" .. tostring(interval) .. " dmg=" .. tostring(damage) .. " meso=" .. tostring(mesoCount))
	end

	@ExecSpace("ServerOnly")
	method void SpawnThrowStarVolley(Entity caster, Entity target, number direction, number count, number damage, number maxRange, number speed, string hitEffect, number mesoCount, Entity mesoAttacker)
		-- Spawns `count` homing stars at the caster with a small vertical spread so they do not overlap.
		if caster == nil or isvalid(caster) ~= true then
			return
		end
		local safeCount = math.max(0, math.floor(self:ReadNumber(count, 0)))
		if safeCount <= 0 then
			return
		end
		local parent = caster.CurrentMap
		if parent == nil then
			self:Log("throw star spawn aborted reason=noMap")
			return
		end
		local safeMesoCount = math.max(0, math.floor(self:ReadNumber(mesoCount, 0)))
		local basePos = caster.TransformComponent.WorldPosition
		for starIndex = 1, safeCount do
			self._T.throwStarSerial = math.floor(self:ReadNumber(self._T.throwStarSerial, 0)) + 1
			local starName = "ThrowStar_" .. tostring(self._T.throwStarSerial)
			local spread = self:ComputeThrowStarSpread(starIndex, safeCount)
			local spawnPos = Vector3(basePos.x, basePos.y + spread, basePos.z)
			local star = _SpawnService:SpawnByModelId(self:GetThrowStarModelId(), starName, spawnPos, parent)
			if star ~= nil then
				---@type ThrowStarProjectile
				local projectile = star:GetComponent("script.ThrowStarProjectile")
				if projectile ~= nil then
					projectile:Fire(target, caster, direction, spread, damage, maxRange, speed, hitEffect, safeMesoCount, mesoAttacker)
					self:Log("throw star spawn index=" .. tostring(starIndex) .. "/" .. tostring(safeCount) .. " dmg=" .. tostring(damage))
				else
					self:Log("throw star spawn failed reason=noComponent index=" .. tostring(starIndex))
				end
			else
				self:Log("throw star spawn failed reason=noEntity index=" .. tostring(starIndex))
			end
		end
	end

	method number ComputeThrowStarSpread(number index, number count)
		-- Returns a small symmetric vertical offset so stars in one volley fan out slightly.
		local n = math.max(1, math.floor(self:ReadNumber(count, 1)))
		local i = math.max(1, math.floor(self:ReadNumber(index, 1)))
		if n <= 1 then
			return 0
		end
		local center = (n + 1) / 2
		return (i - center) * 0.18
	end

	method number GetThrowStarDamagePercent(number tier)
		-- Per-star damage as a percent of caster attack power: t1/t2=100, t3=110, t4=120.
		local order = self:ClampSkillTier(tier)
		if order <= 2 then
			return 100
		end
		if order == 3 then
			return 110
		end
		return 120
	end

	method string GetThrowStarHitEffect(number tier)
		-- Per-tier hit animationclip RUID.
		local order = self:ClampSkillTier(tier)
		if order <= 1 then
			return "a12bf45994e643f38b9daea0075c9bdd"
		end
		if order == 2 then
			return "4c42f0632fa249c29b8394c10d7634fe"
		end
		if order == 3 then
			return "8fc08b2af4944a90be3f1822479c0fd9"
		end
		return "2a8b49e8f8914588bc8b5ad2be5b71e0"
	end

	method string GetThrowStarCastSound(number tier)
		-- Per-tier cast sound RUID; tiers 3-4 have none.
		local order = self:ClampSkillTier(tier)
		if order <= 1 then
			return "d7d22108af1946dfa6a674b9ec713a31"
		end
		if order == 2 then
			return "e736b55d1ab94ad080b571bec3bf5730"
		end
		return ""
	end

	method void PlayThrowStarCastSound(Entity caster, number tier)
		-- Broadcasts the per-tier throwing-star cast sound to clients.
		if self.EnableSkillVisualEffects ~= true or caster == nil then
			return
		end
		local sound = self:GetThrowStarCastSound(tier)
		if sound == "" then
			return
		end
		self:PlayThrowStarCastSoundClient(sound)
	end

	@ExecSpace("Client")
	method void PlayThrowStarCastSoundClient(string soundRuid)
		-- Plays the throwing-star cast sound on the client.
		if soundRuid == nil or soundRuid == "" then
			return
		end
		_SoundService:PlaySound(soundRuid, math.max(0, self:ReadNumber(self.ThrowStarSoundVolume, 0.9)))
	end

	@ExecSpace("ServerOnly")
	method void ApplyThrowStarDamage(Entity target, Entity attacker, number damage)
		-- Applies throwing-star hit damage, reusing the shared dummy/bot/player dispatch.
		if target == nil or isvalid(target) ~= true then
			return
		end
		local dmg = math.max(1, math.floor(self:ReadNumber(damage, 1)))
		---@type BRTrainingDummy
		local dummy = self:GetTrainingDummyComponent(target)
		if dummy ~= nil then
			dummy:ApplyTrainingDamage(attacker, dmg, "throwstar")
			self:Log("throw star damage dummy target=" .. target.Name .. " amount=" .. tostring(dmg))
			return
		end
		local bot = self:GetBattleBotComponent(target)
		if bot ~= nil then
			bot:ApplyBotDamage(attacker, dmg, "throwstar")
			self:Log("throw star damage bot target=" .. self:ReadString(bot.BotId, target.Name) .. " amount=" .. tostring(dmg))
			return
		end
		if target.PlayerComponent ~= nil then
			local player = target.PlayerComponent
			player.Hp = math.max(0, player.Hp - dmg)
			self:Log("throw star damage player amount=" .. tostring(dmg) .. " hp=" .. tostring(player.Hp))
			if _BRDamageSkinSystem ~= nil then
				_BRDamageSkinSystem:ShowEnemyDamage(target, dmg, false, "throwstar")
			end
			if player.Hp <= 0 then
				self:HandleSkillFatalDamage(attacker, target, "throwstar")
			end
		end
	end

	method void HandleSkillFatalDamage(Entity attackerEntity, Entity targetEntity, string sourceId)
		-- Reuses battle death handling when a skill reduces a player to zero HP.
		if targetEntity == nil or targetEntity.PlayerComponent == nil then
			return
		end
		local mapName = self:ReadString(targetEntity.CurrentMapName, "")
		if mapName == "" then
			return
		end
		local battleLogicEntity = _EntityService:GetEntityByPath("/maps/" .. mapName .. "/BattleLogic")
		if battleLogicEntity == nil then
			return
		end
		---@type BRBattleLogic
		local battleLogic = battleLogicEntity:GetComponent("script.BRBattleLogic")
		if battleLogic ~= nil then
			battleLogic:HandlePlayerFatalDeath(attackerEntity, targetEntity, "skill:" .. self:ReadString(sourceId, "skill"))
		end
	end

	method void ApplySkillHeal(Entity targetEntity, any actionDef, string sourceId)
		-- Applies instant self-heal values declared in buff_actions.csv.
		local healPercent = math.max(0, self:ReadNumber(actionDef.HealMaxHpPercent, 0))
		if healPercent <= 0 or targetEntity == nil or targetEntity.PlayerComponent == nil then
			return
		end
		local player = targetEntity.PlayerComponent
		local maxHp = math.max(1, math.floor(self:ReadNumber(player.MaxHp, 100)))
		local oldHp = math.max(0, math.floor(self:ReadNumber(player.Hp, 0)))
		local healAmount = math.max(1, math.floor(maxHp * healPercent / 100))
		player.Hp = math.min(maxHp, oldHp + healAmount)
		self:Log("heal player target=" .. self:ReadString(player.UserId, "") .. " amount=" .. tostring(healAmount) .. " hp=" .. tostring(oldHp) .. "->" .. tostring(player.Hp) .. " source=" .. self:ReadString(sourceId, "skill"))
	end

	method boolean ApplySkillStatus(Entity targetEntity, any actionDef, string applierUserId, string sourceId)
		-- Records a temporary buff or debuff on an entity.
		if targetEntity == nil then
			return false
		end
		local key = self:GetEntityKey(targetEntity)
		if key == "" then
			return false
		end
		if self._T.statusByEntityId[key] == nil then
			self._T.statusByEntityId[key] = {}
		end
		local statusId = self:ReadString(actionDef.StatusId, self:ReadString(actionDef.ActionId, "status"))
		local tickIntervalSeconds = math.max(self:GetSkillFrameSeconds(), math.floor(self:ReadNumber(actionDef.TickIntervalFrames, 33)) * self:GetSkillFrameSeconds())
		local moveSpeedRate = self:GetHardcodedStatusMoveSpeedRate(statusId)
		self._T.statusByEntityId[key][statusId] = {
			StatusId = statusId,
			TargetEntity = targetEntity,
			ApplierUserId = self:ReadString(applierUserId, ""),
			ExpiresAt = self:Now() + self:ReadNumber(actionDef.DurationFrames, 1) * self:GetSkillFrameSeconds(),
			DamageTakenRate = self:ReadNumber(actionDef.DamageTakenRate, 1),
			AttackPowerRate = self:ReadNumber(actionDef.AttackPowerRate, 1),
			MoveSpeedRate = moveSpeedRate,
			CancelChain = actionDef.CancelChain == true,
			DotCoefficient = self:ReadNumber(actionDef.DotCoefficient, 0),
			TickIntervalSeconds = tickIntervalSeconds,
			NextTickAt = self:Now() + tickIntervalSeconds,
			SourceId = self:ReadString(sourceId, "")
		}
		if moveSpeedRate < 0.999 then
			self:ApplyTargetSlow(targetEntity, moveSpeedRate)
		end
		self:Log("status apply target=" .. targetEntity.Name .. " status=" .. statusId .. " source=" .. self:ReadString(sourceId, ""))
		return true
	end

	method boolean IsCasterControlBlocked(Entity casterEntity)
		-- True while the caster carries an active stun or silence status; blocks new skill casts (기절/침묵).
		if casterEntity == nil then
			return false
		end
		local key = self:GetEntityKey(casterEntity)
		if key == "" or self._T.statusByEntityId == nil or self._T.statusByEntityId[key] == nil then
			return false
		end
		local now = self:Now()
		for statusId, status in pairs(self._T.statusByEntityId[key]) do
			if status ~= nil and now < self:ReadNumber(status.ExpiresAt, 0) then
				local safeStatusId = self:ReadString(status.StatusId, "")
				if safeStatusId == "stun" or safeStatusId == "silence" then
					return true
				end
			end
		end
		return false
	end

	method number GetAttackBuffRate(Entity attackerEntity)
		-- Product of active attack-power buff rates on the attacker (buff_actions.attack_power_rate); 1.0 when none.
		if attackerEntity == nil then
			return 1.0
		end
		local key = self:GetEntityKey(attackerEntity)
		if key == "" or self._T.statusByEntityId == nil or self._T.statusByEntityId[key] == nil then
			return 1.0
		end
		local now = self:Now()
		local rate = 1.0
		for statusId, status in pairs(self._T.statusByEntityId[key]) do
			if status ~= nil and now < self:ReadNumber(status.ExpiresAt, 0) then
				rate = rate * math.max(0, self:ReadNumber(status.AttackPowerRate, 1))
			end
		end
		return math.max(0, rate)
	end

	method void TickStatuses()
		-- Removes expired status records and applies periodic status damage.
		local now = self:Now()
		for entityId, statusMap in pairs(self._T.statusByEntityId) do
			local empty = true
			for statusId, status in pairs(statusMap) do
				if status == nil or now >= self:ReadNumber(status.ExpiresAt, 0) then
					if status ~= nil and self:ReadNumber(status.MoveSpeedRate, 1) < 0.999 then
						self:RestoreTargetSlow(status.TargetEntity)
					end
					statusMap[statusId] = nil
					self:Log("status expire entity=" .. tostring(entityId) .. " status=" .. tostring(statusId))
				else
					self:TickStatusDamage(status, now)
					empty = false
				end
			end
			if empty == true then
				self._T.statusByEntityId[entityId] = nil
			end
		end
	end

	method void TickStatusDamage(any status, number now)
		-- Applies DoT damage declared by debuff_actions.csv.
		local coefficient = math.max(0, self:ReadNumber(status.DotCoefficient, 0))
		if coefficient <= 0 then
			return
		end
		local targetEntity = status.TargetEntity
		if targetEntity == nil or isvalid(targetEntity) == false then
			return
		end
		if self:ReadNumber(now, 0) < self:ReadNumber(status.NextTickAt, 0) then
			return
		end
		local applierUserId = self:ReadString(status.ApplierUserId, "")
		local attackerEntity = self:FindPlayerEntityByUserId(applierUserId)
		if attackerEntity == nil then
			attackerEntity = targetEntity
		end
		local dotContext = {
			SourceEntity = attackerEntity,
			UserId = applierUserId,
			SkillKey = self:ReadString(status.StatusId, "dot")
		}
		local dotAction = {
			Coefficient = coefficient,
			HitEffectRUID = ""
		}
		self:ApplySkillDamage(dotContext, targetEntity, dotAction, "dot:" .. self:ReadString(status.SourceId, self:ReadString(status.StatusId, "dot")))
		status.NextTickAt = self:ReadNumber(now, 0) + math.max(self:GetSkillFrameSeconds(), self:ReadNumber(status.TickIntervalSeconds, 1))
	end

	method void CancelTargetChain(Entity targetEntity, string reason)
		-- Cancels queued + active chain execution for the target player and releases the movement lock.
		-- Queued (not-yet-started) steps are dropped; the current cast's timeline stops (motion cancel),
		-- but already-spawned damage (activeAreas / in-flight projectiles) is NOT touched here, so the
		-- current skill's damage judgment still completes. The caster returns to idle + free movement.
		if targetEntity == nil or targetEntity.PlayerComponent == nil then
			return
		end
		local userId = self:ReadString(targetEntity.PlayerComponent.UserId, "")
		if userId == "" then
			return
		end
		local runtime = self:GetChainRuntime(userId)
		runtime.ActiveUntil = 0
		self:ClearQueuedChainRuntime(runtime)
		for index, cast in ipairs(self._T.activeCasts) do
			if cast ~= nil and self:ReadString(cast.UserId, "") == userId then
				cast.Cancelled = true
			end
		end
		-- Release the full-chain movement lock immediately (idle + mobile), without waiting for the
		-- cancelled cast to be cleaned up next tick.
		self:RestoreCasterChainLock(userId)
		self:Log("chain cancelled target=" .. userId .. " reason=" .. self:ReadString(reason, "cc"))
	end

	@ExecSpace("Server")
	method void RequestCancelChainByBlink(string requestUserId)
		-- Client (Burst Step / Blink) asks the server to cancel the local player's active chain.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			return
		end
		local playerEntity = self:FindPlayerEntityByUserId(userId)
		if playerEntity == nil then
			return
		end
		self:CancelTargetChain(playerEntity, "blink")
	end

	method void PlaySkillVisualForEvent(any context, string eventId, number x, number y, boolean isField)
		-- Requests the CSV-mapped animation effect for a skill event.
		local safeEventId = self:ReadString(eventId, "")
		local direction = self:GetContextDirection(context)
		-- Skill effect pivots sit at the target/origin Y (0 vertical offset) instead of being raised.
		local offsetX = 0
		local offsetY = 0
		if isField == true then
			offsetX = 0
			offsetY = 0
		end
		if self:IsPiercingSkillKey(self:ReadString(context.SkillKey, "")) == true then
			-- 활(피어싱) 시전 이펙트만 지면 높이(y 오프셋 0)에서 재생. 다른 스킬은 +0.35 유지.
			offsetY = 0
		end
		self:PlaySkillVisualAt(context, self:GetContextVisualRUID(context, safeEventId), x + direction * offsetX, y + offsetY, direction, self:GetSkillEffectScaleRate(safeEventId) * self:GetContextVisualScale(context, safeEventId), "event:" .. safeEventId)
	end

	method void PlaySkillHitVisual(any context, number x, number y, string sourceId, string overrideRUID)
		-- Requests a compact impact effect at the target position.
		local scaleRate = 0.7
		local safeSourceId = self:ReadString(sourceId, "")
		if string.find(safeSourceId, "field") ~= nil then
			scaleRate = 0.55
		elseif string.find(safeSourceId, "projectile") ~= nil then
			scaleRate = 0.6
		end
		local ruid = self:ReadString(overrideRUID, "")
		self:PlaySkillVisualAt(context, ruid, x, y, self:GetContextDirection(context), scaleRate, "hit:" .. safeSourceId)
	end

	method string GetSkillEffectRUID(string eventId)
		-- Maps an explicit effect id to its RUID.
		local safeEventId = self:ReadString(eventId, "")
		if self._T.skillEffectCatalog ~= nil and self._T.skillEffectCatalog[safeEventId] ~= nil then
			return self:ReadString(self._T.skillEffectCatalog[safeEventId].RUID, "")
		end
		return ""
	end

	method string GetContextVisualRUID(any context, string eventId)
		-- Resolves event visuals from action/projectile overrides first, then skill effect_ids.
		if context ~= nil then
			local visualRUID = self:ReadString(context.VisualRUID, "")
			if visualRUID ~= "" then
				return visualRUID
			end
			if context.EffectIds ~= nil then
				for index, effectId in ipairs(context.EffectIds) do
					local ruid = self:GetSkillEffectRUID(effectId)
					if ruid ~= "" then
						return ruid
					end
				end
			end
		end
		return self:GetSkillEffectRUID(eventId)
	end

	method number GetSkillEffectScaleRate(string eventId)
		-- Scale is now data-agnostic; authored effect assets should carry their intended size.
		return 1.0
	end

	method number GetContextVisualScale(any context, string eventId)
		-- Returns the authored per-effect scale (effects.csv `scale`) for the effect GetContextVisualRUID resolves.
		if context ~= nil then
			if self:ReadString(context.VisualRUID, "") ~= "" then
				return 1.0
			end
			if context.EffectIds ~= nil then
				for index, effectId in ipairs(context.EffectIds) do
					if self:GetSkillEffectRUID(effectId) ~= "" then
						return self:GetSkillEffectScale(effectId)
					end
				end
			end
		end
		return self:GetSkillEffectScale(eventId)
	end

	method number GetSkillEffectScale(string effectId)
		-- Reads the authored per-effect visual scale multiplier (effects.csv `scale`); defaults to 1.0 when unset.
		local safeEffectId = self:ReadString(effectId, "")
		if self._T.skillEffectCatalog ~= nil and self._T.skillEffectCatalog[safeEffectId] ~= nil then
			return math.max(0.05, self:ReadNumber(self._T.skillEffectCatalog[safeEffectId].Scale, 1))
		end
		return 1.0
	end

	method void PlaySkillVisualAt(any context, string animationRuid, number x, number y, number direction, number scaleRate, string sourceId)
		-- Sends a visual effect request to clients currently viewing the same map.
		if self.EnableSkillVisualEffects ~= true then
			return
		end
		local safeRuid = self:ReadString(animationRuid, "")
		if safeRuid == "" then
			return
		end
		local mapName = self:GetContextMapName(context)
		if mapName == "" then
			return
		end
		self:PushSkillVisualClient(mapName, safeRuid, x, y, direction, scaleRate, self:ReadString(sourceId, "skill"))
	end

	@ExecSpace("Client")
	method void PushSkillVisualClient(string mapName, string animationRuid, number x, number y, number direction, number scaleRate, string sourceId)
		-- Plays a one-shot skill animation clip on this client.
		if self.EnableSkillVisualEffects ~= true then
			return
		end
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return
		end
		if self:ReadString(localPlayer.CurrentMapName, "") ~= self:ReadString(mapName, "") then
			return
		end
		local safeRuid = self:ReadString(animationRuid, "")
		if safeRuid == "" then
			return
		end
		local safeScale = math.max(0.05, self:ReadNumber(scaleRate, 1) * math.max(0.05, self:ReadNumber(self.SkillEffectScale, 1)))
		local safeAlpha = math.max(0, math.min(1, self:ReadNumber(self.SkillEffectAlpha, 1)))
		local options = {}
		options["FlipX"] = self:ReadNumber(direction, 1) > 0
		options["SortingLayer"] = "MapLayer0"
		options["OrderInLayer"] = math.floor(self:ReadNumber(self.SkillEffectOrderInLayer, 30))
		options["Alpha"] = safeAlpha
		options["PlayRate"] = 1.15
		options["IgnoreMapLayerCheck"] = true
		local serial = _EffectService:PlayEffect(safeRuid, localPlayer, Vector3(self:ReadNumber(x, 0), self:ReadNumber(y, 0), 0), 0, Vector3(safeScale, safeScale, 1), false, options)
		if serial == 0 then
			log("[BRSkill] effect failed source=" .. self:ReadString(sourceId, "skill") .. " ruid=" .. safeRuid)
		end
	end

	method any CollectTargetsForContext(any context)
		-- Collects player and named training-dummy targets in the caster's current map.
		local targets = {}
		local seenTargets = {}
		local mapName = self:GetContextMapName(context)
		if mapName == "" then
			return targets
		end
		local users = _UserService:GetUsersByMapName(mapName)
		if users ~= nil then
			for index, entity in ipairs(users) do
				self:AddSkillTarget(targets, seenTargets, entity)
			end
		end
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity ~= nil then
			self:CollectNamedTrainingDummyTargets(mapEntity, targets, seenTargets)
			local dummyComponents = mapEntity:GetChildComponentsByTypeName("script.BRTrainingDummy", true)
			if dummyComponents == nil or dummyComponents[1] == nil then
				dummyComponents = mapEntity:GetChildComponentsByTypeName("BRTrainingDummy", true)
			end
			if dummyComponents ~= nil then
				for index, dummy in ipairs(dummyComponents) do
					if dummy ~= nil and dummy.Entity ~= nil then
						self:AddSkillTarget(targets, seenTargets, dummy.Entity)
					end
				end
			end
			local partBoxComponents = mapEntity:GetChildComponentsByTypeName("script.BRPartBox", true)
			if partBoxComponents == nil or partBoxComponents[1] == nil then
				partBoxComponents = mapEntity:GetChildComponentsByTypeName("BRPartBox", true)
			end
			if partBoxComponents ~= nil then
				for index, partBox in ipairs(partBoxComponents) do
					if partBox ~= nil and partBox.Entity ~= nil then
						self:AddSkillTarget(targets, seenTargets, partBox.Entity)
					end
				end
			end
			local botComponents = mapEntity:GetChildComponentsByTypeName("script.BRBattleBotController", true)
			if botComponents ~= nil then
				for index, bot in ipairs(botComponents) do
					if bot ~= nil and bot.Entity ~= nil then
						self:AddSkillTarget(targets, seenTargets, bot.Entity)
					end
				end
			end
		end
		return targets
	end

	method void CollectNamedTrainingDummyTargets(Entity entity, any targets, any seenTargets)
		-- Recursively collects training-dummy targets by placement name.
		if entity == nil then
			return
		end
		if self:IsTrainingDummyPlacementName(entity.Name) == true and self:GetTrainingDummyComponent(entity) ~= nil then
			self:AddSkillTarget(targets, seenTargets, entity)
		end
		if self:IsPartBoxPlacementName(entity.Name) == true and self:GetPartBoxComponent(entity) ~= nil then
			self:AddSkillTarget(targets, seenTargets, entity)
		end
		if entity.Children == nil then
			return
		end
		for index, child in ipairs(entity.Children:ToTable()) do
			self:CollectNamedTrainingDummyTargets(child, targets, seenTargets)
		end
	end

	method void AddSkillTarget(any targets, any seenTargets, Entity entity)
		-- Adds one target once by entity key.
		if targets == nil or seenTargets == nil or entity == nil then
			return
		end
		local key = self:ReadString(self:GetEntityKey(entity), "")
		if key == "" then
			key = self:ReadString(entity.Name, "")
		end
		if key == "" or seenTargets[key] == true then
			return
		end
		seenTargets[key] = true
		table.insert(targets, entity)
	end

	method boolean IsSkillTargetValid(any context, Entity targetEntity)
		-- Checks self-hit, death, and same-user restrictions.
		if targetEntity == nil or isvalid(targetEntity) == false then
			return false
		end
		if context == nil or context.SourceEntity == nil then
			return false
		end
		if targetEntity.Id == context.SourceEntity.Id then
			return false
		end
		if targetEntity.PlayerComponent ~= nil then
			if targetEntity.PlayerComponent:IsDead() == true or targetEntity.PlayerComponent.Hp <= 0 then
				return false
			end
			if self:ReadString(targetEntity.PlayerComponent.UserId, "") == self:ReadString(context.UserId, "") then
				return false
			end
			return true
		end
		local bot = self:GetBattleBotComponent(targetEntity)
		if bot ~= nil then
			return bot:IsSkillTargetValid() == true
		end
		local partBox = self:GetPartBoxComponent(targetEntity)
		if partBox ~= nil then
			return partBox.EnablePartBox == true and partBox.available == true and partBox:IsDamageBox() == true
		end
		return self:GetTrainingDummyComponent(targetEntity) ~= nil
	end

	method any GetTrainingDummyComponent(Entity entity)
		-- Returns the training-dummy component from a named monster target.
		if entity == nil then
			return nil
		end
		local component = entity:GetComponent("script.BRTrainingDummy")
		if component == nil then
			component = entity:GetComponent("BRTrainingDummy")
		end
		return component
	end

	method any GetBattleBotComponent(Entity entity)
		-- Returns the battle AI component when the target is a spawned competitor bot.
		if entity == nil then
			return nil
		end
		local component = entity:GetComponent("script.BRBattleBotController")
		if component == nil then
			component = entity:GetComponent("BRBattleBotController")
		end
		return component
	end

	method boolean IsTrainingDummyPlacementName(string entityName)
		-- Checks whether an entity name is intended as a skill target monster.
		return self:ContainsNameToken(self:ReadString(entityName, ""), self.TrainingDummyNameTokens)
	end

	method boolean IsPartBoxPlacementName(string entityName)
		-- Checks whether an entity name is intended as a skill part box.
		return self:ContainsNameToken(self:ReadString(entityName, ""), self.PartBoxNameTokens)
	end

	method boolean ContainsNameToken(string source, string tokens)
		-- Checks comma-delimited placement-name tokens against one source name.
		local safeSource = string.lower(self:ReadString(source, ""))
		local safeTokens = self:ReadString(tokens, "")
		if safeSource == "" or safeTokens == "" then
			return false
		end
		local startIndex = 1
		while startIndex <= string.len(safeTokens) do
			local commaIndex, commaEndIndex = string.find(safeTokens, ",", startIndex)
			local token = ""
			if commaIndex == nil then
				token = string.sub(safeTokens, startIndex)
				startIndex = string.len(safeTokens) + 1
			else
				token = string.sub(safeTokens, startIndex, commaIndex - 1)
				startIndex = commaIndex + 1
			end
			token = string.lower(self:TrimString(token))
			if token ~= "" and string.find(safeSource, token, 1, true) ~= nil then
				return true
			end
		end
		return false
	end

	method string TrimString(string value)
		-- Trims whitespace around comma-delimited config tokens.
		local safeValue = self:ReadString(value, "")
		local trimmed = string.match(safeValue, "^%s*(.-)%s*$")
		return trimmed
	end

	method boolean IsTargetInsideHitboxes(any context, Entity targetEntity)
		-- Tests a target against any rectangle hitbox on the context.
		if context == nil or context.HitboxIds == nil or targetEntity == nil then
			return false
		end
		for index, hitboxId in ipairs(context.HitboxIds) do
			local hitbox = self._T.skillHitboxCatalog[hitboxId]
			if hitbox ~= nil and self:IsTargetInsideHitbox(context, targetEntity, hitbox) == true then
				return true
			end
		end
		return false
	end

	method void ShowHitboxesForContext(any context, string sourceId)
		-- Spawns short-lived translucent polygons so authored skill hitboxes can be checked in play mode.
		if context == nil or context.HitboxIds == nil then
			return
		end
		-- Hidden by default; only shown for casters who turned hitbox debug on via the HUD toggle.
		if self:IsHitboxDebugEnabledForUser(self:ReadString(context.UserId, "")) ~= true then
			return
		end
		local now = self:ReadNumber(_UtilLogic.ElapsedSeconds, 0)
		local minInterval = math.max(0.03, self:ReadNumber(self.HitboxDebugIntervalSeconds, 0.12))
		if context.LastHitboxDebugAt ~= nil and now - self:ReadNumber(context.LastHitboxDebugAt, 0) < minInterval then
			return
		end
		context.LastHitboxDebugAt = now
		local spawned = 0
		for index, hitboxId in ipairs(context.HitboxIds) do
			local safeHitboxId = self:ReadString(hitboxId, "")
			local hitbox = self._T.skillHitboxCatalog[safeHitboxId]
			if hitbox ~= nil then
				local rect = self:GetHitboxDebugRect(context, hitbox)
				if rect ~= nil then
					self:SpawnHitboxDebugBox(context, rect.X, rect.Y, rect.W, rect.H, self:ReadString(sourceId, "skill") .. ":" .. safeHitboxId)
					spawned = spawned + 1
				end
			end
		end
		if spawned > 0 then
			self:Log("hitbox debug source=" .. self:ReadString(sourceId, "skill") .. " count=" .. tostring(spawned))
		end
	end

	method any GetHitboxDebugRect(any context, any hitbox)
		-- Returns the actual world-space test bounds, including target padding.
		if context == nil or hitbox == nil then
			return nil
		end
		local origin = self:GetContextOrigin(context)
		local direction = self:GetContextDirection(context)
		local padding = self:GetSkillTargetPadding()
		local shape = self:ReadString(hitbox.Shape, "rect")
		if shape == "circle" then
			local rx = self:ReadNumber(hitbox.Rx, 0) / 100
			local by = self:ReadNumber(hitbox.By, 0) / 100
			local radius = math.max(0.01, self:ReadNumber(hitbox.Radius, 1) / 100) + padding
			return {
				X = origin.x + direction * rx,
				Y = origin.y + by,
				W = radius * 2,
				H = radius * 2
			}
		end
		local rx = self:ReadNumber(hitbox.Rx, 0) / 100
		local by = self:ReadNumber(hitbox.By, 0) / 100
		local width = math.max(0.01, self:ReadNumber(hitbox.W, 1) / 100)
		local height = math.max(0.01, self:ReadNumber(hitbox.H, 1) / 100)
		local halfWidth = width * 0.5 + padding
		local halfHeight = height * 0.5 + padding
		return {
			X = origin.x + (-direction) * (rx - width * 0.5),
			Y = origin.y + by + height * 0.5,
			W = halfWidth * 2,
			H = halfHeight * 2
		}
	end

	method void SpawnHitboxDebugBox(any context, number centerX, number centerY, number width, number height, string sourceId)
		if width <= 0 or height <= 0 then
			return
		end
		local mapName = self:GetContextMapName(context)
		if mapName == "" then
			return
		end
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil or isvalid(mapEntity) == false then
			return
		end
		local modelId = self:ReadString(self.HitboxDebugModelId, "")
		if modelId == "" then
			return
		end
		if self._T.hitboxDebugSeq == nil then
			self._T.hitboxDebugSeq = 0
		end
		self._T.hitboxDebugSeq = self._T.hitboxDebugSeq + 1
		local name = "SkillHitbox_" .. tostring(self._T.hitboxDebugSeq)
		local entity = _SpawnService:SpawnByModelId(modelId, name, Vector3(self:ReadNumber(centerX, 0), self:ReadNumber(centerY, 0), 0), mapEntity)
		if entity == nil then
			self:Log("hitbox debug spawn failed model=" .. modelId .. " source=" .. self:ReadString(sourceId, "skill"))
			return
		end
		local r = entity.PolygonRendererComponent
		if r ~= nil then
			-- PolygonRenderer draws from Points, NOT Transform.Scale, and low OrderInLayer is occluded by
			-- foreground map decorations — the same trap the telegraph hit. Build the rect explicitly and
			-- render it above foreground art so the hitbox is actually visible when debug is enabled.
			local hw = math.max(0.01, self:ReadNumber(width, 0.01)) * 0.5
			local hh = math.max(0.01, self:ReadNumber(height, 0.01)) * 0.5
			r.Points:Clear()
			r.Points:Add(Vector2(-hw, -hh))
			r.Points:Add(Vector2(hw, -hh))
			r.Points:Add(Vector2(hw, hh))
			r.Points:Add(Vector2(-hw, hh))
			r.SortingLayer = "MapLayer0"
			r.OrderInLayer = math.floor(self:ReadNumber(self.TelegraphOrderInLayer, 500))
			r.IgnoreMapLayerCheck = true
			r.Color = Color(1, 0.08, 0.02, math.max(0.15, math.min(1, self:ReadNumber(self.HitboxDebugAlpha, 0.35))))
		end
		entity:Destroy(math.max(0.03, self:ReadNumber(self.HitboxDebugDurationSeconds, 0.12)))
	end

	method number PreDelayFramesForSkill(any skillDef)
		-- Converts a skill's pre-cast wind-up (선딜레이) into timeline frames.
		local seconds = self:GetSkillPreDelaySeconds(skillDef)
		if seconds <= 0 then
			return 0
		end
		return math.max(0, math.floor(seconds / self:GetSkillFrameSeconds() + 0.5))
	end

	method number GetSkillPreDelaySeconds(any skillDef)
		-- Pre-cast wind-up in seconds. Any skill with a fixed cast-time hit area (an "area" event) gets a
		-- wind-up so its range is telegraphed before the strike — Brandish, Sharp Slash, etc. Projectile /
		-- summon / charge skills have no fixed cast-time hitbox, so they stay instant (no telegraph).
		-- TEMPORARY uniform 0.5s; TODO: move to a skills.csv column and read it off skillDef here.
		if skillDef == nil then
			return 0
		end
		if self:SkillHasAreaEvent(skillDef) == true then
			return 0.5
		end
		return 0
	end

	method boolean SkillHasAreaEvent(any skillDef)
		-- True if the skill fires any "area" event — a fixed cast-time hitbox that can be telegraphed.
		if skillDef == nil or skillDef.EventsByFrame == nil then
			return false
		end
		for frame, eventIds in pairs(skillDef.EventsByFrame) do
			if eventIds ~= nil then
				for index, eventId in ipairs(eventIds) do
					local eventDef = self._T.skillEventCatalog[self:ReadString(eventId, "")]
					if eventDef ~= nil and self:ReadString(eventDef.Type, "") == "area" then
						return true
					end
				end
			end
		end
		return false
	end

	method number PostDelayFramesForSkill(any skillDef)
		-- Converts a skill's post-cast recovery (후딜) into timeline frames.
		local seconds = self:GetSkillPostDelaySeconds(skillDef)
		if seconds <= 0 then
			return 0
		end
		return math.max(0, math.floor(seconds / self:GetSkillFrameSeconds() + 0.5))
	end

	method number GetSkillPostDelaySeconds(any skillDef)
		-- Post-cast recovery in seconds — spaces out chain steps so skills do not blur together.
		-- TEMPORARY uniform default for all skills; TODO: move to a skills.csv column per skill.
		if skillDef == nil then
			return 0
		end
		-- Meso Explosion is a trigger/starter charge that only enhances the NEXT chain skill (arms meso
		-- coins). It performs no attack itself, so it gets no recovery delay / freeze / attack swing -
		-- the enhanced skill fires immediately after.
		local id = self:ReadString(skillDef.BaseSkillKey, self:ReadString(skillDef.SkillKey, ""))
		if self:IsMesoExplosionSkillKey(id) == true then
			return 0
		end
		return 0.35
	end

	method void ApplyCasterPostDelayFreeze(any cast)
		-- Plays the one-shot attack swing once as post-cast recovery begins. Movement + jump are already
		-- locked for the whole chain by the chain-lock, so no per-cast freeze is applied here.
		if cast == nil or cast.CasterEntity == nil or isvalid(cast.CasterEntity) ~= true then
			return
		end
		if cast.PostFrozen ~= true then
			cast.PostFrozen = true
			self:PlayCasterAttackOnceClient(cast.CasterEntity)
		end
	end

	@ExecSpace("Client")
	method void PlayCasterAttackOnceClient(Entity caster)
		-- Plays a one-handed sword swing once on the avatar body (Onetime = play then stop).
		if caster == nil or isvalid(caster) ~= true or caster.AvatarRendererComponent == nil then
			return
		end
		local body = caster.AvatarRendererComponent:GetBodyEntity()
		if body == nil or isvalid(body) ~= true then
			return
		end
		local event = ActionStateChangedEvent()
		event.CoreActionName = "swingO1"
		event.PartsActionName = "swingO1"
		event.PlayType = SpriteAnimClipPlayType.Onetime
		body:SendEvent(event)
	end

	method void ApplyCasterChainLock(Entity caster, string userId)
		-- Locks the caster's left/right movement AND jump for the whole chain sequence by disabling the
		-- PlayerController (blocks all input) and zeroing InputSpeed. Backs up originals for restore.
		if caster == nil or isvalid(caster) ~= true then
			return
		end
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end
		if self._T.chainLocks == nil then
			self._T.chainLocks = {}
		end
		if self._T.chainLocks[safeUserId] ~= nil then
			self:ReapplyCasterChainLock(safeUserId)
			return
		end
		local lock = { Entity = caster, InputSpeed = nil, ControllerEnable = nil }
		if caster.MovementComponent ~= nil then
			lock.InputSpeed = caster.MovementComponent.InputSpeed
			caster.MovementComponent.InputSpeed = 0
		end
		if caster.PlayerControllerComponent ~= nil then
			lock.ControllerEnable = caster.PlayerControllerComponent.Enable
			caster.PlayerControllerComponent.Enable = false
		end
		self._T.chainLocks[safeUserId] = lock
	end

	method void ReapplyCasterChainLock(string userId)
		-- Re-asserts the lock every server frame: the lobby/battle controller re-sets these each tick.
		if self._T.chainLocks == nil then
			return
		end
		local lock = self._T.chainLocks[self:ReadString(userId, "")]
		if lock == nil then
			return
		end
		local entity = lock.Entity
		if entity == nil or isvalid(entity) ~= true then
			return
		end
		if entity.MovementComponent ~= nil then
			entity.MovementComponent.InputSpeed = 0
		end
		if entity.PlayerControllerComponent ~= nil then
			entity.PlayerControllerComponent.Enable = false
		end
	end

	method void ReapplyAllChainLocks()
		-- Re-asserts every active chain movement lock once per server frame.
		if self._T.chainLocks == nil then
			return
		end
		for lockUserId, lock in pairs(self._T.chainLocks) do
			self:ReapplyCasterChainLock(lockUserId)
		end
	end

	method void RestoreCasterChainLock(string userId)
		-- Releases the full-chain movement lock and returns the caster to idle. Idempotent.
		if self._T.chainLocks == nil then
			return
		end
		local safeUserId = self:ReadString(userId, "")
		local lock = self._T.chainLocks[safeUserId]
		if lock == nil then
			return
		end
		self._T.chainLocks[safeUserId] = nil
		local entity = lock.Entity
		if entity == nil or isvalid(entity) ~= true then
			return
		end
		if entity.MovementComponent ~= nil and lock.InputSpeed ~= nil then
			entity.MovementComponent.InputSpeed = lock.InputSpeed
		end
		if entity.PlayerControllerComponent ~= nil and lock.ControllerEnable ~= nil then
			entity.PlayerControllerComponent.Enable = lock.ControllerEnable
		end
		if entity.StateComponent ~= nil then
			entity.StateComponent:ChangeState("IDLE")
		end
	end

	method boolean IsTelegraphEnabledForUser(string userId)
		-- Telegraph (pre-delay range indicator) shows by default; a player can turn it off for themselves.
		if self.EnableSkillVisualEffects ~= true then
			return false
		end
		if self._T.telegraphOffByUser == nil then
			return true
		end
		return self._T.telegraphOffByUser[self:ReadString(userId, "")] ~= true
	end

	method boolean IsHitboxDebugEnabledForUser(string userId)
		-- Hitbox debug boxes are hidden by default; a player can turn them on for themselves.
		if self.EnableSkillHitboxDebug == true then
			return true
		end
		if self._T.hitboxDebugOnByUser == nil then
			return false
		end
		return self._T.hitboxDebugOnByUser[self:ReadString(userId, "")] == true
	end

	@ExecSpace("Server")
	method void SetTelegraphEnabled(string requestUserId, boolean enabled)
		-- HUD debug toggle: enable/disable the caster's own telegraph range display.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			return
		end
		if self._T.telegraphOffByUser == nil then
			self._T.telegraphOffByUser = {}
		end
		if enabled == true then
			self._T.telegraphOffByUser[userId] = nil
		else
			self._T.telegraphOffByUser[userId] = true
		end
		self:Log("telegraph toggle user=" .. userId .. " enabled=" .. tostring(enabled == true))
	end

	@ExecSpace("Server")
	method void SetHitboxDebugEnabled(string requestUserId, boolean enabled)
		-- HUD debug toggle: enable/disable the caster's own skill hitbox debug boxes.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			return
		end
		if self._T.hitboxDebugOnByUser == nil then
			self._T.hitboxDebugOnByUser = {}
		end
		if enabled == true then
			self._T.hitboxDebugOnByUser[userId] = true
		else
			self._T.hitboxDebugOnByUser[userId] = nil
		end
		self:Log("hitbox debug toggle user=" .. userId .. " enabled=" .. tostring(enabled == true))
	end

	method void ShowSkillTelegraph(any cast)
		-- Spawns a solid red range indicator over the skill's fixed hit area(s) for the whole pre-cast
		-- wind-up (선딜레이), then removes it when the wind-up ends. Only "area" events have a fixed
		-- hitbox at cast time, so projectile / summon skills are excluded (their hitbox travels/spawns).
		if cast == nil or cast.SkillDef == nil then
			return
		end
		-- Shown by default; the caster can turn it off for themselves via the HUD toggle.
		if self:IsTelegraphEnabledForUser(self:ReadString(cast.UserId, "")) ~= true then
			return
		end
		local eventsByFrame = cast.SkillDef.EventsByFrame
		if eventsByFrame == nil then
			return
		end
		local modelId = self:ReadString(self.HitboxDebugModelId, "")
		if modelId == "" then
			return
		end
		local mapName = self:GetContextMapName(cast)
		if mapName == "" then
			return
		end
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity == nil or isvalid(mapEntity) == false then
			return
		end
		local preFrames = self:PreDelayFramesForSkill(cast.SkillDef)
		if preFrames <= 0 then
			return
		end
		-- Stay solid for the whole wind-up, then vanish exactly when the pre-delay ends (the strike begins).
		local windUpSeconds = preFrames * self:GetSkillFrameSeconds()
		local seen = {}
		for frameKey, eventIds in pairs(eventsByFrame) do
			for index, eventId in ipairs(eventIds) do
				local eventDef = self._T.skillEventCatalog[self:ReadString(eventId, "")]
				-- Only "area" events carry a fixed cast-time hitbox — projectile / summon events do not.
				if eventDef ~= nil and self:ReadString(eventDef.Type, "") == "area" and eventDef.HitboxIds ~= nil then
					for hitIndex, hitboxId in ipairs(eventDef.HitboxIds) do
						local safeId = self:ReadString(hitboxId, "")
						if safeId ~= "" and seen[safeId] ~= true then
							seen[safeId] = true
							local hitbox = self._T.skillHitboxCatalog[safeId]
							if hitbox ~= nil then
								local rect = self:GetHitboxDebugRect(cast, hitbox)
								if rect ~= nil then
									self:SpawnTelegraphBox(mapEntity, rect, windUpSeconds)
								end
							end
						end
					end
				end
			end
		end
	end

	method void SpawnTelegraphBox(Entity mapEntity, any rect, number duration)
		-- Spawns one solid red telegraph box sized to the hit rect; it stays visible for `duration`
		-- (the pre-delay) and is removed when that time elapses. No fade — solid until the wind-up ends.
		if mapEntity == nil or isvalid(mapEntity) == false or rect == nil then
			return
		end
		local width = math.max(0.01, self:ReadNumber(rect.W, 0))
		local height = math.max(0.01, self:ReadNumber(rect.H, 0))
		local modelId = self:ReadString(self.HitboxDebugModelId, "")
		if modelId == "" then
			return
		end
		self._T.telegraphSeq = math.floor(self:ReadNumber(self._T.telegraphSeq, 0)) + 1
		local name = "SkillTelegraph_" .. tostring(self._T.telegraphSeq)
		local entity = _SpawnService:SpawnByModelId(modelId, name, Vector3(self:ReadNumber(rect.X, 0), self:ReadNumber(rect.Y, 0), 0), mapEntity)
		if entity == nil then
			self:Log("telegraph spawn failed model=" .. modelId)
			return
		end
		local r = entity.PolygonRendererComponent
		if r ~= nil then
			-- PolygonRenderer draws from Points, NOT from Transform.Scale. Build the rect explicitly.
			local hw = width * 0.5
			local hh = height * 0.5
			r.Points:Clear()
			r.Points:Add(Vector2(-hw, -hh))
			r.Points:Add(Vector2(hw, -hh))
			r.Points:Add(Vector2(hw, hh))
			r.Points:Add(Vector2(-hw, hh))
			r.SortingLayer = "MapLayer0"
			-- High order so the telegraph is not occluded by foreground map decorations.
			r.OrderInLayer = math.floor(self:ReadNumber(self.TelegraphOrderInLayer, 500))
			r.IgnoreMapLayerCheck = true
			r.Color = Color(1, 0.05, 0.05, 0.7)
		end
		-- Solid for the whole wind-up; the scheduled destroy removes it exactly when the pre-delay ends.
		entity:Destroy(math.max(0.05, self:ReadNumber(duration, 0.5)))
	end

	method boolean IsTargetInsideHitbox(any context, Entity targetEntity, any hitbox)
		-- Converts pixel hitbox data into world units and tests the target position.
		local origin = self:GetContextOrigin(context)
		local target = self:GetEntityPosition2(targetEntity)
		local direction = self:GetContextDirection(context)
		local shape = self:ReadString(hitbox.Shape, "rect")
		if shape == "circle" then
			local rx = self:ReadNumber(hitbox.Rx, 0) / 100
			local by = self:ReadNumber(hitbox.By, 0) / 100
			local radius = math.max(0.01, self:ReadNumber(hitbox.Radius, 1) / 100) + self:GetSkillTargetPadding()
			local centerX = origin.x + direction * rx
			local centerY = origin.y + by
			local dx = target.x - centerX
			local dy = target.y - centerY
			return (dx * dx + dy * dy) <= (radius * radius)
		end
		local rx = self:ReadNumber(hitbox.Rx, 0) / 100
		local by = self:ReadNumber(hitbox.By, 0) / 100
		local width = math.max(0.01, self:ReadNumber(hitbox.W, 1) / 100)
		local height = math.max(0.01, self:ReadNumber(hitbox.H, 1) / 100)
		local centerX = origin.x + (-direction) * (rx - width * 0.5)
		local centerY = origin.y + by + height * 0.5
		local halfWidth = width * 0.5 + self:GetSkillTargetPadding()
		local halfHeight = height * 0.5 + self:GetSkillTargetPadding()
		return math.abs(target.x - centerX) <= halfWidth and math.abs(target.y - centerY) <= halfHeight
	end

	method Vector2 GetContextOrigin(any context)
		-- Returns the origin for active casts, virtual casts, projectiles, areas, or fields.
		if context == nil then
			return Vector2(0, 0)
		end
		if context.X ~= nil and context.Y ~= nil then
			return Vector2(self:ReadNumber(context.X, 0), self:ReadNumber(context.Y, 0))
		end
		if context.IsVirtualCaster == true or context.FixedOriginX ~= nil then
			return Vector2(self:ReadNumber(context.FixedOriginX, 0), self:ReadNumber(context.FixedOriginY, 0))
		end
		return self:GetEntityPosition2(context.CasterEntity)
	end

	method string GetContextMapName(any context)
		-- Returns the map name for a context.
		if context == nil then
			return ""
		end
		if context.CasterEntity ~= nil and context.CasterEntity.CurrentMapName ~= nil then
			return self:ReadString(context.CasterEntity.CurrentMapName, "")
		end
		if context.SourceEntity ~= nil and context.SourceEntity.CurrentMapName ~= nil then
			return self:ReadString(context.SourceEntity.CurrentMapName, "")
		end
		return ""
	end

	method number GetContextDirection(any context)
		-- Returns a fixed direction for a context.
		if context ~= nil and self:ReadNumber(context.Direction, 0) < 0 then
			return -1
		end
		return 1
	end

	method number GetLookDirection(Entity entity)
		-- Reads the player's current facing direction, defaulting to right.
		if entity ~= nil and entity.PlayerControllerComponent ~= nil then
			if entity.PlayerControllerComponent.LookDirectionX < 0 then
				return -1
			end
		end
		return 1
	end

	method string GetEntityKey(Entity entity)
		-- Returns a stable key for runtime target memory.
		if entity == nil then
			return ""
		end
		if entity.Id ~= nil and entity.Id ~= "" then
			return entity.Id
		end
		return entity.Name
	end

	method number GetSkillAttackPower(Entity entity)
		-- Returns final attack power after temporary statuses.
		self:EnsureRuntime()
		if self._T.characterDefaults ~= nil then
			return math.max(1, self:ReadNumber(self._T.characterDefaults.AttackPower, self.DefaultSkillAttackPower))
		end
		return math.max(1, self:ReadNumber(self.DefaultSkillAttackPower, 300))
	end

	method boolean RollCritical(Entity entity)
		-- Rolls critical hit using the default critical rate.
		return _UtilLogic:RandomDouble() < self:GetCriticalRate(entity)
	end

	method number GetCriticalRate(Entity entity)
		-- Returns final critical rate.
		return math.max(0, math.min(1, self:ReadNumber(self.DefaultCriticalRate, 0.2)))
	end

	method number GetCriticalDamageRate(Entity entity)
		-- Returns final critical damage multiplier.
		return math.max(1, self:ReadNumber(self.DefaultCriticalDamageRate, 2.0))
	end

	method void ApplyCasterActionLimit(any cast)
		-- Temporarily reduces caster movement speed while a player-cast skill is active.
		if cast == nil or cast.CasterEntity == nil then
			return
		end
		local userId = self:ReadString(cast.UserId, "")
		if userId == "" or self._T.casterLocks[userId] ~= nil then
			return
		end
		local entity = cast.CasterEntity
		local moveSpeedRate = self:GetSkillActionLimitMoveRate(cast)
		if moveSpeedRate >= 0.999 then
			return
		end
		local lock = { Entity = entity, InputSpeed = nil }
		if entity.MovementComponent ~= nil then
			lock.InputSpeed = entity.MovementComponent.InputSpeed
			entity.MovementComponent.InputSpeed = math.max(0.05, self:ReadNumber(lock.InputSpeed, 1) * moveSpeedRate)
		end
		self._T.casterLocks[userId] = lock
	end

	method void RestoreCasterActionLimit(any cast)
		-- Restores movement speed after a non-virtual skill ends.
		if cast == nil then
			return
		end
		local userId = self:ReadString(cast.UserId, "")
		local lock = self._T.casterLocks[userId]
		if lock == nil then
			return
		end
		if lock.Entity ~= nil and isvalid(lock.Entity) and lock.Entity.MovementComponent ~= nil and lock.InputSpeed ~= nil then
			lock.Entity.MovementComponent.InputSpeed = lock.InputSpeed
		end
		self._T.casterLocks[userId] = nil
	end

	method number GetSkillTotalFrames(any skillDef)
		-- Returns a skill's timeline length in frames.
		if skillDef == nil then
			return 1
		end
		return math.max(1, math.floor(self:ReadNumber(skillDef.TotalFrames, 1)))
	end

	method number GetSkillCooldownSeconds(any skillDef)
		-- Converts a skill cooldown from frames to seconds.
		if skillDef == nil then
			return self:GetChainCastCooldownSeconds()
		end
		return math.max(self:GetChainCastCooldownSeconds(), math.floor(self:ReadNumber(skillDef.CooldownFrames, 1)) * self:GetSkillFrameSeconds())
	end

	method number GetSkillDurationSeconds(any skillDef)
		-- Converts a skill timeline duration from frames to seconds.
		return self:GetSkillTotalFrames(skillDef) * self:GetSkillFrameSeconds()
	end

	method number GetSkillMoveDurationSeconds(any actionDef)
		-- Converts a move action's frame-authored duration into seconds for continuous movement.
		if actionDef == nil then
			return self:GetSkillFrameSeconds()
		end
		return math.max(0.001, math.floor(self:ReadNumber(actionDef.MoveTimeFrames, 1)) * self:GetSkillFrameSeconds())
	end

	method number GetSkillFrameSeconds()
		-- Returns the fixed frame duration used by skill timelines.
		return math.max(0.005, self:ReadNumber(self.SkillFrameSeconds, 0.03))
	end

	method number GetSkillChainResetSeconds()
		-- Returns the idle timeout before the player-cast chain restarts from slot 1.
		return math.max(0.1, self:ReadNumber(self.SkillChainResetSeconds, 2.5))
	end

	method number GetChainCastCooldownSeconds()
		-- Returns the minimum cooldown between player-cast chain steps.
		return math.max(0.03, self:ReadNumber(self.ChainCastCooldownSeconds, 0.18))
	end

	method number GetUniqueSkillCooldownSeconds()
		-- Returns the minimum cooldown between character unique skills.
		return math.max(0.05, self:ReadNumber(self.UniqueSkillCooldownSeconds, 1.4))
	end

	method number GetSkillMovementSpeedRate()
		-- Returns the movement speed multiplier during a non-virtual skill cast.
		return math.max(0, math.min(1, self:ReadNumber(self.SkillMovementSpeedRate, 0.45)))
	end

	method number GetSkillActionLimitMoveRate(any cast)
		-- Reads movement restriction from skill_action_restrictions.csv.
		self:EnsureRuntime()
		local skillKey = ""
		if cast ~= nil then
			skillKey = self:ReadString(cast.SkillKey, "")
		end
		if skillKey ~= "" and self._T.skillRestrictionCatalog ~= nil and self._T.skillRestrictionCatalog[skillKey] ~= nil then
			return math.max(0, math.min(1, self:ReadNumber(self._T.skillRestrictionCatalog[skillKey].MoveSpeedRate, 1)))
		end
		return 1
	end

	method number GetPlayerBoundsCheckSeconds()
		-- Returns the polling interval for player map-bound recovery.
		return math.max(0.02, self:ReadNumber(self.PlayerBoundsCheckSeconds, 0.08))
	end

	method number GetPlayerBoundsPadding()
		-- Returns tolerance around map bounds before recovery triggers.
		return math.max(0, self:ReadNumber(self.PlayerBoundsPadding, 0.05))
	end

	method number GetSafeFootholdYOffset()
		-- Returns the small lift applied when storing a foothold position.
		return math.max(0, self:ReadNumber(self.SafeFootholdYOffset, 0.04))
	end

	method number GetSafeFootholdSearchDistance()
		-- Returns extra downward search room for fallback foothold recovery.
		return math.max(1, self:ReadNumber(self.SafeFootholdSearchDistance, 8))
	end

	method number GetSkillTargetPadding()
		-- Returns target padding added to rectangle hitboxes.
		return math.max(0, self:ReadNumber(self.SkillTargetPadding, 0.12))
	end

	method number Now()
		-- Returns server elapsed time in seconds.
		return _UtilLogic.ElapsedSeconds
	end

	method void ResetUser(string userId)
		-- Clears one user's skill parts and runtime chain state.
		self:EnsureRuntime()
		if userId == nil or userId == "" then
			return
		end
		self:ResetUserStateOnly(userId)
		self:NotifyUserChanged(userId)
		self:Log("reset user=" .. userId)
	end

	method void ResetUserForBattle(string userId)
		-- Starts a battle from a clean CSV-backed chain state.
		self:EnsureRuntime()
		if userId == nil or userId == "" then
			return
		end

		self:ResetUserStateOnly(userId)
		local seededCount = 0
		if self.SeedDefaultChainOnBattleReset == true then
			seededCount = self:SeedBattleChainFromData(userId, "battle-reset")
		end
		self:NotifyUserChanged(userId)
		self:ResetLocalBattleSkillRuntime(userId, "battle-reset")
		self:Log("battle reset user=" .. userId .. " seeded=" .. tostring(seededCount))
	end

	method void ResetUserStateOnly(string userId)
		self._T.userStates[userId] = self:CreateUserState()
		self:ClearUserRuntimeState(userId)
	end

	method void ClearUserRuntimeState(string userId)
		-- Removes casts/cooldowns left by lobby or previous match usage.
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return
		end

		if self._T.activeCasts ~= nil then
			for index = #self._T.activeCasts, 1, -1 do
				local cast = self._T.activeCasts[index]
				if cast == nil then
					table.remove(self._T.activeCasts, index)
				elseif self:ReadString(cast.UserId, "") == safeUserId then
					cast.Cancelled = true
					if cast.IsVirtualCaster ~= true then
						self:RestoreCasterActionLimit(cast)
					end
					table.remove(self._T.activeCasts, index)
				end
			end
		end

		self:RemoveRuntimeRecordsForUser(self._T.activeAreas, safeUserId)
		self:RemoveRuntimeRecordsForUser(self._T.activeSkillMoves, safeUserId)
		self:RemoveRuntimeRecordsForUser(self._T.activeProjectiles, safeUserId)
		self:RemoveRuntimeRecordsForUser(self._T.activeFields, safeUserId)
		self:DestroySummonsForUser(safeUserId)
		self:RemoveStatusesForUser(safeUserId)

		if self._T.casterLocks ~= nil then
			local lock = self._T.casterLocks[safeUserId]
			if lock ~= nil and lock.Entity ~= nil and isvalid(lock.Entity) and lock.Entity.MovementComponent ~= nil and lock.InputSpeed ~= nil then
				lock.Entity.MovementComponent.InputSpeed = lock.InputSpeed
			end
			self._T.casterLocks[safeUserId] = nil
		end
		if self._T.chainRuntimeByUser ~= nil then
			self._T.chainRuntimeByUser[safeUserId] = nil
		end
		if self._T.uniqueRuntimeByUser ~= nil then
			self._T.uniqueRuntimeByUser[safeUserId] = nil
		end
		if self._T.lastSafeFootholdByUser ~= nil then
			self._T.lastSafeFootholdByUser[safeUserId] = nil
		end
	end

	method void DestroySummonsForUser(string userId)
		if self._T.activeSummons == nil then
			return
		end
		for index = #self._T.activeSummons, 1, -1 do
			local summon = self._T.activeSummons[index]
			if summon == nil or self:ReadString(summon.UserId, "") == userId then
				self:DestroySummonObject(summon, 0)
				table.remove(self._T.activeSummons, index)
			end
		end
	end

	method void RemoveRuntimeRecordsForUser(any records, string userId)
		if records == nil then
			return
		end
		for index = #records, 1, -1 do
			local record = records[index]
			if record == nil or self:ReadString(record.UserId, "") == userId then
				table.remove(records, index)
			end
		end
	end

	method void RemoveStatusesForUser(string userId)
		if self._T.statusByEntityId == nil then
			return
		end
		for entityId, statusMap in pairs(self._T.statusByEntityId) do
			local empty = true
			for statusId, status in pairs(statusMap) do
				if status == nil or self:ReadString(status.ApplierUserId, "") == userId or self:IsStatusTargetUser(status, userId) == true then
					statusMap[statusId] = nil
				else
					empty = false
				end
			end
			if empty == true then
				self._T.statusByEntityId[entityId] = nil
			end
		end
	end

	method boolean IsStatusTargetUser(any status, string userId)
		if status == nil or status.TargetEntity == nil or status.TargetEntity.PlayerComponent == nil then
			return false
		end
		return self:ReadString(status.TargetEntity.PlayerComponent.UserId, "") == self:ReadString(userId, "")
	end

	method number SeedBattleChainFromData(string userId, string sourceId)
		local seeded = self:SeedBattleChainFromSkillChainData(userId, sourceId)
		if seeded > 0 then
			return seeded
		end

		local partId = self:GetDefaultSeedPartId()
		if partId == "" then
			return 0
		end
		local part = self:AddPartDirectlyToChainSlot(userId, partId, 1, sourceId)
		if part == nil then
			return 0
		end
		return 1
	end

	method number SeedBattleChainFromSkillChainData(string userId, string sourceId)
		local data = self:GetDataTable("skill_chains")
		if data == nil or self:ReadNumber(data:GetRowCount(), 0) <= 0 then
			return 0
		end

		local rowIndex = 1
		local starterChainId = self:GetStarterChainIdForUser(userId)
		if starterChainId ~= "" then
			local preferredRowIndex = self:GetDataRowIndex(data, "chain_id", starterChainId)
			if preferredRowIndex > 0 then
				rowIndex = preferredRowIndex
			else
				self:Log("starter chain fallback user=" .. self:ReadString(userId, "") .. " missingChain=" .. starterChainId)
			end
		end

		local seeded = 0
		local maxSlot = self:GetChainSlotCount()
		for slotIndex = 1, maxSlot do
			local skillId = self:GetDataCell(data, rowIndex, "slot" .. tostring(slotIndex) .. "_skill_id", "")
			if skillId ~= "" then
				local partId = self:GetPartIdForSkillKey(skillId)
				if partId ~= "" and self:AddPartDirectlyToChainSlot(userId, partId, slotIndex, sourceId) ~= nil then
					seeded = seeded + 1
				else
					self:Log("battle seed skipped user=" .. self:ReadString(userId, "") .. " slot=" .. tostring(slotIndex) .. " skill=" .. skillId .. " reason=noPartOrLocked")
				end
			end
		end
		return seeded
	end

	method string GetStarterChainIdForUser(string userId)
		-- Reads the class-specific starter chain id from character_default_skills.csv.
		local data = self:GetDataTable("character_default_skills")
		if data == nil or self:ReadNumber(data:GetRowCount(), 0) <= 0 then
			return ""
		end

		local rowIndex = 1
		if _BRCharacterSystem ~= nil then
			local characterKey = _BRCharacterSystem:GetServerCharacterKey(userId)
			local preferredRowIndex = self:GetDataRowIndex(data, "character_key", characterKey)
			if preferredRowIndex > 0 then
				rowIndex = preferredRowIndex
			end
		end
		return self:GetDataCell(data, rowIndex, "starter_chain_id", "")
	end

	method any AddPartDirectlyToChainSlot(string userId, string partId, number chainSlot, string sourceId)
		local state = self:GetUserState(userId)
		if state == nil then
			return nil
		end
		local definition = self._T.catalog[self:ReadString(partId, "")]
		if definition == nil then
			return nil
		end
		local slotIndex = self:ClampChainSlot(chainSlot)
		if self:IsChainSlotUnlocked(state, slotIndex) ~= true then
			return nil
		end

		local part = self:CreatePartInstance(state, definition, sourceId)
		table.insert(state.Parts, part)
		state.EquippedChainSlots[slotIndex] = part.InstanceId
		state.Equipped["Chain" .. tostring(slotIndex)] = part.InstanceId
		self:Log("battle seed user=" .. userId .. " slot=" .. tostring(slotIndex) .. " part=" .. part.PartId)
		return part
	end

	method string GetDefaultSeedPartId()
		self:EnsureRuntime()
		if self._T.partIds ~= nil and #self._T.partIds > 0 then
			return self:ReadString(self._T.partIds[1], "")
		end
		return self:GetPartIdForSkillKey(self:GetDefaultBasicSkillId())
	end

	method string GetPartIdForSkillKey(string skillKey)
		local safeSkillKey = self:ReadString(skillKey, "")
		if safeSkillKey == "" or self._T.catalog == nil then
			return ""
		end
		if self._T.catalog[safeSkillKey] ~= nil then
			return safeSkillKey
		end
		if self._T.catalog[safeSkillKey .. "_part"] ~= nil then
			return safeSkillKey .. "_part"
		end
		for partId, definition in pairs(self._T.catalog) do
			if definition ~= nil and (self:ReadString(definition.SkillKey, "") == safeSkillKey or self:ReadString(definition.SlotKey, "") == safeSkillKey) then
				return self:ReadString(partId, "")
			end
		end
		return ""
	end

	method boolean GrantUserExperience(string userId, number amount, string sourceId)
		-- Grants skill-chain experience and unlocks chain slots through levels.
		self:EnsureRuntime()
		local state = self:GetUserState(userId)
		if state == nil then
			return false
		end

		local reward = math.max(0, math.floor(self:ReadNumber(amount, 0)))
		if reward <= 0 then
			return false
		end

		self:NormalizeUserLevelState(state)
		local oldLevel = self:GetUserLevel(state)
		local oldSlots = self:GetUnlockedChainSlotCount(state)
		state.Experience = math.max(0, math.floor(self:ReadNumber(state.Experience, 0))) + reward

		local leveled = false
		while self:CanLevelUpState(state) == true do
			local required = self:GetRequiredExperienceForNextLevel(state.Level)
			if state.Experience < required then
				break
			end
			state.Experience = state.Experience - required
			state.Level = math.min(self:GetMaxSkillLevel(), math.floor(self:ReadNumber(state.Level, self:GetStartingSkillLevel())) + 1)
			leveled = true
		end

		self:NormalizeUserState(state)
		local newLevel = self:GetUserLevel(state)
		local newSlots = self:GetUnlockedChainSlotCount(state)
		self:NotifyUserChanged(userId)
		self:Log("experience user=" .. userId
			.. " amount=" .. tostring(reward)
			.. " level=" .. tostring(oldLevel) .. "->" .. tostring(newLevel)
			.. " slots=" .. tostring(oldSlots) .. "->" .. tostring(newSlots)
			.. " exp=" .. tostring(state.Experience)
			.. " source=" .. self:ReadString(sourceId, "unknown"))
		return leveled
	end

	method any CreateUserState()
		-- Creates a fresh user state with a horizontal skill chain.
		return {
			Parts = {},
			Equipped = {},
			EquippedChainSlots = {},
			BagSlots = {},
			Level = self:GetStartingSkillLevel(),
			Experience = 0,
			NextInstanceId = 1
		}
	end

	method any GetUserState(string userId)
		-- Returns or creates runtime skill state for one user.
		self:EnsureRuntime()
		if userId == nil or userId == "" then
			return nil
		end
		if self._T.userStates[userId] == nil then
			self._T.userStates[userId] = self:CreateUserState()
		end
		self:NormalizeUserState(self._T.userStates[userId])
		return self._T.userStates[userId]
	end

	method number AddUserMeso(string userId, number amount, string sourceId)
		-- Adds battle meso to a user's runtime balance.
		self:EnsureRuntime()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return 0
		end
		local addAmount = math.max(0, math.floor(self:ReadNumber(amount, 0)))
		local current = math.max(0, math.floor(self:ReadNumber(self._T.userMeso[safeUserId], 0)))
		local nextValue = current + addAmount
		self._T.userMeso[safeUserId] = nextValue
		self:Log("meso add user=" .. safeUserId .. " amount=" .. tostring(addAmount) .. " balance=" .. tostring(nextValue) .. " source=" .. self:ReadString(sourceId, ""))
		return nextValue
	end

	method boolean SpendUserMeso(string userId, number amount, string sourceId)
		-- Spends battle meso if the user has enough.
		self:EnsureRuntime()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return false
		end
		local spendAmount = math.max(0, math.floor(self:ReadNumber(amount, 0)))
		local current = self:GetUserMeso(safeUserId)
		if current < spendAmount then
			self:Log("meso spend skipped user=" .. safeUserId .. " need=" .. tostring(spendAmount) .. " balance=" .. tostring(current) .. " source=" .. self:ReadString(sourceId, ""))
			return false
		end
		self._T.userMeso[safeUserId] = current - spendAmount
		self:Log("meso spend user=" .. safeUserId .. " amount=" .. tostring(spendAmount) .. " balance=" .. tostring(current - spendAmount) .. " source=" .. self:ReadString(sourceId, ""))
		return true
	end

	method number GetUserMeso(string userId)
		-- Returns a user's runtime battle meso balance.
		self:EnsureRuntime()
		local safeUserId = self:ReadString(userId, "")
		if safeUserId == "" then
			return 0
		end
		return math.max(0, math.floor(self:ReadNumber(self._T.userMeso[safeUserId], 0)))
	end

	method any OpenBoxForUser(string userId, number dropCount, boolean autoEquip, string sourceId)
		-- Grants one or more random first-order parts from a supply box.
		self:EnsureRuntime()
		local result = {
			Dropped = {},
			LastPart = nil
		}
		local count = math.max(1, math.floor(self:ReadNumber(dropCount, 1)))
		for index = 1, count do
			local part = self:GrantRandomPart(userId, autoEquip, sourceId)
			if part ~= nil then
				table.insert(result.Dropped, part)
				result.LastPart = part
			end
		end
		return result
	end

	method any GrantRandomPart(string userId, boolean autoEquip, string sourceId)
		-- Rolls and grants one random skill part.
		local partId = self:RollPartId()
		return self:GrantPart(userId, partId, autoEquip, sourceId)
	end

	method string RollPartId()
		-- Selects a random part id from the catalog.
		self:EnsureRuntime()
		if self._T.partIds == nil or #self._T.partIds <= 0 then
			return ""
		end
		local index = math.random(1, #self._T.partIds)
		return self._T.partIds[index]
	end

	method any GrantPart(string userId, string partId, boolean autoEquip, string sourceId)
		-- Grants one first-order part and optionally equips it into the chain.
		self:EnsureRuntime()
		local state = self:GetUserState(userId)
		if state == nil then
			return nil
		end
		
		local definition = self._T.catalog[self:ReadString(partId, "")]
		if definition == nil then
			self:Log("grant skipped user=" .. userId .. " part=" .. self:ReadString(partId, "") .. " reason=noSkillDefinition")
			return nil
		end
		
		local part = self:CreatePartInstance(state, definition, sourceId)
		table.insert(state.Parts, part)
		local placed = false
		if autoEquip == true then
			local chainSlot = self:FindFirstEmptyChainSlot(state)
			if chainSlot > 0 then
				placed = self:EquipPartInstanceToChainSlot(userId, part.InstanceId, chainSlot)
			end
		end
		if placed == false then
			local bagSlot = self:GetBagSlotIndexByInstanceId(state, part.InstanceId)
			if bagSlot > 0 then
				self:NotifyUserChanged(userId)
				placed = true
			end
		end
		if placed == false then
			local bagSlot = self:FindFirstEmptyBagSlot(state)
			if bagSlot <= 0 then
				self:RemovePartFromOwned(state, part.InstanceId)
				self:NotifyUserChanged(userId)
				self:Log("grant skipped user=" .. userId .. " part=" .. part.PartId .. " reason=noInventorySpace")
				return nil
			end
			state.BagSlots[bagSlot] = part.InstanceId
			self:NotifyUserChanged(userId)
			placed = true
		end
		
		self:Log("grant user=" .. userId .. " part=" .. part.PartId .. " slot=" .. part.SlotKey .. " autoEquip=" .. tostring(autoEquip))
		return part
	end

	method any CreatePartInstance(any state, any definition, string sourceId)
		-- Creates one owned first-order part instance.
		local instanceId = state.NextInstanceId
		state.NextInstanceId = instanceId + 1
		return {
			InstanceId = instanceId,
			PartId = definition.PartId,
			SlotKey = definition.SlotKey,
			SkillKey = definition.SkillKey,
			DisplayName = definition.DisplayName,
			ShortKey = definition.ShortKey,
			IconRUID = self:ReadString(definition.IconRUID, ""),
			SourceId = self:ReadString(sourceId, "")
		}
	end

	method any CreateWorldPartInstance(string partId, string sourceId)
		-- Creates a transient skill-part payload that can be picked up from the world.
		self:EnsureRuntime()
		local safePartId = self:ReadString(partId, "")
		local definition = self._T.catalog[safePartId]
		if definition == nil then
			return nil
		end
		return {
			InstanceId = 0,
			PartId = definition.PartId,
			SlotKey = definition.SlotKey,
			SkillKey = definition.SkillKey,
			DisplayName = definition.DisplayName,
			ShortKey = definition.ShortKey,
			IconRUID = self:ReadString(definition.IconRUID, ""),
			SourceId = self:ReadString(sourceId, "")
		}
	end

	method number DropRandomPartsAt(Entity mapEntity, Vector3 worldPosition, number dropCount, string sourceId)
		-- Drops random skill parts directly into the world without first granting ownership.
		self:EnsureRuntime()
		if mapEntity == nil or worldPosition == nil then
			return 0
		end
		local count = math.max(1, math.floor(self:ReadNumber(dropCount, 1)))
		local dropped = 0
		for index = 1, count do
			local partId = self:RollPartId()
			local part = self:CreateWorldPartInstance(partId, sourceId)
			if part ~= nil then
				local offsetIndex = index - ((count + 1) * 0.5)
				local spawnPosition = Vector3(worldPosition.x + offsetIndex * 0.32, worldPosition.y + 0.08, worldPosition.z)
				local dropEntity = self:SpawnDroppedPartAt(mapEntity, spawnPosition, part, "")
				if dropEntity ~= nil then
					dropped = dropped + 1
				end
			end
		end
		self:Log("world random drop source=" .. self:ReadString(sourceId, "") .. " count=" .. tostring(dropped) .. "/" .. tostring(count))
		return dropped
	end

	@ExecSpace("Server")
	method boolean RequestKioskPurchase(string userId, string partId, string mapName, number x, number y, number price)
		-- Purchases one desired skill part from a kiosk and drops it at the kiosk position.
		self:EnsureRuntime()
		local safeUserId = self:ReadString(userId, "")
		local safePartId = self:ReadString(partId, "")
		local targetMapName = self:ReadString(mapName, "")
		if safeUserId == "" or safePartId == "" or targetMapName == "" then
			self:Log("kiosk purchase skipped reason=badRequest user=" .. safeUserId .. " part=" .. safePartId .. " map=" .. targetMapName)
			return false
		end
		local cost = math.max(0, math.floor(self:ReadNumber(price, 0)))
		if cost > 0 and self:SpendUserMeso(safeUserId, cost, "kiosk") ~= true then
			return false
		end
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. targetMapName)
		if mapEntity == nil then
			self:Log("kiosk purchase skipped reason=noMap map=" .. targetMapName)
			return false
		end
		local part = self:CreateWorldPartInstance(safePartId, "kiosk:" .. safeUserId)
		if part == nil then
			self:Log("kiosk purchase skipped reason=noPart part=" .. safePartId)
			return false
		end
		local drop = self:SpawnDroppedPartAt(mapEntity, Vector3(self:ReadNumber(x, 0), self:ReadNumber(y, 0) + 0.08, 0), part, safeUserId)
		local success = drop ~= nil
		self:Log("kiosk purchase user=" .. safeUserId .. " part=" .. safePartId .. " cost=" .. tostring(cost) .. " success=" .. tostring(success))
		return success
	end

	method boolean EquipPartInstance(string userId, number instanceId)
		-- Equips one part into the first empty chain slot.
		local state = self:GetUserState(userId)
		if state == nil then
			return false
		end
		local part = self:FindPartInState(state, instanceId)
		if part == nil then
			return false
		end

		local chainSlot = self:FindFirstEmptyChainSlot(state)
		if chainSlot <= 0 then
			self:Log("equip skipped user=" .. userId .. " part=" .. part.PartId .. " reason=chainFull")
			return false
		end
		return self:EquipPartInstanceToChainSlot(userId, part.InstanceId, chainSlot)
	end

	method boolean EquipPartInstanceToChainSlot(string userId, number instanceId, number chainSlot)
		-- Equips one owned part into an explicit chain slot.
		local state = self:GetUserState(userId)
		if state == nil then
			return false
		end
		local part = self:FindPartInState(state, instanceId)
		if part == nil then
			return false
		end

		local slotIndex = self:ClampChainSlot(chainSlot)
		if self:IsChainSlotUnlocked(state, slotIndex) ~= true then
			self:Log("chain equip failed user=" .. userId .. " slot=" .. tostring(slotIndex) .. " reason=locked")
			return false
		end
		local sourceBagSlot = self:GetBagSlotIndexByInstanceId(state, part.InstanceId)
		local targetInstanceId = state.EquippedChainSlots[slotIndex]
		if targetInstanceId ~= nil and targetInstanceId ~= part.InstanceId and self:FindPartInState(state, targetInstanceId) ~= nil then
			if sourceBagSlot > 0 then
				state.BagSlots[sourceBagSlot] = targetInstanceId
			else
				local emptyBagSlot = self:FindFirstEmptyBagSlot(state)
				if emptyBagSlot <= 0 then
					self:Log("chain equip failed user=" .. userId .. " slot=" .. tostring(slotIndex) .. " reason=noInventorySpace")
					return false
				end
				state.BagSlots[emptyBagSlot] = targetInstanceId
			end
		elseif sourceBagSlot > 0 then
			state.BagSlots[sourceBagSlot] = nil
		end
		self:RemovePartFromChain(state, part.InstanceId)
		self:RemovePartFromBag(state, part.InstanceId)
		state.EquippedChainSlots[slotIndex] = part.InstanceId
		state.Equipped["Chain" .. tostring(slotIndex)] = part.InstanceId
		self:NotifyUserChanged(userId)
		self:Log("chain equip user=" .. userId .. " slot=" .. tostring(slotIndex) .. " part=" .. part.PartId .. " tier=" .. tostring(self:GetPartChainTier(state, part.InstanceId)))
		return true
	end

	method boolean ClearChainSlot(string userId, number chainSlot)
		-- Clears one equipped chain slot.
		local state = self:GetUserState(userId)
		if state == nil then
			return false
		end

		local slotIndex = self:ClampChainSlot(chainSlot)
		local instanceId = state.EquippedChainSlots[slotIndex]
		if instanceId == nil then
			return false
		end

		local part = self:FindPartInState(state, instanceId)
		if part ~= nil then
			local bagSlot = self:FindFirstEmptyBagSlot(state)
			if bagSlot <= 0 then
				self:Log("chain clear failed user=" .. userId .. " slot=" .. tostring(slotIndex) .. " reason=noInventorySpace")
				return false
			end
			state.BagSlots[bagSlot] = instanceId
		end
		state.EquippedChainSlots[slotIndex] = nil
		state.Equipped["Chain" .. tostring(slotIndex)] = nil
		self:NotifyUserChanged(userId)
		self:Log("chain clear user=" .. userId .. " slot=" .. tostring(slotIndex))
		return true
	end

	method boolean ClearPartInstanceFromChain(string userId, number instanceId)
		-- Clears whichever chain slot currently contains the owned part instance.
		local state = self:GetUserState(userId)
		if state == nil then
			return false
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 or self:FindPartInState(state, safeInstanceId) == nil then
			return false
		end
		for slotIndex = 1, self:GetChainSlotCount() do
			if state.EquippedChainSlots[slotIndex] == safeInstanceId then
				return self:ClearChainSlot(userId, slotIndex)
			end
		end
		return false
	end

	method boolean MovePartInstanceToBagSlot(string userId, number instanceId, number bagSlot)
		-- Moves one owned part into a spare bag slot, swapping with the current slot content when needed.
		local state = self:GetUserState(userId)
		if state == nil then
			return false
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local part = self:FindPartInState(state, safeInstanceId)
		if part == nil then
			return false
		end

		local targetBagSlot = self:ClampBagSlot(bagSlot)
		local sourceChainSlot = self:GetEquippedPartSlotIndex(state, part)
		local sourceBagSlot = self:GetBagSlotIndexByInstanceId(state, safeInstanceId)
		local targetInstanceId = state.BagSlots[targetBagSlot]
		if sourceChainSlot <= 0 and sourceBagSlot <= 0 then
			return false
		end
		if sourceBagSlot == targetBagSlot then
			return false
		end

		if sourceChainSlot > 0 then
			if targetInstanceId ~= nil and self:FindPartInState(state, targetInstanceId) ~= nil then
				state.EquippedChainSlots[sourceChainSlot] = targetInstanceId
				state.Equipped["Chain" .. tostring(sourceChainSlot)] = targetInstanceId
			else
				state.EquippedChainSlots[sourceChainSlot] = nil
				state.Equipped["Chain" .. tostring(sourceChainSlot)] = nil
			end
			state.BagSlots[targetBagSlot] = safeInstanceId
		else
			state.BagSlots[sourceBagSlot] = targetInstanceId
			state.BagSlots[targetBagSlot] = safeInstanceId
		end

		self:NotifyUserChanged(userId)
		self:Log("bag move user=" .. userId .. " instance=" .. tostring(safeInstanceId) .. " bag=" .. tostring(targetBagSlot) .. " fromChain=" .. tostring(sourceChainSlot))
		return true
	end

	method boolean DropPartInstanceToWorld(string userId, number instanceId)
		-- Removes one owned part and creates a pickup entity near the player.
		local state = self:GetUserState(userId)
		if state == nil then
			return false
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local part = self:FindPartInState(state, safeInstanceId)
		if part == nil then
			return false
		end
		local playerEntity = self:FindPlayerEntityByUserId(userId)
		if playerEntity == nil then
			self:Log("world drop failed user=" .. userId .. " instance=" .. tostring(safeInstanceId) .. " reason=noPlayer")
			return false
		end
		local dropEntity = self:SpawnDroppedPart(playerEntity, part)
		if dropEntity == nil then
			self:Log("world drop failed user=" .. userId .. " instance=" .. tostring(safeInstanceId) .. " reason=spawnFailed")
			return false
		end
		local playerPosition = self:GetEntityPosition2(playerEntity)
		local dropPosition = self:GetEntityPosition2(dropEntity)
		local iconRuid = self:GetPartIconRUID(part)
		self:RemovePartFromOwned(state, safeInstanceId)
		self:NotifyUserChanged(userId)
		self:Log("world drop user=" .. userId
			.. " instance=" .. tostring(safeInstanceId)
			.. " part=" .. part.PartId
			.. " entity=" .. dropEntity.Name
			.. " playerPos=" .. tostring(playerPosition.x) .. "," .. tostring(playerPosition.y)
			.. " dropPos=" .. tostring(dropPosition.x) .. "," .. tostring(dropPosition.y)
			.. " icon=" .. iconRuid)
		return true
	end

	method Entity SpawnDroppedPart(Entity playerEntity, any part)
		-- Spawns a Maple-style dropped skill part entity near the player.
		if playerEntity == nil or part == nil then
			return nil
		end
		local mapEntity = playerEntity.CurrentMap
		if mapEntity == nil then
			return nil
		end
		local playerPosition = self:GetEntityPosition2(playerEntity)
		local spawnPosition = Vector3(playerPosition.x, playerPosition.y, 0)
		return self:SpawnDroppedPartAt(mapEntity, spawnPosition, part, self:GetUserIdFromPlayer(playerEntity))
	end

	method Entity SpawnDroppedPartAt(Entity mapEntity, Vector3 spawnPosition, any part, string sourceUserId)
		-- Spawns a Maple-style dropped skill part entity at an explicit world position.
		if mapEntity == nil or spawnPosition == nil or part == nil then
			return nil
		end
		local name = "DroppedSkillPart_" .. tostring(math.floor(self:ReadNumber(part.InstanceId, 0))) .. "_" .. tostring(math.floor(_UtilLogic.ElapsedSeconds * 1000))
		local groundPosition = self:ResolveDroppedPartGroundPosition(mapEntity, spawnPosition)
		local dropEntity = self:SpawnDroppedPartEntity(name, groundPosition, mapEntity)
		if dropEntity == nil then
			return nil
		end
		dropEntity.Visible = true
		local boxComponent = dropEntity:GetComponent("script.BRPartBox")
		if boxComponent ~= nil then
			dropEntity:RemoveComponent("script.BRPartBox")
		end
		---@type any
		local dropComponent = dropEntity:GetComponent("script.BRDroppedSkillPart")
		if dropComponent == nil then
			dropComponent = dropEntity:AddComponent("script.BRDroppedSkillPart")
		end
		if dropComponent ~= nil then
			dropComponent:InitializeDrop(
				self:ReadString(part.PartId, self:GetDefaultBasicSkillId() .. "_part"),
				self:GetSkillName(part),
				self:GetPartShortText(part),
				self:ReadString(sourceUserId, ""),
				self:ReadNumber(part.InstanceId, 0),
				self:GetPartIconRUID(part)
			)
		end
		return dropEntity
	end

	method Vector3 ResolveDroppedPartGroundPosition(Entity mapEntity, Vector3 spawnPosition)
		-- Places dropped skill parts on the nearest foothold like Maple item drops.
		if spawnPosition == nil then
			return Vector3(0, 0, 0)
		end
		local x = self:ReadNumber(spawnPosition.x, 0)
		local y = self:ReadNumber(spawnPosition.y, 0)
		local z = self:ReadNumber(spawnPosition.z, 0)
		if mapEntity == nil or mapEntity.FootholdComponent == nil then
			return Vector3(x, y, z)
		end

		local searchUp = self:GetDroppedPartGroundSearchUp()
		local searchDown = self:GetDroppedPartGroundSearchDown()
		local rayStart = Vector2(x, y + searchUp)
		local foothold = mapEntity.FootholdComponent:Raycast(rayStart, Vector2(0, -1), searchUp + searchDown)
		if foothold == nil then
			foothold = mapEntity.FootholdComponent:GetNearestFootholdByPoint(Vector2(x, y), searchUp + searchDown)
		end
		if foothold == nil or foothold:IsVertical() == true then
			return Vector3(x, y, z)
		end

		local startPoint = foothold.StartPoint
		local endPoint = foothold.EndPoint
		if startPoint == nil or endPoint == nil then
			return Vector3(x, y, z)
		end
		local minX = math.min(startPoint.x, endPoint.x) + 0.05
		local maxX = math.max(startPoint.x, endPoint.x) - 0.05
		local alignedX = x
		if maxX >= minX then
			alignedX = math.max(minX, math.min(maxX, x))
		end
		return Vector3(alignedX, foothold:GetYByX(alignedX) + self:GetDroppedPartGroundYOffset(), z)
	end

	method Entity SpawnDroppedPartEntity(string name, Vector3 spawnPosition, Entity mapEntity)
		-- Prefers the reusable model so drops work on maps without placed part boxes.
		local modelId = self:ReadString(self.DroppedPartModelId, "")
		if modelId ~= "" then
			local entity = _SpawnService:SpawnByModelId(modelId, name, spawnPosition, mapEntity)
			if entity ~= nil then
				return entity
			end
			self:Log("world drop model spawn failed modelId=" .. modelId)
		end

		local template = self:FindDropTemplateEntity(mapEntity)
		if template == nil then
			self:Log("world drop template missing map=" .. self:ReadString(mapEntity.Name, ""))
			return nil
		end
		return _SpawnService:SpawnByEntity(template, name, spawnPosition, mapEntity, false)
	end

	method Entity FindDropTemplateEntity(Entity mapEntity)
		-- Finds a named placed skill part box that can be cloned for a dropped pickup.
		if mapEntity == nil then
			return nil
		end
		local preferred = { "SkillPartBox", "LobbySkillPartBoxA", "LobbySkillPartBoxB", "LobbySkillPartBoxC" }
		for index, name in ipairs(preferred) do
			local entity = mapEntity:GetChildByName(name, false)
			if entity ~= nil and self:GetPartBoxComponent(entity) ~= nil then
				return entity
			end
		end
		local namedTemplate = self:FindNamedPartBoxTemplate(mapEntity)
		if namedTemplate ~= nil then
			return namedTemplate
		end
		if mapEntity.Children == nil then
			return nil
		end
		for index, child in ipairs(mapEntity.Children:ToTable()) do
			if child ~= nil and self:GetPartBoxComponent(child) ~= nil then
				return child
			end
		end
		return nil
	end

	method Entity FindNamedPartBoxTemplate(Entity entity)
		-- Recursively finds the first box whose placement name marks it as a part box.
		if entity == nil then
			return nil
		end
		if self:IsPartBoxPlacementName(entity.Name) == true and self:GetPartBoxComponent(entity) ~= nil then
			return entity
		end
		if entity.Children == nil then
			return nil
		end
		for index, child in ipairs(entity.Children:ToTable()) do
			local found = self:FindNamedPartBoxTemplate(child)
			if found ~= nil then
				return found
			end
		end
		return nil
	end

	method any GetPartBoxComponent(Entity entity)
		-- Returns the part-box component from an entity.
		if entity == nil then
			return nil
		end
		local component = entity:GetComponent("script.BRPartBox")
		if component == nil then
			component = entity:GetComponent("BRPartBox")
		end
		return component
	end

	method boolean MoveChainSlot(string userId, number fromChainSlot, number toChainSlot)
		-- Moves an equipped chain slot, swapping when the target slot is occupied.
		local state = self:GetUserState(userId)
		if state == nil then
			return false
		end

		local fromIndex = self:ClampChainSlot(fromChainSlot)
		local toIndex = self:ClampChainSlot(toChainSlot)
		if fromIndex == toIndex then
			return false
		end
		if self:IsChainSlotUnlocked(state, fromIndex) ~= true or self:IsChainSlotUnlocked(state, toIndex) ~= true then
			self:Log("chain move skipped user=" .. userId .. " from=" .. tostring(fromIndex) .. " to=" .. tostring(toIndex) .. " reason=locked")
			return false
		end

		local sourceInstanceId = state.EquippedChainSlots[fromIndex]
		if sourceInstanceId == nil or self:FindPartInState(state, sourceInstanceId) == nil then
			return false
		end

		local targetInstanceId = state.EquippedChainSlots[toIndex]
		state.EquippedChainSlots[toIndex] = sourceInstanceId
		state.Equipped["Chain" .. tostring(toIndex)] = sourceInstanceId

		if targetInstanceId ~= nil and self:FindPartInState(state, targetInstanceId) ~= nil then
			state.EquippedChainSlots[fromIndex] = targetInstanceId
			state.Equipped["Chain" .. tostring(fromIndex)] = targetInstanceId
		else
			state.EquippedChainSlots[fromIndex] = nil
			state.Equipped["Chain" .. tostring(fromIndex)] = nil
		end

		self:NotifyUserChanged(userId)
		self:Log("chain move user=" .. userId .. " from=" .. tostring(fromIndex) .. " to=" .. tostring(toIndex) .. " swapped=" .. tostring(targetInstanceId ~= nil))
		return true
	end

	method boolean EquipLatestPartInSlot(string userId, string slotKey)
		-- Equips the latest owned part matching a legacy category into the first empty chain slot.
		local state = self:GetUserState(userId)
		if state == nil then
			return false
		end
		for index = #state.Parts, 1, -1 do
			local part = state.Parts[index]
			if part ~= nil and part.SlotKey == slotKey then
				return self:EquipPartInstance(userId, part.InstanceId)
			end
		end
		return false
	end

	method any FindPartInState(any state, number instanceId)
		-- Finds one owned part by runtime instance id.
		if state == nil or state.Parts == nil then
			return nil
		end
		for index, part in ipairs(state.Parts) do
			if part ~= nil and part.InstanceId == instanceId then
				return part
			end
		end
		return nil
	end

	method any GetEquippedStats(string userId)
		-- Returns zero stats because skill parts no longer grant direct stat bonuses.
		return {
			MaxHpBonus = 0,
			DamageBonus = 0,
			SpeedBonus = 0,
			JumpBonus = 0
		}
	end

	method number GetMaxHp(string userId, number baseMaxHp)
		-- Returns base HP; skill parts do not provide stat bonuses.
		return math.max(1, math.floor(self:ReadNumber(baseMaxHp, 100)))
	end

	method number GetBasicAttackDamage(string userId, number baseDamage)
		-- Returns base damage; skill parts do not provide stat bonuses.
		return math.max(1, math.floor(self:ReadNumber(baseDamage, 20)))
	end

	method void ApplyMovementStatsToPlayer(Entity playerEntity, any baseStats)
		-- Restores base movement values; skill parts do not provide movement stats.
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return
		end

		if playerEntity.MovementComponent ~= nil and baseStats ~= nil then
			playerEntity.MovementComponent.InputSpeed = math.max(0.1, self:ReadNumber(baseStats.InputSpeed, playerEntity.MovementComponent.InputSpeed))
			playerEntity.MovementComponent.JumpForce = math.max(0.1, self:ReadNumber(baseStats.JumpForce, playerEntity.MovementComponent.JumpForce))
		end
		if playerEntity.RigidbodyComponent ~= nil and baseStats ~= nil then
			playerEntity.RigidbodyComponent.WalkSpeed = math.max(0.1, self:ReadNumber(baseStats.WalkSpeed, playerEntity.RigidbodyComponent.WalkSpeed))
			playerEntity.RigidbodyComponent.WalkJump = math.max(0.1, self:ReadNumber(baseStats.WalkJump, playerEntity.RigidbodyComponent.WalkJump))
		end
	end

	method string GetPartSummary(any part)
		-- Builds a compact first-order skill summary.
		if part == nil then
			return ""
		end
		return self:GetSkillTierText(part, 1)
	end

	method string GetPartSummaryWithTier(any part, number tier)
		-- Builds a skill summary that includes its current chain tier.
		if part == nil then
			return "-"
		end
		return self:GetSkillTierText(part, tier)
	end

	method string GetSkillName(any part)
		-- Returns the display name without the old Part suffix.
		if part == nil then
			return "Skill"
		end
		local displayName = self:ReadString(part.DisplayName, "")
		if displayName ~= "" then
			return displayName
		end
		local skillKey = self:ReadString(part.SkillKey, "")
		if skillKey ~= "" then
			return skillKey
		end
		return self:ReadString(part.PartId, "Skill")
	end

	method string GetPartIconRUID(any part)
		-- Returns the CSV/UI icon RUID carried by a skill part.
		if part == nil then
			return ""
		end
		local iconRuid = self:ReadString(part.IconRUID, "")
		if iconRuid ~= "" then
			return iconRuid
		end
		local skillKey = self:ReadString(part.SkillKey, self:ReadString(part.SlotKey, ""))
		if skillKey ~= "" then
			self:EnsureRuntime()
			if self._T.skillRuntimeCatalog ~= nil then
				local skillDef = self._T.skillRuntimeCatalog[skillKey]
				if skillDef ~= nil then
					iconRuid = self:ReadString(skillDef.IconRUID, "")
					if iconRuid ~= "" then
						return iconRuid
					end
				end
			end
			if _BRSkillUIDatabase ~= nil then
				iconRuid = _BRSkillUIDatabase:GetSlotIconRUID(skillKey, 1, false)
				if self:ReadString(iconRuid, "") ~= "" then
					return iconRuid
				end
			end
		end
		return ""
	end

	method string GetSkillTierText(any part, number tier)
		-- Formats the current chain tier label for one folded skill definition.
		local order = self:ClampSkillTier(tier)
		local skillDef = self:GetSkillDefinitionForPart(part, order)
		local displayName = self:GetSkillName(part)
		if skillDef ~= nil then
			displayName = self:ReadString(skillDef.DisplayName, displayName)
		end
		return displayName .. " " .. tostring(order) .. "차"
	end

	@ExecSpace("Server")
	method void RequestUserSnapshot(string userId)
		-- Pushes the latest skill panel snapshot to the requesting user.
		self:NotifyUserChanged(userId)
	end

	@ExecSpace("Server")
	method void RequestEquipPartToChainSlot(string requestUserId, number instanceId, number chainSlot)
		-- Handles drag-and-drop chain placement from the local skill UI.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			self:Log("chain equip request skipped reason=noUser instance=" .. tostring(instanceId) .. " slot=" .. tostring(chainSlot))
			return
		end
		if self:EquipPartInstanceToChainSlot(userId, instanceId, chainSlot) == false then
			self:Log("chain equip request failed user=" .. userId .. " instance=" .. tostring(instanceId) .. " slot=" .. tostring(chainSlot))
		end
	end

	@ExecSpace("Server")
	method void RequestGrantTestPartToChainSlot(string requestUserId, string partOrSkillId, number chainSlot)
		-- Developer-only helper used by the lobby test NPC to place a CSV skill part directly into a chain slot.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			self:Log("test grant skipped reason=noUser part=" .. self:ReadString(partOrSkillId, "") .. " slot=" .. tostring(chainSlot))
			return
		end

		self:EnsureRuntime()
		local partId = self:GetPartIdForSkillKey(partOrSkillId)
		if partId == "" then
			partId = self:ReadString(partOrSkillId, "")
		end
		if self._T.catalog == nil or self._T.catalog[partId] == nil then
			self:Log("test grant skipped user=" .. userId .. " reason=unknownPart part=" .. self:ReadString(partOrSkillId, ""))
			return
		end

		local state = self:GetUserState(userId)
		if state == nil then
			self:Log("test grant skipped user=" .. userId .. " reason=noState part=" .. partId)
			return
		end
		local slotIndex = self:ClampChainSlot(chainSlot)
		if self:IsChainSlotUnlocked(state, slotIndex) ~= true then
			self:Log("test grant skipped user=" .. userId .. " reason=locked slot=" .. tostring(slotIndex) .. " part=" .. partId)
			return
		end

		local previousInstanceId = state.EquippedChainSlots[slotIndex]
		if previousInstanceId ~= nil then
			self:RemovePartFromOwned(state, previousInstanceId)
		end

		local definition = self._T.catalog[partId]
		local part = self:CreatePartInstance(state, definition, "testnpc:" .. tostring(slotIndex))
		table.insert(state.Parts, part)
		if self:EquipPartInstanceToChainSlot(userId, part.InstanceId, slotIndex) ~= true then
			self:RemovePartFromOwned(state, part.InstanceId)
			self:NotifyUserChanged(userId)
			self:Log("test grant failed user=" .. userId .. " slot=" .. tostring(slotIndex) .. " part=" .. partId)
			return
		end
		self:Log("test grant user=" .. userId .. " slot=" .. tostring(slotIndex) .. " part=" .. partId)
	end

	@ExecSpace("Server")
	method void RequestClearChainSlot(string requestUserId, number chainSlot)
		-- Handles explicit chain-slot clearing from the local skill UI.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			self:Log("chain clear request skipped reason=noUser slot=" .. tostring(chainSlot))
			return
		end
		if self:ClearChainSlot(userId, chainSlot) == false then
			self:Log("chain clear request failed user=" .. userId .. " slot=" .. tostring(chainSlot))
		end
	end

	@ExecSpace("Server")
	method void RequestClearPartInstanceFromChain(string requestUserId, number instanceId)
		-- Handles explicit unequip by owned part instance id from the local skill UI.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			self:Log("chain clear instance request skipped reason=noUser instance=" .. tostring(instanceId))
			return
		end
		if self:ClearPartInstanceFromChain(userId, instanceId) == false then
			self:Log("chain clear instance request failed user=" .. userId .. " instance=" .. tostring(instanceId))
		end
	end

	@ExecSpace("Server")
	method void RequestMoveChainSlotToChainSlot(string requestUserId, number fromChainSlot, number toChainSlot)
		-- Handles drag-and-drop movement between already equipped chain slots.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			self:Log("chain move request skipped reason=noUser from=" .. tostring(fromChainSlot) .. " to=" .. tostring(toChainSlot))
			return
		end
		if self:MoveChainSlot(userId, fromChainSlot, toChainSlot) == false then
			self:Log("chain move request failed user=" .. userId .. " from=" .. tostring(fromChainSlot) .. " to=" .. tostring(toChainSlot))
		end
	end

	@ExecSpace("Server")
	method void RequestMovePartToBagSlot(string requestUserId, number instanceId, number bagSlot)
		-- Handles drag-and-drop movement into one of the two spare bag slots.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			self:Log("bag move request skipped reason=noUser instance=" .. tostring(instanceId) .. " bag=" .. tostring(bagSlot))
			return
		end
		if self:MovePartInstanceToBagSlot(userId, instanceId, bagSlot) == false then
			self:Log("bag move request failed user=" .. userId .. " instance=" .. tostring(instanceId) .. " bag=" .. tostring(bagSlot))
		end
	end

	@ExecSpace("Server")
	method void RequestDropPartToWorld(string requestUserId, number instanceId)
		-- Handles releasing a skill part outside the chain UI into the world.
		local userId = self:ResolveRequestUserId(self:ReadString(senderUserId, ""), requestUserId)
		if userId == "" then
			self:Log("world drop request skipped reason=noUser instance=" .. tostring(instanceId))
			return
		end
		if self:DropPartInstanceToWorld(userId, instanceId) == false then
			self:Log("world drop request failed user=" .. userId .. " instance=" .. tostring(instanceId))
		end
	end

	@ExecSpace("ServerOnly")
	method void NotifyUserChanged(string userId)
		-- Rebuilds and pushes the user's skill snapshot.
		if userId == nil or userId == "" then
			return
		end
		self:EnsureRuntime()
		self._T.snapshotVersions[userId] = self:ReadNumber(self._T.snapshotVersions[userId], 0) + 1
		local snapshot = self:BuildUserSnapshot(userId)
		self:PushUserSnapshot(userId, snapshot.PanelText, snapshot.HasParts, snapshot.ChainText, snapshot.BagText, snapshot.RecipeText, snapshot.Version, snapshot.Level, snapshot.Experience, snapshot.RequiredExperience, snapshot.UnlockedSlots)
	end

	@ExecSpace("Client")
	method void PushUserSnapshot(string userId, string panelText, boolean hasParts, string chainText, string bagText, string recipeText, number version, number level, number experience, number requiredExperience, number unlockedSlots)
		-- Receives the local player's skill panel snapshot.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			return
		end
		if self:ReadString(userId, "") ~= self:ReadString(localPlayer.PlayerComponent.UserId, "") then
			return
		end
		
		self._T.localPanelText = self:ReadString(panelText, self:GetEmptyPanelText())
		self._T.localPanelHasParts = hasParts == true
		self._T.localChainText = self:ReadString(chainText, "")
		self._T.localBagText = self:ReadString(bagText, "")
		self._T.localRecipeText = self:ReadString(recipeText, self:BuildEmptyRecipeText())
		self._T.localSnapshotVersion = self:ReadNumber(version, 0)
		self._T.localSkillLevel = math.max(1, math.floor(self:ReadNumber(level, 1)))
		self._T.localSkillExperience = math.max(0, math.floor(self:ReadNumber(experience, 0)))
		self._T.localSkillRequiredExperience = math.max(1, math.floor(self:ReadNumber(requiredExperience, 1)))
		self._T.localUnlockedChainSlots = math.max(1, math.floor(self:ReadNumber(unlockedSlots, self:GetBaseUnlockedChainSlots())))
		self._T.localPanelUpdatedAt = _UtilLogic.ElapsedSeconds
		self:RefreshLocalSkillChainUI("snapshot", self._T.localSnapshotVersion)
	end

	@ExecSpace("ClientOnly")
	method void RefreshLocalSkillChainUI(string reason, number version)
		-- Wakes the authored BattleHub skill UI as soon as a fresh snapshot arrives.
		local refreshed = 0
		refreshed = refreshed + self:RefreshSkillChainUIRoot("/ui/BRBattleHudGroup", reason, version)
		if refreshed <= 0 then
			refreshed = refreshed + self:RefreshSkillChainUIRoot("/ui/BRSkillChainGroup", reason, version)
		end
	end

	method number RefreshSkillChainUIRoot(string rootPath, string reason, number version)
		local root = _EntityService:GetEntityByPath(self:ReadString(rootPath, ""))
		if root == nil then
			return 0
		end
		local components = root:GetChildComponentsByTypeName("script.BRSkillChainUI", true)
		if components == nil or #components <= 0 then
			components = root:GetChildComponentsByTypeName("BRSkillChainUI", true)
		end
		if components == nil then
			return 0
		end

		local count = 0
		for index, component in ipairs(components) do
			if component ~= nil then
				---@type BRSkillChainUI
				local ui = component
				ui:RequestImmediateRefresh(reason, version)
				count = count + 1
			end
		end
		return count
	end

	@ExecSpace("Client")
	method void ResetLocalBattleSkillRuntime(string userId, string reason)
		-- Clears client-only common skill cooldowns that survive map changes.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			return
		end
		if self:ReadString(userId, "") ~= self:ReadString(localPlayer.PlayerComponent.UserId, "") then
			return
		end
		self:ClearLocalSkillMovement("battle-reset")
		if _BRCommonSkillSystem ~= nil then
			if _BRCommonSkillSystem:IsLocalNimbusActive() == true then
				_BRCommonSkillSystem:SetLocalNimbusActive(false, "battle-reset")
			else
				_BRCommonSkillSystem:StopNimbusEffect()
			end
			_BRCommonSkillSystem.localNextUniqueAt = 0
			_BRCommonSkillSystem.localNextBlinkAt = 0
			_BRCommonSkillSystem.localNextNimbusToggleAt = 0
			log("[BRSkillSystem] local common cooldown reset reason=" .. self:ReadString(reason, "reset"))
		end
	end

	@ExecSpace("Client")
	method string GetLocalPanelText()
		-- Returns the last synchronized local skill panel text.
		return self:ReadString(self._T.localPanelText, self:GetEmptyPanelText())
	end

	@ExecSpace("Client")
	method boolean LocalSnapshotHasParts()
		-- Returns whether the local snapshot owns at least one part.
		return self._T.localPanelHasParts == true
	end

	@ExecSpace("Client")
	method string GetLocalChainText()
		-- Returns semicolon-delimited chain slot records for the dedicated chain UI.
		return self:ReadString(self._T.localChainText, "")
	end

	@ExecSpace("Client")
	method string GetLocalBagText()
		-- Returns semicolon-delimited owned part records for the dedicated chain UI.
		return self:ReadString(self._T.localBagText, "")
	end

	@ExecSpace("Client")
	method string GetLocalStatsText()
		-- Returns the compact skill recipe line for legacy UI callers.
		return self:GetLocalRecipeText()
	end

	@ExecSpace("Client")
	method string GetLocalRecipeText()
		-- Returns the compact skill recipe line for the dedicated chain UI.
		return self:ReadString(self._T.localRecipeText, self:BuildEmptyRecipeText())
	end

	@ExecSpace("Client")
	method number GetLocalSnapshotVersion()
		-- Returns the latest local skill snapshot version.
		return self:ReadNumber(self._T.localSnapshotVersion, 0)
	end

	@ExecSpace("Client")
	method number GetLocalSkillLevel()
		-- Returns the latest local skill-chain level for HUD display.
		return math.max(1, math.floor(self:ReadNumber(self._T.localSkillLevel, self:GetStartingSkillLevel())))
	end

	@ExecSpace("Client")
	method number GetLocalSkillExperience()
		-- Returns the current skill-chain experience inside the current level.
		return math.max(0, math.floor(self:ReadNumber(self._T.localSkillExperience, 0)))
	end

	@ExecSpace("Client")
	method number GetLocalRequiredExperience()
		-- Returns the experience required for the next visible chain level.
		return math.max(1, math.floor(self:ReadNumber(self._T.localSkillRequiredExperience, self:GetExperiencePerLevel())))
	end

	@ExecSpace("Client")
	method number GetLocalUnlockedChainSlots()
		-- Returns how many chain slots are currently unlocked for the local user.
		return math.max(1, math.floor(self:ReadNumber(self._T.localUnlockedChainSlots, self:GetBaseUnlockedChainSlots())))
	end

	method any BuildUserSnapshot(string userId)
		-- Builds synchronized text for the player's skill chain panel.
		local state = self:GetUserState(userId)
		local hasParts = false
		if state ~= nil and state.Parts ~= nil and #state.Parts > 0 then
			hasParts = true
		end
		
		local text = "SKILLS"
			.. "\n" .. self:BuildEquippedText(state)
			.. "\n" .. self:BuildRecipeText(state)
			.. "\n" .. self:BuildOwnedPartsText(state)
		
		return {
			PanelText = text,
			HasParts = hasParts,
			ChainText = self:BuildChainSnapshotText(state),
			BagText = self:BuildBagSnapshotText(state),
			RecipeText = self:BuildRecipeText(state),
			Level = self:GetUserLevel(state),
			Experience = self:GetUserExperience(state),
			RequiredExperience = self:GetRequiredExperienceForNextLevel(self:GetUserLevel(state)),
			UnlockedSlots = self:GetUnlockedChainSlotCount(state),
			Version = self:ReadNumber(self._T.snapshotVersions[userId], 0)
		}
	end

	method string BuildEquippedText(any state)
		-- Builds a horizontal chain summary.
		return "Chain " .. tostring(self:GetUnlockedChainSlotCount(state)) .. "/" .. tostring(self:GetChainSlotCount()) .. "x1: " .. self:BuildChainLineText(state)
			.. "\n" .. self:BuildChainDetailText(state)
	end

	method string GetEquippedSlotSummary(any state, string slotKey)
		-- Returns a legacy category summary from the chain.
		local part = self:GetEquippedPartInSlot(state, slotKey)
		if part == nil then
			return "-"
		end
		return self:GetPartSummary(part)
	end

	method any GetEquippedPartInSlot(any state, string slotKey)
		-- Finds the first equipped chain part matching a legacy category.
		if state == nil or state.Equipped == nil then
			return nil
		end
		local chain = self:BuildChainState(state)
		for slotIndex = 1, self:GetChainSlotCount() do
			local part = self:FindPartInState(state, chain.Slots[slotIndex])
			if part ~= nil and part.SlotKey == slotKey then
				return part
			end
		end
		return nil
	end

	method string BuildStatsText(string userId)
		-- Builds a legacy-compatible skill recipe line.
		local state = self:GetUserState(userId)
		return self:BuildRecipeText(state)
	end

	method string BuildZeroStatsText()
		-- Returns a legacy-compatible empty skill recipe line.
		return self:BuildEmptyRecipeText()
	end

	method string BuildEmptyRecipeText()
		-- Returns a stable empty recipe line for client fallbacks.
		return "Skill: empty"
	end

	method string BuildRecipeText(any state)
		-- Builds the current skill recipe summary from consecutive chain parts.
		return self:BuildResolvedChainSummary(state)
	end
--[[
		local chain = self:BuildChainState(state)
		if chain.FilledCount <= 0 then
			return self:BuildEmptyRecipeText()
		end
		local part = self:FindPartInState(state, chain.HighestTierInstanceId)
		if part == nil then
			return "Skill: " .. tostring(math.max(1, math.floor(self:ReadNumber(chain.HighestTier, 1)))) .. "차"
		end
		return "Skill: " .. self:GetSkillTierText(part, chain.HighestTier)
	end

]]
	method string BuildChainSnapshotText(any state)
		-- Serializes slots as slot,instanceId,short,tier,displayName,skillKey,hasTrigger records.
		local chain = self:BuildChainState(state)
		local text = ""
		for slotIndex = 1, self:GetChainSlotCount() do
			local instanceId = math.floor(self:ReadNumber(chain.Slots[slotIndex], 0))
			local part = self:FindPartInState(state, instanceId)
			local locked = chain.Locked ~= nil and chain.Locked[slotIndex] == true
			local shortText = "-"
			local displayName = "-"
			local skillKey = "-"
			local tier = math.floor(self:ReadNumber(chain.Tiers[slotIndex], 0))
			local hasTrigger = "0"
			if locked == true then
				instanceId = 0
				shortText = "LOCK"
				displayName = "LOCKED"
				skillKey = "LOCKED"
				tier = -1
			elseif part ~= nil then
				shortText = self:GetPartShortText(part)
				displayName = self:SanitizeRecordText(self:GetSkillName(part))
				skillKey = self:SanitizeRecordText(self:ReadString(part.SkillKey, self:ReadString(part.SlotKey, part.PartId)))
				if self:SkillPartHasTrigger(part, tier) == true then
					hasTrigger = "1"
				end
			end
			if text ~= "" then
				text = text .. ";"
			end
			text = text .. tostring(slotIndex) .. "," .. tostring(instanceId) .. "," .. shortText .. "," .. tostring(tier) .. "," .. displayName .. "," .. skillKey .. "," .. hasTrigger
		end
		return text
	end

	method string BuildBagSnapshotText(any state)
		-- Serializes explicit spare bag slots as slot,instanceId,short,tier,displayName,skillKey,hasTrigger records.
		self:NormalizeUserState(state)
		local text = ""
		for bagSlot = 1, self:GetBagSlotCount() do
			local instanceId = 0
			if state ~= nil and state.BagSlots ~= nil then
				instanceId = math.floor(self:ReadNumber(state.BagSlots[bagSlot], 0))
			end
			local part = self:FindPartInState(state, instanceId)
			local shortText = "-"
			local displayName = "-"
			local skillKey = "-"
			local tier = 0
			local hasTrigger = "0"
			if part ~= nil then
				shortText = self:GetPartShortText(part)
				displayName = self:SanitizeRecordText(self:GetSkillName(part))
				skillKey = self:SanitizeRecordText(self:ReadString(part.SkillKey, self:ReadString(part.SlotKey, part.PartId)))
				tier = 1
				if self:SkillPartHasTrigger(part, tier) == true then
					hasTrigger = "1"
				end
			end
			if text ~= "" then
				text = text .. ";"
			end
			text = text .. tostring(bagSlot)
				.. "," .. tostring(instanceId)
				.. "," .. shortText
				.. "," .. tostring(tier)
				.. "," .. displayName
				.. "," .. skillKey
				.. "," .. hasTrigger
		end
		return text
	end

	method string BuildOwnedPartsText(any state)
		-- Builds a short spare bag list.
		self:NormalizeUserState(state)
		local bagSlotCount = self:GetBagSlotCount()
		local count = 0
		local text = ""
		for bagSlot = 1, bagSlotCount do
			local part = self:GetBagSlotPart(state, bagSlot)
			if part ~= nil then
				count = count + 1
				text = text .. "\nB" .. tostring(bagSlot) .. ": #" .. tostring(part.InstanceId) .. " " .. self:GetPartSummary(part)
			end
		end
		if count <= 0 then
			return "Bag(0/" .. tostring(bagSlotCount) .. "): empty"
		end
		return "Bag(" .. tostring(count) .. "/" .. tostring(bagSlotCount) .. ")" .. text
	end

	method boolean IsPartEquipped(any state, any part)
		-- Checks whether an owned part is equipped in any chain slot.
		if state == nil or state.Equipped == nil or part == nil then
			return false
		end
		return self:GetEquippedPartSlotIndex(state, part) > 0
	end

	method string GetEmptyPanelText()
		-- Returns the panel text before the first snapshot arrives.
		local chainText = ""
		for slotIndex = 1, self:GetChainSlotCount() do
			if slotIndex <= self:GetBaseUnlockedChainSlots() then
				chainText = chainText .. "[" .. tostring(slotIndex) .. ":-]"
			else
				chainText = chainText .. "[" .. tostring(slotIndex) .. ":LOCK]"
			end
		end
		return "SKILLS\nChain " .. tostring(self:GetBaseUnlockedChainSlots()) .. "/" .. tostring(self:GetChainSlotCount()) .. "x1: " .. chainText .. "\nSkill: empty\nBag(0): empty"
	end

	method number GetPanelMaxPartRows()
		-- Returns the max number of bag rows shown in the text panel.
		return math.max(1, math.floor(self:ReadNumber(self.PanelMaxPartRows, 2)))
	end

	method number GetBagSlotCount()
		-- Returns the number of visible spare inventory slots.
		return math.max(1, math.floor(self:ReadNumber(self.BagSlotCount, 4)))
	end

	method number GetDroppedPartSpawnYOffset()
		-- Returns the vertical offset used for player-foot dropped parts.
		return self:ReadNumber(self.DroppedPartSpawnYOffset, 0)
	end

	method number GetDroppedPartSpawnXOffset()
		-- Returns the horizontal offset used to place dropped parts in front of the player.
		return math.max(0, self:ReadNumber(self.DroppedPartSpawnXOffset, 0))
	end

	method number GetDroppedPartGroundYOffset()
		-- Returns the small vertical lift applied after landing on a foothold.
		return math.max(0, self:ReadNumber(self.DroppedPartGroundYOffset, 0.12))
	end

	method number GetDroppedPartGroundSearchUp()
		-- Returns the upward margin used before raycasting downward for dropped parts.
		return math.max(0, self:ReadNumber(self.DroppedPartGroundSearchUp, 3))
	end

	method number GetDroppedPartGroundSearchDown()
		-- Returns the downward search range used to land dropped parts on footholds.
		return math.max(0.1, self:ReadNumber(self.DroppedPartGroundSearchDown, 14))
	end

	method number GetPlayerDropDirection(Entity playerEntity)
		-- Returns the direction used when tossing a skill part from the UI to the world.
		if playerEntity ~= nil and playerEntity.PlayerControllerComponent ~= nil then
			if playerEntity.PlayerControllerComponent.LookDirectionX < 0 then
				return -1
			end
		end
		return 1
	end

	method void NormalizeUserState(any state)
		-- Ensures older runtime states have chain-slot fields.
		if state == nil then
			return
		end
		if state.Parts == nil then
			state.Parts = {}
		end
		if state.Equipped == nil then
			state.Equipped = {}
		end
		if state.EquippedChainSlots == nil then
			state.EquippedChainSlots = {}
			local legacySlots = { "Core", "Frame", "Circuit" }
			for index, legacySlot in ipairs(legacySlots) do
				local instanceId = state.Equipped[legacySlot]
				if instanceId ~= nil and index <= self:GetChainSlotCount() then
					state.EquippedChainSlots[index] = instanceId
				end
			end
		end
		if state.BagSlots == nil then
			state.BagSlots = {}
		end
		if state.NextInstanceId == nil then
			state.NextInstanceId = #state.Parts + 1
		end
		self:NormalizeUserLevelState(state)

		local used = {}
		local unlockedSlotCount = self:GetUnlockedChainSlotCount(state)
		for slotIndex = 1, self:GetChainSlotCount() do
			local instanceId = state.EquippedChainSlots[slotIndex]
			if slotIndex <= unlockedSlotCount and instanceId ~= nil and self:FindPartInState(state, instanceId) ~= nil then
				used[instanceId] = true
				state.Equipped["Chain" .. tostring(slotIndex)] = instanceId
			else
				state.EquippedChainSlots[slotIndex] = nil
				state.Equipped["Chain" .. tostring(slotIndex)] = nil
			end
		end

		for bagSlot = 1, self:GetBagSlotCount() do
			local instanceId = state.BagSlots[bagSlot]
			if instanceId ~= nil and self:FindPartInState(state, instanceId) ~= nil and used[instanceId] ~= true then
				used[instanceId] = true
			else
				state.BagSlots[bagSlot] = nil
			end
		end

		for index, part in ipairs(state.Parts) do
			if part ~= nil and used[part.InstanceId] ~= true then
				local bagSlot = self:FindFirstEmptyBagSlot(state)
				if bagSlot > 0 then
					state.BagSlots[bagSlot] = part.InstanceId
					used[part.InstanceId] = true
				end
			end
		end
	end

	method any BuildChainState(any state)
		-- Builds slot and tier arrays for the skill chain.
		local chain = {
			Slots = {},
			Tiers = {},
			Locked = {},
			UnlockedCount = 0,
			FilledCount = 0,
			HighestTier = 0,
			HighestTierInstanceId = nil
		}
		if state == nil then
			return chain
		end
		self:NormalizeUserState(state)
		local slotCount = self:GetChainSlotCount()
		local unlockedSlotCount = self:GetUnlockedChainSlotCount(state)
		chain.UnlockedCount = unlockedSlotCount
		local previousSkillKey = ""
		local currentTier = 0
		for slotIndex = 1, slotCount do
			if slotIndex > unlockedSlotCount then
				chain.Slots[slotIndex] = nil
				chain.Tiers[slotIndex] = -1
				chain.Locked[slotIndex] = true
				previousSkillKey = ""
				currentTier = 0
			else
				local instanceId = state.EquippedChainSlots[slotIndex]
				local part = self:FindPartInState(state, instanceId)
				if instanceId ~= nil and part ~= nil then
				local skillKey = self:ReadString(part.SkillKey, self:ReadString(part.SlotKey, part.PartId))
				if skillKey ~= "" and skillKey == previousSkillKey then
					currentTier = self:ClampSkillTier(currentTier + 1)
				else
					currentTier = 1
				end

				chain.Slots[slotIndex] = instanceId
				chain.Tiers[slotIndex] = currentTier
				chain.FilledCount = chain.FilledCount + 1
				previousSkillKey = skillKey
				if currentTier > chain.HighestTier then
					chain.HighestTier = currentTier
					chain.HighestTierInstanceId = instanceId
				end
				else
				chain.Slots[slotIndex] = nil
				chain.Tiers[slotIndex] = 0
				previousSkillKey = ""
				currentTier = 0
				end
			end
		end
		return chain
	end

	method string BuildChainLineText(any state)
		-- Builds compact slot boxes for the horizontal chain.
		local chain = self:BuildChainState(state)
		local text = ""
		for slotIndex = 1, self:GetChainSlotCount() do
			local part = self:FindPartInState(state, chain.Slots[slotIndex])
			local label = "-"
			if part ~= nil then
				label = self:GetPartShortText(part) .. tostring(chain.Tiers[slotIndex]) .. "차"
			end
			text = text .. "[" .. tostring(slotIndex) .. ":" .. label .. "]"
		end
		return text
	end

	method string BuildChainDetailText(any state)
		-- Builds one detail line per occupied chain slot.
		local chain = self:BuildChainState(state)
		local text = "Recipe: highest " .. tostring(math.max(0, math.floor(self:ReadNumber(chain.HighestTier, 0)))) .. "차"
		for slotIndex = 1, self:GetChainSlotCount() do
			local part = self:FindPartInState(state, chain.Slots[slotIndex])
			if part ~= nil then
				text = text .. "\nS" .. tostring(slotIndex) .. ": " .. self:GetPartSummaryWithTier(part, chain.Tiers[slotIndex])
			end
		end
		return text
	end

	method string GetPartShortText(any part)
		-- Returns a compact three-letter part label.
		if part == nil then
			return "-"
		end
		local shortKey = self:ReadString(part.ShortKey, "")
		if shortKey ~= "" then
			return shortKey
		end
		local slotKey = self:ReadString(part.SlotKey, "")
		if slotKey == "Core" then
			return "C"
		elseif slotKey == "Frame" then
			return "F"
		elseif slotKey == "Circuit" then
			return "R"
		end
		return "P"
	end

	method number FindFirstEmptyChainSlot(any state)
		-- Finds the first empty slot in the skill chain.
		self:NormalizeUserState(state)
		for slotIndex = 1, self:GetUnlockedChainSlotCount(state) do
			if state.EquippedChainSlots[slotIndex] == nil then
				return slotIndex
			end
		end
		return 0
	end

	method any GetBagSlotPart(any state, number bagSlot)
		-- Returns the part currently stored in a spare bag slot.
		if state == nil or state.BagSlots == nil then
			return nil
		end
		local slotIndex = self:ClampBagSlot(bagSlot)
		local instanceId = state.BagSlots[slotIndex]
		return self:FindPartInState(state, instanceId)
	end

	method number FindFirstEmptyBagSlot(any state)
		-- Finds the first empty spare bag slot.
		if state == nil then
			return 0
		end
		if state.BagSlots == nil then
			state.BagSlots = {}
		end
		for bagSlot = 1, self:GetBagSlotCount() do
			local instanceId = state.BagSlots[bagSlot]
			if instanceId == nil or self:FindPartInState(state, instanceId) == nil then
				state.BagSlots[bagSlot] = nil
				return bagSlot
			end
		end
		return 0
	end

	method number GetBagSlotIndexByInstanceId(any state, number instanceId)
		-- Returns the spare bag slot containing the given instance id.
		if state == nil or state.BagSlots == nil then
			return 0
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return 0
		end
		for bagSlot = 1, self:GetBagSlotCount() do
			if state.BagSlots[bagSlot] == safeInstanceId then
				return bagSlot
			end
		end
		return 0
	end

	method void RemovePartFromChain(any state, number instanceId)
		-- Removes a part from every chain slot before re-equipping.
		if state == nil or state.EquippedChainSlots == nil then
			return
		end
		for slotIndex = 1, self:GetChainSlotCount() do
			if state.EquippedChainSlots[slotIndex] == instanceId then
				state.EquippedChainSlots[slotIndex] = nil
				state.Equipped["Chain" .. tostring(slotIndex)] = nil
			end
		end
	end

	method void RemovePartFromBag(any state, number instanceId)
		-- Removes a part from every spare bag slot.
		if state == nil or state.BagSlots == nil then
			return
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		for bagSlot = 1, self:GetBagSlotCount() do
			if state.BagSlots[bagSlot] == safeInstanceId then
				state.BagSlots[bagSlot] = nil
			end
		end
	end

	method void RemovePartFromOwned(any state, number instanceId)
		-- Removes a part from owned state entirely when no visible slot is available.
		if state == nil or state.Parts == nil then
			return
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		self:RemovePartFromChain(state, safeInstanceId)
		self:RemovePartFromBag(state, safeInstanceId)
		for index = #state.Parts, 1, -1 do
			local part = state.Parts[index]
			if part ~= nil and part.InstanceId == safeInstanceId then
				table.remove(state.Parts, index)
			end
		end
	end

	method Entity FindPlayerEntityByUserId(string userId)
		-- Finds a live player entity by MSW user id.
		local safeUserId = tostring(self:ReadString(userId, ""))
		if safeUserId == "" or _UserService == nil or _UserService.UserEntities == nil then
			return nil
		end
		for index, playerEntity in ipairs(_UserService.UserEntities.Values) do
			if playerEntity ~= nil and isvalid(playerEntity) and playerEntity.PlayerComponent ~= nil then
				if tostring(self:ReadString(playerEntity.PlayerComponent.UserId, "")) == safeUserId then
					return playerEntity
				end
			end
		end
		return nil
	end

	method string GetUserIdFromPlayer(Entity playerEntity)
		-- Reads a player user id with a safe fallback.
		if playerEntity == nil or playerEntity.PlayerComponent == nil then
			return ""
		end
		return tostring(self:ReadString(playerEntity.PlayerComponent.UserId, ""))
	end

	method Vector2 GetEntityPosition2(Entity entity)
		-- Reads an entity world position as Vector2.
		if entity == nil or entity.TransformComponent == nil then
			return Vector2(0, 0)
		end
		local position = entity.TransformComponent.WorldPosition
		return Vector2(position.x, position.y)
	end

	method Entity GetEntityMap(Entity entity)
		-- Resolves the current map entity for one entity.
		if entity == nil then
			return nil
		end
		if entity.CurrentMap ~= nil then
			return entity.CurrentMap
		end
		local mapName = self:ReadString(entity.CurrentMapName, "")
		if mapName == "" then
			return nil
		end
		return _EntityService:GetEntityByPath("/maps/" .. mapName)
	end

	method any GetMapBoundsForEntity(Entity entity)
		-- Reads the map-part custom bound used by camera and movement clamps.
		local mapEntity = self:GetEntityMap(entity)
		if mapEntity == nil or mapEntity.MapComponent == nil or mapEntity.MapComponent.UseCustomBound ~= true then
			return nil
		end
		local leftBottom = mapEntity.MapComponent.LeftBottom
		local rightTop = mapEntity.MapComponent.RightTop
		if leftBottom == nil or rightTop == nil or rightTop.x <= leftBottom.x or rightTop.y <= leftBottom.y then
			return nil
		end
		return {
			Left = leftBottom.x,
			Bottom = leftBottom.y,
			Right = rightTop.x,
			Top = rightTop.y,
			MapName = self:ReadString(mapEntity.Name, self:ReadString(entity.CurrentMapName, ""))
		}
	end

	method Vector2 ClampPositionToMapBounds(Entity entity, Vector2 position)
		-- Clamps a world position to an entity's current map custom bound.
		if position == nil then
			return Vector2(0, 0)
		end
		local bounds = self:GetMapBoundsForEntity(entity)
		if bounds == nil then
			return position
		end
		return Vector2(
			math.max(bounds.Left, math.min(bounds.Right, position.x)),
			math.max(bounds.Bottom, math.min(bounds.Top, position.y))
		)
	end

	method Vector2 ClampContextPositionToMapBounds(any context, Vector2 position)
		-- Clamps a context position using the source or caster map.
		if context == nil then
			return position
		end
		local entity = context.SourceEntity
		if entity == nil then
			entity = context.CasterEntity
		end
		return self:ClampPositionToMapBounds(entity, position)
	end

	method boolean IsPositionOutsideMapBounds(Entity entity, Vector2 position, number padding)
		-- Checks whether a position has left an entity's current map custom bound.
		if position == nil then
			return false
		end
		local bounds = self:GetMapBoundsForEntity(entity)
		if bounds == nil then
			return false
		end
		local pad = math.max(0, self:ReadNumber(padding, 0))
		return position.x < bounds.Left - pad
			or position.x > bounds.Right + pad
			or position.y < bounds.Bottom - pad
			or position.y > bounds.Top + pad
	end

	method void TickPlayerBoundsReturn(number delta)
		-- Periodically remembers grounded positions and returns out-of-bound players.
		if self.EnablePlayerBoundsReturn ~= true then
			return
		end
		if _UserService == nil or _UserService.UserEntities == nil then
			return
		end
		self._T.playerBoundsCheckTimer = self:ReadNumber(self._T.playerBoundsCheckTimer, 0) + self:ReadNumber(delta, 0)
		if self._T.playerBoundsCheckTimer < self:GetPlayerBoundsCheckSeconds() then
			return
		end
		self._T.playerBoundsCheckTimer = 0
		for index, playerEntity in ipairs(_UserService.UserEntities.Values) do
			self:UpdatePlayerBoundsReturnState(playerEntity)
		end
	end

	method void UpdatePlayerBoundsReturnState(Entity playerEntity)
		-- Updates one player's safe foothold or returns them to it.
		if playerEntity == nil or isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			return
		end
		if playerEntity.PlayerComponent:IsDead() == true or playerEntity.PlayerComponent.Hp <= 0 then
			return
		end
		if self:GetMapBoundsForEntity(playerEntity) == nil then
			return
		end

		local userId = self:GetUserIdFromPlayer(playerEntity)
		if userId == "" then
			return
		end
		if self:IsCommonNimbusActiveForUser(userId) == true then
			return
		end
		local position = self:GetEntityPosition2(playerEntity)
		if self:TryHandleBattleBoundsReturn(playerEntity, userId, position) == true then
			return
		end
		if self:IsPositionOutsideMapBounds(playerEntity, position, self:GetPlayerBoundsPadding()) == true then
			self:ReturnPlayerToLastSafeFoothold(playerEntity, userId, position)
			return
		end
		self:RememberPlayerFootholdPosition(playerEntity, userId)
	end

	method boolean IsCommonNimbusActiveForUser(string userId)
		-- Nimbus is a controlled aerial ride; local ride bounds handle clamping while it is active.
		if _BRCommonSkillSystem == nil then
			return false
		end
		return _BRCommonSkillSystem:IsNimbusActiveForUser(self:ReadString(userId, "")) == true
	end

	method boolean TryHandleBattleBoundsReturn(Entity playerEntity, string userId, Vector2 position)
		-- Lets active battle maps apply their own damage and center-return rule.
		local mapEntity = self:GetEntityMap(playerEntity)
		if mapEntity == nil then
			return false
		end

		---@type BRBattleLogic
		local battleLogic = nil
		local logicEntity = nil
		local mapName = self:ReadString(playerEntity.CurrentMapName, "")
		if mapName ~= "" then
			logicEntity = _EntityService:GetEntityByPath("/maps/" .. mapName .. "/BattleLogic")
		end
		if logicEntity == nil then
			logicEntity = mapEntity:GetChildByName("BattleLogic", false)
		end
		if logicEntity ~= nil then
			battleLogic = logicEntity:GetComponent("script.BRBattleLogic")
			if battleLogic == nil then
				battleLogic = logicEntity:GetComponent("BRBattleLogic")
			end
		end
		if battleLogic == nil then
			battleLogic = mapEntity:GetComponent("script.BRBattleLogic")
			if battleLogic == nil then
				battleLogic = mapEntity:GetComponent("BRBattleLogic")
			end
		end
		if battleLogic == nil then
			return false
		end

		return battleLogic:HandlePlayerOutOfBoundsReturn(playerEntity, position) == true
	end

	method void RememberPlayerFootholdPosition(Entity playerEntity, string userId)
		-- Stores the latest grounded foothold position for jump/out-of-bound recovery.
		if playerEntity == nil or playerEntity.RigidbodyComponent == nil then
			return
		end
		if playerEntity.RigidbodyComponent:IsOnGround() ~= true then
			return
		end
		local position = self:GetEntityPosition2(playerEntity)
		local safePosition = Vector2(position.x, position.y)
		local foothold = playerEntity.RigidbodyComponent:GetCurrentFoothold()
		if foothold ~= nil then
			safePosition = Vector2(position.x, foothold:GetYByX(position.x) + self:GetSafeFootholdYOffset())
		end
		safePosition = self:ClampPositionToMapBounds(playerEntity, safePosition)
		local bounds = self:GetMapBoundsForEntity(playerEntity)
		local mapName = ""
		if bounds ~= nil then
			mapName = self:ReadString(bounds.MapName, "")
		end
		self._T.lastSafeFootholdByUser[self:ReadString(userId, "")] = {
			X = safePosition.x,
			Y = safePosition.y,
			MapName = mapName
		}
	end

	method void ReturnPlayerToLastSafeFoothold(Entity playerEntity, string userId, Vector2 fromPosition)
		-- Moves an out-of-bound player back to the latest remembered foothold.
		local safePosition = self:GetStoredSafeFootholdPosition(playerEntity, userId)
		if safePosition == nil then
			safePosition = self:FindNearestSafeFootholdPosition(playerEntity, fromPosition)
		end
		if safePosition == nil then
			safePosition = self:GetFallbackMapBoundPosition(playerEntity)
		end
		if safePosition == nil then
			return
		end
		safePosition = self:ClampPositionToMapBounds(playerEntity, safePosition)
		self:MoveEntityToWorldPosition(playerEntity, safePosition)
		self:ApplyLocalSkillMovementPosition(safePosition, "boundsReturn", self:ReadString(userId, ""))
		self._T.lastSafeFootholdByUser[self:ReadString(userId, "")] = {
			X = safePosition.x,
			Y = safePosition.y,
			MapName = self:ReadString(playerEntity.CurrentMapName, "")
		}
		self:Log("bounds return user=" .. self:ReadString(userId, "") .. " from=(" .. tostring(fromPosition.x) .. "," .. tostring(fromPosition.y) .. ") to=(" .. tostring(safePosition.x) .. "," .. tostring(safePosition.y) .. ")")
	end

	method any GetStoredSafeFootholdPosition(Entity playerEntity, string userId)
		-- Reads a stored safe position if it belongs to the same map.
		local record = self._T.lastSafeFootholdByUser[self:ReadString(userId, "")]
		if record == nil then
			return nil
		end
		local currentMapName = self:ReadString(playerEntity.CurrentMapName, "")
		local recordMapName = self:ReadString(record.MapName, currentMapName)
		if currentMapName ~= "" and recordMapName ~= "" and currentMapName ~= recordMapName then
			return nil
		end
		local position = Vector2(self:ReadNumber(record.X, 0), self:ReadNumber(record.Y, 0))
		if self:IsPositionOutsideMapBounds(playerEntity, position, 0) == true then
			return nil
		end
		return position
	end

	method any FindNearestSafeFootholdPosition(Entity playerEntity, Vector2 position)
		-- Searches downward inside the current map for a foothold fallback.
		local mapEntity = self:GetEntityMap(playerEntity)
		local bounds = self:GetMapBoundsForEntity(playerEntity)
		if mapEntity == nil or mapEntity.FootholdComponent == nil or bounds == nil then
			return nil
		end
		local x = self:ReadNumber(position.x, 0)
		x = math.max(bounds.Left, math.min(bounds.Right, x))
		local rayStart = Vector2(x, bounds.Top + 1)
		local searchDistance = math.max(1, bounds.Top - bounds.Bottom + self:GetSafeFootholdSearchDistance())
		local foothold = mapEntity.FootholdComponent:Raycast(rayStart, Vector2(0, -1), searchDistance)
		if foothold == nil then
			return nil
		end
		return Vector2(x, foothold:GetYByX(x) + self:GetSafeFootholdYOffset())
	end

	method any GetFallbackMapBoundPosition(Entity entity)
		-- Falls back to the custom-bound center if no foothold is available.
		local bounds = self:GetMapBoundsForEntity(entity)
		if bounds == nil then
			return nil
		end
		return Vector2((bounds.Left + bounds.Right) * 0.5, (bounds.Bottom + bounds.Top) * 0.5)
	end

	method number GetEquippedPartSlotIndex(any state, any part)
		-- Returns the slot index where a part is equipped.
		if state == nil or part == nil then
			return 0
		end
		self:NormalizeUserState(state)
		for slotIndex = 1, self:GetChainSlotCount() do
			if state.EquippedChainSlots[slotIndex] == part.InstanceId then
				return slotIndex
			end
		end
		return 0
	end

	method number GetPartChainTier(any state, number instanceId)
		-- Returns the current chain tier for an equipped part.
		local chain = self:BuildChainState(state)
		for slotIndex = 1, self:GetChainSlotCount() do
			if chain.Slots[slotIndex] == instanceId then
				return math.max(1, math.floor(self:ReadNumber(chain.Tiers[slotIndex], 1)))
			end
		end
		return 1
	end

	method number ClampChainSlot(number chainSlot)
		-- Clamps slot indexes to the horizontal chain bounds.
		local value = math.floor(self:ReadNumber(chainSlot, 1))
		return math.max(1, math.min(self:GetChainSlotCount(), value))
	end

	method number ClampBagSlot(number bagSlot)
		-- Clamps slot indexes to the spare bag bounds.
		local value = math.floor(self:ReadNumber(bagSlot, 1))
		return math.max(1, math.min(self:GetBagSlotCount(), value))
	end

	method void NormalizeUserLevelState(any state)
		-- Ensures level and experience fields exist on a user state.
		if state == nil then
			return
		end
		local minLevel = self:GetStartingSkillLevel()
		local maxLevel = self:GetMaxSkillLevel()
		state.Level = math.max(minLevel, math.min(maxLevel, math.floor(self:ReadNumber(state.Level, minLevel))))
		state.Experience = math.max(0, math.floor(self:ReadNumber(state.Experience, 0)))
	end

	method number GetStartingSkillLevel()
		-- Returns the first skill-chain progression level.
		return math.max(1, math.floor(self:ReadNumber(self.StartingSkillLevel, 1)))
	end

	method number GetBaseUnlockedChainSlots()
		-- Returns how many chain slots are available at the starting level.
		return math.max(1, math.min(self:GetChainSlotCount(), math.floor(self:ReadNumber(self.BaseUnlockedChainSlots, 1))))
	end

	method number GetChainSlotsPerLevel()
		-- Returns how many slots unlock per skill-chain level.
		return math.max(0, math.floor(self:ReadNumber(self.ChainSlotsPerLevel, 1)))
	end

	method number GetExperiencePerLevel()
		-- Returns the experience required for one skill-chain level.
		return math.max(1, math.floor(self:ReadNumber(self.ExperiencePerLevel, 1)))
	end

	method number GetMaxSkillLevel()
		-- Returns the highest level needed to unlock every configured chain slot.
		local startLevel = self:GetStartingSkillLevel()
		local baseSlots = self:GetBaseUnlockedChainSlots()
		local slotsPerLevel = self:GetChainSlotsPerLevel()
		local missingSlots = math.max(0, self:GetChainSlotCount() - baseSlots)
		if missingSlots <= 0 or slotsPerLevel <= 0 then
			return startLevel
		end
		return startLevel + math.ceil(missingSlots / slotsPerLevel)
	end

	method number GetUserLevel(any state)
		-- Returns a safe skill-chain level from a user state.
		if state == nil then
			return self:GetStartingSkillLevel()
		end
		return math.max(self:GetStartingSkillLevel(), math.min(self:GetMaxSkillLevel(), math.floor(self:ReadNumber(state.Level, self:GetStartingSkillLevel()))))
	end

	method number GetUserExperience(any state)
		-- Returns current in-level skill-chain experience.
		if state == nil then
			return 0
		end
		return math.max(0, math.floor(self:ReadNumber(state.Experience, 0)))
	end

	method number GetUnlockedChainSlotCount(any state)
		-- Returns the number of currently usable chain slots for a user state.
		if state == nil then
			return self:GetUnlockedChainSlotCountForLevel(self:GetStartingSkillLevel())
		end
		return self:GetUnlockedChainSlotCountForLevel(self:GetUserLevel(state))
	end

	method number GetUnlockedChainSlotCountForLevel(number level)
		-- Calculates unlocked chain slots from a skill-chain level.
		local startLevel = self:GetStartingSkillLevel()
		local safeLevel = math.max(startLevel, math.floor(self:ReadNumber(level, startLevel)))
		local slots = self:GetBaseUnlockedChainSlots() + math.max(0, safeLevel - startLevel) * self:GetChainSlotsPerLevel()
		return math.max(1, math.min(self:GetChainSlotCount(), slots))
	end

	method number GetRequiredExperienceForNextLevel(number level)
		-- Returns the experience cost to reach the next skill-chain level.
		return self:GetExperiencePerLevel()
	end

	method boolean CanLevelUpState(any state)
		-- Returns whether the user can still unlock more chain slots.
		if state == nil then
			return false
		end
		if self:GetUserLevel(state) >= self:GetMaxSkillLevel() then
			return false
		end
		return self:GetUnlockedChainSlotCount(state) < self:GetChainSlotCount()
	end

	method boolean IsChainSlotUnlocked(any state, number slotIndex)
		-- Checks whether a chain slot is usable for the current user state.
		local safeSlot = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlot <= 0 then
			return false
		end
		return safeSlot <= self:GetUnlockedChainSlotCount(state)
	end

	method number GetChainSlotCount()
		-- Returns the fixed horizontal chain slot count.
		return math.max(1, math.floor(self:ReadNumber(self.ChainSlotCount, 5)))
	end

	method number GetChainColumns()
		-- Returns the chain grid width.
		return self:GetChainSlotCount()
	end

	method number GetChainRows()
		-- Returns the chain grid height.
		return 1
	end

	method string FormatNumber(number value)
		-- Formats a number without excess decimals.
		local numberValue = self:ReadNumber(value, 0)
		if math.floor(numberValue) == numberValue then
			return tostring(math.floor(numberValue))
		end
		return tostring(math.floor(numberValue * 100 + 0.5) / 100)
	end

	method string SanitizeRecordText(string value)
		-- Keeps semicolon/comma-delimited UI snapshots parseable.
		local source = self:ReadString(value, "")
		local text = ""
		for index = 1, string.len(source) do
			local char = string.sub(source, index, index)
			if char == "," or char == ";" then
				text = text .. " "
			else
				text = text .. char
			end
		end
		return text
	end

	method string ResolveRequestUserId(string senderId, string requestUserId)
		-- Prefer the RPC sender id; fall back to the explicit UI id for editor/server tests.
		local sender = self:ReadString(senderId, "")
		if sender ~= "" then
			return sender
		end
		return self:ReadString(requestUserId, "")
	end

	method string ReadString(any value, string fallback)
		-- Reads a string-like value with fallback.
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		-- Reads a numeric value with fallback.
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		-- Writes skill-system logs when enabled.
		if self.VerboseLog == true then
			log("[BRSkill] " .. message)
		end
	end

end
