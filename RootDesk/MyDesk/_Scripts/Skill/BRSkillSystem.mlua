@Logic
script BRSkillSystem extends Logic

	property boolean AutoEquipDroppedParts = true

	property boolean VerboseLog = true

	property number PanelMaxPartRows = 2

	property number ChainSlotCount = 5

	property number StartingSkillLevel = 1

	property number BaseUnlockedChainSlots = 2

	property number ChainSlotsPerLevel = 1

	property number ExperiencePerLevel = 1

	property integer MaxSkillTier = 4

	property number BagSlotCount = 2

	property number SkillFrameSeconds = 0.03

	property number SkillChainResetSeconds = 2.5

	property number ChainCastCooldownSeconds = 0.18

	property number UniqueSkillCooldownSeconds = 1.4

	property number SkillMovementSpeedRate = 0.45

	property boolean EnablePlayerBoundsReturn = true

	property number PlayerBoundsCheckSeconds = 0.08

	property number PlayerBoundsPadding = 0.05

	property number SafeFootholdYOffset = 0.04

	property number SafeFootholdSearchDistance = 8

	property number DefaultSkillAttackPower = 300

	property number DefaultCriticalRate = 0.2

	property number DefaultCriticalDamageRate = 2.0

	property number SkillTargetPadding = 0.35

	property string TrainingDummyNameTokens = "BattleChainMonster,TrainingDummy,Monster"

	property string PartBoxNameTokens = "SkillPartBox,LobbySkillPartBox,PartBox,SupplyBox,SupplyPoint"

	property number DroppedPartSpawnYOffset = 0.35

	property number DroppedPartSpawnXOffset = 1.15

	property boolean EnableSkillVisualEffects = true

	property string SlashEffectRUID = "0706dac96b694cd699b87e602ba74f42"

	property string ProjectileEffectRUID = "4a7a78ed206847748a65a46e5f5ae206"

	property string BurstEffectRUID = "9194c22af1dc423a9b23eb4de171a137"

	property string GuardEffectRUID = "8a31de9dc1634e3bbd3d083f7deadf47"

	property string FieldEffectRUID = "9df237754ee44c90bb4602f55d29ff9b"

	property string HitEffectRUID = "9194c22af1dc423a9b23eb4de171a137"

	property number SkillEffectScale = 1.0

	property number SkillEffectAlpha = 1.0

	property integer SkillEffectOrderInLayer = 30

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes the server-side skill-chain runtime once per world session.
		self:EnsureRuntime()
		self:Log("runtime ready frameSeconds=" .. tostring(self:GetSkillFrameSeconds()))
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Advances active skill casts, hit areas, projectiles, fields, and temporary statuses.
		self:EnsureRuntime()
		self:TickActiveCasts(delta)
		self:TickActiveAreas(delta)
		self:TickActiveProjectiles(delta)
		self:TickActiveFields(delta)
		self:TickStatuses()
		self:TickPlayerBoundsReturn(delta)
	end

	method void EnsureRuntime()
		-- Initializes runtime-only skill data tables.
		if self._T.userStates == nil then
			self._T.userStates = {}
		end
		if self._T.catalog == nil then
			self._T.catalog = self:CreateCatalog()
		end
		if self._T.partIds == nil then
			self._T.partIds = self:CreatePartIdList()
		end
		if self._T.snapshotVersions == nil then
			self._T.snapshotVersions = {}
		end
		if self._T.skillRuntimeCatalog == nil then
			self._T.skillRuntimeCatalog = self:CreateSkillRuntimeCatalog()
		end
		if self._T.skillEventCatalog == nil then
			self._T.skillEventCatalog = self:CreateSkillEventCatalog()
		end
		if self._T.skillHitboxCatalog == nil then
			self._T.skillHitboxCatalog = self:CreateSkillHitboxCatalog()
		end
		if self._T.skillActionCatalog == nil then
			self._T.skillActionCatalog = self:CreateSkillActionCatalog()
		end
		if self._T.chainRuntimeByUser == nil then
			self._T.chainRuntimeByUser = {}
		end
		if self._T.uniqueRuntimeByUser == nil then
			self._T.uniqueRuntimeByUser = {}
		end
		if self._T.lastSafeFootholdByUser == nil then
			self._T.lastSafeFootholdByUser = {}
		end
		if self._T.playerBoundsCheckTimer == nil then
			self._T.playerBoundsCheckTimer = 0
		end
		if self._T.activeCasts == nil then
			self._T.activeCasts = {}
		end
		if self._T.activeAreas == nil then
			self._T.activeAreas = {}
		end
		if self._T.activeProjectiles == nil then
			self._T.activeProjectiles = {}
		end
		if self._T.activeFields == nil then
			self._T.activeFields = {}
		end
		if self._T.statusByEntityId == nil then
			self._T.statusByEntityId = {}
		end
		if self._T.casterLocks == nil then
			self._T.casterLocks = {}
		end
		if self._T.randomSeeded ~= true then
			self._T.randomSeeded = true
			math.randomseed(math.floor(_UtilLogic.ElapsedSeconds * 100000) + 17)
		end
	end

	method any CreateCatalog()
		-- Builds the first-order skill catalog. Part ids stay stable for runtime compatibility.
		local catalog = {}
		self:AddPartDefinition(catalog, "slash_part", "Slash", "Slash", "SL")
		self:AddPartDefinition(catalog, "shot_part", "Shot", "Shot", "SH")
		self:AddPartDefinition(catalog, "burst_part", "Burst", "Burst", "BU")
		self:AddPartDefinition(catalog, "dash_part", "Dash", "Dash", "DA")
		self:AddPartDefinition(catalog, "guard_part", "Guard", "Guard", "GU")
		self:AddPartDefinition(catalog, "field_part", "Field", "Field", "FI")
		return catalog
	end

	method void AddPartDefinition(any catalog, string partId, string skillKey, string displayName, string shortKey)
		-- Adds one first-order skill definition.
		catalog[partId] = {
			PartId = partId,
			SlotKey = skillKey,
			SkillKey = skillKey,
			DisplayName = displayName,
			ShortKey = shortKey
		}
	end

	method any CreatePartIdList()
		-- Returns rollable skill part ids.
		return {
			"slash_part",
			"shot_part",
			"burst_part",
			"dash_part",
			"guard_part",
			"field_part"
		}
	end

	method any CreateSkillRuntimeCatalog()
		-- Creates distinct skill timeline definitions for each skill order.
		local skills = {}
		self:AddSkillRuntimeDefinition(skills, "Slash", 1, "Slash", 12, 12, { [4] = { "divineSwingArea1" }, [8] = { "slashFollowEffect" } })
		self:AddSkillRuntimeDefinition(skills, "Slash", 2, "Slash II", 14, 16, { [3] = { "divineSwingArea1" }, [6] = { "slashTier2BackArea" }, [10] = { "slashFollowEffect" } })
		self:AddSkillRuntimeDefinition(skills, "Slash", 3, "Slash III", 16, 18, { [2] = { "slashTier3WideArea" }, [6] = { "divineSwingArea1" }, [11] = { "slashFollowEffect" } })
		self:AddSkillRuntimeDefinition(skills, "Slash", 4, "Slash IV", 18, 22, { [2] = { "slashTier4CrossArea" }, [7] = { "slashTier3WideArea" }, [13] = { "slashFollowEffect" } })
		self:AddSkillRuntimeDefinition(skills, "Shot", 1, "Shot", 12, 14, { [5] = { "basicProjectile" } })
		self:AddSkillRuntimeDefinition(skills, "Shot", 2, "Piercing Shot", 13, 16, { [4] = { "shotPierceProjectile" } })
		self:AddSkillRuntimeDefinition(skills, "Shot", 3, "Double Shot", 15, 18, { [3] = { "basicProjectile" }, [7] = { "shotPierceProjectile" } })
		self:AddSkillRuntimeDefinition(skills, "Shot", 4, "Storm Shot", 18, 22, { [2] = { "shotStormProjectile" }, [6] = { "shotPierceProjectile" }, [10] = { "basicProjectile" } })
		self:AddSkillRuntimeDefinition(skills, "Burst", 1, "Burst", 10, 18, { [3] = { "burstTriggerArea" } })
		self:AddSkillRuntimeDefinition(skills, "Burst", 2, "Burst II", 12, 20, { [3] = { "burstTriggerArea2" } })
		self:AddSkillRuntimeDefinition(skills, "Burst", 3, "Burst III", 14, 22, { [2] = { "burstTriggerArea3" } })
		self:AddSkillRuntimeDefinition(skills, "Burst", 4, "Burst IV", 16, 26, { [2] = { "burstTriggerArea4" }, [7] = { "burstEchoArea" } })
		self:AddSkillRuntimeDefinition(skills, "Dash", 1, "Dash", 9, 15, { [0] = { "dashMoveAction" }, [2] = { "dashDamageArea" } })
		self:AddSkillRuntimeDefinition(skills, "Dash", 2, "Dash II", 11, 17, { [0] = { "dashMoveAction" }, [2] = { "dashExtendedArea" } })
		self:AddSkillRuntimeDefinition(skills, "Dash", 3, "Dash III", 13, 19, { [0] = { "dashLongMoveAction" }, [1] = { "dashExtendedArea" }, [6] = { "dashReturnArea" } })
		self:AddSkillRuntimeDefinition(skills, "Dash", 4, "Dash IV", 15, 23, { [0] = { "dashLongMoveAction" }, [1] = { "dashBreakArea" }, [5] = { "dashExtendedArea" }, [9] = { "dashReturnArea" } })
		self:AddSkillRuntimeDefinition(skills, "Guard", 1, "Guard", 8, 20, { [0] = { "guardBuffAction" } })
		self:AddSkillRuntimeDefinition(skills, "Guard", 2, "Barrier", 10, 22, { [0] = { "guardBarrierAction" } })
		self:AddSkillRuntimeDefinition(skills, "Guard", 3, "Fortress", 12, 24, { [0] = { "guardFortressAction" }, [6] = { "slashFollowEffect" } })
		self:AddSkillRuntimeDefinition(skills, "Guard", 4, "Aegis", 14, 28, { [0] = { "guardAegisAction" }, [5] = { "guardBarrierAction" } })
		self:AddSkillRuntimeDefinition(skills, "Field", 1, "Field", 12, 24, { [6] = { "fieldCreateAction" } })
		self:AddSkillRuntimeDefinition(skills, "Field", 2, "Field II", 14, 26, { [5] = { "fieldCreateWideAction" } })
		self:AddSkillRuntimeDefinition(skills, "Field", 3, "Field III", 16, 28, { [4] = { "fieldCreatePulseAction" } })
		self:AddSkillRuntimeDefinition(skills, "Field", 4, "Field IV", 18, 32, { [3] = { "fieldCreateStormAction" }, [9] = { "fieldCreateWideAction" } })
		self:AddSkillRuntimeDefinition(skills, "UniqueHero", 1, "Hero Unique", 18, 46, { [1] = { "uniqueHeroAdvance" }, [4] = { "uniqueHeroArea" }, [9] = { "slashFollowEffect" } })
		self:AddSkillRuntimeDefinition(skills, "UniqueStorm", 1, "Storm Unique", 20, 48, { [2] = { "uniqueStormProjectile" }, [5] = { "uniqueStormProjectile" }, [8] = { "uniqueStormProjectile" } })
		self:AddSkillRuntimeDefinition(skills, "UniqueArcane", 1, "Arcane Unique", 22, 52, { [2] = { "uniqueArcaneField" }, [8] = { "uniqueArcaneBurst" } })
		return skills
	end

	method void AddSkillRuntimeDefinition(any skills, string baseSkillKey, number tier, string displayName, number totalFrames, number cooldownFrames, any eventsByFrame)
		-- Registers one tier as a different executable skill definition.
		local order = self:ClampSkillTier(tier)
		local skillKey = self:GetTieredSkillKey(baseSkillKey, order)
		skills[skillKey] = {
			SkillKey = skillKey,
			BaseSkillKey = baseSkillKey,
			Tier = order,
			DisplayName = displayName,
			TotalFrames = math.max(1, math.floor(self:ReadNumber(totalFrames, 1))),
			CooldownFrames = math.max(1, math.floor(self:ReadNumber(cooldownFrames, 1))),
			EventsByFrame = eventsByFrame
		}
	end

