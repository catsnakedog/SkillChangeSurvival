@Logic
script BRSkillSystem extends Logic

	property boolean AutoEquipDroppedParts = true

	property boolean SeedDefaultChainOnBattleReset = true

	property boolean VerboseLog = true

	property number PanelMaxPartRows = 2

	property number ChainSlotCount = 5

	property number StartingSkillLevel = 1

	property number BaseUnlockedChainSlots = 2

	property number ChainSlotsPerLevel = 1

	property number ExperiencePerLevel = 1

	property integer MaxSkillTier = 4

	property number BagSlotCount = 2

	property number SkillFrameSeconds = 0.03

	property number SkillChainResetSeconds = 2.5

	property number ChainCastCooldownSeconds = 0.18

	property number UniqueSkillCooldownSeconds = 1.4

	property number SkillMovementSpeedRate = 0.45

	property boolean EnablePlayerBoundsReturn = true

	property number PlayerBoundsCheckSeconds = 0.08

	property number PlayerBoundsPadding = 0.05

	property number SafeFootholdYOffset = 0.04

	property number SafeFootholdSearchDistance = 8

	property number DefaultSkillAttackPower = 300

	property number DefaultCriticalRate = 0.2

	property number DefaultCriticalDamageRate = 2.0

	property number SkillTargetPadding = 0.35

	property string TrainingDummyNameTokens = "BattleChainMonster,TrainingDummy,Monster"

	property string PartBoxNameTokens = "SkillPartBox,LobbySkillPartBox,PartBox,SupplyBox,SupplyPoint"

	property number DroppedPartSpawnYOffset = 0.35

	property number DroppedPartSpawnXOffset = 1.15

	property boolean EnableSkillVisualEffects = true

	property number SkillEffectScale = 1.0

	property number SkillEffectAlpha = 1.0

	property integer SkillEffectOrderInLayer = 30

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes the server-side skill-chain runtime once per world session.
		self:EnsureRuntime()
		self:Log("runtime ready frameSeconds=" .. tostring(self:GetSkillFrameSeconds()))
		self:ValidateSkillDataCatalogs()
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Advances active skill casts, hit areas, projectiles, fields, and temporary statuses.
		self:EnsureRuntime()
		self:TickActiveCasts(delta)
		self:TickActiveSkillMoves(delta)
		self:TickActiveAreas(delta)
		self:TickActiveProjectiles(delta)
		self:TickActiveFields(delta)
		self:TickStatuses()
		self:TickPlayerBoundsReturn(delta)
	end

	method void EnsureRuntime()
		-- Initializes runtime-only skill data tables from Data/*.csv-backed DataSets.
		if self._T.userStates == nil then
			self._T.userStates = {}
		end
		if self._T.snapshotVersions == nil then
			self._T.snapshotVersions = {}
		end
		if self._T.skillEffectCatalog == nil then
			self._T.skillEffectCatalog = self:CreateSkillEffectCatalog()
		end
		if self._T.skillHitboxCatalog == nil then
			self._T.skillHitboxCatalog = self:CreateSkillHitboxCatalog()
		end
		if self._T.skillActionCatalog == nil then
			self._T.skillActionCatalog = self:CreateSkillActionCatalog()
		end
		if self._T.skillEventCatalog == nil then
			self._T.skillEventCatalog = self:CreateSkillEventCatalog()
		end
		if self._T.skillRuntimeCatalog == nil then
			self._T.skillRuntimeCatalog = self:CreateSkillRuntimeCatalog()
		end
		if self._T.catalog == nil then
			self._T.catalog = self:CreateCatalog()
		end
		if self._T.partIds == nil then
			self._T.partIds = self:CreatePartIdList()
		end
		if self._T.skillRestrictionCatalog == nil then
			self._T.skillRestrictionCatalog = self:CreateSkillRestrictionCatalog()
		end
		if self._T.characterDefaults == nil then
			self._T.characterDefaults = self:CreateCharacterDefaults()
		end
		if self._T.chainRuntimeByUser == nil then
			self._T.chainRuntimeByUser = {}
		end
		if self._T.uniqueRuntimeByUser == nil then
			self._T.uniqueRuntimeByUser = {}
		end
		if self._T.lastSafeFootholdByUser == nil then
			self._T.lastSafeFootholdByUser = {}
		end
		if self._T.playerBoundsCheckTimer == nil then
			self._T.playerBoundsCheckTimer = 0
		end
		if self._T.activeCasts == nil then
			self._T.activeCasts = {}
		end
		if self._T.activeSkillMoves == nil then
			self._T.activeSkillMoves = {}
		end
		if self._T.activeAreas == nil then
			self._T.activeAreas = {}
		end
		if self._T.activeProjectiles == nil then
			self._T.activeProjectiles = {}
		end
		if self._T.activeFields == nil then
			self._T.activeFields = {}
		end
		if self._T.statusByEntityId == nil then
			self._T.statusByEntityId = {}
		end
		if self._T.casterLocks == nil then
			self._T.casterLocks = {}
		end
		if self._T.randomSeeded ~= true then
			self._T.randomSeeded = true
			math.randomseed(math.floor(_UtilLogic.ElapsedSeconds * 100000) + 17)
		end
	end

	method void ValidateSkillDataCatalogs()
		-- Logs broken CSV/DataSet references early so silent skill failures are visible.
		self:Log("data loaded skills=" .. tostring(self:GetTableCount(self._T.skillRuntimeCatalog)) .. " parts=" .. tostring(self:GetTableCount(self._T.catalog)) .. " events=" .. tostring(self:GetTableCount(self._T.skillEventCatalog)) .. " actions=" .. tostring(self:GetTableCount(self._T.skillActionCatalog)) .. " hitboxes=" .. tostring(self:GetTableCount(self._T.skillHitboxCatalog)))
		self:ValidateSkillTimelineEvents()
		self:ValidateSkillEventDefinitions()
		self:ValidateSkillActionDefinitions()
	end

	method void ValidateSkillTimelineEvents()
		-- Checks skill frame_event_ids against events.csv.
		if self._T.skillRuntimeCatalog == nil then
			return
		end
		for skillKey, skillDef in pairs(self._T.skillRuntimeCatalog) do
			if skillDef ~= nil and skillDef.EventsByFrame ~= nil then
				for frame, eventIds in pairs(skillDef.EventsByFrame) do
					for index, eventId in ipairs(eventIds) do
						local safeEventId = self:ReadString(eventId, "")
						if safeEventId ~= "" and (self._T.skillEventCatalog == nil or self._T.skillEventCatalog[safeEventId] == nil) then
							self:Log("data warning missing event skill=" .. self:ReadString(skillKey, "") .. " frame=" .. tostring(frame) .. " event=" .. safeEventId)
						end
					end
				end
			end
		end
	end

	method void ValidateSkillEventDefinitions()
		-- Checks events.csv and context-generator references.
		if self._T.skillEventCatalog == nil then
			return
		end
		for eventId, eventDef in pairs(self._T.skillEventCatalog) do
			local safeEventId = self:ReadString(eventId, "")
			local eventType = self:ReadString(eventDef.Type, "action")
			if eventType == "area" or eventType == "field" then
				self:ValidateHitboxReferences(safeEventId, eventDef.HitboxIds, "event-hitbox")
				self:ValidateActionReferences(safeEventId, eventDef.ActionIds, "event-action")
			elseif eventType == "projectile" then
				self:ValidateHitboxReferences(safeEventId, eventDef.HitboxIds, "event-projectile-hitbox")
				self:ValidateActionReferences(safeEventId, eventDef.ActionIds, "event-projectile-action")
				self:ValidateEventReferences(safeEventId, eventDef.CollisionEventIds, "event-projectile-collision")
				self:ValidateEventReferences(safeEventId, eventDef.ExpireEventIds, "event-projectile-expire")
			else
				self:ValidateActionReferences(safeEventId, eventDef.ActionIds, "event-action")
			end
		end
	end

	method void ValidateSkillActionDefinitions()
		-- Checks nested action detail references such as projectile collision events.
		if self._T.skillActionCatalog == nil then
			return
		end
		for actionId, actionDef in pairs(self._T.skillActionCatalog) do
			local safeActionId = self:ReadString(actionId, "")
			local actionType = self:ReadString(actionDef.Type, "")
			if actionType == "projectile" then
				self:ValidateHitboxReferences(safeActionId, actionDef.HitboxIds, "projectile-hitbox")
				self:ValidateEventReferences(safeActionId, actionDef.CollisionEventIds, "projectile-collision")
				self:ValidateEventReferences(safeActionId, actionDef.ExpireEventIds, "projectile-expire")
			elseif actionType == "field" then
				self:ValidateHitboxReferences(safeActionId, actionDef.HitboxIds, "field-hitbox")
				self:ValidateActionReferences(safeActionId, actionDef.ActionIds, "field-action")
			end
		end
	end

	method void ValidateActionReferences(string ownerId, any actionIds, string sourceType)
		-- Checks an action id list against actions.csv.
		if actionIds == nil then
			return
		end
		for index, actionId in ipairs(actionIds) do
			local safeActionId = self:ReadString(actionId, "")
			if safeActionId ~= "" and (self._T.skillActionCatalog == nil or self._T.skillActionCatalog[safeActionId] == nil) then
				self:Log("data warning missing action owner=" .. self:ReadString(ownerId, "") .. " type=" .. self:ReadString(sourceType, "") .. " action=" .. safeActionId)
			end
		end
	end

	method void ValidateEventReferences(string ownerId, any eventIds, string sourceType)
		-- Checks an event id list against events.csv.
		if eventIds == nil then
			return
		end
		for index, eventId in ipairs(eventIds) do
			local safeEventId = self:ReadString(eventId, "")
			if safeEventId ~= "" and (self._T.skillEventCatalog == nil or self._T.skillEventCatalog[safeEventId] == nil) then
				self:Log("data warning missing event owner=" .. self:ReadString(ownerId, "") .. " type=" .. self:ReadString(sourceType, "") .. " event=" .. safeEventId)
			end
		end
	end

	method void ValidateHitboxReferences(string ownerId, any hitboxIds, string sourceType)
		-- Checks a hitbox id list against rect/circle hitbox DataSets.
		if hitboxIds == nil then
			return
		end
		for index, hitboxId in ipairs(hitboxIds) do
			local safeHitboxId = self:ReadString(hitboxId, "")
			if safeHitboxId ~= "" and (self._T.skillHitboxCatalog == nil or self._T.skillHitboxCatalog[safeHitboxId] == nil) then
				self:Log("data warning missing hitbox owner=" .. self:ReadString(ownerId, "") .. " type=" .. self:ReadString(sourceType, "") .. " hitbox=" .. safeHitboxId)
			end
		end
	end

	method any CreateCatalog()
		-- Builds rollable skill parts from the skills DataSet.
		local catalog = {}
		local skills = self:GetDataTable("skills")
		if skills ~= nil then
			local rowCount = math.max(0, math.floor(self:ReadNumber(skills:GetRowCount(), 0)))
			for row = 1, rowCount do
				local skillId = self:GetDataCell(skills, row, "id", "")
				local category = self:GetDataCell(skills, row, "skill_category", "")
				if skillId ~= "" and self:IsSkillPartCategory(category) == true then
					local displayName = self:GetDataCell(skills, row, "name", skillId)
					self:AddPartDefinition(catalog, skillId .. "_part", skillId, displayName, self:BuildShortKey(skillId, displayName))
				end
			end
		end
		if self:GetTableCount(catalog) <= 0 then
			self:Log("part catalog empty reason=noChainSkillRows")
		end
		return catalog
	end

	method void AddPartDefinition(any catalog, string partId, string skillKey, string displayName, string shortKey)
		-- Adds one first-order skill definition.
		catalog[partId] = {
			PartId = partId,
			SlotKey = skillKey,
			SkillKey = skillKey,
			DisplayName = displayName,
			ShortKey = shortKey
		}
	end

	method any CreatePartIdList()
		-- Returns rollable skill part ids.
		local ids = {}
		if self._T.catalog ~= nil then
			for partId, definition in pairs(self._T.catalog) do
				table.insert(ids, partId)
			end
		end
		table.sort(ids)
		return ids
	end

	method any CreateSkillRuntimeCatalog()
		-- Creates executable skill timeline definitions from the skills DataSet.
		local skills = {}
		local data = self:GetDataTable("skills")
		if data == nil then
			return skills
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			local skillId = self:GetDataCell(data, row, "id", "")
			if skillId ~= "" then
				local eventsByFrame = self:ParseFrameEventMap(self:GetDataCell(data, row, "frame_event_ids", ""))
				local totalFrames = math.max(1, math.floor(self:ReadNumber(self:GetDataCell(data, row, "total_length_frames", "1"), 1)))
				totalFrames = math.max(totalFrames, self:InferTotalFramesFromEvents(eventsByFrame))
				local cooldownSeconds = math.max(0, self:ReadNumber(self:GetDataCell(data, row, "cooldown", "0"), 0))
				local cooldownFrames = math.max(1, math.floor(cooldownSeconds / self:GetSkillFrameSeconds() + 0.999))
				skills[skillId] = {
					SkillKey = skillId,
					BaseSkillKey = skillId,
					Tier = 1,
					DisplayName = self:GetDataCell(data, row, "name", skillId),
					SkillCategory = self:GetDataCell(data, row, "skill_category", ""),
					IconRUID = self:GetDataCell(data, row, "icon_ruid", ""),
					EffectIds = self:ParseDelimitedList(self:GetDataCell(data, row, "effect_ids", ""), "|"),
					TotalFrames = totalFrames,
					CooldownFrames = cooldownFrames,
					CooldownSeconds = cooldownSeconds,
					EventsByFrame = eventsByFrame
				}
			end
		end
		return skills
	end

	method void AddSkillRuntimeDefinition(any skills, string baseSkillKey, number tier, string displayName, number totalFrames, number cooldownFrames, any eventsByFrame)
		-- Registers one tier as a different executable skill definition.
		local order = self:ClampSkillTier(tier)
		local skillKey = self:GetTieredSkillKey(baseSkillKey, order)
		skills[skillKey] = {
			SkillKey = skillKey,
			BaseSkillKey = baseSkillKey,
			Tier = order,
			DisplayName = displayName,
			TotalFrames = math.max(1, math.floor(self:ReadNumber(totalFrames, 1))),
			CooldownFrames = math.max(1, math.floor(self:ReadNumber(cooldownFrames, 1))),
			EventsByFrame = eventsByFrame
		}
	end

	method any CreateSkillEventCatalog()
		-- Creates timeline events from event and context-generator DataSets.
		local events = {}
		local data = self:GetDataTable("events")
		if data == nil then
			return events
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			local eventId = self:GetDataCell(data, row, "event_id", "")
			if eventId ~= "" then
				local eventType = self:NormalizeEventType(self:GetDataCell(data, row, "event_type", ""))
				local actionIds = self:ParseDelimitedList(self:GetDataCell(data, row, "action_ids", ""), "|")
				local eventDef = {
					EventId = eventId,
					Type = eventType,
					ActionIds = actionIds
				}
				if eventType == "area" then
					self:ApplyAreaTargetData(eventDef, self:GetDataCell(data, row, "area_target_id", ""))
				end
				events[eventId] = eventDef
			end
		end
		return events
	end

	method any CreateSkillHitboxCatalog()
		-- Creates invisible target-capture hitboxes in pixel data; runtime converts to world units.
		local hitboxes = {}
		local rects = self:GetDataTable("rect_hitboxes")
		if rects ~= nil then
			local rowCount = math.max(0, math.floor(self:ReadNumber(rects:GetRowCount(), 0)))
			for row = 1, rowCount do
				local hitboxId = self:GetDataCell(rects, row, "hitbox_id", "")
				if hitboxId ~= "" then
					hitboxes[hitboxId] = {
						HitboxId = hitboxId,
						Shape = "rect",
						Rx = self:ReadNumber(self:GetDataCell(rects, row, "offset_x", "0"), 0),
						By = self:ReadNumber(self:GetDataCell(rects, row, "offset_y", "0"), 0),
						W = self:ReadNumber(self:GetDataCell(rects, row, "width", "1"), 1),
						H = self:ReadNumber(self:GetDataCell(rects, row, "height", "1"), 1)
					}
				end
			end
		end
		local circles = self:GetDataTable("circle_hitboxes")
		if circles ~= nil then
			local rowCount = math.max(0, math.floor(self:ReadNumber(circles:GetRowCount(), 0)))
			for row = 1, rowCount do
				local hitboxId = self:GetDataCell(circles, row, "hitbox_id", "")
				if hitboxId ~= "" then
					hitboxes[hitboxId] = {
						HitboxId = hitboxId,
						Shape = "circle",
						Rx = self:ReadNumber(self:GetDataCell(circles, row, "offset_x", "0"), 0),
						By = self:ReadNumber(self:GetDataCell(circles, row, "offset_y", "0"), 0),
						Radius = self:ReadNumber(self:GetDataCell(circles, row, "radius", "1"), 1)
					}
				end
			end
		end
		return hitboxes
	end

	method any CreateSkillActionCatalog()
		-- Creates executable actions consumed by skill events.
		local actions = {}
		local base = self:GetDataTable("actions")
		if base ~= nil then
			local rowCount = math.max(0, math.floor(self:ReadNumber(base:GetRowCount(), 0)))
			for row = 1, rowCount do
				local actionId = self:GetDataCell(base, row, "action_id", "")
				if actionId ~= "" then
					actions[actionId] = {
						ActionId = actionId,
						Type = self:NormalizeActionType(self:GetDataCell(base, row, "action_type", "")),
						RequiredContext = self:ParseDelimitedList(self:GetDataCell(base, row, "required_context", ""), "|")
					}
				end
			end
		end
		self:ApplyDamageActionData(actions)
		self:ApplyProjectileActionData(actions)
		self:ApplyGroundAreaActionData(actions)
		self:ApplyTriggerActionData(actions)
		self:ApplyDashActionData(actions)
		self:ApplyTeleportActionData(actions)
		self:ApplyBuffActionData(actions)
		self:ApplyDebuffActionData(actions)
		return actions
	end

	method any CreateSkillEffectCatalog()
		-- Loads effect metadata by effect id.
		local effects = {}
		local data = self:GetDataTable("effects")
		if data == nil then
			return effects
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			local effectId = self:GetDataCell(data, row, "effect_id", "")
			if effectId ~= "" then
				effects[effectId] = {
					EffectId = effectId,
					RUID = self:GetDataCell(data, row, "effect_ruid", ""),
					Loop = self:ReadDataBoolean(data, row, "is_loop", false),
					TotalFrames = math.max(1, math.floor(self:ReadNumber(self:GetDataCell(data, row, "total_length_frames", "1"), 1)))
				}
			end
		end
		return effects
	end

	method any CreateSkillRestrictionCatalog()
		-- Loads per-skill movement restriction windows.
		local restrictions = {}
		local data = self:GetDataTable("skill_action_restrictions")
		if data == nil then
			return restrictions
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			local skillId = self:GetDataCell(data, row, "skill_id", "")
			if skillId ~= "" then
				restrictions[skillId] = {
					SkillId = skillId,
					StartFrame = math.floor(self:ReadNumber(self:GetDataCell(data, row, "start_frame", "0"), 0)),
					EndFrame = math.floor(self:ReadNumber(self:GetDataCell(data, row, "end_frame", "0"), 0)),
					MoveSpeedRate = math.max(0, math.min(1, self:ReadNumber(self:GetDataCell(data, row, "caster_move_speed_reduction_rate", "1"), 1)))
				}
			end
		end
		return restrictions
	end

	method any CreateCharacterDefaults()
		-- Loads character defaults used by skill formulas.
		local defaults = {
			Hp = 10000,
			AttackPower = math.max(1, self:ReadNumber(self.DefaultSkillAttackPower, 300)),
			BasicSkillId = ""
		}
		local data = self:GetDataTable("characters")
		if data ~= nil and self:ReadNumber(data:GetRowCount(), 0) > 0 then
			defaults.Hp = math.max(1, self:ReadNumber(self:GetDataCell(data, 1, "hp", tostring(defaults.Hp)), defaults.Hp))
			defaults.AttackPower = math.max(1, self:ReadNumber(self:GetDataCell(data, 1, "attack_power", tostring(defaults.AttackPower)), defaults.AttackPower))
			defaults.BasicSkillId = self:GetDataCell(data, 1, "basic_skill_id", "")
		end
		if defaults.BasicSkillId == "" then
			defaults.BasicSkillId = self:FindFirstSkillIdByCategory("기본 스킬")
		end
		if defaults.BasicSkillId == "" then
			defaults.BasicSkillId = self:FindFirstAnySkillId()
		end
		return defaults
	end

	method any GetDataTable(string tableName)
		-- Reads a UserDataSet by table name. Missing datasets are allowed during authoring.
		local safeName = self:ReadString(tableName, "")
		if safeName == "" then
			return nil
		end
		return _DataService:GetTable(safeName)
	end

	method string GetDataCell(any dataSet, number row, string columnName, string fallback)
		-- Reads one DataSet cell as a trimmed string.
		if dataSet == nil then
			return self:ReadString(fallback, "")
		end
		local value = dataSet:GetCell(math.max(1, math.floor(self:ReadNumber(row, 1))), self:ReadString(columnName, ""))
		if value == nil then
			return self:ReadString(fallback, "")
		end
		return self:TrimString(tostring(value))
	end

	method boolean ReadDataBoolean(any dataSet, number row, string columnName, boolean fallback)
		-- Reads common CSV boolean spellings.
		local value = string.lower(self:GetDataCell(dataSet, row, columnName, ""))
		if value == "true" or value == "1" or value == "yes" or value == "y" then
			return true
		end
		if value == "false" or value == "0" or value == "no" or value == "n" then
			return false
		end
		return fallback == true
	end

	method any ParseDelimitedList(string value, string delimiter)
		-- Parses pipe/semicolon-delimited ids while keeping Korean ids intact.
		local result = {}
		local safeValue = self:ReadString(value, "")
		local safeDelimiter = self:ReadString(delimiter, "|")
		if safeValue == "" then
			return result
		end
		local startIndex = 1
		while startIndex <= string.len(safeValue) do
			local remaining = string.sub(safeValue, startIndex)
			local relativeDelimiterIndex, relativeDelimiterEndIndex = string.find(remaining, safeDelimiter)
			local delimiterIndex = nil
			if relativeDelimiterIndex ~= nil then
				delimiterIndex = startIndex + relativeDelimiterIndex - 1
			end
			local token = ""
			if delimiterIndex == nil then
				token = string.sub(safeValue, startIndex)
				startIndex = string.len(safeValue) + 1
			else
				token = string.sub(safeValue, startIndex, delimiterIndex - 1)
				startIndex = delimiterIndex + string.len(safeDelimiter)
			end
			token = self:TrimString(token)
			if token ~= "" then
				table.insert(result, token)
			end
		end
		return result
	end

	method any ParseFrameEventMap(string value)
		-- Parses "4:eventA|eventB;8:eventC" into a frame-indexed event map.
		local result = {}
		local segments = self:ParseDelimitedList(value, ";")
		for index, segment in ipairs(segments) do
			local colonIndex, colonEndIndex = string.find(segment, ":")
			if colonIndex ~= nil then
				local frameText = self:TrimString(string.sub(segment, 1, colonIndex - 1))
				local eventText = self:TrimString(string.sub(segment, colonIndex + 1))
				local frame = math.max(0, math.floor(self:ReadNumber(frameText, 0)))
				local eventIds = self:ParseDelimitedList(eventText, "|")
				if #eventIds > 0 then
					result[frame] = eventIds
				end
			end
		end
		return result
	end

	method number InferTotalFramesFromEvents(any eventsByFrame)
		-- Ensures total_length_frames covers the last frame event.
		local maxFrame = 1
		if eventsByFrame ~= nil then
			for frame, eventIds in pairs(eventsByFrame) do
				local safeFrame = math.floor(self:ReadNumber(frame, 0))
				if eventIds ~= nil and safeFrame + 1 > maxFrame then
					maxFrame = safeFrame + 1
				end
			end
		end
		return maxFrame
	end

	method number PixelsToWorld(string value, number fallbackPixels)
		-- Converts planned pixel data into MSW world units (100 px = 1 world unit).
		return self:ReadNumber(value, fallbackPixels) / 100
	end

	method boolean IsSkillPartCategory(string category)
		-- Only skill-chain parts are rollable parts; basic skills are direct casts.
		local safeCategory = self:ReadString(category, "")
		if safeCategory == "" then
			return true
		end
		return safeCategory ~= "기본 스킬"
	end

	method string NormalizeEventType(string eventType)
		local safeType = self:ReadString(eventType, "")
		if safeType == "area" or safeType == "area_target" then
			return "area"
		end
		if safeType == "projectile" or safeType == "projectile_spawn" then
			return "projectile"
		end
		if safeType == "field" or safeType == "ground_area" or safeType == "ground_area_spawn" then
			return "field"
		end
		if safeType == "action" or safeType == "action_execute" then
			return "action"
		end
		if safeType == "범위 대상포착" or safeType == "범위 내 대상 포착" or string.find(safeType, "범위") ~= nil then
			return "area"
		end
		if safeType == "투사체" or safeType == "투사체 생성" then
			return "projectile"
		end
		if safeType == "장판" or safeType == "장판 생성" then
			return "field"
		end
		return "action"
	end

	method string NormalizeActionType(string actionType)
		local safeType = self:ReadString(actionType, "")
		if safeType == "damage" then
			return "damage"
		end
		if safeType == "buff" then
			return "buff"
		end
		if safeType == "debuff" then
			return "debuff"
		end
		if safeType == "trigger" then
			return "trigger"
		end
		if safeType == "move" or safeType == "dash" or safeType == "teleport" then
			return "move"
		end
		if safeType == "projectile" or safeType == "projectile_spawn" then
			return "projectile"
		end
		if safeType == "field" or safeType == "ground_area" or safeType == "ground_area_spawn" then
			return "field"
		end
		if safeType == "aftereffect" or safeType == "after_effect" then
			return "aftereffect"
		end
		if safeType == "피해" then
			return "damage"
		end
		if safeType == "버프" then
			return "buff"
		end
		if safeType == "디버프" then
			return "debuff"
		end
		if safeType == "트리거" then
			return "trigger"
		end
		if safeType == "이동" then
			return "move"
		end
		if safeType == "투사체 생성" then
			return "projectile"
		end
		if safeType == "장판 생성" then
			return "field"
		end
		if safeType == "후속효과" then
			return "aftereffect"
		end
		return "aftereffect"
	end

	method string BuildShortKey(string skillId, string displayName)
		-- Keeps UI labels stable without hardcoded English skill names.
		local source = self:ReadString(displayName, "")
		if source == "" then
			source = self:ReadString(skillId, "")
		end
		if string.len(source) <= 2 then
			return source
		end
		return string.sub(source, 1, 2)
	end

	method number GetTableCount(any tableValue)
		local count = 0
		if tableValue ~= nil then
			for key, value in pairs(tableValue) do
				count = count + 1
			end
		end
		return count
	end

	method string FindFirstSkillIdByCategory(string category)
		local data = self:GetDataTable("skills")
		if data == nil then
			return ""
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			if self:GetDataCell(data, row, "skill_category", "") == category then
				return self:GetDataCell(data, row, "id", "")
			end
		end
		return ""
	end

	method string FindFirstAnySkillId()
		local data = self:GetDataTable("skills")
		if data == nil or self:ReadNumber(data:GetRowCount(), 0) <= 0 then
			return ""
		end
		return self:GetDataCell(data, 1, "id", "")
	end

	method void ApplyAreaTargetData(any eventDef, string areaTargetId)
		local safeAreaId = self:ReadString(areaTargetId, "")
		if eventDef == nil or safeAreaId == "" then
			return
		end
		local data = self:GetDataTable("area_target_captures")
		if data == nil then
			return
		end
		local row = data:FindRow("area_target_id", safeAreaId)
		if row == nil then
			return
		end
		local rowIndex = self:GetDataRowIndex(data, "area_target_id", safeAreaId)
		if rowIndex <= 0 then
			return
		end
		eventDef.AreaTargetId = safeAreaId
		eventDef.DurationFrames = math.max(1, math.floor(self:ReadNumber(self:GetDataCell(data, rowIndex, "duration_frames", "1"), 1)))
		eventDef.HitboxIds = self:ParseDelimitedList(self:GetDataCell(data, rowIndex, "hitbox_ids", ""), "|")
		eventDef.ActionIds = self:ParseDelimitedList(self:GetDataCell(data, rowIndex, "action_ids", ""), "|")
		eventDef.TargetGroup = self:GetDataCell(data, rowIndex, "target", "")
		eventDef.MaxTargets = math.max(0, math.floor(self:ReadNumber(self:GetDataCell(data, rowIndex, "max_targets", "0"), 0)))
	end

	method number GetDataRowIndex(any dataSet, string columnName, string value)
		if dataSet == nil then
			return 0
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(dataSet:GetRowCount(), 0)))
		local safeValue = self:ReadString(value, "")
		for row = 1, rowCount do
			if self:GetDataCell(dataSet, row, columnName, "") == safeValue then
				return row
			end
		end
		return 0
	end

	method void ApplyDamageActionData(any actions)
		local data = self:GetDataTable("damage_actions")
		if data == nil then
			return
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			local actionId = self:GetDataCell(data, row, "action_id", "")
			local actionDef = actions[actionId]
			if actionDef ~= nil then
				actionDef.Type = "damage"
				actionDef.Coefficient = math.max(0, self:ReadNumber(self:GetDataCell(data, row, "attack_power_coefficient_percent", "100"), 100))
				actionDef.HitEffectRUID = self:GetDataCell(data, row, "hit_effect_ruid", "")
			end
		end
	end

	method void ApplyProjectileActionData(any actions)
		local data = self:GetDataTable("projectile_spawn_actions")
		if data == nil then
			return
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			local actionId = self:GetDataCell(data, row, "id", "")
			local actionDef = actions[actionId]
			if actionDef ~= nil then
				actionDef.Type = "projectile"
				actionDef.ProjectileSpriteRUID = self:GetDataCell(data, row, "projectile_sprite_ruid", "")
				actionDef.ProjectileEffectRUID = actionDef.ProjectileSpriteRUID
				actionDef.Range = self:PixelsToWorld(self:GetDataCell(data, row, "projectile_range", "500"), 500)
				actionDef.Speed = self:PixelsToWorld(self:GetDataCell(data, row, "projectile_speed", "600"), 600)
				actionDef.FrontDirection = self:ReadDataBoolean(data, row, "projectile_front_direction", true)
				actionDef.HitboxIds = self:ParseDelimitedList(self:GetDataCell(data, row, "projectile_hitbox_id", ""), "|")
				actionDef.Pierce = math.max(0, math.floor(self:ReadNumber(self:GetDataCell(data, row, "projectile_pierce", "0"), 0)))
				actionDef.CollisionEventIds = self:ParseDelimitedList(self:GetDataCell(data, row, "collision_event_ids", ""), "|")
				actionDef.ExpireEventIds = self:ParseDelimitedList(self:GetDataCell(data, row, "expire_event_ids", ""), "|")
			end
		end
	end

	method void ApplyGroundAreaActionData(any actions)
		local data = self:GetDataTable("ground_area_spawn_actions")
		if data == nil then
			return
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			local actionId = self:GetDataCell(data, row, "action_id", "")
			local actionDef = actions[actionId]
			if actionDef ~= nil then
				actionDef.Type = "field"
	actionDef.DurationFrames = math.max(1, math.floor(self:ReadNumber(self:GetDataCell(data, row, "duration_frames", "1"), 1)))
				actionDef.TickIntervalFrames = math.max(1, math.floor(self:ReadNumber(self:GetDataCell(data, row, "tick_interval_frames", "1"), 1)))
				actionDef.ActionIds = self:ParseDelimitedList(self:GetDataCell(data, row, "ground_area_event_ids", ""), "|")
				actionDef.FieldEffectId = self:GetDataCell(data, row, "ground_area_effect_id", "")
				actionDef.HitboxIds = self:ParseDelimitedList(self:GetDataCell(data, row, "hitbox_ids", ""), "|")
				actionDef.TargetGroup = self:GetDataCell(data, row, "target", "")
				actionDef.MaxTargets = math.max(0, math.floor(self:ReadNumber(self:GetDataCell(data, row, "max_targets", "0"), 0)))
			end
		end
	end

	method void ApplyTriggerActionData(any actions)
