@Logic
script BRSkillUIDatabase extends Logic

	property string PlaceholderIconRUID = "4fea64a3307cda641809ad8be0d4890b"

	property boolean VerboseLog = false

	method string GetSlotIconRUID(string skillKey, number tier, boolean isLeadSlot)
		local order = self:ClampTier(tier)
		local resolvedSkillKey = self:ReadString(skillKey, "Default")
		if isLeadSlot == true and order > 1 then
			resolvedSkillKey = self:ResolveSkillKeyForTier(resolvedSkillKey, order)
		end

		local data = self:GetIconData(resolvedSkillKey)
		if data == nil and resolvedSkillKey ~= skillKey then
			data = self:GetIconData(skillKey)
		end
		if data == nil then
			data = self:GetIconData("Default")
		end
		if data == nil then
			return self:ReadString(self.PlaceholderIconRUID, "")
		end

		if isLeadSlot == true and order > 1 and data.LeadByTier ~= nil then
			local leadRuid = self:ReadString(data.LeadByTier[order], "")
			if leadRuid ~= "" then
				return leadRuid
			end
		end
		if data.ByTier ~= nil then
			local tierRuid = self:ReadString(data.ByTier[order], "")
			if tierRuid ~= "" then
				return tierRuid
			end
		end
		return self:ReadString(data.IconRUID, self.PlaceholderIconRUID)
	end

	method Color GetSlotBaseColor(boolean occupied, number tier, boolean equipped)
		-- Returns a stable square background tint; tier emphasis is carried by the frame.
		if occupied ~= true then
			return Color(0.055, 0.07, 0.1, 0.72)
		end
		if equipped == true then
			return Color(0.09, 0.16, 0.14, 0.92)
		end
		return Color(0.08, 0.12, 0.18, 0.94)
	end

	method Color GetSlotBorderColor(number tier, boolean occupied, boolean isLeadSlot)
		-- Returns the visible tier frame color around one skill slot.
		if occupied ~= true then
			return Color(0.28, 0.34, 0.43, 0.42)
		end
		local order = self:ClampTier(tier)
		if order >= 4 then
			return Color(0.94, 0.3, 1.0, 1.0)
		elseif order == 3 then
			return Color(1.0, 0.36, 0.12, 1.0)
		elseif order == 2 then
			return Color(1.0, 0.82, 0.22, 1.0)
		elseif isLeadSlot == true then
			return Color(0.42, 0.84, 1.0, 0.98)
		end
		return Color(0.34, 0.48, 0.68, 0.82)
	end

	method Color GetIconColor(number tier, boolean occupied)
		-- Keeps icon tint neutral so chain emphasis reads through the frame.
		if occupied ~= true then
			return Color(1, 1, 1, 0)
		end
		return Color(1, 1, 1, 0.96)
	end

	method any GetIconData(string skillKey)
		-- Looks up icon data by CSV skill id.
		local catalog = self:GetIconCatalog()
		local key = self:ReadString(skillKey, "Default")
		if catalog[key] ~= nil then
			return catalog[key]
		end
		return catalog[self:GetBaseSkillKey(key)]
	end

	method any GetSkillDisplayData(string skillKey, number tier)
		-- Returns Maple-style tooltip display data for one skill tier.
		local catalog = self:GetSkillDisplayCatalog()
		local order = self:ClampTier(tier)
		local resolvedKey = self:ResolveSkillKeyForTier(skillKey, order)
		local data = catalog[resolvedKey]
		if data == nil then
			data = catalog[self:GetBaseSkillKey(skillKey)]
		end
		if data == nil then
			data = catalog[self:ReadString(skillKey, "Default")]
		end
		if data == nil then
			data = catalog.Default
		end
		if data == nil then
			data = {
				SkillKey = "Default",
				Name = "Skill",
				Description = "",
				Category = "",
				IconRUID = self:ReadString(self.PlaceholderIconRUID, ""),
				Tier = order
			}
		end
		return {
			SkillKey = self:ReadString(data.SkillKey, resolvedKey),
			Name = self:ReadString(data.Name, "Skill"),
			Description = self:ReadString(data.Description, ""),
			Category = self:ReadString(data.Category, ""),
			IconRUID = self:ReadString(data.IconRUID, self.PlaceholderIconRUID),
			Tier = order
		}
	end

	method string ResolveSkillKeyForTier(string skillKey, number tier)
		-- Maps a base skill key and visible tier to the CSV row that describes that tier.
		local catalog = self:GetSkillDisplayCatalog()
		local key = self:ReadString(skillKey, "Default")
		local order = self:ClampTier(tier)
		local baseKey = self:GetBaseSkillKey(key)
		if order <= 1 then
			if catalog[baseKey] ~= nil then
				return baseKey
			end
			return key
		end
		local tieredKey = baseKey .. tostring(order)
		if catalog[tieredKey] ~= nil then
			return tieredKey
		end
		if catalog[key] ~= nil then
			return key
		end
		return baseKey
	end

	method any GetSkillDisplayCatalog()
		-- Caches the CSV fields needed by skill icon tooltips.
		if self._T.skillDisplayCatalog == nil then
			self._T.skillDisplayCatalog = {
				Default = {
					SkillKey = "Default",
					Name = "Skill",
					Description = "",
					Category = "",
					IconRUID = self:ReadString(self.PlaceholderIconRUID, "")
				}
			}
			local skills = self:GetDataTable("skills")
			if skills ~= nil then
				local rowCount = math.max(0, math.floor(self:ReadNumber(skills:GetRowCount(), 0)))
				for row = 1, rowCount do
					local skillId = self:GetDataCell(skills, row, "id", "")
					if skillId ~= "" then
						local iconRuid = self:GetDataCell(skills, row, "icon_ruid", "")
						if iconRuid == "" then
							iconRuid = self:GetFirstEffectRUID(self:GetDataCell(skills, row, "effect_ids", ""))
						end
						if iconRuid == "" then
							iconRuid = self:ReadString(self.PlaceholderIconRUID, "")
						end
						self._T.skillDisplayCatalog[skillId] = {
							SkillKey = skillId,
							Name = self:GetDataCell(skills, row, "name", skillId),
							Description = self:GetDataCell(skills, row, "description", ""),
							Category = self:GetDataCell(skills, row, "skill_category", ""),
							IconRUID = iconRuid
						}
					end
				end
			end
			self:Log("tooltip display db ready")
		end
		return self._T.skillDisplayCatalog
	end

	method any GetIconCatalog()
		-- Creates icon data from skills/effects DataSets.
		if self._T.iconCatalog == nil then
			self._T.iconCatalog = { Default = { IconRUID = self.PlaceholderIconRUID } }
			local skills = self:GetDataTable("skills")
			if skills ~= nil then
				local rowCount = math.max(0, math.floor(self:ReadNumber(skills:GetRowCount(), 0)))
				for row = 1, rowCount do
					local skillId = self:GetDataCell(skills, row, "id", "")
					if skillId ~= "" then
						local iconRuid = self:GetDataCell(skills, row, "icon_ruid", "")
						if iconRuid == "" then
							iconRuid = self:GetFirstEffectRUID(self:GetDataCell(skills, row, "effect_ids", ""))
						end
						if iconRuid == "" then
							iconRuid = self:ReadString(self.PlaceholderIconRUID, "")
						end
						self._T.iconCatalog[skillId] = {
							IconRUID = iconRuid,
							ByTier = { [1] = iconRuid, [2] = iconRuid, [3] = iconRuid, [4] = iconRuid },
							LeadByTier = { [2] = iconRuid, [3] = iconRuid, [4] = iconRuid }
						}
					end
				end
			end
			self:Log("icon db ready")
		end
		return self._T.iconCatalog
	end

	method any GetDataTable(string tableName)
		local safeName = self:ReadString(tableName, "")
		if safeName == "" then
			return nil
		end
		return _DataService:GetTable(safeName)
	end

	method string GetDataCell(any dataSet, number row, string columnName, string fallback)
		if dataSet == nil then
			return self:ReadString(fallback, "")
		end
		local value = dataSet:GetCell(math.max(1, math.floor(self:ReadNumber(row, 1))), self:ReadString(columnName, ""))
		if value == nil then
			return self:ReadString(fallback, "")
		end
		return self:TrimString(tostring(value))
	end

	method string GetFirstEffectRUID(string effectIds)
		local ids = self:ParseDelimitedList(effectIds, "|")
		local effects = self:GetDataTable("effects")
		if effects == nil then
			return ""
		end
		for index, effectId in ipairs(ids) do
			local row = self:GetDataRowIndex(effects, "effect_id", effectId)
			if row > 0 then
				local ruid = self:GetDataCell(effects, row, "effect_ruid", "")
				if ruid ~= "" then
					return ruid
				end
			end
		end
		return ""
	end

	method number GetDataRowIndex(any dataSet, string columnName, string value)
		if dataSet == nil then
			return 0
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(dataSet:GetRowCount(), 0)))
		local safeValue = self:ReadString(value, "")
		for row = 1, rowCount do
			if self:GetDataCell(dataSet, row, columnName, "") == safeValue then
				return row
			end
		end
		return 0
	end

	method any ParseDelimitedList(string value, string delimiter)
		local result = {}
		local safeValue = self:ReadString(value, "")
		local safeDelimiter = self:ReadString(delimiter, "|")
		if safeValue == "" then
			return result
		end
		local startIndex = 1
		while startIndex <= string.len(safeValue) do
			local remaining = string.sub(safeValue, startIndex)
			local relativeDelimiterIndex, relativeDelimiterEndIndex = string.find(remaining, safeDelimiter)
			local delimiterIndex = nil
			if relativeDelimiterIndex ~= nil then
				delimiterIndex = startIndex + relativeDelimiterIndex - 1
			end
			local token = ""
			if delimiterIndex == nil then
				token = string.sub(safeValue, startIndex)
				startIndex = string.len(safeValue) + 1
			else
				token = string.sub(safeValue, startIndex, delimiterIndex - 1)
				startIndex = delimiterIndex + string.len(safeDelimiter)
			end
			token = self:TrimString(token)
			if token ~= "" then
				table.insert(result, token)
			end
		end
		return result
	end

	method string TrimString(string value)
		local safeValue = self:ReadString(value, "")
		return string.match(safeValue, "^%s*(.-)%s*$")
	end

	method string GetBaseSkillKey(string skillKey)
		-- Normalizes tiered runtime keys back to their base catalog key.
		local key = self:ReadString(skillKey, "Default")
		key = self:ReadString(string.match(key, "^(.-)%d*$"), key)
		if key == "" or key == "-" then
			return "Default"
		end
		return key
	end

	method number ClampTier(number tier)
		-- Clamps visible skill order.
		local order = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		return math.min(order, 4)
	end

	method string ReadString(any value, string fallback)
		-- Reads a string-like value with fallback.
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		-- Reads a numeric value with fallback.
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		-- Writes icon-db logs when enabled.
		if self.VerboseLog == true then
			log("[BRSkillUIDB] " .. message)
		end
	end

end
