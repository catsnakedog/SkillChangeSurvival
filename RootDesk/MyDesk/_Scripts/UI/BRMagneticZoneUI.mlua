@Component
script BRMagneticZoneUI extends Component

	property Entity panel = "c69a1e1b-2358-4d12-8522-500391a8ecda"

	property SpriteGUIRendererComponent phaseNumber = "e8a00312-4615-454e-9267-bf7655748f85"

	property SpriteGUIRendererComponent secTens = "3e501112-3d70-4df2-8ba1-9453af3c16a9"

	property SpriteGUIRendererComponent secOnes = "e7a33703-cb12-42ac-944b-666f8509d1c5"

	property Entity forbiddenOverlay = "cf69a1bb-214c-4244-adb6-c703e6ddebf3"

	property SpriteGUIRendererComponent forbiddenOverlayImage = "cf69a1bb-214c-4244-adb6-c703e6ddebf3"

	property Entity forbiddenBombRoot = "8141b2df-95d1-488b-9706-3766fd6269b8"

	property SpriteGUIRendererComponent forbiddenBombImage = "8141b2df-95d1-488b-9706-3766fd6269b8"

	property TextComponent forbiddenBombText = "dd8033a5-a97c-4596-aae1-03dab17d5004"

	property string ForbiddenScreenEffectRUID = "a49a9d7f7e7b461db9f0ee38e5f1f5cc"

	property string ForbiddenBombRUID = "fc4584eed6094384a0b3e5580bef7264"

	property number ForbiddenBombWorldOffsetY = 1.45

	property number RefreshSeconds = 0.1

	property boolean VerboseLog = true

	property number refreshTimerId = 0

	property boolean lastVisible = false

	property integer lastPhase = 0

	property integer lastSec = -1

	property integer lastForbiddenSec = -1

	property boolean lastForbiddenActive = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Starts the local phase-timer HUD refresh loop.
		self._T.timeDigits = self:BuildTimeDigitRuidTable()
		self._T.phaseNumbers = self:BuildPhaseNumberRuidTable()
		self:SetRootRaycastBlocked(false)
		self:ApplyForbiddenEffectRUIDs()
		self:SetPanelActive(false)
		self:SetForbiddenFeedbackActive(false)
		self.lastPhase = 0
		self.lastSec = -1
		self.lastForbiddenSec = -1
		self.refreshTimerId = _TimerService:SetTimerRepeat(function() self:Refresh() end, self:GetRefreshSeconds())
		self:Log("ready")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Clears the local phase-timer HUD refresh loop.
		if self.refreshTimerId ~= nil and self.refreshTimerId > 0 then
			_TimerService:ClearTimer(self.refreshTimerId)
		end
		self.refreshTimerId = 0
		self:SetForbiddenFeedbackActive(false)
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- Updates the phase whole-number and two-digit seconds from synchronized state.
		local visible = self:ShouldShow()
		self:SetPanelActive(visible)
		self:RefreshForbiddenFeedback(visible)
		if visible ~= true then
			return
		end

		self:ApplyPhase()
		self:ApplySeconds()
	end

	method table BuildTimeDigitRuidTable()
		-- 0~9 seconds digit sprite RUIDs (maple secret-vault timer numbers).
		return {
			[0] = "404804a4f462458e9ebb30475e8c4f18",
			[1] = "503223f2741d45edba6f752d373881ca",
			[2] = "190a70eb00e941248fc815536f186058",
			[3] = "5a2a31f2fe4348d2908a2599430f5f7b",
			[4] = "721481c17ae84c7389cd9dc1ac826d9d",
			[5] = "bcce0a1a96974bb2acc49720c5077387",
			[6] = "ad7abc9214a547c8b3b75cdf102b61c3",
			[7] = "68a07ce4e3df46719c5c8f06518f77d8",
			[8] = "1091ca4ddf384d6799899c31fa3632c7",
			[9] = "3dc79b51e05f4359874ac8bbef083632",
		}
	end

	method table BuildPhaseNumberRuidTable()
		-- Phase whole-number sprites from animationclip-1091968 (frames = numbers 1~12).
		-- Phase N -> frame index N-1. Only phases 1~9 are used in this game.
		return {
			[1] = "1e00a3a798d142e89dd89367339eb966",
			[2] = "41665d3e5a17402f945f3ddb10a6e349",
			[3] = "702c35ede00e49738c03f24c7eff888f",
			[4] = "37ead2abdc1343be9cbc98958c65593f",
			[5] = "7aae391f60c949bb83c153548252ff5b",
			[6] = "adfbfca1cf304fb79135deaa5e41fa2b",
			[7] = "dae13cdce6f0428d887e7548ca86081b",
			[8] = "d5998a5cee0e4e0b88cb84a2007c99ce",
			[9] = "40ca61bd99dd433585a051fd14f0dae6",
		}
	end

	method void ApplyPhase()
		-- Renders the current phase whole-number sprite (1~9), only on change.
		if self.phaseNumber == nil then
			return
		end
		local p = math.floor(self:ReadNumber(_BRMagneticZoneSystem.PhaseNumber, 1))
		if p < 1 then
			p = 1
		end
		if p > 9 then
			p = 9
		end
		if p == self.lastPhase then
			return
		end
		self.lastPhase = p
		local ruid = self._T.phaseNumbers[p]
		if ruid ~= nil and ruid ~= "" then
			self.phaseNumber.ImageRUID = ruid
			self:Log("phase=" .. tostring(p))
		end
	end

	method void ApplySeconds()
		-- Renders remaining phase seconds as two digits (tens/ones), only on change.
		local sec = math.ceil(math.max(0, self:ReadNumber(_BRMagneticZoneSystem.PhaseTimeRemaining, 0)))
		if sec > 99 then
			sec = 99
		end
		if sec == self.lastSec then
			return
		end
		self.lastSec = sec
		local tens = math.floor(sec / 10)
		local ones = sec % 10
		if self.secTens ~= nil and self._T.timeDigits[tens] ~= nil then
			self.secTens.ImageRUID = self._T.timeDigits[tens]
		end
		if self.secOnes ~= nil and self._T.timeDigits[ones] ~= nil then
			self.secOnes.ImageRUID = self._T.timeDigits[ones]
		end
	end

	method void ApplyForbiddenEffectRUIDs()
		-- Restores the configured forbidden-zone animationclip RUIDs on the UI renderers.
		if self.forbiddenOverlayImage ~= nil then
			self.forbiddenOverlayImage.ImageRUID = self:ReadString(self.ForbiddenScreenEffectRUID, "a49a9d7f7e7b461db9f0ee38e5f1f5cc")
		end
		if self.forbiddenBombImage ~= nil then
			self.forbiddenBombImage.ImageRUID = self:ReadString(self.ForbiddenBombRUID, "fc4584eed6094384a0b3e5580bef7264")
		end
	end

	method void RefreshForbiddenFeedback(boolean zoneVisible)
		-- Updates the local forbidden-zone screen effect and overhead countdown.
		local active = zoneVisible == true and self:IsForbiddenFeedbackActive() == true
		self:SetForbiddenFeedbackActive(active)
		if active ~= true then
			self.lastForbiddenSec = -1
			return
		end

		self:ApplyForbiddenSeconds()
		self:UpdateForbiddenBombPosition()
	end

	method boolean IsForbiddenFeedbackActive()
		-- Checks whether the local player is currently spending forbidden-zone time.
		if _BRMagneticZoneSystem == nil then
			return false
		end
		if _BRMagneticZoneSystem.ZoneRunning ~= true then
			return false
		end
		return _BRMagneticZoneSystem.ClientInsideForbidden == true
	end

	method void SetForbiddenFeedbackActive(boolean active)
		-- Toggles the full-screen effect and Lucid-bomb countdown together.
		if self.forbiddenOverlay ~= nil then
			self.forbiddenOverlay.Enable = active
		end
		if self.forbiddenBombRoot ~= nil then
			self.forbiddenBombRoot.Enable = active
		end
		if active ~= self.lastForbiddenActive then
			self.lastForbiddenActive = active
			self:Log("forbiddenFeedback=" .. tostring(active))
		end
	end

	method void ApplyForbiddenSeconds()
		-- Writes the remaining forbidden-zone seconds inside the bomb marker.
		if self.forbiddenBombText == nil then
			return
		end
		local sec = math.ceil(math.max(0, self:ReadNumber(_BRMagneticZoneSystem.ClientForbiddenRemaining, 0)))
		if sec > 99 then
			sec = 99
		end
		if sec == self.lastForbiddenSec then
			return
		end

		self.lastForbiddenSec = sec
		self.forbiddenBombText.Text = tostring(sec)
		if sec <= 5 then
			self.forbiddenBombText.FontColor = Color(1, 0.25, 0.25, 1)
		elseif sec <= 10 then
			self.forbiddenBombText.FontColor = Color(1, 0.88, 0.22, 1)
		else
			self.forbiddenBombText.FontColor = Color(1, 1, 1, 1)
		end
		self:Log("forbiddenRemaining=" .. tostring(sec))
	end

	method void UpdateForbiddenBombPosition()
		-- Places the bomb marker above the local player's head in screen UI space.
		if self.forbiddenBombRoot == nil or self.forbiddenBombRoot.UITransformComponent == nil then
			return
		end
		if _UILogic == nil then
			return
		end
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.TransformComponent == nil then
			return
		end

		local worldPosition = localPlayer.TransformComponent.WorldPosition
		local offsetY = self:GetForbiddenBombWorldOffsetY()
		local screenPoint = _UILogic:WorldToScreenPosition(Vector2(worldPosition.x, worldPosition.y + offsetY))
		local uiPosition = _UILogic:ScreenToUIPosition(screenPoint)
		self.forbiddenBombRoot.UITransformComponent.anchoredPosition = uiPosition
	end

	method boolean ShouldShow()
		-- Checks whether the phase-timer HUD should be visible for the local player.
		if _BRMagneticZoneSystem == nil then
			return false
		end
		if _BRMagneticZoneSystem.ZoneRunning ~= true then
			return false
		end

		local zoneMapName = self:ReadString(_BRMagneticZoneSystem.ZoneMapName, "")
		if zoneMapName == "" then
			return true
		end

		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return false
		end
		return self:ReadString(localPlayer.CurrentMapName, "") == zoneMapName
	end

	method void SetPanelActive(boolean visible)
		-- Toggles the phase-timer HUD panel tree.
		if self.panel == nil then
			return
		end
		self.panel.Enable = visible
		if visible ~= self.lastVisible then
			self.lastVisible = visible
			self:Log("visible=" .. tostring(visible))
		end
	end

	method void SetRootRaycastBlocked(boolean blocked)
		-- Keeps this display-only HUD from swallowing skill-chain input.
		local root = _EntityService:GetEntityByPath("/ui/MagneticZoneGroup")
		if root ~= nil and root.CanvasGroupComponent ~= nil then
			root.CanvasGroupComponent.BlocksRaycasts = blocked == true
			root.CanvasGroupComponent.Interactable = blocked == true
		end
	end

	method number GetRefreshSeconds()
		-- Returns the UI refresh interval.
		return math.max(0.05, self:ReadNumber(self.RefreshSeconds, 0.1))
	end

	method number GetForbiddenBombWorldOffsetY()
		-- Returns the world-space vertical offset used for the overhead bomb marker.
		return math.max(0.5, self:ReadNumber(self.ForbiddenBombWorldOffsetY, 1.45))
	end

	method string ReadString(any value, string fallback)
		-- Reads a string-like value with fallback.
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		-- Reads a numeric value with fallback.
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		-- Writes a phase-timer UI log when verbose logging is enabled.
		if self.VerboseLog == true then
			log("[BRMagneticZoneUI] " .. self:ReadString(message, ""))
		end
	end

end
