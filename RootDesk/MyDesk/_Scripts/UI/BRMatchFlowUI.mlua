@Component
script BRMatchFlowUI extends Component

	property string RootPath = "/ui/BRMatchFlowGroup"

	property number refreshTimerId = 0

	property number loadingEndAt = 0

	property number loadingAutoHideAt = 0

	property number effectTimerId = 0

	property string LucidWalkRUID = "2035089d2e614442b3234143b30dced6"

	property number LucidBaseX = -150

	property number LucidBaseY = 118

	property number LucidTravelPixels = 170

	property number LucidWalkCycleSeconds = 2.4

	property number CenterEffectBaseWidth = 760

	property number CenterEffectBaseHeight = 300

	property number CenterCountdownBaseWidth = 420

	property number CenterCountdownBaseHeight = 420

	property number CenterStartBaseWidth = 760

	property number CenterStartBaseHeight = 300

	property any closeHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Initializes modal panels as hidden and non-blocking.
		self:HideLoading("")
		self:HideStartSequence()
		self:HideResult()
		self:ConnectButtons()
		self.refreshTimerId = _TimerService:SetTimerRepeat(function() self:RefreshLoadingCountdown() end, 1 / 60, 0.1)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Clears timers and event handlers owned by the match-flow UI.
		if self.refreshTimerId ~= nil and self.refreshTimerId > 0 then
			_TimerService:ClearTimer(self.refreshTimerId)
		end
		self.refreshTimerId = 0
		self:ClearEffectTimer()
		self:DisconnectButtons()
	end

	@ExecSpace("Client")
	method void ShowLoading(string message, number seconds, number curtainHoldSeconds)
		-- Opens a full-screen loading curtain.
		self:SetEntityActive("Loading", true)
		self:SetEntityActive("Loading/LucidWalker", true)
		self:SetEntityActive("StartSequence", false)
		self:SetEntityActive("Result", false)
		self:SetRootRaycastBlocked(true)
		self:SetTextByPath("Loading/Message", self:ReadString(message, "MATCH LOADING..."))
		self:SetTextByPath("Loading/Sub", "Loading battle arena")
		self:SetTextByPath("Loading/Countdown", "")
		self:SetSpriteRUIDByPath("Loading/LucidWalker", self:ReadString(self.LucidWalkRUID, ""))
		local duration = math.max(0, self:ReadNumber(seconds, 0))
		local hold = math.max(0, self:ReadNumber(curtainHoldSeconds, 0))
		local now = _UtilLogic.ElapsedSeconds
		if duration + hold > 0 then
			self.loadingAutoHideAt = now + duration + hold
		else
			self.loadingAutoHideAt = 0
		end
		if duration > 0 then
			self.loadingEndAt = now + duration
		else
			self.loadingEndAt = 0
		end
		self:RefreshLoadingCountdown()
		log("[BRMatchFlowUI] loading shown seconds=" .. tostring(duration) .. " curtainHold=" .. tostring(hold))
	end

	@ExecSpace("Client")
	method void HideLoading(string message)
		-- Closes the loading curtain.
		self:SetEntityActive("Loading", false)
		self:RefreshRootRaycastBlocked()
		self.loadingEndAt = 0
		self.loadingAutoHideAt = 0
		local safeMessage = self:ReadString(message, "")
		if safeMessage ~= "" and _UIToast ~= nil then
			_UIToast:ShowMessage(safeMessage)
		end
	end

	@ExecSpace("Client")
	method void PlayCenterEffect(string animationRuid, number scale, number seconds, string phase)
		-- Plays a center-screen battle-start animationclip.
		self:ClearEffectTimer()
		local safeRuid = self:ResolveAnimationClipRUID(self:ReadString(animationRuid, ""))
		if safeRuid == "" then
			return
		end

		self:SetEntityActive("StartSequence", true)
		self:SetEntityActive("StartSequence/CenterEffect", false)
		self:SetSpriteRUIDByPath("StartSequence/CenterEffect", safeRuid)
		self:ResizeCenterEffect(safeRuid, scale, self:ReadString(phase, "start"))
		self:SetEntityActive("StartSequence/CenterEffect", true)

		local duration = math.max(0, self:ReadNumber(seconds, 0))
		if duration > 0 then
			self.effectTimerId = _TimerService:SetTimerOnce(function() self:HideStartSequence() end, duration)
		end
		log("[BRMatchFlowUI] center effect phase=" .. self:ReadString(phase, "start") .. " ruid=" .. safeRuid .. " duration=" .. tostring(duration) .. " scale=" .. tostring(scale))
	end

	@ExecSpace("Client")
	method void HideStartSequence()
		-- Hides the battle-start animation layer.
		self:ClearEffectTimer()
		self:SetEntityActive("StartSequence", false)
	end

	@ExecSpace("Client")
	method void ShowResult(string title, string body)
		-- Opens the large match-result panel.
		self:SetEntityActive("Loading", false)
		self:SetEntityActive("Result", true)
		self:SetRootRaycastBlocked(true)
		local safeTitle = self:ReadString(title, "RESULT")
		local safeBody = self:ReadString(body, "")
		self:SetTextByPath("Result/Title", safeTitle)
		self:SetTextByPath("Result/Body", safeBody)
		self:ApplyResultDetails(safeTitle, safeBody)
		log("[BRMatchFlowUI] result shown title=" .. safeTitle)
	end

	@ExecSpace("Client")
	method void HideResult()
		-- Hides the result panel and releases full-screen input blocking.
		self:SetEntityActive("Result", false)
		self:RefreshRootRaycastBlocked()
	end

	method void ConnectButtons()
		self:DisconnectButtons()
		local closeButton = self:GetEntity("Result/CloseButton")
		if closeButton ~= nil then
			self.closeHandler = closeButton:ConnectEvent(ButtonClickEvent, self.OnClickClose)
		end
	end

	method void DisconnectButtons()
		local closeButton = self:GetEntity("Result/CloseButton")
		if self.closeHandler ~= nil and closeButton ~= nil then
			closeButton:DisconnectEvent(ButtonClickEvent, self.closeHandler)
		end
		self.closeHandler = nil
	end

	method void OnClickClose(ButtonClickEvent event)
		-- Requests the server-side lobby return after the player has reviewed settlement.
		if _BRBattleLauncher ~= nil then
			_BRBattleLauncher:RequestReturnToLobbyFromResult()
			_BRBattleLauncher:SetLocalPlayerInputEnabled(true)
		end
		self:HideResult()
	end

	method void ApplyResultDetails(string title, string body)
		-- Splits the result body into PUBG-style settlement fields.
		local safeTitle = self:ReadString(title, "RESULT")
		local safeBody = self:ReadString(body, "")
		local rank = self:ExtractResultValue(safeBody, "RANK ", "-")
		local winner = self:ExtractResultValue(safeBody, "WINNER ", "NONE")
		local matchId = self:ExtractResultValue(safeBody, "MATCH ", "-")
		local timeText = self:ExtractResultValue(safeBody, "TIME ", "00:00")
		local reason = self:ExtractResultValue(safeBody, "REASON ", "-")
		local headline = "MATCH COMPLETE"
		if safeTitle == "VICTORY" then
			headline = "WINNER WINNER"
		elseif safeTitle == "DEFEAT" then
			headline = "BATTLE ENDED"
		end

		self:SetTextByPath("Result/Headline", headline)
		self:SetTextByPath("Result/RankValue", rank)
		self:SetTextByPath("Result/WinnerValue", winner)
		self:SetTextByPath("Result/MatchValue", matchId)
		self:SetTextByPath("Result/TimeValue", timeText)
		self:SetTextByPath("Result/ReasonValue", reason)
	end

	method string ExtractResultValue(string body, string key, string fallback)
		-- Reads one KEY value from a newline-separated result body.
		local safeBody = self:ReadString(body, "")
		local safeKey = self:ReadString(key, "")
		if safeBody == "" or safeKey == "" then
			return self:ReadString(fallback, "")
		end

		for line in string.gmatch(safeBody, "([^\n]+)") do
			if string.sub(line, 1, string.len(safeKey)) == safeKey then
				local value = string.sub(line, string.len(safeKey) + 1)
				if value ~= nil and value ~= "" then
					return value
				end
			end
		end
		return self:ReadString(fallback, "")
	end

	method void RefreshLoadingCountdown()
		-- Updates loading presentation timers and the walking Lucid position.
		local now = _UtilLogic.ElapsedSeconds
		if self:IsEntityActive("Loading") == true then
			self:RefreshLucidWalker(now)
		end
		if self.loadingAutoHideAt > 0 and now >= self.loadingAutoHideAt then
			self:HideLoading("")
			return
		end
		self:SetTextByPath("Loading/Countdown", "")
		if self.loadingEndAt <= 0 then
			return
		end
	end

	method void RefreshLucidWalker(number now)
		-- Moves the Lucid loading sprite so the walk clip has screen motion.
		local entity = self:GetEntity("Loading/LucidWalker")
		if entity == nil or entity.UITransformComponent == nil then
			return
		end

		local cycleSeconds = math.max(0.1, self:ReadNumber(self.LucidWalkCycleSeconds, 2.4))
		local cycle = math.fmod(self:ReadNumber(now, 0), cycleSeconds) / cycleSeconds
		local baseX = self:ReadNumber(self.LucidBaseX, -150)
		local baseY = self:ReadNumber(self.LucidBaseY, 118)
		local travel = math.max(0, self:ReadNumber(self.LucidTravelPixels, 170))
		local bob = math.sin(cycle * 6.28318530718) * 5
		entity.UITransformComponent.anchoredPosition = Vector2(baseX - travel * cycle, baseY + bob)
	end

	method void ResizeCenterEffect(string animationRuid, number scale, string phase)
		-- Applies the requested presentation scale to the center animation slot.
		local entity = self:GetEntity("StartSequence/CenterEffect")
		if entity == nil or entity.UITransformComponent == nil then
			return
		end

		local safeScale = math.max(0.05, self:ReadNumber(scale, 1))
		local baseSize = self:GetCenterEffectBaseSize(animationRuid, phase)
		local width = math.max(1, baseSize.x * safeScale)
		local height = math.max(1, baseSize.y * safeScale)
		entity.UITransformComponent.RectSize = Vector2(width, height)
	end

	method Vector2 GetCenterEffectBaseSize(string animationRuid, string phase)
		-- Countdown digits are square-ish, while START is a wide title clip.
		local safePhase = self:ReadString(phase, "")
		local safeRuid = self:ResolveAnimationClipRUID(self:ReadString(animationRuid, ""))
		if safePhase == "countdown" or safeRuid == "3b765e2b2a68476996ea77b2e5b8bcb4" then
			return Vector2(
				math.max(1, self:ReadNumber(self.CenterCountdownBaseWidth, 420)),
				math.max(1, self:ReadNumber(self.CenterCountdownBaseHeight, 420))
			)
		end
		if safePhase == "start" or safeRuid == "1dea1763a5fb4c5da2e06411183dbca8" then
			return Vector2(
				math.max(1, self:ReadNumber(self.CenterStartBaseWidth, 760)),
				math.max(1, self:ReadNumber(self.CenterStartBaseHeight, 300))
			)
		end
		return Vector2(
			math.max(1, self:ReadNumber(self.CenterEffectBaseWidth, 760)),
			math.max(1, self:ReadNumber(self.CenterEffectBaseHeight, 300))
		)
	end

	method void SetSpriteRUIDByPath(string relativePath, string ruid)
		-- Assigns a sprite or animationclip RUID to a UI sprite entity.
		local entity = self:GetEntity(relativePath)
		if entity == nil or entity.SpriteGUIRendererComponent == nil then
			return
		end

		local safeRuid = self:ResolveAnimationClipRUID(self:ReadString(ruid, ""))
		if safeRuid == "" then
			return
		end
		entity.SpriteGUIRendererComponent.ImageRUID = DataRef(safeRuid)
		entity.SpriteGUIRendererComponent.StartFrameIndex = 0
		entity.SpriteGUIRendererComponent.EndFrameIndex = 2147483647
		entity.SpriteGUIRendererComponent.PlayRate = 1
	end

	method string ResolveAnimationClipRUID(string value)
		-- Converts Maker/search display ids into actual animationclip resource RUIDs.
		local safeValue = self:ReadString(value, "")
		if safeValue == "animationclip-1092315" then
			return "3b765e2b2a68476996ea77b2e5b8bcb4"
		elseif safeValue == "animationclip-1092321" then
			return "1dea1763a5fb4c5da2e06411183dbca8"
		end
		return safeValue
	end

	method void ClearEffectTimer()
		-- Clears the auto-hide timer used by the center presentation effect.
		if self.effectTimerId ~= nil and self.effectTimerId > 0 then
			_TimerService:ClearTimer(self.effectTimerId)
		end
		self.effectTimerId = 0
	end

	method Entity GetEntity(string relativePath)
		local path = self:ReadString(relativePath, "")
		if path == "" then
			return nil
		end
		if string.sub(path, 1, 1) ~= "/" then
			path = self:ReadString(self.RootPath, "/ui/BRMatchFlowGroup") .. "/" .. path
		end
		return _EntityService:GetEntityByPath(path)
	end

	method void SetEntityActive(string relativePath, boolean active)
		local entity = self:GetEntity(relativePath)
		if entity ~= nil then
			entity.Enable = active == true
		end
	end

	method boolean IsEntityActive(string relativePath)
		-- Returns whether a modal child is currently enabled.
		local entity = self:GetEntity(relativePath)
		return entity ~= nil and entity.Enable == true
	end

	method void RefreshRootRaycastBlocked()
		-- Blocks background input only while a modal child is visible.
		self:SetRootRaycastBlocked(self:IsEntityActive("Loading") == true or self:IsEntityActive("Result") == true)
	end

	method void SetRootRaycastBlocked(boolean blocked)
		-- Toggles full-screen raycast blocking for match-flow modal states.
		local root = _EntityService:GetEntityByPath(self:ReadString(self.RootPath, "/ui/BRMatchFlowGroup"))
		if root ~= nil and root.CanvasGroupComponent ~= nil then
			root.CanvasGroupComponent.BlocksRaycasts = blocked == true
			root.CanvasGroupComponent.Interactable = blocked == true
		end
	end

	method void SetTextByPath(string relativePath, string text)
		local entity = self:GetEntity(relativePath)
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
		end
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

end
