@Component
script BRRoomMiniMapUI extends Component

	property Entity panel = "b718a19a-5b8d-498d-b6c0-811544b2ffcb"

	property Entity mapArea = "935c0429-e65c-4b60-94a0-a41cc48ec352"

	property Entity roomBg = "b5310173-a6b2-49a3-9ea5-bb84ec78d8c8"

	property TextComponent titleText = "c8d8f8fb-a528-458a-9a45-a3a59193f8fb"

	property number RefreshSeconds = 0.1

	property number SlowScanTicks = 5

	property number MaxItems = 12

	property number MaxEnemies = 8

	property boolean VerboseLog = true

	property number refreshTimerId = 0

	property number tickCount = 0

	property boolean lastVisible = false

	property string currentRoomKey = ""

	property string currentRoomName = ""

	property number lastMiniMapVersion = -1

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Starts the local room minimap refresh loop.
		self:EnsureRuntime()
		self:HideAllMarkers()
		self:SetPanelActive(false)
		self.refreshTimerId = _TimerService:SetTimerRepeat(function() self:Refresh() end, self:GetRefreshSeconds())
		self:Log("ready")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Clears the local room minimap refresh loop.
		if self.refreshTimerId ~= nil and self.refreshTimerId > 0 then
			_TimerService:ClearTimer(self.refreshTimerId)
		end
		self.refreshTimerId = 0
	end

	method void EnsureRuntime()
		-- Prepares non-synced client caches used by the room minimap.
		if self._T.ready ~= true then
			self._T.ready = true
			self._T.assignments = {}
			self._T.roomCenterX = 0
			self._T.roomCenterY = 0
			self._T.roomHalfX = 10
			self._T.roomHalfY = 7.5
			self._T.enemyEntities = {}
			self._T.itemRecords = {}
		end
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- Updates room detection, the baked room background, and live markers.
		self:EnsureRuntime()

		local visible = self:ShouldShow()
		self:SetPanelActive(visible)
		if visible ~= true then
			self.currentRoomKey = ""
			return
		end

		local version = self:ReadNumber(_BRRoomGraphGenerator.LastMiniMapVersion, 0)
		if version ~= self.lastMiniMapVersion then
			self.lastMiniMapVersion = version
			self:ParseAssignments()
			self.currentRoomKey = ""
			self:Log("graph version=" .. tostring(version) .. " assignments=" .. tostring(#self._T.assignments))
		end

		local room = self:DetectCurrentRoom()
		if room == nil then
			return
		end

		if room.Key ~= self.currentRoomKey then
			self:OnRoomChanged(room)
		end

		self.tickCount = self.tickCount + 1
		if self.tickCount % math.max(1, math.floor(self:ReadNumber(self.SlowScanTicks, 5))) == 0 then
			self:ScanEnemies()
			self:ScanItems()
		end
		self:UpdateLiveMarkers()
	end

	method boolean ShouldShow()
		-- Checks whether the room minimap applies to the local player's current map.
		if _BRRoomGraphGenerator == nil then
			return false
		end

		local mapName = self:ReadString(_BRRoomGraphGenerator.LastMiniMapMapName, "")
		if mapName == "" then
			return false
		end

		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil then
			return false
		end
		return self:ReadString(localPlayer.CurrentMapName, "") == mapName
	end

	method void ParseAssignments()
		-- Parses row,column,physicalRoom records from the synchronized payload.
		local result = {}
		local value = self:ReadString(_BRRoomGraphGenerator.LastMiniMapAssignments, "")
		for record in string.gmatch(value, "([^;]+)") do
			local parts = self:SplitCommaRecord(record)
			local row = math.floor(self:ReadNumber(parts[1], 0))
			local column = math.floor(self:ReadNumber(parts[2], 0))
			local roomName = self:ReadString(parts[3], "")
			if row > 0 and column > 0 and roomName ~= "" then
				table.insert(result, { Row = row, Column = column, RoomName = roomName, Key = tostring(row) .. ":" .. tostring(column) })
			end
		end
		self._T.assignments = result
	end

	method any DetectCurrentRoom()
		-- Finds the assigned physical room containing the local player.
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.TransformComponent == nil then
			return nil
		end

		local mapName = self:ReadString(_BRRoomGraphGenerator.LastMiniMapMapName, "")
		local position = localPlayer.TransformComponent.WorldPosition
		local half = self:GetRoomHalf(mapName)

		for index, record in ipairs(self._T.assignments) do
			local center = self:GetPhysicalRoomCenter(mapName, record.RoomName)
			if center ~= nil then
				local margin = 0.05
				if position.x >= center.x - half.x - margin and position.x <= center.x + half.x + margin
					and position.y >= center.y - half.y - margin and position.y <= center.y + half.y + margin then
					record.CenterX = center.x
					record.CenterY = center.y
					return record
				end
			end
		end
		return nil
	end

	method void OnRoomChanged(any room)
		-- Swaps the baked room background and rebuilds portal marks when the player enters another room.
		self.currentRoomKey = self:ReadString(room.Key, "")
		self.currentRoomName = self:ReadString(room.RoomName, "")
		self._T.roomCenterX = self:ReadNumber(room.CenterX, 0)
		self._T.roomCenterY = self:ReadNumber(room.CenterY, 0)

		local mapName = self:ReadString(_BRRoomGraphGenerator.LastMiniMapMapName, "")
		local half = self:GetRoomHalf(mapName)
		self._T.roomHalfX = half.x
		self._T.roomHalfY = half.y

		if self.titleText ~= nil then
			self.titleText.Text = "ROOM " .. tostring(room.Row) .. "-" .. tostring(room.Column)
		end

		self:SetRoomBackground(self.currentRoomName)
		self:RenderPortals(room.Row, room.Column)
		self:ScanEnemies()
		self:ScanItems()
		self:Log("room changed key=" .. self.currentRoomKey .. " physical=" .. self.currentRoomName
			.. " center=(" .. string.format("%.2f", self._T.roomCenterX) .. "," .. string.format("%.2f", self._T.roomCenterY) .. ")")
	end

	method void SetRoomBackground(string roomName)
		-- Loads the pre-baked minimap image for this physical room, or hides the background if none exists.
		if self.roomBg == nil then
			return
		end

		local ruid = self:GetRoomImageRuid(roomName)
		if ruid == "" then
			self.roomBg.Enable = false
			self:Log("room background missing image room=" .. self:ReadString(roomName, ""))
			return
		end

		if self.roomBg.SpriteGUIRendererComponent ~= nil then
			-- Force-download/cache the UGC sprite so a runtime-only reference still renders.
			local sprite = _ResourceService:LoadSpriteAndWait(ruid)
			self.roomBg.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
			self:Log("bg set room=" .. self:ReadString(roomName, "") .. " ruid=" .. ruid .. " loaded=" .. tostring(sprite ~= nil))
		end
		self.roomBg.Enable = true
	end

	method string GetRoomImageRuid(string roomName)
		-- Returns the pre-uploaded minimap sprite RUID for one physical room name.
		local name = self:ReadString(roomName, "")
		if name == "" then
			return ""
		end

		local imageMap = {
			CornerNW = "0a19c0acc0aa4b6a864765dcef59030f",
			CornerNE = "35dd94a94ae1451a94d8bb42696f056a",
			CornerSW = "194cd611f0334ee48cfd58da15b4522d",
			CornerSE = "702ee0ecfd15410c8e65e1b831f7cb6f",
			Room_001 = "be6679daf2b64d91af616bec9baf8fa9",
			Room_002 = "27141617d79241e9b653c79de87adcd0",
			Room_003 = "7a9d49380ad24a4f80505fac7c05da4b",
			Room_004 = "784b007309854f1d80a028a23109549c",
			Room_005 = "e39d92d0206c4970a474d6de44a36043",
			Room_006 = "1b420c7de90a4c82a25d232d105453fc",
			Room_007 = "b3be3a1ff56f40c1b4e8c1e4a342fe01",
			Room_008 = "81ee22b48b674805a61eca29d70c0170",
			Room_009 = "13eda689030e4ff69e5aa52b2f842d01",
			Room_010 = "f10d730437124819a4012f54ee3b1d23",
			Room_011 = "7e5a629925fc46d08aab5789b46d6034",
			Room_012 = "822ab074bcfd4c9d8a409c4bbe6ab420",
			Room_013 = "3758386ccab944c7ba1aa985aec1e275",
			Room_014 = "1b0bf12433f849089e2a565316146bd6",
			Room_015 = "449b2a143908490eb1ab3317445d9e73",
			Room_016 = "d0da90c8bd16461884fd3ddeebea22d4",
			Room_017 = "41857926f70a40268f07242c5036abcf",
			Room_018 = "212e725f91cd440b8d68a5a38649274c",
			Room_019 = "faaa4c3ca8eb4265b9c64a058a8379b3",
			Room_020 = "71d657b8eaae4d53b0dc918ef37ed4f7",
			Room_021 = "6ebf705ec14f4b399b265496b0235a5f",
			Room_022 = "39813b4677104ec29230cbfdb9c0c0ed",
			Room_023 = "29f897425fb54881b87ea594d1b4844d",
			Room_024 = "a9f7f5ca0b894c218339ff52b2f378d7",
		}
		return self:ReadString(imageMap[name], "")
	end

	method void RenderPortals(number row, number column)
		-- Shows edge marks for portal directions open from the current logical cell.
		local openN = false
		local openE = false
		local openS = false
		local openW = false

		local value = self:ReadString(_BRRoomGraphGenerator.LastMiniMapConnections, "")
		for record in string.gmatch(value, "([^;]+)") do
			local parts = self:SplitCommaRecord(record)
			local recordRow = math.floor(self:ReadNumber(parts[1], 0))
			local recordColumn = math.floor(self:ReadNumber(parts[2], 0))
			local direction = string.upper(self:ReadString(parts[3], ""))
			if direction == "E" then
				if recordRow == row and recordColumn == column then
					openE = true
				elseif recordRow == row and recordColumn == column - 1 then
					openW = true
				end
			elseif direction == "S" then
				if recordRow == row and recordColumn == column then
					openS = true
				elseif recordRow == row - 1 and recordColumn == column then
					openN = true
				end
			end
		end

		self:SetAreaChildActive("PortalN", openN)
		self:SetAreaChildActive("PortalE", openE)
		self:SetAreaChildActive("PortalS", openS)
		self:SetAreaChildActive("PortalW", openW)
	end

	method void ScanEnemies()
		-- Caches same-map dynamic markers: other players (red) plus battle-bot monsters (purple).
		local result = {}
		local mapName = self:ReadString(_BRRoomGraphGenerator.LastMiniMapMapName, "")
		local localPlayer = _UserService.LocalPlayer

		local users = _UserService:GetUsersByMapName(mapName)
		if users ~= nil then
			for index, userEntity in ipairs(users) do
				if isvalid(userEntity) and userEntity ~= localPlayer then
					table.insert(result, { Target = userEntity, MarkerColor = Color(1, 0.35, 0.35, 1) })
				end
			end
		end

		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity ~= nil then
			local bots = mapEntity:GetChildComponentsByTypeName("script.BRBattleBotController", true)
			if bots == nil or bots[1] == nil then
				bots = mapEntity:GetChildComponentsByTypeName("BRBattleBotController", true)
			end
			if bots ~= nil then
				for index, bot in ipairs(bots) do
					if bot ~= nil and isvalid(bot.Entity) and bot:IsAlive() == true then
						table.insert(result, { Target = bot.Entity, MarkerColor = Color(0.8, 0.45, 1, 1) })
					end
				end
			end

			local monsters = mapEntity:GetChildComponentsByTypeName("script.BRTrainingDummy", true)
			if monsters == nil or monsters[1] == nil then
				monsters = mapEntity:GetChildComponentsByTypeName("BRTrainingDummy", true)
			end
			if monsters ~= nil then
				for index, dummy in ipairs(monsters) do
					if dummy ~= nil and isvalid(dummy.Entity) and dummy.IsBattleRuntimeMonster == true and self:ReadNumber(dummy.CurrentHp, 0) > 0 then
						table.insert(result, { Target = dummy.Entity, MarkerColor = Color(1, 0.55, 0.2, 1) })
					end
				end
			end
		end

		self._T.enemyEntities = result
	end

	method void ScanItems()
		-- Caches in-room item markers: dropped skill parts and part/supply boxes.
		local records = {}
		local mapName = self:ReadString(_BRRoomGraphGenerator.LastMiniMapMapName, "")
		local mapEntity = _EntityService:GetEntityByPath("/maps/" .. mapName)
		if mapEntity ~= nil then
			self:CollectItemEntities(mapEntity, "script.BRDroppedSkillPart", records, Color(0.45, 1, 0.5, 1))
			self:CollectItemEntities(mapEntity, "script.BRPartBox", records, Color(1, 0.72, 0.25, 1))
		end
		self._T.itemRecords = records
	end

	method void CollectItemEntities(Entity mapEntity, string typeName, any records, Color markerColor)
		-- Collects entities of one item component type into the marker record list.
		local components = mapEntity:GetChildComponentsByTypeName(typeName, true)
		if components == nil then
			return
		end

		for index, component in ipairs(components) do
			if component ~= nil and component.Enable == true and isvalid(component.Entity) and component.Entity.Enable == true then
				table.insert(records, { Target = component.Entity, MarkerColor = markerColor })
			end
		end
	end

	method void UpdateLiveMarkers()
		-- Repositions my marker, enemy/player markers, and item markers every tick.
		local localPlayer = _UserService.LocalPlayer
		local me = self:GetAreaChild("Me")
		if me ~= nil and me.UITransformComponent ~= nil and localPlayer ~= nil and localPlayer.TransformComponent ~= nil then
			local position = localPlayer.TransformComponent.WorldPosition
			me.UITransformComponent.anchoredPosition = self:ToMapPosition(position.x, position.y)
			me.Enable = true
		end

		local maxEnemies = math.max(1, math.floor(self:ReadNumber(self.MaxEnemies, 8)))
		local enemySlot = 0
		for index, record in ipairs(self._T.enemyEntities) do
			if enemySlot >= maxEnemies then
				break
			end
			local enemyEntity = record.Target
			if isvalid(enemyEntity) and self:IsEntityAlive(enemyEntity) == true and enemyEntity.TransformComponent ~= nil then
				local position = enemyEntity.TransformComponent.WorldPosition
				if self:IsPointInsideRoom(position.x, position.y, 0) == true then
					enemySlot = enemySlot + 1
					self:PlaceDotMarker("Enemy_" .. tostring(enemySlot), position.x, position.y, record.MarkerColor)
				end
			end
		end
		for index = enemySlot + 1, maxEnemies do
			self:SetAreaChildActive("Enemy_" .. tostring(index), false)
		end

		local maxItems = math.max(1, math.floor(self:ReadNumber(self.MaxItems, 12)))
		local itemSlot = 0
		for index, record in ipairs(self._T.itemRecords) do
			if itemSlot >= maxItems then
				break
			end
			local target = record.Target
			if isvalid(target) and target.Enable == true and target.TransformComponent ~= nil then
				local position = target.TransformComponent.WorldPosition
				if self:IsPointInsideRoom(position.x, position.y, 0) == true then
					itemSlot = itemSlot + 1
					self:PlaceDotMarker("Item_" .. tostring(itemSlot), position.x, position.y, record.MarkerColor)
				end
			end
		end
		for index = itemSlot + 1, maxItems do
			self:SetAreaChildActive("Item_" .. tostring(index), false)
		end
	end

	method boolean IsPointInsideRoom(number x, number y, number margin)
		-- Checks whether one world point is inside the current room rectangle.
		local safeMargin = self:ReadNumber(margin, 0)
		return x >= self._T.roomCenterX - self._T.roomHalfX - safeMargin
			and x <= self._T.roomCenterX + self._T.roomHalfX + safeMargin
			and y >= self._T.roomCenterY - self._T.roomHalfY - safeMargin
			and y <= self._T.roomCenterY + self._T.roomHalfY + safeMargin
	end

	method boolean IsEntityAlive(Entity target)
		-- Checks player-like entities for a living state before showing a marker.
		if target.PlayerComponent ~= nil then
			if target.PlayerComponent:IsDead() == true or target.PlayerComponent.Hp <= 0 then
				return false
			end
		end
		local bot = target:GetComponent("script.BRBattleBotController")
		if bot == nil then
			bot = target:GetComponent("BRBattleBotController")
		end
		if bot ~= nil then
			return bot:IsAlive() == true
		end
		return true
	end

	method void PlaceDotMarker(string childName, number worldX, number worldY, any markerColor)
		-- Enables one dot marker at a world position projected into the map area.
		local marker = self:GetAreaChild(childName)
		if marker == nil or marker.UITransformComponent == nil then
			return
		end

		marker.UITransformComponent.anchoredPosition = self:ToMapPosition(worldX, worldY)
		if markerColor ~= nil and marker.SpriteGUIRendererComponent ~= nil then
			marker.SpriteGUIRendererComponent.Color = markerColor
		end
		marker.Enable = true
	end

	method Vector2 ToMapPosition(number worldX, number worldY)
		-- Converts a world position into a clamped map-area anchored position using independent x/y room scale.
		-- Rooms are non-square (e.g. 20x15) while the map area is square, so x and y scale separately so the
		-- room fills the area edge-to-edge and lines up with the baked room background and the edge portal marks.
		local areaHalf = self:GetMapAreaHalf()
		local scaleX = areaHalf.x / math.max(0.5, self._T.roomHalfX)
		local scaleY = areaHalf.y / math.max(0.5, self._T.roomHalfY)
		local x = (worldX - self._T.roomCenterX) * scaleX
		local y = (worldY - self._T.roomCenterY) * scaleY
		return Vector2(math.max(-areaHalf.x, math.min(areaHalf.x, x)), math.max(-areaHalf.y, math.min(areaHalf.y, y)))
	end

	method Vector2 GetMapAreaHalf()
		-- Returns the half extents of the map area rect in UI pixels.
		if self.mapArea ~= nil and self.mapArea.UITransformComponent ~= nil then
			local size = self.mapArea.UITransformComponent.RectSize
			return Vector2(size.x * 0.5, size.y * 0.5)
		end
		return Vector2(100, 100)
	end

	method Vector2 GetRoomHalf(string mapName)
		-- Reads room half extents from the grid editor tool when available.
		local width = 20
		local height = 15
		local toolEntity = _EntityService:GetEntityByPath("/maps/" .. self:ReadString(mapName, "RoomTestMap") .. "/GridMapEditorTool")
		if toolEntity ~= nil then
			---@type BRGridMapEditorTool
			local gridTool = toolEntity:GetComponent("script.BRGridMapEditorTool")
			if gridTool ~= nil then
				width = gridTool:GetRoomWidth()
				height = gridTool:GetRoomHeight()
			end
		end
		return Vector2(math.max(0.5, width * 0.5), math.max(0.5, height * 0.5))
	end

	method any GetPhysicalRoomCenter(string mapName, string roomName)
		-- Reads the world center of one assigned physical room.
		local safeRoomName = self:ReadString(roomName, "")
		if safeRoomName == "" then
			return nil
		end

		local room = _EntityService:GetEntityByPath("/maps/" .. self:ReadString(mapName, "RoomTestMap") .. "/EditorGeneratedGrid/" .. safeRoomName)
		if room == nil then
			room = _EntityService:GetEntityByPath("/maps/" .. self:ReadString(mapName, "RoomTestMap") .. "/" .. safeRoomName)
		end
		if room == nil or room.TransformComponent == nil then
			return nil
		end

		local position = room.TransformComponent.WorldPosition
		return Vector2(position.x, position.y)
	end

	method void HideAllMarkers()
		-- Hides the room background and every dynamic marker before the first render.
		if self.roomBg ~= nil then
			self.roomBg.Enable = false
		end
		for index = 1, math.max(1, math.floor(self:ReadNumber(self.MaxItems, 12))) do
			self:SetAreaChildActive("Item_" .. tostring(index), false)
		end
		for index = 1, math.max(1, math.floor(self:ReadNumber(self.MaxEnemies, 8))) do
			self:SetAreaChildActive("Enemy_" .. tostring(index), false)
		end
		self:SetAreaChildActive("PortalN", false)
		self:SetAreaChildActive("PortalE", false)
		self:SetAreaChildActive("PortalS", false)
		self:SetAreaChildActive("PortalW", false)
	end

	method Entity GetAreaChild(string childName)
		-- Finds one map-area child by name.
		if self.mapArea == nil then
			return nil
		end
		return self.mapArea:GetChildByName(self:ReadString(childName, ""), false)
	end

	method void SetAreaChildActive(string childName, boolean active)
		-- Sets the active state for one map-area child if it exists.
		local child = self:GetAreaChild(childName)
		if child ~= nil then
			child.Enable = active == true
		end
	end

	method void SetPanelActive(boolean visible)
		-- Toggles the room minimap panel tree.
		if self.panel == nil then
			return
		end
		self.panel.Enable = visible == true
		if visible ~= self.lastVisible then
			self.lastVisible = visible
			self:Log("visible=" .. tostring(visible))
		end
	end

	method any SplitCommaRecord(string record)
		-- Splits one comma-delimited record into ordered string parts.
		local parts = {}
		for part in string.gmatch(self:ReadString(record, ""), "([^,]+)") do
			table.insert(parts, part)
		end
		return parts
	end

	method number GetRefreshSeconds()
		-- Returns the marker refresh interval.
		return math.max(0.05, self:ReadNumber(self.RefreshSeconds, 0.1))
	end

	method string ReadString(any value, string fallback)
		-- Reads a string-like value with fallback.
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		-- Reads a numeric value with fallback.
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		-- Writes a room minimap log when verbose logging is enabled.
		if self.VerboseLog == true then
			log("[BRRoomMiniMapUI] " .. self:ReadString(message, ""))
		end
	end

end
