@Component
script BRSkillChainUI extends Component

	property string ChainRootPath = "/ui/BRBattleHudGroup"

	property string InventoryRootPath = "/ui/BRSkillInventoryGroup"

	property string RootPath = "/ui/BRBattleHudGroup"

	property number RefreshSeconds = 0.15

	property number RequestSeconds = 0.75

	property number ChainSlotCount = 5

	property number BagSlotCount = 2

	property boolean AttachInventoryPanel = true

	property number InventoryAttachGap = -2

	property number InventoryPanelYOffset = 0

	property boolean VerboseLog = true

	property boolean runtimeDisabled = false

	property number refreshTimerId = 0

	property number nextRequestAt = 0

	property number lastSnapshotVersion = -1

	property number draggingInstanceId = 0

	property number draggingSourceSlot = 0

	property string draggingLabel = ""

	property number hoverChainSlot = 0

	property number hoverBagIndex = 0

	property number draggingSourceBagIndex = 0

	property number draggingStartX = 0

	property number draggingStartY = 0

	property boolean draggingMoved = false

	property number ClickDragThreshold = 8

	property any inputKeyDownHandler = nil

	property any inputKeyUpHandler = nil

	property any inputTouchDownHandler = nil

	property any inputTouchHoldHandler = nil

	property any inputTouchReleaseHandler = nil

	property any inputMouseMoveHandler = nil

	property number DragGroupOrder = 90

	property number dragGroupOrderBefore = -1000

	property boolean EnableBattleHudLayout = true

	property boolean ShowBattleHudStatus = true

	property number HudPanelWidth = 940

	property number HudPanelHeight = 112

	property number HudPanelY = 32

	property number HudSlotSize = 54

	property number HudIconSize = 42

	property number HudSlotSpacing = 58

	property number BattleHudScale = 0.72

	property number AuthoredHudGaugeWidth = 243

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:EnsureRuntime()
		if self:IsControllerInChainRoot() ~= true then
			self.runtimeDisabled = true
			self:Log("ignored controller path=" .. self:GetSelfPath() .. " chainRoot=" .. self:GetChainRootPath())
			return
		end
		self.runtimeDisabled = false
		if self:HasAuthoredBattleHudLayout() ~= true then
			self:ApplySlotOnlyLayout()
		end
		self:EnsureBattleHudLayout()
		self:ConnectHandlers()
		self:SetDragGhostActive(false)
		self:Refresh()
		self.refreshTimerId = _TimerService:SetTimerRepeat(function() self:Refresh() end, self:GetRefreshSeconds(), 0.1)
		self:Log("slot highlight mode=frame")
		self:Log("ready chainRoot=" .. self:GetChainRootPath() .. " inventoryRoot=" .. self:GetInventoryRootPath())
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.refreshTimerId ~= nil and self.refreshTimerId > 0 then
			_TimerService:ClearTimer(self.refreshTimerId)
		end
		self.refreshTimerId = 0
		self:DisconnectHandlers()
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		if self.runtimeDisabled == true then
			return
		end
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			self:SetChainPanelActive(false)
			self:SetInventoryPanelActive(false)
			return
		end

		self:SetChainPanelActive(true)
		self:SetInventoryPanelActive(true)
		self:RefreshBattleHud(localPlayer)
		local now = _UtilLogic.ElapsedSeconds
		if _BRSkillSystem ~= nil and now >= self.nextRequestAt then
			self.nextRequestAt = now + self:GetRequestSeconds()
			_BRSkillSystem:RequestUserSnapshot(localPlayer.PlayerComponent.UserId)
		end

		if _BRSkillSystem == nil then
			self:RefreshCommonSkillSlots()
			self:RenderChain()
			self:RenderBag()
			return
		end

		local version = _BRSkillSystem:GetLocalSnapshotVersion()
		if version == self.lastSnapshotVersion then
			self:RefreshCommonSkillSlots()
			return
		end
		self.lastSnapshotVersion = version

		self._T.chainSlots = self:ParseChainText(_BRSkillSystem:GetLocalChainText())
		self._T.bagParts = self:ParseBagText(_BRSkillSystem:GetLocalBagText())
		self:RenderChain()
		self:RenderBag()
		self:RefreshCommonSkillSlots()
	end

	@ExecSpace("ClientOnly")
	method void ConnectHandlers()
		self:EnsureRuntime()
		self:DisconnectHandlers()
		self._T.handlers = {}

		self.inputKeyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnInputKeyDown)
		self.inputKeyUpHandler = _InputService:ConnectEvent(KeyUpEvent, self.OnInputKeyUp)
		self.inputTouchDownHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.OnScreenTouchDown)
		self.inputTouchHoldHandler = _InputService:ConnectEvent(ScreenTouchHoldEvent, self.OnScreenTouchHold)
		self.inputTouchReleaseHandler = _InputService:ConnectEvent(ScreenTouchReleaseEvent, self.OnScreenTouchRelease)
		self.inputMouseMoveHandler = _InputService:ConnectEvent(MouseMoveEvent, self.OnMouseMove)

		for index = 1, self:GetChainSlotCount() do
			local slotIndex = index
			local touch = self:GetChainTouchEntity(slotIndex)
			if touch ~= nil then
				self:ConnectTouchEntity(touch, "CHAIN", slotIndex)
			end
			local slot = self:GetChainEntity("Panel/Chain/Slot_" .. tostring(slotIndex))
			if slot ~= nil and slot ~= touch then
				self:ConnectTouchEntity(slot, "CHAIN", slotIndex)
			end
		end

		for index = 1, self:GetBagSlotCount() do
			local bagIndex = index
			local touch = self:GetBagTouchEntity(bagIndex)
			if touch ~= nil then
				self:ConnectTouchEntity(touch, "BAG", bagIndex)
			end
			local item = self:GetInventoryEntity("Panel/Inventory/Item_" .. tostring(bagIndex))
			if item ~= nil and item ~= touch then
				self:ConnectTouchEntity(item, "BAG", bagIndex)
			end
		end

		self:Log("handlers connected count=" .. tostring(#self._T.handlers))
	end

	@ExecSpace("ClientOnly")
	method void ApplyAttachedInventoryLayout()
		if self.AttachInventoryPanel ~= true then
			return
		end

		local chainPanel = self:GetChainEntity("Panel")
		local inventoryPanel = self:GetInventoryEntity("Panel")
		if chainPanel == nil or inventoryPanel == nil or chainPanel.UITransformComponent == nil or inventoryPanel.UITransformComponent == nil then
			self:Log("layout attach skipped chainPanel=" .. tostring(chainPanel ~= nil) .. " inventoryPanel=" .. tostring(inventoryPanel ~= nil))
			return
		end

		local chainTransform = chainPanel.UITransformComponent
		local inventoryTransform = inventoryPanel.UITransformComponent
		local chainSize = chainTransform.RectSize
		local inventorySize = inventoryTransform.RectSize
		local chainPosition = chainTransform.anchoredPosition
		local gap = self:ReadNumber(self.InventoryAttachGap, -2)
		local offsetY = self:ReadNumber(self.InventoryPanelYOffset, 0)
		local targetX = chainPosition.x + chainSize.x * 0.5 + inventorySize.x * 0.5 + gap
		local targetY = chainPosition.y + offsetY
		inventoryTransform.anchoredPosition = Vector2(targetX, targetY)
		self:Log("layout attached inventoryX=" .. tostring(math.floor(targetX)) .. " inventoryY=" .. tostring(math.floor(targetY)))
	end

	@ExecSpace("ClientOnly")
	method void ConnectTouchEntity(Entity entity, string kind, number index)
		if entity == nil then
			return
		end

		local downHandler = entity:ConnectEvent(UITouchDownEvent, function(event) self:OnTouchDown(kind, index, event) end)
		local dragHandler = entity:ConnectEvent(UITouchDragEvent, function(event) self:OnTouchDrag(kind, index, event) end)
		local upHandler = entity:ConnectEvent(UITouchUpEvent, function(event) self:OnTouchUp(kind, index, event) end)
		local enterHandler = entity:ConnectEvent(UITouchEnterEvent, function(event) self:OnTouchEnter(kind, index, event) end)
		local exitHandler = entity:ConnectEvent(UITouchExitEvent, function(event) self:OnTouchExit(kind, index, event) end)

		table.insert(self._T.handlers, { Entity = entity, EventType = "DOWN", Handler = downHandler })
		table.insert(self._T.handlers, { Entity = entity, EventType = "DRAG", Handler = dragHandler })
		table.insert(self._T.handlers, { Entity = entity, EventType = "UP", Handler = upHandler })
		table.insert(self._T.handlers, { Entity = entity, EventType = "ENTER", Handler = enterHandler })
		table.insert(self._T.handlers, { Entity = entity, EventType = "EXIT", Handler = exitHandler })
	end

	@ExecSpace("ClientOnly")
	method void DisconnectHandlers()
		if self.inputKeyDownHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.inputKeyDownHandler)
		end
		self.inputKeyDownHandler = nil
		if self.inputKeyUpHandler ~= nil then
			_InputService:DisconnectEvent(KeyUpEvent, self.inputKeyUpHandler)
		end
		self.inputKeyUpHandler = nil
		if self.inputTouchDownHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchEvent, self.inputTouchDownHandler)
		end
		self.inputTouchDownHandler = nil
		if self.inputTouchHoldHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchHoldEvent, self.inputTouchHoldHandler)
		end
		self.inputTouchHoldHandler = nil
		if self.inputTouchReleaseHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchReleaseEvent, self.inputTouchReleaseHandler)
		end
		self.inputTouchReleaseHandler = nil
		if self.inputMouseMoveHandler ~= nil then
			_InputService:DisconnectEvent(MouseMoveEvent, self.inputMouseMoveHandler)
		end
		self.inputMouseMoveHandler = nil

		if self._T.handlers == nil then
			return
		end

		for index, entry in ipairs(self._T.handlers) do
			if entry ~= nil and entry.Entity ~= nil and entry.Handler ~= nil then
				if entry.EventType == "DOWN" then
					entry.Entity:DisconnectEvent(UITouchDownEvent, entry.Handler)
				elseif entry.EventType == "DRAG" then
					entry.Entity:DisconnectEvent(UITouchDragEvent, entry.Handler)
				elseif entry.EventType == "UP" then
					entry.Entity:DisconnectEvent(UITouchUpEvent, entry.Handler)
				elseif entry.EventType == "ENTER" then
					entry.Entity:DisconnectEvent(UITouchEnterEvent, entry.Handler)
				elseif entry.EventType == "EXIT" then
					entry.Entity:DisconnectEvent(UITouchExitEvent, entry.Handler)
				end
			end
		end
		self._T.handlers = {}
	end

	@ExecSpace("ClientOnly")
	method void OnInputKeyDown(KeyDownEvent event)
		if event == nil or event.key ~= KeyboardKey.Mouse1 then
			return
		end

		local cursorPosition = _InputService:GetCursorPosition()
		local slotIndex = self:GetSlotIndexAtScreenPoint(cursorPosition)
		if slotIndex <= 0 then
			slotIndex = self.hoverChainSlot
		end
		if slotIndex > 0 then
			self:RequestClearSlot(slotIndex)
			return
		end

		local bagIndex = self:GetBagIndexAtScreenPoint(cursorPosition)
		if bagIndex <= 0 then
			bagIndex = self.hoverBagIndex
		end
		if bagIndex > 0 then
			self:ClearEquippedBagPart(bagIndex)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnInputKeyUp(KeyUpEvent event)
		-- Completes an active drag even if the pointer left the original UI touch receiver.
		if event == nil or event.key ~= KeyboardKey.Mouse0 then
			return
		end
		if self.draggingInstanceId <= 0 then
			return
		end
		self:EndPartDragAtScreen(_InputService:GetCursorPosition())
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchDown(ScreenTouchEvent event)
		-- Starts dragging from the global screen input path when UI raycasts are blocked by another group.
		if event == nil or self.draggingInstanceId > 0 then
			return
		end

		local screenPoint = event.TouchPoint
		local slotIndex = self:GetSlotIndexAtScreenPoint(screenPoint)
		if slotIndex > 0 then
			if self:BeginChainSlotDragAtScreen(slotIndex, screenPoint) == true then
				self:Log("screen drag begin slot=" .. tostring(slotIndex))
			end
			return
		end

		local bagIndex = self:GetBagIndexAtScreenPoint(screenPoint)
		if bagIndex > 0 then
			if self:BeginBagPartDragAtScreen(bagIndex, screenPoint) == true then
				self:Log("screen drag begin bag=" .. tostring(bagIndex))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchHold(ScreenTouchHoldEvent event)
		-- Keeps the drag ghost attached to the pointer after leaving the source slot.
		if event == nil or self.draggingInstanceId <= 0 then
			return
		end
		self:MovePartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchRelease(ScreenTouchReleaseEvent event)
		-- Completes touch dragging from anywhere on the screen.
		if event == nil or self.draggingInstanceId <= 0 then
			return
		end
		self:EndPartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnMouseMove(MouseMoveEvent event)
		-- Tracks PC mouse dragging between UI touch events.
		if self.draggingInstanceId <= 0 then
			return
		end
		if _InputService:IsKeyPressed(KeyboardKey.Mouse0) == false then
			return
		end
		self:MovePartDragAtScreen(_InputService:GetCursorPosition())
	end

	@ExecSpace("ClientOnly")
	method void OnTouchDown(string kind, number index, UITouchDownEvent event)
		if event == nil then
			return
		end

		self:Log("touch down kind=" .. self:ReadString(kind, "") .. " index=" .. tostring(index) .. " touchId=" .. tostring(event.TouchId))
		if kind == "CHAIN" then
			self.hoverChainSlot = math.floor(self:ReadNumber(index, 0))
			if self:IsRightClick(event.TouchId) == true then
				self:RequestClearSlot(index)
				return
			end
			self:BeginChainSlotDrag(index, event)
		elseif kind == "BAG" then
			self.hoverBagIndex = math.floor(self:ReadNumber(index, 0))
			if self:IsRightClick(event.TouchId) == true then
				self:ClearEquippedBagPart(index)
				return
			end
			self:BeginBagPartDrag(index, event)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouchDrag(string kind, number index, UITouchDragEvent event)
		if event == nil then
			return
		end
		self:MovePartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnTouchUp(string kind, number index, UITouchUpEvent event)
		self:EndPartDrag(event)
	end

	@ExecSpace("ClientOnly")
	method void OnTouchEnter(string kind, number index, UITouchEnterEvent event)
		if kind == "CHAIN" then
			self.hoverChainSlot = math.floor(self:ReadNumber(index, 0))
		elseif kind == "BAG" then
			self.hoverBagIndex = math.floor(self:ReadNumber(index, 0))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouchExit(string kind, number index, UITouchExitEvent event)
		local safeIndex = math.floor(self:ReadNumber(index, 0))
		if kind == "CHAIN" and self.hoverChainSlot == safeIndex then
			self.hoverChainSlot = 0
		elseif kind == "BAG" and self.hoverBagIndex == safeIndex then
			self.hoverBagIndex = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void BeginBagPartDrag(number bagIndex, UITouchDownEvent event)
		local part = self:GetBagPart(bagIndex)
		if part == nil then
			return
		end

		if self:BeginBagPartDragAtScreen(bagIndex, event.TouchPoint) ~= true then
			return
		end
		self:Log("drag begin bag=" .. tostring(bagIndex) .. " instance=" .. tostring(self.draggingInstanceId))
	end

	@ExecSpace("ClientOnly")
	method boolean BeginBagPartDragAtScreen(number bagIndex, Vector2 screenPoint)
		-- Starts dragging a spare inventory part from the given screen position.
		local part = self:GetBagPart(bagIndex)
		if part == nil then
			return false
		end

		self.draggingInstanceId = math.floor(self:ReadNumber(part.InstanceId, 0))
		self.draggingSourceSlot = 0
		self.draggingSourceBagIndex = math.floor(self:ReadNumber(bagIndex, 0))
		self.draggingStartX = screenPoint.x
		self.draggingStartY = screenPoint.y
		self.draggingMoved = false
		self.draggingLabel = self:FormatSkillIconText(self:ReadString(part.Short, "S"), 1)
		self:RenderDragGhostVisual(part, 1, false)
		self:SetDragGhostActive(true)
		self:MoveGhostToTouch(screenPoint)
		return true
	end

	@ExecSpace("ClientOnly")
	method void BeginChainSlotDrag(number slotIndex, UITouchDownEvent event)
		local record = self:GetChainSlot(slotIndex)
		if record == nil or self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) <= 0 then
			return
		end

		if self:BeginChainSlotDragAtScreen(slotIndex, event.TouchPoint) ~= true then
			return
		end
		self:Log("drag begin slot=" .. tostring(slotIndex) .. " instance=" .. tostring(self.draggingInstanceId))
	end

	@ExecSpace("ClientOnly")
	method boolean BeginChainSlotDragAtScreen(number slotIndex, Vector2 screenPoint)
		-- Starts dragging an equipped chain slot from the given screen position.
		local record = self:GetChainSlot(slotIndex)
		if record == nil or self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) <= 0 then
			return false
		end

		self.draggingInstanceId = math.floor(self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0))
		self.draggingSourceSlot = math.floor(self:ReadNumber(slotIndex, 0))
		self.draggingSourceBagIndex = 0
		self.draggingStartX = screenPoint.x
		self.draggingStartY = screenPoint.y
		self.draggingMoved = false
		self.draggingLabel = self:FormatSkillIconText(self:ReadString(self:ReadRecordValue(record, "Short"), "S"), self:ReadRecordValue(record, "Tier"))
		self:RenderDragGhostVisual(record, self:GetChainDisplayTier(slotIndex, record), self:IsLeadChainSlot(slotIndex, record))
		self:SetDragGhostActive(true)
		self:MoveGhostToTouch(screenPoint)
		return true
	end

	@ExecSpace("ClientOnly")
	method void MovePartDrag(UITouchDragEvent event)
		if event == nil or self.draggingInstanceId <= 0 then
			return
		end
		self:MovePartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void MovePartDragAtScreen(Vector2 screenPoint)
		-- Moves the drag ghost to the current pointer position.
		if self.draggingInstanceId <= 0 then
			return
		end
		self:UpdateDragMoved(screenPoint)
		self:MoveGhostToTouch(screenPoint)
	end

	@ExecSpace("ClientOnly")
	method void EndPartDrag(UITouchUpEvent event)
		if event == nil or self.draggingInstanceId <= 0 then
			self:ResetDrag()
			self:SetDragGhostActive(false)
			return
		end
		self:EndPartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void EndPartDragAtScreen(Vector2 screenPoint)
		-- Resolves a drag release into chain, spare bag, or world drop behavior.
		if self.draggingInstanceId <= 0 then
			return
		end
		self:MoveGhostToTouch(screenPoint)
		self:UpdateDragMoved(screenPoint)
		local targetSlot = self:GetSlotIndexAtScreenPoint(screenPoint)
		local targetBagIndex = self:GetBagIndexAtScreenPoint(screenPoint)
		local instanceId = self.draggingInstanceId
		local sourceSlot = self.draggingSourceSlot
		local sourceBagIndex = self.draggingSourceBagIndex
		local wasClick = self.draggingMoved == false
		self:ResetDrag()
		self:SetDragGhostActive(false)

		if _BRSkillSystem == nil then
			return
		end

		if targetSlot > 0 and self:IsChainSlotLocked(targetSlot) == true then
			self:Log("drop locked slot=" .. tostring(targetSlot) .. " instance=" .. tostring(instanceId))
			return
		end

		if targetSlot > 0 and sourceSlot > 0 then
			if sourceSlot == targetSlot then
				self:Log("chain click sourceSlot=" .. tostring(sourceSlot) .. " instance=" .. tostring(instanceId))
			else
				_BRSkillSystem:RequestMoveChainSlotToChainSlot(self:GetLocalUserId(), sourceSlot, targetSlot)
				self:ApplyLocalMoveChainSlot(sourceSlot, targetSlot)
			end
		elseif targetSlot > 0 then
			self:RequestEquipPartToSlot(instanceId, targetSlot, "drop")
		elseif targetBagIndex > 0 then
			if sourceSlot > 0 then
				self:RequestMovePartToBagSlot(instanceId, targetBagIndex, "drop")
			elseif sourceBagIndex > 0 then
				if wasClick == true and sourceBagIndex == targetBagIndex then
					self:HandleBagPartClick(instanceId, sourceBagIndex)
				elseif sourceBagIndex ~= targetBagIndex then
					self:RequestMovePartToBagSlot(instanceId, targetBagIndex, "bag")
				end
			end
		elseif wasClick == true and sourceBagIndex > 0 then
			self:HandleBagPartClick(instanceId, sourceBagIndex)
		elseif wasClick == false and (sourceSlot > 0 or sourceBagIndex > 0) then
			self:RequestDropPartToWorld(instanceId, "outside")
		else
			self:Log("drop ignored instance=" .. tostring(instanceId) .. " sourceSlot=" .. tostring(sourceSlot))
		end

		self.nextRequestAt = 0
		self:Log("drop instance=" .. tostring(instanceId) .. " sourceSlot=" .. tostring(sourceSlot) .. " sourceBag=" .. tostring(sourceBagIndex) .. " targetSlot=" .. tostring(targetSlot) .. " targetBag=" .. tostring(targetBagIndex))
	end

	@ExecSpace("ClientOnly")
	method void UpdateDragMoved(Vector2 screenPoint)
		local dx = math.abs(screenPoint.x - self.draggingStartX)
		local dy = math.abs(screenPoint.y - self.draggingStartY)
		if dx >= self:GetClickDragThreshold() or dy >= self:GetClickDragThreshold() then
			self.draggingMoved = true
		end
	end

	@ExecSpace("ClientOnly")
	method number GetSlotIndexAtScreenPoint(Vector2 screenPoint)
		for slotIndex = 1, self:GetChainSlotCount() do
			local slot = self:GetChainEntity("Panel/Chain/Slot_" .. tostring(slotIndex))
			if self:IsScreenPointInsideEntity(screenPoint, slot) == true then
				return slotIndex
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method number GetBagIndexAtScreenPoint(Vector2 screenPoint)
		for bagIndex = 1, self:GetBagSlotCount() do
			local tile = self:GetInventoryEntity("Panel/Inventory/Item_" .. tostring(bagIndex))
			if self:IsScreenPointInsideEntity(screenPoint, tile) == true then
				return bagIndex
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method boolean IsScreenPointInsideEntity(Vector2 screenPoint, Entity entity)
		if entity == nil or entity.UITransformComponent == nil then
			return false
		end

		local localPosition = _UILogic:ScreenToLocalUIPosition(screenPoint, entity.UITransformComponent)
		local rectSize = entity.UITransformComponent.RectSize
		return math.abs(localPosition.x) <= rectSize.x * 0.5 and math.abs(localPosition.y) <= rectSize.y * 0.5
	end

	@ExecSpace("ClientOnly")
	method void MoveGhostToTouch(Vector2 screenPoint)
		local ghost = self:GetChainEntity("DragGhost")
		if ghost == nil or ghost.UITransformComponent == nil then
			return
		end

		local uiPosition = _UILogic:ScreenToUIPosition(screenPoint)
		ghost.UITransformComponent.anchoredPosition = uiPosition
	end

	@ExecSpace("ClientOnly")
	method void RenderChain()
		-- Renders the chain as icon-only slots with tier frames.
		local slots = self._T.chainSlots
		for slotIndex = 1, self:GetChainSlotCount() do
			local labelPath = "Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Label"
			local tierPath = "Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Tier"
			local record = nil
			if slots ~= nil then
				record = slots[slotIndex]
			end
			self:SetChainTextByPath(labelPath, "")
			self:SetChainTextByPath(tierPath, "")
			self:RenderChainSlotVisual(slotIndex, record)
		end
	end

	@ExecSpace("ClientOnly")
	method void RenderBag()
		-- Renders spare skill parts as icon-only inventory slots.
		for index = 1, self:GetBagSlotCount() do
			local part = self:GetBagPart(index)
			if part == nil then
				self:SetInventoryItemActive(index, true)
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Label", "")
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Name", "")
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Equipped", "")
				self:RenderBagSlotVisual(index, nil, false)
			else
				self:SetInventoryItemActive(index, true)
				local equippedSlot = math.floor(self:ReadNumber(part.EquippedSlot, 0))
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Label", "")
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Name", "")
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Equipped", "")
				self:RenderBagSlotVisual(index, part, equippedSlot > 0)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RenderChainSlotVisual(number slotIndex, any record)
		-- Applies icon, base tint, and tier frame to one chain slot.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		local basePath = "Panel/Chain/Slot_" .. tostring(safeSlotIndex)
		if self:IsLockedChainSlotRecord(record) == true then
			self:SetSkillSlotVisual("CHAIN", basePath, "Default", 0, false, false, false)
			self:SetVisualSpriteColor("CHAIN", basePath, Color(0.035, 0.04, 0.055, 0.82))
			self:SetSlotFrameColor("CHAIN", basePath, Color(0.78, 0.82, 0.9, 0.62))
			return
		end
		local occupied = record ~= nil and self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0
		local isLead = false
		local displayTier = 1
		local skillKey = "Default"
		if occupied == true then
			isLead = self:IsLeadChainSlot(safeSlotIndex, record)
			displayTier = self:GetChainDisplayTier(safeSlotIndex, record)
			skillKey = self:GetRecordSkillKey(record)
		else
			displayTier = 0
		end
		self:SetSkillSlotVisual("CHAIN", basePath, skillKey, displayTier, occupied, isLead, false)
	end

	@ExecSpace("ClientOnly")
	method void RenderBagSlotVisual(number bagIndex, any part, boolean equipped)
		-- Applies icon, base tint, and equipped frame to one spare slot.
		local safeBagIndex = math.floor(self:ReadNumber(bagIndex, 0))
		local occupied = part ~= nil and self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0) > 0
		local skillKey = "Default"
		if occupied == true then
			skillKey = self:GetRecordSkillKey(part)
		end
		self:SetSkillSlotVisual("BAG", "Panel/Inventory/Item_" .. tostring(safeBagIndex), skillKey, 1, occupied, false, equipped == true)
	end

	@ExecSpace("ClientOnly")
	method void RenderDragGhostVisual(any record, number tier, boolean isLeadSlot)
		-- Applies the dragged skill icon to the floating ghost.
		local occupied = record ~= nil and self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0
		local skillKey = "Default"
		if occupied == true then
			skillKey = self:GetRecordSkillKey(record)
		end
		self:SetChainTextByPath("DragGhost/Label", "")
		self:SetSkillSlotVisual("CHAIN", "DragGhost", skillKey, self:ReadNumber(tier, 1), occupied, isLeadSlot == true, false)
	end

	@ExecSpace("ClientOnly")
	method void SetSkillSlotVisual(string rootKind, string basePath, string skillKey, number tier, boolean occupied, boolean isLeadSlot, boolean equipped)
		-- Updates the visual entities under a skill slot.
		local safeRootKind = self:ReadString(rootKind, "CHAIN")
		local safeBasePath = self:ReadString(basePath, "")
		local safeTier = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		local iconRuid = self:GetSlotIconRUID(skillKey, safeTier, isLeadSlot == true)
		local baseColor = self:GetSlotBaseColor(occupied == true, safeTier, equipped == true)
		local borderColor = self:GetSlotBorderColor(safeTier, occupied == true, isLeadSlot == true)
		local iconColor = self:GetSlotIconColor(safeTier, occupied == true)

		if self:HasAuthoredBattleHudLayout() == true and safeRootKind == "CHAIN" then
			self:SetVisualSpriteColor(safeRootKind, safeBasePath, Color(1, 1, 1, 1))
		else
			self:SetVisualSpriteColor(safeRootKind, safeBasePath, baseColor)
		end
		self:SetVisualSpriteImage(safeRootKind, safeBasePath .. "/Icon", iconRuid)
		self:SetVisualSpriteColor(safeRootKind, safeBasePath .. "/Icon", iconColor)
		self:SetSlotFrameColor(safeRootKind, safeBasePath, borderColor)
	end

	@ExecSpace("ClientOnly")
	method void SetSlotFrameColor(string rootKind, string basePath, Color color)
		-- Colors the four thin frame sprites around a slot.
		self:SetVisualSpriteColor(rootKind, basePath .. "/FrameTop", color)
		self:SetVisualSpriteColor(rootKind, basePath .. "/FrameBottom", color)
		self:SetVisualSpriteColor(rootKind, basePath .. "/FrameLeft", color)
		self:SetVisualSpriteColor(rootKind, basePath .. "/FrameRight", color)
	end

	@ExecSpace("ClientOnly")
	method void SetVisualSpriteImage(string rootKind, string relativePath, string ruid)
		-- Assigns a UI sprite RUID through the correct root group.
		local entity = self:GetVisualEntity(rootKind, relativePath)
		if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.ImageRUID = DataRef(self:ReadString(ruid, self:GetFallbackIconRUID()))
		end
	end

	@ExecSpace("ClientOnly")
	method void SetVisualSpriteColor(string rootKind, string relativePath, Color color)
		-- Assigns a UI sprite tint through the correct root group.
		local entity = self:GetVisualEntity(rootKind, relativePath)
		self:SetSpriteColor(entity, color)
	end

	method Entity GetVisualEntity(string rootKind, string relativePath)
		-- Resolves a visual entity from the chain or inventory group.
		if self:ReadString(rootKind, "CHAIN") == "BAG" then
			return self:GetInventoryEntity(relativePath)
		end
		return self:GetChainEntity(relativePath)
	end

	method string GetSlotIconRUID(string skillKey, number tier, boolean isLeadSlot)
		-- Reads icon RUID data from the temporary skill UI database.
		if _BRSkillUIDatabase ~= nil then
			return _BRSkillUIDatabase:GetSlotIconRUID(self:GetBaseSkillKey(skillKey), tier, isLeadSlot == true)
		end
		return self:GetFallbackIconRUID()
	end

	method Color GetSlotBaseColor(boolean occupied, number tier, boolean equipped)
		-- Reads slot base tint data from the temporary skill UI database.
		if _BRSkillUIDatabase ~= nil then
			return _BRSkillUIDatabase:GetSlotBaseColor(occupied == true, tier, equipped == true)
		end
		if occupied ~= true then
			return Color(0.055, 0.07, 0.1, 0.72)
		end
		if equipped == true then
			return Color(0.09, 0.16, 0.14, 0.92)
		end
		return Color(0.08, 0.12, 0.18, 0.94)
	end

	method Color GetSlotBorderColor(number tier, boolean occupied, boolean isLeadSlot)
		-- Reads tier frame color data from the temporary skill UI database.
		if _BRSkillUIDatabase ~= nil then
			return _BRSkillUIDatabase:GetSlotBorderColor(tier, occupied == true, isLeadSlot == true)
		end
		if occupied ~= true then
			return Color(0.28, 0.34, 0.43, 0.42)
		end
		if tier >= 2 then
			return Color(1.0, 0.82, 0.22, 1.0)
		end
		return Color(0.34, 0.48, 0.68, 0.82)
	end

	method Color GetSlotIconColor(number tier, boolean occupied)
		-- Reads icon tint data from the temporary skill UI database.
		if _BRSkillUIDatabase ~= nil then
			return _BRSkillUIDatabase:GetIconColor(tier, occupied == true)
		end
		if occupied ~= true then
			return Color(1, 1, 1, 0)
		end
		return Color(1, 1, 1, 0.96)
	end

	method boolean IsLeadChainSlot(number slotIndex, any record)
		-- Returns true for the first visible slot in a folded same-skill run.
		if record == nil or self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) <= 0 then
			return false
		end
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 1 then
			return true
		end
		local previous = self:GetChainSlot(safeSlotIndex - 1)
		if previous == nil or self:ReadNumber(self:ReadRecordValue(previous, "InstanceId"), 0) <= 0 then
			return true
		end
		return self:GetBaseSkillKey(self:GetRecordSkillKey(previous)) ~= self:GetBaseSkillKey(self:GetRecordSkillKey(record))
	end

	method number GetChainDisplayTier(number slotIndex, any record)
		-- Uses the final folded tier on a run's first slot, and the local tier on follower slots.
		if record == nil then
			return 1
		end
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		local tier = math.max(1, math.floor(self:ReadNumber(self:ReadRecordValue(record, "Tier"), 1)))
		if self:IsLeadChainSlot(safeSlotIndex, record) ~= true then
			return tier
		end

		local baseKey = self:GetBaseSkillKey(self:GetRecordSkillKey(record))
		local maxTier = tier
		for nextSlot = safeSlotIndex + 1, self:GetChainSlotCount() do
			local nextRecord = self:GetChainSlot(nextSlot)
			if nextRecord == nil or self:ReadNumber(self:ReadRecordValue(nextRecord, "InstanceId"), 0) <= 0 then
				break
			end
			if self:GetBaseSkillKey(self:GetRecordSkillKey(nextRecord)) ~= baseKey then
				break
			end
			local nextTier = math.max(1, math.floor(self:ReadNumber(self:ReadRecordValue(nextRecord, "Tier"), 1)))
			if nextTier > maxTier then
				maxTier = nextTier
			end
		end
		return maxTier
	end

	method string GetRecordSkillKey(any record)
		-- Reads the base skill key from a chain or bag record.
		if record == nil then
			return "Default"
		end
		return self:GetBaseSkillKey(self:ReadString(self:ReadRecordValue(record, "SkillKey"), self:InferSkillKey(self:ReadRecordValue(record, "Short"), self:ReadRecordValue(record, "DisplayName"))))
	end

	method boolean IsLockedChainSlotRecord(any record)
		-- Returns true for server-provided locked chain slot placeholders.
		if record == nil then
			return false
		end
		local tier = math.floor(self:ReadNumber(self:ReadRecordValue(record, "Tier"), 0))
		local skillKey = self:ReadString(self:ReadRecordValue(record, "SkillKey"), "")
		local displayName = self:ReadString(self:ReadRecordValue(record, "DisplayName"), "")
		return tier < 0 or skillKey == "LOCKED" or displayName == "LOCKED"
	end

	method boolean IsChainSlotLocked(number slotIndex)
		-- Checks whether the local snapshot marks one chain slot as locked.
		return self:IsLockedChainSlotRecord(self:GetChainSlot(slotIndex))
	end

	method string InferSkillKey(any shortText, any displayName)
		-- Old snapshots without SkillKey cannot be safely mapped after CSV migration.
		return "Default"
	end

	method string GetBaseSkillKey(string skillKey)
		-- Normalizes tiered runtime keys back to their base catalog key.
		local key = self:ReadString(skillKey, "Default")
		key = self:ReadString(string.match(key, "^(.-)%d*$"), key)
		if key == "" or key == "-" then
			return "Default"
		end
		return key
	end

	method string GetFallbackIconRUID()
		-- Returns a safe placeholder RUID when the icon database is unavailable.
		return "4fea64a3307cda641809ad8be0d4890b"
	end

	method any ParseChainText(string text)
		local result = {}
		for record in string.gmatch(self:ReadString(text, ""), "([^;]+)") do
			local parts = self:SplitCommaRecord(record)
			local slotIndex = math.floor(self:ReadNumber(parts[1], 0))
			if slotIndex > 0 then
				result[slotIndex] = {
					Slot = slotIndex,
					InstanceId = math.floor(self:ReadNumber(parts[2], 0)),
					Short = self:ReadString(parts[3], "-"),
					Tier = math.floor(self:ReadNumber(parts[4], 0)),
					DisplayName = self:ReadString(parts[5], "-"),
					SkillKey = self:ReadString(parts[6], self:InferSkillKey(parts[3], parts[5]))
				}
			end
		end
		return result
	end

	method any ParseBagText(string text)
		local result = {}
		for record in string.gmatch(self:ReadString(text, ""), "([^;]+)") do
			local parts = self:SplitCommaRecord(record)
			local slotIndex = #result + 1
			local instanceId = math.floor(self:ReadNumber(parts[1], 0))
			local shortIndex = 2
			local tierIndex = 4
			local displayIndex = 5
			local skillKeyIndex = 6
			if tonumber(parts[2]) ~= nil then
				slotIndex = math.floor(self:ReadNumber(parts[1], 0))
				instanceId = math.floor(self:ReadNumber(parts[2], 0))
				shortIndex = 3
				tierIndex = 4
				displayIndex = 5
				skillKeyIndex = 6
			end
			if instanceId > 0 then
				result[slotIndex] = {
					InstanceId = instanceId,
					Short = self:ReadString(parts[shortIndex], "P"),
					EquippedSlot = 0,
					Tier = math.floor(self:ReadNumber(parts[tierIndex], 0)),
					DisplayName = self:ReadString(parts[displayIndex], "Skill"),
					SkillKey = self:ReadString(parts[skillKeyIndex], self:InferSkillKey(parts[shortIndex], parts[displayIndex]))
				}
			end
		end
		return result
	end

	method any GetChainSlot(number slotIndex)
		local slots = self._T.chainSlots
		if slots == nil then
			return nil
		end
		return slots[math.floor(self:ReadNumber(slotIndex, 0))]
	end

	method any ReadRecordValue(any record, string key)
		if record == nil then
			return nil
		end
		return record[key]
	end

	method any GetBagPart(number bagIndex)
		local parts = self._T.bagParts
		if parts == nil then
			return nil
		end
		local part = parts[math.floor(self:ReadNumber(bagIndex, 0))]
		if part == nil or math.floor(self:ReadNumber(part.InstanceId, 0)) <= 0 then
			return nil
		end
		return part
	end

	@ExecSpace("ClientOnly")
	method void SetInventoryItemActive(number bagIndex, boolean active)
		local indexText = tostring(math.floor(self:ReadNumber(bagIndex, 0)))
		local tile = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText)
		local touch = self:GetBagTouchEntity(bagIndex)
		if tile ~= nil then
			tile.Enable = active == true
		end
		if touch ~= nil then
			touch.Enable = active == true
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearEquippedBagPart(number bagIndex)
		local part = self:GetBagPart(bagIndex)
		if part == nil then
			return
		end
		local equippedSlot = self:GetLocalEquippedSlotForBagPart(part)
		if equippedSlot > 0 then
			self:RequestClearSlot(equippedSlot)
			return
		end
		self:Log("bag right click ignored bag=" .. tostring(math.floor(self:ReadNumber(bagIndex, 0))) .. " reason=alreadySpare")
	end

	@ExecSpace("ClientOnly")
	method void RequestClearSlot(number slotIndex)
		local index = math.floor(self:ReadNumber(slotIndex, 0))
		if index <= 0 or _BRSkillSystem == nil then
			return
		end
		if self:FindFirstEmptyLocalBagSlot() <= 0 then
			self:Log("clear slot skipped slot=" .. tostring(index) .. " reason=noInventorySpace")
			return
		end
		_BRSkillSystem:RequestClearChainSlot(self:GetLocalUserId(), index)
		self:ApplyLocalClearSlot(index)
		self.nextRequestAt = 0
		self:Log("clear slot=" .. tostring(index))
	end

	@ExecSpace("ClientOnly")
	method void RequestClearPartInstance(number instanceId)
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 or _BRSkillSystem == nil then
			return
		end
		_BRSkillSystem:RequestClearPartInstanceFromChain(self:GetLocalUserId(), safeInstanceId)
		self:ApplyLocalClearPartInstance(safeInstanceId)
		self.nextRequestAt = 0
		self:Log("clear instance=" .. tostring(safeInstanceId))
	end

	@ExecSpace("ClientOnly")
	method void HandleBagPartClick(number instanceId, number sourceBagIndex)
		local bagIndex = math.floor(self:ReadNumber(sourceBagIndex, 0))
		local part = self:GetBagPart(bagIndex)
		local equippedSlot = self:GetLocalEquippedSlotForBagPart(part)
		if equippedSlot > 0 then
			self:RequestClearSlot(equippedSlot)
			self:Log("bag click clear bag=" .. tostring(bagIndex) .. " slot=" .. tostring(equippedSlot))
			return
		end
		self:RequestEquipPartToFirstEmptySlot(instanceId, bagIndex)
	end

	@ExecSpace("ClientOnly")
	method void RequestEquipPartToFirstEmptySlot(number instanceId, number sourceBagIndex)
		local targetSlot = self:FindFirstEmptyLocalChainSlot()
		if targetSlot <= 0 then
			self:Log("click insert skipped instance=" .. tostring(instanceId) .. " bag=" .. tostring(sourceBagIndex) .. " reason=chainFull")
			return
		end
		self:RequestEquipPartToSlot(instanceId, targetSlot, "click")
	end

	@ExecSpace("ClientOnly")
	method void RequestEquipPartToSlot(number instanceId, number targetSlot, string reason)
		if _BRSkillSystem == nil then
			return
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local safeSlot = math.floor(self:ReadNumber(targetSlot, 0))
		if safeInstanceId <= 0 or safeSlot <= 0 then
			return
		end
		if self:IsChainSlotLocked(safeSlot) == true then
			self:Log("insert skipped instance=" .. tostring(safeInstanceId) .. " targetSlot=" .. tostring(safeSlot) .. " reason=locked")
			return
		end
		_BRSkillSystem:RequestEquipPartToChainSlot(self:GetLocalUserId(), safeInstanceId, safeSlot)
		self:ApplyLocalEquipPartToSlot(safeInstanceId, safeSlot)
		self.nextRequestAt = 0
		self:Log("insert " .. self:ReadString(reason, "request") .. " instance=" .. tostring(safeInstanceId) .. " targetSlot=" .. tostring(safeSlot))
	end

	@ExecSpace("ClientOnly")
	method void RequestMovePartToBagSlot(number instanceId, number targetBagSlot, string reason)
		if _BRSkillSystem == nil then
			return
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local safeBagSlot = math.floor(self:ReadNumber(targetBagSlot, 0))
		if safeInstanceId <= 0 or safeBagSlot <= 0 then
			return
		end
		_BRSkillSystem:RequestMovePartToBagSlot(self:GetLocalUserId(), safeInstanceId, safeBagSlot)
		self:ApplyLocalMovePartToBagSlot(safeInstanceId, safeBagSlot)
		self.nextRequestAt = 0
		self:Log("bag move " .. self:ReadString(reason, "request") .. " instance=" .. tostring(safeInstanceId) .. " targetBag=" .. tostring(safeBagSlot))
	end

	@ExecSpace("ClientOnly")
	method void RequestDropPartToWorld(number instanceId, string reason)
		-- Requests a Maple-style world drop when a skill part is released outside valid slots.
		if _BRSkillSystem == nil then
			return
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return
		end
		_BRSkillSystem:RequestDropPartToWorld(self:GetLocalUserId(), safeInstanceId)
		self:ApplyLocalDropPart(safeInstanceId)
		self.nextRequestAt = 0
		self:Log("world drop " .. self:ReadString(reason, "request") .. " instance=" .. tostring(safeInstanceId))
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalEquipPartToSlot(number instanceId, number targetSlot)
		-- Moves one visible bag part into a local chain slot while waiting for the server snapshot.
		self:EnsureRuntime()
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local safeSlot = math.floor(self:ReadNumber(targetSlot, 0))
		if safeInstanceId <= 0 or safeSlot <= 0 then
			return
		end
		if self:IsChainSlotLocked(safeSlot) == true then
			return
		end

		if self._T.chainSlots == nil then
			self._T.chainSlots = {}
		end

		local sourceBagIndex = self:FindLocalBagIndexByInstanceId(safeInstanceId)
		local bagPart = self:FindLocalBagPartByInstanceId(safeInstanceId)
		if bagPart == nil then
			local existingSlot = self:FindLocalChainSlotByInstanceId(safeInstanceId)
			if existingSlot > 0 then
				bagPart = self:BuildBagPartFromChainRecord(self:GetChainSlot(existingSlot))
			end
		end

		local previousRecord = self._T.chainSlots[safeSlot]
		if previousRecord ~= nil then
			local previousInstanceId = math.floor(self:ReadNumber(self:ReadRecordValue(previousRecord, "InstanceId"), 0))
			if previousInstanceId > 0 and previousInstanceId ~= safeInstanceId then
				if sourceBagIndex > 0 then
					self._T.bagParts[sourceBagIndex] = self:BuildBagPartFromChainRecord(previousRecord)
				else
					self:AppendLocalBagPart(self:BuildBagPartFromChainRecord(previousRecord))
				end
			end
		end

		for slotIndex = 1, self:GetChainSlotCount() do
			local record = self._T.chainSlots[slotIndex]
			if record ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0)) == safeInstanceId then
				self._T.chainSlots[slotIndex] = nil
			end
		end

		self._T.chainSlots[safeSlot] = {
			Slot = safeSlot,
			InstanceId = safeInstanceId,
			Short = self:ReadString(self:ReadRecordValue(bagPart, "Short"), "S"),
			Tier = 1,
			DisplayName = self:ReadString(self:ReadRecordValue(bagPart, "DisplayName"), "Skill"),
			SkillKey = self:GetRecordSkillKey(bagPart)
		}
		self:RemoveLocalBagPartByInstanceId(safeInstanceId)
		self:RenderChain()
		self:RenderBag()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalClearSlot(number slotIndex)
		-- Moves one local chain slot back into the visible spare bag.
		self:EnsureRuntime()
		local safeSlot = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlot <= 0 or self._T.chainSlots == nil then
			return
		end

		local record = self._T.chainSlots[safeSlot]
		if record ~= nil then
			self:AppendLocalBagPart(self:BuildBagPartFromChainRecord(record))
		end
		self._T.chainSlots[safeSlot] = nil
		self:RenderChain()
		self:RenderBag()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalMovePartToBagSlot(number instanceId, number targetBagSlot)
		-- Moves one local chain or bag part into a spare bag slot while waiting for the server snapshot.
		self:EnsureRuntime()
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local safeBagSlot = math.floor(self:ReadNumber(targetBagSlot, 0))
		if safeInstanceId <= 0 or safeBagSlot <= 0 then
			return
		end
		if safeBagSlot > self:GetBagSlotCount() then
			safeBagSlot = self:GetBagSlotCount()
		end

		local sourceChainSlot = self:FindLocalChainSlotByInstanceId(safeInstanceId)
		local sourceBagSlot = self:FindLocalBagIndexByInstanceId(safeInstanceId)
		local sourceBagPart = self:GetBagPart(sourceBagSlot)
		local targetBagPart = self:GetBagPart(safeBagSlot)
		if sourceChainSlot > 0 then
			local sourceRecord = self:GetChainSlot(sourceChainSlot)
			if targetBagPart ~= nil then
				self._T.chainSlots[sourceChainSlot] = self:BuildChainRecordFromBagPart(targetBagPart, sourceChainSlot)
			else
				self._T.chainSlots[sourceChainSlot] = nil
			end
			self._T.bagParts[safeBagSlot] = self:BuildBagPartFromChainRecord(sourceRecord)
		elseif sourceBagSlot > 0 and sourceBagSlot ~= safeBagSlot then
			self._T.bagParts[sourceBagSlot] = targetBagPart
			self._T.bagParts[safeBagSlot] = sourceBagPart
		else
			return
		end
		self:RenderChain()
		self:RenderBag()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalClearPartInstance(number instanceId)
		-- Clears one local chain record by part instance id.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return
		end

		local slotIndex = self:FindLocalChainSlotByInstanceId(safeInstanceId)
		if slotIndex > 0 then
			self:ApplyLocalClearSlot(slotIndex)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalDropPart(number instanceId)
		-- Removes a locally visible part after a world-drop request.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return
		end
		local slotIndex = self:FindLocalChainSlotByInstanceId(safeInstanceId)
		if slotIndex > 0 and self._T.chainSlots ~= nil then
			self._T.chainSlots[slotIndex] = nil
		end
		self:RemoveLocalBagPartByInstanceId(safeInstanceId)
		self:RenderChain()
		self:RenderBag()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalMoveChainSlot(number fromSlot, number toSlot)
		-- Moves or swaps two local chain slots while waiting for the server snapshot.
		self:EnsureRuntime()
		local fromIndex = math.floor(self:ReadNumber(fromSlot, 0))
		local toIndex = math.floor(self:ReadNumber(toSlot, 0))
		if fromIndex <= 0 or toIndex <= 0 or fromIndex == toIndex then
			return
		end
		if self:IsChainSlotLocked(fromIndex) == true or self:IsChainSlotLocked(toIndex) == true then
			return
		end
		if self._T.chainSlots == nil then
			self._T.chainSlots = {}
		end

		local sourceRecord = self._T.chainSlots[fromIndex]
		if sourceRecord == nil then
			return
		end

		local targetRecord = self._T.chainSlots[toIndex]
		self._T.chainSlots[toIndex] = sourceRecord
		self._T.chainSlots[toIndex].Slot = toIndex
		self._T.chainSlots[fromIndex] = targetRecord
		if self._T.chainSlots[fromIndex] ~= nil then
			self._T.chainSlots[fromIndex].Slot = fromIndex
		end
		self:RenderChain()
	end

	method number FindFirstEmptyLocalChainSlot()
		local slots = self._T.chainSlots
		for slotIndex = 1, self:GetChainSlotCount() do
			local record = nil
			if slots ~= nil then
				record = slots[slotIndex]
			end
			if self:IsLockedChainSlotRecord(record) ~= true and (record == nil or self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) <= 0) then
				return slotIndex
			end
		end
		return 0
	end

	method any FindLocalBagPartByInstanceId(number instanceId)
		-- Finds one visible spare bag record by instance id.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local parts = self._T.bagParts
		if safeInstanceId <= 0 or parts == nil then
			return nil
		end
		for index = 1, self:GetBagSlotCount() do
			local part = parts[index]
			if part ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0)) == safeInstanceId then
				return part
			end
		end
		return nil
	end

	method number FindLocalBagIndexByInstanceId(number instanceId)
		-- Finds the visible spare bag slot index for one part instance.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local parts = self._T.bagParts
		if safeInstanceId <= 0 or parts == nil then
			return 0
		end
		for index = 1, self:GetBagSlotCount() do
			local part = parts[index]
			if part ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0)) == safeInstanceId then
				return index
			end
		end
		return 0
	end

	method void RemoveLocalBagPartByInstanceId(number instanceId)
		-- Removes one visible spare bag record by instance id.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local parts = self._T.bagParts
		if safeInstanceId <= 0 or parts == nil then
			return
		end
		for index = 1, self:GetBagSlotCount() do
			local part = parts[index]
			if part ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0)) == safeInstanceId then
				parts[index] = nil
			end
		end
	end

	method void AppendLocalBagPart(any part)
		-- Appends one unequipped part to the visible spare bag if it is not already present.
		if part == nil then
			return
		end
		self:EnsureRuntime()
		local instanceId = math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0))
		if instanceId <= 0 or self:FindLocalBagPartByInstanceId(instanceId) ~= nil then
			return
		end
		local bagSlot = self:FindFirstEmptyLocalBagSlot()
		if bagSlot <= 0 then
			self:Log("append bag skipped instance=" .. tostring(instanceId) .. " reason=noInventorySpace")
			return
		end
		self._T.bagParts[bagSlot] = {
			InstanceId = instanceId,
			Short = self:ReadString(self:ReadRecordValue(part, "Short"), "S"),
			EquippedSlot = 0,
			Tier = 1,
			DisplayName = self:ReadString(self:ReadRecordValue(part, "DisplayName"), "Skill"),
			SkillKey = self:GetRecordSkillKey(part)
		}
	end

	method any BuildBagPartFromChainRecord(any record)
		-- Converts one chain slot record into an unequipped bag record.
		if record == nil then
			return nil
		end
		local instanceId = math.floor(self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0))
		if instanceId <= 0 then
			return nil
		end
		return {
			InstanceId = instanceId,
			Short = self:ReadString(self:ReadRecordValue(record, "Short"), "S"),
			EquippedSlot = 0,
			Tier = 1,
			DisplayName = self:ReadString(self:ReadRecordValue(record, "DisplayName"), "Skill"),
			SkillKey = self:GetRecordSkillKey(record)
		}
	end

	method any BuildChainRecordFromBagPart(any part, number slotIndex)
		-- Converts one spare bag record into a chain slot record.
		if part == nil then
			return nil
		end
		local instanceId = math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0))
		if instanceId <= 0 then
			return nil
		end
		return {
			Slot = math.floor(self:ReadNumber(slotIndex, 0)),
			InstanceId = instanceId,
			Short = self:ReadString(self:ReadRecordValue(part, "Short"), "S"),
			Tier = 1,
			DisplayName = self:ReadString(self:ReadRecordValue(part, "DisplayName"), "Skill"),
			SkillKey = self:GetRecordSkillKey(part)
		}
	end

	method number FindFirstEmptyLocalBagSlot()
		-- Finds the first empty visible spare slot.
		self:EnsureRuntime()
		for index = 1, self:GetBagSlotCount() do
			if self:GetBagPart(index) == nil then
				return index
			end
		end
		return 0
	end

	method number GetLocalEquippedSlotForBagPart(any part)
		if part == nil then
			return 0
		end
		local equippedSlot = math.floor(self:ReadNumber(part.EquippedSlot, 0))
		if equippedSlot > 0 then
			return equippedSlot
		end
		local instanceId = math.floor(self:ReadNumber(part.InstanceId, 0))
		return self:FindLocalChainSlotByInstanceId(instanceId)
	end

	method number FindLocalChainSlotByInstanceId(number instanceId)
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return 0
		end
		local slots = self._T.chainSlots
		if slots == nil then
			return 0
		end
		for slotIndex = 1, self:GetChainSlotCount() do
			local record = slots[slotIndex]
			if record ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0)) == safeInstanceId then
				return slotIndex
			end
		end
		return 0
	end

	method void ResetDrag()
		self.draggingInstanceId = 0
		self.draggingSourceSlot = 0
		self.draggingSourceBagIndex = 0
		self.draggingStartX = 0
		self.draggingStartY = 0
		self.draggingMoved = false
		self.draggingLabel = ""
	end

	method boolean IsRightClick(number touchId)
		return math.floor(self:ReadNumber(touchId, 0)) == -3
	end

	method string FormatSkillTierText(string displayName, number tier)
		local order = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		return self:ReadString(displayName, "Skill") .. " " .. tostring(order) .. "차"
	end

	method string FormatSkillIconText(string shortText, number tier)
		-- Returns compact text that fits inside one square skill icon.
		local order = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		return self:ReadString(shortText, "S") .. "\n" .. tostring(order) .. "차"
	end

	method any SplitCommaRecord(string record)
		local parts = {}
		for part in string.gmatch(self:ReadString(record, ""), "([^,]+)") do
			table.insert(parts, part)
		end
		return parts
	end

	method Entity GetChainTouchEntity(number slotIndex)
		local indexText = tostring(math.floor(self:ReadNumber(slotIndex, 0)))
		local touch = self:GetChainEntity("Panel/Chain/SlotTouch_" .. indexText)
		if touch ~= nil then
			return touch
		end
		touch = self:GetChainEntity("Panel/Chain/Slot_" .. indexText .. "/Touch")
		if touch ~= nil then
			return touch
		end
		return self:GetChainEntity("Panel/Chain/Slot_" .. indexText)
	end

	method Entity GetBagTouchEntity(number bagIndex)
		local indexText = tostring(math.floor(self:ReadNumber(bagIndex, 0)))
		local touch = self:GetInventoryEntity("Panel/Inventory/ItemTouch_" .. indexText)
		if touch ~= nil then
			return touch
		end
		touch = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText .. "/Touch")
		if touch ~= nil then
			return touch
		end
		touch = self:GetEntityFromRoot(self:GetChainRootPath(), "Panel/Bag/Part_" .. indexText)
		if touch ~= nil then
			return touch
		end
		return self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText)
	end

	method Entity GetEntity(string relativePath)
		return self:GetChainEntity(relativePath)
	end

	method Entity GetChainEntity(string relativePath)
		local entity = self:GetEntityFromRoot(self:GetChainRootPath(), relativePath)
		if entity ~= nil then
			return entity
		end
		return self:GetBattleHudAliasEntity(relativePath)
	end

	method Entity GetInventoryEntity(string relativePath)
		return self:GetEntityFromRoot(self:GetInventoryRootPath(), relativePath)
	end

	method Entity GetEntityFromRoot(string rootPath, string relativePath)
		local path = self:ReadString(relativePath, "")
		if path == "" then
			return nil
		end
		if self:IsForSavePath(path) == true then
			return nil
		end
		if string.sub(path, 1, 1) ~= "/" then
			path = self:ReadString(rootPath, self:GetChainRootPath()) .. "/" .. path
		end
		if self:IsForSavePath(path) == true then
			return nil
		end
		return _EntityService:GetEntityByPath(path)
	end

	method Entity GetBattleHudAliasEntity(string relativePath)
		local aliasPath = self:GetBattleHudAliasRelativePath(relativePath)
		if aliasPath == "" then
			return nil
		end
		return self:GetEntityFromRoot(self:GetChainRootPath(), aliasPath)
	end

	method string GetBattleHudAliasRelativePath(string relativePath)
		local path = self:ReadString(relativePath, "")
		if path == "" or self:IsForSavePath(path) == true then
			return ""
		end
		if string.sub(path, 1, 1) == "/" then
			return ""
		end
		if path == "Panel" or path == "Panel/Bg" or path == "Panel/Chain" then
			return "Bg"
		end
		if self:StartsWith(path, "Panel/Chain/SlotTouch_") == true then
			return self:GetBattleHudSlotAlias(path, "Panel/Chain/SlotTouch_")
		end
		if self:StartsWith(path, "Panel/Chain/Slot_") == true then
			return self:GetBattleHudSlotAlias(path, "Panel/Chain/Slot_")
		end
		if self:StartsWith(path, "Panel/Chain/Common_") == true then
			return "Bg/Common_" .. string.sub(path, string.len("Panel/Chain/Common_") + 1)
		end
		if path == "Panel/HudLevelText" then
			return "Bg/HudLevelText"
		end
		if path == "Panel/HudHpFill" or path == "Panel/HudHpBack" then
			return "Bg/HudHpFill"
		end
		if path == "Panel/HudExpFill" or path == "Panel/HudExpBack" then
			return "Bg/HudExpFill"
		end
		return ""
	end

	method string GetBattleHudSlotAlias(string path, string prefix)
		local safePath = self:ReadString(path, "")
		local safePrefix = self:ReadString(prefix, "")
		for index = 7, 1, -1 do
			local token = safePrefix .. tostring(index)
			if self:StartsWith(safePath, token) == true then
				local suffix = string.sub(safePath, string.len(token) + 1)
				if index == 1 then
					return "Bg/SkillChain_5" .. suffix
				end
				return "Bg/ChainPart_" .. tostring(index - 1) .. suffix
			end
		end
		return ""
	end

	method boolean IsForSavePath(string path)
		return string.find(self:ReadString(path, ""), "ForSave") ~= nil
	end

	@ExecSpace("ClientOnly")
	method void SetChainTextByPath(string relativePath, string text)
		local entity = self:GetChainEntity(relativePath)
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetInventoryTextByPath(string relativePath, string text)
		local entity = self:GetInventoryEntity(relativePath)
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetSpriteColor(Entity entity, Color color)
		if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.Color = color
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplySlotOnlyLayout()
		-- Hides static labels so the skill-chain UI is composed only of slots.
		if self:HasAuthoredBattleHudLayout() == true then
			return
		end
		self:SetChainTextByPath("Panel/Title", "")
		self:SetChainTextByPath("Panel/Stats", "")
		self:SetChainTextByPath("DragGhost/Label", "")
		self:SetChainEntityEnabled("Panel/Bg", false)
		self:SetChainEntityEnabled("Panel/Title", false)
		self:SetChainEntityEnabled("Panel/Stats", false)
		self:SetChainEntityEnabled("DragGhost/Label", false)
		for slotIndex = 1, self:GetChainSlotCount() do
			self:SetChainTextByPath("Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Label", "")
			self:SetChainTextByPath("Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Tier", "")
			self:SetChainEntityEnabled("Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Label", false)
			self:SetChainEntityEnabled("Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Tier", false)
		end

		self:SetInventoryTextByPath("Panel/Title", "")
		self:SetInventoryEntityEnabled("Panel/Bg", false)
		self:SetInventoryEntityEnabled("Panel/Title", false)
		for index = 1, self:GetBagSlotCount() do
			self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Label", "")
			self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Name", "")
			self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Equipped", "")
			self:SetInventoryEntityEnabled("Panel/Inventory/Item_" .. tostring(index) .. "/Label", false)
			self:SetInventoryEntityEnabled("Panel/Inventory/Item_" .. tostring(index) .. "/Name", false)
			self:SetInventoryEntityEnabled("Panel/Inventory/Item_" .. tostring(index) .. "/Equipped", false)
		end
	end

	@ExecSpace("ClientOnly")
	method void EnsureBattleHudLayout()
		-- Rebuilds the skill chain panel as a compact bottom battle HUD.
		if self.EnableBattleHudLayout ~= true then
			return
		end
		self:ApplyBattleHudScale()
		if self:HasAuthoredBattleHudLayout() == true then
			self:EnsureCommonSkillSlots()
			self:RefreshCommonSkillSlots()
			self:RefreshBattleHud(_UserService.LocalPlayer)
			self:Log("authored battle hud scale=" .. tostring(self:GetBattleHudScale()))
			return
		end
		self:EnsureCommonSkillSlots()
		self:ApplyBattleHudPanelLayout()
		self:ApplyBattleHudSlotLayout()
		self:RefreshCommonSkillSlots()
		self:RefreshBattleHud(_UserService.LocalPlayer)
		self:ApplyAttachedInventoryLayout()
	end

	@ExecSpace("ClientOnly")
	method void ApplyBattleHudPanelLayout()
		if self:HasAuthoredBattleHudLayout() == true then
			return
		end
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return
		end
		if panel.UITransformComponent ~= nil then
			panel.UITransformComponent.AnchorsMin = Vector2(0.5, 0)
			panel.UITransformComponent.AnchorsMax = Vector2(0.5, 0)
			panel.UITransformComponent.Pivot = Vector2(0.5, 0)
			panel.UITransformComponent.RectSize = Vector2(self:GetHudPanelWidth(), self:GetHudPanelHeight())
			panel.UITransformComponent.anchoredPosition = Vector2(0, self:GetHudPanelY())
		end

		local chain = self:GetChainEntity("Panel/Chain")
		if chain ~= nil and chain.UITransformComponent ~= nil then
			chain.UITransformComponent.AnchorsMin = Vector2(0.5, 0.5)
			chain.UITransformComponent.AnchorsMax = Vector2(0.5, 0.5)
			chain.UITransformComponent.Pivot = Vector2(0.5, 0.5)
			chain.UITransformComponent.RectSize = Vector2(560, 64)
			chain.UITransformComponent.anchoredPosition = Vector2(250, -2)
		end

		self:SetChainEntityEnabled("Panel/Bg", true)
		self:SetVisualSpriteColor("CHAIN", "Panel/Bg", Color(0.025, 0.035, 0.055, 0.88))
	end

	@ExecSpace("ClientOnly")
	method void ApplyBattleHudSlotLayout()
		if self:HasAuthoredBattleHudLayout() == true then
			return
		end
		local size = self:GetHudSlotSize()
		local spacing = self:GetHudSlotSpacing()
		local startX = -128
		for slotIndex = 1, self:GetChainSlotCount() do
			local x = startX + (slotIndex - 1) * spacing
			self:ApplyHudSlotLayout("Panel/Chain/Slot_" .. tostring(slotIndex), x, 0, size)
		end

		local commonStartX = startX - spacing * 3 - 18
		for index = 1, self:GetCommonSkillSlotCount() do
			local x = commonStartX + (index - 1) * spacing
			self:ApplyHudSlotLayout("Panel/Chain/Common_" .. tostring(index), x, 0, size)
		end
	end

	@ExecSpace("ClientOnly")
	method void EnsureCommonSkillSlots()
		-- Uses statically authored common skill slots from the HUD UI file.
		for index = 1, self:GetCommonSkillSlotCount() do
			local name = "Common_" .. tostring(index)
			local slot = self:GetChainEntity("Panel/Chain/" .. name)
			if slot ~= nil then
				self:SetChainTextByPath("Panel/Chain/" .. name .. "/Label", "")
				self:SetChainTextByPath("Panel/Chain/" .. name .. "/Tier", "")
				self:SetChainEntityEnabled("Panel/Chain/" .. name .. "/Label", false)
				self:SetChainEntityEnabled("Panel/Chain/" .. name .. "/Tier", false)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyHudSlotLayout(string relativePath, number x, number y, number size)
		local path = self:ReadString(relativePath, "")
		local slot = self:GetChainEntity(path)
		if slot == nil then
			return
		end
		local safeSize = math.max(24, self:ReadNumber(size, self:GetHudSlotSize()))
		self:ApplyHudRect(slot, x, y, safeSize, safeSize, Vector2(0.5, 0.5))

		local icon = self:GetChainEntity(path .. "/Icon")
		if icon ~= nil then
			local iconSize = self:GetHudIconSize()
			self:ApplyHudRect(icon, 0, 0, iconSize, iconSize, Vector2(0.5, 0.5))
		end

		self:ApplyHudFrame(path, safeSize)
		local touch = self:GetChainEntity(path .. "/Touch")
		if touch ~= nil then
			self:ApplyHudRect(touch, 0, 0, safeSize, safeSize, Vector2(0.5, 0.5))
		end
		self:SetChainEntityEnabled(path .. "/Label", false)
		self:SetChainEntityEnabled(path .. "/Tier", false)
	end

	@ExecSpace("ClientOnly")
	method void ApplyHudFrame(string basePath, number size)
		local safeSize = math.max(24, self:ReadNumber(size, self:GetHudSlotSize()))
		local thickness = 3
		self:ApplyHudRect(self:GetChainEntity(basePath .. "/FrameTop"), 0, safeSize * 0.5 - thickness * 0.5, safeSize, thickness, Vector2(0.5, 0.5))
		self:ApplyHudRect(self:GetChainEntity(basePath .. "/FrameBottom"), 0, -safeSize * 0.5 + thickness * 0.5, safeSize, thickness, Vector2(0.5, 0.5))
		self:ApplyHudRect(self:GetChainEntity(basePath .. "/FrameLeft"), -safeSize * 0.5 + thickness * 0.5, 0, thickness, safeSize, Vector2(0.5, 0.5))
		self:ApplyHudRect(self:GetChainEntity(basePath .. "/FrameRight"), safeSize * 0.5 - thickness * 0.5, 0, thickness, safeSize, Vector2(0.5, 0.5))
	end

	@ExecSpace("ClientOnly")
	method void ApplyHudRect(Entity entity, number x, number y, number width, number height, Vector2 pivot)
		if entity == nil or entity.UITransformComponent == nil then
			return
		end
		entity.UITransformComponent.AnchorsMin = Vector2(0.5, 0.5)
		entity.UITransformComponent.AnchorsMax = Vector2(0.5, 0.5)
		entity.UITransformComponent.Pivot = pivot
		entity.UITransformComponent.RectSize = Vector2(math.max(1, self:ReadNumber(width, 1)), math.max(1, self:ReadNumber(height, 1)))
		entity.UITransformComponent.anchoredPosition = Vector2(self:ReadNumber(x, 0), self:ReadNumber(y, 0))
	end

	@ExecSpace("ClientOnly")
	method void RefreshCommonSkillSlots()
		if self.EnableBattleHudLayout ~= true then
			return
		end
		local uniqueSkillKey = "Unique"
		if _BRCharacterSystem ~= nil then
			uniqueSkillKey = _BRCharacterSystem:GetLocalUniqueSkillKey()
		end
		self:SetSkillSlotVisual("CHAIN", "Panel/Chain/Common_1", uniqueSkillKey, 1, true, false, false)
		self:SetSkillSlotVisual("CHAIN", "Panel/Chain/Common_2", "Blink", 1, true, false, false)
		self:SetSkillSlotVisual("CHAIN", "Panel/Chain/Common_3", "Nimbus", 1, true, false, false)
		if _BRCommonSkillSystem ~= nil and _BRCommonSkillSystem:IsLocalNimbusActive() == true then
			self:SetSlotFrameColor("CHAIN", "Panel/Chain/Common_3", Color(0.42, 0.95, 1.0, 1.0))
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshBattleHud(Entity localPlayer)
		if self.EnableBattleHudLayout ~= true or self.ShowBattleHudStatus ~= true then
			return
		end
		self:EnsureHudGauge("Hp", -246, 18, 212, 10, Color(0.94, 0.18, 0.3, 1))
		self:EnsureHudGauge("Exp", -246, -15, 212, 8, Color(0.98, 0.86, 0.18, 1))
		self:EnsureBattleHudText()

		local level = 1
		local exp = 0
		local expMax = 1
		if _BRSkillSystem ~= nil then
			level = math.max(1, math.floor(self:ReadNumber(_BRSkillSystem:GetLocalSkillLevel(), 1)))
			exp = math.max(0, math.floor(self:ReadNumber(_BRSkillSystem:GetLocalSkillExperience(), 0)))
			expMax = math.max(1, math.floor(self:ReadNumber(_BRSkillSystem:GetLocalRequiredExperience(), 1)))
		end

		local hp = 0
		local maxHp = 1
		if localPlayer ~= nil and localPlayer.PlayerComponent ~= nil then
			hp = math.max(0, math.floor(self:ReadNumber(localPlayer.PlayerComponent.Hp, 0)))
			maxHp = math.max(1, math.floor(self:ReadNumber(localPlayer.PlayerComponent.MaxHp, 1)))
		end

		self:SetHudText("HudLevelText", "Lv. " .. tostring(level), Color(1, 1, 1, 1))
		self:SetHudText("HudHpValue", tostring(hp) .. "/" .. tostring(maxHp), Color(1, 1, 1, 1))
		self:SetHudText("HudExpValue", tostring(exp) .. "/" .. tostring(expMax), Color(1, 1, 1, 1))
		self:SetHudGaugeRatio("Hp", hp / maxHp)
		self:SetHudGaugeRatio("Exp", exp / expMax)
	end

	@ExecSpace("ClientOnly")
	method void EnsureBattleHudText()
		self:EnsureHudText("HudLevelText", -392, 18, 90, 28, 20, Color(1, 1, 1, 1))
		self:EnsureHudText("HudHpLabel", -288, 18, 32, 18, 12, Color(1, 1, 1, 1))
		self:EnsureHudText("HudHpValue", -246, 18, 212, 16, 10, Color(1, 1, 1, 1))
		self:EnsureHudText("HudExpLabel", -288, -15, 32, 18, 12, Color(1, 1, 1, 1))
		self:EnsureHudText("HudExpValue", -246, -15, 212, 16, 10, Color(1, 1, 1, 1))
		self:SetHudText("HudHpLabel", "HP", Color(1, 1, 1, 1))
		self:SetHudText("HudExpLabel", "EXP", Color(1, 1, 1, 1))
	end

	@ExecSpace("ClientOnly")
	method Entity EnsureHudText(string name, number x, number y, number width, number height, number fontSize, Color color)
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return nil
		end
		local safeName = self:ReadString(name, "")
		local entity = self:GetAuthoredHudTextEntity(safeName)
		if entity == nil then
			entity = panel:GetChildByName(safeName, false)
		end
		if entity == nil then
			return nil
		end
		entity.Enable = true
		if self:HasAuthoredBattleHudLayout() == true then
			return entity
		end
		self:ApplyHudRect(entity, x, y, width, height, Vector2(0, 0.5))
		if entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.Enable = false
			entity.SpriteGUIRendererComponent.RaycastTarget = false
		end
		if entity.TextComponent ~= nil then
			entity.TextComponent.FontSize = math.max(8, math.floor(self:ReadNumber(fontSize, 12)))
			entity.TextComponent.Alignment = TextAlignmentType.MiddleLeft
			entity.TextComponent.FontColor = color
			entity.TextComponent.Bold = true
			entity.TextComponent.DropShadow = true
		end
		return entity
	end

	@ExecSpace("ClientOnly")
	method void EnsureHudGauge(string key, number x, number y, number width, number height, Color fillColor)
		-- Prepares a HUD gauge with a fixed max-size fill sprite.
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return
		end

		local safeKey = self:ReadString(key, "Gauge")
		if self:HasAuthoredBattleHudLayout() == true then
			local authoredFill = self:GetAuthoredHudGaugeFillEntity(safeKey)
			if authoredFill ~= nil then
				authoredFill.Enable = true
				if authoredFill.SpriteGUIRendererComponent ~= nil then
					authoredFill.SpriteGUIRendererComponent.RaycastTarget = false
				end
			end
			return
		end
		local back = panel:GetChildByName("Hud" .. safeKey .. "Back", false)
		local fill = panel:GetChildByName("Hud" .. safeKey .. "Fill", false)

		if back ~= nil then
			back.Enable = true
			self:ApplyHudRect(back, x, y, width, height, Vector2(0, 0.5))
			self:SetSpriteColor(back, Color(0.02, 0.025, 0.035, 0.95))
			if back.SpriteGUIRendererComponent ~= nil then
				back.SpriteGUIRendererComponent.RaycastTarget = false
			end
		end
		if fill ~= nil then
			fill.Enable = true
			self:ApplyHudRect(fill, x, y, width, height, Vector2(0, 0.5))
			self:SetSpriteColor(fill, fillColor)
			if fill.SpriteGUIRendererComponent ~= nil then
				fill.SpriteGUIRendererComponent.Type = ImageType.Filled
				fill.SpriteGUIRendererComponent.FillMethod = FillMethodType.Horizontal
				fill.SpriteGUIRendererComponent.FillOrigin = 0
				fill.SpriteGUIRendererComponent.RaycastTarget = false
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetHudGaugeRatio(string key, number ratio)
		-- Updates the visible gauge amount without changing the authored max width.
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return
		end
		local safeKey = self:ReadString(key, "Gauge")
		if self:HasAuthoredBattleHudLayout() == true then
			local authoredFill = self:GetAuthoredHudGaugeFillEntity(safeKey)
			if authoredFill == nil then
				return
			end
			local safeRatio = math.max(0, math.min(1, self:ReadNumber(ratio, 0)))
			if authoredFill.SpriteGUIRendererComponent ~= nil then
				authoredFill.SpriteGUIRendererComponent.Type = ImageType.Filled
				authoredFill.SpriteGUIRendererComponent.FillMethod = FillMethodType.Horizontal
				authoredFill.SpriteGUIRendererComponent.FillOrigin = 0
				authoredFill.SpriteGUIRendererComponent.FillAmount = safeRatio
			end
			if authoredFill.UITransformComponent ~= nil then
				authoredFill.UITransformComponent.Pivot = Vector2(0, 0.5)
				authoredFill.UITransformComponent.RectSize = Vector2(self:GetAuthoredHudGaugeWidth(), authoredFill.UITransformComponent.RectSize.y)
			end
			return
		end
		local back = panel:GetChildByName("Hud" .. safeKey .. "Back", false)
		local fill = panel:GetChildByName("Hud" .. safeKey .. "Fill", false)
		if back == nil or fill == nil or back.UITransformComponent == nil or fill.UITransformComponent == nil then
			return
		end
		local safeRatio = math.max(0, math.min(1, self:ReadNumber(ratio, 0)))
		local backSize = back.UITransformComponent.RectSize
		fill.UITransformComponent.Pivot = Vector2(0, 0.5)
		fill.UITransformComponent.RectSize = Vector2(math.max(1, backSize.x), backSize.y)
		if fill.SpriteGUIRendererComponent ~= nil then
			fill.SpriteGUIRendererComponent.Type = ImageType.Filled
			fill.SpriteGUIRendererComponent.FillMethod = FillMethodType.Horizontal
			fill.SpriteGUIRendererComponent.FillOrigin = 0
			fill.SpriteGUIRendererComponent.FillAmount = safeRatio
		end
	end

	@ExecSpace("ClientOnly")
	method void SetHudText(string name, string text, Color color)
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return
		end
		local safeName = self:ReadString(name, "")
		local entity = self:GetAuthoredHudTextEntity(safeName)
		if entity == nil then
			entity = panel:GetChildByName(safeName, false)
		end
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
			entity.TextComponent.FontColor = color
		end
	end

	@ExecSpace("ClientOnly")
	method void SetChainEntityEnabled(string relativePath, boolean enabled)
		-- Enables or disables an entity under the chain root.
		local entity = self:GetChainEntity(relativePath)
		if entity ~= nil then
			entity.Enable = enabled == true
		end
	end

	@ExecSpace("ClientOnly")
	method void SetInventoryEntityEnabled(string relativePath, boolean enabled)
		-- Enables or disables an entity under the inventory root.
		local entity = self:GetInventoryEntity(relativePath)
		if entity ~= nil then
			entity.Enable = enabled == true
		end
	end

	@ExecSpace("ClientOnly")
	method void SetChainPanelActive(boolean active)
		local panel = self:GetChainEntity("Panel")
		if panel ~= nil then
			panel.Enable = active == true
		end
	end

	@ExecSpace("ClientOnly")
	method void SetInventoryPanelActive(boolean active)
		local panel = self:GetInventoryEntity("Panel")
		if panel ~= nil then
			panel.Enable = active == true
		end
	end

	@ExecSpace("ClientOnly")
	method void SetDragGhostActive(boolean active)
		local ghost = self:GetChainEntity("DragGhost")
		local root = _EntityService:GetEntityByPath(self:GetChainRootPath())
		if root ~= nil and root.UIGroupComponent ~= nil then
			if active == true then
				if self.dragGroupOrderBefore <= -1000 then
					self.dragGroupOrderBefore = self:ReadNumber(root.UIGroupComponent.GroupOrder, 4)
				end
				root.UIGroupComponent.GroupOrder = math.floor(self:ReadNumber(self.DragGroupOrder, 90))
			elseif self.dragGroupOrderBefore > -1000 then
				root.UIGroupComponent.GroupOrder = math.floor(self.dragGroupOrderBefore)
				self.dragGroupOrderBefore = -1000
			end
		end
		if ghost ~= nil then
			ghost.Enable = active == true
			if ghost.UITransformComponent ~= nil then
				local scale = self:GetBattleHudScale()
				ghost.UITransformComponent.UIScale = Vector3(scale, scale, 1)
			end
			if active == true and ghost.UITransformComponent ~= nil then
				_UILogic:SetSiblingIndex(ghost.UITransformComponent, 1000000)
			end
		end
	end

	method void EnsureRuntime()
		if self._T.chainSlots == nil then
			self._T.chainSlots = {}
		end
		if self._T.bagParts == nil then
			self._T.bagParts = {}
		end
		if self._T.handlers == nil then
			self._T.handlers = {}
		end
	end

	method number GetRefreshSeconds()
		return math.max(0.05, self:ReadNumber(self.RefreshSeconds, 0.15))
	end

	method number GetRequestSeconds()
		return math.max(self:GetRefreshSeconds(), self:ReadNumber(self.RequestSeconds, 0.75))
	end

	method number GetBagSlotCount()
		local count = math.floor(self:ReadNumber(self.BagSlotCount, 2))
		if _BRSkillSystem ~= nil then
			count = math.floor(self:ReadNumber(_BRSkillSystem:GetBagSlotCount(), count))
		end
		return math.max(1, count)
	end

	method number GetChainSlotCount()
		-- Returns the visible chain slot count.
		local count = math.floor(self:ReadNumber(self.ChainSlotCount, 5))
		if _BRSkillSystem ~= nil then
			count = math.floor(self:ReadNumber(_BRSkillSystem:GetChainSlotCount(), count))
		end
		return math.max(1, count)
	end

	method number GetCommonSkillSlotCount()
		return 3
	end

	method number GetHudPanelWidth()
		return math.max(360, self:ReadNumber(self.HudPanelWidth, 940))
	end

	method number GetHudPanelHeight()
		return math.max(64, self:ReadNumber(self.HudPanelHeight, 112))
	end

	method number GetHudPanelY()
		return self:ReadNumber(self.HudPanelY, 32)
	end

	method number GetHudSlotSize()
		return math.max(28, self:ReadNumber(self.HudSlotSize, 54))
	end

	method number GetHudIconSize()
		return math.max(20, self:ReadNumber(self.HudIconSize, 42))
	end

	method number GetHudSlotSpacing()
		return math.max(self:GetHudSlotSize(), self:ReadNumber(self.HudSlotSpacing, 58))
	end

	method number GetBattleHudScale()
		local scale = self:ReadNumber(self.BattleHudScale, 0.72)
		return math.max(0.25, math.min(1, scale))
	end

	method number GetAuthoredHudGaugeWidth()
		return math.max(1, self:ReadNumber(self.AuthoredHudGaugeWidth, 243))
	end

	method number GetClickDragThreshold()
		return math.max(1, self:ReadNumber(self.ClickDragThreshold, 8))
	end

	method string GetChainRootPath()
		local ownerRootPath = self:GetOwnerUiRootPath()
		if self:IsBattleHudRootPath(ownerRootPath) == true then
			return ownerRootPath
		end
		return self:ReadString(self.ChainRootPath, self:ReadString(self.RootPath, "/ui/BRBattleHudGroup"))
	end

	method string GetOwnerUiRootPath()
		local selfPath = self:GetSelfPath()
		if self:StartsWith(selfPath, "/ui/") ~= true then
			return ""
		end
		local searchStart = string.len("/ui/") + 1
		local nextSlash, nextSlashEnd = string.find(selfPath, "/", searchStart)
		if nextSlashEnd == nil then
			return selfPath
		end
		return string.sub(selfPath, 1, nextSlash - 1)
	end

	method boolean IsBattleHudRootPath(string path)
		local rootPath = self:ReadString(path, "")
		return rootPath == "/ui/BRBattleHudGroup" or rootPath == "/ui/BRBattleHubGroup"
	end

	method string GetSelfPath()
		if self.Entity == nil then
			return ""
		end
		if self.Entity.Path == nil then
			return ""
		end
		return self:ReadString(self.Entity.Path, "")
	end

	method boolean IsControllerInChainRoot()
		local selfPath = self:GetSelfPath()
		local rootPath = self:GetChainRootPath()
		if self:IsForSavePath(selfPath) == true then
			return false
		end
		if selfPath == "" or rootPath == "" then
			return true
		end
		if selfPath == rootPath then
			return true
		end
		local prefix = rootPath .. "/"
		return string.sub(selfPath, 1, string.len(prefix)) == prefix
	end

	method boolean HasAuthoredBattleHudLayout()
		local bg = self:GetEntityFromRoot(self:GetChainRootPath(), "Bg")
		local slot = self:GetEntityFromRoot(self:GetChainRootPath(), "Bg/ChainPart_1")
		return bg ~= nil and slot ~= nil
	end

	@ExecSpace("ClientOnly")
	method void ApplyBattleHudScale()
		local scaleRoot = self:GetEntityFromRoot(self:GetChainRootPath(), "Bg")
		if scaleRoot == nil then
			scaleRoot = self:GetEntityFromRoot(self:GetChainRootPath(), "Panel")
		end
		if scaleRoot ~= nil and scaleRoot.UITransformComponent ~= nil then
			local scale = self:GetBattleHudScale()
			scaleRoot.UITransformComponent.UIScale = Vector3(scale, scale, 1)
		end
	end

	method Entity GetAuthoredHudTextEntity(string name)
		local safeName = self:ReadString(name, "")
		if safeName == "HudLevelText" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), "Bg/HudLevelText")
		end
		if safeName == "HudHpValue" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), "Bg/HudHpFill/HudHpValue")
		end
		if safeName == "HudExpValue" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), "Bg/HudExpFill/HudExpValue")
		end
		return nil
	end

	method Entity GetAuthoredHudGaugeFillEntity(string key)
		local safeKey = self:ReadString(key, "")
		if safeKey == "Hp" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), "Bg/HudHpFill")
		end
		if safeKey == "Exp" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), "Bg/HudExpFill")
		end
		return nil
	end

	method string GetInventoryRootPath()
		return self:ReadString(self.InventoryRootPath, "/ui/BRSkillInventoryGroup")
	end

	method string GetLocalUserId()
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			return ""
		end
		return self:ReadString(localPlayer.PlayerComponent.UserId, "")
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method boolean StartsWith(string text, string prefix)
		local safeText = self:ReadString(text, "")
		local safePrefix = self:ReadString(prefix, "")
		if safePrefix == "" then
			return true
		end
		return string.sub(safeText, 1, string.len(safePrefix)) == safePrefix
	end

	method void Log(string message)
		if self.VerboseLog == true then
			log("[BRSkillChainUI] " .. message)
		end
	end

end
