@Component
script BRSkillChainUI extends Component

	property string ChainRootPath = "/ui/BRBattleHudGroup"

	property string InventoryRootPath = "/ui/BRBattleHudGroup"

	property string RootPath = "/ui/BRBattleHudGroup"

	property number RefreshSeconds = 0.15

	property number RequestSeconds = 0.75

	property number ChainSlotCount = 5

	property number BagSlotCount = 4

	property boolean AttachInventoryPanel = false

	property boolean EnableChainEditing = true

	property boolean ShowSkillInventoryPanel = false

	property number InventoryAttachGap = -2

	property number InventoryPanelYOffset = 0

	property boolean VerboseLog = true

	property boolean runtimeDisabled = false

	property number refreshTimerId = 0

	property number nextRequestAt = 0

	property number lastSnapshotVersion = -1

	property number draggingInstanceId = 0

	property number draggingSourceSlot = 0

	property string draggingLabel = ""

	property number hoverChainSlot = 0

	property number hoverBagIndex = 0

	property number draggingSourceBagIndex = 0

	property number draggingSourceConsumableIndex = 0

	property boolean tooltipLocked = false

	property string tooltipSkillKey = ""

	property number tooltipTier = 1

	property string tooltipSourceKind = ""

	property number tooltipSourceIndex = 0

	property number TooltipWidth = 360

	property number TooltipHeight = 228

	property number draggingStartX = 0

	property number draggingStartY = 0

	property boolean draggingMoved = false

	property number ClickDragThreshold = 8

	property any inputKeyDownHandler = nil

	property any inputKeyUpHandler = nil

	property any inputTouchDownHandler = nil

	property any inputTouchHoldHandler = nil

	property any inputTouchReleaseHandler = nil

	property any inputMouseMoveHandler = nil

	property number DragGroupOrder = 90

	property number dragGroupOrderBefore = -1000

	property boolean EnableBattleHudLayout = true

	property boolean ShowBattleHudStatus = true

	property number HudPanelWidth = 940

	property number HudPanelHeight = 112

	property number HudPanelY = 32

	property number HudSlotSize = 54

	property number HudIconSize = 42

	property number HudSlotSpacing = 58

	property number BattleHudScale = 1

	property number AuthoredHudGaugeWidth = 243

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:EnsureRuntime()
		if self:IsControllerInChainRoot() ~= true then
			self.runtimeDisabled = true
			self:Log("ignored controller path=" .. self:GetSelfPath() .. " chainRoot=" .. self:GetChainRootPath())
			return
		end
		self.runtimeDisabled = false
		if self:HasAuthoredBattleHudLayout() ~= true then
			self:ApplySlotOnlyLayout()
		end
		self:EnsureBattleHudLayout()
		self:ConnectHandlers()
		self:SetDragGhostActive(false)
		self:ClearSkillTooltipState()
		self:Refresh()
		self.refreshTimerId = _TimerService:SetTimerRepeat(function() self:Refresh() end, self:GetRefreshSeconds(), 0.1)
		self:Log("slot highlight mode=skill-icon")
		self:Log("ready chainRoot=" .. self:GetChainRootPath() .. " inventoryRoot=" .. self:GetInventoryRootPath())
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.refreshTimerId ~= nil and self.refreshTimerId > 0 then
			_TimerService:ClearTimer(self.refreshTimerId)
		end
		self.refreshTimerId = 0
		self:ClearSkillTooltipState()
		self:DisconnectHandlers()
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		if self.runtimeDisabled == true then
			return
		end
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			self:SetChainPanelActive(false)
			self:SetInventoryPanelActive(false)
			return
		end

		self:SetChainPanelActive(true)
		self:SetInventoryPanelActive(self.ShowSkillInventoryPanel == true)
		self:RefreshBattleHud(localPlayer)
		local now = _UtilLogic.ElapsedSeconds
		if _BRSkillSystem ~= nil and now >= self.nextRequestAt then
			self.nextRequestAt = now + self:GetRequestSeconds()
			_BRSkillSystem:RequestUserSnapshot(localPlayer.PlayerComponent.UserId)
		end

		if _BRSkillSystem == nil then
			self:RefreshCommonSkillSlots()
			self:RenderChain()
			return
		end

		local version = _BRSkillSystem:GetLocalSnapshotVersion()
		if version == self.lastSnapshotVersion then
			self:RefreshCommonSkillSlots()
			return
		end
		self.lastSnapshotVersion = version

		self._T.chainSlots = self:ParseChainText(_BRSkillSystem:GetLocalChainText())
		self._T.bagParts = self:ParseBagText(_BRSkillSystem:GetLocalBagText())
		self._T.consumableSlot = nil
		self:RenderChain()
		self:RenderBag()
		self:RefreshCommonSkillSlots()
	end

	@ExecSpace("ClientOnly")
	method void RequestImmediateRefresh(string reason, number version)
		-- Server snapshots can arrive between timer ticks; render them immediately.
		if self.runtimeDisabled == true then
			return
		end
		self:EnsureRuntime()
		local now = _UtilLogic.ElapsedSeconds
		self.nextRequestAt = math.max(self.nextRequestAt, now + self:GetRequestSeconds())
		self.lastSnapshotVersion = -1
		self:Refresh()
		if self._T.immediateRefreshLogged ~= true then
			self._T.immediateRefreshLogged = true
			self:Log("immediate refresh ready reason=" .. self:ReadString(reason, "snapshot") .. " version=" .. tostring(math.floor(self:ReadNumber(version, 0))))
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectHandlers()
		self:EnsureRuntime()
		self:DisconnectHandlers()
		self._T.handlers = {}

		if self.EnableChainEditing ~= true then
			self:Log("handlers skipped mode=sequence-display")
			return
		end

		self.inputKeyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnInputKeyDown)
		self.inputKeyUpHandler = _InputService:ConnectEvent(KeyUpEvent, self.OnInputKeyUp)
		self.inputTouchDownHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.OnScreenTouchDown)
		self.inputTouchHoldHandler = _InputService:ConnectEvent(ScreenTouchHoldEvent, self.OnScreenTouchHold)
		self.inputTouchReleaseHandler = _InputService:ConnectEvent(ScreenTouchReleaseEvent, self.OnScreenTouchRelease)
		self.inputMouseMoveHandler = _InputService:ConnectEvent(MouseMoveEvent, self.OnMouseMove)

		local usingAuthoredHud = self:HasAuthoredBattleHudLayout()
		for index = 1, self:GetChainSlotCount() do
			local slotIndex = index
			local touch = self:GetChainTouchEntity(slotIndex)
			if touch ~= nil then
				self:ConnectTouchEntity(touch, "CHAIN", slotIndex)
			end
			if usingAuthoredHud ~= true then
				local slot = self:GetChainEntity("Panel/Chain/Slot_" .. tostring(slotIndex))
				if slot ~= nil and slot ~= touch then
					self:ConnectTouchEntity(slot, "CHAIN", slotIndex)
				end
			end
		end

		for index = 1, self:GetBagSlotCount() do
			local bagIndex = index
			local touch = self:GetBagTouchEntity(bagIndex)
			if touch ~= nil then
				self:ConnectTouchEntity(touch, "BAG", bagIndex)
			end
			local item = self:GetInventoryEntity("Panel/Inventory/Item_" .. tostring(bagIndex))
			if item ~= nil and item ~= touch then
				self:ConnectTouchEntity(item, "BAG", bagIndex)
			end
		end

		if _BRCommonSkillSystem ~= nil then
			local hotkeySlots = {
				{ Path = "Panel/Chain/Common_1", Action = "unique" },
				{ Path = "Panel/Chain/Common_2", Action = "blink" },
				{ Path = "Panel/Chain/Common_3", Action = "nimbus" },
				{ Path = self:GetRepresentativeChainSlotPath(), Action = "attack" }
			}
			for _, slot in ipairs(hotkeySlots) do
				local hotkeyEntity = self:GetChainEntity(slot.Path)
				local hotkeyActionId = self:ReadString(slot.Action, "")
				if hotkeyEntity ~= nil and hotkeyActionId ~= "" then
					local hotkeyDownHandler = hotkeyEntity:ConnectEvent(UITouchDownEvent, function(event)
						if _BRCommonSkillSystem ~= nil and _BRCommonSkillSystem:IsSelectingHudRebindSlot() == true then
							if event == nil or (self:IsRightClick(event.TouchId) ~= true and self:IsMiddleClick(event.TouchId) ~= true) then
								_BRCommonSkillSystem:BeginHudSlotRebind(hotkeyActionId)
								self:Log("hotkey rebind action selected=" .. hotkeyActionId)
							end
						end
					end)
					table.insert(self._T.handlers, { Entity = hotkeyEntity, EventType = "DOWN", Handler = hotkeyDownHandler })
				end
			end
		end
		self:Log("handlers connected count=" .. tostring(#self._T.handlers))
	end

	@ExecSpace("ClientOnly")
	method void ApplyAttachedInventoryLayout()
		if self.AttachInventoryPanel ~= true then
			return
		end

		local chainPanel = self:GetChainEntity("Panel")
		local inventoryPanel = self:GetInventoryEntity("Panel")
		if chainPanel == nil or inventoryPanel == nil or chainPanel.UITransformComponent == nil or inventoryPanel.UITransformComponent == nil then
			self:Log("layout attach skipped chainPanel=" .. tostring(chainPanel ~= nil) .. " inventoryPanel=" .. tostring(inventoryPanel ~= nil))
			return
		end

		local chainTransform = chainPanel.UITransformComponent
		local inventoryTransform = inventoryPanel.UITransformComponent
		local chainSize = chainTransform.RectSize
		local inventorySize = inventoryTransform.RectSize
		local chainPosition = chainTransform.anchoredPosition
		local gap = self:ReadNumber(self.InventoryAttachGap, -2)
		local offsetY = self:ReadNumber(self.InventoryPanelYOffset, 0)
		local targetX = chainPosition.x + chainSize.x * 0.5 + inventorySize.x * 0.5 + gap
		local targetY = chainPosition.y + offsetY
		inventoryTransform.anchoredPosition = Vector2(targetX, targetY)
		self:Log("layout attached inventoryX=" .. tostring(math.floor(targetX)) .. " inventoryY=" .. tostring(math.floor(targetY)))
	end

	@ExecSpace("ClientOnly")
	method void ConnectTouchEntity(Entity entity, string kind, number index)
		if entity == nil then
			return
		end

		local downHandler = entity:ConnectEvent(UITouchDownEvent, function(event) self:OnTouchDown(kind, index, event) end)
		local dragHandler = entity:ConnectEvent(UITouchDragEvent, function(event) self:OnTouchDrag(kind, index, event) end)
		local upHandler = entity:ConnectEvent(UITouchUpEvent, function(event) self:OnTouchUp(kind, index, event) end)
		local enterHandler = entity:ConnectEvent(UITouchEnterEvent, function(event) self:OnTouchEnter(kind, index, event) end)
		local exitHandler = entity:ConnectEvent(UITouchExitEvent, function(event) self:OnTouchExit(kind, index, event) end)

		table.insert(self._T.handlers, { Entity = entity, EventType = "DOWN", Handler = downHandler })
		table.insert(self._T.handlers, { Entity = entity, EventType = "DRAG", Handler = dragHandler })
		table.insert(self._T.handlers, { Entity = entity, EventType = "UP", Handler = upHandler })
		table.insert(self._T.handlers, { Entity = entity, EventType = "ENTER", Handler = enterHandler })
		table.insert(self._T.handlers, { Entity = entity, EventType = "EXIT", Handler = exitHandler })
	end

	@ExecSpace("ClientOnly")
	method void ConnectHotkeyRebindSlots()
		self:ConnectHotkeyRebindSlot("Panel/Chain/Common_1", "unique")
		self:ConnectHotkeyRebindSlot("Panel/Chain/Common_2", "blink")
		self:ConnectHotkeyRebindSlot("Panel/Chain/Common_3", "nimbus")
		self:ConnectHotkeyRebindSlot(self:GetRepresentativeChainSlotPath(), "attack")
		self:ConnectHotkeyRebindSlot("Panel/Chain/Sobie_1", "consumable")
	end

	@ExecSpace("ClientOnly")
	method void ConnectHotkeyRebindSlot(string relativePath, string actionId)
		local entity = self:GetChainEntity(relativePath)
		if entity == nil then
			return
		end
		local safeActionId = self:ReadString(actionId, "")
		local hotkeyDownHandler = entity:ConnectEvent(UITouchDownEvent, function(event) self:OnHotkeyRebindSlotTouch(safeActionId, event) end)
		table.insert(self._T.handlers, { Entity = entity, EventType = "DOWN", Handler = hotkeyDownHandler })
	end

	@ExecSpace("ClientOnly")
	method void DisconnectHandlers()
		if self.inputKeyDownHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.inputKeyDownHandler)
		end
		self.inputKeyDownHandler = nil
		if self.inputKeyUpHandler ~= nil then
			_InputService:DisconnectEvent(KeyUpEvent, self.inputKeyUpHandler)
		end
		self.inputKeyUpHandler = nil
		if self.inputTouchDownHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchEvent, self.inputTouchDownHandler)
		end
		self.inputTouchDownHandler = nil
		if self.inputTouchHoldHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchHoldEvent, self.inputTouchHoldHandler)
		end
		self.inputTouchHoldHandler = nil
		if self.inputTouchReleaseHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchReleaseEvent, self.inputTouchReleaseHandler)
		end
		self.inputTouchReleaseHandler = nil
		if self.inputMouseMoveHandler ~= nil then
			_InputService:DisconnectEvent(MouseMoveEvent, self.inputMouseMoveHandler)
		end
		self.inputMouseMoveHandler = nil

		if self._T.handlers == nil then
			return
		end

		for index, entry in ipairs(self._T.handlers) do
			if entry ~= nil and entry.Entity ~= nil and entry.Handler ~= nil then
				if entry.EventType == "DOWN" then
					entry.Entity:DisconnectEvent(UITouchDownEvent, entry.Handler)
				elseif entry.EventType == "DRAG" then
					entry.Entity:DisconnectEvent(UITouchDragEvent, entry.Handler)
				elseif entry.EventType == "UP" then
					entry.Entity:DisconnectEvent(UITouchUpEvent, entry.Handler)
				elseif entry.EventType == "ENTER" then
					entry.Entity:DisconnectEvent(UITouchEnterEvent, entry.Handler)
				elseif entry.EventType == "EXIT" then
					entry.Entity:DisconnectEvent(UITouchExitEvent, entry.Handler)
				end
			end
		end
		self._T.handlers = {}
	end

	@ExecSpace("ClientOnly")
	method void OnInputKeyDown(KeyDownEvent event)
		if event == nil then
			return
		end
		if _BRCommonSkillSystem ~= nil and _BRCommonSkillSystem:IsSelectingHudRebindSlot() == true then
			return
		end

		if event.key == KeyboardKey.Mouse2 then
			self:ToggleSkillTooltipLockAtCursor()
			return
		end

		if self.tooltipLocked == true then
			if event.key == KeyboardKey.LeftArrow then
				self:ShiftSkillTooltipTier(-1)
				return
			elseif event.key == KeyboardKey.RightArrow then
				self:ShiftSkillTooltipTier(1)
				return
			end
		end

		if event.key ~= KeyboardKey.Mouse1 then
			return
		end

		local cursorPosition = _InputService:GetCursorPosition()
		local slotIndex = self:GetSlotIndexAtScreenPoint(cursorPosition)
		if slotIndex <= 0 then
			slotIndex = self.hoverChainSlot
		end
		if slotIndex > 0 then
			self:RequestClearSlot(slotIndex)
			return
		end

		local bagIndex = self:GetBagIndexAtScreenPoint(cursorPosition)
		if bagIndex <= 0 then
			bagIndex = self.hoverBagIndex
		end
		if bagIndex > 0 then
			self:ClearEquippedBagPart(bagIndex)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnInputKeyUp(KeyUpEvent event)
		-- Completes an active drag even if the pointer left the original UI touch receiver.
		if event == nil or event.key ~= KeyboardKey.Mouse0 then
			return
		end
		if self.draggingInstanceId <= 0 then
			return
		end
		self:EndPartDragAtScreen(_InputService:GetCursorPosition())
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchDown(ScreenTouchEvent event)
		-- Starts dragging from the global screen input path when UI raycasts are blocked by another group.
		if event == nil or self.draggingInstanceId > 0 then
			return
		end

		local screenPoint = event.TouchPoint
		if _BRCommonSkillSystem ~= nil and _BRCommonSkillSystem:IsSelectingHudRebindSlot() == true then
			local actionId = ""
			for commonIndex = 1, self:GetCommonSkillSlotCount() do
				local common = self:GetChainEntity("Panel/Chain/Common_" .. tostring(commonIndex))
				if self:IsScreenPointInsideEntity(screenPoint, common) == true then
					if commonIndex == 1 then
						actionId = "unique"
					elseif commonIndex == 2 then
						actionId = "blink"
					elseif commonIndex == 3 then
						actionId = "nimbus"
					end
				end
			end
			if actionId == "" then
				local representative = self:GetChainEntity(self:GetRepresentativeChainSlotPath())
				if self:IsScreenPointInsideEntity(screenPoint, representative) == true then
					actionId = "attack"
				end
			end
			if actionId ~= "" then
				_BRCommonSkillSystem:BeginHudSlotRebind(actionId)
				self:Log("hotkey rebind action selected=" .. actionId)
			end
			return
		end
		local slotIndex = self:GetSlotIndexAtScreenPoint(screenPoint)
		if slotIndex > 0 then
			if self:BeginChainSlotDragAtScreen(slotIndex, screenPoint) == true then
				self:Log("screen drag begin slot=" .. tostring(slotIndex))
			end
			return
		end

		local bagIndex = self:GetBagIndexAtScreenPoint(screenPoint)
		if bagIndex > 0 then
			if self:BeginBagPartDragAtScreen(bagIndex, screenPoint) == true then
				self:Log("screen drag begin bag=" .. tostring(bagIndex))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchHold(ScreenTouchHoldEvent event)
		-- Keeps the drag ghost attached to the pointer after leaving the source slot.
		if event == nil or self.draggingInstanceId <= 0 then
			return
		end
		self:MovePartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchRelease(ScreenTouchReleaseEvent event)
		-- Completes touch dragging from anywhere on the screen.
		if event == nil or self.draggingInstanceId <= 0 then
			return
		end
		self:EndPartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnMouseMove(MouseMoveEvent event)
		-- Tracks PC mouse dragging and hover tooltip updates between UI touch events.
		local cursorPosition = _InputService:GetCursorPosition()
		if _BRCommonSkillSystem ~= nil and _BRCommonSkillSystem:IsSelectingHudRebindSlot() == true then
			self:ClearSkillTooltipState()
			return
		end
		if self.draggingInstanceId > 0 then
			if _InputService:IsKeyPressed(KeyboardKey.Mouse0) == false then
				return
			end
			self:MovePartDragAtScreen(cursorPosition)
			return
		end
		if self.tooltipLocked == true then
			self:MoveSkillTooltipToScreen(cursorPosition)
			return
		end
		self:UpdateSkillTooltipHover(cursorPosition)
	end

	@ExecSpace("ClientOnly")
	method void OnTouchDown(string kind, number index, UITouchDownEvent event)
		if event == nil then
			return
		end
		if _BRCommonSkillSystem ~= nil and _BRCommonSkillSystem:IsSelectingHudRebindSlot() == true then
			return
		end

		self:Log("touch down kind=" .. self:ReadString(kind, "") .. " index=" .. tostring(index) .. " touchId=" .. tostring(event.TouchId))
		if self:IsMiddleClick(event.TouchId) == true then
			return
		end
		if kind == "CHAIN" then
			self.hoverChainSlot = math.floor(self:ReadNumber(index, 0))
			if self:IsRightClick(event.TouchId) == true then
				self:RequestClearSlot(index)
				return
			end
			self:BeginChainSlotDrag(index, event)
		elseif kind == "BAG" then
			self.hoverBagIndex = math.floor(self:ReadNumber(index, 0))
			if self:IsRightClick(event.TouchId) == true then
				self:ClearEquippedBagPart(index)
				return
			end
			self:BeginBagPartDrag(index, event)
		elseif kind == "CONSUMABLE" then
			return
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouchDrag(string kind, number index, UITouchDragEvent event)
		if event == nil then
			return
		end
		self:MovePartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnTouchUp(string kind, number index, UITouchUpEvent event)
		self:EndPartDrag(event)
	end

	@ExecSpace("ClientOnly")
	method void OnTouchEnter(string kind, number index, UITouchEnterEvent event)
		if kind == "CHAIN" then
			self.hoverChainSlot = math.floor(self:ReadNumber(index, 0))
		elseif kind == "BAG" then
			self.hoverBagIndex = math.floor(self:ReadNumber(index, 0))
		end
		if self.tooltipLocked ~= true then
			self:UpdateSkillTooltipHover(_InputService:GetCursorPosition())
		end
	end

	@ExecSpace("ClientOnly")
	method void OnTouchExit(string kind, number index, UITouchExitEvent event)
		local safeIndex = math.floor(self:ReadNumber(index, 0))
		if kind == "CHAIN" and self.hoverChainSlot == safeIndex then
			self.hoverChainSlot = 0
		elseif kind == "BAG" and self.hoverBagIndex == safeIndex then
			self.hoverBagIndex = 0
		end
		if self.tooltipLocked ~= true then
			self:ClearSkillTooltipState()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnHotkeyRebindSlotTouch(string actionId, UITouchDownEvent event)
		if self:IsHudRebindSelectionActive() ~= true then
			return
		end
		if event ~= nil and (self:IsRightClick(event.TouchId) == true or self:IsMiddleClick(event.TouchId) == true) then
			return
		end
		self:BeginHotkeyRebindAction(actionId)
	end

	@ExecSpace("ClientOnly")
	method boolean TryBeginHotkeyRebindAtScreen(Vector2 screenPoint)
		if self:IsHudRebindSelectionActive() ~= true then
			return false
		end
		local actionId = self:GetHotkeyActionAtScreenPoint(screenPoint)
		if actionId == "" then
			return false
		end
		return self:BeginHotkeyRebindAction(actionId)
	end

	@ExecSpace("ClientOnly")
	method boolean BeginHotkeyRebindAction(string actionId)
		local safeActionId = self:ReadString(actionId, "")
		if safeActionId == "" or _BRCommonSkillSystem == nil then
			return false
		end
		_BRCommonSkillSystem:BeginHudSlotRebind(safeActionId)
		self:RefreshHotkeyLabels()
		self:Log("hotkey rebind action selected=" .. safeActionId)
		return true
	end

	method string GetHotkeyActionAtScreenPoint(Vector2 screenPoint)
		for commonIndex = 1, self:GetCommonSkillSlotCount() do
			local common = self:GetChainEntity("Panel/Chain/Common_" .. tostring(commonIndex))
			if self:IsScreenPointInsideEntity(screenPoint, common) == true then
				return self:GetCommonHotkeyActionId(commonIndex)
			end
		end
		local representative = self:GetChainEntity(self:GetRepresentativeChainSlotPath())
		if self:IsScreenPointInsideEntity(screenPoint, representative) == true then
			return "attack"
		end
		local consumable = self:GetConsumableTouchEntity()
		if self:IsScreenPointInsideEntity(screenPoint, consumable) == true then
			return "consumable"
		end
		return ""
	end

	method string GetCommonHotkeyActionId(number index)
		local safeIndex = math.floor(self:ReadNumber(index, 0))
		if safeIndex == 1 then
			return "unique"
		elseif safeIndex == 2 then
			return "blink"
		elseif safeIndex == 3 then
			return "nimbus"
		end
		return ""
	end

	method boolean IsHudRebindSelectionActive()
		if _BRCommonSkillSystem == nil then
			return false
		end
		return _BRCommonSkillSystem:IsSelectingHudRebindSlot() == true
	end

	@ExecSpace("ClientOnly")
	method void BeginBagPartDrag(number bagIndex, UITouchDownEvent event)
		local part = self:GetBagPart(bagIndex)
		if part == nil then
			return
		end

		if self:BeginBagPartDragAtScreen(bagIndex, event.TouchPoint) ~= true then
			return
		end
		self:Log("drag begin bag=" .. tostring(bagIndex) .. " instance=" .. tostring(self.draggingInstanceId))
	end

	@ExecSpace("ClientOnly")
	method boolean BeginBagPartDragAtScreen(number bagIndex, Vector2 screenPoint)
		-- Starts dragging a spare inventory part from the given screen position.
		local part = self:GetBagPart(bagIndex)
		if part == nil then
			return false
		end

		self.draggingInstanceId = math.floor(self:ReadNumber(part.InstanceId, 0))
		self.draggingSourceSlot = 0
		self.draggingSourceBagIndex = math.floor(self:ReadNumber(bagIndex, 0))
		self.draggingSourceConsumableIndex = 0
		self.draggingStartX = screenPoint.x
		self.draggingStartY = screenPoint.y
		self.draggingMoved = false
		self.draggingLabel = self:FormatSkillIconText(self:ReadString(part.Short, "S"), 1)
		self:RenderDragGhostVisual(part, 1, false)
		self:SetDragGhostActive(true)
		self:MoveGhostToTouch(screenPoint)
		return true
	end

	@ExecSpace("ClientOnly")
	method void BeginConsumableSlotDrag(number slotIndex, UITouchDownEvent event)
		local part = self:GetConsumableSlotPart()
		if part == nil or event == nil then
			return
		end
		if self:BeginConsumableSlotDragAtScreen(slotIndex, event.TouchPoint) ~= true then
			return
		end
		self:Log("drag begin consumable instance=" .. tostring(self.draggingInstanceId))
	end

	@ExecSpace("ClientOnly")
	method boolean BeginConsumableSlotDragAtScreen(number slotIndex, Vector2 screenPoint)
		-- Starts dragging the Sobie_1 consumable from the given screen position.
		local part = self:GetConsumableSlotPart()
		if part == nil then
			return false
		end
		self.draggingInstanceId = math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0))
		self.draggingSourceSlot = 0
		self.draggingSourceBagIndex = 0
		self.draggingSourceConsumableIndex = math.floor(self:ReadNumber(slotIndex, 1))
		self.draggingStartX = screenPoint.x
		self.draggingStartY = screenPoint.y
		self.draggingMoved = false
		self.draggingLabel = self:FormatSkillIconText(self:ReadString(self:ReadRecordValue(part, "Short"), "USE"), 1)
		self:RenderDragGhostVisual(part, 1, false)
		self:SetDragGhostActive(true)
		self:MoveGhostToTouch(screenPoint)
		return true
	end

	@ExecSpace("ClientOnly")
	method void BeginChainSlotDrag(number slotIndex, UITouchDownEvent event)
		local record = self:GetChainSlot(slotIndex)
		if record == nil or self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) <= 0 then
			return
		end

		if self:BeginChainSlotDragAtScreen(slotIndex, event.TouchPoint) ~= true then
			return
		end
		self:Log("drag begin slot=" .. tostring(slotIndex) .. " instance=" .. tostring(self.draggingInstanceId))
	end

	@ExecSpace("ClientOnly")
	method boolean BeginChainSlotDragAtScreen(number slotIndex, Vector2 screenPoint)
		-- Starts dragging an equipped chain slot from the given screen position.
		local record = self:GetChainSlot(slotIndex)
		if record == nil or self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) <= 0 then
			return false
		end

		self.draggingInstanceId = math.floor(self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0))
		self.draggingSourceSlot = math.floor(self:ReadNumber(slotIndex, 0))
		self.draggingSourceBagIndex = 0
		self.draggingSourceConsumableIndex = 0
		self.draggingStartX = screenPoint.x
		self.draggingStartY = screenPoint.y
		self.draggingMoved = false
		self.draggingLabel = self:FormatSkillIconText(self:ReadString(self:ReadRecordValue(record, "Short"), "S"), self:ReadRecordValue(record, "Tier"))
		self:RenderDragGhostVisual(record, self:GetChainDisplayTier(slotIndex, record), self:IsLeadChainSlot(slotIndex, record))
		self:SetDragGhostActive(true)
		self:MoveGhostToTouch(screenPoint)
		return true
	end

	@ExecSpace("ClientOnly")
	method void MovePartDrag(UITouchDragEvent event)
		if event == nil or self.draggingInstanceId <= 0 then
			return
		end
		self:MovePartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void MovePartDragAtScreen(Vector2 screenPoint)
		-- Moves the drag ghost to the current pointer position.
		if self.draggingInstanceId <= 0 then
			return
		end
		self:UpdateDragMoved(screenPoint)
		self:MoveGhostToTouch(screenPoint)
	end

	@ExecSpace("ClientOnly")
	method void EndPartDrag(UITouchUpEvent event)
		if event == nil or self.draggingInstanceId <= 0 then
			self:ResetDrag()
			self:SetDragGhostActive(false)
			return
		end
		self:EndPartDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void EndPartDragAtScreen(Vector2 screenPoint)
		-- Resolves a drag release into chain, spare bag, or world drop behavior.
		if self.draggingInstanceId <= 0 then
			return
		end
		self:MoveGhostToTouch(screenPoint)
		self:UpdateDragMoved(screenPoint)
		local targetConsumableIndex = self:GetConsumableIndexAtScreenPoint(screenPoint)
		local targetSlot = self:GetSlotIndexAtScreenPoint(screenPoint)
		local targetBagIndex = self:GetBagIndexAtScreenPoint(screenPoint)
		local instanceId = self.draggingInstanceId
		local sourceSlot = self.draggingSourceSlot
		local sourceBagIndex = self.draggingSourceBagIndex
		local sourceConsumableIndex = self.draggingSourceConsumableIndex
		local wasClick = self.draggingMoved == false
		local dragRecord = self:GetLocalRecordByInstanceId(instanceId)
		local isConsumable = self:IsConsumableRecord(dragRecord)
		self:ResetDrag()
		self:SetDragGhostActive(false)

		if _BRSkillSystem == nil then
			return
		end

		if targetSlot > 0 and self:IsChainSlotLocked(targetSlot) == true then
			self:Log("drop locked slot=" .. tostring(targetSlot) .. " instance=" .. tostring(instanceId))
			return
		end

		if targetConsumableIndex > 0 then
			if isConsumable == true then
				self:RequestEquipConsumableToSlot(instanceId, "drop")
			else
				self:Log("consumable drop rejected instance=" .. tostring(instanceId) .. " reason=notConsumable")
			end
		elseif targetSlot > 0 and isConsumable == true then
			self:Log("chain drop rejected instance=" .. tostring(instanceId) .. " reason=consumable")
		elseif targetSlot > 0 and sourceSlot > 0 then
			if sourceSlot == targetSlot then
				self:Log("chain click sourceSlot=" .. tostring(sourceSlot) .. " instance=" .. tostring(instanceId))
			else
				_BRSkillSystem:RequestMoveChainSlotToChainSlot(self:GetLocalUserId(), sourceSlot, targetSlot)
				self:ApplyLocalMoveChainSlot(sourceSlot, targetSlot)
			end
		elseif targetSlot > 0 then
			self:RequestEquipPartToSlot(instanceId, targetSlot, "drop")
		elseif targetBagIndex > 0 then
			if sourceSlot > 0 then
				self:RequestMovePartToBagSlot(instanceId, targetBagIndex, "drop")
			elseif sourceBagIndex > 0 then
				if wasClick == true and sourceBagIndex == targetBagIndex then
					self:HandleBagPartClick(instanceId, sourceBagIndex)
				elseif sourceBagIndex ~= targetBagIndex then
					self:RequestMovePartToBagSlot(instanceId, targetBagIndex, "bag")
				end
			elseif sourceConsumableIndex > 0 then
				self:RequestMovePartToBagSlot(instanceId, targetBagIndex, "consumable")
			end
		elseif wasClick == true and sourceBagIndex > 0 then
			self:HandleBagPartClick(instanceId, sourceBagIndex)
		elseif wasClick == true and sourceConsumableIndex > 0 then
			self:Log("consumable click ignored instance=" .. tostring(instanceId))
		elseif wasClick == false and (sourceSlot > 0 or sourceBagIndex > 0) then
			if isConsumable == true then
				self:Log("world drop skipped instance=" .. tostring(instanceId) .. " reason=consumableInventoryOnly")
			else
				self:RequestDropPartToWorld(instanceId, "outside")
			end
		elseif wasClick == false and sourceConsumableIndex > 0 then
			self:Log("world drop skipped instance=" .. tostring(instanceId) .. " reason=consumableSlot")
		else
			self:Log("drop ignored instance=" .. tostring(instanceId) .. " sourceSlot=" .. tostring(sourceSlot))
		end

		self.nextRequestAt = 0
		self:Log("drop instance=" .. tostring(instanceId) .. " sourceSlot=" .. tostring(sourceSlot) .. " sourceBag=" .. tostring(sourceBagIndex) .. " sourceConsumable=" .. tostring(sourceConsumableIndex) .. " targetSlot=" .. tostring(targetSlot) .. " targetBag=" .. tostring(targetBagIndex) .. " targetConsumable=" .. tostring(targetConsumableIndex))
	end

	@ExecSpace("ClientOnly")
	method void UpdateDragMoved(Vector2 screenPoint)
		local dx = math.abs(screenPoint.x - self.draggingStartX)
		local dy = math.abs(screenPoint.y - self.draggingStartY)
		if dx >= self:GetClickDragThreshold() or dy >= self:GetClickDragThreshold() then
			self.draggingMoved = true
		end
	end

	@ExecSpace("ClientOnly")
	method number GetSlotIndexAtScreenPoint(Vector2 screenPoint)
		local usingAuthoredHud = self:HasAuthoredBattleHudLayout()
		if usingAuthoredHud == true then
			for slotIndex = 1, self:GetChainSlotCount() do
				local slot = self:GetAuthoredChainSlotEntity(slotIndex)
				if self:IsScreenPointInsideEntity(screenPoint, slot) == true then
					return slotIndex
				end
			end
			return 0
		end

		for slotIndex = 1, self:GetChainSlotCount() do
			local slot = self:GetChainEntity("Panel/Chain/Slot_" .. tostring(slotIndex))
			if self:IsScreenPointInsideEntity(screenPoint, slot) == true then
				return slotIndex
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method number GetBagIndexAtScreenPoint(Vector2 screenPoint)
		for bagIndex = 1, self:GetBagSlotCount() do
			local tile = self:GetBagTouchEntity(bagIndex)
			if self:IsScreenPointInsideEntity(screenPoint, tile) == true then
				return bagIndex
			end
			local visual = self:GetInventoryEntity("Panel/Inventory/Item_" .. tostring(bagIndex))
			if visual ~= tile and self:IsScreenPointInsideEntity(screenPoint, visual) == true then
				return bagIndex
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method number GetConsumableIndexAtScreenPoint(Vector2 screenPoint)
		local slot = self:GetConsumableTouchEntity()
		if self:IsScreenPointInsideEntity(screenPoint, slot) == true then
			return 1
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method boolean IsScreenPointInsideEntity(Vector2 screenPoint, Entity entity)
		if entity == nil or entity.UITransformComponent == nil then
			return false
		end

		local localPosition = _UILogic:ScreenToLocalUIPosition(screenPoint, entity.UITransformComponent)
		local rectSize = entity.UITransformComponent.RectSize
		return math.abs(localPosition.x) <= rectSize.x * 0.5 and math.abs(localPosition.y) <= rectSize.y * 0.5
	end

	@ExecSpace("ClientOnly")
	method void UpdateSkillTooltipHover(Vector2 screenPoint)
		-- Shows Maple-style skill details while the cursor is over a skill icon.
		if self.draggingInstanceId > 0 then
			return
		end
		local target = self:GetSkillTooltipTargetAtScreenPoint(screenPoint)
		if target == nil then
			self:ClearSkillTooltipState()
			return
		end
		self:ApplySkillTooltipTarget(target, screenPoint, false)
	end

	@ExecSpace("ClientOnly")
	method void ToggleSkillTooltipLockAtCursor()
		-- Middle mouse locks the current tooltip so arrow keys can inspect other tiers.
		local screenPoint = _InputService:GetCursorPosition()
		local target = self:GetSkillTooltipTargetAtScreenPoint(screenPoint)
		if target == nil then
			self:ClearSkillTooltipState()
			self:Log("tooltip unlock reason=noTarget")
			return
		end

		local sameTarget = self.tooltipLocked == true and self.tooltipSourceKind == self:ReadString(target.Kind, "") and self.tooltipSourceIndex == self:ReadNumber(target.Index, 0) and self:GetBaseSkillKey(self.tooltipSkillKey) == self:GetBaseSkillKey(self:ReadString(target.SkillKey, "Default"))
		if sameTarget == true then
			self.tooltipLocked = false
			self:ApplySkillTooltipTarget(target, screenPoint, false)
			self:Log("tooltip unlock skill=" .. self:ReadString(target.SkillKey, "Default"))
			return
		end

		self:ApplySkillTooltipTarget(target, screenPoint, true)
		self:Log("tooltip lock skill=" .. self:ReadString(target.SkillKey, "Default") .. " tier=" .. tostring(math.floor(self:ReadNumber(target.Tier, 1))))
	end

	@ExecSpace("ClientOnly")
	method void ShiftSkillTooltipTier(number delta)
		if self.tooltipSkillKey == "" then
			return
		end
		local nextTier = math.floor(self:ReadNumber(self.tooltipTier, 1)) + math.floor(self:ReadNumber(delta, 0))
		nextTier = math.max(1, math.min(4, nextTier))
		if nextTier == self.tooltipTier then
			return
		end
		self.tooltipTier = nextTier
		self:RenderSkillTooltip(self.tooltipSkillKey, self.tooltipTier)
		self:LogSkillTooltipSummary("tier")
	end

	@ExecSpace("ClientOnly")
	method void ApplySkillTooltipTarget(any target, Vector2 screenPoint, boolean locked)
		if target == nil then
			self:ClearSkillTooltipState()
			return
		end
		self.tooltipLocked = locked == true
		self.tooltipSkillKey = self:ReadString(target.SkillKey, "Default")
		self.tooltipTier = math.max(1, math.floor(self:ReadNumber(target.Tier, 1)))
		self.tooltipSourceKind = self:ReadString(target.Kind, "")
		self.tooltipSourceIndex = math.floor(self:ReadNumber(target.Index, 0))
		self:RenderSkillTooltip(self.tooltipSkillKey, self.tooltipTier)
		self:MoveSkillTooltipToScreen(screenPoint)
		self:LogSkillTooltipSummary("hover")
	end

	@ExecSpace("ClientOnly")
	method any GetSkillTooltipTargetAtScreenPoint(Vector2 screenPoint)
		local slots = self._T.chainSlots
		local representative = self:GetChainEntity(self:GetRepresentativeChainSlotPath())
		if self:IsScreenPointInsideEntity(screenPoint, representative) == true then
			for slotIndex = 1, self:GetChainSlotCount() do
				local record = nil
				if slots ~= nil then
					record = slots[slotIndex]
				end
				if record ~= nil and self:IsLockedChainSlotRecord(record) ~= true and self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0 then
					return {
						Kind = "REPRESENTATIVE",
						Index = 0,
						SkillKey = self:GetRecordSkillKey(record),
						Tier = self:GetChainDisplayTier(slotIndex, record)
					}
				end
			end
		end

		for commonIndex = 1, self:GetCommonSkillSlotCount() do
			local common = self:GetChainEntity("Panel/Chain/Common_" .. tostring(commonIndex))
			if self:IsScreenPointInsideEntity(screenPoint, common) == true then
				local skillKey = self:GetCommonSkillKey(commonIndex)
				if self:IsCommonSkillAvailable(skillKey) == true then
					return {
						Kind = "COMMON",
						Index = commonIndex,
						SkillKey = skillKey,
						Tier = 1
					}
				end
			end
		end

		for slotIndex = 1, self:GetChainSlotCount() do
			local slot = self:GetAuthoredChainSlotEntity(slotIndex)
			if slot == nil then
				slot = self:GetChainEntity(self:GetInternalChainSlotPath(slotIndex))
			end
			if self:IsScreenPointInsideEntity(screenPoint, slot) == true then
				local record = self:GetChainSlot(slotIndex)
				if record ~= nil and self:IsLockedChainSlotRecord(record) ~= true and self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0 then
					return {
						Kind = "CHAIN",
						Index = slotIndex,
						SkillKey = self:GetRecordSkillKey(record),
						Tier = self:GetChainDisplayTier(slotIndex, record)
					}
				end
			end
		end

		for bagIndex = 1, self:GetBagSlotCount() do
			local bag = self:GetBagTouchEntity(bagIndex)
			if self:IsScreenPointInsideEntity(screenPoint, bag) == true then
				local part = self:GetBagPart(bagIndex)
				if part ~= nil and self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0) > 0 then
					return {
						Kind = "BAG",
						Index = bagIndex,
						SkillKey = self:GetRecordSkillKey(part),
						Tier = math.max(1, math.floor(self:ReadNumber(self:ReadRecordValue(part, "Tier"), 1)))
					}
				end
			end
			local visual = self:GetInventoryEntity("Panel/Inventory/Item_" .. tostring(bagIndex))
			if visual ~= bag and self:IsScreenPointInsideEntity(screenPoint, visual) == true then
				local part = self:GetBagPart(bagIndex)
				if part ~= nil and self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0) > 0 then
					return {
						Kind = "BAG",
						Index = bagIndex,
						SkillKey = self:GetRecordSkillKey(part),
						Tier = math.max(1, math.floor(self:ReadNumber(self:ReadRecordValue(part, "Tier"), 1)))
					}
				end
			end
		end

		return nil
	end

	@ExecSpace("ClientOnly")
	method void RenderSkillTooltip(string skillKey, number tier)
		local safeSkillKey = self:ReadString(skillKey, "Default")
		local safeTier = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		local name = safeSkillKey
		local description = ""
		local category = ""
		local iconRuid = self:GetFallbackIconRUID()
		if _BRSkillUIDatabase ~= nil then
			local data = _BRSkillUIDatabase:GetSkillDisplayData(safeSkillKey, safeTier)
			if data ~= nil then
				name = self:ReadString(data.Name, name)
				description = self:ReadString(data.Description, "")
				category = self:ReadString(data.Category, "")
				iconRuid = self:ReadString(data.IconRUID, iconRuid)
				safeTier = math.max(1, math.floor(self:ReadNumber(data.Tier, safeTier)))
			end
		end
		if description == "" then
			description = "스킬 설명 없음"
		end
		if category == "" then
			category = "스킬"
		end

		self:SetSkillTooltipActive(true)
		self:SetSkillTooltipSprite("Icon", iconRuid)
		self:SetSkillTooltipText("Name", name)
		self:SetSkillTooltipText("Tier", tostring(safeTier) .. "차")
		self:SetSkillTooltipText("Category", category)
		self:SetSkillTooltipText("Description", description)
		self:SetSkillTooltipText("Hint", "휠 클릭 고정 / 좌우 방향키 차수 보기")
	end

	@ExecSpace("ClientOnly")
	method void MoveSkillTooltipToScreen(Vector2 screenPoint)
		local tooltip = self:GetSkillTooltipEntity("")
		if tooltip == nil or tooltip.UITransformComponent == nil then
			return
		end
		local width = self:GetSkillTooltipWidth()
		local height = self:GetSkillTooltipHeight()
		local uiPosition = _UILogic:ScreenToUIPosition(screenPoint)
		local x = uiPosition.x + 18
		local y = uiPosition.y - 16
		local minX = -948
		local maxX = 948 - width
		local minY = -528 + height
		local maxY = 528
		if x > maxX then
			x = uiPosition.x - width - 18
		end
		x = math.max(minX, math.min(maxX, x))
		y = math.max(minY, math.min(maxY, y))
		tooltip.UITransformComponent.Pivot = Vector2(0, 1)
		tooltip.UITransformComponent.RectSize = Vector2(width, height)
		tooltip.UITransformComponent.anchoredPosition = Vector2(x, y)
	end

	@ExecSpace("ClientOnly")
	method void ClearSkillTooltipState()
		self.tooltipLocked = false
		self.tooltipSkillKey = ""
		self.tooltipTier = 1
		self.tooltipSourceKind = ""
		self.tooltipSourceIndex = 0
		self:SetSkillTooltipActive(false)
	end

	@ExecSpace("ClientOnly")
	method void SetSkillTooltipActive(boolean active)
		local tooltip = self:GetSkillTooltipEntity("")
		if tooltip == nil then
			return
		end
		tooltip.Enable = active == true
		if tooltip.CanvasGroupComponent ~= nil then
			if active == true then
				tooltip.CanvasGroupComponent.GroupAlpha = 0.98
			else
				tooltip.CanvasGroupComponent.GroupAlpha = 0
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetSkillTooltipText(string relativePath, string text)
		local entity = self:GetSkillTooltipEntity(relativePath)
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetSkillTooltipSprite(string relativePath, string ruid)
		local entity = self:GetSkillTooltipEntity(relativePath)
		if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.ImageRUID = DataRef(self:ReadString(ruid, self:GetFallbackIconRUID()))
			entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		end
	end

	method Entity GetSkillTooltipEntity(string relativePath)
		local path = "SkillTooltip"
		local suffix = self:ReadString(relativePath, "")
		if suffix ~= "" then
			path = path .. "/" .. suffix
		end
		return self:GetEntityFromRoot(self:GetChainRootPath(), path)
	end

	method string GetCommonSkillKey(number index)
		local safeIndex = math.floor(self:ReadNumber(index, 0))
		if safeIndex == 1 then
			local uniqueSkillKey = "Unique"
			if _BRCharacterSystem ~= nil then
				uniqueSkillKey = self:ReadString(_BRCharacterSystem:GetLocalUniqueSkillKey(), uniqueSkillKey)
			end
			return uniqueSkillKey
		elseif safeIndex == 2 then
			return "Blink"
		elseif safeIndex == 3 then
			return "Nimbus"
		end
		return ""
	end

	method boolean IsCommonSkillAvailable(string skillKey)
		local key = self:ReadString(skillKey, "")
		if key == "" then
			return false
		end
		if _BRSkillSystem == nil then
			return true
		end
		return _BRSkillSystem:HasSkillDefinition(key) == true
	end

	method number GetSkillTooltipWidth()
		return math.max(260, self:ReadNumber(self.TooltipWidth, 360))
	end

	method number GetSkillTooltipHeight()
		return math.max(160, self:ReadNumber(self.TooltipHeight, 228))
	end

	method void LogSkillTooltipSummary(string reason)
		self:EnsureRuntime()
		local summary = self:ReadString(reason, "hover") .. ":" .. self:ReadString(self.tooltipSkillKey, "") .. ":" .. tostring(math.floor(self:ReadNumber(self.tooltipTier, 1))) .. ":" .. tostring(self.tooltipLocked == true)
		if self._T.lastTooltipSummary == summary then
			return
		end
		self._T.lastTooltipSummary = summary
		self:Log("tooltip " .. summary)
	end

	@ExecSpace("ClientOnly")
	method void MoveGhostToTouch(Vector2 screenPoint)
		local ghost = self:GetChainEntity("DragGhost")
		if ghost == nil or ghost.UITransformComponent == nil then
			return
		end

		local uiPosition = _UILogic:ScreenToUIPosition(screenPoint)
		ghost.UITransformComponent.anchoredPosition = uiPosition
	end

	@ExecSpace("ClientOnly")
	method void RenderChain()
		-- Renders one representative skill icon and five internal sequence slots.
		local slots = self._T.chainSlots
		local lockedCount = 0
		local effectCount = 0
		local leftConnectCount = 0
		local rightConnectCount = 0
		self:RenderChainRepresentativeVisual(slots)
		for slotIndex = 1, self:GetChainSlotCount() do
			local basePath = self:GetInternalChainSlotPath(slotIndex)
			local labelPath = basePath .. "/Label"
			local tierPath = basePath .. "/Tier"
			local record = nil
			if slots ~= nil then
				record = slots[slotIndex]
			end
			self:SetChainTextByPath(labelPath, "")
			self:SetChainTextByPath(tierPath, "")
			if self:IsLockedChainSlotRecord(record) == true then
				lockedCount = lockedCount + 1
			elseif record ~= nil and self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0 then
				if self:IsLeadChainSlot(slotIndex, record) == true and self:GetChainDisplayTier(slotIndex, record) > 1 then
					effectCount = effectCount + 1
				end
				if self:ShouldShowLeftConnect(slotIndex, record) == true then
					leftConnectCount = leftConnectCount + 1
				end
				if self:ShouldShowRightConnect(slotIndex, record) == true then
					rightConnectCount = rightConnectCount + 1
				end
			end
			self:RenderChainSlotVisual(slotIndex, record)
		end
		self:LogChainDecorationSummary(lockedCount, effectCount, leftConnectCount, rightConnectCount)
	end

	@ExecSpace("ClientOnly")
	method void RenderChainRepresentativeVisual(any slots)
		-- Uses the left icon as the whole chain's representative image.
		local representativePath = self:GetRepresentativeChainSlotPath()
		local representativeSlotIndex = self:GetRepresentativeChainSlotIndex(slots)
		local record = self:GetChainSlotRecordFromSnapshot(slots, representativeSlotIndex)
		local skillKey = "Default"
		local displayTier = 1
		local occupied = false
		if record ~= nil then
			skillKey = self:GetRecordSkillKey(record)
			displayTier = self:GetChainDisplayTier(representativeSlotIndex, record)
			occupied = self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0
		end
		self:SetChainTextByPath(representativePath .. "/Label", "")
		self:SetChainTextByPath(representativePath .. "/Tier", "")
		self:SetSkillSlotVisual("CHAIN", representativePath, skillKey, displayTier, occupied, true, false)
		self:SetSlotFrameColor("CHAIN", representativePath, Color(1.0, 0.86, 0.24, 1.0))
	end

	@ExecSpace("ClientOnly")
	method void RenderBag()
		-- Renders spare skill parts as icon-only inventory slots.
		local occupiedCount = 0
		for index = 1, self:GetBagSlotCount() do
			local part = self:GetBagPart(index)
			local occupied = false
			local skillKey = "Default"
			local equipped = false
			if part == nil then
				self:SetInventoryItemActive(index, true)
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Label", "")
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Name", "")
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Equipped", "")
			else
				self:SetInventoryItemActive(index, true)
				local equippedSlot = math.floor(self:ReadNumber(part.EquippedSlot, 0))
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Label", "")
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Name", "")
				self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Equipped", "")
				occupied = self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0) > 0
				if occupied == true then
					skillKey = self:GetRecordSkillKey(part)
					equipped = equippedSlot > 0
					occupiedCount = occupiedCount + 1
				end
			end
			self:RenderBagSlotVisual(index, part, equipped)
		end
		self:LogBagRenderSummary(occupiedCount)
	end

	method void LogBagRenderSummary(number occupiedCount)
		-- Logs inventory icon refresh evidence only when the visible bag count changes.
		self:EnsureRuntime()
		local summary = "occupied=" .. tostring(math.floor(self:ReadNumber(occupiedCount, 0)))
			.. "/" .. tostring(self:GetBagSlotCount())
		if self._T.lastBagRenderSummary == summary then
			return
		end
		self._T.lastBagRenderSummary = summary
		self:Log("bag render " .. summary)
	end

	@ExecSpace("ClientOnly")
	method void RenderConsumableSlot()
		-- Renders the authored BattleHub/Sobie_1 consumable slot.
		local part = self:GetConsumableSlotPart()
		local occupied = part ~= nil and self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0) > 0
		local skillKey = "Default"
		if occupied == true then
			skillKey = self:GetRecordSkillKey(part)
		end
		self:SetSkillSlotVisualWithIcon("CHAIN", "Panel/Chain/Sobie_1", skillKey, 1, occupied, false, false, self:GetRecordIconRUID(part))
		self:ApplySlotCooldownVisual("CHAIN", "Panel/Chain/Sobie_1", "consumable", occupied)
		self:SetSlotFrameColor("CHAIN", "Panel/Chain/Sobie_1", Color(0.45, 0.95, 0.78, 0.95))
	end

	@ExecSpace("ClientOnly")
	method void RenderChainSlotVisual(number slotIndex, any record)
		-- Applies icon, base tint, and order frame to one internal chain slot.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		local basePath = self:GetInternalChainSlotPath(safeSlotIndex)
		local locked = self:IsLockedChainSlotRecord(record)
		self:SetChainSlotLockVisual(safeSlotIndex, locked)
		self:SetChainSlotChainEffectVisual(safeSlotIndex, 0, false)
		self:SetChainSlotConnectVisual(safeSlotIndex, false, false)
		if locked == true then
			self:SetSkillSlotVisual("CHAIN", basePath, "Default", 0, false, false, false)
			self:SetVisualSpriteColor("CHAIN", basePath, Color(0.035, 0.04, 0.055, 0.82))
			self:SetSlotFrameColor("CHAIN", basePath, Color(0.78, 0.82, 0.9, 0.62))
			return
		end
		local occupied = record ~= nil and self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0
		local displayTier = 0
		local isLeadSlot = false
		local skillKey = "Default"
		if occupied == true then
			skillKey = self:GetRecordSkillKey(record)
			displayTier = self:GetChainDisplayTier(safeSlotIndex, record)
			isLeadSlot = self:IsLeadChainSlot(safeSlotIndex, record)
		else
			displayTier = 0
		end
		self:SetSkillSlotVisualWithIcon("CHAIN", basePath, skillKey, displayTier, occupied, isLeadSlot, false, self:GetRecordIconRUID(record))
		self:SetChainSlotChainEffectVisual(safeSlotIndex, displayTier, occupied == true and isLeadSlot == true and displayTier > 1)
		self:SetChainSlotConnectVisual(safeSlotIndex, self:ShouldShowLeftConnect(safeSlotIndex, record), self:ShouldShowRightConnect(safeSlotIndex, record))
	end

	@ExecSpace("ClientOnly")
	method void SetChainSlotLockVisual(number slotIndex, boolean locked)
		-- Authored HUD slots expose a child named Lock for the locked overlay.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 0 then
			return
		end
		local basePath = self:GetInternalChainSlotPath(safeSlotIndex)
		self:SetChainEntityEnabled(basePath .. "/Lock", locked == true)
	end

	@ExecSpace("ClientOnly")
	method void SetChainSlotChainEffectVisual(number slotIndex, number tier, boolean active)
		-- Only the lead slot in a folded chain run shows Chain_N. Tier 1 has no effect.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 0 then
			return
		end
		local basePath = self:GetInternalChainSlotPath(safeSlotIndex)
		for effectTier = 2, self:GetChainSlotCount() do
			self:SetChainEntityEnabled(basePath .. "/Chain_" .. tostring(effectTier), false)
		end
		local safeTier = math.floor(self:ReadNumber(tier, 0))
		if active == true and safeTier > 1 then
			self:SetChainEntityEnabled(basePath .. "/Chain_" .. tostring(safeTier), true)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetChainSlotConnectVisual(number slotIndex, boolean leftActive, boolean rightActive)
		-- Authored HUD slots expose LeftConnect/RightConnect children for trigger links.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 0 then
			return
		end
		local basePath = self:GetInternalChainSlotPath(safeSlotIndex)
		self:SetChainEntityEnabled(basePath .. "/LeftConnect", leftActive == true)
		self:SetChainEntityEnabled(basePath .. "/RightConnect", rightActive == true)
		self:SetChainEntityEnabled(basePath .. "/RightConect", rightActive == true)
	end

	method void LogChainDecorationSummary(number lockedCount, number effectCount, number leftConnectCount, number rightConnectCount)
		self:EnsureRuntime()
		local summary = "locked=" .. tostring(math.floor(self:ReadNumber(lockedCount, 0)))
			.. " effects=" .. tostring(math.floor(self:ReadNumber(effectCount, 0)))
			.. " left=" .. tostring(math.floor(self:ReadNumber(leftConnectCount, 0)))
			.. " right=" .. tostring(math.floor(self:ReadNumber(rightConnectCount, 0)))
		if self._T.lastChainDecorationSummary == summary then
			return
		end
		self._T.lastChainDecorationSummary = summary
		self:Log("chain decoration refresh " .. summary)
	end

	@ExecSpace("ClientOnly")
	method void RenderBagSlotVisual(number bagIndex, any part, boolean equipped)
		-- Applies icon, base tint, and equipped frame to one spare slot.
		local safeBagIndex = math.floor(self:ReadNumber(bagIndex, 0))
		local occupied = part ~= nil and self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0) > 0
		local skillKey = "Default"
		if occupied == true then
			skillKey = self:GetRecordSkillKey(part)
		end
		self:SetSkillSlotVisualWithIcon("BAG", "Panel/Inventory/Item_" .. tostring(safeBagIndex), skillKey, 1, occupied == true, false, equipped == true, self:GetRecordIconRUID(part))
	end

	@ExecSpace("ClientOnly")
	method void RenderBagSlotVisualByKey(number bagIndex, string skillKey, boolean occupied, boolean equipped)
		-- Renders a spare slot from primitive values so runtime snapshot records are not passed through UI helper calls.
		local safeBagIndex = math.floor(self:ReadNumber(bagIndex, 0))
		self:SetSkillSlotVisual("BAG", "Panel/Inventory/Item_" .. tostring(safeBagIndex), skillKey, 1, occupied == true, false, equipped == true)
	end

	@ExecSpace("ClientOnly")
	method void RenderDragGhostVisual(any record, number tier, boolean isLeadSlot)
		-- Applies the dragged skill icon to the floating ghost.
		local occupied = record ~= nil and self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0
		local skillKey = "Default"
		if occupied == true then
			skillKey = self:GetRecordSkillKey(record)
		end
		self:SetChainTextByPath("DragGhost/Label", "")
		self:SetSkillSlotVisualWithIcon("CHAIN", "DragGhost", skillKey, self:ReadNumber(tier, 1), occupied, isLeadSlot == true, false, self:GetRecordIconRUID(record))
	end

	@ExecSpace("ClientOnly")
	method void SetSkillSlotVisual(string rootKind, string basePath, string skillKey, number tier, boolean occupied, boolean isLeadSlot, boolean equipped)
		-- Updates one slot from the canonical skill UI database.
		self:SetSkillSlotVisualWithIcon(rootKind, basePath, skillKey, tier, occupied, isLeadSlot, equipped, "")
	end

	@ExecSpace("ClientOnly")
	method void SetSkillSlotVisualWithIcon(string rootKind, string basePath, string skillKey, number tier, boolean occupied, boolean isLeadSlot, boolean equipped, string iconRuidOverride)
		-- Updates one slot, preferring a snapshot icon when it is available.
		local safeRootKind = self:ReadString(rootKind, "CHAIN")
		local safeBasePath = self:ReadString(basePath, "")
		local safeTier = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		local useSolidIcon = false
		local iconRuid = self:GetSlotIconRUID(skillKey, safeTier, isLeadSlot == true, useSolidIcon)
		local overrideRuid = self:ReadString(iconRuidOverride, "")
		if occupied == true and overrideRuid ~= "" then
			iconRuid = overrideRuid
		end
		local baseColor = self:GetSlotBaseColor(occupied == true, safeTier, equipped == true)
		local borderColor = self:GetSlotBorderColor(safeTier, occupied == true, isLeadSlot == true)
		local iconColor = self:GetSlotIconDisplayColor(skillKey, safeTier, occupied == true, isLeadSlot == true, useSolidIcon)

		self:SetVisualSpriteColor(safeRootKind, safeBasePath, baseColor)
		local iconPath = self:ApplySlotIconVisual(safeRootKind, safeBasePath, iconRuid, iconColor)
		if iconPath ~= "" then
			self:SetVisualEntityEnabled(safeRootKind, iconPath, true)
			local iconEntity = self:GetVisualEntity(safeRootKind, iconPath)
			if iconEntity ~= nil and iconEntity.SpriteGUIRendererComponent ~= nil then
				iconEntity.SpriteGUIRendererComponent.Type = ImageType.Simple
				iconEntity.SpriteGUIRendererComponent.FillAmount = 1
			end
		elseif self:ShouldUseBattleHudIconChildOnly(safeRootKind, safeBasePath) ~= true then
			self:SetVisualSpriteImage(safeRootKind, safeBasePath, iconRuid)
			local baseEntity = self:GetVisualEntity(safeRootKind, safeBasePath)
			if baseEntity ~= nil and baseEntity.SpriteGUIRendererComponent ~= nil then
				baseEntity.SpriteGUIRendererComponent.Type = ImageType.Simple
				baseEntity.SpriteGUIRendererComponent.FillAmount = 1
			end
			if occupied == true then
				self:SetVisualSpriteColor(safeRootKind, safeBasePath, iconColor)
			else
				self:SetVisualSpriteColor(safeRootKind, safeBasePath, baseColor)
			end
		end
		self:SetSlotFrameColor(safeRootKind, safeBasePath, borderColor)
	end

	@ExecSpace("ClientOnly")
	method string ApplySlotIconVisual(string rootKind, string basePath, string iconRuid, Color iconColor)
		-- Authored slots do not all use the same child name, so try every known icon surface.
		local safeBasePath = self:ReadString(basePath, "")
		if self:ShouldUseBattleHudIconChildOnly(rootKind, safeBasePath) == true then
			local iconPath = safeBasePath .. "/Icon"
			if self:SetVisualSpriteImage(rootKind, iconPath, iconRuid) == true then
				self:SetVisualSpriteColor(rootKind, iconPath, iconColor)
				return iconPath
			end
			return ""
		end
		local candidates = {
			safeBasePath .. "/Icon",
			safeBasePath .. "/SkillIcon",
			safeBasePath .. "/Image",
			safeBasePath .. "/IconImage",
			safeBasePath .. "/ItemIcon",
			safeBasePath .. "/Skill",
			safeBasePath
		}
		for index, iconPath in ipairs(candidates) do
			if self:SetVisualSpriteImage(rootKind, iconPath, iconRuid) == true then
				self:SetVisualSpriteColor(rootKind, iconPath, iconColor)
				return iconPath
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void ResetSlotIconCooldownFill(string rootKind, string iconPath)
		-- Restores a slot icon before a per-action cooldown fill is applied.
		local iconEntity = self:GetVisualEntity(rootKind, iconPath)
		if iconEntity == nil or iconEntity.SpriteGUIRendererComponent == nil then
			return
		end
		iconEntity.SpriteGUIRendererComponent.Type = ImageType.Simple
		iconEntity.SpriteGUIRendererComponent.FillAmount = 1
	end

	@ExecSpace("ClientOnly")
	method void ApplySlotCooldownVisual(string rootKind, string basePath, string actionId, boolean available)
		-- Applies Maple-style bottom-up refill to hotkey skill icons during cooldown.
		local iconPath = self:FindSlotIconPath(rootKind, basePath)
		if iconPath == "" then
			return
		end
		local iconEntity = self:GetVisualEntity(rootKind, iconPath)
		if iconEntity == nil or iconEntity.SpriteGUIRendererComponent == nil then
			return
		end
		local readyRatio = 1
		if available == true and _BRCommonSkillSystem ~= nil then
			readyRatio = _BRCommonSkillSystem:GetActionCooldownReadyRatio(actionId)
		end
		local safeRatio = math.max(0, math.min(1, self:ReadNumber(readyRatio, 1)))
		if safeRatio >= 0.999 then
			iconEntity.SpriteGUIRendererComponent.Type = ImageType.Simple
			iconEntity.SpriteGUIRendererComponent.FillAmount = 1
			return
		end
		iconEntity.SpriteGUIRendererComponent.Type = ImageType.Filled
		iconEntity.SpriteGUIRendererComponent.FillMethod = FillMethodType.Vertical
		iconEntity.SpriteGUIRendererComponent.FillOrigin = 0
		iconEntity.SpriteGUIRendererComponent.FillAmount = safeRatio
	end

	method string FindSlotIconPath(string rootKind, string basePath)
		-- Finds the authored icon surface used by SetSkillSlotVisual.
		local safeBasePath = self:ReadString(basePath, "")
		if self:ShouldUseBattleHudIconChildOnly(rootKind, safeBasePath) == true then
			local iconPath = safeBasePath .. "/Icon"
			local entity = self:GetVisualEntity(rootKind, iconPath)
			if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
				return iconPath
			end
			return ""
		end
		local candidates = {
			safeBasePath .. "/Icon",
			safeBasePath .. "/SkillIcon",
			safeBasePath .. "/Image",
			safeBasePath .. "/IconImage",
			safeBasePath .. "/ItemIcon",
			safeBasePath .. "/Skill",
			safeBasePath
		}
		for index, iconPath in ipairs(candidates) do
			local entity = self:GetVisualEntity(rootKind, iconPath)
			if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
				return iconPath
			end
		end
		return ""
	end

	method boolean ShouldUseBattleHudIconChildOnly(string rootKind, string basePath)
		-- BattleHub slot backgrounds stay as authored art; skill images are injected only into the Icon child.
		if self:ReadString(rootKind, "CHAIN") ~= "CHAIN" then
			return false
		end
		if self:HasAuthoredBattleHudLayout() ~= true then
			return false
		end
		local path = self:ReadString(basePath, "")
		if path == "Panel/Chain/Representative" then
			return true
		end
		if path == "Panel/Chain/Sobie_1" or path == "Panel/Chain/Consumable_1" then
			return true
		end
		if self:StartsWith(path, "Panel/Chain/Slot_") == true then
			return true
		end
		if self:StartsWith(path, "Panel/Chain/Common_") == true then
			return true
		end
		if self:StartsWith(path, "BattleHub/") == true or self:StartsWith(path, "Bg/") == true then
			return true
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void SetSlotFrameColor(string rootKind, string basePath, Color color)
		-- Colors the four thin frame sprites around a slot.
		self:SetVisualSpriteColor(rootKind, basePath .. "/FrameTop", color)
		self:SetVisualSpriteColor(rootKind, basePath .. "/FrameBottom", color)
		self:SetVisualSpriteColor(rootKind, basePath .. "/FrameLeft", color)
		self:SetVisualSpriteColor(rootKind, basePath .. "/FrameRight", color)
	end

	@ExecSpace("ClientOnly")
	method boolean SetVisualSpriteImage(string rootKind, string relativePath, string ruid)
		-- Assigns a UI sprite RUID through the correct root group.
		local entity = self:GetVisualEntity(rootKind, relativePath)
		if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
			entity.Enable = true
			entity.SpriteGUIRendererComponent.Enable = true
			entity.SpriteGUIRendererComponent.ImageRUID = DataRef(self:ReadString(ruid, self:GetFallbackIconRUID()))
			return true
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void SetVisualEntityEnabled(string rootKind, string relativePath, boolean enabled)
		local entity = self:GetVisualEntity(rootKind, relativePath)
		if entity ~= nil then
			entity.Enable = enabled == true
			if entity.SpriteGUIRendererComponent ~= nil then
				entity.SpriteGUIRendererComponent.Enable = enabled == true
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetVisualSpriteColor(string rootKind, string relativePath, Color color)
		-- Assigns a UI sprite tint through the correct root group.
		local entity = self:GetVisualEntity(rootKind, relativePath)
		self:SetSpriteColor(entity, color)
	end

	method Entity GetVisualEntity(string rootKind, string relativePath)
		-- Resolves a visual entity from the chain or inventory group.
		if self:ReadString(rootKind, "CHAIN") == "BAG" then
			return self:GetInventoryEntity(relativePath)
		end
		return self:GetChainEntity(relativePath)
	end

	method boolean ShouldUseSolidSkillIcon(string rootKind, string basePath, boolean isLeadSlot)
		-- Chain slots now use the same CSV skill icons as the representative slot.
		return false
	end

	method string GetSlotIconRUID(string skillKey, number tier, boolean isLeadSlot, boolean useSolidIcon)
		-- Returns the skill icon declared in CSV, with the fallback only for missing data.
		if useSolidIcon == true then
			return self:GetFallbackIconRUID()
		end
		local consumableIcon = self:GetConsumableIconRUID(skillKey)
		if consumableIcon ~= "" then
			return consumableIcon
		end
		if _BRSkillUIDatabase ~= nil then
			local iconRuid = _BRSkillUIDatabase:GetSlotIconRUID(skillKey, tier, isLeadSlot == true)
			if self:ReadString(iconRuid, "") ~= "" then
				return iconRuid
			end
		end
		return self:GetFallbackIconRUID()
	end

	method string GetConsumableIconRUID(string skillKey)
		local key = self:ReadString(skillKey, "")
		if key == "Consumable_HealthPotion" then
			return "fb1622f63b424e62bc9668dfa880a449"
		elseif key == "Consumable_ShieldPotion" then
			return "d6237415a0ba4576b860874bbf5d0d4b"
		end
		return ""
	end

	method Color GetSlotIconDisplayColor(string skillKey, number tier, boolean occupied, boolean isRepresentative, boolean useSolidIcon)
		-- Real skill icons stay neutral; the solid-marker path is retained as a fallback hook.
		if useSolidIcon == true then
			return self:GetSolidSlotIconColor(skillKey, tier, occupied == true, isRepresentative == true)
		end
		return self:GetSlotIconColor(tier, occupied == true)
	end

	method Color GetSolidSlotIconColor(string skillKey, number tier, boolean occupied, boolean isRepresentative)
		if occupied ~= true then
			return Color(1, 1, 1, 0)
		end
		if isRepresentative == true then
			return Color(1.0, 0.86, 0.24, 1.0)
		end

		local order = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		local paletteIndex = ((order + self:GetSkillPaletteOffset(skillKey) - 2) % 5) + 1
		if paletteIndex == 1 then
			return Color(0.22, 0.72, 1.0, 0.98)
		elseif paletteIndex == 2 then
			return Color(0.28, 0.94, 0.58, 0.98)
		elseif paletteIndex == 3 then
			return Color(1.0, 0.78, 0.22, 0.98)
		elseif paletteIndex == 4 then
			return Color(1.0, 0.36, 0.26, 0.98)
		end
		return Color(0.78, 0.42, 1.0, 0.98)
	end

	method number GetSkillPaletteOffset(string skillKey)
		local key = self:GetBaseSkillKey(skillKey)
		if key == "Default" or key == "" then
			return 0
		end
		if key == "divineSwing" or key == "디바인 스윙" then
			return 0
		elseif key == "Blink" then
			return 1
		elseif key == "Nimbus" then
			return 2
		elseif key == "Unique" then
			return 3
		end

		local total = 0
		for index = 1, string.len(key) do
			total = total + string.byte(key, index)
		end
		return total % 5
	end

	method Color GetSlotBaseColor(boolean occupied, number tier, boolean equipped)
		-- Reads slot base tint data from the temporary skill UI database.
		if _BRSkillUIDatabase ~= nil then
			return _BRSkillUIDatabase:GetSlotBaseColor(occupied == true, tier, equipped == true)
		end
		if occupied ~= true then
			return Color(0.055, 0.07, 0.1, 0.72)
		end
		if equipped == true then
			return Color(0.09, 0.16, 0.14, 0.92)
		end
		return Color(0.08, 0.12, 0.18, 0.94)
	end

	method Color GetSlotBorderColor(number tier, boolean occupied, boolean isLeadSlot)
		-- Reads tier frame color data from the temporary skill UI database.
		if _BRSkillUIDatabase ~= nil then
			return _BRSkillUIDatabase:GetSlotBorderColor(tier, occupied == true, isLeadSlot == true)
		end
		if occupied ~= true then
			return Color(0.28, 0.34, 0.43, 0.42)
		end
		if tier >= 2 then
			return Color(1.0, 0.82, 0.22, 1.0)
		end
		return Color(0.34, 0.48, 0.68, 0.82)
	end

	method Color GetSlotIconColor(number tier, boolean occupied)
		-- Reads icon tint data from the temporary skill UI database.
		if _BRSkillUIDatabase ~= nil then
			return _BRSkillUIDatabase:GetIconColor(tier, occupied == true)
		end
		if occupied ~= true then
			return Color(1, 1, 1, 0)
		end
		return Color(1, 1, 1, 0.96)
	end

	method boolean IsLeadChainSlot(number slotIndex, any record)
		-- Returns true for the first visible slot in a folded same-skill run.
		if record == nil or self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) <= 0 then
			return false
		end
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 1 then
			return true
		end
		local previous = self:GetChainSlot(safeSlotIndex - 1)
		if previous == nil or self:ReadNumber(self:ReadRecordValue(previous, "InstanceId"), 0) <= 0 then
			return true
		end
		return self:GetBaseSkillKey(self:GetRecordSkillKey(previous)) ~= self:GetBaseSkillKey(self:GetRecordSkillKey(record))
	end

	method boolean IsOccupiedChainSlotRecord(any record)
		if record == nil or self:IsLockedChainSlotRecord(record) == true then
			return false
		end
		return self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0
	end

	method number GetChainDisplayTier(number slotIndex, any record)
		-- Uses the final folded tier on a run's first slot, and the local tier on follower slots.
		if record == nil then
			return 1
		end
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		local tier = math.max(1, math.floor(self:ReadNumber(self:ReadRecordValue(record, "Tier"), 1)))
		if self:IsLeadChainSlot(safeSlotIndex, record) ~= true then
			return tier
		end

		local baseKey = self:GetBaseSkillKey(self:GetRecordSkillKey(record))
		local maxTier = tier
		for nextSlot = safeSlotIndex + 1, self:GetChainSlotCount() do
			local nextRecord = self:GetChainSlot(nextSlot)
			if nextRecord == nil or self:ReadNumber(self:ReadRecordValue(nextRecord, "InstanceId"), 0) <= 0 then
				break
			end
			if self:GetBaseSkillKey(self:GetRecordSkillKey(nextRecord)) ~= baseKey then
				break
			end
			local nextTier = math.max(1, math.floor(self:ReadNumber(self:ReadRecordValue(nextRecord, "Tier"), 1)))
			if nextTier > maxTier then
				maxTier = nextTier
			end
		end
		return maxTier
	end

	method string GetRecordSkillKey(any record)
		-- Reads the base skill key from a chain or bag record.
		if record == nil then
			return "Default"
		end
		return self:GetBaseSkillKey(self:ReadString(self:ReadRecordValue(record, "SkillKey"), self:InferSkillKey(self:ReadRecordValue(record, "Short"), self:ReadRecordValue(record, "DisplayName"))))
	end

	method string GetRecordIconRUID(any record)
		-- Reads the exact icon RUID carried by a chain, bag, or consumable record.
		if record == nil then
			return ""
		end
		local iconRuid = self:ReadString(self:ReadRecordValue(record, "IconRUID"), "")
		if iconRuid ~= "" then
			return iconRuid
		end
		if _BRSkillSystem ~= nil and _BRSkillSystem["GetPartIconRUID"] ~= nil then
			return self:ReadString(_BRSkillSystem:GetPartIconRUID(record), "")
		end
		return ""
	end

	method boolean IsLockedChainSlotRecord(any record)
		-- Returns true for server-provided locked chain slot placeholders.
		if record == nil then
			return false
		end
		local tier = math.floor(self:ReadNumber(self:ReadRecordValue(record, "Tier"), 0))
		local skillKey = self:ReadString(self:ReadRecordValue(record, "SkillKey"), "")
		local displayName = self:ReadString(self:ReadRecordValue(record, "DisplayName"), "")
		return tier < 0 or skillKey == "LOCKED" or displayName == "LOCKED"
	end

	method boolean IsChainSlotLocked(number slotIndex)
		-- Checks whether the local snapshot marks one chain slot as locked.
		return self:IsLockedChainSlotRecord(self:GetChainSlot(slotIndex))
	end

	method boolean ShouldShowRightConnect(number slotIndex, any record)
		-- Trigger/starter parts always show the right connector by role, regardless of adjacency.
		if self:IsOccupiedChainSlotRecord(record) ~= true then
			return false
		end
		return self:SkillRecordHasTrigger(slotIndex, record)
	end

	method boolean ShouldShowLeftConnect(number slotIndex, any record)
		-- Non-trigger parts always show the left connector as follow-up-capable chain parts.
		if self:IsOccupiedChainSlotRecord(record) ~= true then
			return false
		end
		return self:SkillRecordHasTrigger(slotIndex, record) ~= true
	end

	method boolean IsTriggerStarterChainSlot(number slotIndex, any record)
		-- Returns true for a chain part marked by the server as a trigger/starter.
		if self:IsOccupiedChainSlotRecord(record) ~= true then
			return false
		end
		return self:SkillRecordHasTrigger(slotIndex, record)
	end

	method boolean IsLinkedChainSlotRecord(number slotIndex, any record)
		-- Returns true for a non-trigger chain part that can be consumed as a follow-up.
		if self:IsOccupiedChainSlotRecord(record) ~= true then
			return false
		end
		return self:SkillRecordHasTrigger(slotIndex, record) ~= true
	end

	method boolean IsLinkedChainGroup(number groupStartSlot)
		-- Mirrors runtime chain resolution: a linked end group cannot trigger another group.
		local safeGroupStartSlot = math.floor(self:ReadNumber(groupStartSlot, 0))
		if safeGroupStartSlot <= 0 then
			return false
		end
		local previousEndSlot = self:GetPreviousChainGroupEndSlot(safeGroupStartSlot)
		if previousEndSlot <= 0 then
			return false
		end
		local previousStartSlot = self:GetCurrentChainGroupStartSlot(previousEndSlot)
		if previousStartSlot <= 0 then
			return false
		end
		if self:IsLinkedChainGroup(previousStartSlot) == true then
			return false
		end
		return self:SkillRecordHasTrigger(previousEndSlot, self:GetChainSlot(previousEndSlot))
	end

	method boolean SkillRecordHasTrigger(number slotIndex, any record)
		-- Reads the server-provided trigger/starter marker for a rendered chain slot.
		if self:IsOccupiedChainSlotRecord(record) ~= true then
			return false
		end
		local value = self:ReadRecordValue(record, "HasTrigger")
		if value == true then
			return true
		end
		local text = string.lower(tostring(value))
		return text == "1" or text == "true" or text == "yes"
	end

	method number GetCurrentChainGroupStartSlot(number slotIndex)
		-- Finds the first slot in the contiguous same-skill group containing slotIndex.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		local currentRecord = self:GetChainSlot(safeSlotIndex)
		if self:IsOccupiedChainSlotRecord(currentRecord) ~= true then
			return 0
		end
		local currentBaseKey = self:GetBaseSkillKey(self:GetRecordSkillKey(currentRecord))
		local startSlot = safeSlotIndex
		for cursor = safeSlotIndex - 1, 1, -1 do
			local cursorRecord = self:GetChainSlot(cursor)
			if self:IsOccupiedChainSlotRecord(cursorRecord) ~= true then
				break
			end
			if self:GetBaseSkillKey(self:GetRecordSkillKey(cursorRecord)) ~= currentBaseKey then
				break
			end
			startSlot = cursor
		end
		return startSlot
	end

	method number GetCurrentChainGroupEndSlot(number slotIndex)
		-- Finds the last slot in the contiguous same-skill group containing slotIndex.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		local currentRecord = self:GetChainSlot(safeSlotIndex)
		if self:IsOccupiedChainSlotRecord(currentRecord) ~= true then
			return 0
		end
		local currentBaseKey = self:GetBaseSkillKey(self:GetRecordSkillKey(currentRecord))
		local endSlot = safeSlotIndex
		for cursor = safeSlotIndex + 1, self:GetChainSlotCount() do
			local cursorRecord = self:GetChainSlot(cursor)
			if self:IsOccupiedChainSlotRecord(cursorRecord) ~= true then
				break
			end
			if self:GetBaseSkillKey(self:GetRecordSkillKey(cursorRecord)) ~= currentBaseKey then
				break
			end
			endSlot = cursor
		end
		return endSlot
	end

	method number GetPreviousChainGroupLeadSlot(number slotIndex)
		-- Finds the first slot of the group immediately before slotIndex.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 1 then
			return 0
		end
		local previousEndSlot = self:GetPreviousChainGroupEndSlot(safeSlotIndex)
		if previousEndSlot <= 0 then
			return 0
		end
		return self:GetCurrentChainGroupStartSlot(previousEndSlot)
	end

	method number GetPreviousChainGroupEndSlot(number slotIndex)
		-- Finds the last slot of the group immediately before slotIndex.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 1 then
			return 0
		end
		local previousSlot = safeSlotIndex - 1
		local previousRecord = self:GetChainSlot(previousSlot)
		if self:IsOccupiedChainSlotRecord(previousRecord) ~= true then
			return 0
		end
		return self:GetCurrentChainGroupEndSlot(previousSlot)
	end

	method number GetNextChainGroupLeadSlot(number slotIndex)
		-- Finds the first slot of the group immediately after slotIndex.
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		local currentRecord = self:GetChainSlot(safeSlotIndex)
		if self:IsOccupiedChainSlotRecord(currentRecord) ~= true then
			return 0
		end
		local currentBaseKey = self:GetBaseSkillKey(self:GetRecordSkillKey(currentRecord))
		for cursor = safeSlotIndex + 1, self:GetChainSlotCount() do
			local cursorRecord = self:GetChainSlot(cursor)
			if self:IsOccupiedChainSlotRecord(cursorRecord) ~= true then
				return 0
			end
			if self:GetBaseSkillKey(self:GetRecordSkillKey(cursorRecord)) ~= currentBaseKey then
				return cursor
			end
		end
		return 0
	end

	method string InferSkillKey(any shortText, any displayName)
		-- Old snapshots without SkillKey cannot be safely mapped after CSV migration.
		return "Default"
	end

	method string GetBaseSkillKey(string skillKey)
		-- Normalizes tiered runtime keys back to their base catalog key.
		local key = self:ReadString(skillKey, "Default")
		key = self:ReadString(string.match(key, "^(.-)%d*$"), key)
		if key == "" or key == "-" then
			return "Default"
		end
		return key
	end

	method string GetFallbackIconRUID()
		-- Returns a safe placeholder RUID when the icon database is unavailable.
		return "4fea64a3307cda641809ad8be0d4890b"
	end

	method string GetRepresentativeChainSlotPath()
		-- Authored battle HUD stores the whole-skill icon separately from sequence parts.
		if self:HasAuthoredBattleHudLayout() == true then
			return "Panel/Chain/Representative"
		end
		return "Panel/Chain/Slot_1"
	end

	method string GetInternalChainSlotPath(number slotIndex)
		-- In the authored HUD, Slot_1 is reserved for the representative image alias.
		local safeSlotIndex = math.max(1, math.floor(self:ReadNumber(slotIndex, 1)))
		if self:HasAuthoredBattleHudLayout() == true then
			return "Panel/Chain/Slot_" .. tostring(safeSlotIndex + 1)
		end
		return "Panel/Chain/Slot_" .. tostring(safeSlotIndex)
	end

	method any GetRepresentativeChainRecord(any slots)
		if slots == nil then
			return nil
		end
		return self:GetChainSlotRecordFromSnapshot(slots, self:GetRepresentativeChainSlotIndex(slots))
	end

	method number GetRepresentativeChainSlotIndex(any slots)
		-- Finds the left-most active chain slot so the representative icon follows its folded tier.
		if slots == nil then
			return 0
		end
		for slotIndex = 1, self:GetChainSlotCount() do
			local record = slots[slotIndex]
			if record ~= nil and self:IsLockedChainSlotRecord(record) ~= true and self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0 then
				return slotIndex
			end
		end
		return 0
	end

	method any GetChainSlotRecordFromSnapshot(any slots, number slotIndex)
		-- Reads a chain slot record from a snapshot table with nil-safe index handling.
		if slots == nil then
			return nil
		end
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 0 then
			return nil
		end
		return slots[safeSlotIndex]
	end

	method any ParseChainText(string text)
		local result = {}
		for record in string.gmatch(self:ReadString(text, ""), "([^;]+)") do
			local parts = self:SplitCommaRecord(record)
			local slotIndex = math.floor(self:ReadNumber(parts[1], 0))
			if slotIndex > 0 then
				result[slotIndex] = {
					Slot = slotIndex,
					InstanceId = math.floor(self:ReadNumber(parts[2], 0)),
					Short = self:ReadString(parts[3], "-"),
					Tier = math.floor(self:ReadNumber(parts[4], 0)),
					DisplayName = self:ReadString(parts[5], "-"),
					SkillKey = self:ReadString(parts[6], self:InferSkillKey(parts[3], parts[5])),
					HasTrigger = self:ReadString(parts[7], "0") == "1",
					ItemType = self:ReadString(parts[8], "SKILL"),
					IconRUID = self:ReadString(parts[9], "")
				}
			end
		end
		return result
	end

	method any ParseBagText(string text)
		local result = {}
		for record in string.gmatch(self:ReadString(text, ""), "([^;]+)") do
			local parts = self:SplitCommaRecord(record)
			local slotIndex = #result + 1
			local instanceId = math.floor(self:ReadNumber(parts[1], 0))
			local shortIndex = 2
			local tierIndex = 4
			local displayIndex = 5
			local skillKeyIndex = 6
			local triggerIndex = 7
			local itemTypeIndex = 8
			local iconRuidIndex = 9
			if tonumber(parts[2]) ~= nil then
				slotIndex = math.floor(self:ReadNumber(parts[1], 0))
				instanceId = math.floor(self:ReadNumber(parts[2], 0))
				shortIndex = 3
				tierIndex = 4
				displayIndex = 5
				skillKeyIndex = 6
				triggerIndex = 7
				itemTypeIndex = 8
				iconRuidIndex = 9
			end
			if instanceId > 0 then
				result[slotIndex] = {
					InstanceId = instanceId,
					Short = self:ReadString(parts[shortIndex], "P"),
					EquippedSlot = 0,
					Tier = math.floor(self:ReadNumber(parts[tierIndex], 0)),
					DisplayName = self:ReadString(parts[displayIndex], "Skill"),
					SkillKey = self:ReadString(parts[skillKeyIndex], self:InferSkillKey(parts[shortIndex], parts[displayIndex])),
					HasTrigger = self:ReadString(parts[triggerIndex], "0") == "1",
					ItemType = self:ReadString(parts[itemTypeIndex], "SKILL"),
					IconRUID = self:ReadString(parts[iconRuidIndex], "")
				}
			end
		end
		return result
	end

	method any ParseConsumableText(string text)
		local result = nil
		for record in string.gmatch(self:ReadString(text, ""), "([^;]+)") do
			local parts = self:SplitCommaRecord(record)
			local instanceId = math.floor(self:ReadNumber(parts[2], 0))
			if instanceId > 0 then
				result = {
					Slot = math.floor(self:ReadNumber(parts[1], 1)),
					InstanceId = instanceId,
					Short = self:ReadString(parts[3], "USE"),
					EquippedSlot = 0,
					Tier = math.floor(self:ReadNumber(parts[4], 1)),
					DisplayName = self:ReadString(parts[5], "Consumable"),
					SkillKey = self:ReadString(parts[6], "Default"),
					HasTrigger = false,
					ItemType = self:ReadString(parts[8], "CONSUMABLE"),
					IconRUID = self:ReadString(parts[9], "")
				}
			end
		end
		return result
	end

	method any GetChainSlot(number slotIndex)
		local slots = self._T.chainSlots
		if slots == nil then
			return nil
		end
		return slots[math.floor(self:ReadNumber(slotIndex, 0))]
	end

	method any ReadRecordValue(any record, string key)
		if record == nil then
			return nil
		end
		return record[key]
	end

	method any GetBagPart(number bagIndex)
		local parts = self._T.bagParts
		if parts == nil then
			return nil
		end
		local part = parts[math.floor(self:ReadNumber(bagIndex, 0))]
		if part == nil or math.floor(self:ReadNumber(part.InstanceId, 0)) <= 0 then
			return nil
		end
		return part
	end

	method any GetConsumableSlotPart()
		local part = self._T.consumableSlot
		if part == nil or math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0)) <= 0 then
			return nil
		end
		return part
	end

	method any GetLocalRecordByInstanceId(number instanceId)
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return nil
		end
		local consumable = self:GetConsumableSlotPart()
		if consumable ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(consumable, "InstanceId"), 0)) == safeInstanceId then
			return consumable
		end
		local bagPart = self:FindLocalBagPartByInstanceId(safeInstanceId)
		if bagPart ~= nil then
			return bagPart
		end
		local chainSlot = self:FindLocalChainSlotByInstanceId(safeInstanceId)
		if chainSlot > 0 then
			return self:GetChainSlot(chainSlot)
		end
		return nil
	end

	method boolean IsConsumableRecord(any record)
		if record == nil then
			return false
		end
		if string.upper(self:ReadString(self:ReadRecordValue(record, "ItemType"), "SKILL")) == "CONSUMABLE" then
			return true
		end
		local skillKey = self:GetRecordSkillKey(record)
		return skillKey == "Consumable_HealthPotion" or skillKey == "Consumable_ShieldPotion"
	end

	@ExecSpace("ClientOnly")
	method void SetInventoryItemActive(number bagIndex, boolean active)
		local indexText = tostring(math.floor(self:ReadNumber(bagIndex, 0)))
		local tile = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText)
		local icon = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText .. "/Icon")
		local skillIcon = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText .. "/SkillIcon")
		local image = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText .. "/Image")
		local iconImage = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText .. "/IconImage")
		local itemIcon = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText .. "/ItemIcon")
		local skill = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText .. "/Skill")
		local touch = self:GetBagTouchEntity(bagIndex)
		self:SetEntityAndSpriteEnabled(tile, active == true)
		self:SetEntityAndSpriteEnabled(icon, active == true)
		self:SetEntityAndSpriteEnabled(skillIcon, active == true)
		self:SetEntityAndSpriteEnabled(image, active == true)
		self:SetEntityAndSpriteEnabled(iconImage, active == true)
		self:SetEntityAndSpriteEnabled(itemIcon, active == true)
		self:SetEntityAndSpriteEnabled(skill, active == true)
		if touch ~= nil then
			touch.Enable = active == true
		end
	end

	@ExecSpace("ClientOnly")
	method void SetEntityAndSpriteEnabled(Entity entity, boolean enabled)
		if entity == nil then
			return
		end
		entity.Enable = enabled == true
		if entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.Enable = enabled == true
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearEquippedBagPart(number bagIndex)
		local part = self:GetBagPart(bagIndex)
		if part == nil then
			return
		end
		local equippedSlot = self:GetLocalEquippedSlotForBagPart(part)
		if equippedSlot > 0 then
			self:RequestClearSlot(equippedSlot)
			return
		end
		self:Log("bag right click ignored bag=" .. tostring(math.floor(self:ReadNumber(bagIndex, 0))) .. " reason=alreadySpare")
	end

	@ExecSpace("ClientOnly")
	method void RequestClearSlot(number slotIndex)
		local index = math.floor(self:ReadNumber(slotIndex, 0))
		if index <= 0 or _BRSkillSystem == nil then
			return
		end
		if self:FindFirstEmptyLocalBagSlot() <= 0 then
			self:Log("clear slot skipped slot=" .. tostring(index) .. " reason=noInventorySpace")
			return
		end
		_BRSkillSystem:RequestClearChainSlot(self:GetLocalUserId(), index)
		self:ApplyLocalClearSlot(index)
		self.nextRequestAt = 0
		self:Log("clear slot=" .. tostring(index))
	end

	@ExecSpace("ClientOnly")
	method void RequestClearPartInstance(number instanceId)
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 or _BRSkillSystem == nil then
			return
		end
		_BRSkillSystem:RequestClearPartInstanceFromChain(self:GetLocalUserId(), safeInstanceId)
		self:ApplyLocalClearPartInstance(safeInstanceId)
		self.nextRequestAt = 0
		self:Log("clear instance=" .. tostring(safeInstanceId))
	end

	@ExecSpace("ClientOnly")
	method void HandleBagPartClick(number instanceId, number sourceBagIndex)
		local bagIndex = math.floor(self:ReadNumber(sourceBagIndex, 0))
		local part = self:GetBagPart(bagIndex)
		local equippedSlot = self:GetLocalEquippedSlotForBagPart(part)
		if equippedSlot > 0 then
			self:RequestClearSlot(equippedSlot)
			self:Log("bag click clear bag=" .. tostring(bagIndex) .. " slot=" .. tostring(equippedSlot))
			return
		end
		self:RequestEquipPartToFirstEmptySlot(instanceId, bagIndex)
	end

	@ExecSpace("ClientOnly")
	method void RequestEquipPartToFirstEmptySlot(number instanceId, number sourceBagIndex)
		local targetSlot = self:FindFirstEmptyLocalChainSlot()
		if targetSlot <= 0 then
			self:Log("click insert skipped instance=" .. tostring(instanceId) .. " bag=" .. tostring(sourceBagIndex) .. " reason=chainFull")
			return
		end
		self:RequestEquipPartToSlot(instanceId, targetSlot, "click")
	end

	@ExecSpace("ClientOnly")
	method void RequestEquipPartToSlot(number instanceId, number targetSlot, string reason)
		if _BRSkillSystem == nil then
			return
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local safeSlot = math.floor(self:ReadNumber(targetSlot, 0))
		if safeInstanceId <= 0 or safeSlot <= 0 then
			return
		end
		if self:IsChainSlotLocked(safeSlot) == true then
			self:Log("insert skipped instance=" .. tostring(safeInstanceId) .. " targetSlot=" .. tostring(safeSlot) .. " reason=locked")
			return
		end
		_BRSkillSystem:RequestEquipPartToChainSlot(self:GetLocalUserId(), safeInstanceId, safeSlot)
		self:ApplyLocalEquipPartToSlot(safeInstanceId, safeSlot)
		self.nextRequestAt = 0
		self:Log("insert " .. self:ReadString(reason, "request") .. " instance=" .. tostring(safeInstanceId) .. " targetSlot=" .. tostring(safeSlot))
	end

	@ExecSpace("ClientOnly")
	method void RequestEquipConsumableToSlot(number instanceId, string reason)
		if _BRSkillSystem == nil then
			return
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return
		end
		if self:IsConsumableRecord(self:GetLocalRecordByInstanceId(safeInstanceId)) ~= true then
			self:Log("consumable insert skipped instance=" .. tostring(safeInstanceId) .. " reason=notConsumable")
			return
		end
		_BRSkillSystem:RequestEquipConsumableToSlot(self:GetLocalUserId(), safeInstanceId)
		self:ApplyLocalEquipConsumableToSlot(safeInstanceId)
		self.nextRequestAt = 0
		self:Log("consumable insert " .. self:ReadString(reason, "request") .. " instance=" .. tostring(safeInstanceId))
	end

	@ExecSpace("ClientOnly")
	method void RequestClearConsumableSlot()
		if _BRSkillSystem == nil then
			return
		end
		if self:GetConsumableSlotPart() == nil then
			return
		end
		if self:FindFirstEmptyLocalBagSlot() <= 0 then
			self:Log("consumable clear skipped reason=noInventorySpace")
			return
		end
		_BRSkillSystem:RequestClearConsumableSlot(self:GetLocalUserId())
		self:ApplyLocalClearConsumableSlot()
		self.nextRequestAt = 0
		self:Log("consumable clear")
	end

	@ExecSpace("ClientOnly")
	method void RequestMovePartToBagSlot(number instanceId, number targetBagSlot, string reason)
		if _BRSkillSystem == nil then
			return
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local safeBagSlot = math.floor(self:ReadNumber(targetBagSlot, 0))
		if safeInstanceId <= 0 or safeBagSlot <= 0 then
			return
		end
		_BRSkillSystem:RequestMovePartToBagSlot(self:GetLocalUserId(), safeInstanceId, safeBagSlot)
		self:ApplyLocalMovePartToBagSlot(safeInstanceId, safeBagSlot)
		self.nextRequestAt = 0
		self:Log("bag move " .. self:ReadString(reason, "request") .. " instance=" .. tostring(safeInstanceId) .. " targetBag=" .. tostring(safeBagSlot))
	end

	@ExecSpace("ClientOnly")
	method void RequestDropPartToWorld(number instanceId, string reason)
		-- Requests a Maple-style world drop when a skill part is released outside valid slots.
		if _BRSkillSystem == nil then
			return
		end
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return
		end
		_BRSkillSystem:RequestDropPartToWorld(self:GetLocalUserId(), safeInstanceId)
		self:ApplyLocalDropPart(safeInstanceId)
		self.nextRequestAt = 0
		self:Log("world drop " .. self:ReadString(reason, "request") .. " instance=" .. tostring(safeInstanceId))
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalEquipConsumableToSlot(number instanceId)
		-- Moves one visible inventory consumable into Sobie_1 while waiting for the server snapshot.
		self:EnsureRuntime()
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return
		end
		local sourceBagIndex = self:FindLocalBagIndexByInstanceId(safeInstanceId)
		local sourcePart = self:GetBagPart(sourceBagIndex)
		if sourcePart == nil then
			sourcePart = self:GetConsumableSlotPart()
		end
		if self:IsConsumableRecord(sourcePart) ~= true then
			return
		end
		local previous = self:GetConsumableSlotPart()
		if previous ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(previous, "InstanceId"), 0)) ~= safeInstanceId then
			if sourceBagIndex > 0 then
				self._T.bagParts[sourceBagIndex] = self:BuildBagPartFromAnyRecord(previous)
			else
				self:AppendLocalBagPart(previous)
			end
		elseif sourceBagIndex > 0 then
			self._T.bagParts[sourceBagIndex] = nil
		end
		self:RemoveLocalBagPartByInstanceId(safeInstanceId)
		self._T.consumableSlot = self:BuildConsumableRecordFromAnyRecord(sourcePart)
		self:RenderBag()
		self:RenderConsumableSlot()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalClearConsumableSlot()
		local part = self:GetConsumableSlotPart()
		if part ~= nil then
			self:AppendLocalBagPart(part)
		end
		self._T.consumableSlot = nil
		self:RenderBag()
		self:RenderConsumableSlot()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalEquipPartToSlot(number instanceId, number targetSlot)
		-- Moves one visible bag part into a local chain slot while waiting for the server snapshot.
		self:EnsureRuntime()
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local safeSlot = math.floor(self:ReadNumber(targetSlot, 0))
		if safeInstanceId <= 0 or safeSlot <= 0 then
			return
		end
		if self:IsChainSlotLocked(safeSlot) == true then
			return
		end

		if self._T.chainSlots == nil then
			self._T.chainSlots = {}
		end

		local sourceBagIndex = self:FindLocalBagIndexByInstanceId(safeInstanceId)
		local bagPart = self:FindLocalBagPartByInstanceId(safeInstanceId)
		if bagPart == nil then
			local existingSlot = self:FindLocalChainSlotByInstanceId(safeInstanceId)
			if existingSlot > 0 then
				bagPart = self:BuildBagPartFromChainRecord(self:GetChainSlot(existingSlot))
			end
		end

		local previousRecord = self._T.chainSlots[safeSlot]
		if previousRecord ~= nil then
			local previousInstanceId = math.floor(self:ReadNumber(self:ReadRecordValue(previousRecord, "InstanceId"), 0))
			if previousInstanceId > 0 and previousInstanceId ~= safeInstanceId then
				if sourceBagIndex > 0 then
					self._T.bagParts[sourceBagIndex] = self:BuildBagPartFromChainRecord(previousRecord)
				else
					self:AppendLocalBagPart(self:BuildBagPartFromChainRecord(previousRecord))
				end
			end
		end

		for slotIndex = 1, self:GetChainSlotCount() do
			local record = self._T.chainSlots[slotIndex]
			if record ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0)) == safeInstanceId then
				self._T.chainSlots[slotIndex] = nil
			end
		end

		self._T.chainSlots[safeSlot] = {
			Slot = safeSlot,
			InstanceId = safeInstanceId,
			Short = self:ReadString(self:ReadRecordValue(bagPart, "Short"), "S"),
			Tier = 1,
			DisplayName = self:ReadString(self:ReadRecordValue(bagPart, "DisplayName"), "Skill"),
			SkillKey = self:GetRecordSkillKey(bagPart),
			HasTrigger = self:ReadRecordValue(bagPart, "HasTrigger") == true,
			ItemType = self:ReadString(self:ReadRecordValue(bagPart, "ItemType"), "SKILL"),
			IconRUID = self:ReadString(self:ReadRecordValue(bagPart, "IconRUID"), "")
		}
		self:RemoveLocalBagPartByInstanceId(safeInstanceId)
		self:RenderChain()
		self:RenderBag()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalClearSlot(number slotIndex)
		-- Moves one local chain slot back into the visible spare bag.
		self:EnsureRuntime()
		local safeSlot = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlot <= 0 or self._T.chainSlots == nil then
			return
		end

		local record = self._T.chainSlots[safeSlot]
		if record ~= nil then
			self:AppendLocalBagPart(self:BuildBagPartFromChainRecord(record))
		end
		self._T.chainSlots[safeSlot] = nil
		self:RenderChain()
		self:RenderBag()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalMovePartToBagSlot(number instanceId, number targetBagSlot)
		-- Moves one local chain or bag part into a spare bag slot while waiting for the server snapshot.
		self:EnsureRuntime()
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local safeBagSlot = math.floor(self:ReadNumber(targetBagSlot, 0))
		if safeInstanceId <= 0 or safeBagSlot <= 0 then
			return
		end
		if safeBagSlot > self:GetBagSlotCount() then
			safeBagSlot = self:GetBagSlotCount()
		end

		local sourceChainSlot = self:FindLocalChainSlotByInstanceId(safeInstanceId)
		local sourceBagSlot = self:FindLocalBagIndexByInstanceId(safeInstanceId)
		local sourceBagPart = self:GetBagPart(sourceBagSlot)
		local targetBagPart = self:GetBagPart(safeBagSlot)
		if sourceChainSlot > 0 then
			local sourceRecord = self:GetChainSlot(sourceChainSlot)
			if targetBagPart ~= nil then
				self._T.chainSlots[sourceChainSlot] = self:BuildChainRecordFromBagPart(targetBagPart, sourceChainSlot)
			else
				self._T.chainSlots[sourceChainSlot] = nil
			end
			self._T.bagParts[safeBagSlot] = self:BuildBagPartFromChainRecord(sourceRecord)
		elseif sourceBagSlot > 0 and sourceBagSlot ~= safeBagSlot then
			self._T.bagParts[sourceBagSlot] = targetBagPart
			self._T.bagParts[safeBagSlot] = sourceBagPart
		else
			return
		end
		self:RenderChain()
		self:RenderBag()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalClearPartInstance(number instanceId)
		-- Clears one local chain record by part instance id.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return
		end

		local slotIndex = self:FindLocalChainSlotByInstanceId(safeInstanceId)
		if slotIndex > 0 then
			self:ApplyLocalClearSlot(slotIndex)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalDropPart(number instanceId)
		-- Removes a locally visible part after a world-drop request.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return
		end
		local slotIndex = self:FindLocalChainSlotByInstanceId(safeInstanceId)
		if slotIndex > 0 and self._T.chainSlots ~= nil then
			self._T.chainSlots[slotIndex] = nil
		end
		self:RemoveLocalBagPartByInstanceId(safeInstanceId)
		self:RenderChain()
		self:RenderBag()
	end

	@ExecSpace("ClientOnly")
	method void ApplyLocalMoveChainSlot(number fromSlot, number toSlot)
		-- Moves or swaps two local chain slots while waiting for the server snapshot.
		self:EnsureRuntime()
		local fromIndex = math.floor(self:ReadNumber(fromSlot, 0))
		local toIndex = math.floor(self:ReadNumber(toSlot, 0))
		if fromIndex <= 0 or toIndex <= 0 or fromIndex == toIndex then
			return
		end
		if self:IsChainSlotLocked(fromIndex) == true or self:IsChainSlotLocked(toIndex) == true then
			return
		end
		if self._T.chainSlots == nil then
			self._T.chainSlots = {}
		end

		local sourceRecord = self._T.chainSlots[fromIndex]
		if sourceRecord == nil then
			return
		end

		local targetRecord = self._T.chainSlots[toIndex]
		self._T.chainSlots[toIndex] = sourceRecord
		self._T.chainSlots[toIndex].Slot = toIndex
		self._T.chainSlots[fromIndex] = targetRecord
		if self._T.chainSlots[fromIndex] ~= nil then
			self._T.chainSlots[fromIndex].Slot = fromIndex
		end
		self:RenderChain()
	end

	method number FindFirstEmptyLocalChainSlot()
		local slots = self._T.chainSlots
		for slotIndex = 1, self:GetChainSlotCount() do
			local record = nil
			if slots ~= nil then
				record = slots[slotIndex]
			end
			if self:IsLockedChainSlotRecord(record) ~= true and (record == nil or self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) <= 0) then
				return slotIndex
			end
		end
		return 0
	end

	method any FindLocalBagPartByInstanceId(number instanceId)
		-- Finds one visible spare bag record by instance id.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local parts = self._T.bagParts
		if safeInstanceId <= 0 or parts == nil then
			return nil
		end
		for index = 1, self:GetBagSlotCount() do
			local part = parts[index]
			if part ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0)) == safeInstanceId then
				return part
			end
		end
		return nil
	end

	method number FindLocalBagIndexByInstanceId(number instanceId)
		-- Finds the visible spare bag slot index for one part instance.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local parts = self._T.bagParts
		if safeInstanceId <= 0 or parts == nil then
			return 0
		end
		for index = 1, self:GetBagSlotCount() do
			local part = parts[index]
			if part ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0)) == safeInstanceId then
				return index
			end
		end
		return 0
	end

	method void RemoveLocalBagPartByInstanceId(number instanceId)
		-- Removes one visible spare bag record by instance id.
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		local parts = self._T.bagParts
		if safeInstanceId <= 0 or parts == nil then
			return
		end
		for index = 1, self:GetBagSlotCount() do
			local part = parts[index]
			if part ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0)) == safeInstanceId then
				parts[index] = nil
			end
		end
	end

	method void AppendLocalBagPart(any part)
		-- Appends one unequipped part to the visible spare bag if it is not already present.
		if part == nil then
			return
		end
		self:EnsureRuntime()
		local instanceId = math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0))
		if instanceId <= 0 or self:FindLocalBagPartByInstanceId(instanceId) ~= nil then
			return
		end
		local bagSlot = self:FindFirstEmptyLocalBagSlot()
		if bagSlot <= 0 then
			self:Log("append bag skipped instance=" .. tostring(instanceId) .. " reason=noInventorySpace")
			return
		end
		self._T.bagParts[bagSlot] = {
			InstanceId = instanceId,
			Short = self:ReadString(self:ReadRecordValue(part, "Short"), "S"),
			EquippedSlot = 0,
			Tier = 1,
			DisplayName = self:ReadString(self:ReadRecordValue(part, "DisplayName"), "Skill"),
			SkillKey = self:GetRecordSkillKey(part),
			HasTrigger = self:ReadRecordValue(part, "HasTrigger") == true,
			ItemType = self:ReadString(self:ReadRecordValue(part, "ItemType"), "SKILL"),
			IconRUID = self:ReadString(self:ReadRecordValue(part, "IconRUID"), "")
		}
	end

	method any BuildBagPartFromAnyRecord(any record)
		-- Converts a chain, bag, or consumable record into a spare inventory record.
		if record == nil then
			return nil
		end
		local instanceId = math.floor(self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0))
		if instanceId <= 0 then
			return nil
		end
		return {
			InstanceId = instanceId,
			Short = self:ReadString(self:ReadRecordValue(record, "Short"), "S"),
			EquippedSlot = 0,
			Tier = 1,
			DisplayName = self:ReadString(self:ReadRecordValue(record, "DisplayName"), "Skill"),
			SkillKey = self:GetRecordSkillKey(record),
			HasTrigger = self:ReadRecordValue(record, "HasTrigger") == true,
			ItemType = self:ReadString(self:ReadRecordValue(record, "ItemType"), "SKILL"),
			IconRUID = self:ReadString(self:ReadRecordValue(record, "IconRUID"), "")
		}
	end

	method any BuildBagPartFromChainRecord(any record)
		-- Converts one chain slot record into an unequipped bag record.
		return self:BuildBagPartFromAnyRecord(record)
	end

	method any BuildChainRecordFromBagPart(any part, number slotIndex)
		-- Converts one spare bag record into a chain slot record.
		if part == nil then
			return nil
		end
		local instanceId = math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0))
		if instanceId <= 0 then
			return nil
		end
		return {
			Slot = math.floor(self:ReadNumber(slotIndex, 0)),
			InstanceId = instanceId,
			Short = self:ReadString(self:ReadRecordValue(part, "Short"), "S"),
			Tier = 1,
			DisplayName = self:ReadString(self:ReadRecordValue(part, "DisplayName"), "Skill"),
			SkillKey = self:GetRecordSkillKey(part),
			HasTrigger = self:ReadRecordValue(part, "HasTrigger") == true,
			ItemType = self:ReadString(self:ReadRecordValue(part, "ItemType"), "SKILL"),
			IconRUID = self:ReadString(self:ReadRecordValue(part, "IconRUID"), "")
		}
	end

	method any BuildConsumableRecordFromAnyRecord(any record)
		if record == nil then
			return nil
		end
		local instanceId = math.floor(self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0))
		if instanceId <= 0 then
			return nil
		end
		return {
			Slot = 1,
			InstanceId = instanceId,
			Short = self:ReadString(self:ReadRecordValue(record, "Short"), "USE"),
			EquippedSlot = 0,
			Tier = 1,
			DisplayName = self:ReadString(self:ReadRecordValue(record, "DisplayName"), "Consumable"),
			SkillKey = self:GetRecordSkillKey(record),
			HasTrigger = false,
			ItemType = "CONSUMABLE",
			IconRUID = self:ReadString(self:ReadRecordValue(record, "IconRUID"), "")
		}
	end

	method number FindFirstEmptyLocalBagSlot()
		-- Finds the first empty visible spare slot.
		self:EnsureRuntime()
		for index = 1, self:GetBagSlotCount() do
			if self:GetBagPart(index) == nil then
				return index
			end
		end
		return 0
	end

	method number GetLocalEquippedSlotForBagPart(any part)
		if part == nil then
			return 0
		end
		local equippedSlot = math.floor(self:ReadNumber(part.EquippedSlot, 0))
		if equippedSlot > 0 then
			return equippedSlot
		end
		local instanceId = math.floor(self:ReadNumber(part.InstanceId, 0))
		return self:FindLocalChainSlotByInstanceId(instanceId)
	end

	method number FindLocalChainSlotByInstanceId(number instanceId)
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return 0
		end
		local slots = self._T.chainSlots
		if slots == nil then
			return 0
		end
		for slotIndex = 1, self:GetChainSlotCount() do
			local record = slots[slotIndex]
			if record ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0)) == safeInstanceId then
				return slotIndex
			end
		end
		return 0
	end

	method number FindLocalConsumableSlotByInstanceId(number instanceId)
		local safeInstanceId = math.floor(self:ReadNumber(instanceId, 0))
		if safeInstanceId <= 0 then
			return 0
		end
		local part = self:GetConsumableSlotPart()
		if part ~= nil and math.floor(self:ReadNumber(self:ReadRecordValue(part, "InstanceId"), 0)) == safeInstanceId then
			return 1
		end
		return 0
	end

	method void ResetDrag()
		self.draggingInstanceId = 0
		self.draggingSourceSlot = 0
		self.draggingSourceBagIndex = 0
		self.draggingSourceConsumableIndex = 0
		self.draggingStartX = 0
		self.draggingStartY = 0
		self.draggingMoved = false
		self.draggingLabel = ""
	end

	method boolean IsRightClick(number touchId)
		return math.floor(self:ReadNumber(touchId, 0)) == -2
	end

	method boolean IsMiddleClick(number touchId)
		return math.floor(self:ReadNumber(touchId, 0)) == -3
	end

	method string FormatSkillTierText(string displayName, number tier)
		local order = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		return self:ReadString(displayName, "Skill") .. " " .. tostring(order) .. "차"
	end

	method string FormatSkillIconText(string shortText, number tier)
		-- Returns compact text that fits inside one square skill icon.
		local order = math.max(1, math.floor(self:ReadNumber(tier, 1)))
		return self:ReadString(shortText, "S") .. "\n" .. tostring(order) .. "차"
	end

	method any SplitCommaRecord(string record)
		local parts = {}
		for part in string.gmatch(self:ReadString(record, ""), "([^,]+)") do
			table.insert(parts, part)
		end
		return parts
	end

	method Entity GetChainTouchEntity(number slotIndex)
		local indexText = tostring(math.floor(self:ReadNumber(slotIndex, 0)))
		local authored = self:GetAuthoredChainSlotEntity(slotIndex)
		if authored ~= nil then
			return authored
		end
		local touch = self:GetChainEntity("Panel/Chain/SlotTouch_" .. indexText)
		if touch ~= nil then
			return touch
		end
		touch = self:GetChainEntity("Panel/Chain/Slot_" .. indexText .. "/Touch")
		if touch ~= nil then
			return touch
		end
		return self:GetChainEntity("Panel/Chain/Slot_" .. indexText)
	end

	method Entity GetAuthoredChainSlotEntity(number slotIndex)
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 0 then
			return nil
		end
		return self:GetEntityFromRoot(self:GetChainRootPath(), self:GetAuthoredBattleHudContainerPath() .. "/ChainPart_" .. tostring(safeSlotIndex))
	end

	method Entity GetConsumableTouchEntity()
		local authored = self:GetEntityFromRoot(self:GetChainRootPath(), self:GetAuthoredBattleHudContainerPath() .. "/Sobie_1")
		if authored ~= nil then
			return authored
		end
		local touch = self:GetChainEntity("Panel/Chain/Sobie_1/Touch")
		if touch ~= nil then
			return touch
		end
		return self:GetChainEntity("Panel/Chain/Sobie_1")
	end

	method Entity GetBagTouchEntity(number bagIndex)
		local indexText = tostring(math.floor(self:ReadNumber(bagIndex, 0)))
		local touch = self:GetInventoryEntity("Panel/Inventory/ItemTouch_" .. indexText)
		if touch ~= nil then
			return touch
		end
		touch = self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText .. "/Touch")
		if touch ~= nil then
			return touch
		end
		touch = self:GetEntityFromRoot(self:GetChainRootPath(), "Panel/Bag/Part_" .. indexText)
		if touch ~= nil then
			return touch
		end
		return self:GetInventoryEntity("Panel/Inventory/Item_" .. indexText)
	end

	method Entity GetEntity(string relativePath)
		return self:GetChainEntity(relativePath)
	end

	method Entity GetChainEntity(string relativePath)
		local entity = self:GetEntityFromRoot(self:GetChainRootPath(), relativePath)
		if entity ~= nil then
			return entity
		end
		return self:GetBattleHudAliasEntity(relativePath)
	end

	method Entity GetInventoryEntity(string relativePath)
		local inventoryRootPath = self:GetInventoryRootPath()
		local entity = self:GetEntityFromRoot(inventoryRootPath, relativePath)
		if entity ~= nil then
			return entity
		end
		local chainRootPath = self:GetChainRootPath()
		if chainRootPath ~= inventoryRootPath then
			entity = self:GetEntityFromRoot(chainRootPath, relativePath)
			if entity ~= nil then
				return entity
			end
		end
		local aliasPath = self:GetInventoryAliasRelativePath(relativePath)
		if aliasPath ~= "" then
			entity = self:GetEntityFromRoot(chainRootPath, aliasPath)
			if entity ~= nil then
				return entity
			end
			if chainRootPath ~= inventoryRootPath then
				entity = self:GetEntityFromRoot(inventoryRootPath, aliasPath)
				if entity ~= nil then
					return entity
				end
			end
		end
		return nil
	end

	method Entity GetEntityFromRoot(string rootPath, string relativePath)
		local path = self:ReadString(relativePath, "")
		if path == "" then
			return nil
		end
		if self:IsForSavePath(path) == true then
			return nil
		end
		if string.sub(path, 1, 1) ~= "/" then
			path = self:ReadString(rootPath, self:GetChainRootPath()) .. "/" .. path
		end
		if self:IsForSavePath(path) == true then
			return nil
		end
		return _EntityService:GetEntityByPath(path)
	end

	method Entity GetBattleHudAliasEntity(string relativePath)
		local aliasPath = self:GetBattleHudAliasRelativePath(relativePath)
		if aliasPath == "" then
			return nil
		end
		return self:GetEntityFromRoot(self:GetChainRootPath(), aliasPath)
	end

	method string GetBattleHudAliasRelativePath(string relativePath)
		local path = self:ReadString(relativePath, "")
		if path == "" or self:IsForSavePath(path) == true then
			return ""
		end
		if string.sub(path, 1, 1) == "/" then
			return ""
		end
		local hubPath = self:GetAuthoredBattleHudContainerPath()
		if path == "Panel" or path == "Panel/Chain" then
			return ""
		end
		if path == "Panel/Bg" then
			return hubPath .. "/Bg"
		end
		if path == "Panel/Chain/Representative" then
			return hubPath .. "/SkillChain_5"
		end
		if self:StartsWith(path, "Panel/Chain/Representative/") == true then
			return hubPath .. "/SkillChain_5" .. string.sub(path, string.len("Panel/Chain/Representative") + 1)
		end
		if path == "Panel/Chain/Sobie_1" or path == "Panel/Chain/Consumable_1" then
			return hubPath .. "/Sobie_1"
		end
		if self:StartsWith(path, "Panel/Chain/Sobie_1/") == true then
			return hubPath .. "/Sobie_1" .. string.sub(path, string.len("Panel/Chain/Sobie_1") + 1)
		end
		if self:StartsWith(path, "Panel/Chain/Consumable_1/") == true then
			return hubPath .. "/Sobie_1" .. string.sub(path, string.len("Panel/Chain/Consumable_1") + 1)
		end
		if path == "Panel/Chain/SobieTouch_1" then
			return hubPath .. "/Sobie_1"
		end
		if self:StartsWith(path, "Panel/Chain/SlotTouch_") == true then
			return self:GetBattleHudSlotAlias(path, "Panel/Chain/SlotTouch_")
		end
		if self:StartsWith(path, "Panel/Chain/Slot_") == true then
			return self:GetBattleHudSlotAlias(path, "Panel/Chain/Slot_")
		end
		if self:StartsWith(path, "Panel/Chain/Common_") == true then
			return hubPath .. "/Common_" .. string.sub(path, string.len("Panel/Chain/Common_") + 1)
		end
		if path == "Panel/HudLevelText" then
			return hubPath .. "/HudLevelText"
		end
		if path == "Panel/HudHpFill" or path == "Panel/HudHpBack" then
			return hubPath .. "/HudHpFill"
		end
		if path == "Panel/HudExpFill" or path == "Panel/HudExpBack" then
			return hubPath .. "/HudExpFill"
		end
		return ""
	end

	method string GetBattleHudSlotAlias(string path, string prefix)
		local safePath = self:ReadString(path, "")
		local safePrefix = self:ReadString(prefix, "")
		local hubPath = self:GetAuthoredBattleHudContainerPath()
		for index = 7, 1, -1 do
			local token = safePrefix .. tostring(index)
			if self:StartsWith(safePath, token) == true then
				local suffix = string.sub(safePath, string.len(token) + 1)
				if index == 1 then
					return hubPath .. "/SkillChain_5" .. suffix
				end
				return hubPath .. "/ChainPart_" .. tostring(index - 1) .. suffix
			end
		end
		return ""
	end

	method string GetInventoryAliasRelativePath(string relativePath)
		local path = self:ReadString(relativePath, "")
		if path == "" or self:IsForSavePath(path) == true then
			return ""
		end
		if string.sub(path, 1, 1) == "/" then
			return ""
		end
		if path == "Panel" or path == "Panel/Inventory" or path == "Panel/Bag" then
			return ""
		end
		local alias = self:GetInventorySlotAlias(path, "Panel/Inventory/ItemTouch_")
		if alias ~= "" then
			return alias
		end
		alias = self:GetInventorySlotAlias(path, "Panel/Inventory/Item_")
		if alias ~= "" then
			return alias
		end
		alias = self:GetInventorySlotAlias(path, "Panel/Bag/Part_")
		if alias ~= "" then
			return alias
		end
		alias = self:GetInventorySlotAlias(path, "Inventory_")
		if alias ~= "" then
			return alias
		end
		return self:GetInventorySlotAlias(path, "Invetory_")
	end

	method string GetInventorySlotAlias(string path, string prefix)
		local safePath = self:ReadString(path, "")
		local safePrefix = self:ReadString(prefix, "")
		for index = math.floor(self:GetBagSlotCount()), 1, -1 do
			local token = safePrefix .. tostring(index)
			if self:StartsWith(safePath, token) == true then
				local suffix = string.sub(safePath, string.len(token) + 1)
				return self:GetAuthoredInventorySlotPath(index, suffix)
			end
		end
		return ""
	end

	method string GetAuthoredInventorySlotPath(number slotIndex, string suffix)
		local safeSlotIndex = math.floor(self:ReadNumber(slotIndex, 0))
		if safeSlotIndex <= 0 then
			return ""
		end
		local safeSuffix = self:ReadString(suffix, "")
		local hubPath = self:GetAuthoredBattleHudContainerPath()
		local primary = hubPath .. "/Inventory_" .. tostring(safeSlotIndex) .. safeSuffix
		if self:GetEntityFromRoot(self:GetChainRootPath(), primary) ~= nil then
			return primary
		end
		local typo = hubPath .. "/Invetory_" .. tostring(safeSlotIndex) .. safeSuffix
		if self:GetEntityFromRoot(self:GetChainRootPath(), typo) ~= nil then
			return typo
		end
		local legacy = "Invetory_" .. tostring(safeSlotIndex) .. safeSuffix
		if self:GetEntityFromRoot(self:GetChainRootPath(), legacy) ~= nil then
			return legacy
		end
		return primary
	end

	method boolean IsForSavePath(string path)
		return string.find(self:ReadString(path, ""), "ForSave") ~= nil
	end

	@ExecSpace("ClientOnly")
	method void SetChainTextByPath(string relativePath, string text)
		local entity = self:GetChainEntity(relativePath)
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetInventoryTextByPath(string relativePath, string text)
		local entity = self:GetInventoryEntity(relativePath)
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetSpriteColor(Entity entity, Color color)
		if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.Enable = true
			entity.SpriteGUIRendererComponent.Color = color
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplySlotOnlyLayout()
		-- Hides static labels so the skill-chain UI is composed only of slots.
		if self:HasAuthoredBattleHudLayout() == true then
			return
		end
		self:SetChainTextByPath("Panel/Title", "")
		self:SetChainTextByPath("Panel/Stats", "")
		self:SetChainTextByPath("DragGhost/Label", "")
		self:SetChainEntityEnabled("Panel/Bg", false)
		self:SetChainEntityEnabled("Panel/Title", false)
		self:SetChainEntityEnabled("Panel/Stats", false)
		self:SetChainEntityEnabled("DragGhost/Label", false)
		for slotIndex = 1, self:GetChainSlotCount() do
			self:SetChainTextByPath("Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Label", "")
			self:SetChainTextByPath("Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Tier", "")
			self:SetChainEntityEnabled("Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Label", false)
			self:SetChainEntityEnabled("Panel/Chain/Slot_" .. tostring(slotIndex) .. "/Tier", false)
		end

		self:SetInventoryTextByPath("Panel/Title", "")
		self:SetInventoryEntityEnabled("Panel/Bg", false)
		self:SetInventoryEntityEnabled("Panel/Title", false)
		for index = 1, self:GetBagSlotCount() do
			self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Label", "")
			self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Name", "")
			self:SetInventoryTextByPath("Panel/Inventory/Item_" .. tostring(index) .. "/Equipped", "")
			self:SetInventoryEntityEnabled("Panel/Inventory/Item_" .. tostring(index) .. "/Label", false)
			self:SetInventoryEntityEnabled("Panel/Inventory/Item_" .. tostring(index) .. "/Name", false)
			self:SetInventoryEntityEnabled("Panel/Inventory/Item_" .. tostring(index) .. "/Equipped", false)
		end
	end

	@ExecSpace("ClientOnly")
	method void EnsureBattleHudLayout()
		-- Rebuilds the skill chain panel as a compact bottom battle HUD.
		if self.EnableBattleHudLayout ~= true then
			return
		end
		self:ApplyBattleHudScale()
		if self:HasAuthoredBattleHudLayout() == true then
			self:EnsureCommonSkillSlots()
			self:RefreshCommonSkillSlots()
			self:RefreshBattleHud(_UserService.LocalPlayer)
			self:Log("authored battle hud scale=1")
			return
		end
		self:EnsureCommonSkillSlots()
		self:ApplyBattleHudPanelLayout()
		self:ApplyBattleHudSlotLayout()
		self:RefreshCommonSkillSlots()
		self:RefreshBattleHud(_UserService.LocalPlayer)
		self:ApplyAttachedInventoryLayout()
	end

	@ExecSpace("ClientOnly")
	method void ApplyBattleHudPanelLayout()
		if self:HasAuthoredBattleHudLayout() == true then
			return
		end
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return
		end
		if panel.UITransformComponent ~= nil then
			panel.UITransformComponent.AnchorsMin = Vector2(0.5, 0)
			panel.UITransformComponent.AnchorsMax = Vector2(0.5, 0)
			panel.UITransformComponent.Pivot = Vector2(0.5, 0)
			panel.UITransformComponent.RectSize = Vector2(self:GetHudPanelWidth(), self:GetHudPanelHeight())
			panel.UITransformComponent.anchoredPosition = Vector2(0, self:GetHudPanelY())
		end

		local chain = self:GetChainEntity("Panel/Chain")
		if chain ~= nil and chain.UITransformComponent ~= nil then
			chain.UITransformComponent.AnchorsMin = Vector2(0.5, 0.5)
			chain.UITransformComponent.AnchorsMax = Vector2(0.5, 0.5)
			chain.UITransformComponent.Pivot = Vector2(0.5, 0.5)
			chain.UITransformComponent.RectSize = Vector2(560, 64)
			chain.UITransformComponent.anchoredPosition = Vector2(250, -2)
		end

		self:SetChainEntityEnabled("Panel/Bg", true)
		self:SetVisualSpriteColor("CHAIN", "Panel/Bg", Color(0.025, 0.035, 0.055, 0.88))
	end

	@ExecSpace("ClientOnly")
	method void ApplyBattleHudSlotLayout()
		if self:HasAuthoredBattleHudLayout() == true then
			return
		end
		local size = self:GetHudSlotSize()
		local spacing = self:GetHudSlotSpacing()
		local startX = -128
		for slotIndex = 1, self:GetChainSlotCount() do
			local x = startX + (slotIndex - 1) * spacing
			self:ApplyHudSlotLayout("Panel/Chain/Slot_" .. tostring(slotIndex), x, 0, size)
		end

		local commonStartX = startX - spacing * 3 - 18
		for index = 1, self:GetCommonSkillSlotCount() do
			local x = commonStartX + (index - 1) * spacing
			self:ApplyHudSlotLayout("Panel/Chain/Common_" .. tostring(index), x, 0, size)
		end
	end

	@ExecSpace("ClientOnly")
	method void EnsureCommonSkillSlots()
		-- Uses statically authored common skill slots from the HUD UI file.
		for index = 1, self:GetCommonSkillSlotCount() do
			local name = "Common_" .. tostring(index)
			local slot = self:GetChainEntity("Panel/Chain/" .. name)
			if slot ~= nil then
				self:SetChainTextByPath("Panel/Chain/" .. name .. "/Label", "")
				self:SetChainTextByPath("Panel/Chain/" .. name .. "/Tier", "")
				self:SetChainEntityEnabled("Panel/Chain/" .. name .. "/Label", false)
				self:SetChainEntityEnabled("Panel/Chain/" .. name .. "/Tier", false)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyHudSlotLayout(string relativePath, number x, number y, number size)
		local path = self:ReadString(relativePath, "")
		local slot = self:GetChainEntity(path)
		if slot == nil then
			return
		end
		local safeSize = math.max(24, self:ReadNumber(size, self:GetHudSlotSize()))
		self:ApplyHudRect(slot, x, y, safeSize, safeSize, Vector2(0.5, 0.5))

		local icon = self:GetChainEntity(path .. "/Icon")
		if icon ~= nil then
			local iconSize = self:GetHudIconSize()
			self:ApplyHudRect(icon, 0, 0, iconSize, iconSize, Vector2(0.5, 0.5))
		end

		self:ApplyHudFrame(path, safeSize)
		local touch = self:GetChainEntity(path .. "/Touch")
		if touch ~= nil then
			self:ApplyHudRect(touch, 0, 0, safeSize, safeSize, Vector2(0.5, 0.5))
		end
		self:SetChainEntityEnabled(path .. "/Label", false)
		self:SetChainEntityEnabled(path .. "/Tier", false)
	end

	@ExecSpace("ClientOnly")
	method void ApplyHudFrame(string basePath, number size)
		local safeSize = math.max(24, self:ReadNumber(size, self:GetHudSlotSize()))
		local thickness = 3
		self:ApplyHudRect(self:GetChainEntity(basePath .. "/FrameTop"), 0, safeSize * 0.5 - thickness * 0.5, safeSize, thickness, Vector2(0.5, 0.5))
		self:ApplyHudRect(self:GetChainEntity(basePath .. "/FrameBottom"), 0, -safeSize * 0.5 + thickness * 0.5, safeSize, thickness, Vector2(0.5, 0.5))
		self:ApplyHudRect(self:GetChainEntity(basePath .. "/FrameLeft"), -safeSize * 0.5 + thickness * 0.5, 0, thickness, safeSize, Vector2(0.5, 0.5))
		self:ApplyHudRect(self:GetChainEntity(basePath .. "/FrameRight"), safeSize * 0.5 - thickness * 0.5, 0, thickness, safeSize, Vector2(0.5, 0.5))
	end

	@ExecSpace("ClientOnly")
	method void ApplyHudRect(Entity entity, number x, number y, number width, number height, Vector2 pivot)
		if entity == nil or entity.UITransformComponent == nil then
			return
		end
		entity.UITransformComponent.AnchorsMin = Vector2(0.5, 0.5)
		entity.UITransformComponent.AnchorsMax = Vector2(0.5, 0.5)
		entity.UITransformComponent.Pivot = pivot
		entity.UITransformComponent.RectSize = Vector2(math.max(1, self:ReadNumber(width, 1)), math.max(1, self:ReadNumber(height, 1)))
		entity.UITransformComponent.anchoredPosition = Vector2(self:ReadNumber(x, 0), self:ReadNumber(y, 0))
	end

	@ExecSpace("ClientOnly")
	method void RefreshCommonSkillSlots()
		if self.EnableBattleHudLayout ~= true then
			return
		end
		for index = 1, self:GetCommonSkillSlotCount() do
			local path = "Panel/Chain/Common_" .. tostring(index)
			local skillKey = self:GetCommonSkillKey(index)
			local occupied = self:IsCommonSkillAvailable(skillKey) == true
			local actionId = ""
			if index == 1 then
				actionId = "unique"
			elseif index == 2 then
				actionId = "blink"
			elseif index == 3 then
				actionId = "nimbus"
			end
			if occupied == true then
				self:SetSkillSlotVisual("CHAIN", path, skillKey, 1, true, false, false)
			else
				self:SetSkillSlotVisual("CHAIN", path, "Default", 0, false, false, false)
				self:SetSlotFrameColor("CHAIN", path, Color(0.28, 0.34, 0.43, 0.42))
			end
			local iconCandidates = {
				path .. "/Icon",
				path .. "/SkillIcon",
				path .. "/Image",
				path .. "/IconImage",
				path .. "/ItemIcon",
				path .. "/Skill",
				path
			}
			local iconEntity = nil
			for _, iconPath in ipairs(iconCandidates) do
				local candidate = self:GetVisualEntity("CHAIN", iconPath)
				if candidate ~= nil and candidate.SpriteGUIRendererComponent ~= nil then
					iconEntity = candidate
					break
				end
			end
			if iconEntity ~= nil then
				local readyRatio = 1
				if _BRCommonSkillSystem ~= nil and actionId ~= "" then
					readyRatio = _BRCommonSkillSystem:GetActionCooldownReadyRatio(actionId)
				end
				local safeRatio = math.max(0, math.min(1, self:ReadNumber(readyRatio, 1)))
				if safeRatio >= 0.999 then
					iconEntity.SpriteGUIRendererComponent.Type = ImageType.Simple
					iconEntity.SpriteGUIRendererComponent.FillAmount = 1
				else
					iconEntity.SpriteGUIRendererComponent.Type = ImageType.Filled
					iconEntity.SpriteGUIRendererComponent.FillMethod = FillMethodType.Vertical
					iconEntity.SpriteGUIRendererComponent.FillOrigin = 0
					iconEntity.SpriteGUIRendererComponent.FillAmount = safeRatio
				end
			end
		end
		for index = self:GetCommonSkillSlotCount() + 1, 6 do
			local path = "Panel/Chain/Common_" .. tostring(index)
			if self:GetChainEntity(path) ~= nil then
				self:SetSkillSlotVisual("CHAIN", path, "Default", 0, false, false, false)
				self:SetSlotFrameColor("CHAIN", path, Color(0.28, 0.34, 0.43, 0.42))
			end
		end
		if _BRCommonSkillSystem ~= nil and _BRCommonSkillSystem:IsLocalNimbusActive() == true then
			self:SetSlotFrameColor("CHAIN", "Panel/Chain/Common_3", Color(0.42, 0.95, 1.0, 1.0))
		end

		local representativePath = self:GetRepresentativeChainSlotPath()
		local representativeSlotIndex = self:GetRepresentativeChainSlotIndex(self._T.chainSlots)
		local record = self:GetChainSlotRecordFromSnapshot(self._T.chainSlots, representativeSlotIndex)
		local representativeOccupied = false
		if record ~= nil then
			representativeOccupied = self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0
		end
		local representativeIconCandidates = {
			representativePath .. "/Icon",
			representativePath .. "/SkillIcon",
			representativePath .. "/Image",
			representativePath .. "/IconImage",
			representativePath .. "/ItemIcon",
			representativePath .. "/Skill",
			representativePath
		}
		local representativeIcon = nil
		for _, iconPath in ipairs(representativeIconCandidates) do
			local candidate = self:GetVisualEntity("CHAIN", iconPath)
			if candidate ~= nil and candidate.SpriteGUIRendererComponent ~= nil then
				representativeIcon = candidate
				break
			end
		end
		if representativeIcon ~= nil then
			local readyRatio = 1
			if _BRCommonSkillSystem ~= nil then
				readyRatio = _BRCommonSkillSystem:GetActionCooldownReadyRatio("attack")
			end
			local safeRatio = math.max(0, math.min(1, self:ReadNumber(readyRatio, 1)))
			if safeRatio >= 0.999 then
				representativeIcon.SpriteGUIRendererComponent.Type = ImageType.Simple
				representativeIcon.SpriteGUIRendererComponent.FillAmount = 1
			else
				representativeIcon.SpriteGUIRendererComponent.Type = ImageType.Filled
				representativeIcon.SpriteGUIRendererComponent.FillMethod = FillMethodType.Vertical
				representativeIcon.SpriteGUIRendererComponent.FillOrigin = 0
				representativeIcon.SpriteGUIRendererComponent.FillAmount = safeRatio
			end
		end
		self:RefreshConsumableCooldownVisual()

		if _BRCommonSkillSystem ~= nil then
			local labels = {
				{ Path = "Panel/Chain/Common_1", Action = "unique" },
				{ Path = "Panel/Chain/Common_2", Action = "blink" },
				{ Path = "Panel/Chain/Common_3", Action = "nimbus" },
				{ Path = representativePath, Action = "attack" },
				{ Path = "Panel/Chain/Sobie_1", Action = "consumable" }
			}
			for _, row in ipairs(labels) do
				local label = _BRCommonSkillSystem:GetActionKeyName(row.Action)
				if _BRCommonSkillSystem:IsCapturingRebind() == true and _BRCommonSkillSystem:GetCapturingActionId() == row.Action then
					label = "?"
				end
				local textEntity = self:GetChainEntity(row.Path .. "/UIText")
				if textEntity ~= nil then
					textEntity.Enable = true
					if textEntity.TextComponent ~= nil then
						textEntity.TextComponent.Text = self:ReadString(label, "")
					elseif textEntity.TextGUIRendererComponent ~= nil then
						textEntity.TextGUIRendererComponent.Text = self:ReadString(label, "")
					end
				end
			end
		end
		local unusedTextEntity = self:GetChainEntity("Panel/Chain/Common_4/UIText")
		if unusedTextEntity ~= nil then
			if unusedTextEntity.TextComponent ~= nil then
				unusedTextEntity.TextComponent.Text = ""
			elseif unusedTextEntity.TextGUIRendererComponent ~= nil then
				unusedTextEntity.TextGUIRendererComponent.Text = ""
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshRepresentativeCooldownVisual()
		-- Keeps the chain hotkey icon refill moving even when the chain snapshot does not change.
		local representativePath = self:GetRepresentativeChainSlotPath()
		local representativeSlotIndex = self:GetRepresentativeChainSlotIndex(self._T.chainSlots)
		local record = self:GetChainSlotRecordFromSnapshot(self._T.chainSlots, representativeSlotIndex)
		local occupied = false
		if record ~= nil then
			occupied = self:ReadNumber(self:ReadRecordValue(record, "InstanceId"), 0) > 0
		end
		self:ApplySlotCooldownVisual("CHAIN", representativePath, "attack", occupied)
	end

	@ExecSpace("ClientOnly")
	method void RefreshConsumableCooldownVisual()
		local occupied = self:GetConsumableSlotPart() ~= nil
		self:ApplySlotCooldownVisual("CHAIN", "Panel/Chain/Sobie_1", "consumable", occupied)
	end

	@ExecSpace("ClientOnly")
	method void RefreshHotkeyLabels()
		if _BRCommonSkillSystem == nil then
			return
		end
		self:SetHotkeyLabel("Panel/Chain/Common_1", "unique")
		self:SetHotkeyLabel("Panel/Chain/Common_2", "blink")
		self:SetHotkeyLabel("Panel/Chain/Common_3", "nimbus")
		self:SetHotkeyLabel(self:GetRepresentativeChainSlotPath(), "attack")
		self:SetHotkeyLabel("Panel/Chain/Sobie_1", "consumable")
		self:SetHotkeyText("Panel/Chain/Common_4", "")
	end

	@ExecSpace("ClientOnly")
	method void SetHotkeyLabel(string relativePath, string actionId)
		local label = _BRCommonSkillSystem:GetActionKeyName(actionId)
		if _BRCommonSkillSystem:IsCapturingRebind() == true and _BRCommonSkillSystem:GetCapturingActionId() == actionId then
			label = "?"
		end
		self:SetHotkeyText(relativePath, label)
	end

	@ExecSpace("ClientOnly")
	method void SetHotkeyText(string relativePath, string text)
		local textEntity = self:GetHotkeyTextEntity(relativePath)
		if textEntity == nil then
			return
		end
		textEntity.Enable = true
		if textEntity.TextComponent ~= nil then
			textEntity.TextComponent.Text = self:ReadString(text, "")
		elseif textEntity.TextGUIRendererComponent ~= nil then
			textEntity.TextGUIRendererComponent.Text = self:ReadString(text, "")
		end
	end

	method Entity GetHotkeyTextEntity(string relativePath)
		local path = self:ReadString(relativePath, "")
		local textEntity = self:GetChainEntity(path .. "/UIText")
		if textEntity ~= nil then
			return textEntity
		end
		textEntity = self:GetChainEntity(path .. "/KeyText")
		if textEntity ~= nil then
			return textEntity
		end
		local slot = self:GetChainEntity(path)
		if slot ~= nil then
			return slot:GetChildByName("UIText", false)
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void RefreshBattleHud(Entity localPlayer)
		if self.EnableBattleHudLayout ~= true or self.ShowBattleHudStatus ~= true then
			return
		end
		self:EnsureHudGauge("Hp", -246, 18, 212, 10, Color(0.94, 0.18, 0.3, 1))
		self:EnsureHudGauge("Exp", -246, -15, 212, 8, Color(0.98, 0.86, 0.18, 1))
		self:EnsureBattleHudText()

		local level = 1
		local exp = 0
		local expMax = 1
		if _BRSkillSystem ~= nil then
			level = math.max(1, math.floor(self:ReadNumber(_BRSkillSystem:GetLocalSkillLevel(), 1)))
			exp = math.max(0, math.floor(self:ReadNumber(_BRSkillSystem:GetLocalSkillExperience(), 0)))
			expMax = math.max(1, math.floor(self:ReadNumber(_BRSkillSystem:GetLocalRequiredExperience(), 1)))
		end

		local hp = 0
		local maxHp = 1
		if localPlayer ~= nil and localPlayer.PlayerComponent ~= nil then
			hp = math.max(0, math.floor(self:ReadNumber(localPlayer.PlayerComponent.Hp, 0)))
			maxHp = math.max(1, math.floor(self:ReadNumber(localPlayer.PlayerComponent.MaxHp, 1)))
		end

		self:SetHudText("HudLevelText", "Lv. " .. tostring(level), Color(1, 1, 1, 1))
		self:SetHudText("HudHpValue", tostring(hp) .. "/" .. tostring(maxHp), Color(1, 1, 1, 1))
		self:SetHudText("HudExpValue", tostring(exp) .. "/" .. tostring(expMax), Color(1, 1, 1, 1))
		self:SetHudGaugeRatio("Hp", hp / maxHp)
		self:SetHudGaugeRatio("Exp", exp / expMax)
	end

	@ExecSpace("ClientOnly")
	method void EnsureBattleHudText()
		self:EnsureHudText("HudLevelText", -392, 18, 90, 28, 20, Color(1, 1, 1, 1))
		self:EnsureHudText("HudHpLabel", -288, 18, 32, 18, 12, Color(1, 1, 1, 1))
		self:EnsureHudText("HudHpValue", -246, 18, 212, 16, 10, Color(1, 1, 1, 1))
		self:EnsureHudText("HudExpLabel", -288, -15, 32, 18, 12, Color(1, 1, 1, 1))
		self:EnsureHudText("HudExpValue", -246, -15, 212, 16, 10, Color(1, 1, 1, 1))
		self:SetHudText("HudHpLabel", "HP", Color(1, 1, 1, 1))
		self:SetHudText("HudExpLabel", "EXP", Color(1, 1, 1, 1))
	end

	@ExecSpace("ClientOnly")
	method Entity EnsureHudText(string name, number x, number y, number width, number height, number fontSize, Color color)
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return nil
		end
		local safeName = self:ReadString(name, "")
		local entity = self:GetAuthoredHudTextEntity(safeName)
		if entity == nil then
			entity = panel:GetChildByName(safeName, false)
		end
		if entity == nil then
			return nil
		end
		entity.Enable = true
		if self:HasAuthoredBattleHudLayout() == true then
			return entity
		end
		self:ApplyHudRect(entity, x, y, width, height, Vector2(0, 0.5))
		if entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.Enable = false
			entity.SpriteGUIRendererComponent.RaycastTarget = false
		end
		if entity.TextComponent ~= nil then
			entity.TextComponent.FontSize = math.max(8, math.floor(self:ReadNumber(fontSize, 12)))
			entity.TextComponent.Alignment = TextAlignmentType.MiddleLeft
			entity.TextComponent.FontColor = color
			entity.TextComponent.Bold = true
			entity.TextComponent.DropShadow = true
		end
		return entity
	end

	@ExecSpace("ClientOnly")
	method void EnsureHudGauge(string key, number x, number y, number width, number height, Color fillColor)
		-- Prepares a HUD gauge with a fixed max-size fill sprite.
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return
		end

		local safeKey = self:ReadString(key, "Gauge")
		if self:HasAuthoredBattleHudLayout() == true then
			local authoredFill = self:GetAuthoredHudGaugeFillEntity(safeKey)
			if authoredFill ~= nil then
				authoredFill.Enable = true
				if authoredFill.SpriteGUIRendererComponent ~= nil then
					authoredFill.SpriteGUIRendererComponent.RaycastTarget = false
				end
			end
			return
		end
		local back = panel:GetChildByName("Hud" .. safeKey .. "Back", false)
		local fill = panel:GetChildByName("Hud" .. safeKey .. "Fill", false)

		if back ~= nil then
			back.Enable = true
			self:ApplyHudRect(back, x, y, width, height, Vector2(0, 0.5))
			self:SetSpriteColor(back, Color(0.02, 0.025, 0.035, 0.95))
			if back.SpriteGUIRendererComponent ~= nil then
				back.SpriteGUIRendererComponent.RaycastTarget = false
			end
		end
		if fill ~= nil then
			fill.Enable = true
			self:ApplyHudRect(fill, x, y, width, height, Vector2(0, 0.5))
			self:SetSpriteColor(fill, fillColor)
			if fill.SpriteGUIRendererComponent ~= nil then
				fill.SpriteGUIRendererComponent.Type = ImageType.Filled
				fill.SpriteGUIRendererComponent.FillMethod = FillMethodType.Horizontal
				fill.SpriteGUIRendererComponent.FillOrigin = 0
				fill.SpriteGUIRendererComponent.RaycastTarget = false
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetHudGaugeRatio(string key, number ratio)
		-- Updates the visible gauge amount without changing the authored max width.
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return
		end
		local safeKey = self:ReadString(key, "Gauge")
		if self:HasAuthoredBattleHudLayout() == true then
			local authoredFill = self:GetAuthoredHudGaugeFillEntity(safeKey)
			if authoredFill == nil then
				return
			end
			local safeRatio = math.max(0, math.min(1, self:ReadNumber(ratio, 0)))
			if authoredFill.SpriteGUIRendererComponent ~= nil then
				authoredFill.SpriteGUIRendererComponent.Type = ImageType.Filled
				authoredFill.SpriteGUIRendererComponent.FillMethod = FillMethodType.Horizontal
				authoredFill.SpriteGUIRendererComponent.FillOrigin = 0
				authoredFill.SpriteGUIRendererComponent.FillAmount = safeRatio
			end
			if authoredFill.UITransformComponent ~= nil then
				authoredFill.UITransformComponent.Pivot = Vector2(0, 0.5)
				authoredFill.UITransformComponent.RectSize = Vector2(self:GetAuthoredHudGaugeWidth(), authoredFill.UITransformComponent.RectSize.y)
			end
			return
		end
		local back = panel:GetChildByName("Hud" .. safeKey .. "Back", false)
		local fill = panel:GetChildByName("Hud" .. safeKey .. "Fill", false)
		if back == nil or fill == nil or back.UITransformComponent == nil or fill.UITransformComponent == nil then
			return
		end
		local safeRatio = math.max(0, math.min(1, self:ReadNumber(ratio, 0)))
		local backSize = back.UITransformComponent.RectSize
		fill.UITransformComponent.Pivot = Vector2(0, 0.5)
		fill.UITransformComponent.RectSize = Vector2(math.max(1, backSize.x), backSize.y)
		if fill.SpriteGUIRendererComponent ~= nil then
			fill.SpriteGUIRendererComponent.Type = ImageType.Filled
			fill.SpriteGUIRendererComponent.FillMethod = FillMethodType.Horizontal
			fill.SpriteGUIRendererComponent.FillOrigin = 0
			fill.SpriteGUIRendererComponent.FillAmount = safeRatio
		end
	end

	@ExecSpace("ClientOnly")
	method void SetHudText(string name, string text, Color color)
		local panel = self:GetChainEntity("Panel")
		if panel == nil then
			return
		end
		local safeName = self:ReadString(name, "")
		local entity = self:GetAuthoredHudTextEntity(safeName)
		if entity == nil then
			entity = panel:GetChildByName(safeName, false)
		end
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
			entity.TextComponent.FontColor = color
		end
	end

	@ExecSpace("ClientOnly")
	method void SetChainEntityEnabled(string relativePath, boolean enabled)
		-- Enables or disables an entity under the chain root.
		local entity = self:GetChainEntity(relativePath)
		if entity ~= nil then
			entity.Enable = enabled == true
		end
	end

	@ExecSpace("ClientOnly")
	method void SetInventoryEntityEnabled(string relativePath, boolean enabled)
		-- Enables or disables an entity under the inventory root.
		local entity = self:GetInventoryEntity(relativePath)
		if entity ~= nil then
			entity.Enable = enabled == true
		end
	end

	@ExecSpace("ClientOnly")
	method void SetChainPanelActive(boolean active)
		-- Keeps the authored BattleHub container alive; only legacy generated panels are toggled.
		if self:HasAuthoredBattleHudLayout() == true then
			if active == true then
				local hub = self:GetEntityFromRoot(self:GetChainRootPath(), self:GetAuthoredBattleHudContainerPath())
				if hub ~= nil then
					hub.Enable = true
				end
			end
			return
		end
		local panel = self:GetChainEntity("Panel")
		if panel ~= nil then
			panel.Enable = active == true
		end
	end

	@ExecSpace("ClientOnly")
	method void SetInventoryPanelActive(boolean active)
		-- Keeps the authored BattleHub container alive; inventory slots are children of it now.
		if self:HasAuthoredBattleHudLayout() == true then
			if active == true then
				local hub = self:GetEntityFromRoot(self:GetChainRootPath(), self:GetAuthoredBattleHudContainerPath())
				if hub ~= nil then
					hub.Enable = true
				end
			end
			return
		end
		local panel = self:GetInventoryEntity("Panel")
		if panel ~= nil then
			panel.Enable = active == true
		end
	end

	@ExecSpace("ClientOnly")
	method void SetDragGhostActive(boolean active)
		local ghost = self:GetChainEntity("DragGhost")
		local root = _EntityService:GetEntityByPath(self:GetChainRootPath())
		if root ~= nil and root.UIGroupComponent ~= nil then
			if active == true then
				if self.dragGroupOrderBefore <= -1000 then
					self.dragGroupOrderBefore = self:ReadNumber(root.UIGroupComponent.GroupOrder, 4)
				end
				root.UIGroupComponent.GroupOrder = math.floor(self:ReadNumber(self.DragGroupOrder, 90))
			elseif self.dragGroupOrderBefore > -1000 then
				root.UIGroupComponent.GroupOrder = math.floor(self.dragGroupOrderBefore)
				self.dragGroupOrderBefore = -1000
			end
		end
		if ghost ~= nil then
			ghost.Enable = active == true
			if ghost.UITransformComponent ~= nil then
				local scale = self:GetBattleHudScale()
				ghost.UITransformComponent.UIScale = Vector3(scale, scale, 1)
			end
			if active == true and ghost.UITransformComponent ~= nil then
				_UILogic:SetSiblingIndex(ghost.UITransformComponent, 1000000)
			end
		end
	end

	method void EnsureRuntime()
		if self._T.chainSlots == nil then
			self._T.chainSlots = {}
		end
		if self._T.bagParts == nil then
			self._T.bagParts = {}
		end
		if self._T.consumableSlot == nil then
			self._T.consumableSlot = nil
		end
		if self._T.handlers == nil then
			self._T.handlers = {}
		end
	end

	method number GetRefreshSeconds()
		return math.max(0.05, self:ReadNumber(self.RefreshSeconds, 0.15))
	end

	method number GetRequestSeconds()
		return math.max(self:GetRefreshSeconds(), self:ReadNumber(self.RequestSeconds, 0.75))
	end

	method number GetBagSlotCount()
		local count = math.floor(self:ReadNumber(self.BagSlotCount, 4))
		if _BRSkillSystem ~= nil then
			count = math.floor(self:ReadNumber(_BRSkillSystem:GetBagSlotCount(), count))
		end
		return math.max(1, count)
	end

	method number GetChainSlotCount()
		-- Returns the visible chain slot count.
		local count = math.floor(self:ReadNumber(self.ChainSlotCount, 5))
		if _BRSkillSystem ~= nil then
			count = math.floor(self:ReadNumber(_BRSkillSystem:GetChainSlotCount(), count))
		end
		return math.max(1, count)
	end

	method number GetCommonSkillSlotCount()
		return 3
	end

	method number GetHudPanelWidth()
		return math.max(360, self:ReadNumber(self.HudPanelWidth, 940))
	end

	method number GetHudPanelHeight()
		return math.max(64, self:ReadNumber(self.HudPanelHeight, 112))
	end

	method number GetHudPanelY()
		return self:ReadNumber(self.HudPanelY, 32)
	end

	method number GetHudSlotSize()
		return math.max(28, self:ReadNumber(self.HudSlotSize, 54))
	end

	method number GetHudIconSize()
		return math.max(20, self:ReadNumber(self.HudIconSize, 42))
	end

	method number GetHudSlotSpacing()
		return math.max(self:GetHudSlotSize(), self:ReadNumber(self.HudSlotSpacing, 58))
	end

	method number GetBattleHudScale()
		local scale = self:ReadNumber(self.BattleHudScale, 1)
		return math.max(0.25, math.min(1, scale))
	end

	method number GetAuthoredHudGaugeWidth()
		return math.max(1, self:ReadNumber(self.AuthoredHudGaugeWidth, 243))
	end

	method number GetClickDragThreshold()
		return math.max(1, self:ReadNumber(self.ClickDragThreshold, 8))
	end

	method string GetChainRootPath()
		local ownerRootPath = self:GetOwnerUiRootPath()
		if self:IsBattleHudRootPath(ownerRootPath) == true then
			return ownerRootPath
		end
		return self:ReadString(self.ChainRootPath, self:ReadString(self.RootPath, "/ui/BRBattleHudGroup"))
	end

	method string GetOwnerUiRootPath()
		local selfPath = self:GetSelfPath()
		if self:StartsWith(selfPath, "/ui/") ~= true then
			return ""
		end
		local searchStart = string.len("/ui/") + 1
		local nextSlash, nextSlashEnd = string.find(selfPath, "/", searchStart)
		if nextSlashEnd == nil then
			return selfPath
		end
		return string.sub(selfPath, 1, nextSlash - 1)
	end

	method boolean IsBattleHudRootPath(string path)
		local rootPath = self:ReadString(path, "")
		return rootPath == "/ui/BRBattleHudGroup" or rootPath == "/ui/BRBattleHubGroup"
	end

	method string GetSelfPath()
		if self.Entity == nil then
			return ""
		end
		if self.Entity.Path == nil then
			return ""
		end
		return self:ReadString(self.Entity.Path, "")
	end

	method boolean IsControllerInChainRoot()
		local selfPath = self:GetSelfPath()
		local rootPath = self:GetChainRootPath()
		if self:IsForSavePath(selfPath) == true then
			return false
		end
		if selfPath == "" or rootPath == "" then
			return true
		end
		if selfPath == rootPath then
			return true
		end
		local prefix = rootPath .. "/"
		return string.sub(selfPath, 1, string.len(prefix)) == prefix
	end

	method string GetAuthoredBattleHudContainerPath()
		local rootPath = self:GetChainRootPath()
		if self:GetEntityFromRoot(rootPath, "BattleHub/ChainPart_1") ~= nil then
			return "BattleHub"
		end
		if self:GetEntityFromRoot(rootPath, "Bg/ChainPart_1") ~= nil then
			return "Bg"
		end
		return "BattleHub"
	end

	method boolean HasAuthoredBattleHudLayout()
		local rootPath = self:GetChainRootPath()
		local hubPath = self:GetAuthoredBattleHudContainerPath()
		local hub = self:GetEntityFromRoot(rootPath, hubPath)
		local slot = self:GetEntityFromRoot(rootPath, hubPath .. "/ChainPart_1")
		return hub ~= nil and slot ~= nil
	end

	@ExecSpace("ClientOnly")
	method void ApplyBattleHudScale()
		local rootPath = self:GetChainRootPath()
		local authoredRoot = self:GetEntityFromRoot(rootPath, self:GetAuthoredBattleHudContainerPath())
		if authoredRoot ~= nil and authoredRoot.UITransformComponent ~= nil then
			-- Authored BattleHub already has its final size in the UI file.
			authoredRoot.UITransformComponent.UIScale = Vector3(1, 1, 1)
			return
		end
		local scaleRoot = self:GetEntityFromRoot(rootPath, "Panel")
		if scaleRoot ~= nil and scaleRoot.UITransformComponent ~= nil then
			local scale = self:GetBattleHudScale()
			scaleRoot.UITransformComponent.UIScale = Vector3(scale, scale, 1)
		end
	end

	method Entity GetAuthoredHudTextEntity(string name)
		local safeName = self:ReadString(name, "")
		local hubPath = self:GetAuthoredBattleHudContainerPath()
		if safeName == "HudLevelText" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), hubPath .. "/HudLevelText")
		end
		if safeName == "HudHpValue" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), hubPath .. "/HudHpFill/HudHpValue")
		end
		if safeName == "HudExpValue" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), hubPath .. "/HudExpFill/HudExpValue")
		end
		return nil
	end

	method Entity GetAuthoredHudGaugeFillEntity(string key)
		local safeKey = self:ReadString(key, "")
		local hubPath = self:GetAuthoredBattleHudContainerPath()
		if safeKey == "Hp" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), hubPath .. "/HudHpFill")
		end
		if safeKey == "Exp" then
			return self:GetEntityFromRoot(self:GetChainRootPath(), hubPath .. "/HudExpFill")
		end
		return nil
	end

	method string GetInventoryRootPath()
		local configuredPath = self:ReadString(self.InventoryRootPath, "")
		if configuredPath == "" then
			return self:GetChainRootPath()
		end
		return configuredPath
	end

	method string GetLocalUserId()
		local localPlayer = _UserService.LocalPlayer
		if localPlayer == nil or localPlayer.PlayerComponent == nil then
			return ""
		end
		return self:ReadString(localPlayer.PlayerComponent.UserId, "")
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return value
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method boolean StartsWith(string text, string prefix)
		local safeText = self:ReadString(text, "")
		local safePrefix = self:ReadString(prefix, "")
		if safePrefix == "" then
			return true
		end
		return string.sub(safeText, 1, string.len(safePrefix)) == safePrefix
	end

	method void Log(string message)
		if self.VerboseLog == true then
			log("[BRSkillChainUI] " .. message)
		end
	end

end
