@Logic
script BRSkillPartTestUI extends Logic

	property string RootPath = "/ui/BRSkillPartTestGroup"

	property string BattleHudRootPath = "/ui/BRBattleHudGroup"

	property string SkillTableName = "skills"

	property string PlaceholderIconRUID = "4fea64a3307cda641809ad8be0d4890b"

	property number SlotCount = 9

	property boolean VerboseLog = true

	property boolean kioskMode = false

	property string kioskMapName = ""

	property number kioskX = 0

	property number kioskY = 0

	property number kioskPrice = 10

	property string FreeKioskMapNames = "StartMap,Lobby,LobbyMap"

	property any closeHandler = nil

	property any inputTouchStartHandler = nil

	property any inputTouchReleaseHandler = nil

	property any inputMouseMoveHandler = nil

	property any inputKeyDownHandler = nil

	property number draggingIndex = 0

	property string draggingSkillKey = ""

	property string draggingPartId = ""

	property number dragStartX = 0

	property number dragStartY = 0

	property boolean dragMoved = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:EnsureRuntime()
		self:CloseImmediate()
		self:ConnectHandlers()
		self:Log("ready slots=" .. tostring(self:GetSlotCount()))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:DisconnectHandlers()
	end

	@ExecSpace("Client")
	method void Open()
		self:EnsureRuntime()
		self:ConnectHandlers()
		self:LoadCatalog()
		self:RenderCatalog()
		self:SetPanelActive(true)
		self:RefreshRootRaycastBlocked()
		self:Log("open count=" .. tostring(self:GetCatalogCount()))
	end

	@ExecSpace("Client")
	method void OpenKiosk(string userId, string mapName, number x, number y, number price)
		-- Opens the catalog in kiosk-purchase mode; Buy buttons submit purchases.
		local localUserId = self:GetLocalUserId()
		if localUserId == "" or localUserId ~= self:ReadString(userId, "") then
			return
		end
		self.kioskMode = true
		self.kioskMapName = self:ReadString(mapName, "")
		self.kioskX = self:ReadNumber(x, 0)
		self.kioskY = self:ReadNumber(y, 0)
		self.kioskPrice = self:GetKioskPriceForMap(self.kioskMapName, price)
		self:Open()
		self:Log("kiosk open map=" .. self.kioskMapName .. " price=" .. tostring(self.kioskPrice))
	end

	@ExecSpace("Client")
	method void Close()
		self:CancelDrag()
		self.kioskMode = false
		self:SetPanelActive(false)
		self:RefreshRootRaycastBlocked()
		self:Log("closed")
	end

	@ExecSpace("ClientOnly")
	method void CloseImmediate()
		self:CancelDrag()
		self:SetPanelActive(false)
		self:RefreshRootRaycastBlocked()
	end

	@ExecSpace("ClientOnly")
	method void ConnectHandlers()
		self:EnsureRuntime()
		if self._T.handlersConnected == true then
			return
		end
		self._T.handlers = {}

		local closeButton = self:GetEntity("Panel/CloseButton")
		local connectedUiCount = 0
		if closeButton ~= nil then
			self.closeHandler = closeButton:ConnectEvent(ButtonClickEvent, self.OnClickClose)
			connectedUiCount = connectedUiCount + 1
		end

		for index = 1, self:GetSlotCount() do
			local slotIndex = index
			local slot = self:GetEntity("Panel/Grid/Slot_" .. tostring(slotIndex))
			if slot ~= nil then
				local downHandler = slot:ConnectEvent(UITouchDownEvent, function(event) self:OnSlotTouchDown(slotIndex, event) end)
				local dragHandler = slot:ConnectEvent(UITouchDragEvent, function(event) self:OnSlotTouchDrag(slotIndex, event) end)
				local upHandler = slot:ConnectEvent(UITouchUpEvent, function(event) self:OnSlotTouchUp(slotIndex, event) end)
				table.insert(self._T.handlers, { Entity = slot, EventType = "DOWN", Handler = downHandler })
				table.insert(self._T.handlers, { Entity = slot, EventType = "DRAG", Handler = dragHandler })
				table.insert(self._T.handlers, { Entity = slot, EventType = "UP", Handler = upHandler })
				connectedUiCount = connectedUiCount + 1
			end
			local buyButton = self:GetEntity("Panel/Grid/Slot_" .. tostring(slotIndex) .. "/Buy")
			if buyButton ~= nil then
				local buyHandler = buyButton:ConnectEvent(ButtonClickEvent, function(event) self:OnBuyClick(slotIndex, event) end)
				table.insert(self._T.handlers, { Entity = buyButton, EventType = "BUY", Handler = buyHandler })
				connectedUiCount = connectedUiCount + 1
			end
		end

		if connectedUiCount <= 0 then
			self:Log("handlers delayed reason=noUiEntities")
			return
		end

		if _InputService ~= nil then
			self.inputTouchStartHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.OnScreenTouchStart)
			self.inputTouchReleaseHandler = _InputService:ConnectEvent(ScreenTouchReleaseEvent, self.OnScreenTouchRelease)
			self.inputMouseMoveHandler = _InputService:ConnectEvent(MouseMoveEvent, self.OnMouseMove)
			self.inputKeyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnInputKeyDown)
		end

		self._T.handlersConnected = true
		self:Log("handlers connected count=" .. tostring(#self._T.handlers))
	end

	@ExecSpace("ClientOnly")
	method void DisconnectHandlers()
		self:EnsureRuntime()
		local closeButton = self:GetEntity("Panel/CloseButton")
		if self.closeHandler ~= nil and closeButton ~= nil then
			closeButton:DisconnectEvent(ButtonClickEvent, self.closeHandler)
		end
		self.closeHandler = nil

		if self.inputTouchStartHandler ~= nil and _InputService ~= nil then
			_InputService:DisconnectEvent(ScreenTouchEvent, self.inputTouchStartHandler)
		end
		self.inputTouchStartHandler = nil

		if self.inputTouchReleaseHandler ~= nil and _InputService ~= nil then
			_InputService:DisconnectEvent(ScreenTouchReleaseEvent, self.inputTouchReleaseHandler)
		end
		self.inputTouchReleaseHandler = nil

		if self.inputMouseMoveHandler ~= nil and _InputService ~= nil then
			_InputService:DisconnectEvent(MouseMoveEvent, self.inputMouseMoveHandler)
		end
		self.inputMouseMoveHandler = nil

		if self.inputKeyDownHandler ~= nil and _InputService ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.inputKeyDownHandler)
		end
		self.inputKeyDownHandler = nil

		for index, entry in ipairs(self._T.handlers) do
			if entry ~= nil and entry.Entity ~= nil and entry.Handler ~= nil then
				if entry.EventType == "DOWN" then
					entry.Entity:DisconnectEvent(UITouchDownEvent, entry.Handler)
				elseif entry.EventType == "DRAG" then
					entry.Entity:DisconnectEvent(UITouchDragEvent, entry.Handler)
				elseif entry.EventType == "UP" then
					entry.Entity:DisconnectEvent(UITouchUpEvent, entry.Handler)
				elseif entry.EventType == "BUY" then
					entry.Entity:DisconnectEvent(ButtonClickEvent, entry.Handler)
				end
			end
		end
		self._T.handlers = {}
		self._T.handlersConnected = false
	end

	@ExecSpace("ClientOnly")
	method void OnClickClose(ButtonClickEvent event)
		self:Close()
	end

	@ExecSpace("ClientOnly")
	method void OnInputKeyDown(KeyDownEvent event)
		-- Closes the lobby skill catalog with Escape while the panel is open.
		if event == nil or event.key ~= KeyboardKey.Escape then
			return
		end
		if self:IsPanelActive() ~= true then
			return
		end
		self:Close()
	end

	@ExecSpace("ClientOnly")
	method void OnSlotTouchDown(number slotIndex, UITouchDownEvent event)
		if event == nil or self:IsPanelActive() ~= true then
			return
		end
		if self.kioskMode == true then
			return
		end
		self:StartDragFromSlot(slotIndex, event.TouchPoint, "slot")
	end

	@ExecSpace("ClientOnly")
	method void OnBuyClick(number slotIndex, ButtonClickEvent event)
		self:RequestPurchaseItem(slotIndex)
	end

	@ExecSpace("ClientOnly")
	method void RequestPurchaseItem(number slotIndex)
		local item = self:GetCatalogItem(slotIndex)
		if item == nil then
			self:Log("buy ignored slot=" .. tostring(slotIndex) .. " reason=noItem")
			return
		end
		if self.kioskMode ~= true then
			self:Log("buy ignored slot=" .. tostring(slotIndex) .. " reason=notKiosk")
			return
		end
		local userId = self:GetLocalUserId()
		if userId == "" then
			self:Log("buy ignored slot=" .. tostring(slotIndex) .. " reason=noLocalUser")
			return
		end
		if _BRSkillSystem == nil then
			self:Log("buy ignored slot=" .. tostring(slotIndex) .. " reason=noSkillSystem")
			return
		end
		local partId = self:ReadString(item.PartId, "")
		local skillKey = self:ReadString(item.SkillKey, "")
		_BRSkillSystem:RequestKioskPurchase(userId, partId, self.kioskMapName, self.kioskX, self.kioskY, self.kioskPrice)
		self:Log("kiosk buy requested skill=" .. skillKey .. " part=" .. partId .. " map=" .. self.kioskMapName .. " price=" .. tostring(self.kioskPrice))
	end

	@ExecSpace("ClientOnly")
	method void StartDragFromSlot(number slotIndex, Vector2 screenPoint, string source)
		-- Starts a drag from a catalog slot using a screen-space pointer position.
		if self.draggingIndex > 0 or self:IsPanelActive() ~= true then
			return
		end
		local item = self:GetCatalogItem(slotIndex)
		if item == nil then
			return
		end

		self.draggingIndex = math.floor(self:ReadNumber(slotIndex, 0))
		self.draggingSkillKey = self:ReadString(item.SkillKey, "")
		self.draggingPartId = self:ReadString(item.PartId, "")
		self.dragStartX = screenPoint.x
		self.dragStartY = screenPoint.y
		self.dragMoved = false
		self:RenderDragGhost(item)
		self:SetDragGhostActive(true)
		self:MoveGhostToTouch(screenPoint)
		self:Log("drag begin skill=" .. self.draggingSkillKey .. " source=" .. self:ReadString(source, ""))
	end

	@ExecSpace("ClientOnly")
	method void OnSlotTouchDrag(number slotIndex, UITouchDragEvent event)
		if event == nil or self.draggingIndex <= 0 then
			return
		end
		self:UpdateDragMoved(event.TouchPoint)
		self:MoveGhostToTouch(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnSlotTouchUp(number slotIndex, UITouchUpEvent event)
		if event == nil or self.draggingIndex <= 0 then
			return
		end
		self:EndDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchStart(ScreenTouchEvent event)
		-- Fallback path for cases where a child visual consumes the slot touch event.
		if event == nil or self:IsPanelActive() ~= true or self.draggingIndex > 0 then
			return
		end
		if self.kioskMode == true then
			return
		end
		local slotIndex = self:GetCatalogSlotAtScreenPoint(event.TouchPoint)
		if slotIndex <= 0 then
			return
		end
		self:StartDragFromSlot(slotIndex, event.TouchPoint, "screen")
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTouchRelease(ScreenTouchReleaseEvent event)
		if event == nil or self.draggingIndex <= 0 then
			return
		end
		self:EndDragAtScreen(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnMouseMove(MouseMoveEvent event)
		if self.draggingIndex <= 0 or _InputService == nil then
			return
		end
		local cursorPosition = _InputService:GetCursorPosition()
		self:UpdateDragMoved(cursorPosition)
		self:MoveGhostToTouch(cursorPosition)
	end

	@ExecSpace("ClientOnly")
	method void EndDragAtScreen(Vector2 screenPoint)
		if self.draggingIndex <= 0 then
			return
		end
		self:MoveGhostToTouch(screenPoint)
		self:UpdateDragMoved(screenPoint)
		local targetSlot = 0
		if self.kioskMode ~= true then
			targetSlot = self:GetHudChainSlotAtScreenPoint(screenPoint)
		end
		local partId = self.draggingPartId
		local skillKey = self.draggingSkillKey
		self:CancelDrag()
		local userId = self:GetLocalUserId()
		if userId == "" then
			self:Log("drop ignored skill=" .. skillKey .. " reason=noLocalUser")
			return
		end
		if _BRSkillSystem == nil then
			self:Log("drop ignored skill=" .. skillKey .. " reason=noSkillSystem")
			return
		end
		if self.kioskMode == true then
			self:Log("drop ignored skill=" .. skillKey .. " reason=buyButtonRequired")
			return
		end
		if targetSlot <= 0 then
			self:Log("drop ignored skill=" .. skillKey .. " reason=noTargetSlot x=" .. tostring(math.floor(screenPoint.x)) .. " y=" .. tostring(math.floor(screenPoint.y)))
			return
		end
		_BRSkillSystem:RequestGrantTestPartToChainSlot(userId, partId, targetSlot)
		self:Log("drop requested skill=" .. skillKey .. " slot=" .. tostring(targetSlot))
	end

	@ExecSpace("ClientOnly")
	method number GetCatalogSlotAtScreenPoint(Vector2 screenPoint)
		-- Finds the catalog slot under a screen-space pointer position.
		for slotIndex = 1, self:GetSlotCount() do
			local slot = self:GetEntity("Panel/Grid/Slot_" .. tostring(slotIndex))
			if self:IsScreenPointInsideEntity(screenPoint, slot) == true then
				return slotIndex
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method number GetHudChainSlotAtScreenPoint(Vector2 screenPoint)
		for slotIndex = 1, 5 do
			local slot = self:GetHudChainSlotEntity(slotIndex)
			if self:IsScreenPointInsideEntity(screenPoint, slot) == true then
				return slotIndex
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method Entity GetHudChainSlotEntity(number slotIndex)
		local safeSlot = math.max(1, math.min(5, math.floor(self:ReadNumber(slotIndex, 1))))
		local rootPath = self:ReadString(self.BattleHudRootPath, "/ui/BRBattleHudGroup")
		local entity = _EntityService:GetEntityByPath(rootPath .. "/BattleHub/ChainPart_" .. tostring(safeSlot))
		if entity == nil then
			entity = _EntityService:GetEntityByPath(rootPath .. "/Bg/ChainPart_" .. tostring(safeSlot))
		end
		if entity == nil then
			entity = _EntityService:GetEntityByPath(rootPath .. "/Panel/Chain/Slot_" .. tostring(safeSlot))
		end
		if entity == nil then
			entity = _EntityService:GetEntityByPath(rootPath .. "/Panel/Chain/Slot_" .. tostring(safeSlot + 1))
		end
		return entity
	end

	@ExecSpace("ClientOnly")
	method boolean IsScreenPointInsideEntity(Vector2 screenPoint, Entity entity)
		if entity == nil or entity.UITransformComponent == nil then
			return false
		end
		local localPosition = _UILogic:ScreenToLocalUIPosition(screenPoint, entity.UITransformComponent)
		local rectSize = entity.UITransformComponent.RectSize
		return math.abs(localPosition.x) <= rectSize.x * 0.5 and math.abs(localPosition.y) <= rectSize.y * 0.5
	end

	@ExecSpace("ClientOnly")
	method void LoadCatalog()
		self:EnsureRuntime()
		self._T.items = {}
		if _BRSkillSystem ~= nil and _BRSkillSystem["EnsureRuntime"] ~= nil then
			_BRSkillSystem:EnsureRuntime()
		end
		local data = self:GetDataTable(self.SkillTableName)
		if data == nil then
			self:Log("catalog skipped reason=noDataSet")
			return
		end
		local rowCount = math.max(0, math.floor(self:ReadNumber(data:GetRowCount(), 0)))
		for row = 1, rowCount do
			local skillId = self:GetDataCell(data, row, "id", "")
			local category = self:GetDataCell(data, row, "skill_category", "")
			local partId = self:ResolveCatalogPartId(skillId)
			if partId ~= "" and self:IsCatalogFirstOrderSkill(skillId, category) == true then
				local displayName = self:GetDataCell(data, row, "name", skillId)
				local iconRuid = self:GetSkillTierIconRUID(skillId, 1, data, row)
				table.insert(self._T.items, {
					SkillKey = skillId,
					PartId = partId,
					DisplayName = displayName,
					IconRUID = iconRuid,
					TierIcon1 = iconRuid,
					TierIcon2 = self:GetSkillTierIconRUID(skillId, 2, data, row),
					TierIcon3 = self:GetSkillTierIconRUID(skillId, 3, data, row),
					TierIcon4 = self:GetSkillTierIconRUID(skillId, 4, data, row)
				})
			end
		end
		self:Log("catalog loaded count=" .. tostring(#self._T.items))
	end

	method string ResolveCatalogPartId(string skillId)
		if _BRSkillSystem == nil or _BRSkillSystem["GetPartIdForSkillKey"] == nil then
			return ""
		end
		return self:ReadString(_BRSkillSystem:GetPartIdForSkillKey(self:ReadString(skillId, "")), "")
	end

	method void AppendKioskConsumableCatalogItems()
		if self.kioskMode ~= true or _BRSkillSystem == nil then
			return
		end
		self:AppendKioskConsumableCatalogItem(
			self:ReadString(_BRSkillSystem.HealthPotionPartId, "health_recovery_potion"),
			self:ReadString(_BRSkillSystem.HealthPotionSkillKey, "Consumable_HealthPotion"),
			"Health Potion",
			self:ReadString(_BRSkillSystem.HealthPotionIconRUID, self.PlaceholderIconRUID)
		)
		self:AppendKioskConsumableCatalogItem(
			self:ReadString(_BRSkillSystem.ShieldPotionPartId, "fairy_tear_shield_potion"),
			self:ReadString(_BRSkillSystem.ShieldPotionSkillKey, "Consumable_ShieldPotion"),
			"Fairy Tear",
			self:ReadString(_BRSkillSystem.ShieldPotionIconRUID, self.PlaceholderIconRUID)
		)
	end

	method void AppendKioskConsumableCatalogItem(string partId, string skillKey, string displayName, string iconRuid)
		local resolvedPartId = self:ResolveCatalogPartId(partId)
		if resolvedPartId == "" then
			resolvedPartId = self:ResolveCatalogPartId(skillKey)
		end
		if resolvedPartId == "" or self:HasCatalogPartId(resolvedPartId) == true then
			return
		end
		table.insert(self._T.items, {
			SkillKey = self:ReadString(skillKey, resolvedPartId),
			PartId = resolvedPartId,
			DisplayName = self:ReadString(displayName, resolvedPartId),
			IconRUID = self:ReadString(iconRuid, self.PlaceholderIconRUID)
		})
	end

	method boolean HasCatalogPartId(string partId)
		if self._T == nil or self._T.items == nil then
			return false
		end
		local safePartId = self:ReadString(partId, "")
		if safePartId == "" then
			return false
		end
		for index, item in ipairs(self._T.items) do
			if item ~= nil and self:ReadString(item.PartId, "") == safePartId then
				return true
			end
		end
		return false
	end

	method boolean IsCatalogFirstOrderSkill(string skillId, string category)
		local safeSkillId = self:ReadString(skillId, "")
		if safeSkillId == "" or safeSkillId == "Blink" or safeSkillId == "Nimbus" then
			return false
		end
		local safeCategory = self:ReadString(category, "")
		if safeCategory == "스킬 파츠" or safeCategory == "트리거" then
			return true
		end
		local lowerCategory = string.lower(safeCategory)
		if lowerCategory == "part" or lowerCategory == "skill_part" or lowerCategory == "trigger" or lowerCategory == "starter" then
			return true
		end
		return false
	end

	method string GetSkillTierIconRUID(string skillId, number tier, any data, number row)
		if _BRSkillUIDatabase ~= nil then
			local icon = _BRSkillUIDatabase:GetSlotIconRUID(skillId, tier, true)
			if self:ReadString(icon, "") ~= "" then
				return icon
			end
		end
		local csvIcon = self:GetDataCell(data, row, "icon_ruid", "")
		if csvIcon ~= "" then
			return csvIcon
		end
		return self:ReadString(self.PlaceholderIconRUID, "")
	end

	@ExecSpace("ClientOnly")
	method void RenderCatalog()
		self:RenderHeader()
		local count = self:GetSlotCount()
		for slotIndex = 1, count do
			local item = self:GetCatalogItem(slotIndex)
			local basePath = "Panel/Grid/Slot_" .. tostring(slotIndex)
			if item == nil then
				self:SetEntityActive(basePath, false)
			else
				self:SetEntityActive(basePath, true)
				self:SetTextByPath(basePath .. "/Name", self:ReadString(item.DisplayName, "Skill"))
				self:SetSpriteImage(basePath .. "/Icon", self:ReadString(item.IconRUID, self.PlaceholderIconRUID))
				self:SetSpriteImage(basePath .. "/Icon_1", self:ReadString(item.TierIcon1, item.IconRUID))
				self:SetSpriteImage(basePath .. "/Icon_2", self:ReadString(item.TierIcon2, item.IconRUID))
				self:SetSpriteImage(basePath .. "/Icon_3", self:ReadString(item.TierIcon3, item.IconRUID))
				self:SetSpriteImage(basePath .. "/Icon_4", self:ReadString(item.TierIcon4, item.IconRUID))
				self:SetSpriteColor(basePath .. "/Icon", Color(1, 1, 1, 0.96))
				self:SetSpriteColor(basePath .. "/Icon_1", Color(1, 1, 1, 0.96))
				self:SetSpriteColor(basePath .. "/Icon_2", Color(1, 1, 1, 0.96))
				self:SetSpriteColor(basePath .. "/Icon_3", Color(1, 1, 1, 0.96))
				self:SetSpriteColor(basePath .. "/Icon_4", Color(1, 1, 1, 0.96))
				self:SetSpriteColor(basePath .. "/Bg", Color(0.05, 0.07, 0.1, 0.9))
				self:SetFrameColor(basePath, self:GetFrameColor(slotIndex))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RenderHeader()
		if self.kioskMode == true then
			self:SetTextByPath("Panel/Title", "Skill Kiosk")
			self:SetTextByPath("Panel/Hint", "First-tier skills. Buy to receive.")
			self:SetTextByPath("Panel/PriceLabel", self:GetKioskPriceLabel())
			self:SetTextByPath("Panel/ModeLabel", self:GetKioskDropModeLabel())
			self:SetPriceText(self:GetKioskPriceLabel())
			return
		end
		self:SetTextByPath("Panel/Title", "Skill Part Test")
		self:SetTextByPath("Panel/Hint", "Drag a part to the 5 chain slots.")
		self:SetTextByPath("Panel/PriceLabel", "Test mode")
		self:SetTextByPath("Panel/ModeLabel", "Chain slot drop")
		self:SetPriceText(self:GetKioskPriceLabel())
	end

	method string GetKioskPriceLabel()
		local cost = self:GetKioskPriceForMap(self.kioskMapName, self.kioskPrice)
		return "Price : " .. self:FormatOneDecimalPrice(cost) .. "만메소"
	end

	method string GetKioskDropModeLabel()
		if self:IsFreeKioskMap(self.kioskMapName) == true then
			return "Drops now"
		end
		return "Drops in 15s"
	end

	method number GetKioskPriceForMap(string mapName, number price)
		if self:IsFreeKioskMap(mapName) == true then
			return 0
		end
		return self:FloorToOneDecimal(math.max(0, self:ReadNumber(price, 0)))
	end

	method number FloorToOneDecimal(number value)
		return math.floor(self:ReadNumber(value, 0) * 10) / 10
	end

	method string FormatOneDecimalPrice(number value)
		local floored = self:FloorToOneDecimal(value)
		if floored == math.floor(floored) then
			return tostring(math.floor(floored))
		end
		return tostring(floored)
	end

	method boolean IsFreeKioskMap(string mapName)
		local safeMapName = string.lower(self:TrimString(self:ReadString(mapName, "")))
		if safeMapName == "" then
			return false
		end
		local names = self:ReadString(self.FreeKioskMapNames, "StartMap,Lobby,LobbyMap")
		for token in string.gmatch(names, "([^,]+)") do
			local safeToken = string.lower(self:TrimString(token))
			if safeToken ~= "" and safeToken == safeMapName then
				return true
			end
		end
		return false
	end

	method Color GetFrameColor(number slotIndex)
		local paletteIndex = math.floor(self:ReadNumber(slotIndex, 1)) % 5
		if paletteIndex == 1 then
			return Color(0.36, 0.64, 1.0, 0.95)
		elseif paletteIndex == 2 then
			return Color(1.0, 0.58, 0.22, 0.95)
		elseif paletteIndex == 3 then
			return Color(0.62, 0.84, 0.28, 0.95)
		elseif paletteIndex == 4 then
			return Color(0.84, 0.48, 1.0, 0.95)
		end
		return Color(0.98, 0.82, 0.24, 0.95)
	end

	@ExecSpace("ClientOnly")
	method void RenderDragGhost(any item)
		self:SetTextByPath("DragGhost/Name", "")
		self:SetSpriteImage("DragGhost/Icon", self:ReadString(item.IconRUID, self.PlaceholderIconRUID))
		self:SetSpriteColor("DragGhost/Icon", Color(1, 1, 1, 0.98))
		self:SetSpriteColor("DragGhost/Bg", Color(0.07, 0.1, 0.14, 0.96))
		self:SetFrameColor("DragGhost", Color(1.0, 0.86, 0.28, 1.0))
	end

	@ExecSpace("ClientOnly")
	method void SetDragGhostActive(boolean active)
		local ghost = self:GetEntity("DragGhost")
		if ghost ~= nil then
			ghost.Enable = active == true
			if active == true and ghost.UITransformComponent ~= nil then
				_UILogic:SetSiblingIndex(ghost.UITransformComponent, 1000000)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void MoveGhostToTouch(Vector2 screenPoint)
		local ghost = self:GetEntity("DragGhost")
		if ghost == nil or ghost.UITransformComponent == nil then
			return
		end
		ghost.UITransformComponent.anchoredPosition = _UILogic:ScreenToUIPosition(screenPoint)
	end

	method void UpdateDragMoved(Vector2 screenPoint)
		local dx = screenPoint.x - self.dragStartX
		local dy = screenPoint.y - self.dragStartY
		if dx * dx + dy * dy >= 36 then
			self.dragMoved = true
		end
	end

	@ExecSpace("ClientOnly")
	method void CancelDrag()
		self:SetDragGhostActive(false)
		self.draggingIndex = 0
		self.draggingSkillKey = ""
		self.draggingPartId = ""
		self.dragStartX = 0
		self.dragStartY = 0
		self.dragMoved = false
	end

	method any GetCatalogItem(number index)
		self:EnsureRuntime()
		local safeIndex = math.floor(self:ReadNumber(index, 0))
		if safeIndex <= 0 then
			return nil
		end
		return self._T.items[safeIndex]
	end

	method number GetCatalogCount()
		self:EnsureRuntime()
		return #self._T.items
	end

	method void EnsureRuntime()
		if self._T.items == nil then
			self._T.items = {}
		end
		if self._T.handlers == nil then
			self._T.handlers = {}
		end
		if self._T.handlersConnected == nil then
			self._T.handlersConnected = false
		end
	end

	method any GetDataTable(string tableName)
		local safeName = self:ReadString(tableName, "")
		if safeName == "" then
			return nil
		end
		return _DataService:GetTable(safeName)
	end

	method string GetDataCell(any dataSet, number row, string columnName, string fallback)
		if dataSet == nil then
			return self:ReadString(fallback, "")
		end
		local value = dataSet:GetCell(math.max(1, math.floor(self:ReadNumber(row, 1))), self:ReadString(columnName, ""))
		if value == nil then
			return self:ReadString(fallback, "")
		end
		return self:TrimString(tostring(value))
	end

	@ExecSpace("ClientOnly")
	method Entity GetEntity(string relativePath)
		local path = self:ReadString(relativePath, "")
		if path == "" then
			return nil
		end
		if string.sub(path, 1, 1) ~= "/" then
			path = self:ReadString(self.RootPath, "/ui/BRSkillPartTestGroup") .. "/" .. path
		end
		return _EntityService:GetEntityByPath(path)
	end

	@ExecSpace("ClientOnly")
	method void SetPanelActive(boolean active)
		self:SetEntityActive("Panel", active)
	end

	@ExecSpace("ClientOnly")
	method boolean IsPanelActive()
		local panel = self:GetEntity("Panel")
		return panel ~= nil and panel.Enable == true
	end

	@ExecSpace("ClientOnly")
	method void SetEntityActive(string relativePath, boolean active)
		local entity = self:GetEntity(relativePath)
		if entity ~= nil then
			entity.Enable = active == true
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshRootRaycastBlocked()
		local root = _EntityService:GetEntityByPath(self:ReadString(self.RootPath, "/ui/BRSkillPartTestGroup"))
		local panelOpen = self:IsPanelActive()
		if root ~= nil and root.CanvasGroupComponent ~= nil then
			root.CanvasGroupComponent.BlocksRaycasts = panelOpen == true
			root.CanvasGroupComponent.Interactable = panelOpen == true
			root.CanvasGroupComponent.GroupAlpha = 1
		end
	end

	@ExecSpace("ClientOnly")
	method void SetTextByPath(string relativePath, string text)
		local entity = self:GetEntity(relativePath)
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
		elseif entity ~= nil and entity.TextGUIRendererComponent ~= nil then
			entity.TextGUIRendererComponent.Text = self:ReadString(text, "")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetPriceText(string text)
		if self:SetTextIfExists("Panel/Grid/PriceText", text) == true then
			return
		end
		if self:SetTextIfExists("Panel/PriceText", text) == true then
			return
		end
		if self:SetTextIfExists("Panel/Grid/UIText", text) == true then
			return
		end
		self:SetTextByPath("Panel/PriceLabel", text)
	end

	@ExecSpace("ClientOnly")
	method boolean SetTextIfExists(string relativePath, string text)
		local entity = self:GetEntity(relativePath)
		if entity == nil then
			return false
		end
		if entity.TextComponent ~= nil then
			entity.TextComponent.Text = self:ReadString(text, "")
			return true
		end
		if entity.TextGUIRendererComponent ~= nil then
			entity.TextGUIRendererComponent.Text = self:ReadString(text, "")
			return true
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void SetSpriteImage(string relativePath, string ruid)
		local entity = self:GetEntity(relativePath)
		if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.ImageRUID = DataRef(self:ReadString(ruid, self.PlaceholderIconRUID))
		end
	end

	@ExecSpace("ClientOnly")
	method void SetSpriteColor(string relativePath, Color color)
		local entity = self:GetEntity(relativePath)
		if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.Color = color
		end
	end

	@ExecSpace("ClientOnly")
	method void SetFrameColor(string basePath, Color color)
		self:SetSpriteColor(basePath .. "/FrameTop", color)
		self:SetSpriteColor(basePath .. "/FrameBottom", color)
		self:SetSpriteColor(basePath .. "/FrameLeft", color)
		self:SetSpriteColor(basePath .. "/FrameRight", color)
	end

	method string GetLocalUserId()
		local localPlayer = _UserService.LocalPlayer
		if localPlayer ~= nil and localPlayer.PlayerComponent ~= nil then
			return self:ReadString(localPlayer.PlayerComponent.UserId, "")
		end
		return ""
	end

	method number GetSlotCount()
		return math.max(1, math.floor(self:ReadNumber(self.SlotCount, 25)))
	end

	method string TrimString(string value)
		local text = self:ReadString(value, "")
		return self:ReadString(string.match(text, "^%s*(.-)%s*$"), "")
	end

	method string ReadString(any value, string fallback)
		if value == nil or value == "" then
			return fallback
		end
		return tostring(value)
	end

	method number ReadNumber(any value, number fallback)
		local numberValue = tonumber(value)
		if numberValue == nil then
			return fallback
		end
		return numberValue
	end

	method void Log(string message)
		if self.VerboseLog == true then
			log("[BRSkillPartTestUI] " .. self:ReadString(message, ""))
		end
	end

end
